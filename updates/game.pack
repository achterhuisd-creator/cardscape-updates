L3(x0, y0, x1, y1, -7, 3)
end
seg(0, gap); seg(math.min(1, gap + glen), 1)
end
if anim_v > 0 then
for z2 = 0, 3 do
if grand(10) < 6 then
local yy = ay0 + (ay1 - ay0) * (z2 + grand(100) / 100) / 4
local hh2 = 3 + grand(7)
local sh = (grand(41) - 20)
local q = { Q(math.max(ax0, ax0 + sh), yy, math.min(ax1, ax1 + sh), yy + hh2, -2) }
smudge.fill_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], grand(2) == 0, tk)
end
end
end
end
if case then
local g = GR.grade(c)
local function L(x0, y0, x1, y1, z, t)
local a, b2 = P(x0, y0, z); local c2, d = P(x1, y1, z)
smudge.line(math.floor(a + 0.5), math.floor(b2 + 0.5), math.floor(c2 + 0.5), math.floor(d + 0.5), t or 1)
end
local function rrect(x0, y0, x1, y1, z, ch, t)
local pts = { x0 + ch, y0, x1 - ch, y0, x1, y0 + ch, x1, y1 - ch, x1 - ch, y1, x0 + ch, y1, x0, y1 - ch, x0, y0 + ch }
for m = 0, 7 do local n = (m + 1) % 8; L(pts[m * 2 + 1], pts[m * 2 + 2], pts[n * 2 + 1], pts[n * 2 + 2], z, t) end
end
local function box(x0, y0, x1, y1, z, t) rrect(x0, y0, x1, y1, z, 0, t) end
box(-hw - 6, -hh - 6, hw + 6, hh + 6, 3, 1)
rrect(-hw - 6, -hh - 6, hw + 6, hh + 6, fz, 3, 1)
local lx0, ly0, lx1, ly1 = kx0 + 8, ky0 + 8, kx1 - 8, -hh - 14
local lq = { Q(lx0, ly0, lx1, ly1, fz) }
smudge.fill_quad(lq[1], lq[2], lq[3], lq[4], lq[5], lq[6], lq[7], lq[8], false, tk)
box(lx0, ly0, lx1, ly1, fz, 2)
box(lx0 + 3, ly0 + 3, lx1 - 3, ly1 - 3, fz, 1)
local gx0, gy0, gx1, gy1 = lx0 + 8, ly0 + 7, lx0 + 60, ly1 - 7
local gq = { Q(gx0, gy0, gx1, gy1, fz) }
smudge.fill_quad(gq[1], gq[2], gq[3], gq[4], gq[5], gq[6], gq[7], gq[8], true, tk)
local bx0, bx1 = lx1 - 54, lx1 - 8
local seed = c * 131 + g * 17
local x = bx0
while x < bx1 do
seed = (seed * 1103 + 12345) % 65536
local wdt = 1 + seed % 3
if (seed // 8) % 3 ~= 0 then for xx = x, math.min(bx1, x + wdt - 1) do L(xx, ly0 + 8, xx, ly0 + 38, fz, 1) end end
x = x + wdt + 1
end
local hq = { Q(bx0, ly0 + 44, bx1, ly1 - 7, fz) }
smudge.fill_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], true, tk)
if smudge.glare_quad then smudge.glare_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], (math.floor(o.ry * 20) % 2) == 0) end
box(bx0, ly0 + 44, bx1, ly1 - 7, fz, 1)
if smudge.text_sprite then
local key = c * 100 + g + (MG and anim_v * 100000 or 0)
if V3.glbl ~= key then
local cert = string.format("CERT %04d %03d%02d", 7300 + c * 37 % 2700, c, g * 7 % 100)
local gn = tostring(g)
if MG and anim_v >= 3 then gn = ({ "?", GL[gn:sub(1, 1)] or "#", "#" })[anim_v - 2] end
smudge.text_sprite("lblgnum", 48, 40, gn, "bitter14", nil, nil)
smudge.text_sprite("lblg1", 144, 46, corrupt(fit(cname(c), 142, "ui10", "bold")), "ui10", corrupt(GR.word(g)), "small")
smudge.text_sprite("lblg2", 144, 20, corrupt(cert), "small", nil, nil)
V3.glbl = key
end
local nq = { Q(gx0 + 4, gy0 + 4, gx1 - 4, gy1 - 4, fz) }
smudge.fill_quad(nq[1], nq[2], nq[3], nq[4], nq[5], nq[6], nq[7], nq[8], false, tk)
local gcx, gcy = (gx0 + gx1) / 2, (gy0 + gy1) / 2
local sq = { Q(gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz) }
tquad("lblgnum", 48, 40, gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz)
local mx0, mx1 = gx1 + 6, bx0 - 6
tquad("lblg1", 144, 46, mx0, ly0 + 4, mx1, ly0 + 4 + 46 * (mx1 - mx0) / 144, fz)
tquad("lblg2", 144, 20, mx0, ly1 - 4 - 20 * (mx1 - mx0) / 144, mx1, ly1 - 4, fz)
end
box(gx0, gy0, gx1, gy1, fz, 2)
rrect(kx0, ky0, kx1, ky1, fz, CH8, 3)
rrect(kx0 + 4, ky0 + 4, kx1 - 4, ky1 - 4, fz, 6, 1)
L(kx0 + 4, ly1 + 6, kx1 - 4, ly1 + 6, fz, 1)
for yy = -hh + 30, hh - 30, 12 do
L(kx0 + 1, yy, kx0 + 4, yy, fz, 1); L(kx1 - 4, yy, kx1 - 1, yy, fz, 1)
end
if smudge.glare_quad then
local p = 0.5 + o.ry * 1.4 - o.rx * 1.0
local cw2 = kx1 - kx0
local t0 = kx0 - cw2 * 0.5 + p * cw2 * 1.6
local function cl(v) return math.max(kx0 + 4, math.min(kx1 - 4, v)) end
local gy = ly1 + 8
local x0, y0 = P(cl(t0), gy, fz); local x1, y1 = P(cl(t0 + 22), gy, fz)
local x2, y2 = P(cl(t0 + 22 - cw2 * 0.5), ky1 - 4, fz); local x3, y3 = P(cl(t0 - cw2 * 0.5), ky1 - 4, fz)
smudge.glare_quad(x0, y0, x1, y1, x2, y2, x3, y3, false)
end
end
end
SCREENS.card3d = function()
local c = V3.c
local now = smudge.millis()
top_bar(cname(c), D.tiers[tier_of(c) + 1])
local gx, gy = V3.tx, V3.ty
local held = V3.drag and V3.drag.moved
if not held then gx = 0.12 * math.sin(now / 1700 + 1); gy = 0.24 * math.sin(now / 1300) end
local dt = math.min(100, now - (V3.last or now)); V3.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
V3.rx = V3.rx + (gx - V3.rx) * k
if V3.spin and not held then
local sp = V3.spin
if math.abs(sp.v) > 0.0022 then
sp.a = sp.a + sp.v * dt; sp.v = sp.v * math.exp(-dt / 900)
else
local tgt = math.floor(sp.a / (2 * math.pi) + 0.5) * 2 * math.pi
sp.a = sp.a + (tgt - sp.a) * (1 - math.exp(-dt / 160))
if math.abs(tgt - sp.a) < 0.01 then V3.ry = sp.a - tgt; V3.spin = nil end
end
if V3.spin then V3.ry = sp.a; V3.moving = now + 1600 end
else
V3.spin = nil
V3.ry = V3.ry + (gy - V3.ry) * k
end
if tier_of(c) == 5 and not SAVER then
local g = math.floor(now / 140)
if g ~= V3.gl then V3.gl = g; gseed(g * 3 + 9); anim_v = (math.floor(now) % 2200 < 520) and grand(5) or 0 end
end
local graded = GR and GR.grade(c) > 0
local CW, CH = graded and 250 or 270, graded and 344 or 370
local bw, bh = graded and CW + 28 or CW, graded and CH + 110 or CH
local y0, y1 = TOP + 10, H - 150
local sc = math.min((W - 60) / bw, (y1 - y0) / bh) * (graded and 0.87 or 0.92)
local cy = (y0 + y1) / 2 + (graded and 41 * sc or 0)
local ry = math.atan(math.sin(V3.ry), math.cos(V3.ry))
local back = math.cos(ry) < 0
if back then ry = math.atan(math.sin(ry + math.pi), math.cos(ry + math.pi)) end
V3.render({ c = c, cx = W // 2, cy = cy, CW = CW, CH = CH, scale = sc, back = back,
rx = V3.rx, ry = ry, inset = 22, label = true, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
ctext(W / 2, H - 132, "Drag to tilt the card - tap to close", "small")
reg("CLOSE3D", 0, TOP, W, H - TOP, function() go("detail") end, false)
end
SCREENS.detail = function()
local c = sel
local own = owned(c)
top_bar(own and cname(c) or "Undiscovered card", own and ("LV " .. S.lvl[c]) or "")
res_bar(TOP + 2)
local ax, ay = 24, TOP + 40
if own and V3.ok() and not SAVER then
local now = smudge.millis()
local m = V3.mini
if not m or m.c ~= c then m = { c = c, rx = 0, ry = 0, tx = 0, ty = 0 }; V3.mini = m end
m.box = { ax, ay, 208, 208 }
local held = m.drag and m.drag.moved
local gx, gy = m.tx, m.ty
if not held then gx = 0.08 * math.sin(now / 1700 + 1); gy = 0.16 * math.sin(now / 1300) end
local dt = math.min(100, now - (m.last or now)); m.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
m.rx = m.rx + (gx - m.rx) * k; m.ry = m.ry + (gy - m.ry) * k
V3.render({ c = c, cx = ax + 104, cy = ay + 104, CW = 208, CH = 208, inset = 8, depth = 0.6,
rx = m.rx, ry = m.ry, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
else
bigcard(ax, ay, c, own)
if own and S.shiny[c] == 1 then glass(ax + 8, ay + 8, 192) end
end
if own and GR then GR.badge(ax + 4, ay + 4, c, true) end
if own and V3.ok() then reg("CARD3D", ax, ay, 208, 208, function() V3.open(c) end, false) end
if own and not SAVER and tier_of(c) >= 1 and not V3.ok() then card_aura(ax, ay, anim_t, tier_of(c)) end
local t, e = tier_of(c), elem_of(c)
local x, w = 250, 206
local gtxt = (own and GR and GR.grade(c) > 0) and ("  G" .. GR.grade(c) .. " +" .. GR.atk(c)) or ""
ltext(x, ay + 2, fit(D.tiers[t + 1] .. ((own and S.shiny[c] == 1) and "  SHINY" or "") .. gtxt, w, "ui10", "bold"), "ui10", "bold")
tint(x, ay + 2, tw(D.tiers[t + 1], "ui10", "bold") + 1, lh("ui10") - 2, t, "ink")
chip(x + 16, ay + 38, e)
ltext(x + 40, ay + 28, D.elems[e], "ui12", "bold")
smudge.line(x, ay + 62, x + w, ay + 62, 1)
if own then
local a, h = card_stats(c)
local as = C.asc(c)
ltext(x, ay + 70, fit(string.format("Level %d / %d", S.lvl[c], D.max_level) .. ((as > 0) and ("  " .. string.rep("*", as)) or "")
.. ((DX.m(c) > 0) and ("  M" .. DX.m(c)) or ""), w, "ui10", "bold"), "ui10", "bold")
if S.lvl[c] >= D.max_level then
if as < 5 then
local du, sp, sc = C.asc_cost(c)
button(x, ay + 94, w, 46, "ASCEND " .. (as + 1) .. "/5", function() C.ascend(S, c) end,
{ font = "small", sub = string.format("%d dust %d spare %d scale", du, sp, sc), id = "ASCEND" })
else ltext(x, ay + 110, "FULLY ASCENDED", "small", "bold") end
else
local frac = S.xp[c] / D.xp_need[S.lvl[c]]
bar(x, ay + 98, w, 18, frac)
ltext(x, ay + 120, string.format("%d / %d xp", S.xp[c], D.xp_need[S.lvl[c]]), "small")
end
icon_sword(x + 12, ay + 160); ltext(x + 34, ay + 148, "ATK  " .. a, "ui12", "bold")
icon_heart(x + 12, ay + 192); ltext(x + 34, ay + 178, "HP   " .. h, "ui12", "bold")
else
ltext(x, ay + 72, "Not found yet.", "ui10", "bold")
wrapped(x, ay + 100, (tier_of(c) == 6) and "A secret. It can only drop from a pack." or "Find it in a pack or craft it with dust.", w, "small", 4)
end
local y = ay + 222
ltext(24, y, "Strong vs " .. D.elems[D.beats[e]], "ui10")
rtext(W - 24, y, "Weak to " .. D.elems[D.weak[e]], "ui10")
local ly = y + 30
if own then
if t == 4 then ly = wrapped(24, ly, D.ability[e], W - 48, "ui10", 3)
else ly = wrapped(24, ly, D.lore[c], W - 48, "ui10", 3) end
end
local sy = ay + 222 + 30 + 84
if CS_SMOOTH then sy = math.max(sy, H - 96 - 10 - 176) end
if own then
local ry = CS_SMOOTH and (sy - 66) or (sy + 176)
local hw = (W - 48 - 10) // 2
local tt2 = tier_of(c) + 1
if S.shiny[c] == 1 then
button(24, ry, hw, 56, "SHINY", function() note = "This card is already shiny." end, { font = "small", sub = "already shiny", off = true, id = "MKSHINY" })
else
local sc2 = DX.SHINY[tt2]
button(24, ry, hw, 56, "MAKE SHINY", function()
if S.dust < sc2 then note = string.format("Making it shiny costs %d dust (you have %d).", sc2, S.dust); return end
S.dust = S.dust - sc2; S.shiny[c] = 1; save_now()
note = cname(c) .. " is shiny now! (+1 ATK, +2 HP)"; aura_start()
end, { font = "small", sub = sc2 .. " dust", off = S.dust < sc2, id = "MKSHINY" })
end
local mc = DX.mcost(c)
local maxed = S.lvl[c] >= D.max_level
button(34 + hw, ry, hw, 56, "MASTERY " .. (DX.m(c) + 1), function()
if not maxed then note = "Mastery starts once a card is level " .. D.max_level .. "."; return end
if DX.m(c) >= 99 then note = "Mastery 99: the very top."; return end
if S.dust < mc then note = string.format("The next mastery star costs %d dust (you have %d).", mc, S.dust); return end
S.dust = S.dust - mc; DX.mast[c] = DX.m(c) + 1; DX.save(); save_now()
note = string.format("%s: mastery %d! (+1 ATK, +2 HP)", cname(c), DX.m(c))
end, { font = "small", sub = maxed and (mc .. " dust, +1 ATK +2 HP") or ("at level " .. D.max_level), off = (not maxed) or S.dust < mc, id = "MASTERY" })
end
smudge.line(24, sy, W - 24, sy, 2)
if own then
ltext(24, sy + 12, "Spares: " .. S.spare[c], "ui12", "bold")
if S.spare[c] > 0 then
button(W - 24 - 150 - 118, sy + 4, 108, 52, F.card_asking(c) and "SURE?" or "GIFT", function() F.gift_card_tap(c) end,
{ font = "ui10", sub = "1 copy", active = F.card_asking(c), id = "GIFTCARD" })
end
button(W - 24 - 150, sy + 4, 150, 52, all_mode and "ALL" or "ONE", function() all_mode = not all_mode end,
{ font = "ui10", sub = "copies per tap" })
local n = all_mode and S.spare[c] or math.min(1, S.spare[c])
local tt = tier_of(c) + 1
if S.spare[c] > 0 then
button(24, sy + 70, 138, 96, "SELL", function() spare_action("sell") end,
{ sub = string.format("+%d coins", D.sell_value[tt] * n) })
local maxed = S.lvl[c] >= D.max_level
if maxed and t < 5 then
local ec = ({ 10, 20, 50, 100, 200 })[t + 1]
button(171, sy + 70, 138, 96, "EVOLVE", function() evolve(c) end,
{ sub = string.format("3 + %d dust", ec), off = S.spare[c] < 3 or S.dust < ec, id = "EVOLVE" })
else
button(171, sy + 70, 138, 96, "MERGE", function() spare_action("merge") end,
{ sub = maxed and "max level" or string.format("+%d xp", D.xp_value[tt] * n), off = maxed })
end
button(318, sy + 70, 138, 96, "DUST", function() spare_action("dust") end,
{ sub = string.format("+%d dust", D.dust_value[tt] * n) })
else
ctext(W / 2, sy + 84, "No spares. Duplicates from packs land here.", "small")
end
elseif tier_of(c) == 6 then
ctext(W / 2, sy + 20, "SECRET CARD - cannot be crafted", "ui10", "bold")
ctext(W / 2, sy + 56, "Any secret: 1 in 10,000,000 per pulled card", "small")
else
local cost = D.craft_cost[t + 1]
ltext(24, sy + 12, string.format("Craft cost: %d dust  (you have %d)", cost, S.dust), "ui10", "bold")
button(24, sy + 70, W - 48, 96, "CRAFT", function() craft_card(c) end,
{ sub = string.format("%d dust", cost), off = S.dust < cost })
end
draw_note(H - 134)
button(24, H - 96, 120, 64, "PREV", function() sel = D.step(sel, -1); note = ""; anim_t = 0 end, { font = "ui10" })
button(156, H - 96, 168, 64, "BACK", function() go("album") end, { font = "ui10" })
button(336, H - 96, 120, 64, "NEXT", function() sel = D.step(sel, 1); note = ""; anim_t = 0 end, { font = "ui10" })
end
local function info_line(e)
return "Weak to " .. D.elems[D.weak[e]] .. "   -   Strong vs " .. D.elems[D.beats[e]]
end
SCREENS.quest = function()
local e = PE
top_bar(e.duel and F.duel_title() or e.wb and ("WORLD BOSS - " .. e.name) or e.lair and ("BOSS - " .. e.name) or (e.wild and ("Wilderness lvl " .. e.wild * 10)) or (e.tower and ((e.boss and "BOSS - " or "Tower - ") .. "Floor " .. e.tower) or (e.boss and ("BOSS - Stage " .. S.stage) or ("Quest - Stage " .. S.stage))), "")
local ey = TOP + 4
local ee = e.eelem or elem_of(e.ec)
thumb(16, ey, e.ec, { show = true, art = e.art })
local x = 138
ltext(x, ey, fit(e.name or cname(e.ec), W - x - 10, "ui12", "bold"), "ui12", "bold")
chip(x + 16, ey + 44, ee)
ltext(x + 38, ey + 32, D.elems[ee] .. " - " .. ((e.lair or e.wb) and "BOSS" or (e.wild and "WILDERNESS" or D.tiers[tier_of(e.ec) + 1])), "small")
icon_heart(x + 12, ey + 70); ltext(x + 30, ey + 58, "HP " .. e.eh, "ui10", "bold")
icon_sword(x + 142, ey + 70); ltext(x + 160, ey + 58, "ATK " .. e.ea, "ui10", "bold")
ltext(x, ey + 84, "Weak to  " .. D.elems[D.weak[ee]], "ui10", "bold")
ltext(x, ey + 108, "Strong vs " .. D.elems[D.beats[ee]], "small")
if e.boss then ltext(x + 170, ey + 4, "BOSS", "small", "bold") end
ctext(W / 2, ey + 132, "Choose a fighter. Dots: your cards strong here.", "small")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
swipe_tabs(function() return page end, function(t) page = t end, 0, 6)
for i = 0, 6 do
local n = GRID.count(i, function(c) return S.lvl[c] > 0 and mult(elem_of(c), ee) == 2 end)
local tx = 6 + i * 67
button(tx, ey + 156, 63, 52, tabs[i + 1], function() if page == i then GRID.flip("fight", i) end; page = i end,
{ font = "small", sub = " ", active = (page == i), id = tabs[i + 1] })
local bx, by = tx + 31, ey + 156 + 36
if n > 0 then
smudge.circle(bx, by, 10, true); ctext(bx, by - lh("small") // 2, tostring(n), "small", "bold", true); badge_tint(bx, by, 10)
else
smudge.circle(bx, by, 10, true, 1, false); smudge.circle(bx, by, 10, false, 1)
ctext(bx, by - lh("small") // 2, "0", "small")
end
end
local y0 = ey + 220
GRID.draw("fight", page, y0, 2, 172, function(c, gx, gy)
thumb(gx, gy, c, { name = true })
if owned(c) then
local a, h = card_stats(c)
ctext(gx + 54, gy + 130, string.format("A%d  H%d", a, h), "small")
local mo, mt = mult(elem_of(c), ee), mult(ee, elem_of(c))
local tag
if mo == 2 then tag = "STRONG x2"
elseif mo == 0.5 then tag = "WEAK x1/2"
elseif mt == 2 then tag = "HIT BY x2"
else tag = "EVEN" end
ctext(gx + 54, gy + 150, tag, "small", "bold")
local bx, by = gx + 94, gy + 14
if mo == 2 then
smudge.circle(bx, by, 13, true); ctext(bx, by - lh("small") // 2, "x2", "small", "bold", true); badge_tint(bx, by, 13)
elseif mo == 0.5 then
smudge.circle(bx, by, 13, true, 1, false); smudge.circle(bx, by, 13, false, 2)
ctext(bx, by - lh("small") // 2, "/2", "small", "bold")
end
end
reg("card" .. c, gx, gy, 108, 168, function()
if owned(c) then start_battle(c) else note = "You do not own that card yet." end
end, true)
end)
draw_note(y0 + 2 * 172)
button(24, H - 96, W - 48, 64, "BACK", function()
if e.duel then PE = nil; F.duel_quit(); return end
if e.lair or e.wild or e.wb then local back = e.wb and "worldboss" or ((e.lair == 9) and "questinfo" or (e.lair and "lairs" or "wild")); PE = nil; go(back) else go("title") end
end, { font = "ui10" })
end
local function leave_battle()
local won, tower = B.win, B.tower
if B.duel then B = nil; PE = nil; F.duel_next(); return end
if B.lair or B.wild or B.wb then local back = C.adv_back(B); B = nil; PE = nil; go(back); return end
B = nil
if won then
if tower then new_tower_enemy(S.tower + 1) else new_enemy() end
end
go("quest")
end
SCREENS.battle = function()
local boss = B.boss
top_bar(B.duel and F.duel_title() or B.wb and ("WORLD BOSS - " .. ename()) or B.lair and ("BOSS - " .. ename()) or (B.wild and ("Wilderness lvl " .. B.wild * 10)) or (B.tower and ("Tower - Floor " .. B.tower) or (boss and ("BOSS - Stage " .. B.stage) or ("Stage " .. B.stage))), "")
local ee, pe = eelem(), elem_of(B.pc)
local ey = TOP + 4
ltext(24, ey, ename(), "ui12", "bold")
chip(40, ey + 40, ee)
ltext(64, ey + 32, D.elems[ee] .. " - " .. ((B.lair or B.wb) and "BOSS" or (B.wild and "WILDERNESS" or D.tiers[tier_of(B.ec) + 1])), "small")
bar(24, ey + 58, 300, 24, B.ehp / B.emax)
ltext(24, ey + 88, string.format("HP %d / %d   ATK %d", B.ehp, B.emax, B.eatk) .. stt(B.es), "small", "bold")
ltext(24, ey + 112, info_line(ee), "small")
local py = TOP + 146
if V3.ok() and not SAVER then
local now = smudge.millis()
local function pose(fx, side)
local dx, dy, rx, ry = 0, 0, 0.06 * math.sin(now / 1500 + side), -0.28 * side + 0.05 * math.sin(now / 1200 + side)
if fx then
local u = (now - fx.t) / 450
if u >= 0 and u < 1 then
local sw = math.sin(u * math.pi)
if fx.k == "lunge" then dx, dy, rx = dx + 70 * sw * side, dy - 44 * sw * side, rx - 0.35 * sw * side
elseif fx.k == "hit" then dx = dx + math.sin(u * 38) * 9 * (1 - u); ry = ry + math.sin(u * 25) * 0.35 * (1 - u)
elseif fx.k == "guard" then ry = ry + 1.15 * sw * side end
end
end
return dx, dy, rx, ry
end
local function fall(r, win_side)
if B.over and B.endt then
local u = math.min(1, (now - B.endt) / 600)
return r + 1.25 * u * u, u
end
return r, 0
end
if B.over and not B.endt then B.endt = now end
local edx, edy, erx, ery = pose(B.fxe, -1)
local pdx, pdy, prx, pry = pose(B.fxp, 1)
if B.over then
if B.win then erx = fall(erx) elseif not B.fled then prx = fall(prx) end
end
V3.render({ c = B.ec, cx = 402 + edx, cy = ey + 56 + edy, CW = 104, CH = 104, rx = erx, ry = ery, inset = 6, depth = 0.6,
art = B.art, layers = not B.art, fx = (not B.art) and tier_of(B.ec) or nil })
V3.render({ c = B.pc, cx = 78 + pdx, cy = py + 56 + pdy, CW = 104, CH = 104, rx = prx, ry = pry, inset = 6, depth = 0.6,
layers = true, fx = tier_of(B.pc), shiny = S.shiny[B.pc] == 1 })
else
thumb(348, ey, B.ec, { show = true, art = B.art })
thumb(24, py, B.pc, { show = true })
end
ltext(150, py, cname(B.pc), "ui12", "bold")
ltext(150, py + 28, string.format("LV %d - %s", S.lvl[B.pc], D.elems[pe]) .. ((tier_of(B.pc) == 4) and (" - " .. D.ability_short[pe]) or ""), "small")
bar(150, py + 58, 300, 24, B.php / B.pmax)
ltext(150, py + 88, string.format("HP %d / %d   ATK %d", B.php, B.pmax, B.patk) .. stt(B.ps), "small", "bold")
ltext(150, py + 114, "Energy", "small")
for i = 1, 5 do smudge.circle(238 + (i - 1) * 24, py + 122, 8, i <= B.energy, 2) end
ltext(24, py + 138, info_line(pe), "small")
ctext(W / 2, py + 164, string.format("Your hits %s     Their hits %s", mult_txt(mult(pe, ee)), mult_txt(mult(ee, pe))), "small", "bold")
local ly = py + 190
if not SAVER then smudge.rounded_rect(28, ly + 4, W - 48, 108, 8, true, 1) end
smudge.rounded_rect(24, ly, W - 48, 108, 8, true, 1, false)
smudge.rounded_rect(24, ly, W - 48, 108, 8, false, 2)
for i, line in ipairs(B.log) do ltext(36, ly + 6 + (i - 1) * 24, fit(line, W - 72, "small", "regular"), "small") end
if B.over then
local y = ly + 124
ctext(W / 2, y, B.win and "VICTORY!" or (B.fled and "RETREATED" or (B.wb and "KNOCKED BACK" or "DEFEATED")), "bitter14", "bold")
if B.reward > 0 then
icon_coin(W / 2 - 50, y + 54); ltext(W / 2 - 32, y + 42, "+" .. B.reward .. " coins", "ui12", "bold")
end
if B.lair or B.wild or B.wb then
local t = (B.dust and B.win) and ("+" .. B.dust .. " dust  ") or ""
ctext(W / 2, y + 78, fit(t .. (B.bonus or ""), W - 40, "ui10", "regular"), "ui10")
elseif B.win and not B.duel then
local extra = B.scales and (string.format("  +%d Boss scale", B.scales)) or ""
if B.dust then extra = extra .. "  +" .. B.dust .. " dust" end
if B.tower then ctext(W / 2, y + 78, string.format("Next: floor %d", S.tower + 1) .. extra, "ui10")
else ctext(W / 2, y + 78, string.format("Next: stage %d", S.stage) .. extra, "ui10") end
if B.bonus then ctext(W / 2, y + 100 - 2, B.bonus, "small", "bold") end
end
button(24, y + 108, W - 48, 76, "CONTINUE", function() leave_battle() end)
return
end
local by = ly + 138
draw_note(by - 26)
local busy = B.busy
button(24, by, W - 48, 74, "ATTACK", function() player_act("attack") end, { off = busy })
button(24, by + 82, 210, 74, "GUARD", function() player_act("guard") end, { off = busy, sub = "heal + halve hit" })
button(246, by + 82, 210, 74, "SPECIAL", function() player_act("special") end,
{ off = busy or B.energy < 3, sub = "3 energy, double hit" })
local pp, pmx = C.pray_points(S)
button(246, by + 164, 210, 52, B.prot and "PRAY: ON" or "PRAY: OFF", function()
if not B.prot and pp <= 0 then note = "No prayer points. Restore them at the altar."; return end
B.prot = not B.prot
note = B.prot and ("Protect from " .. D.elems[eelem()] .. ": half damage.") or "Prayer off."
end, { font = "small", sub = pp .. "/" .. pmx .. " points", active = B.prot, off = busy, id = "PRAY" })
button(24, by + 164, 210, 52, "RETREAT", function()
if B.retreat then
B.over = true; B.win = false; B.reward = 0; B.fled = true; blog("You retreated.")
else
B.retreat = true; note = "Tap RETREAT again to give up."
end
end, { font = "ui10", off = busy })
end
SCREENS.stats = function()
top_bar("Statistics", "")
local y = TOP + 6
local rows = {
{ "Packs opened", S.packs }, { "Cards found", found_count() .. " / " .. D.ncards },
{ "Spare copies", spare_total() }, { "Shiny cards", shiny_count() },
{ "Sets complete", sets_done() .. " / 14" }, { "Evolutions", S.evolved },
{ "Battles won", S.wins }, { "Quest stage", S.stage }, { "Tower floor", S.tower },
{ "Coins earned", S.earned }, { "Coins now", S.coins }, { "Dust", S.dust },
}
for i, r in ipairs(rows) do
ltext(32, y + (i - 1) * 28, r[1], "ui10")
rtext(W - 32, y + (i - 1) * 28, tostring(r[2]), "ui10", "bold")
smudge.line(24, y + (i - 1) * 28 + 25, W - 24, y + (i - 1) * 28 + 25, 1)
end
local ry = y + 12 * 28 + 4
ctext(W / 2, ry, "Rank: " .. D.ranks[math.min(5, found_count() // 8 + 1)], "ui12", "bold")
for t = 0, 5 do
local n, tot = GRID.count(t)
ltext(32, ry + 34 + t * 22, D.tiers[t + 1], "small")
bar(160, ry + 34 + t * 22, 290, 16, n / tot)
end
button(24, H - 172, W - 48, 64, "CAMP & ADVENTURE", function() go("hiscores") end, { font = "ui10", sub = "skills, bosses, quests, clues...", id = "HISCORES" })
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
SCREENS.elempack = function()
top_bar("Element Pack", "")
ctext(W / 2, TOP + 4, "3 cards, all of one element. 70 coins.", "ui10")
ctext(W / 2, TOP + 30, "Last card is still uncommon or better.", "small")
for e = 1, 8 do
local col, row = (e - 1) % 2, (e - 1) // 2
button(24 + col * 222, TOP + 62 + row * 94, 210, 86, D.elems[e], function() open_pack(false, false, e) end,
{ sub = "70 coins", off = S.coins < 70, id = "EP" .. e })
chip(24 + col * 222 + 30, TOP + 62 + row * 94 + 43, e)
end
