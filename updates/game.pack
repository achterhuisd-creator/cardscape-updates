}
local EQUIP = { bow1 = { 1, 1, 0 }, bow2 = { 1, 2, 0 }, bow3 = { 1, 3, 0 }, bow4 = { 1, 4, 0 }, cap = { 2, 0, 2 }, hat = { 2, 0, 4 },
vest = { 3, 0, 6 }, charm = { 4, 2, 3 },
bow5 = { 1, 6, 0 }, bow6 = { 1, 8, 0 }, bow7 = { 1, 10, 0 }, bow8 = { 1, 13, 0 },
