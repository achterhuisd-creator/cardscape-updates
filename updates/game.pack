X.ltext(66, by + 34, "Completed: " .. x["cd" .. t], "small")
X.button(W - 24 - 130, by + 8, 120, 46, "OPEN", function() clue_start(S, t) end,
{ font = "small", off = x["cs" .. t] < 1 or x.clt ~= 0, id = "CLUE" .. t, dot = (x.clt == 0 and x["cs" .. t] > 0) and x["cs" .. t] or nil })
end
local ay = y + 3 * 70 + 6
panel(20, ay, W - 40, 150)
if x.clt == 0 then
X.ctext(W / 2, ay + 20, "No clue in progress.", "ui10", "bold")
X.wrapped(34, ay + 56, "Clues drop from gathering, fights, Slayer tasks, bosses and the Wilderness.", W - 70, "small", 3)
else
X.ltext(34, ay + 8, CLUE_N[x.clt] .. " clue: " .. x.cls .. " step(s) left", "ui10", "bold")
X.wrapped(34, ay + 40, clue_text(cp), W - 70, "ui10", 2)
X.bar(34, ay + 98, W - 68, 18, (x.clk == 5) and 0 or math.min(1, x.clh / math.max(1, x.cln)))
X.ltext(34, ay + 122, (x.clk == 5) and ("You have " .. K.count(cp, x.cla)) or (x.clh .. " / " .. x.cln), "small")
X.button(24, ay + 160, W - 48, 64, (x.clk == 5) and "HAND OVER" or "CHECK STEP", function() clue_check(S) end,
{ font = "ui10", id = "CLUECHECK", dot = (ADV.clue_ready(cp) > 0 or (x.clk == 5 and K.count(cp, x.cla) >= x.cln)) and "!" or nil })
end
X.draw_note(ay + 232)
back_btn("adventure")
end
function C.draw_colog(S)
local cp = S.camp
head(S, "Collection log", log_count(cp) .. "/" .. NLOG)
local per = 9
local pages = math.ceil(NLOG / per)
if lpage >= pages then lpage = pages - 1 end
local y0 = TOPY() + 4
local sp = rows_sp(y0 + 56, per, 60)
local function lrow(n, by)
local j = LOGJ[n]
if j then
local i = FIRST + j - 1
local got = log_has(cp, j)
panel(20, by, W - 40, sp - 6)
if got then sprite(32, by + (sp - 6 - 24) // 2, 24, ITEMS[i][3]) else X.ctext(44, by + (sp - 6) // 2 - 10, "?", "ui12", "bold") end
X.ltext(66, by + (sp - 6) // 2 - 10, got and ITEMS[i][1] or "???", "ui10", got and "bold" or "regular")
local e = K.EQL[i]
if got and e then X.rtext(W - 34, by + (sp - 6) // 2 - 8, string.format("+%d ATK +%d HP", e[2], e[3]), "small") end
end
end
local ny = y0 + per * sp + 4
if not X.list("colog", y0, nil, #LOGJ, sp, lrow) then
for k = 1, per do lrow(lpage * per + k, y0 + (k - 1) * sp) end
X.button(24, ny, 140, 46, "PREV", function() if lpage > 0 then lpage = lpage - 1 end end, { font = "ui10", off = lpage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (lpage + 1) .. " / " .. pages, "ui10")
X.button(W - 164, ny, 140, 46, "NEXT", function() if lpage < pages - 1 then lpage = lpage + 1 end end, { font = "ui10", off = lpage >= pages - 1, id = "NEXT" })
end
back_btn("adventure")
end
local function build_room(S, k)
local cp = S.camp
if room(cp, k) then return end
local r = ROOMS[k]
if lvl(cp, 16) < r[5] then X.set_note("You need Construction level " .. r[5] .. "."); return end
if S.coins < r[3] then X.set_note("Need " .. r[3] .. " coins."); return end
for _, nd in ipairs(r[4]) do if K.count(cp, nd[1]) < nd[2] then X.set_note("Need " .. nd[2] .. " " .. ITEMS[nd[1]][1] .. "."); return end end
S.coins = S.coins - r[3]
for _, nd in ipairs(r[4]) do K.take(cp, nd[1], nd[2]) end
cp.x.house = cp.x.house + 2 ^ (k - 1)
X.set_note("You built the " .. r[1] .. "!" .. K.give_xp(S, 16, r[6]))
X.save_now()
end
function C.draw_house(S)
local cp = S.camp
head(S, "Your house", "")
local y0 = TOPY() + 4
local sp = rows_sp(y0, 8, 76)
for k, r in ipairs(ROOMS) do
local by = y0 + (k - 1) * sp
local built = room(cp, k)
panel(20, by, W - 40, sp - 6)
X.ltext(34, by + 4, r[1], "ui10", "bold")
X.ltext(34, by + 26, r[2], "small")
if not built then
local p = { "Con " .. r[5], r[3] .. "c" }
for _, nd in ipairs(r[4]) do p[#p + 1] = nd[2] .. " " .. ITEMS[nd[1]][1] end
X.ltext(34, by + sp - 28, table.concat(p, ", "), "small")
end
X.button(W - 24 - 104, by + 6, 94, sp - 18, built and "BUILT" or "BUILD", function() build_room(S, k) end,
{ font = "small", off = built, id = "ROOM" .. k })
end
X.draw_note(y0 + 8 * sp)
back_btn("adventure")
end
