local cx, cy = W // 2, fy + 110
local function rays(r1, r2, n, th, rot)
for k = 0, n - 1 do
local a = k * 2 * math.pi / n + (rot or 0)
smudge.line(cx + math.floor(math.cos(a) * r1), cy + math.floor(math.sin(a) * r1),
cx + math.floor(math.cos(a) * r2), cy + math.floor(math.sin(a) * r2), th)
end
end
