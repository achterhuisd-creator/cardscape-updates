local pic, busy, after, run_timers = HP.pic, HP.busy, HP.after, HP.run_timers
local stake, payout, flush = HP.stake, HP.payout, HP.flush
local WILD, STAR, JACK, BELL = 8, 9, 10, 6
local PAY3 = { 5, 7, 12, 24, 48, 95, 480 }
local PAY2 = { 0, 0, 1, 1, 1, 2, 9 }
local PAYW = 1150
local FREE, FREEX = 8, 1
local TIER = { { "GRAND", 400, 0.005 }, { "MAJOR", 40, 0.002 }, { "MINI", 5, 0.0005 } }
local CHEST = { 1, 1, 2, 2, 3, 3, 4, 7, 0 }
local P_HOLD, P_NUDGE = 1 / 20, 1 / 25
local STRIP = {
{ 1,5,9,1,1,3,4,6,1,1,3,3,4,6,2,8,1,4,5,6,10,4,3,3,2,2,1,2,7,9,2,2,1,1,2,5,2,2,3,3,4,5 },
{ 3,1,4,3,5,5,9,2,1,1,3,6,2,9,4,6,4,10,2,2,3,2,2,1,2,1,3,2,4,1,5,1,4,3,8,5,1,2,7,3,1,6 },
{ 4,1,5,4,4,2,1,1,3,5,2,2,3,2,1,5,1,1,6,3,3,10,1,7,3,4,1,8,5,4,9,2,1,6,2,2,6,9,2,2,3,3 } }
local NS = #STRIP[1]
local LINES = { { 1, 1, 1 }, { 2, 2, 2 }, { 3, 3, 3 }, { 1, 2, 3 }, { 3, 2, 1 } }
local LINE_NAME = { "top row", "middle row", "bottom row", "diagonal", "diagonal" }
local BETS = { 10, 20, 50, 100, 200, 500, 1000, 2000, 5000, 10000 }
local function sym_at(r, p, row) return STRIP[r][((p + row - 3) % NS) + 1] end
local function line_pay(a, b, c)
if a == JACK and b == JACK and c == JACK then return -1, 3 end
if a == WILD and b == WILD and c == WILD then return PAYW, 3 end
local t = {}
for _, x in ipairs({ a, b, c }) do if x ~= WILD then t[#t + 1] = x end end
if a ~= STAR and b ~= STAR and c ~= STAR and a ~= JACK and b ~= JACK and c ~= JACK then
local same = true
for k = 2, #t do if t[k] ~= t[1] then same = false end end
if same and t[1] then return PAY3[t[1]], 3 end
end
if a ~= STAR and b ~= STAR and a ~= JACK and b ~= JACK then
if a == WILD and b == WILD then return PAY2[7], 2 end
local f = (a ~= WILD) and a or b
if (a == WILD or a == f) and (b == WILD or b == f) and PAY2[f] > 0 then return PAY2[f], 2 end
end
return 0, 0
end
