local function star_shape(cx, cy, r, filled)
local pts = {}
for k = 0, 9 do
local ang = -math.pi / 2 + k * math.pi / 5
local rr = (k % 2 == 0) and r or r * 0.45
pts[#pts + 1] = { cx + rr * math.cos(ang), cy + rr * math.sin(ang) }
end
for k = 1, 10 do
local p, q = pts[k], pts[k % 10 + 1]
if filled then smudge.triangle(cx, cy, p[1], p[2], q[1], q[2], true) end
smudge.line(p[1], p[2], q[1], q[2], 1)
end
end
function C.draw_achieve(S)
