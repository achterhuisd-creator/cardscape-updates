elseif eq then equip(S, i)
else X.set_note(ITEMS[i][1] .. ": " .. (item_info(i)[1] or "")) end
end, { id = "QINV" .. s2 })
sprite(bx + 5, by + 3, 24, ITEMS[i][3])
local tag = (f and f[1] == 6) and "DRINK" or (eq and "WEAR") or (stacks(i) and tostring(e[2])) or nil
if tag then X.ltext(bx + 32, by + 4, tag, "small", "bold") end
X.ltext(bx + 5, by + chh - 22, X.fit(ITEMS[i][1], cw - 10, "small"), "small")
else
smudge.rounded_rect(bx, by, cw, chh, 6, false, 1)
end
end
local by = gy + 7 * (chh + 4) + 4
local hw = (W - 50 - 16) // 3
X.button(18, by, hw, 52, "INVENTORY", function() qopen = false; if X.scr() ~= "gear" then C.ret.gear = X.scr() end; X.go("gear") end, { font = "small", sub = "worn gear", id = "QFULL", nohelp = true })
X.button(26 + hw, by, hw, 52, C.qall and "DEPOSIT ALL" or "DEPOSIT", function()
if C.qall then deposit_all(S); C.qall = false; return end
bank_loot(S)
if inv_used() > 0 then
C.qall = true
X.set_note("Kept food, potions, gear, tools and supplies. Tap DEPOSIT ALL to bank those too.")
end
end, { font = "small", sub = C.qall and "everything" or "loot to bank", active = C.qall, off = inv_used() == 0, id = "QDEP", nohelp = true })
X.button(34 + 2 * hw, by, hw, 52, "BANK", function() qopen = false; if X.scr() ~= "bank" then C.ret.bank = X.scr() end; X.go("bank") end, { font = "small", sub = "take more", id = "QBANK", nohelp = true })
end
function C.draw_gear(S)
local cp = S.camp
head(S, "Inventory", inv_used() .. " / " .. INV_MAX)
local y = TOP + 4
local ew = (W - 48 - 16) // 5
for k = 1, 5 do
