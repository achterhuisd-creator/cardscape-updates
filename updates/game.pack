126536
return function(X)
local C = {}
local W, H = X.W, X.H
local HUDY = X.TOP + 2
local TOP = X.TOP + 42
local fl = math.floor
local MAX_BASE, REGEN, MAX_LVL = 20, 120, 99
local ADV = dofile("adv.lua")
C.BANKCAP = { { 99, 0 }, { 250, 1000 }, { 1000, 10000 }, { 5000, 50000 }, { 25000, 250000 }, { 100000, 1000000 }, { 1000000, 5000000 } }
function C.bank_tier(cp) local t = (cp and cp.x and cp.x.bank) or 0; if t < 0 then t = 0 elseif t > #C.BANKCAP - 1 then t = #C.BANKCAP - 1 end return t end
function C.bank_cap(cp) return C.BANKCAP[C.bank_tier(cp) + 1][1] end
function C.cnum(n) local s = tostring(fl(n)); local r; repeat s, r = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until r == 0; return s end
local function xp_at(l) return ADV.XPT[l] or 0 end
local SK = {
{ name = "Woodcutting", gather = true }, { name = "Mining", gather = true },
{ name = "Fishing", gather = true }, { name = "Hunting", gather = true },
{ name = "Smithing" }, { name = "Fletching" }, { name = "Crafting" }, { name = "Magic" },
{ name = "Cooking" }, { name = "Farming", farm = true },
{ name = "Agility", act = 1 }, { name = "Thieving", act = 2 }, { name = "Prayer" },
{ name = "Slayer", slayer = true }, { name = "Herblore" }, { name = "Construction" },
{ name = "Ranged", combat = 1 }, { name = "Melee", combat = 2 }, { name = "Block", combat = 3 },
{ name = "Runecrafting" }, { name = "Firemaking" },
}
local NS = #SK
local GEAR = { [1] = { "Fly rod", "Crafting 3" }, [2] = { "Harpoon", "Smithing 12" } }
local TIERN = { "Bronze", "Iron", "Steel", "Mithril", "Adamant", "Rune", "Dragon" }
local TOOLREQ = { 1, 1, 6, 21, 31, 41, 61 }
local TOOLN = { "axe", "pickaxe" }
local ITEMS = {
{ "Logs", 2, "r0" }, { "Oak logs", 3, "r0" }, { "Willow logs", 5, "r0" }, { "Maple logs", 8, "r0" },
{ "Copper ore", 2, "r1" }, { "Iron ore", 3, "r1" }, { "Coal", 5, "r1" }, { "Mithril ore", 8, "r1" },
{ "Shrimp", 2, "r2" }, { "Trout", 3, "r2" }, { "Salmon", 5, "r2" }, { "Swordfish", 8, "r2" },
{ "Rabbit fur", 2, "i_hunt" }, { "Feathers", 3, "i_hunt" }, { "Deer hide", 5, "i_hunt" }, { "Boar tusk", 8, "i_hunt" },
{ "Bronze bar", 5, "i_bar" }, { "Iron bar", 8, "i_bar" }, { "Steel bar", 17, "i_bar" }, { "Mithril bar", 30, "i_bar" },
{ "Shortbow", 10, "i_good" }, { "Oak bow", 16, "i_good" }, { "Willow bow", 24, "i_good" }, { "Maple bow", 36, "i_good" },
{ "Fur cap", 9, "i_good" }, { "Feather hat", 17, "i_good" }, { "Hide vest", 22, "i_good" }, { "Tusk charm", 30, "i_good" },
{ "Potato", 2, "i_crop" }, { "Cabbage", 4, "i_crop" }, { "Pumpkin", 7, "i_crop" }, { "Starfruit", 11, "i_crop" },
{ "Shrimp stew", 12, "i_food" }, { "Trout pie", 18, "i_food" }, { "Salmon roast", 20, "i_food" }, { "Hunter feast", 34, "i_food" },
{ "Boss scale", 15, "i_scale" },
{ "Yew logs", 12, "r0" }, { "Magic logs", 20, "r0" }, { "Elder logs", 34, "r0" }, { "Ancient logs", 55, "r0" },
{ "Adamant ore", 14, "r1" }, { "Rune ore", 24, "r1" }, { "Dragon ore", 40, "r1" }, { "Celestial ore", 65, "r1" },
{ "Lobster", 14, "r2" }, { "Shark", 24, "r2" }, { "Manta ray", 40, "r2" }, { "Leviathan", 65, "r2" },
{ "Wolf pelt", 14, "i_hunt" }, { "Bear claw", 24, "i_hunt" }, { "Drake scale", 40, "i_hunt" }, { "Phoenix plume", 65, "i_hunt" },
{ "Adamant bar", 60, "i_bar" }, { "Rune bar", 100, "i_bar" }, { "Dragon bar", 170, "i_bar" }, { "Celestial bar", 280, "i_bar" },
{ "Yew bow", 90, "i_good" }, { "Magic bow", 140, "i_good" }, { "Elder bow", 220, "i_good" }, { "Ancient bow", 340, "i_good" },
{ "Wolf helm", 80, "i_good" }, { "Bear vest", 130, "i_good" }, { "Drake mail", 200, "i_good" }, { "Phoenix charm", 300, "i_good" },
{ "Fireberry", 20, "i_crop" }, { "Moonbean", 32, "i_crop" }, { "Sunapple", 50, "i_crop" }, { "Lotus", 80, "i_crop" },
{ "Lobster stew", 60, "i_food" }, { "Shark pie", 100, "i_food" }, { "Manta roast", 160, "i_food" }, { "Dragon feast", 250, "i_food" },
}
local ADV_FIRST = #ITEMS + 1
for _, a in ipairs(ADV.items) do ITEMS[#ITEMS + 1] = { a[1], a[2], a[3] } end
local NI = #ITEMS
local NI8 = ADV_FIRST - 1
local NI9 = ADV_FIRST - 1 + ADV.V9_COUNT
local NI10 = ADV_FIRST - 1 + ADV.V10_COUNT
local NI11 = ADV_FIRST - 1 + ADV.V11_COUNT
local NI12 = ADV_FIRST - 1 + ADV.V12_COUNT
local NI13 = ADV_FIRST - 1 + ADV.V13_COUNT
local NI14 = ADV_FIRST - 1 + ADV.V14_COUNT
local OLD_NI = 28
local NI7 = 37
local IDX = {}
do
local ids = { "log", "oak", "willow", "maple", "copper", "iron", "coal", "mith", "shrimp", "trout", "salmon", "sword",
"fur", "feather", "hide", "tusk", "bbar", "ibar", "sbar", "mbar", "bow1", "bow2", "bow3", "bow4",
"cap", "hat", "vest", "charm", "potato", "cabbage", "pumpkin", "star", "stew", "pie", "roast", "feast", "scale",
"yew", "magic", "elder", "anc", "adam", "rune", "dragon", "celes", "lob", "shark", "manta", "levi",
"wolf", "bear", "drake", "plume", "abar", "rbar", "dbar", "cbar", "bow5", "bow6", "bow7", "bow8",
"helm", "bvest", "mail", "pcharm", "dfruit", "melon", "apple", "lotus", "lstew", "spie", "mroast", "dfeast" }
for i, id in ipairs(ids) do IDX[id] = i end
for k, a in ipairs(ADV.items) do IDX[a[4]] = ADV_FIRST + k - 1 end
end
