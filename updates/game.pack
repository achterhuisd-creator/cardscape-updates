SCREENS.cosmetics = function()
if not DX.cv then DX.cload() end
top_bar("Cosmetics", short(S.dust) .. " dust")
res_bar(TOP + 2)
local y = TOP + 44
local cw = (W - 48 - 4 * 8) // 5
local function row(title, names, owned, cur, price, path, pw, ph, kind)
ltext(24, y, title, "ui12", "bold")
local th = math.floor(cw * ph / pw)
for k = 0, 4 do
local x0, y0 = 24 + k * (cw + 8), y + 34
local on = (cur == k)
smudge.rounded_rect(x0 - 3, y0 - 3, cw + 6, th + 50, 8, false, on and 3 or 1)
local p0 = (k == 0) and ((kind == "cv") and "art/bind_cover" or "art/stand") or (path .. k)
if smudge.draw_sprite_quad then
smudge.draw_sprite_quad(p0 .. ".raw", pw, ph, x0, y0, x0 + cw, y0, x0 + cw, y0 + th, x0, y0 + th, p0 .. "_m.raw")
end
local has = (k == 0) or owned:sub(k, k) == "1"
ctext(x0 + cw / 2, y0 + th + 2, fit((k == 0) and "Plain" or names[k], cw, "small", "bold"), "small", "bold")
ctext(x0 + cw / 2, y0 + th + 22, on and "IN USE" or (has and "OWNED" or (price .. "")), "small")
reg(kind .. k, x0 - 3, y0 - 3, cw + 6, th + 50, function()
if not has then
if S.dust < price then note = string.format("This costs %d dust (you have %d).", price, S.dust); return end
S.dust = S.dust - price
if kind == "cv" then DX.oc = DX.oc:sub(1, k - 1) .. "1" .. DX.oc:sub(k + 1) else DX.os = DX.os:sub(1, k - 1) .. "1" .. DX.os:sub(k + 1) end
save_now(); note = "Bought: " .. names[k] .. ((kind == "cv") and " cover." or " stand.")
end
if kind == "cv" then DX.cv = k else DX.sd = k end
DX.csave()
end, true)
end
y = y + 34 + th + 70
end
row("Binder covers", DX.COVERS, DX.oc, DX.cv, DX.CPRICE, "art/bc", 192, 232, "cv")
row("Shelf stands", DX.STANDS, DX.os, DX.sd, DX.SPRICE, "art/sd", 96, 104, "sd")
ctext(W / 2, y, "Tap one to buy it (dust) or to use it.", "small")
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go("dustshop") end, { font = "ui10" })
end
function DX.swap(n)
if S.dust < n then note = "Not enough dust."; return end
S.dust = S.dust - n; add_coins(n * 5 // 2); save_now()
note = string.format("%d dust -> %d coins.", n, n * 5 // 2)
end
function DX.well()
if S.dust < 1000 then note = string.format("The well wants 1000 dust (you have %d).", S.dust); return end
S.dust = S.dust - 1000
local r = rnd(1, 400)
if r == 1 then
local l = D.tier_cards[6]
local c = l[rnd(1, #l)]
local isnew = give_card(c)
note = "The well glows... A SECRET CARD: " .. cname(c) .. "!" .. (isnew and " (NEW!)" or "")
else
local k = rnd(1, 100)
if k <= 50 then
local n = rnd(400, 900); add_coins(n); note = "Splash! The well gives you " .. n .. " coins."
elseif k <= 80 then
S.camp.tickets = S.camp.tickets + 1; note = "Splash! A pack ticket floats up."
else
local list = {}
for c = 1, D.ncards do if S.lvl[c] > 0 and S.shiny[c] ~= 1 then list[#list + 1] = c end end
if #list > 0 then
local c = list[rnd(1, #list)]; S.shiny[c] = 1; note = "Sparkle! " .. cname(c) .. " turned shiny."
else
S.camp.rtickets = S.camp.rtickets + 1; note = "Sparkle! A rare pack ticket floats up."
end
end
end
save_now()
end
