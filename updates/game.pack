smudge.fill_quad(xs[1], ys[1], xs[2], ys[2], xs[3], ys[3], xs[4], ys[4], true, tk)
if smudge.glare_quad then smudge.glare_quad(xs[1], ys[1], xs[2], ys[2], xs[3], ys[3], xs[4], ys[4], true) end
for m = 0, 3 do local n = (m + 1) % 4; smudge.line(math.floor(xs[m + 1] + 0.5), math.floor(ys[m + 1] + 0.5), math.floor(xs[n + 1] + 0.5), math.floor(ys[n + 1] + 0.5), 1) end
end
end
