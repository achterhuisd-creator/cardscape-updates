head(S, "World", "")
local y = TOPY() + 6
local ph, we = WO.phase(), WO.weather()
panel(20, y, W - 40, 128)
sun_moon(54, y + 40, ph)
X.ltext(86, y + 10, PHASES[ph][1], "ui12", "bold")
X.wrapped(86, y + 44, PHASES[ph][5], W - 120, "small", 3)
local wy = y + 140
panel(20, wy, W - 40, 110)
X.ltext(36, wy + 10, "Weather: " .. WEATHER[we][1], "ui12", "bold")
X.wrapped(36, wy + 44, WEATHER[we][5] .. ". Changes every day.", W - 70, "small", 3)
local ky = wy + 122
local _, name, txt = WO.week()
panel(20, ky, W - 40, 128)
X.ltext(36, ky + 10, "This week: " .. name, "ui12", "bold")
X.wrapped(36, ky + 44, txt .. ".", W - 70, "small", 2)
local left = week_left()
X.ltext(36, ky + 94, string.format("Next week in %dd %dh", left // 86400, (left % 86400) // 3600), "small", "bold")
X.wrapped(30, ky + 140, "Morning 6-12, day 12-18, evening 18-22, night 22-6 (your reader's clock).", W - 60, "small", 2)
back_btn("title")
end
function C.draw_bounty(S)
local b, done, ok = bounty_state(S)
head(S, "Collector bounty", get("bdone") .. " done")
local y = TOPY() + 6
panel(20, y, W - 40, 250)
X.ltext(34, y + 10, "The Collector wants:", "ui10", "bold")
X.thumb(34, y + 40, b.c, { show = true })
X.ltext(156, y + 44, X.cname(b.c), "ui12", "bold")
X.ltext(156, y + 78, string.format("%s card, level %d+", X.tier_name(b.c), b.need), "small", "bold")
if b.shiny then X.ltext(156, y + 100, "It must be SHINY!", "small", "bold") end
X.ltext(156, y + 124, string.format("You: %s, level %d, %d spare%s", X.owned(b.c) and "owned" or "not owned", S.lvl[b.c], S.spare[b.c], S.spare[b.c] == 1 and "" or "s"), "small")
local left = b.ends - now()
X.ltext(34, y + 170, string.format("Reward: %d coins + %s", b.coins, G.R.BOX[b.box]), "ui10", "bold")
X.ltext(34, y + 200, string.format("Ends in %dd %dh   (every 10 bounties: Mythic box)", left // 86400, (left % 86400) // 3600), "small")
X.button(24, y + 264, W - 48, 74, done and "DELIVERED" or "HAND OVER A COPY", function() bounty_deliver(S) end,
{ off = done or not ok, sub = done and "new bounty soon" or "gives 1 spare copy", id = "BDELIVER", dot = (not done and ok) and "!" or nil })
X.wrapped(30, y + 352, "Level the card by merging copies in the album. Shiny copies come from packs. You keep the card, you only hand over one spare copy.", W - 60, "small", 4)
X.draw_note(y + 440)
back_btn("camp")
end
local SPOTS = { { 0.24, 0.59 }, { 0.47, 0.50 }, { 0.26, 0.28 }, { 0.69, 0.73 }, { 0.81, 0.39 }, { 0.54, 0.22 },
{ 0.35, 0.78 }, { 0.78, 0.84 }, { 0.86, 0.57 }, { 0.64, 0.08 } }
local PAN = { cu = 0.3, cv = 0.55, tu = 0.3, tv = 0.55 }
local MAPZ = 1.5
function C.map_touch(ev, x, y)
if X.scr() ~= "worldmap" or not PAN.box or type(x) ~= "number" then return false end
local b = PAN.box
if ev == "down" then
if smudge.in_rect(x, y, b[1], b[2], b[3], b[4]) then
PAN.d = { x0 = x, y0 = y, u0 = PAN.tu, v0 = PAN.tv, smp = { { x, y, X.millis() } } }; PAN.vu, PAN.vv = 0, 0
else PAN.d = nil end
return false
end
local d = PAN.d
if not d then return false end
if ev == "move" then
local dx, dy = x - d.x0, y - d.y0
if d.moved or dx * dx + dy * dy > 100 then
d.moved = true
PAN.tu, PAN.tv = d.u0 - dx / PAN.su, d.v0 - dy / PAN.sv
PAN.clamp()
end
d.smp[#d.smp + 1] = { x, y, X.millis() }; if #d.smp > 8 then table.remove(d.smp, 1) end
if X.moving then X.moving(600) end
return d.moved or false
end
if ev == "release" then
PAN.d = nil
if d.moved then
local t1, s0 = X.millis(), d.smp[1]
for _, sm in ipairs(d.smp) do if t1 - sm[3] <= 90 then s0 = sm; break end end
local dt = math.max(16, t1 - s0[3])
PAN.vu, PAN.vv = -(x - s0[1]) / dt / PAN.su, -(y - s0[2]) / dt / PAN.sv
if X.moving then X.moving(1500) end
end
return d.moved or false
end
return false
end
local function map3d(S, cp, my)
local mh = math.min(H - my - 380, 390)
if mh < 300 or not X.tilt3d or not X.tilt3d("wmap", 0, -10, 1, 1, 0) then return nil end
local MW, MD = (W - 40) * MAPZ, (W - 40) * 300 / 448 * MAPZ
local tilt = 0.62
local SCL = 1.03
local cy, sa, ca = my + mh * 0.5 + 10, math.sin(tilt), math.cos(tilt)
local FOC = 900
PAN.box = { 0, my, W, mh }
PAN.su, PAN.sv = MW * SCL, MD * ca * SCL
local function ty(v, cv0)
local z = (v - cv0) * MD
return cy + z * ca * (FOC / (FOC - z * sa)) * SCL
end
local function solve(f)
local lo, hi = -0.5, 1.5
for _ = 1, 24 do local m = (lo + hi) / 2; if f(m) then hi = m else lo = m end end
return hi
end
local cvmin = solve(function(c) return ty(0, c) <= my + 70 end)
local cvmax = solve(function(c) return ty(1, c) < my + mh - 24 end)
function PAN.clamp()
local hu = 0.5 * W / PAN.su
PAN.tu = hu >= 0.5 and 0.5 or math.max(hu - 0.03, math.min(1 - hu + 0.03, PAN.tu))
PAN.tv = (cvmin >= cvmax) and (cvmin + cvmax) / 2 or math.max(cvmin, math.min(cvmax, PAN.tv))
end
PAN.clamp()
local now0 = X.millis()
local dt = math.min(60, now0 - (PAN.last or now0)); PAN.last = now0
if not PAN.d and ((PAN.vu or 0) ~= 0 or (PAN.vv or 0) ~= 0) then
PAN.tu, PAN.tv = PAN.tu + PAN.vu * dt, PAN.tv + PAN.vv * dt
local f = math.exp(-dt / 280)
PAN.vu, PAN.vv = PAN.vu * f, PAN.vv * f
local u0, v0 = PAN.tu, PAN.tv
PAN.clamp()
if u0 ~= PAN.tu then PAN.vu = 0 end
if v0 ~= PAN.tv then PAN.vv = 0 end
if math.abs(PAN.vu) + math.abs(PAN.vv) < 0.00002 then PAN.vu, PAN.vv = 0, 0 end
end
local kk0 = 1 - math.exp(-dt / (PAN.d and 50 or 110))
PAN.cu, PAN.cv = PAN.cu + (PAN.tu - PAN.cu) * kk0, PAN.cv + (PAN.tv - PAN.cv) * kk0
local function MP(u, v, h)
local x, z = (u - PAN.cu) * MW, (v - PAN.cv) * MD
local yy = z * ca - (h or 0) * sa
local dep = -z * sa - (h or 0) * ca * 0.2
local k = FOC / (FOC + dep)
return W / 2 + x * k * SCL, cy + yy * k * SCL, k
end
local function quad(u0, v0, u1, v1, h)
local a1, b1 = MP(u0, v0, h); local a2, b2 = MP(u1, v0, h); local a3, b3 = MP(u1, v1, h); local a4, b4 = MP(u0, v1, h)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
if smudge.set_clip then smudge.set_clip(8, my, W - 16, mh) end
local sh = quad(0.02, 0.04, 1.02, 1.04, -8)
if smudge.shade_quad then smudge.shade_quad(sh[1] + 6, sh[2] + 6, sh[3] + 6, sh[4] + 6, sh[5] + 6, sh[6] + 6, sh[7] + 6, sh[8] + 6, 0) end
local top, bot = quad(0, 0, 1, 1, 0), quad(0, 0, 1, 1, -7)
smudge.fill_quad(top[7], top[8], top[5], top[6], bot[5], bot[6], bot[7], bot[8], true, X.TT and X.TT.panel)
smudge.fill_quad(top[3], top[4], top[5], top[6], bot[5], bot[6], bot[3], bot[4], true, X.TT and X.TT.panel)
smudge.fill_quad(top[1], top[2], top[7], top[8], bot[7], bot[8], bot[1], bot[2], true, X.TT and X.TT.panel)
smudge.draw_sprite_quad("art/wmap.raw", 768, 512, top[1], top[2], top[3], top[4], top[5], top[6], top[7], top[8])
for k2 = 0, 3 do
local i, j = k2 * 2 + 1, ((k2 + 1) % 4) * 2 + 1
smudge.line(fl(top[i] + 0.5), fl(top[i + 1] + 0.5), fl(top[j] + 0.5), fl(top[j + 1] + 0.5), 2)
end
local order = {}
for k = 1, NR do order[k] = k end
local dz = {}
for k = 1, NR do local _, sy2 = MP(SPOTS[k][1], SPOTS[k][2], 0); dz[k] = sy2 end
table.sort(order, function(i, j) return dz[i] < dz[j] end)
local t = X.millis()
local lab = {}
for _, k in ipairs(order) do
local s = SPOTS[k]
local open = unlocked(cp, k)
do
local R, n = (k == sel) and 0.058 or 0.048, 14
local cx0, cy0 = MP(s[1], s[2], 0)
local pts = {}
for i = 0, n - 1 do
local a = i / n * 2 * math.pi
local qx, qy = MP(s[1] + math.cos(a) * R, s[2] + math.sin(a) * R * 448 / 300, 0)
pts[#pts + 1] = { qx, qy }
end
for i = 1, n do
local p1, p2 = pts[i], pts[i % n + 1]
smudge.fill_quad(cx0, cy0, p1[1], p1[2], p2[1], p2[2], p2[1], p2[2], false)
end
for i = 1, n do
local p1, p2 = pts[i], pts[i % n + 1]
smudge.line(fl(p1[1] + 0.5), fl(p1[2] + 0.5), fl(p2[1] + 0.5), fl(p2[2] + 0.5), 2)
end
end
if k == sel then
local px, py
for i = 0, 24 do
local a = i / 24 * 2 * math.pi
local qx, qy = MP(s[1] + math.cos(a) * 0.078, s[2] + math.sin(a) * 0.078 * 448 / 300, 0)
if px then smudge.line(fl(px + 0.5), fl(py + 0.5), fl(qx + 0.5), fl(qy + 0.5), 3) end
px, py = qx, qy
end
end
local lift = (k == sel) and (8 + 5 * math.sin(t / 260)) or 0
local bx, by, kk = MP(s[1], s[2], 0)
local _, ty2 = MP(s[1], s[2], lift)
local sz = 92 * kk
local x0, y1 = bx - sz / 2, ty2 + sz * 0.12
local nm = "art/lm" .. k .. (open and "" or "_n")
smudge.draw_sprite_quad(nm .. ".raw", 96, 96, x0, y1 - sz, x0 + sz, y1 - sz, x0 + sz, y1, x0, y1, nm .. "_m.raw")
if not open then
local lx, ly = fl(bx), fl(y1 - sz * 0.45)
smudge.rounded_rect(lx - 10, ly - 4, 20, 16, 3, true); smudge.circle(lx, ly - 7, 6, false, 2)
smudge.rect(lx - 1, ly + 1, 2, 6, true, 1, false)
end
if get("sec" .. k) == 1 then smudge.circle(fl(x0 + sz - 4), fl(y1 - sz + 6), 6, true) end
lab[k] = { fl(bx), fl(y1 - sz - 2), open }
X.reg("REGION" .. k, fl(x0 - 6), fl(y1 - sz - 6), fl(sz + 12), fl(sz + 12), function() sel = k; PAN.tu, PAN.tv = s[1], s[2]; PAN.clamp() end)
end
local taken = {}
local names = { sel }
for k = 1, NR do if k ~= sel then names[#names + 1] = k end end
for _, k in ipairs(names) do
local r, l = REGIONS[k], lab[k]
local txt = l[3] and r[1] or (r[1] .. " (" .. r[2] .. ")")
local lw = X.tw(txt, "small", "bold")
local bx0, by0, bw0, bh0 = l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2
local free = true
for _, o in ipairs(taken) do
if bx0 < o[1] + o[3] + 2 and o[1] < bx0 + bw0 + 2 and by0 < o[2] + o[4] and o[2] < by0 + bh0 then free = false end
end
if free then taken[#taken + 1] = { bx0, by0, bw0, bh0 } end
if free then smudge.rounded_rect(l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2, 6, true, 1, false) end
if free and k == sel then smudge.rounded_rect(l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2, 6, false, 2) end
if free then X.ctext(l[1], l[2] - X.lh("small"), txt, "small", "bold") end
end
local ev = WO.event()
if ev then
for _, k in ipairs({ ev.k, ev.kind == "storm" and ev.k2 or nil }) do
local l = lab[k]
if l then
local bx2, by2 = l[1] + 30, l[2] - 34 + fl(3 * math.sin(t / 300))
smudge.circle(bx2, by2, 12, true, 1, false); smudge.circle(bx2, by2, 10, true)
X.ctext(bx2, by2 - X.lh("small") // 2, (ev.kind == "storm" and k == ev.k) and "x" or "!", "small", "bold", true)
if smudge.tint_circle and X.TT then smudge.tint_circle(bx2, by2, 10, 6, 3) end
end
end
end
if smudge.set_clip then smudge.set_clip() end
smudge.rounded_rect(8, my, W - 16, mh, 12, false, 2)
return mh
end
function C.draw_worldmap(S)
local cp = S.camp
head(S, "World map", secrets() .. "/" .. NR .. " secrets")
local y = TOPY() + 4
local ev = WO.event()
if ev then
local ek = (ev.kind == "storm") and ev.k2 or ev.k
X.button(20, y, W - 40, 40, ev.name:upper() .. "  " .. left_txt(ev), function() sel = ek; X.set_note(ev.txt) end,
{ font = "small", sub = (ev.kind == "storm") and (REGIONS[ev.k][1] .. " closed - " .. REGIONS[ev.k2][1] .. " x2 xp") or REGIONS[ev.k][1], id = "EVBAR", nohelp = true })
y = y + 46
end
local mh3 = map3d(S, cp, y)
local mx, my, mw, mh = 20, y, W - 40, mh3 or 300
if not mh3 then
smudge.draw_sprite(mx, my + 2, 440, 296, "art/wmap_r.raw")
smudge.rounded_rect(mx, my, mw, mh, 12, false, 2)
local taken = {}
for k, r in ipairs(REGIONS) do
local px, py = mx + fl(SPOTS[k][1] * mw), my + fl(SPOTS[k][2] * mh)
local open = unlocked(cp, k)
if k == sel then smudge.circle(px, py - 18, 32, false, 3) end
smudge.draw_sprite(px - 24, py - 42, 48, 48, "art/lm" .. k .. "_r.raw", "art/lm" .. k .. "_r_m.raw")
if not open then
smudge.rect_dither(px - 16, py - 36, 32, 32, true)
smudge.rounded_rect(px - 8, py - 22, 16, 13, 2, true); smudge.circle(px, py - 24, 5, false, 2)
end
if get("sec" .. k) == 1 then smudge.circle(px + 20, py - 40, 6, true) end
local lab = open and r[1] or (r[1] .. " (" .. r[2] .. ")")
local lw = X.tw(lab, "small", "bold")
local bx0, bw0 = px - lw // 2 - 3, lw + 6
local free = true
for _, o in ipairs(taken) do if bx0 < o[1] + o[3] and o[1] < bx0 + bw0 and math.abs(o[2] - py) < X.lh("small") + 2 then free = false end end
if free or k == sel then
taken[#taken + 1] = { bx0, py, bw0 }
smudge.rect(bx0, py + 7, bw0, X.lh("small"), true, 1, false)
X.ctext(px, py + 8, lab, "small", "bold")
end
X.reg("REGION" .. k, px - 30, py - 46, 60, 60, function() sel = k end)
if ev and (ev.k == k or (ev.kind == "storm" and ev.k2 == k)) then
smudge.circle(px + 20, py - 30, 9, true); X.ctext(px + 20, py - 30 - X.lh("small") // 2, (ev.kind == "storm" and k == ev.k) and "x" or "!", "small", "bold", true)
end
end
end
local r = REGIONS[sel]
local py = my + mh + 10
panel(20, py, W - 40, 150)
smudge.draw_sprite(30, py + 8, 96, 96, string.format("art/ms%02d.raw", mart(sel)))
X.ltext(136, py + 8, r[1], "ui12", "bold")
X.button(W - 24 - 96, py + 8, 88, 34, "DROPS", function() ADV.show_drops(region_drops(sel)) end, { font = "small", id = "RDROPS", nohelp = true })
X.wrapped(136, py + 40, r[3], W - 180, "small", 2)
X.ltext(136, py + 88, unlocked(cp, sel) and string.format("Home of the %s", r[6]) or ("Needs total level " .. r[2]), "small", "bold")
X.ltext(136, py + 110, string.format("Skill: %s   Secret: %s", SK[r[5]].name, get("sec" .. sel) == 1 and "found" or "?"), "small")
local by = py + 160
local evb = nil
if ev and ev.k == sel then
if ev.kind == "boss" then
local done = get("evboss") == ev.slot
evb = { "BOSS", function() event_boss(S, sel) end, done and "beaten" or ("Giant " .. r[6]), not done }
elseif ev.kind == "chest" then
local done = get("evchest") == ev.slot
evb = { done and "OPENED" or "CHEST", function() event_chest(S, sel) end, done and "next event" or "open it", not done, done }
elseif ev.kind == "trader" then
local i, n, price = trade_offer(sel)
local left = 3 - ((get("evbuy_s") == ev.slot) and get("evbuy") or 0)
evb = { "TRADER", function() event_trade(S, sel) end, left > 0 and string.format("%d %s %dc", n, ITEMS[i][1], price) or "sold out", left > 0, left <= 0 }
end
end
local closed = ev and ev.kind == "storm" and ev.k == sel
local nb = evb and 3 or 2
local hw = (W - 48 - 10 * (nb - 1)) // nb
X.button(24, by, hw, 64, "EXPLORE", function() explore(S, sel) end, { off = not unlocked(cp, sel) or closed, sub = closed and "storm!" or "20 s trip", id = "EXPLORE" })
X.button(34 + hw, by, hw, 64, enc == sel and "FIGHT!" or "FIGHT", function() region_fight(S, sel) end,
{ off = not unlocked(cp, sel) or closed, sub = r[6], id = "RFIGHT", dot = (enc == sel) and "!" or nil })
if evb then
X.button(44 + 2 * hw, by, hw, 64, evb[1], evb[2], { off = evb[5], sub = evb[3], id = "EVACT", dot = evb[4] and "!" or nil })
end
X.draw_note(by + 70)
back_btn("title")
end
return WO
end
