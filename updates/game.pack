GFX.SKY = {
{ 0, 8, 12, 40, 20, 28, 70, 0.75 }, { 4.8, 14, 16, 52, 48, 40, 90, 0.7 }, { 6.0, 70, 70, 140, 240, 140, 120, 0.62 },
{ 7.5, 110, 150, 215, 250, 205, 170, 0.58 }, { 10, 85, 150, 235, 185, 215, 245, 0.58 }, { 14, 80, 145, 235, 180, 212, 242, 0.56 },
{ 17, 105, 150, 220, 245, 210, 160, 0.58 }, { 19, 90, 80, 160, 255, 130, 60, 0.6 }, { 20.3, 45, 35, 100, 170, 70, 90, 0.68 },
{ 21.5, 12, 16, 50, 34, 34, 80, 0.75 }, { 24, 8, 12, 40, 20, 28, 70, 0.75 } }
function GFX.skycols()
local ok, d = pcall(os.date, "*t", (smudge.time and tonumber(smudge.time())) or os.time())
local h = (ok and d) and (d.hour + d.min / 60) or 12
if GFX.skyh then h = GFX.skyh end
local S = GFX.SKY
local a, b = S[1], S[#S]
for i = 1, #S - 1 do if h >= S[i][1] and h <= S[i + 1][1] then a, b = S[i], S[i + 1]; break end end
local u = (b[1] > a[1]) and (h - a[1]) / (b[1] - a[1]) or 0
u = u * u * (3 - 2 * u)
local c = {}
for j = 2, 8 do c[j - 1] = a[j] + (b[j] - a[j]) * u end
return c
end
function GFX.skylight(by, bh, iy)
if not (GFX.ok() and smudge.glass_sprite_quad and not SAVER) then return false end
local c = GFX.skycols()
local n = 18
local y1 = by + bh
for k = 0, n - 1 do
local u = k / (n - 1)
local y0 = math.floor(by + (y1 - by) * k / n)
local y2 = math.floor(by + (y1 - by) * (k + 1) / n)
local v = math.min(1, u * 1.25)
smudge.glass_sprite_quad("art/one_m.raw", 8, 8, 0, y0, W, y0, W, y2, 0, y2,
math.floor(c[1] + (c[4] - c[1]) * v), math.floor(c[2] + (c[5] - c[2]) * v), math.floor(c[3] + (c[6] - c[3]) * v), c[7])
end
return true
end
function GFX.skyband(by, bh, iy, ph, SP, mx, my)
local t = smudge.millis() / 1000
local fx = GFX.ok()
smudge.rect(0, by, W, bh, ph >= 3)
if ph < 3 then return end
if ph == 3 and fx then
for j = 0, 5 do
local y1 = iy + 30 + j * 14
smudge.glow_quad(0, y1, W, y1, W, iy + 120, 0, iy + 120, 255, 110 + j * 18, 60 + j * 6, 0.16)
end
end
for i = 1, #SP - 1, 2 do
local k = i // 2
if ph == 4 or k % 3 == 0 then
local x, y = math.floor(SP[i] * W), iy + math.floor(SP[i + 1] * 240)
local tw = 0.5 + 0.5 * math.sin(t * (1.1 + (k % 4) * 0.37) + k * 2.3)
if not fx or tw > 0.25 then smudge.rect(x, y, (k % 5 == 0) and 2 or 1, (k % 5 == 0) and 2 or 1, false) end
if fx then smudge.glow_circle(x, y, 3, 255, 250, 220, 2.2 * tw) end
end
end
if ph == 4 then
smudge.circle(mx, iy + my, 9, true, 1, false)
smudge.circle(mx + 4, iy + my - 2, 8, true, 1, true)
if fx then smudge.glow_circle(mx, iy + my, 22, 220, 230, 255, 1.0) end
end
end
