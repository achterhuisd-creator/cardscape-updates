local p, t = dc_prog(S, k)
panel(20, by, W - 40, 92)
X.ltext(34, by + 10, string.format(DC[x["dc" .. k]][1], t), "ui10", "bold")
X.bar(34, by + 48, W - 160, 20, p / t)
X.rtext(W - 34, by + 46, p .. " / " .. t, "ui10", "bold")
end
local by = y + 310
local claimed = x.dcc == 1
X.button(24, by, W - 48, 76, claimed and "CLAIMED TODAY" or "OPEN CHEST", function() dc_claim(S) end,
{ off = claimed or not dc_all(S), sub = claimed and "new challenges tomorrow" or "all 3 done = chest", id = "DCCLAIM", dot = G.dc_ready(S) > 0 and "!" or nil })
X.wrapped(30, by + 90, "Streak bonuses: day 7 two tickets, day 14 a RARE ticket, day 30 three RARE tickets. Miss a day and the streak restarts.", W - 60, "small", 3)
back_btn("rewards")
end
local CB = dofile("combat.lua")(X, K, C, ADV, G)
ADV.CB = CB
for _, n in ipairs(CB.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(CB.PARENT) do G.PARENT[k] = v end
local R = dofile("rsps.lua")(X, K, C, ADV, G)
G.R = R; ADV.R = R
for _, n in ipairs(R.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(R.PARENT) do G.PARENT[k] = v end
local SF = dofile("safe.lua")(X, K, C, ADV, G)
G.SF = SF; ADV.SF = SF
for _, n in ipairs(SF.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(SF.PARENT) do G.PARENT[k] = v end
if GFX and GFX.ok and smudge.draw_sprite_quad then
local CA = dofile("casino.lua")(X, K, C, ADV, G)
G.CA = CA; ADV.CA = CA
for _, n in ipairs(CA.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(CA.PARENT) do G.PARENT[k] = v end
end
local WL = dofile("wilds.lua")(X, K, C, ADV, G)
G.WL = WL; ADV.WL = WL
for _, n in ipairs(WL.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(WL.PARENT) do G.PARENT[k] = v end
local WO = dofile("world.lua")(X, K, C, ADV, G)
G.WO = WO; ADV.WO = WO
for _, n in ipairs(WO.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(WO.PARENT) do G.PARENT[k] = v end
function G.times(S, t0, t1, add)
for s = t0 // STAR_SLOT, t1 // STAR_SLOT + 1 do add(s * STAR_SLOT + fl(hash01(s, 7) * 3600)) end
for s = t0 // WB_SLOT, t1 // WB_SLOT + 1 do add(s * WB_SLOT) end
local x = S.camp.x
for k = 1, 3 do if x["w" .. k .. "c"] ~= 0 then add(x["w" .. k .. "t"] + 8 * 3600) end end
if WO.times then WO.times(t0, t1, add) end
end
return G
end
handkit.lua
3423
return function(X, H)
local K = {}
local W, Hh = X.W, X.H
local fl = math.floor
K.PX = 464 / 256
K.PHONE = smudge.smooth == true
function K.hd() return K.PHONE and GFX and GFX.ok and GFX.ok() and smudge.hires_quad end
function K.busy() if not K.PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
function K.snd(n, v) if SND then SND.play(n, v) end end
function K.vib(p) if VIB then VIB.play(p, true) end end
function K.layout(y)
local by = Hh - 96 - 60
local ry = by - 62
return { x = fl((W - 464) / 2), y = y, w = 464, h = ry - 6 - y, ry = ry, by = by }
end
function K.tile(nm, x0, y0, x1, y1)
local lx, rx = x0 + 0.75, x1 - 1.75
smudge.hires_quad(nm, lx, y0, rx, y0, rx, y1, lx, y1, x0, y0, x1, y0, x1, y1, x0, y1)
end
function K.pic(nm, pw, ph, cx, cy, w, ang, ax, ay)
local s = (w or pw * K.PX) / pw
local qw, qh = pw * s, ph * s
local x0, y0 = -(ax or 0.5) * qw, -(ay or 0.5) * qh
local c, sn = math.cos(ang or 0), math.sin(ang or 0)
local function R(dx, dy) return cx + dx * c - dy * sn, cy + dx * sn + dy * c end
local a1, a2 = R(x0, y0); local b1, b2 = R(x0 + qw, y0); local c1, c2 = R(x0 + qw, y0 + qh); local d1, d2 = R(x0, y0 + qh)
local o = -9
smudge.hires_quad("^hd/" .. nm .. "_c.png", o, o, o, o, o, o, o, o, a1, a2, b1, b2, c1, c2, d1, d2)
return qw, qh
end
function K.pill(cx, y, txt, font)
font = font or "ui10"
local tw = X.tw(txt, font, "bold") + 18
smudge.rounded_rect(fl(cx - tw / 2), fl(y), tw, 26, 9, true, 1, false)
smudge.rounded_rect(fl(cx - tw / 2), fl(y), tw, 26, 9, false, 2)
X.ctext(fl(cx), fl(y + 3), txt, font, "bold")
end
function K.ring(cx, cy, r, wd)
smudge.circle(fl(cx), fl(cy), fl(r), false, wd + 2)
smudge.circle(fl(cx), fl(cy), fl(r), false, wd, false)
end
function K.picker(L, ry, k, title, sub, step, idp)
X.button(24, ry, 52, 56, "<", function() step(-1) end, { font = "ui12", id = idp .. "PREV", nohelp = true })
X.button(W - 76, ry, 52, 56, ">", function() step(1) end, { font = "ui12", id = idp .. "NEXT", nohelp = true })
smudge.rounded_rect(82, ry, W - 164, 56, 10, false, 1)
X.ctext(W // 2, ry + 4, title, "ui10", "bold")
X.ctext(W // 2, ry + 30, X.fit(sub, W - 180, "small"), "small")
end
function K.why_not(cp, si, r, skill)
if H.slevel(cp, si) < r[2] then return "You need " .. skill .. " level " .. r[2] .. "." end
if r[6] and not H.have_item(cp, r[6]) then return "You need a " .. H.ITEMS[r[6]][1]:lower() .. " (General store in the SHOP)." end
if not H.can_make(cp, r) then return "Missing materials: " .. H.need_text(cp, r) .. "." end
return nil
end
function K.tline(ax, ay, bx, by, w, ink)
local dx, dy = bx - ax, by - ay
local d = math.sqrt(dx * dx + dy * dy)
if d < 0.5 then smudge.circle(fl(ax), fl(ay), fl(w / 2), true, 1, ink); return end
local nx, ny = -dy / d * w / 2, dx / d * w / 2
smudge.fill_quad(ax + nx, ay + ny, bx + nx, by + ny, bx - nx, by - ny, ax - nx, ay - ny, ink)
smudge.circle(fl(bx), fl(by), fl(w / 2), true, 1, ink)
end
function K.addnote(extra)
local n = X.get_note and X.get_note() or ""
X.set_note((n ~= "" and (n .. "  ") or "") .. extra)
end
function K.pop(L, P, t)
if not P or t - P.t0 > 1300 then return false end
local v = (t - P.t0) / 1300
local tw = X.tw(P.text, "ui12", "bold") + 20
smudge.rounded_rect(fl(L.x + L.w / 2 - tw / 2), fl(L.y + L.h * 0.3 - 30 * v), tw, 30, 10, true)
X.ctext(fl(L.x + L.w / 2), fl(L.y + L.h * 0.3 + 4 - 30 * v), P.text, "ui12", "bold", true)
return true
end
return K
end
help.lua
45012
local H = {
friends = { "Friends", "Share with a friend, without internet: the game turns a gift or your deck into a short code. Send it any way you like (a message, a note); your friend types it in with ENTER A CODE.\nGIFT COINS: pick the amount with - and +. Items: open the BANK, tap an item, GIFT (the x1 / x5 / ALL button sets how many). Cards: open a card in the ALBUM, GIFT gives one spare copy. What you give leaves your game at once; every code works only once per game.\nDUEL CODES: MY DUEL CODE shows your deck (3 cards with their attack and HP) as a code. Your friend fights your 3 cards one by one (best of 3). The first win against a code gives 100 coins and a pack ticket.\nBookworm (on the reader): every 30 minutes you read a book gives a pack ticket, every 4th one a RARE ticket. Only minutes with a page turn or touch in the last 3 minutes count." },
codeentry = { "Enter a code", "Type the letters of the code on the QWERTY keyboard (numbers on top); dashes don't matter. Codes use 2-9 and A-Z without I and O, so there is no 0/O or 1/I to mix up. A gift code has 15 letters, a duel code 20. OK checks it: a typo is caught, and you can fix it with DELETE." },
duel = { "Duel result", "Best of 3 against your friend's deck. FIGHT AGAIN plays it once more (the prize only comes with the first win against a code). Send your own duel code so they can fight back." },
away = { "Welcome back", "What happened while you were away: crops and expeditions that finished, GE offers, missions and more, plus your Bookworm tickets for reading on the reader. Tap a line to go there, or CONTINUE for the home screen. Everything also stays in the notifications (tap the top bar)." },
frames = { "Gold frames", "Pure decoration for rich collectors: a gold frame around a card you own, shown everywhere the card is (album, fights, showcase). It costs coins by rarity: common 10k, uncommon 20k, rare 50k, legendary 100k, exotic 250k, mythic 500k, secret 1M. Tap a card twice to buy. Frames give no stats." },
ourpet = { "Our pet", "One pet for two players: you both see the same pet and what the other did (on the reader the care is sent at the next sync).\nFEED fills Food, PLAY fills Fun (and makes it a bit hungry), CLEAN fills Clean, PET cheers it up a little, TREAT gives it food from your bank (lots of Food and a little Fun). Food is empty after a day, Fun after 18 hours, Clean after a day and a half; the app can notify you when one gets low. At night (23:00-7:00) it sleeps.\nCare gives xp (once per 15 minutes per action and player): the egg hatches, and your pet grows from baby to young to grown-up.\nTOGETHER: on a day you both took care of it, you each claim a pack ticket. Days in a row together make a streak: 3, 7, 14, 30, 60 and 100 days give rewards.\nGIFT: once a day a happy pet (everything over 60%) brings you coins, sometimes a pack ticket.\nWISH: every day the pet has its own wish for each of you (feed it twice, a bath, hide and seek...). Make it come true for coins, sometimes a ticket.\nHIDE & SEEK: the pet hides in the box, the plant or the basket. Find it: it counts as playing, and the first 3 finds a day give coins.\nTap the pet itself and it reacts. A level-up or growing up is celebrated with confetti.\nSettings (repository, token, your name): the app's menu (top left) > Settings > Our pet." },
title = { "Home", "CardScape: collect cards, fight with them and build up your camp.\nPACKS opens card packs, ALBUM shows your collection, QUEST and TOWER are card fights for coins, CAMP is the RuneScape-style part with skills, bank, adventure and more. DECK picks the 3 cards that fight together.\nTap one of the four cards at the top to show off a card of your own (BEST 4 fills them with your rarest cards).\nTap the top bar for notifications and your task tracker.\nSEARCH (the bar at the top of every ? help): type any item, monster or boss to see where to get it, every drop chance and what it is used for.\nThe device Home button always brings you back here. Quit the game in Settings (the cog). FRIENDS: gift codes and duel codes to share with a friend." },
grading = { "Card grading", "Send up to 3 cards to the grader at once; each comes back after 30 minutes (real time, nothing speeds it up): tap COLLECT. The first grading gives a grade from 1 to 10 (most cards get 4-7, a 10 GEM MINT is rare). Every 2 grade points give the card +1 ATK in fights (grade 10: +5).\nSend a graded card again to try for a higher grade: from grade 1 it goes up 80% of the time, from 5 40%, from 8 15%, from 9 only 6%. It never goes down. Grading is free: it only takes the 30 minutes, and while a card is away you can't use it anywhere (fights, deck, pet, expeditions, workers).\nBREAK CASE (switch at the top, then tap a graded card twice): the grade is gone, and it costs one copy of the card: a spare, or if you have no spares the card itself (back to not found; you get a warning first).\nThe grade shows on the card everywhere; in the big 3D view the card sits in a grading case with its grade on the label." },
packs = { "Booster packs", "Each pack has 3 cards; the 3rd is always UNCOMMON or better. Pay 30 coins (or open x5 / x10 at once), or use pack tickets and RARE tickets.\nGet coins from quests, the tower, selling items in the bank and camp tasks. Tickets come from levelling skills, diaries, bosses, raids and daily streaks.\nELEMENT PACK (70 coins) only gives cards of one element.\nGRADING (free): send a card to the grader (30 minutes, real time). It comes back with a grade 1-10: +1 ATK per 2 grade points. Send it again to try for a higher grade; the higher it is, the smaller the chance it goes up (it never goes down)." },
elempack = { "Element pack", "Pick an element: all 3 cards will be that element. Costs 70 coins. Handy to finish an element set or to get strong cards against an enemy element." },
reveal = { "Opening packs", "Tap to flip each card. New cards go into your album; duplicates become spare copies, which you can merge in the album to level a card up or turn into dust." },
album = { "Album", "All 153 cards, by tier tab (COM ... MYTH, ??? = secret). Every rarity has 24 cards (three series, the newest is the winter set Frostfall): scroll down for the rest (or tap the tab again). Tap a card to see its stats.\nCards come from packs. Missing ones can also be crafted with dust on the card page (not secret cards).\nThe dots under a card are its level (max 5). FILTER shows owned, missing, spares, shiny or one element." },
detail = { "Card", "Stats, element and level of one card.\nLevel up: merge spare copies (copies per tap: ONE / ALL) or train it in the camp. At level 5 you can ASCEND with dust, spare copies and Boss scales for extra ATK and HP.\nNot owned yet? CRAFT it with dust (dust comes from levels, selling spares, diaries and bosses). Secret cards only drop from packs (1 in 10 million)." },
quest = { "Pick a fighter", "Choose the card that fights this enemy. Element advantage doubles your damage: the dots on the tabs show how many of your cards are strong here.\nStrong/weak chain: FIRE > NATURE > EARTH > STORM > WATER > FIRE and SHADOW > DREAM > LIGHT > SHADOW." },
battle = { "Card battle", "ATTACK deals your ATK (x2 against a weak element). GUARD heals and halves the next hit. SPECIAL costs 3 energy for a double hit (energy fills each turn). PRAY halves boss hits but uses prayer points (refill at the Altar or with prayer potions).\nWins give coins and card xp. RETREAT ends the fight without a reward." },
deck = { "Deck & sets", "Choose 3 cards for your deck. Team spirit: a deck card in a fight gets +1 ATK and +2 HP for every other deck card.\nSETS: own all cards of a set for a permanent bonus." },
sets = { "Sets", "Each set is a group of cards. Collect every card of a set to complete it and get its bonus forever." },
stats = { "Statistics", "Your totals: coins earned, packs, wins, tower floor and collection. CAMP & ADVENTURE shows the hiscores for skills, bosses, quests and clues." },
settings = { "Settings", "Battery saver turns off animations and shadows for fewer screen refreshes.\nCLEANUP adds a black clean-up flash every 40 screens against ghosting (off = never; needs the CardScape firmware).\nGLINT and RIPPLE (phone) turn the light running over buttons and the ring where you tap on or off.\nQUIT GAME saves and closes CardScape (back to the reader).\nRESET PROGRESS deletes everything (asks twice)." },
cardpick = { "Pick a card", "Tap a card you own. It is used for the slot you came from (deck, worker, expedition, training or pet)." },
camp = { "Camp", "Your base: the RuneScape part of the game. SKILLS: train 21 skills. BANK: everything you store. INVENTORY: 28 slots of what you carry and wear. HOUSE: build rooms with lasting perks. WORKERS: cards that gather while you're away. TRAINING gives card xp. CARD BUDDY follows you. EXPEDITION sends cards out for loot. MISSIONS give coins for deliveries. SHOP has daily deals and real shops. MARKET is a live price chart for trading. BOUNTY: the Collector's card requests. ADVENTURE: quests, slayer, bosses, raids and more. REWARDS: daily bonus, challenges, goals, diaries, collection log, loot boxes and perks. CASINO (phone): roulette, blackjack and the slot machine, for coins.\nThe bag bar at the top shows how full your inventory is (like RuneScape, gathering fills it). Tap it on any camp screen for the QUICK INVENTORY: drink, wear, DEPOSIT your loot or go to the BANK." },
skills = { "Skills", "21 skills, each up to level 99, like RuneScape. Gathering puts 1 item in your inventory per success. Everything you gather stacks in one slot, like runes; every try can fail, less often with a higher level and (Woodcutting/Mining) a better axe or pickaxe; Fishing and Hunting get the same boost from your level alone (at 6, 21, 31, 41 and 61). When your inventory is full, tap BANK. Making skills use materials from your bank. Combat skills (Ranged, Melee, Block, Magic) train in fights.\nTools: axes and pickaxes (Smithing at the anvil, each needs a level to use; better trees and rocks need a better one: Willow and Coal an Iron one, Maple and Mithril Steel, Yew and Adamant Mithril, Magic Adamant, Elder and Dragon Rune, Ancient and Celestial Dragon), fly rod and harpoon for Fishing. Nets, lobster cages, snares and traps are equipment: buy or make one once and keep it forever (they are expensive in the SHOP).\nNo xp boosts or level rewards except skilling outfits (Lumberjack, Prospector, Angler: +2.5% each full set); level 99 gives the skill's cape. PRESTIGE (under the skills): a skill at level 99 can start again at level 1 for lasting bonuses (more xp and extra drops)." },
bank = { "Bank", "Everything you gather or make lands here. Tabs filter by type (logs, ore, food, potions, gear, runes, misc); the search bar finds items by name or description (tap it for a keyboard, X clears it). Tap an item for its info: what it does and where to get it. SELL gives coins (market goods sell at the market price). TAKE moves items to your inventory: food and potions only work from your inventory, gear is worn from there. The amount button switches x1 / x5 / ALL. DEPOSIT empties your inventory into the bank. Tools and supplies sell back for 40% of their price. The bank holds 99 of each item at first; UPGRADE opens a panel that shows what you have, the next step and its cost; buying raises that: 250 for 1,000 coins, 1,000 for 10,000, 5,000 for 50,000, 25,000 for 250,000, 100,000 for 1M and 1M for 5M. ALCH = High Alchemy (Magic 21, 1 nature + 3 fire runes) turns items into coins." },
gear = { "Inventory", "28 slots like RuneScape, plus your 5 worn slots. Gathering fills it; DEPOSIT puts your loot in the bank (food, potions, tools, supplies and gear stay).\nTap an item: DRINK prayer potions, EQUIP gear (needs a level: weapons the skill of their style, armour Block), put it back in the BANK or DROP it. Tap a worn slot to REMOVE or UPGRADE it (+1..+10 with bars and dust, can fail).\nFood and combat potions are used in fights, raids and Wintertodt from here." },
missions = { "Missions", "Deliver the items asked for coins, dust and tickets. A new mission replaces each delivered one; SKIP swaps one you don't like. Items come from your bank: gather or make them first." },
daily = { "Daily", "Claim a daily bonus every day for a 7-day streak (miss a day and it restarts). The daily mission pays double when you deliver the item." },
expedition = { "Expeditions", "Send a card away for 30 min, 2 h or 4 h. Its element decides the loot (ores, fish, crops, hunter drops, bars, dust, logs or coins); higher tier cards bring back more. Collect when it's back." },
expsend = { "Send out", "Choose how long the card goes away. Longer trips bring back more." },
training = { "Training", "Spend 5 coins for +3 card xp on any card you own. Merging duplicate cards in the album is faster, but training works on every card." },
shop = { "Shop", "DEALS: the trader changes stock every day (resources, a rare bit and a card); each offer once per day, not in Iron Mode.\nThe real shops, like RuneScape: GENERAL (knife, tinderbox, hammer, chisel, vial), FISHING (small net, feathers, lobster cage, big net), HUNTER (snare, pit trap, net trap: equipment, bought once and kept forever) and HERBS (Apothecary: vials and potion secondaries). They sell at the market price and put everything in your bank." },
pet = { "Pet", "Choose a card as your pet. It follows you around camp and gives a chance of +1 item on every gather; higher tier cards give a bigger chance. Skilling pets (like the Beaver) are different: a rare drop while training a skill, just for show like in RuneScape." },
market = { "Market", "Live prices that move every 15 minutes, like crypto. Buy low, sell high: tap an item for its chart, BUY 1/10 and SELL. Categories on the side, sorted by value.\nPORTFOLIO shows what you bought and your profit. GE offers (BID/ASK) fill by themselves when the price reaches your offer." },
mktitem = { "Market item", "The chart shows the price over time. BUY and SELL trade at the current price (+10% when buying). GE BID buys 10 when it dips 15%, GE ASK sells when it rises. Your bank sells market goods for the same market price." },
achieve = { "Trophies", "Goals for skills, cards, fights and more. Claim a finished trophy for coins, dust and tickets. Track one in the notification bubble with + TRACK." },
tasks = { "Slayer master", "Get a Slayer task (kill N of a monster) and fight them yourself: FIGHT uses your own Melee / Ranged / Magic combat. Monsters drop coins, resources, runes and rare uniques. Finish the task, then CLAIM the reward (coins/dust/ticket + Slayer points).\nSKIP costs points; the SLAYER SHOP sells helms, rerolls and more. Higher Slayer levels unlock tougher monsters, up to the Rune Serpent at level 99." },
slayshop = { "Slayer shop", "Spend Slayer points (from finished tasks) on items and perks. Points go up with your task streak." },
inbox = { "Notifications", "All your notifications and the tracker. Tap one to jump to it." },
trackpick = { "Track", "Pick what to follow in the TRACKER tab of the notification bubble: Slayer task, missions, quests, clues, trophies, crops, expeditions, GE offers, card grading or your pet (up to 18)." },
portfolio = { "Portfolio", "What you bought on the market, what you paid and what it's worth now. Realised profit counts sales." },
geoffers = { "GE offers", "Your open Grand Exchange offers. BID buys 10 items when the price drops to your offer, ASK sells when it climbs. They fill by themselves, even while the app is closed. Place them on a market item page." },
adventure = { "Adventure", "Going out and fighting: QUESTS (journal), BOSSES (lairs), WILDERNESS (risky fights), SLAYER (tasks), CLUES, MINIGAMES, WORLD BOSS (every 1.5 h), SHOOTING STAR, RAIDS, WINTERTODT and the ALTAR (restore prayer). (House and workers are in the camp; loot, perks, diaries and challenges under Camp > REWARDS.)" },
customtheme = { "Custom theme", "Pick a colour and a dark or light ground: the whole game takes four shades of it. EVERY COLOUR (phone) lets you change each part on its own: the background and its text, panels, buttons (face, text, rim and edge), the top bar, pop-ups, bars, unavailable buttons and the cards' paper and lines. Tap a part, then a colour in the palette; it changes at once. A star marks the parts you changed; RESET ONE puts the chosen part back, RESET ALL all of them." },
customcolors = { "Every colour", "Tap a part at the top (the > shows which one), then a colour in the palette below: the game changes at once, this screen too. Parts with a star are your own colours. RESET ONE: the chosen part back to the theme's colour. RESET ALL: every part back. DONE: back to the custom theme." },
wilds = { "The Wilds", "A world of your own to walk in (phone). Left thumb: the stick (anywhere in the lower left of the world) walks you. Right thumb: the round action button does what fits the tile in front of you with what you hold; hold it to keep going. THE HOTBAR (bottom): 7 slots; tap one to hold it; drag slots to swap them, pull one up off the bar to empty it. BAG: everything as pictures (tools, food, things to build, seeds, things you found): drag one onto the bar, or tap it to put it in the slot you hold. HAND: chop, mine, pick berries, harvest, catch rabbits and deer, break what you built, craft at a workbench, open a chest, sleep in a bed. HOE: till grass or dirt. Seeds: sow on tilled soil (coins and your Farming level). Build pieces: walls, floor, door, workbench, chest, bed, torch, stone path (the number is how many you can build). Food: berries, crops and cooked meat fill your hunger (empty, you walk slower). CRAFT: the workbench by hand (4 logs); at a workbench everything else: walls, floor, door, stone path, bridge, chest, bed, torches, fishing rod, furnace, shovel, bucket. What you build is crafted first; the bag shows only what you have. Chopped trees grow back as little trees. SEEDS are things in your bag: harvesting a crop gives seeds back (berry bushes sometimes a potato seed). SHOP CART (6 logs, 2 copper): buy seeds, sell what you gathered. WAYPOINT FLAG (2 logs, 1 fur): pick its colour; it shows on the MINIMAP (top corner: your house, flags, shop carts, the other player; far flags wait at its edge). SETTINGS: the minimap\'s size (or off) and its corner. Tap the minimap: the whole map (drag it, + and -, ME; tap: a marker; standing at a flag, tap another flag: travel there). Flags list your other flags: TRAVEL. Weather changes every few minutes (clear, cloudy, rain): its sign sits on the minimap's corner; out here you hear wind and birds, crickets at night, the rain. FLOORS: craft a LADDER (4 logs) or STAIRS (8 logs), build it, and walk onto it: up you go. Upstairs, walk onto the hatch (or push into nothing while standing on it): down. HAND on a ladder or stairs breaks it. Up there: build floor on top of your walls (a floor needs a wall under it or a floor next to it), then walls, beds, chests on it; the hatch takes you DOWN. Up to two floors above the ground; the world below looks dithered. The power button opens the menu: CONTINUE, CHARACTER (boy or girl, hair and shirt colours), SETTINGS (joystick stays put or follows your thumb, left or right hand, name tags), QUIT. FURNACE (place it, HAND opens it): bronze and iron bars, cooked meat (rabbits and deer drop raw meat), coal from logs; a log of fuel each, xp to Smithing, Cooking, Firemaking. SHOVEL: dig a hole (you keep the ground as a block: dirt, sand, grass). Blocks (BUILD them from the bar): fill holes and water, or cover ground. BUCKET: scoop water, pour it into a hole. BRIDGE (3 logs): over water and holes. Day and night every 20 minutes. The power button (top left) saves and leaves. MY WORLD is yours; OUR WORLD is shared live with the other phone (the app from 6.8.0 and your relay: see the README): you see each other walk, and what one of you builds, digs or plants is there for both (bags, drops and animals stay your own). PAIRING: the relay\'s name, one 12-letter code for both phones (NEW CODE on one, type it on the other), your name. The world remembers what you changed." },
safe = { "Crack a safe", "Thieving. Pick a safe (higher Thieving level: more numbers, bigger loot). It works like a real safe: turn the wheel the way the top line says (LEFT < for the 1st, 3rd and 5th number, like a real safe; RIGHT > for the others) until it clicks, then turn back the other way: the number where you stopped is locked in, and a bolt slides back if it was right. Now look for the next number turning that other way, and so on; the last one locked in opens the door. Close is fine on the easier safes (a number or two either side); the royal treasury and the dragon vault want it exact. Phone: grab the wheel and turn it with your finger; every number you pass ticks (a tiny buzz), the right one clicks (a different buzz), there's no time limit. Reader: << < > >> turn it (the big steps stop at the click). Three wrong numbers: caught, stunned for 5 seconds. STREAK: every safe opened in a row gives 10% more coins and xp, up to 3x; getting caught ends it." },
casino = { "Casino", "Play for coins: ROULETTE, BLACKJACK and the SLOT MACHINE. Tap a table in the picture or a button. Bets come out of your coins straight away, winnings fly back into the counter. Below: what you have won and lost here, and your best single win. (Phone only.) Like a real casino the house wins a little over time: play for fun." },
roulette = { "Roulette", "Pick a chip (10 to 5000, or your own amount: tap the 7th chip twice and type it), then tap the table to bet: a number pays 36x, a column (2:1) or a dozen (1st, 2nd, 3rd 12) pays 3x, red/black, even/odd, 1-18/19-36 pay 2x. Tap a box again to add more. SPIN: the ball runs round, drops and bounces into a pocket. Green 0 beats every outside bet. CLEAR takes all your chips back before the spin, UNDO the last one, AGAIN repeats the last bets. The last numbers stand on the left of the table." },
blackjack = { "Blackjack", "Pick a chip (the 7th is your own amount: tap it twice and type it) and DEAL. Get closer to 21 than the dealer without going over. Number cards count their number, J, Q, K count 10, an Ace counts 11 or 1 (a 'soft' hand). HIT: another card. STAND: the dealer turns over the hidden card and draws to 17. DOUBLE (first two cards only): double your bet for exactly one more card. Win pays 2x your bet back, a push gives your bet back, a blackjack (Ace + a 10) pays 3 to 2." },
slots = { "Slot machine", "Set your bet with < and > (tap the bet to type your own) and press SPIN; tap SPIN (STOP) or the reels while they turn to stop them at once. Hold SPIN until its bar fills: AUTO, it plays by itself until you tap SPIN again. Five lines share your bet: three of a fruit, the bell or BAR on a line, or the first two, pay what the table says. WILD (the diamond) counts as any of them; landing in the very middle it EXPANDS over the whole middle reel. STARS anywhere: two pay your bet back, three start 8 FREE SPINS in which every WILD that lands STICKS until they end. The 7s are the JACKPOTS (on the panel, in coins at your bet; GRAND ticks up all the time): two at the start of a line MINI, one on every reel MAJOR, three on a line GRAND. Three BELLS anywhere: the BELL BONUS, pick 3 of 9 chests. Two of a kind already on a line and the last reel keeps you waiting. After a losing pull, now and then: HOLD (tap up to two reels) or NUDGES (tap a reel to move it one down). After a win: GAMBLE it, red or black. Tap the table's title for your RECORDS and today's three MISSIONS (rewards: times your average bet today). Over time a little more comes back than you bet (about 104%), though it comes in streaks." },
fortune = { "Wheel of Fortune", "Set your bet (< and >, or tap it to type your own) and press SPIN. The wheel turns, the pegs tick past the red pointer and it slows down: where it stops is what you get back, x0, x0.5, x1, x1.5, x2 or the gold x10. 24 segments, each as likely: 10 x0, 5 x0.5, 5 x1, 1 x1.5, 2 x2, 1 x10, so on average 96% of your bet comes back. Your last ten spins show under the wheel." },
rewards = { "Rewards", "Everything you collect or work towards: DAILY BONUS (streak and the daily mission), CHALLENGES (3 a day), GOALS (trophies to earn), DIARIES (area tasks), COLLECTION LOG, LOOT BOXES (boxes, wheel, forge) and PERKS (login calendar, prestige, luck, titles, instances, iron mode, mega pets)." },
quests = { "Quests", "Story quests with steps: deliver items, win fights, reach levels or beat a boss. Each quest gives rewards and quest points; some unlock boss lairs (e.g. Dragon Slayer)." },
questinfo = { "Quest", "The current step of this quest. Do what it asks, then come back to continue. Items are taken from your bank." },
lairs = { "Boss lairs", "Card fights against bosses with special moves (fire breath, healing, burrowing, changing element...). Some need a quest or Slayer level first. Each has a unique drop and counts its kills (KC)." },
wild = { "Wilderness", "Risky card fights: double coins and better clue drops, but if you lose you drop half of 3 random bank stacks. Deeper levels are harder and pay more." },
clues = { "Clue scrolls", "Easy, medium and hard clues drop from gathering, fights, Slayer, bosses and the Wilderness. Do the steps to open a casket with coins, items and clue uniques (berets, boots, third-age...)." },
colog = { "Collection log", "Every unique item you can find: pets, capes, boss drops, clue items, raid purples and more. Owned ones show their icon." },
house = { "House", "Build rooms with planks (Construction), bars and coins. Each room gives a lasting perk: faster crops, double meals, a workshop that sometimes saves materials, a chapel (prayer), free teleports, nests and gems x2, and rooms that give +10% xp to their skills (the Throne room: +3% in all)." },
minigames = { "Minigames", "FISHING TRAWLER: 6 rounds at sea for fish, Fishing xp and Angler pieces. BARBARIAN ASSAULT: your deck fights up to 10 waves; Honour buys rewards like the Fighter torso." },
trawler = { "Fishing Trawler", "Pick the right fix each round (leaks, nets, waves). A good trip gives more fish, Fishing xp and a chance at Angler pieces (the full set gives +2.5% Fishing xp)." },
ba = { "Barbarian Assault", "Your 3 DECK cards fight up to 10 waves of Penance. The further you get, the more Honour you earn; spend it on rewards." },
hiscores = { "Hiscores", "Your camp records: skill levels, total level, boss kill counts, quests and clues." },
worldboss = { "World boss", "A boss spawns every 90 minutes and stays 30 minutes. Fight it yourself (Melee / Ranged / Magic, Block, Eat, Pray). Its HP stays down between your fights. A kill gives coins, dust, a RARE ticket, a Silver box and a 1 in 8 unique. ARMOURY picks your weapons." },
star = { "Shooting star", "Every 3 hours a star lands for 45 minutes. Mine it (higher layers need more Mining) for stardust. Spend stardust in the STARDUST SHOP: Prospector outfit pieces (+Mining xp), rare ores, tickets and star gear." },
starshop = { "Stardust shop", "Trade stardust from shooting stars for potions, rare ores, RARE tickets, star gear and the Celestial ring." },
workers = { "Card workers", "Put up to 3 cards to work: they gather while you're away (up to 8 hours). Higher tier and level cards gather faster. SKILL switches what they gather, COLLECT takes the loot." },
diary = { "Achievement diaries", "Each area has Easy/Medium/Hard/Elite tasks: get all its skills to the level shown. Claim for coins, dust and tickets." },
challenges = { "Daily challenges", "3 new challenges every day. Finish all 3 and open the chest for coins, dust and a Bronze box. Keep a streak for tickets on day 7, 14 and 30." },
fight = { "Your fight", "DROPS shows every drop of this monster with its chance (1/N), including uniques, herbs, boxes and pets. You fight with your own skills: MELEE, RANGED and MAGIC (needs runes) deal damage; the enemy's weak style does x1.5. BLOCK raises your block chance and heals a little. ITEMS opens your inventory in the fight: eat food or drink potions (Healing +30 / Super healing +60 HP, Attack +15% damage, Overload +30% damage but -10 HP, Prayer and Super restore refill prayer). Using an item takes your turn. Take them from the BANK into your inventory before the fight. PRAY halves hits using prayer points.\nDamage trains the style you use; hits you take train Block." },
raid = { "Raid", "5 rooms in a row. Your HP carries over between rooms, so take food in your inventory. Clear all 5 for a chest with a 1 in 12 purple (Twisted bow, Kodai wand, Dragon claws, Ancestral robe), plus boxes and a chance at an Instance token." },
todt = { "Wintertodt", "A skilling boss. CHOP roots (Woodcutting), FLETCH them into kindling (Fletching), FEED the brazier (Firemaking), FIX or LIGHT it when it breaks or goes out, EAT (from your inventory) when the cold hurts. Points pay a supply crate; 500+ points can give Pyromancer pieces, Lumberjack pieces (+Woodcutting xp) and the Phoenix pet." },
alch = { "High Alchemy", "Turn an item into coins: Magic 21, 1 nature rune + 3 fire runes per cast. Market goods alch for the market price, other items for 1.3x their value. Make runes with Runecrafting." },
armoury = { "Armoury", "Choose the weapon for each style: melee weapons, bows and staffs you own (bank or worn). Upgrades count. Better weapons raise your max hit." },
loot = { "Loot", "Open Bronze, Silver, Gold and Mythic boxes and Crystal chests (with keys). They drop from Slayer, world bosses, raids, Wintertodt, challenges, the wheel and login days. Mythic boxes can even hold a secret card.\nWHEEL: 1 free spin a day. FORGE: 3 of the same gear -> a better piece." },
reel = { "Prize reel", "The reel spins and stops on your prize. It is already yours: OPEN ANOTHER if you have more boxes." },
wheel = { "Wheel of Fortune", "One free spin a day; login days give extra spins. Prizes: coins, dust, boxes, keys, potions and Instance tokens." },
forge = { "Upgrade forge", "Combine 3 of the same gear piece plus coins for a random better piece of the same slot. Success is 60% (more with luck); a fail keeps 1 of the 3." },
perks = { "Perks", "LOGIN calendar, LUCK gear, TITLES from kill counts, INSTANCES (private boss rooms), IRON MODE and MEGA PETS." },
login = { "Daily login", "Claim once a day. 28 days of rewards with a big chest on day 28 (Mythic box, Gold box, 3 RARE tickets, 500 dust). Missing a day sets you back 3 days." },
luck = { "Luck gear", "Ring of wealth (Boss scales, from bosses) and Amulet of luck (stardust, from shooting stars). Each level is +2% luck: rare drops, pets, purples and box prizes come easier." },
titles = { "Titles", "Kill counts for world bosses, raids, Wintertodt and Slayer. Milestones unlock a title (shown on Adventure) and +2% damage against that boss per milestone. WEAR one you like." },
instance = { "Instances", "An Instance token (from raids, boxes, the wheel and login days) opens a private room for 10 boss kills, any time. Fight any world boss or the Mad Hatter." },
iron = { "Iron Mode", "A challenge: no buying packs with coins, no Market buying, no GE bids, no daily deals (the real shops are allowed, like RuneScape ironmen). Rewards: +5% luck and the Ironman title. After turning it off you wait 24 h to turn it on again." },
worldinfo = { "World", "The game follows your reader's clock. MORNING (6-12): crops grow faster. DAY (12-18): Light & Fire cards +15%. EVENING (18-22): Nature & Water cards +15%. NIGHT (22-6): Shadow & Dream cards +20%.\nWEATHER changes every day: rain (faster crops, Water cards), storm (Storm cards), fog (Shadow cards), snow (Water cards).\nEvery week one MODIFIER is active: Lucky week, Slayer week, Wild markets, Nest week (nests, gems and clue bottles x2), Shiny week, Harvest week (crops x2 faster), Fortune week (the merchant comes more often) or an element week." },
bounty = { "Collector bounty", "Every 3 days the Collector asks for one card at a certain level (sometimes shiny). Hand over ONE spare copy (you keep the card) for coins and a box. Every 10 bounties gives a Mythic box. Level cards by merging copies in the album; shiny cards come from packs." },
worldmap = { "World map", "6 regions unlock with your total level: Greenwood (0), Copper Hills (60), Saltmarsh (150), Wildlands (300), Frostpeak (600) and The Void (1000). EXPLORE (a 20 second trip) finds resources and xp, a hidden stash, or a monster to FIGHT with your own combat. Each region hides a SECRET (rare, +200 coins). Find all 6 for a Mythic box." },
megapets = { "Mega pets", "Gathering with a skilling pet you already own can rarely turn it MEGA, a giant version just for show. Mythic boxes can also give one." },
}
local SKILL = {
"The power swing: hold your finger down on the tree. The axe winds up back over your shoulder and the bar beside the tree goes up and down. Let go in the gold band at the top: PERFECT, the tree is cut through at once and its logs come (3 to 5). Let go higher up the bar: a good chop; low: a weak one. Enough chops (5 for a plain tree, up to 14 for an Ancient one) and the logs come too; the tree stays and you chop on. Perfect chops in a row are a streak: +10% xp each on the logs (up to +100%). A better axe (Smithing, needs a Woodcutting level) makes the gold band wider and the bar a little slower. TREE & AXE: pick the tree and see your axe. Better trees need a better axe: Willow an Iron axe, Maple Steel, Yew Mithril, Magic Adamant, Elder Rune, Ancient Dragon. BANK when your inventory is full. Rare bird nests. The Elder and Ancient trees need quest points. (The reader: tap the tree to chop.)",
"Dig down, Minecraft style: you look down a shaft at the block under you. Tap it: it cracks, breaks, and you drop one block deeper. A gold CRIT point sits on the block and jumps after every tap: hit it and that block gives five times as much. Ores lie in layers by depth: copper near the top (1-25), iron (10-45), coal (25-70), mithril (50-100), adamant (80-140), dragon from 130, celestial from 200; the plain stone gives rune essence (for Runecrafting and rune equipment). The chart under the shaft shows what's common where you are; ore glints in the floor when one is coming. Harder ores take more taps; a better pickaxe (Smithing, needs a Mining level) and a higher level fewer. An ore too hard for you (Coal needs an Iron pickaxe, Mithril Steel, Adamant Mithril, Dragon Rune, Celestial Dragon; the deepest veins quest points) still breaks but gives rune essence. Ticket blocks (stone with a golden ticket) turn up now and then: break one for a mine ticket for that layer's main ore. Find an ore 25 times in the shaft and its own mine opens under MINES: one ticket, 15 blocks of only that ore (CRIT x5 still works); leave it halfway and it waits. LIFT: back to the top or to any depth you reached (every 10); UP: one block up. Rare uncut gems (cut them with a chisel in Crafting). (The reader: tap the block to dig.)",
"Fish with one rod. Pick a SPOT and a BAIT under SPOT & BAIT, then THROW: grab the float, swing your finger up and let go, like throwing a ball: the faster, the further out (a long throw bites a little sooner; the reader: tap the water or CAST). Now and then bubbles come up somewhere on the water: throw your float right into them for a PERFECT THROW: a double catch and +50% xp. It waits in real time, even with the app closed. When the float dips and says BITE!, a reel wheel shows up: spin your finger round it to wind the fish in (it clicks as it turns). The fish rests and pulls: reel while it rests; when it says IT PULLS!, stop and let it run (the line slips out a bit) or the strain bar fills up and the line snaps (the fish swims off, throw again). Wild spinning winds no faster than a steady turn a second. Deeper spots take more turns (5 for shrimp, up to about 10) but bring up more fish and more xp. SPOT & BAIT: better BAIT opens up with your Fishing level (Bread paste 10, Feather lure 25, Glowworms 45, Kraken bait 65, Golden lure 85): shorter waits, more xp, a chance of a double catch, for a few coins a cast (the Feather lure: a feather a cast). Fly fishing (trout and salmon) uses a feather every cast too, like RuneScape (FISHING shop, or Hunter: pheasant nests). The spots still need their gear like RuneScape: shrimp a small net, trout and salmon a fly rod (Crafting 3), swordfish, sharks and leviathans a harpoon (Smithing 12), lobsters a lobster cage, manta rays a big net.",
"Hunt on the map: 12 areas (meadows, woods, a river bank, hills, a rocky slope, the ash ridge, the snowy peak). The animals wander between the areas they like every 20 minutes of real time; some areas have nothing for a while, the rare ones (drakes, the phoenix) show up now and then. You can't see them: tap an area to see it up close, and place a DETECTOR there (2, one more every 25 Hunting levels, up to 5). It scans first (10 minutes, down to 5 at level 99; you get a message when it's done), then shows what passed and keeps logging (\"Deer x3, 12 min ago\"); the map and the area show the newest group seen (from the last hour). Under the map: your detectors and your trap; tap one to go there. Then set your trap where the animals are: tap the third button to pick SNARE (rabbits, pheasants, the phoenix), PIT TRAP (deer, boars, wolves, bears) or NET TRAP (drakes), then SET (in the area up close). It catches after a wait nobody knows, if an animal it can take comes by (sometimes two, now and then a rare one). You get a message when it caught something, also with the app closed, and when a detector spots a rare animal. Tap the trap (or COLLECT) for the catch. Traps: buy or make one once and keep it forever (SHOP: Hunter shop, or Fletching). You need the level and quest points for an animal to catch it.",
"Two steps like RuneScape. The FURNACE: pick a bar with < and >, then hold your finger on the furnace: the bellows blow, the fire grows and the heat goes up; let go and it cools. Keep the needle in the black band on the thermometer and the ore melts; when it is all molten it is poured into the mould: your bar. Better metals have a narrower, hotter band (your level widens it a little). Never too hot (the dotted part) during a melt: a PERFECT POUR, one ore back. STOP ends a melt (nothing used). The ANVIL (needs a hammer): pick what to make, tap the anvil to start. A spot on the hot metal glows and a ring closes in on it: tap when the ring meets the spot (PERFECT, GOOD or WEAK); every hit shapes it, from a bar to a sword, axe, pickaxe or harpoon (better metals take more hits). The metal cools: a cold one hardly changes, REHEAT it in the forge. Three perfect hits in a row at the end: a MASTERWORK (+25% xp, and a 1 in 4 chance to keep the materials). QUICK x5 makes five the old way, without the bonuses. Bars are also used for upgrades, house rooms and missions. (The reader: tap the furnace or the anvil to make one.)",
"Needs a knife. Cut logs into bows and string them with a bow string (Crafting, from flax), make snares, pit traps and net traps for Hunting. Bows are ranged weapons (pick them in the Armoury, each needs a Ranged level).",
"Spin flax into bow strings, make small nets, lobster cages, big nets and the fly rod, cut gems with a chisel, and make gear from hunter drops and staffs for Magic.",
"Cast utility spells (dust, tickets, coins) and teleports with runes. Magic is also a combat style: spells use runes from Runecrafting. High Alchemy is in the Bank.",
"Cook in the pan, seen from above: pick a dish with < and >, then COOK (or tap the stove): its ingredients go in as 6 pieces. Drag anywhere on the screen to move the pan: the pieces slide around in it, lag behind, bump the rim and each other. Only what lies over the flame cooks (the pan's floor glows there): the side facing down browns. The ring round a piece shows that side: white = golden (turn it now), blinking black = nearly burnt, black = burnt. TOSS (or flick the pan up quickly): everything jumps and lands on its other side. SERVE when you're done: every side golden is a PERFECT dish (one extra, +25% xp); more than 2 burnt sides and it's lost. QUICK x5 cooks five the old way (they can burn, less often with your level). Meals heal you in fights, like RuneScape. (The reader: tap the stove to cook one.)",
"Your patch: 9 plots (3 to start; buy plots 4-9 with the PLOT button: 500c Farming 10, 2000c Farming 30, 6000c Farming 50, 12000c Farming 60, 25000c Farming 70, 50000c Farming 85). Pick a tool under the patch. RAKE: swipe back and forth over a plot, every turn takes some weeds off (they grow back slowly). PLANT: tap a clean, empty plot to sow the seeds picked with < and > (coins). WATER: hold your finger on a plot, its water bar fills; wet soil grows 20% faster, a full bar lasts an hour. COMPOST: before planting, +1 crop (15 coins). Crops grow in real time and you see them grow; you get a message when they're ripe, also with the app closed. HARVEST like a sickle: swipe your finger across ripe crops (with any tool), or tap a ripe plot. Care is never needed, only rewarded: compost +1, no weeds at harvest +1, watered while it grew +1. PLANT ALL sows every clean empty plot, HARVEST ALL picks every ripe one. Flax for bow strings and nets, herbs (Guam, Ranarr, Snapdragon, Torstol) for Herblore. The crop goes into your inventory. (The reader: tap a plot to use the tool on it.)",
"Run laps for coins and xp. You can slip on an obstacle; a higher Agility level makes it safer.",
"Pickpocket by hand: pick your mark with < and > (better marks pay more but look round more often and sooner). Hold your finger anywhere on the street: your hand creeps toward the coin pouch on his belt; let go and it stops. If his eyes are on you while your hand moves, you're caught: stunned for 5 seconds, like RuneScape. His tell: his ear twitches just before he turns round. Reach the pouch and the coins are yours (three times the old dice roll). QUICK: the old way, a dice roll. CRACK A SAFE: the safes. (The reader: tap the street to try the old way.)",
"Pray at the altar: pick a blessing with < and >, then OFFER (or tap the altar). Rings of light swell out from the offering in a slow, steady beat: tap anywhere as each ring meets the white circle. Every beat in time rings the next note of a hymn (+10% xp each); eight make the offering. All eight in time: a HOLY offering (Fortune lasts twice as long, Might is half as strong again). Blessings: Might and Strength (+ATK next fight) and Fortune (more coins). QUICK offers the old way. (The reader: tap the altar.)",
"Slayer tasks: kill monsters with your own combat. Open it from Adventure > SLAYER.",
"Like RuneScape: clean grimy herbs (from farming and monster drops), then mix herb + secondary (Apothecary in the SHOP) + vial of water: attack, healing, prayer, super restore, super healing and overload. Potions are used in fights (ITEMS); prayer potions also work from your inventory.",
"Saw logs into planks to build rooms in your HOUSE (Camp).",
"Trains in fights when you hit with a bow. Raises your ranged max hit.",
"Trains in fights when you hit with melee. Raises your melee max hit.",
"Trains when you get hit or block in fights. Raises your HP, block chance and damage reduction.",
"Trace the rune at the altar: pick a rune with < and >, then trace its glowing shape on the altar in one stroke, starting at the circle (each rune its own shape: a spiral for air, a wave for water, a mountain for earth, a flame for fire, a bolt for chaos, a leaf for nature, an hourglass for death, a drop for blood, a loop for soul). Stay on the line and cover all of it: 92% and up is a PERFECT trace (half as many runes again, +25% xp), 80% a quarter more, under 60% fewer. QUICK x5 crafts five the old way. Turn rune essence into runes for Magic spells, teleports and High Alchemy. Every rune needs rune essence (Mining: the Rune stone rock); air runes need nothing else, the other runes one more material (ore, bars, coal or planks).",
"Light a fire by hand, like a real one (needs a tinderbox). Pick the log with < and >. 1 STRIKE: swipe the steel down across the flint's sharp edge, fast and glancing, for a shower of sparks; one that lands hot in the tinder may catch. 2 BLOW: hold your finger down to blow on the ember, let go to breathe in; keep it glowing until the tinder flames up (if it cools too far it dies). 3 TWIGS: drag three twigs (bottom left) onto the flame, not while it's tiny. 4 STICKS: two sticks when it burns higher. 5 THE LOG: when the flame reaches the mark (better logs need a bigger flame), the log; then keep the flame up (hold to blow) until it catches. Too much too soon smothers it. A roaring fire gives three times the old xp; a clean one (never went out, nothing smothered) a quarter more. The log is only used when the fire is done. QUICK x5 burns five the old way. Better logs, more xp. Feeding the Wintertodt brazier trains it too.",
}
return { H = H, SKILL = SKILL }
hunting.lua
25730
return function(X, C, ADV, H)
local F = {}
local W, Hh = X.W, X.H
local fl = math.floor
local SI = 4
local GATHER = H.GATHER[4]
local ITEMS = H.ITEMS
local PHONE = smudge.smooth == true
local function hd() return PHONE and GFX and GFX.ok and GFX.ok() and smudge.hires_quad end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function vib(p) if VIB then VIB.play(p, true) end end
local function now() return X.time() end
local function ms() return X.millis() end
local EPOCH = 20 * 60
local CATCH_P = 0.55
local HORIZON = 72 * 3600
local AREAS = {
{ "North meadow", "meadow" }, { "Old woods", "woods" }, { "Windy hills", "hills" }, { "Snowy peak", "peak" },
{ "Flower meadow", "meadow" }, { "River bank", "river" }, { "Pine woods", "woods" }, { "Rocky slope", "rocks" },
{ "South meadow", "meadow" }, { "Deep woods", "woods" }, { "Bear hills", "hills" }, { "Ash ridge", "ridge" },
}
local ANIM = {
{ name = "Rabbit", areas = { 1, 5, 9, 6 }, groups = 2, here = 0.85, trap = 1, n = 3, rare = "golden rabbit" },
{ name = "Pheasant", areas = { 1, 5, 9, 2, 10 }, groups = 2, here = 0.8, trap = 1, n = 3, rare = "silver pheasant" },
{ name = "Deer", areas = { 2, 7, 10, 6 }, groups = 2, here = 0.8, trap = 2, n = 3, rare = "white stag" },
{ name = "Boar", areas = { 2, 7, 10, 3, 11 }, groups = 1, here = 0.75, trap = 2, n = 4, rare = "great tusker" },
{ name = "Wolf", areas = { 3, 11, 7, 8 }, groups = 1, here = 0.7, trap = 2, n = 4, rare = "shadow wolf" },
{ name = "Bear", areas = { 11, 3, 8 }, groups = 1, here = 0.6, trap = 2, n = 5, rare = "cave bear" },
{ name = "Drake", areas = { 12, 8 }, groups = 1, here = 0.45, trap = 3, n = 6, rare = "elder drake", flag = true },
{ name = "Phoenix", areas = { 4 }, groups = 1, here = 0.25, trap = 1, n = 8, rare = "golden phoenix", flag = true },
}
local TRAPS = { "Snare", "Pit trap", "Net trap" }
local TRAPID = { "snare", "ptrap", "ntrap" }
local function hash(a, b)
local h = (a * 374761393 + b * 668265263) % 4294967296
h = (h * 1274126177 + 2654435761) % 4294967296
h = (h ~ (h >> 15)) % 4294967296
h = (h * 2246822519) % 4294967296
h = h ~ (h >> 13)
return (h % 1000003) / 1000003
end
local function where(gi, grp, e)
local a = ANIM[gi]
if hash(e * 31 + gi, grp * 7 + 1) >= a.here then return 0 end
return a.areas[1 + fl(hash(e * 17 + gi * 3, grp * 11 + 5) * #a.areas)]
end
local function seen_in(area, e)
local out = nil
for gi = 1, #ANIM do
for grp = 1, ANIM[gi].groups do
if where(gi, grp, e) == area then
out = out or {}
out[gi] = (out[gi] or 0) + 1 + fl(hash(e + gi, grp + area) * (gi <= 3 and 3 or 2))
end
end
end
return out
end
local function lv(cp) return H.slevel(cp, SI) end
local function ndet(cp) return math.min(5, 2 + fl(lv(cp) / 25)) end
local function scan_len(cp) return 600 - fl(300 * math.min(99, lv(cp)) / 99) end
local function scan_left(cp, k) return math.max(0, (cp.x["hda" .. k] or 0) + scan_len(cp) - now()) end
local function mmss(t) t = math.max(0, fl(t)); return string.format("%d:%02d", t // 60, t % 60) end
local function can(cp, gi) return H.block(cp, SI, gi) == nil end
local function plan(cp, area, kind, t0)
local e0 = t0 // EPOCH
for e = e0, (t0 + HORIZON) // EPOCH do
local here = seen_in(area, e)
if here then
local best = nil
for gi, n in pairs(here) do
if ANIM[gi].trap == kind and can(cp, gi) and (not best or hash(e, gi) > hash(e, best)) then best = gi end
end
if best and hash(e * 13 + area, t0 % 9973) < CATCH_P then
local at = math.max(t0 + 45, e * EPOCH + fl(hash(e, t0 % 7919) * EPOCH))
return at, best
end
end
end
return 0, 0
end
local view = "map"
local SEL = 1
local SNAPT = nil
local POP = nil
local MAP = nil
local function det_at(cp, area) for k = 1, 5 do if (cp.x["hd" .. k] or 0) == area then return k end end end
local function sightings(cp, k, maxn)
local area, since = cp.x["hd" .. k] or 0, cp.x["hda" .. k] or 0
local out = {}
if area == 0 or now() < since + scan_len(cp) then return out end
local e1 = now() // EPOCH
local e0 = math.max(since // EPOCH, e1 - 72)
for e = e1, e0, -1 do
local here = seen_in(area, e)
if here then
for gi, n in pairs(here) do
if hash(e * 5 + area, gi) < 0.85 then
local t = math.max(since, e * EPOCH + fl(hash(e, gi * 3 + area) * EPOCH))
if t <= now() then out[#out + 1] = { gi, n, t } end
end
end
end
if #out >= (maxn or 4) then break end
end
table.sort(out, function(a, b) return a[3] > b[3] end)
return out
end
local function ago(t)
local s = math.max(0, now() - t)
if s < 60 then return "just now" end
if s < 3600 then return fl(s / 60) .. " min ago" end
return fl(s / 3600) .. " h ago"
end
local function caught(cp) return (cp.x.htr or 0) > 0 and (cp.x.htt or 0) > 0 and now() >= cp.x.htt end
local function replan(cp)
if (cp.x.htr or 0) > 0 and (cp.x.htt or 0) == 0 and now() > (cp.x.hts or 0) + HORIZON then
local t0 = now()
cp.x.hts = t0
cp.x.htt, cp.x.hcg = plan(cp, cp.x.htr, cp.x.htk or 1, t0)
end
end
local function set_trap(cp, area, kind)
if not H.has_trap(cp, TRAPID[kind]) then X.set_note("You need a " .. TRAPS[kind]:lower() .. " (Hunter shop, or Fletching): bought once, kept forever."); return end
local t0 = now()
local at, gi = plan(cp, area, kind, t0)
cp.x.htr, cp.x.htk, cp.x.hts, cp.x.htt, cp.x.hcg = area, kind, t0, at, gi
local r = hash(t0 % 100003, area * 7 + kind)
cp.x.hcr = (r < 0.05) and 1 or 0
cp.x.hcn = (r < 0.05) and 3 or ((r < 0.2) and 2 or 1)
snd("hu_snap", 0.25); vib("sf_click")
X.set_note(TRAPS[kind] .. " set in the " .. AREAS[area][1]:lower() .. ". Now wait: you'll get a message when it catches something.")
X.mark_dirty(); X.save_now()
end
local function collect(S)
local cp = S.camp
local gi, mul = cp.x.hcg or 0, cp.x.hcn or 1
if gi == 0 then return end
local g = GATHER[gi]
local n = ANIM[gi].n * mul
local bonus = mul == 2 and " (two!)" or ""
if (cp.x.hcr or 0) == 1 then bonus = " (a " .. ANIM[gi].rare .. "!)" end
if cp.pet > 0 and X.rnd(1, 100) <= 4 + 3 * X.tier_of(cp.pet) then n = n + 1; bonus = bonus .. " (pet)" end
ADV.on_action(S, SI)
H.stash(cp, g[4], n)
ADV.on_gain(S, g[4], n)
local xp = H.xp_amt(cp, fl(g[7] * ANIM[gi].n * 1.5 * (mul == 1 and 1 or mul * 0.8)), SI)
local note = string.format("+%d %s%s  (+%d xp)", n, ITEMS[g[4]][1], bonus, xp)
note = note .. H.rare_drop(S, SI) .. ADV.G.pet_roll(S, SI)
local lvn = H.give_xp(S, SI, xp)
if lvn ~= "" then note = lvn:gsub("^%s+", "") .. "  " .. note end
if ADV.cluenote then note = ADV.cluenote .. "  " .. note; ADV.cluenote = nil end
cp.stat[SI] = cp.stat[SI] + 1
POP = { t0 = ms(), text = "+" .. n .. " " .. ITEMS[g[4]][1] }
cp.x.htr, cp.x.htt, cp.x.hcg, cp.x.hcn, cp.x.hcr = 0, 0, 0, 0, 0
snd("slot_coin", 0.5); vib("sf_bolt")
X.set_note(note)
X.mark_dirty(); X.save_now()
end
local PICS = {
a1 = { "a1", 15, 32, 30.815 },
a2 = { "a2", 14, 46, 44.296 },
a3 = { "a3", 25, 57, 54.889 },
a4 = { "a4", 21, 49, 47.185 },
a5 = { "a5", 18, 57, 54.889 },
a6 = { "a6", 29, 59, 56.815 },
a7 = { "a7", 29, 57, 54.889 },
a8 = { "a8", 63, 62, 59.704 },
c1 = { "a1", 15, 32, 36.000 },
c2 = { "a2", 14, 46, 36.000 },
c3 = { "a3", 25, 57, 36.000 },
c4 = { "a4", 21, 49, 36.000 },
c5 = { "a5", 18, 57, 36.000 },
c6 = { "a6", 29, 59, 36.000 },
c7 = { "a7", 29, 57, 36.000 },
c8 = { "a8", 63, 62, 36.000 },
t1 = { "t1", 54, 32, 28.444 },
t2 = { "t2", 51, 39, 34.667 },
t3 = { "t3", 49, 37, 32.889 },
det = { "det", 20, 54, 44.000 },
}
local ZPICS = {
za1 = { "za1", 14, 31, 56.000 },
za2 = { "za2", 12, 42, 76.000 },
za3 = { "za3", 25, 57, 104.000 },
za4 = { "za4", 21, 47, 86.000 },
za5 = { "za5", 18, 55, 100.000 },
za6 = { "za6", 29, 60, 108.000 },
za7 = { "za7", 30, 57, 104.000 },
za8 = { "za8", 62, 62, 112.000 },
zt1 = { "zt1", 68, 40, 72.463 },
zt2 = { "zt2", 62, 47, 85.101 },
zt3 = { "zt3", 60, 46, 82.800 },
zdet = { "zdet", 24, 66, 120.000 },
}
local function zpic(k, cx, cy, ht, ang)
local P = ZPICS[k]
local sc = (ht or P[4]) / P[3]
local hw, hh = P[2] * sc / 2, P[3] * sc / 2
local c, sn = math.cos(ang or 0), math.sin(ang or 0)
local function R(dx, dy) return cx + dx * c - dy * sn, cy + dx * sn + dy * c end
local a1, a2 = R(-hw, -hh); local b1, b2 = R(hw, -hh); local c1, c2 = R(hw, hh); local d1, d2 = R(-hw, hh)
local o = -9
smudge.hires_quad("^hd/hu_" .. P[1] .. "_c.png", o, o, o, o, o, o, o, o, a1, a2, b1, b2, c1, c2, d1, d2)
return hw * 2, hh * 2
end
local function tile(nm, x0, y0, x1, y1)
local lx, rx = x0 + 0.75, x1 - 1.75
smudge.hires_quad(nm, lx, y0, rx, y0, rx, y1, lx, y1, x0, y0, x1, y0, x1, y1, x0, y1)
end
local function pic(k, cx, by, ht, over)
local P = PICS[k]
local s = (ht or P[4]) / P[3]
local w, h = P[2] * s, P[3] * s
local x0, y0 = cx - w / 2, by - h
local nm = "hd/hu_" .. P[1] .. "_c.png"
if over then
local o = -9
smudge.hires_quad("^" .. nm, o, o, o, o, o, o, o, o, x0, y0, x0 + w, y0, x0 + w, y0 + h, x0, y0 + h)
else smudge.hires_quad(nm, x0, y0, x0 + w, y0, x0 + w, y0 + h, x0, y0 + h) end
return w, h
end
local function land(kind, x, y, w, h, seed)
local function r(k) return hash(seed, k) end
if kind == "meadow" then
for k = 1, 14 do local gx, gy = x + 6 + r(k) * (w - 12), y + 8 + r(k + 50) * (h - 14)
smudge.line(fl(gx), fl(gy), fl(gx - 2), fl(gy - 4), 1); smudge.line(fl(gx + 2), fl(gy), fl(gx + 3), fl(gy - 5), 1) end
elseif kind == "woods" then
for k = 1, 7 do local gx, gy = x + 12 + r(k) * (w - 24), y + 12 + r(k + 50) * (h - 22)
local rr = 6 + fl(r(k + 9) * 5)
smudge.circle(fl(gx), fl(gy), rr, true, 1, false); smudge.circle(fl(gx), fl(gy), rr, false, 1)
smudge.line(fl(gx), fl(gy + rr), fl(gx), fl(gy + rr + 3), 2) end
elseif kind == "river" then
for q = 0, 2 do
local yy = y + h * (0.3 + q * 0.2)
local px, py
for k = 0, 10 do local xx = x + 4 + (w - 8) * k / 10; local yv = yy + math.sin(k * 1.2 + q) * 3
if px then smudge.line(fl(px), fl(py), fl(xx), fl(yv), 1) end; px, py = xx, yv end
end
elseif kind == "hills" then
for k = 1, 3 do local gx, gy = x + 14 + r(k) * (w - 28), y + h * 0.4 + r(k + 50) * h * 0.4
local rr = 10 + fl(r(k + 9) * 8)
smudge.line(fl(gx - rr), fl(gy), fl(gx), fl(gy - rr * 0.7), 2); smudge.line(fl(gx), fl(gy - rr * 0.7), fl(gx + rr), fl(gy), 2) end
elseif kind == "rocks" or kind == "ridge" or kind == "peak" then
for k = 1, (kind == "peak" and 2 or 4) do local gx, gy = x + 12 + r(k) * (w - 24), y + h * 0.45 + r(k + 50) * h * 0.4
local rr = (kind == "peak" and 18 or 9) + fl(r(k + 9) * 6)
smudge.fill_quad(fl(gx - rr), fl(gy), fl(gx), fl(gy - rr * 1.2), fl(gx), fl(gy - rr * 1.2), fl(gx + rr), fl(gy), false)
smudge.line(fl(gx - rr), fl(gy), fl(gx), fl(gy - rr * 1.2), 2); smudge.line(fl(gx), fl(gy - rr * 1.2), fl(gx + rr), fl(gy), 2)
if kind == "ridge" then smudge.line(fl(gx - 3), fl(gy - rr * 0.6), fl(gx + 2), fl(gy - rr * 0.3), 1) end
if kind == "peak" then smudge.line(fl(gx - 4), fl(gy - rr * 0.9), fl(gx + 4), fl(gy - rr * 0.9), 1) end
end
end
end
local function area_box(i)
local c, r = (i - 1) % 4, fl((i - 1) / 4)
local cw, rh = MAP[3] / 4, MAP[4] / 3
return MAP[1] + c * cw, MAP[2] + r * rh, cw, rh
end
local function draw_map(S, x, y, w, h)
local cp = S.camp
local t = ms()
MAP = { x, y, w, h }
local HD = hd()
smudge.rect(x, y, w, h, true, 1, false)
for i = 1, #AREAS do
local ax, ay, aw, ah = area_box(i)
if HD then
tile("hd/hu_map" .. i .. "_c.png", fl(ax), fl(ay), fl(ax + aw), fl(ay + ah))
else
smudge.rect_dither(fl(ax) + 1, fl(ay) + 1, fl(aw) - 2, fl(ah) - 2, false)
land(AREAS[i][2], ax, ay, aw, ah, i * 101)
smudge.rect(fl(ax), fl(ay), fl(aw), fl(ah), false, 1)
end
end
for i = 1, #AREAS do
local ax, ay, aw, ah = area_box(i)
local k = det_at(cp, i)
if k then
if HD then pic("det", ax + 15, ay + ah - 5, nil, true)
else
smudge.circle(fl(ax + 14), fl(ay + 14), 9, true)
smudge.circle(fl(ax + 14), fl(ay + 14), 5, true, 1, false)
smudge.circle(fl(ax + 14), fl(ay + 14), 2, true)
end
local s = sightings(cp, k, 1)[1]
local left = scan_left(cp, k)
if left > 0 then
local txt = mmss(left)
local tw = X.tw(txt, "small", "bold") + 10
smudge.rounded_rect(fl(ax + aw / 2 - tw / 2 + 8), fl(ay + ah / 2 - 9), tw, 18, 6, true, 1, false)
smudge.rounded_rect(fl(ax + aw / 2 - tw / 2 + 8), fl(ay + ah / 2 - 9), tw, 18, 6, false, 1)
X.ctext(fl(ax + aw / 2 + 8), fl(ay + ah / 2 - 9), txt, "small", "bold")
busy()
elseif s then
local age = now() - s[3]
local fresh = age < 3600
if HD then
if fresh then
pic("a" .. s[1], ax + aw / 2 + 6, ay + ah / 2 + PICS["a" .. s[1]][4] / 2, nil, true)
if s[2] > 1 then
local tw = X.tw("x" .. s[2], "small", "bold") + 8
smudge.rounded_rect(fl(ax + aw - tw - 4), fl(ay + 4), tw, 18, 6, true, 1, false)
X.ctext(fl(ax + aw - 4 - tw / 2), fl(ay + 4), "x" .. s[2], "small", "bold")
end
end
else
local nm = "art/hu_" .. s[1]
smudge.draw_sprite(fl(ax + aw / 2 - 12), fl(ay + ah / 2 - 12), 24, 24, nm .. ".raw", nm .. "_m.raw")
if s[2] > 1 then X.ltext(fl(ax + aw / 2 + 12), fl(ay + ah / 2), "x" .. s[2], "small", "bold") end
if not fresh then smudge.rect_dither(fl(ax + aw / 2 - 12), fl(ay + ah / 2 - 12), 24, 24, false) end
end
end
end
if (cp.x.htr or 0) == i then
local tx, ty = ax + aw - 16, ay + ah - 16
local full = caught(cp)
local sh = 0
if full and PHONE then sh = math.sin(t / 60) * 2; busy() end
if HD then
local kind = cp.x.htk or 1
if kind < 1 or kind > 3 then kind = 1 end
local tcx, tby = ax + aw - 26 + sh, ay + ah - 3
local _, th = pic("t" .. kind, tcx, tby, nil, true)
if full then
local g = "a" .. (cp.x.hcg or 1)
pic("c" .. (cp.x.hcg or 1), tcx, tby - th * 0.3, nil, true)
X.ctext(fl(tcx + 18), fl(tby - th * 0.3 - 40), "!", "ui10", "bold")
end
else
smudge.rounded_rect(fl(tx - 11 + sh), fl(ty - 9), 22, 18, 4, true)
smudge.rounded_rect(fl(tx - 9 + sh), fl(ty - 7), 18, 14, 3, true, 1, false)
if full then
local nm = "art/hu_" .. (cp.x.hcg or 1)
smudge.draw_sprite(fl(tx - 12 + sh), fl(ty - 30), 24, 24, nm .. ".raw", nm .. "_m.raw")
X.ctext(fl(tx + sh), fl(ty - 7), "!", "ui10", "bold")
if (cp.x.hcr or 0) == 1 then smudge.tint(fl(tx - 12), fl(ty - 30), 24, 24, 4, 3) end
else
smudge.line(fl(tx - 5), fl(ty), fl(tx + 5), fl(ty), 1); smudge.line(fl(tx), fl(ty - 4), fl(tx), fl(ty + 4), 1)
end
end
end
X.reg("HAREA" .. i, fl(ax), fl(ay), fl(aw), fl(ah), function()
SEL = i; view = "zoom"; snd("tap", 0.25); X.mark_dirty()
end, false)
end
smudge.rect(x, y, w, h, false, 2)
if POP and t - POP.t0 < 1200 then
local u = (t - POP.t0) / 1200
local tw = X.tw(POP.text, "ui12", "bold") + 20
smudge.rounded_rect(fl(x + w / 2 - tw / 2), fl(y + h / 2 - 20 - 20 * u), tw, 30, 10, true)
X.ctext(fl(x + w / 2), fl(y + h / 2 - 16 - 20 * u), POP.text, "ui12", "bold", true)
busy()
end
end
local ZSLOT = { { 0.50, 0.40 }, { 0.74, 0.27 }, { 0.30, 0.25 }, { 0.64, 0.58 } }
local function trap_kind(cp) local k = cp.x.htk or 1; if k < 1 or k > 3 then k = 1 end; return k end
local function draw_zoom(S, y)
local cp = S.camp
local t = ms()
local HD = hd()
local a = AREAS[SEL]
local by = Hh - 96 - 60
local zh = fl(math.min(464 * 228 / 256, by - 8 - y - 150))
local zw = fl(math.min(464, zh * 256 / 228))
local zx = fl((W - zw) / 2)
local zy = y
local u = zw / 464
if HD then tile("hd/hu_z" .. SEL .. "_c.png", zx, zy, zx + zw, zy + zh)
else
smudge.rect(zx, zy, zw, zh, true, 1, false)
smudge.rect_dither(zx + 1, zy + 1, zw - 2, zh - 2, false)
land(a[2], zx, zy, zw, zh, SEL * 101)
end
local k = det_at(cp, SEL)
local dcx, dcy = zx + 58 * u, zy + zh - 72 * u
if k then
local left = scan_left(cp, k)
if HD then zpic("zdet", dcx, dcy, 120 * u)
else
smudge.circle(fl(dcx), fl(dcy - 30 * u), 16, true); smudge.circle(fl(dcx), fl(dcy - 30 * u), 9, true, 1, false)
smudge.circle(fl(dcx), fl(dcy - 30 * u), 4, true); smudge.rect(fl(dcx - 3), fl(dcy - 14 * u), 6, fl(70 * u), true)
end
local ey = dcy - 36 * u
if left > 0 then
if PHONE then
smudge.set_clip(zx, zy, zw, zh)
for q = 0, 2 do
local f = ((t / 1600) + q / 3) % 1
smudge.circle(fl(dcx), fl(ey), fl(14 + f * 120 * u), false, f < 0.66 and 2 or 1)
end
smudge.set_clip()
busy()
end
local txt = "Scanning  " .. mmss(left)
local tw = X.tw(txt, "ui10", "bold") + 20
local px = fl(math.max(zx + 6, math.min(zx + zw - tw - 6, dcx - tw / 2)))
smudge.rounded_rect(px, fl(ey - 104 * u - 14), tw, 28, 10, true, 1, false)
smudge.rounded_rect(px, fl(ey - 104 * u - 14), tw, 28, 10, false, 2)
X.ctext(fl(px + tw / 2), fl(ey - 104 * u - 11), txt, "ui10", "bold")
else
local s = sightings(cp, k, 1)[1]
if s and now() - s[3] < 3600 then
for q = 1, math.min(4, s[2]) do
local sl = ZSLOT[q]
local jx, jy = (hash(s[3], q) - 0.5) * 0.08, (hash(s[3], q + 9) - 0.5) * 0.08
local cx, cy = zx + zw * (sl[1] + jx), zy + zh * (sl[2] + jy)
if HD then zpic("za" .. s[1], cx, cy, nil, (hash(s[3], q + 20) - 0.5) * 1.4)
else
local nm = "art/hu_" .. s[1]
smudge.draw_sprite(fl(cx - 12), fl(cy - 12), 24, 24, nm .. ".raw", nm .. "_m.raw")
end
end
end
end
end
if (cp.x.htr or 0) == SEL then
local kind = trap_kind(cp)
local full = caught(cp)
local sh = 0
if full and PHONE then sh = math.sin(t / 60) * 3; busy() end
local tcx, tcy = zx + zw - 84 * u + sh, zy + zh - 56 * u
if HD then zpic("zt" .. kind, tcx, tcy, nil)
else
smudge.rounded_rect(fl(tcx - 40), fl(tcy - 18), 80, 36, 8, true)
smudge.rounded_rect(fl(tcx - 36), fl(tcy - 14), 72, 28, 6, true, 1, false)
X.ctext(fl(tcx), fl(tcy - 9), TRAPS[kind]:lower(), "small", "bold")
end
if full then
local gi = cp.x.hcg or 1
if HD then zpic("za" .. gi, tcx, tcy - 34 * u, 76 * u, 0.3)
else local nm = "art/hu_" .. gi; smudge.draw_sprite(fl(tcx - 12), fl(tcy - 50), 24, 24, nm .. ".raw", nm .. "_m.raw") end
smudge.circle(fl(tcx + 40 * u), fl(tcy - 80 * u), 13, true, 1, false); smudge.circle(fl(tcx + 40 * u), fl(tcy - 80 * u), 13, false, 2)
X.ctext(fl(tcx + 40 * u), fl(tcy - 80 * u - 10), "!", "ui10", "bold")
X.reg("HZTRAP", fl(tcx - 70 * u), fl(tcy - 120 * u), fl(140 * u), fl(160 * u), function() collect(S) end, false)
end
end
local nt = a[1]
local nw = X.tw(nt, "ui10", "bold") + 20
smudge.rounded_rect(zx + 8, zy + 8, nw, 28, 10, true, 1, false)
smudge.rounded_rect(zx + 8, zy + 8, nw, 28, 10, false, 2)
X.ctext(zx + 8 + nw // 2, zy + 11, nt, "ui10", "bold")
smudge.rect(zx, zy, zw, zh, false, 2)
if POP and t - POP.t0 < 1200 then
local v = (t - POP.t0) / 1200
local tw = X.tw(POP.text, "ui12", "bold") + 20
smudge.rounded_rect(fl(zx + zw / 2 - tw / 2), fl(zy + zh / 2 - 20 - 30 * v), tw, 30, 10, true)
X.ctext(fl(zx + zw / 2), fl(zy + zh / 2 - 16 - 30 * v), POP.text, "ui12", "bold", true)
busy()
end
local x0, w0 = 24, W - 48
local py = zy + zh + 6
local ph = by - 8 - py
smudge.rounded_rect(x0, py, w0, ph, 10, false, 1)
local yy = py + 8
local rowh = HD and 30 or 22
local trapHere = (cp.x.htr or 0) == SEL
local rows = fl((ph - 16 - (trapHere and 22 or 0)) / rowh)
if k then
local left = scan_left(cp, k)
if left > 0 then
X.ltext(x0 + 10, yy, X.fit("Detector scanning: results in " .. mmss(left) .. ".", w0 - 20, "small"), "small", "bold"); yy = yy + 22
else
local log = sightings(cp, k, math.max(1, rows))
if #log == 0 then X.ltext(x0 + 10, yy, "Detector: nothing seen yet.", "small"); yy = yy + 22 end
for q = 1, math.min(#log, math.max(1, rows)) do
local s = log[q]
local nm = "art/hu_" .. s[1]
if HD then pic("a" .. s[1], x0 + 22, yy + 25, 28) else smudge.draw_sprite(x0 + 10, yy - 2, 24, 24, nm .. ".raw", nm .. "_m.raw") end
X.ltext(x0 + 40, yy + (HD and 3 or 0), string.format("%s x%d", ANIM[s[1]].name, s[2]), "small", "bold")
X.rtext(x0 + w0 - 10, yy + (HD and 3 or 0), ago(s[3]), "small")
yy = yy + rowh
end
end
else
X.ltext(x0 + 10, yy, X.fit("No detector here: place one to see what lives here.", w0 - 20, "small"), "small"); yy = yy + 22
end
if trapHere then
local txt = caught(cp) and "Your " .. TRAPS[trap_kind(cp)]:lower() .. " caught something! Tap it to collect."
or ("Your " .. TRAPS[trap_kind(cp)]:lower() .. " is set here, waiting...")
X.ltext(x0 + 10, py + ph - 24, X.fit(txt, w0 - 20, "small"), "small", "bold")
end
local bw = (w0 - 12) // 3
local used = 0
for q = 1, 5 do if (cp.x["hd" .. q] or 0) > 0 then used = used + 1 end end
X.button(x0, by, bw, 52, "DETECTOR", function()
if k then cp.x["hd" .. k] = 0; X.set_note("Detector taken back.")
else
local free = nil
for q = 1, ndet(cp) do if (cp.x["hd" .. q] or 0) == 0 then free = q; break end end
if not free then X.set_note("All your detectors are out (" .. ndet(cp) .. "; more with your Hunting level). Take one back first."); return end
cp.x["hd" .. free], cp.x["hda" .. free] = SEL, now()
snd("hu_rustle", 0.4)
X.set_note("Detector placed in the " .. a[1]:lower() .. ": it scans for " .. fl(scan_len(cp) / 60) .. " min, then shows what passed.")
end
X.mark_dirty(); X.save_now()
end, { font = "small", id = "HDET", sub = k and "take it back" or (used .. "/" .. ndet(cp) .. " out") })
local kind = trap_kind(cp)
if (cp.x.htr or 0) == 0 or trapHere then
if trapHere and caught(cp) then
X.button(x0 + bw + 6, by, bw, 52, "COLLECT", function() collect(S) end, { font = "small", id = "HCOLL", dot = "!" })
elseif trapHere then
X.button(x0 + bw + 6, by, bw, 52, "TAKE TRAP", function()
cp.x.htr, cp.x.htt, cp.x.hcg = 0, 0, 0; X.set_note("Trap taken back."); X.mark_dirty(); X.save_now()
end, { font = "small", id = "HTRAP", sub = TRAPS[kind]:lower() })
else
X.button(x0 + bw + 6, by, bw, 52, "SET " .. TRAPS[kind]:upper(), function() set_trap(cp, SEL, kind) end,
{ font = "small", id = "HTRAP", sub = "here" })
end
else
X.button(x0 + bw + 6, by, bw, 52, "TRAP", function()
X.set_note("Your trap is in the " .. AREAS[cp.x.htr][1]:lower() .. ".")
SEL = cp.x.htr
end, { font = "small", id = "HTRAP", sub = "go to it" })
end
X.button(x0 + 2 * (bw + 6), by, w0 - 2 * (bw + 6), 52, (cp.x.htr or 0) == 0 and TRAPS[kind]:upper() or "BANK", function()
if (cp.x.htr or 0) == 0 then cp.x.htk = kind % 3 + 1; X.mark_dirty()
else H.bank_loot(S) end
end, { font = "small", id = (cp.x.htr or 0) == 0 and "HKIND" or "GBANK", nohelp = true,
sub = (cp.x.htr or 0) == 0 and "tap: other trap" or (H.inv_used() .. "/" .. H.INV_MAX) })
if caught(cp) then busy() end
X.draw_note(zy + zh - 60)
end
local function draw_overview(S, y)
local cp = S.camp
local x0, w0 = 8, W - 16
local by = Hh - 96 - 60
local mh = fl(math.min(w0 * 2 / 3, by - 8 - y - 110))
draw_map(S, x0, y, w0, mh)
local px, pw = 24, W - 48
local py = y + mh + 6
local ph = by - 8 - py
smudge.rounded_rect(px, py, pw, ph, 10, false, 1)
local yy = py + 6
local rowh = ph >= 150 and 22 or 20
local function row(id, area, l, r, bold)
if yy + rowh > py + ph - 2 then return end
X.ltext(px + 10, yy, X.fit(l, pw - 130, "small"), "small", "bold")
X.rtext(px + pw - 10, yy, r, "small", bold and "bold" or nil)
X.reg(id, px, yy - 2, pw, rowh, function() SEL = area; view = "zoom"; snd("tap", 0.25); X.mark_dirty() end, false)
yy = yy + rowh
end
local any = false
for k = 1, 5 do
local area = cp.x["hd" .. k] or 0
if area > 0 then
any = true
local left = scan_left(cp, k)
local r
if left > 0 then r = "scanning " .. mmss(left)
else
local s = sightings(cp, k, 1)[1]
r = s and (ANIM[s[1]].name .. " x" .. s[2] .. ", " .. ago(s[3])) or "nothing yet"
end
row("HROW" .. k, area, "Detector: " .. AREAS[area][1], r)
end
end
if (cp.x.htr or 0) > 0 then
any = true
row("HROWT", cp.x.htr, TRAPS[trap_kind(cp)] .. ": " .. AREAS[cp.x.htr][1], caught(cp) and "caught something!" or "waiting", caught(cp))
end
if not any then
X.ltext(px + 10, yy, X.fit("Tap an area to look closer: place a detector, set a trap.", pw - 20, "small"), "small"); yy = yy + rowh
end
X.button(24, by, W - 48, 52, "BANK", function() H.bank_loot(S) end,
{ font = "small", id = "GBANK", nohelp = true, sub = H.inv_used() .. "/" .. H.INV_MAX })
if caught(cp) then busy() end
X.draw_note(y + mh - 60)
end
function F.draw(S, y)
replan(S.camp)
if view == "zoom" then draw_zoom(S, y); return true end
draw_overview(S, y)
return false
end
function F.back() view = "map"; X.mark_dirty() end
function F.notes(S)
local cp = S.camp
if not cp or not cp.x then return end
local t = now()
if (cp.x.htr or 0) > 0 and (cp.x.htt or 0) > 0 and cp.x.htt <= t and (cp.x.hnt or 0) ~= cp.x.htt then
cp.x.hnt = cp.x.htt
local gi = cp.x.hcg or 0
local what = (gi > 0) and (((cp.x.hcr or 0) == 1) and ("a " .. ANIM[gi].rare .. "!") or ((cp.x.hcn or 1) > 1 and ("two " .. ANIM[gi].name:lower() .. "s!") or ("a " .. ANIM[gi].name:lower() .. "."))) or "something."
ADV.notify("Your " .. TRAPS[cp.x.htk or 1]:lower() .. " caught " .. what, "hunt")
end
local done = 0
for k = 1, 5 do
local area = cp.x["hd" .. k] or 0
local te = (cp.x["hda" .. k] or 0) + scan_len(cp)
if area > 0 and te <= t and te > (cp.x.hdn or 0) and t - te < 6 * 3600 then
done = math.max(done, te)
local s = sightings(cp, k, 1)[1]
ADV.notify("Your detector in the " .. AREAS[area][1]:lower() .. " is done scanning: "
.. (s and (ANIM[s[1]].name:lower() .. " x" .. s[2] .. ".") or "nothing came by yet."), "hunt")
end
end
if done > 0 then cp.x.hdn = done end
local e = t // EPOCH
if (cp.x.hnr or 0) < e then
for k = 1, 5 do
local area = cp.x["hd" .. k] or 0
if area > 0 and (cp.x["hda" .. k] or 0) <= e * EPOCH then
local here = seen_in(area, e)
if here then
for gi, n in pairs(here) do
if ANIM[gi].flag and hash(e * 5 + area, gi) < 0.85 then
cp.x.hnr = e
ADV.notify("Your detector in the " .. AREAS[area][1]:lower() .. " spotted a " .. ANIM[gi].name:lower() .. "!", "hunt")
end
end
end
end
end
end
end
function F.times(S, t0, t1, add)
local cp = S.camp
if not cp or not cp.x then return end
if (cp.x.htr or 0) > 0 and (cp.x.htt or 0) > 0 then add(cp.x.htt) end
for k = 1, 5 do
local te = (cp.x["hda" .. k] or 0) + scan_len(cp)
if (cp.x["hd" .. k] or 0) > 0 and te > t0 and te <= t1 then add(te) end
end
for e = t0 // EPOCH, t1 // EPOCH + 1 do
for k = 1, 5 do
local area = cp.x["hd" .. k] or 0
if area > 0 then
local here = seen_in(area, e)
if here then for gi in pairs(here) do if ANIM[gi].flag then add(e * EPOCH + 5) end end end
end
end
end
end
F.plan, F.seen_in, F.where, F.ANIM, F.AREAS = plan, seen_in, where, ANIM, AREAS
F.collect = collect
return F
end
main.lua
314630
local D = dofile("data.lua")
local W, H = 480, 800
local TOP = 64
local S
local C
local F
local GR
local scr = "title"
local btns, nbtn = {}, 0
local focus = 1
local note = ""
local last_act = -1000
local timer_at, timer_fn = nil, nil
local page = 0
local album_mode = "view"
local sel = 1
local SHOW = { 25, 28, 30, 32 }
local sslot = 1
local all_mode = false
local RV
local B
local dirty = false
local confirm_reset = false
local confirm_phone = false
local SAVER = false
local anim_v = 0
local PE
local start_opening
local pack_art
local function rnd(a, b)
if smudge.random then return smudge.random(a, b) end
return math.random(a, b)
end
local function tier_of(c)
if c >= 151 then return 6 elseif c >= 103 then return (c - 103) // 8 elseif c >= 100 then return 6 elseif c >= 76 then return (c - 76) // 8 + 3 elseif c >= 52 then return (c - 52) // 8 end
return (c - 1) // 8
end
local SECRET_ELEM = { [49] = 6, [50] = 1, [51] = 8, [100] = 6, [101] = 5, [102] = 8, [151] = 2, [152] = 1, [153] = 7 }
local function elem_of(c) if SECRET_ELEM[c] then return SECRET_ELEM[c] end if c >= 103 then return (c - 103) % 8 + 1 end if c >= 52 then return (c - 52) % 8 + 1 end return (c - 1) % 8 + 1 end
local function cname(c) return D.names[c] end
local function owned(c) return S.lvl[c] > 0 end
local function after(ms, fn) timer_at = smudge.millis() + ms; timer_fn = fn end
local function redraw() smudge.request_update() end
local CLEAN = false
local FX_GLINT, FX_RIP = true, true
local function apply_clean() if smudge.set_clean_refresh then smudge.set_clean_refresh(CLEAN and 40 or 0) end end
local function split(str, sep)
local t = {}
for p in string.gmatch(str, "[^" .. sep .. "]+") do t[#t + 1] = p end
return t
end
local function new_state()
local s = { lvl = {}, spare = {}, xp = {}, coins = D.start_coins, dust = 0, stage = 1, wins = 0, packs = 0, camp = C.new(),
earned = 0, tower = 0, evolved = 0, setmask = 0, deck = { 0, 0, 0 }, shiny = {} }
for i = 1, D.ncards do s.lvl[i] = 0; s.spare[i] = 0; s.xp[i] = 0; s.shiny[i] = 0 end
local zero = { __index = function() return 0 end }
setmetatable(s.lvl, zero); setmetatable(s.spare, zero); setmetatable(s.xp, zero); setmetatable(s.shiny, zero)
return s
end
local OLDN = 51
local function serialize()
return table.concat({
"CPQ5",
table.concat(S.lvl, ",", 1, OLDN), table.concat(S.spare, ",", 1, OLDN), table.concat(S.xp, ",", 1, OLDN),
table.concat({ S.coins, S.dust, S.stage, S.wins, S.packs, S.earned, S.tower, S.evolved, S.setmask, S.deck[1], S.deck[2], S.deck[3] }, ","),
C.ser(S.camp),
table.concat(S.shiny, ",", 1, OLDN),
}, "|")
end
local function ser_cards2()
local t = {}
for _, arr in ipairs({ S.lvl, S.spare, S.xp, S.shiny }) do
local r = {}
for c = OLDN + 1, D.ncards do r[#r + 1] = arr[c] or 0 end
t[#t + 1] = table.concat(r, ",")
end
return table.concat(t, "|")
end
local function load_cards2(s)
local raw = smudge.load("cards2", "")
if not raw or raw == "" then return end
local parts = split(raw, "|")
for k, arr in ipairs({ s.lvl, s.spare, s.xp, s.shiny }) do
local v = split(parts[k] or "", ",")
for i = 1, math.min(#v, D.ncards - OLDN) do arr[OLDN + i] = tonumber(v[i]) or 0 end
end
end
local function load_state()
local s = new_state()
local raw = smudge.load("save", "")
if raw and raw ~= "" then
local p = split(raw, "|")
if (p[1] == "CPQ2" or p[1] == "CPQ3" or p[1] == "CPQ4" or p[1] == "CPQ5") and #p >= 5 then
local a, b, c, d = split(p[2], ","), split(p[3], ","), split(p[4], ","), split(p[5], ",")
local old = (#a == 24 and #b == 24 and #c == 24)
local old40 = (#a == 40 and #b == 40 and #c == 40)
local old48 = (#a == 48 and #b == 48 and #c == 48)
local old49 = (#a == 49 and #b == 49 and #c == 49)
local old51 = (#a == 51 and #b == 51 and #c == 51)
if (old or old40 or old48 or old49 or old51 or (#a == D.ncards and #b == D.ncards and #c == D.ncards)) and #d >= 5 then
local tmap = { [0] = 0, [1] = 2, [2] = 3 }
for i = 1, #a do
local j = i
if old then j = tmap[(i - 1) // 8] * 8 + (i - 1) % 8 + 1 end
if old40 and i > 32 then j = i + 8 end
s.lvl[j] = tonumber(a[i]) or 0
s.spare[j] = tonumber(b[i]) or 0
s.xp[j] = tonumber(c[i]) or 0
end
s.coins = tonumber(d[1]) or D.start_coins
s.dust = tonumber(d[2]) or 0
s.stage = tonumber(d[3]) or 1
s.wins = tonumber(d[4]) or 0
s.packs = tonumber(d[5]) or 0
if (p[1] == "CPQ4" or p[1] == "CPQ5") and p[6] then s.camp = C.deser(p[6]) end
s.earned = tonumber(d[6]) or 0; s.tower = tonumber(d[7]) or 0; s.evolved = tonumber(d[8]) or 0
s.setmask = tonumber(d[9]) or 0
for i = 1, 3 do s.deck[i] = tonumber(d[9 + i]) or 0 end
if p[7] then
local sh = split(p[7], ",")
if #sh == D.ncards or #sh == 48 or #sh == 49 or #sh == 51 then for i = 1, #sh do s.shiny[i] = tonumber(sh[i]) or 0 end end
if #sh == 40 then for i = 1, #sh do s.shiny[i > 32 and i + 8 or i] = tonumber(sh[i]) or 0 end end
end
load_cards2(s)
if old40 then
local m = s.setmask
s.setmask = (m & 15) | (((m >> 4) & 1) << 5) | ((m >> 5) << 6)
for i = 1, 3 do if s.deck[i] > 32 then s.deck[i] = s.deck[i] + 8 end end
local cp = s.camp
if cp.pet > 32 then cp.pet = cp.pet + 8 end
for k = 1, 2 do if cp.exp[k][1] > 32 then cp.exp[k][1] = cp.exp[k][1] + 8 end end
end
end
end
end
return s
end
local function save_now()
SAVE_PENDING = false
smudge.save("save", serialize())
smudge.save("cards2", ser_cards2())
smudge.save("stamp", string.format("%d %d", tonumber(smudge.time and smudge.time() or os.time()) or 0, S and math.floor(S.coins or 0) or 0))
dirty = false
end
SAVE_PENDING = false
function GLASS_CUT(x, y, w, h)
if smudge.glass_sprite_quad then
smudge.glass_sprite_quad("art/one_m.raw", 8, 8, x, y, x + w, y, x + w, y + h, x, y + h, -1, 0, 0)
end
end
function CS_FLUSH() if SAVE_PENDING and S then save_now() end end
local function found_count()
local n = 0
for i = 1, D.ncards do if S.lvl[i] > 0 then n = n + 1 end end
return n
end
local function spare_total()
local n = 0
for i = 1, D.ncards do n = n + S.spare[i] end
return n
end
local function base_stats(c)
local e, t = elem_of(c), tier_of(c) + 1
return D.elem_atk[e] + D.tier_atk[t], D.elem_hp[e] + D.tier_hp[t]
end
local function tier_done(t)
for k = 1, 8 do if S.lvl[t * 8 + k] < 1 then return false end end
return true
end
local function elem_done(e)
for t = 0, 5 do if S.lvl[t * 8 + e] < 1 then return false end end
return true
end
local function sets_done()
local n = 0
for t = 0, 5 do if tier_done(t) then n = n + 1 end end
for e = 1, 8 do if elem_done(e) then n = n + 1 end end
return n
end
local function shiny_count()
local n = 0
for i = 1, D.ncards do if S.shiny[i] == 1 and S.lvl[i] > 0 then n = n + 1 end end
return n
end
local function in_deck(c) for i = 1, 3 do if S.deck[i] == c then return true end end return false end
local DX = { mast = {} }
function DX.load()
DX.mast = {}
for c, n in (smudge.load("mastery", "") or ""):gmatch("(%d+):(%d+)") do DX.mast[tonumber(c)] = tonumber(n) end
end
function DX.save()
local t = {}
for c, n in pairs(DX.mast) do if n > 0 then t[#t + 1] = c .. ":" .. n end end
table.sort(t)
smudge.save("mastery", table.concat(t, ";"))
end
function DX.m(c) return DX.mast[c] or 0 end
DX.MBASE = { 100, 150, 200, 300, 400, 600, 800 }
function DX.mcost(c) return DX.MBASE[tier_of(c) + 1] * (DX.m(c) + 1) end
DX.SHINY = { 200, 350, 600, 1000, 1600, 3000, 5000 }
DX.COVERS = { "Dragon scale", "Moonlight", "Rune wood", "Crystal stone" }
DX.STANDS = { "Laurel", "Stone", "Crystal", "Crown" }
DX.CPRICE, DX.SPRICE = 1500, 800
function DX.cload()
local v = smudge.load("cosm", "") or ""
DX.cv = tonumber(v:match("cv:(%d)")) or 0; DX.sd = tonumber(v:match("sd:(%d)")) or 0
DX.oc = v:match("oc:(%d+)") or "0000"; DX.os = v:match("os:(%d+)") or "0000"
end
function DX.csave() smudge.save("cosm", string.format("cv:%d;sd:%d;oc:%s;os:%s", DX.cv, DX.sd, DX.oc, DX.os)) end
function DX.cover() if not DX.cv then DX.cload() end return (DX.cv > 0) and ("art/bc" .. DX.cv) or "art/bind_cover" end
function DX.stand() if not DX.sd then DX.cload() end return (DX.sd > 0) and ("art/sd" .. DX.sd) or "art/stand" end
local function card_stats(c)
local a, h = base_stats(c)
local lv = S.lvl[c]
if lv < 1 then lv = 1 end
a = a + 2 * (lv - 1); h = h + 4 * (lv - 1)
local ts = 0
for t = 0, 5 do if tier_done(t) then ts = ts + 1 end end
a = a + ts; h = h + 2 * ts
if elem_done(elem_of(c)) then a = a + 2 end
if GR then a = a + GR.atk(c) end
if S.shiny[c] == 1 then a = a + 1; h = h + 2 end
if DX.m(c) > 0 then a = a + DX.m(c); h = h + 2 * DX.m(c) end
if EVO.n(c) > 0 then a = a + 2 * EVO.n(c); h = h + 4 * EVO.n(c) end
if in_deck(c) then
local n = 0
for i = 1, 3 do local d = S.deck[i]; if d ~= 0 and d ~= c and S.lvl[d] > 0 then n = n + 1 end end
a = a + n; h = h + 2 * n
end
if C and C.gear then
local ga, gh = C.gear(S)
a = a + ga; h = h + gh
end
if C and C.asc_bonus then local aa, ah = C.asc_bonus(c); a = a + aa; h = h + ah end
return a, h
end
do
local raw_draw, MASK = smudge.draw_sprite, {}
local function mask_for(path)
local m = MASK[path]
if m == nil then
local n = path:match("^art/(.-)%.raw$")
m = false
if n and (n:match("^it_") or n:match("^ui_") or n:match("^i_") or n:match("^sk%d+$") or n:match("^[eah]%d+$")) then m = "art/" .. n .. "_m.raw" end
MASK[path] = m
end
return m or nil
end
if raw_draw then
smudge.draw_sprite = function(x, y, w, h, path, mask)
return raw_draw(x, y, w, h, path, mask or (path and mask_for(path)))
end
end
end
local MAXCASH = 2000000000
local function add_coins(n) S.coins = math.max(0, math.min(MAXCASH, S.coins + n)); if n > 0 then S.earned = math.min(MAXCASH, S.earned + n) end end
local function add_dust(n) S.dust = math.max(0, math.min(MAXCASH, S.dust + n)) end
local function short(n)
n = math.floor(n or 0)
if n < 100000 then return tostring(n) end
if n < 1000000 then return (string.format("%.1fK", n / 1000):gsub("%.0K", "K")) end
if n < 1000000000 then return (string.format("%.1fM", n / 1000000):gsub("%.0M", "M")) end
return string.format("%.2fB", n / 1000000000)
end
local function roll_card(slot, rare, elem, mint)
local sodds = (mint == 3) and 1000000 or 10000000
if not elem and rnd(1, sodds) == 1 then local l = D.tier_cards[6]; return l[rnd(1, #l)] end
local r = rnd(1, 1000)
local t
if mint == 3 then
t = (r <= 750) and 3 or ((r <= 950) and 4 or 5)
elseif rare or mint == 2 then
t = (r <= 700) and 2 or ((r <= 930) and 3 or ((r <= 985) and 4 or 5))
elseif slot == 3 then
t = (r <= 470) and 1 or ((r <= 810) and 2 or ((r <= 960) and 3 or ((r <= 990) and 4 or 5)))
else
t = (r <= 550) and 0 or ((r <= 800) and 1 or ((r <= 935) and 2 or ((r <= 980) and 3 or ((r <= 995) and 4 or 5))))
end
return D.pick(t, elem, rnd)
end
local function give_card(c)
if S.lvl[c] == 0 then
S.lvl[c] = 1; S.xp[c] = 0
return true
end
if S.spare[c] < D.max_spare then S.spare[c] = S.spare[c] + 1 end
return false
end
local function merge_one(c)
if S.spare[c] < 1 or S.lvl[c] < 1 or S.lvl[c] >= D.max_level then return false end
S.spare[c] = S.spare[c] - 1
S.xp[c] = S.xp[c] + D.xp_value[tier_of(c) + 1]
local leveled = false
while S.lvl[c] < D.max_level and S.xp[c] >= D.xp_need[S.lvl[c]] do
S.xp[c] = S.xp[c] - D.xp_need[S.lvl[c]]
S.lvl[c] = S.lvl[c] + 1
leveled = true
end
if S.lvl[c] >= D.max_level then S.xp[c] = 0 end
return true, leveled
end
local function spare_action(kind)
local c = sel
if S.spare[c] < 1 then note = "No spare copies."; return end
local n, gained, leveled = 0, 0, false
local limit = all_mode and S.spare[c] or 1
for _ = 1, limit do
if S.spare[c] < 1 then break end
if kind == "sell" then
S.spare[c] = S.spare[c] - 1
local v = D.sell_value[tier_of(c) + 1]
add_coins(v); gained = gained + v; n = n + 1
elseif kind == "dust" then
S.spare[c] = S.spare[c] - 1
local v = D.dust_value[tier_of(c) + 1]
add_dust(v); gained = gained + v; n = n + 1
else
local ok, lv = merge_one(c)
if not ok then break end
n = n + 1
if lv then leveled = true end
end
end
if n == 0 then
note = (kind == "merge") and "This card is already at max level." or "Nothing to do."
elseif kind == "sell" then
note = string.format("Sold %d for %d coins.", n, gained)
SND.play(n > 2 and "coins" or "coin", 0.6)
elseif kind == "dust" then
note = string.format("Broke up %d for %d dust.", n, gained)
SND.play("buy", 0.6)
else
note = leveled and string.format("Merged %d - LEVEL UP! Now level %d.", n, S.lvl[c])
or string.format("Merged %d copies into xp.", n)
if leveled then SND.play("levelup", 0.7); if GFX then GFX.levelup(nil, "LEVEL " .. S.lvl[c]) end end
end
save_now()
end
function SELL_SPARES(dry)
local n, coins = 0, 0
for c = 1, D.ncards do
local k = S.spare[c] or 0
if k > 0 then
n = n + k; coins = coins + k * D.sell_value[tier_of(c) + 1]
if not dry then S.spare[c] = 0 end
end
end
if not dry and n > 0 then add_coins(coins); save_now(); SND.play("coins", 0.7) end
return n, coins
end
EVO = { e = {}, MAX = 3, BASE = { 30, 60, 120, 250, 500, 800 } }
function EVO.load()
EVO.e = {}
for c, n in (smudge.load("evolve", "") or ""):gmatch("(%d+):(%d+)") do EVO.e[tonumber(c)] = tonumber(n) end
end
function EVO.save()
local t = {}
for c, n in pairs(EVO.e) do if n > 0 then t[#t + 1] = c .. ":" .. n end end
table.sort(t)
smudge.save("evolve", table.concat(t, ";"))
end
function EVO.n(c) return EVO.e[c] or 0 end
function EVO.cost(c) return (EVO.BASE[tier_of(c) + 1] or 800) * (EVO.n(c) + 1) end
EVO.SW, EVO.LW = { 16, 24, 24 }, { 24, 40, 48 }
EVO.SD, EVO.LD = { 10, 19, 21 }, { 19, 38, 43 }
function EVO.spr(c, big)
local n = EVO.n(c)
if n < 1 then return nil end
n = math.min(n, 3)
if big then return "art/evo" .. n .. "_l", EVO.LW[n], 32, EVO.LD[n] end
return "art/evo" .. n, EVO.SW[n], 16, EVO.SD[n]
end
function EVO.badge(x, yb, c, big)
local p, w, h, dw = EVO.spr(c, big)
if not p then return end
local pad = big and 4 or 3
local tw3, th = dw + 2 * pad, h + 2 * pad
smudge.rounded_rect(x, yb - th, tw3, th, big and 6 or 4, true, 1, false)
smudge.rounded_rect(x, yb - th, tw3, th, big and 6 or 4, false, big and 2 or 1)
smudge.draw_sprite(x + pad, yb - th + pad, w, h, p .. ".raw", p .. "_m.raw")
end
function EVO.quad(c, big, L, col)
local p, w, h, dw = EVO.spr(c, big)
if not p then return end
local pad = big and 4 or 3
local a1, b1 = L(-pad, -pad); local a2, b2 = L(dw + pad, -pad); local a3, b3 = L(dw + pad, h + pad); local a4, b4 = L(-pad, h + pad)
smudge.fill_quad(a1, b1, a2, b2, a3, b3, a4, b4, false, col)
for _, e in ipairs({ { a1, b1, a2, b2 }, { a2, b2, a3, b3 }, { a3, b3, a4, b4 }, { a4, b4, a1, b1 } }) do
smudge.line(math.floor(e[1] + 0.5), math.floor(e[2] + 0.5), math.floor(e[3] + 0.5), math.floor(e[4] + 0.5), big and 2 or 1)
end
local q1, q2 = L(0, 0); local q3, q4 = L(w, 0); local q5, q6 = L(w, h); local q7, q8 = L(0, h)
smudge.draw_sprite_quad(p .. ".raw", w, h, q1, q2, q3, q4, q5, q6, q7, q8, p .. "_m.raw")
end
function CHAT_READY()
if not (smudge.pet_chat_card and smudge.pet_chat) then return false end
local ok, c = pcall(smudge.pet_chat)
return ok and type(c) == "table" and c.setup and true or false
end
function CHAT_CARD_LINE(c)
local t = D.tiers[tier_of(c) + 1]
local l = t:sub(1, 1) .. t:sub(2):lower() .. " - level " .. (S.lvl[c] or 0)
if EVO.n(c) > 0 then l = l .. ", evolve " .. EVO.n(c) end
if S.shiny[c] == 1 then l = l .. ", shiny" end
return l
end
GIFTC = nil
function CHAT_GIFT(c)
if (S.spare[c] or 0) < 1 then note = "You need a spare copy to give away."; return end
if not (GIFTC and GIFTC[1] == c and smudge.millis() - GIFTC[2] < 4000) then GIFTC = { c, smudge.millis() }; return end
GIFTC = nil
local ok, sent = pcall(smudge.pet_chat_card, "gift", c, cname(c), D.tiers[tier_of(c) + 1]:sub(1, 1) .. D.tiers[tier_of(c) + 1]:sub(2):lower())
if not (ok and sent) then note = "The gift could not be wrapped: your copy stays here. Try again."; return end
S.spare[c] = S.spare[c] - 1; save_now()
note = "Gift sent: " .. cname(c) .. " is wrapped and waiting in the chat."
end
function CHAT_COMMAS(n) local s2 = tostring(math.floor(n)); local r; repeat s2, r = s2:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until r == 0; return s2 end
CHAT_WHAT = {
coins = { "coins", "coin", function() return S.coins end, function(n) add_coins(-n) end, function(n) add_coins(n) end },
dust = { "dust", "dust", function() return S.dust end, function(n) S.dust = S.dust - n end, function(n) add_dust(n) end },
stardust = { "stardust", "stardust", function() return S.camp.x.stardust or 0 end,
function(n) S.camp.x.stardust = S.camp.x.stardust - n end, function(n) S.camp.x.stardust = math.min(MAXCASH, (S.camp.x.stardust or 0) + n) end },
ticket = { "pack tickets", "pack ticket", function() return S.camp.tickets or 0 end,
function(n) S.camp.tickets = S.camp.tickets - n end, function(n) S.camp.tickets = math.min(MAXCASH, (S.camp.tickets or 0) + n) end },
rticket = { "rare tickets", "rare ticket", function() return S.camp.rtickets or 0 end,
function(n) S.camp.rtickets = S.camp.rtickets - n end, function(n) S.camp.rtickets = math.min(MAXCASH, (S.camp.rtickets or 0) + n) end },
}
function CHAT_JSTR(v) return '"' .. tostring(v):gsub('[%c"\\]', function(c) return c == '"' and '\\"' or (c == "\\" and "\\\\" or " ") end) .. '"' end
function CHAT_BAL()
if C and C.is_iron and C.is_iron() then return '{"iron":1}' end
local p = {}
for _, k in ipairs({ "coins", "dust", "stardust", "ticket", "rticket" }) do p[#p + 1] = CHAT_JSTR(k) .. ":" .. math.floor(CHAT_WHAT[k][3]()) end
local it = {}
local IT = C and C._data and C._data.ITEMS
if IT and S.camp and S.camp.inv then
for i = 1, #IT do
local n = S.camp.inv[i] or 0
if n > 0 then it[#it + 1] = "[" .. i .. "," .. n .. "," .. CHAT_JSTR(IT[i][1]) .. "," .. CHAT_JSTR(IT[i][3]) .. "]" end
end
end
return "{" .. table.concat(p, ",") .. ',"items":[' .. table.concat(it, ",") .. "]}"
end
function CHAT_SEND_GIFT(btn)
local what, n, i = btn:match("^chatgift:(%a+):(%d+):?(%d*)$")
n = tonumber(n or "") or 0; i = tonumber(i or "")
if not what or n < 1 or not CHAT_READY() then return end
if C and C.is_iron and C.is_iron() then note = "Ironman: you can't give gifts."; return end
local name, line, c = "", "", 0
if what == "item" then
local IT = C and C._data and C._data.ITEMS
if not (IT and i and IT[i]) then return end
n = math.min(n, S.camp.inv[i] or 0)
if n < 1 then note = "Nothing of that in the bank."; return end
S.camp.inv[i] = S.camp.inv[i] - n
name, line, c = n .. " x " .. IT[i][1], IT[i][1], i
else
local W2 = CHAT_WHAT[what]
if not W2 then return end
if W2[3]() < n then note = "You don't have " .. n .. " " .. W2[1] .. "."; return end
W2[4](n)
name, line = CHAT_COMMAS(n) .. " " .. (n == 1 and W2[2] or W2[1]), W2[1]
end
local ok, sent = pcall(smudge.pet_chat_card, "gift", c, name, line, what, n)
if not (ok and sent) then
if what == "item" then S.camp.inv[i] = S.camp.inv[i] + n else CHAT_WHAT[what][5](n) end
note = "The gift could not be wrapped: it stays with you. Try again."
return
end
save_now()
note = "Gift sent: " .. name .. " is wrapped and waiting in the chat."
end
function CHAT_GIFT_IN()
if not smudge.pet_chat_gift then return end
local ok, g = pcall(smudge.pet_chat_gift)
if not ok or type(g) ~= "table" or not g.id then return end
local got = smudge.load("chatgot", "") or ""
local c = tonumber(g.c) or 0
local w, a = g.w and tostring(g.w) or nil, math.max(0, math.floor(tonumber(g.a) or 0))
if w and w ~= "" and w ~= "card" then
if not got:find("," .. g.id .. ",", 1, true) and a > 0 then
local what
if w == "item" then
local IT = C and C._data and C._data.ITEMS
local s2 = g.s and tostring(g.s) or ""
if IT and not (IT[c] and IT[c][1] == s2) then
c = 0
for k2 = 1, #IT do if IT[k2][1] == s2 then c = k2; break end end
end
if IT and IT[c] and S.camp and S.camp.inv then
S.camp.inv[c] = math.min(MAXCASH, (S.camp.inv[c] or 0) + a); what = a .. " x " .. IT[c][1]
end
elseif CHAT_WHAT[w] then
CHAT_WHAT[w][5](a); what = CHAT_COMMAS(a) .. " " .. (a == 1 and CHAT_WHAT[w][2] or CHAT_WHAT[w][1])
end
if not what then
CHAT_NEWER = CHAT_NEWER or {}
if not CHAT_NEWER[g.id] then CHAT_NEWER[g.id] = true; note = "A gift from a newer game version: update the game to open it." end
return
end
local keep = ("," .. g.id .. got):sub(1, 3000)
smudge.save("chatgot", keep:sub(-1) == "," and keep or (keep .. ","))
note = "Gift opened: " .. what .. "!"
SND.play("gift", 0.75)
if GFX then GFX.burst(W / 2, H / 2, 36, { 255, 210, 90 }, 0.35, 1000) end
save_now()
end
smudge.pet_chat_gift_done(g.id)
return
end
if not got:find("," .. g.id .. ",", 1, true) and c >= 1 and c <= D.ncards then
local new = give_card(c)
local keep = ("," .. g.id .. got):sub(1, 3000)
smudge.save("chatgot", keep:sub(-1) == "," and keep or (keep .. ","))
note = "Gift opened: " .. cname(c) .. (new and " - a NEW card!" or " (a spare copy)")
SND.play("gift", 0.75)
if GFX then GFX.burst(W / 2, H / 2, 36, { 255, 120, 200 }, 0.35, 1000) end
save_now()
end
smudge.pet_chat_gift_done(g.id)
end
ADVENT = {}
ADVENT.R = {
{ "coins", 200 }, { "dust", 60 }, { "ticket", 1 }, { "coins", 300 }, { "dust", 80 }, { "card", 1 },
{ "coins", 400 }, { "ticket", 1 }, { "dust", 100 }, { "coins", 500 }, { "rticket", 1 }, { "card", 2 },
{ "coins", 600 }, { "dust", 150 }, { "ticket", 2 }, { "coins", 700 }, { "dust", 200 }, { "card", 3 },
{ "coins", 800 }, { "rticket", 1 }, { "dust", 250 }, { "ticket", 2 }, { "coins", 1000 }, { "card", 4 },
}
function ADVENT.date()
if ADVENT_DATE then return ADVENT_DATE[1], ADVENT_DATE[2], ADVENT_DATE[3] end
local t = (smudge.time and tonumber(smudge.time())) or os.time()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.year then return d.year, d.month, d.day end
return 0, 0, 0
end
function ADVENT.on() local _, m = ADVENT.date(); return m == 12 end
function ADVENT.mask()
local y = ADVENT.date()
local sy, sm = (smudge.load("advent", "") or ""):match("^(%d+):(%d+)$")
return (tonumber(sy) == y) and (tonumber(sm) or 0) or 0
end
function ADVENT.is_open(d) return (ADVENT.mask() >> (d - 1)) & 1 == 1 end
function ADVENT.can(d) local _, m, day = ADVENT.date(); return m == 12 and d <= day and d <= 24 and not ADVENT.is_open(d) end
function ADVENT.waiting()
if not ADVENT.on() then return nil end
for d = 1, 24 do if ADVENT.can(d) then return d end end
end
function ADVENT.text(d)
local r = ADVENT.R[d]
if r[1] == "coins" then return "+" .. r[2] .. " coins" end
if r[1] == "dust" then return "+" .. r[2] .. " dust" end
if r[1] == "ticket" then return r[2] == 1 and "pack ticket" or (r[2] .. " pack tickets") end
if r[1] == "rticket" then return "rare ticket" end
local c = tonumber(smudge.load("advcard" .. d, "") or "")
if c then return cname(c) end
return "Frostfall " .. D.tiers[r[2] + 1]:lower()
end
function ADVENT.open(d)
if not ADVENT.can(d) then return nil end
local y = ADVENT.date()
smudge.save("advent", y .. ":" .. (ADVENT.mask() | (1 << (d - 1))))
local r, c, new = ADVENT.R[d], nil, false
if r[1] == "coins" then add_coins(r[2])
elseif r[1] == "dust" then S.dust = S.dust + r[2]
elseif r[1] == "ticket" then S.camp.tickets = S.camp.tickets + r[2]
elseif r[1] == "rticket" then S.camp.rtickets = (S.camp.rtickets or 0) + r[2]
else
local t = r[2]
if d == 24 and math.random(1, 10) == 1 then t = 5 end
c = 102 + t * 8 + math.random(1, 8)
new = give_card(c)
smudge.save("advcard" .. d, tostring(c))
end
save_now()
ADVENT.pop = { d = d, c = c, new = new, t = smudge.millis() }
SND.play("door", 0.75)
return true
end
local function evolve(c)
local t = tier_of(c)
if t >= 6 then note = "Secret cards cannot evolve."; return end
if S.lvl[c] < D.max_level then note = "Only max level cards can evolve."; return end
if EVO.n(c) >= EVO.MAX then note = cname(c) .. " is fully evolved."; return end
local cost = EVO.cost(c)
if S.spare[c] < 3 then note = "Evolving needs 3 spare copies."; return end
if S.dust < cost then note = string.format("Need %d dust.", cost); return end
S.spare[c] = S.spare[c] - 3
S.dust = S.dust - cost
EVO.e[c] = EVO.n(c) + 1; EVO.save()
S.evolved = S.evolved + 1
EVO.fx = { c = c, t = smudge.millis() }
SND.last.pull_exotic = smudge.millis()
if VIB and VIB.play then pcall(VIB.play, "t4") end
SND.play("evolve", 0.8)
if GFX then GFX.flash(255, 240, 180, 500, 0.5); GFX.burst(W / 2, H / 2, 50, { 255, 230, 120 }, 0.4, 1200) end
note = string.format("%s evolved! Stage %d/%d: +2 ATK, +4 HP.", cname(c), EVO.n(c), EVO.MAX)
save_now()
end
local function craft_card(c)
local cost = D.craft_cost[tier_of(c) + 1]
if S.lvl[c] > 0 or tier_of(c) == 6 then return end
if S.dust < cost then note = string.format("Need %d dust (you have %d).", cost, S.dust); return end
S.dust = S.dust - cost
S.lvl[c] = 1; S.xp[c] = 0; S.spare[c] = 0
note = "Crafted " .. cname(c) .. "!"
save_now()
end
local function ename() return (B and B.ename) or cname(B.ec) end
local function eelem() return (B and B.eel) or elem_of(B.ec) end
local function blog(msg)
local l = B.log
l[#l + 1] = msg
if #l > 4 then table.remove(l, 1) end
end
local function calc_dmg(atk, ae, de)
local d = atk + rnd(0, 2)
local eff = 0
if D.beats[ae] == de then d = d * 2; eff = 1
elseif D.beats[de] == ae then d = math.max(1, d // 2); eff = 2 end
return d, eff
end
local function eff_text(eff)
if eff == 1 then return " Super effective!" end
if eff == 2 then return " Not very effective." end
return ""
end
local function new_enemy()
local boss = (S.stage % 5 == 0)
local t
if boss then t = (S.stage >= 60) and 5 or ((S.stage >= 40) and 4 or 3)
else t = (S.stage < 6) and 0 or ((S.stage < 12) and 1 or ((S.stage < 22) and 2 or ((S.stage < 40) and 3 or ((S.stage < 70) and 4 or 5)))) end
local ec = D.pick(t, nil, rnd)
local ea, eh = base_stats(ec)
ea = ea + S.stage // 4 + (boss and 3 or 0)
eh = eh + S.stage
if boss then eh = eh + eh // 2 end
PE = { ec = ec, ea = ea, eh = eh, boss = boss }
end
local function new_tower_enemy(f)
local boss = (f % 10 == 0)
local t = math.min(5, 1 + f // 9)
if boss then t = math.min(5, t + 1) end
local ec = D.pick(t, nil, rnd)
local ea, eh = base_stats(ec)
ea = ea + f // 2 + (boss and 3 or 0)
eh = eh + f * 2
if boss then eh = eh + eh // 2 end
PE = { ec = ec, ea = ea, eh = eh, boss = boss, tower = f }
end
local function mult(ae, de)
if D.beats[ae] == de then return 2 end
if D.beats[de] == ae then return 0.5 end
return 1
end
local function mult_txt(m) return (m == 2) and "x2" or ((m == 0.5) and "x1/2" or "x1") end
local function start_battle(pc)
if GR and GR.busy(pc) then note = cname(pc) .. " is away for grading."; return end
if not PE then new_enemy() end
local pa, ph = card_stats(pc)
pa = pa + C.take_power(S)
local ec, ea, eh, boss = PE.ec, PE.ea, PE.eh, PE.boss
B = { pc = pc, ec = ec, patk = pa, pmax = ph, php = ph, eatk = ea, emax = eh, ehp = eh,
energy = 0, guard = false, boss = boss, log = {}, busy = false, over = false, win = false,
reward = 0, retreat = false, stage = S.stage, tower = PE.tower, duel = PE.duel,
art = PE.art, lair = PE.lair, wild = PE.wild, wb = PE.wb, wbstart = PE.wb and eh or nil, ename = PE.name, eel = PE.eelem, eturn = 0, prot = false,
ps = { burn = 0, regen = 0 }, es = { burn = 0, regen = 0 } }
if C and C.world_mult then
B.patk = math.floor(B.patk * C.world_mult(elem_of(pc)) + 0.5)
B.eatk = math.floor(B.eatk * C.world_mult(PE.eelem or elem_of(ec)) + 0.5)
end
if B.wb then blog("World boss " .. PE.name .. "! Hit it hard for 10 turns.")
elseif B.lair then blog(PE.name .. " awakens!")
elseif B.wild then blog("A player-killer attacks you in the Wilderness!")
else blog(boss and "A BOSS blocks the way!" or "A wild card appears!") end
scr = "battle"; focus = 1; note = ""
end
local function end_battle(win)
B.over = true; B.win = win; B.busy = false
if B.duel then
B.reward = 0
F.duel_end(win)
blog(win and "Round won!" or "Round lost...")
return
end
if B.lair or B.wild or B.wb then
C.adv_end(S, B, win)
if B.wb then win = B.win end
if win then S.wins = S.wins + 1; C.on_win(S, eelem(), tier_of(B.ec)); blog("Victory!") else blog("You were defeated...") end
save_now()
return
end
if win then
if B.tower then
local f = B.tower
if f > S.tower then
local coins = 4 + f // 2
B.reward = coins
local dust = f // 4
if f % 10 == 0 then
dust = dust + f
B.scales = C.boss_drop(S)
if f % 20 == 0 then S.camp.rtickets = S.camp.rtickets + 1; B.bonus = "RARE ticket!"
else S.camp.tickets = S.camp.tickets + 1; B.bonus = "Pack ticket!" end
end
if dust > 0 then add_dust(dust); B.dust = dust end
S.tower = f
B.reward = math.floor(coins * C.fort_mult(S))
else
B.reward = 1
end
else
B.reward = math.floor((10 + S.stage // 2 + (B.boss and 10 or 0)) * C.fort_mult(S))
if B.boss then B.scales = C.boss_drop(S) end
if S.stage < 99 then S.stage = S.stage + 1 end
end
add_coins(B.reward)
S.wins = S.wins + 1
C.on_win(S, eelem(), tier_of(B.ec))
blog("Victory!")
else
B.reward = 2
add_coins(2)
blog("You were defeated...")
end
save_now()
end
local function stt(t)
local s = ""
if t.burn > 0 then s = s .. " BURN" end
if t.soak then s = s .. " SOAK" end
if t.shield then s = s .. " ROCK" end
if t.stun then s = s .. " STUN" end
if t.conf then s = s .. " DAZE" end
if t.regen > 0 then s = s .. " REGEN" end
return s
end
local function hp_add(side, n)
if side == "p" then B.php = math.max(0, math.min(B.pmax, B.php + n))
else B.ehp = math.max(0, math.min(B.emax, B.ehp + n)) end
end
local function proc(att, ae, dmg)
if rnd(1, 100) > 25 then return end
local vic = (att == "p") and "e" or "p"
local A, V = B[att .. "s"], B[vic .. "s"]
local who = (att == "p") and cname(B.pc) or ename()
local vwho = (att == "p") and ename() or cname(B.pc)
if ae == 1 then V.burn = 3; blog(vwho .. " is burning!")
elseif ae == 2 then V.soak = true; blog(vwho .. " is soaked: weaker next hit.")
elseif ae == 3 then A.shield = true; blog(who .. " hides behind rock.")
elseif ae == 4 then
if B.boss and vic == "e" and rnd(1, 2) == 1 then blog(vwho .. " shrugs off the shock.")
else V.stun = true; blog(vwho .. " is stunned!") end
elseif ae == 5 then
local h = math.max(1, dmg // 2)
hp_add(att, h); blog(who .. " drains " .. h .. " HP.")
elseif ae == 6 then
local h = math.max(2, ((att == "p") and B.pmax or B.emax) // 5)
hp_add(att, h); blog(who .. " glows and heals " .. h .. ".")
elseif ae == 7 then A.regen = 3; blog(who .. " starts to regrow.")
else V.conf = true; blog(vwho .. " is dazed.") end
end
local function ability()
if tier_of(B.pc) == 4 then return elem_of(B.pc) end
return nil
end
local function enemy_turn()
if not B or B.over then return end
local E, P = B.es, B.ps
local ab = ability()
if E.burn > 0 then
E.burn = E.burn - 1; B.ehp = math.max(0, B.ehp - 2); blog(ename() .. " burns for 2.")
if B.ehp <= 0 then end_battle(true); redraw(); return end
end
if E.regen > 0 then E.regen = E.regen - 1; hp_add("e", 2) end
if E.stun then
E.stun = false; blog(ename() .. " cannot move!"); B.busy = false; redraw(); return
end
if E.conf then
E.conf = false
if rnd(1, 2) == 1 then blog(ename() .. " misses wildly!"); B.busy = false; redraw(); return end
end
if ab == 8 and rnd(1, 100) <= 30 then
blog("Lucid Haze: " .. ename() .. " loses track of you!"); B.busy = false; redraw(); return
end
B.eturn = B.eturn + 1
local L, T = B.lair, B.eturn
if B.wb and T > 10 then blog(ename() .. " knocks you back!"); end_battle(false); redraw(); return end
if B.wb and T % 4 == 0 then B.wbslam = true end
if L == 2 and T % 2 == 0 then hp_add("e", 8); blog(ename() .. " heals 8 HP.") end
if L == 7 then hp_add("e", 4); blog(ename() .. " regrows 4 HP.") end
if L == 3 and T % 4 == 0 then B.burrow = true; blog(ename() .. " burrows underground!"); B.busy = false; redraw(); return end
if L == 8 and T % 3 == 0 then E.shield = true; P.conf = true; blog(ename() .. " shields itself and dazes you!") end
local d, eff = calc_dmg(B.eatk, eelem(), elem_of(B.pc))
if B.wbslam then B.wbslam = false; d = d * 2; blog("SPECIAL ATTACK!") end
if (L == 1 or L == 9) and T % 3 == 0 then
if C.has_ads(S) then blog("Your Anti-dragon shield blocks the dragonfire!")
else d = d * 2; blog("DRAGONFIRE!") end
end
if B.prot then
if C.pray_drain(S) then d = math.max(1, d // 2) else B.prot = false; blog("You have run out of prayer points.") end
end
if ab == 3 then d = math.max(1, d - 3) end
if E.soak then d = math.max(1, d // 2); E.soak = false end
if B.guard then d = math.max(1, d // 2); B.guard = false end
if P.shield then d = math.max(1, d // 2); P.shield = false end
B.php = math.max(0, B.php - d)
B.fxe = { k = "lunge", t = GFX.now() }; B.fxp = { k = "hit", t = GFX.now() + 180, dmg = d, el = eelem(), big = eff == 1 or d * 3 >= B.pmax, ko = B.php <= 0 }
blog(string.format("%s hits you for %d.%s", ename(), d, eff_text(eff)))
if L == 5 then local h = math.max(1, d // 2); hp_add("e", h); blog("The Sire drains " .. h .. " HP.") end
if L == 4 then B.eel = rnd(1, 8); blog(ename() .. " changes to " .. D.elems[B.eel] .. "!") end
B.busy = false
if ab == 7 and B.php > 0 then
B.ehp = math.max(0, B.ehp - 2); blog("Thornbark reflects 2 damage.")
if B.ehp <= 0 then end_battle(true); redraw(); return end
end
if B.php <= 0 then
if ab == 6 and not B.revived then
B.revived = true; B.php = math.max(1, B.pmax // 2); blog("Second Dawn! You rise again.")
else end_battle(false) end
else proc("e", eelem(), d) end
redraw()
end
local function player_act(kind)
if not B or B.over or B.busy then return end
if kind == "special" and B.energy < 3 then note = "Special needs 3 energy."; return end
note = ""
local P, E = B.ps, B.es
local ab = ability()
if ab == 2 then hp_add("p", 3) end
if P.burn > 0 then
P.burn = P.burn - 1; B.php = math.max(0, B.php - 2); blog("You burn for 2.")
if B.php <= 0 then end_battle(false); redraw(); return end
end
if P.regen > 0 then P.regen = P.regen - 1; hp_add("p", 2) end
if P.stun then
P.stun = false; blog("You are stunned and lose the turn!")
B.busy = true
if SAVER then enemy_turn() else after(700, enemy_turn) end
redraw(); return
end
if kind == "guard" then
local heal = math.max(2, B.pmax // 8)
B.php = math.min(B.pmax, B.php + heal)
B.guard = true
B.fxp = { k = "guard", t = GFX.now() }
B.energy = math.min(5, B.energy + 1)
blog(string.format("You guard and recover %d HP.", heal))
else
local atk = B.patk
if kind == "special" then atk = atk * 2; B.energy = B.energy - 3
else B.energy = math.min(5, B.energy + 1) end
local d, eff = calc_dmg(atk, elem_of(B.pc), eelem())
if P.soak then d = math.max(1, d // 2); P.soak = false end
local miss = false
if P.conf then P.conf = false; if rnd(1, 2) == 1 then miss = true end end
if E.shield then d = math.max(1, d // 2); E.shield = false end
if B.lair == 6 and mult(elem_of(B.pc), eelem()) < 2 then d = math.max(1, d // 2) end
local dug = false
if B.burrow then B.burrow = false; miss = true; dug = true end
local now = GFX.now()
B.fxp = { k = "lunge", t = now }
if dug then blog("The mole is underground. Your hit finds only dirt!")
elseif miss then blog("You swing wildly and miss!")
else
B.fxe = { k = "hit", t = now + 180, dmg = d, el = elem_of(B.pc), big = kind == "special" or eff == 1, ko = B.ehp - d <= 0 }
B.ehp = math.max(0, B.ehp - d)
blog(string.format("%s %s for %d.%s", cname(B.pc), (kind == "special") and "unleashes" or "strikes", d, eff_text(eff)))
if ab == 4 and B.ehp > 0 and rnd(1, 100) <= 30 then
B.ehp = math.max(0, B.ehp - d); blog("Double Strike! Another " .. d .. ".")
end
if ab == 5 then local h = math.max(1, d // 2); hp_add("p", h); blog("Eclipse Bite drains " .. h .. " HP.") end
if ab == 1 and B.ehp > 0 then E.burn = 3 end
if B.ehp > 0 then proc("p", elem_of(B.pc), d) end
end
end
if B.ehp <= 0 then
end_battle(true)
else
B.busy = true
if SAVER then enemy_turn() else after(700, enemy_turn) end
end
redraw()
end
local function open_pack(free, rare, elem, count, mint)
count = count or 1
local iron = C and C.is_iron and C.is_iron()
if iron and ((count > 1 and free ~= true) or elem or (not rare and free ~= true)) then
note = "Iron Mode: no buying packs with coins. Use tickets!"; return
end
if count > 1 then
if free == true then
local have = rare and S.camp.rtickets or S.camp.tickets
count = math.min(count, have)
if count < 1 then return end
if rare then S.camp.rtickets = S.camp.rtickets - count else S.camp.tickets = S.camp.tickets - count end
else
local cost = D.pack_cost * count
if S.coins < cost then note = string.format("%d packs cost %d coins.", count, cost); return end
S.coins = S.coins - cost
end
S.packs = S.packs + count
local list = {}
local jack = nil
if CS_FORCE_JACKPOT or rnd(1, 100000) == 1 then
local r = rnd(1, 100)
jack = (r <= 60) and 3 or ((r <= 90) and 4 or 5)
CS_FORCE_JACKPOT = nil
end
for p = 1, count do
for slot = 1, 3 do
local c = jack and D.tier_cards[jack][rnd(1, #D.tier_cards[jack])] or roll_card(slot, free == true and rare or nil)
local sh = rnd(1, 100) <= ((C and C.shiny_pct) and C.shiny_pct() or 3)
local isnew = give_card(c)
if sh then S.shiny[c] = 1 end
list[#list + 1] = { c = c, new = isnew, shiny = sh }
end
end
save_now()
local best = 0
for _, r in ipairs(list) do best = math.max(best, tier_of(r.c)) end
RV = { list = list, idx = 0, fr = 1, best = best, flip = nil, kind = { free, rare, nil, count }, multi = count, jackpot = jack }
scr = "reveal"; focus = 1; note = ""
redraw()
start_opening()
return
end
if mint then
local cost = (mint == 3) and 1200 or 400
if S.dust < cost then note = string.format("This dust pack costs %d dust (you have %d).", cost, S.dust); return end
S.dust = S.dust - cost
elseif elem then
if S.coins < 70 then note = "An element pack costs 70 coins."; return end
S.coins = S.coins - 70
else
if rare then
if S.camp.rtickets < 1 then return end
S.camp.rtickets = S.camp.rtickets - 1
elseif free == true then
if S.camp.tickets < 1 then return end
S.camp.tickets = S.camp.tickets - 1
else
if S.coins < D.pack_cost then
note = string.format("Not enough coins (a pack costs %d).", D.pack_cost)
return
end
S.coins = S.coins - D.pack_cost
end
end
S.packs = S.packs + 1
local list = {}
for slot = 1, 3 do
local c = roll_card(slot, rare, elem, mint)
local sh = rnd(1, 100) <= ((C and C.shiny_pct) and C.shiny_pct() or 3)
local isnew = give_card(c)
if sh then S.shiny[c] = 1 end
list[slot] = { c = c, new = isnew, shiny = sh }
end
save_now()
local best = 0
for i = 1, 3 do best = math.max(best, tier_of(list[i].c)) end
RV = { list = list, idx = 0, fr = 1, best = best, flip = nil, kind = { free, rare, elem, nil, mint } }
scr = "reveal"; focus = 1; note = ""
redraw()
start_opening()
end
local use_focus = false
local go
local function tw(s, f, st) return smudge.text_width(s, f or "ui10", st or "regular") end
local function lh(f) return smudge.line_height(f or "ui10") end
local function ltext(x, y, s, f, st, white) smudge.text(x, y, s, f or "ui10", st or "regular", "left", not white) end
local function ctext(cx, y, s, f, st, white)
ltext(math.floor(cx - tw(s, f, st) / 2), y, s, f, st, white)
end
local function rtext(xr, y, s, f, st) ltext(xr - tw(s, f, st), y, s, f, st) end
local function fit(s, maxw, f, st)
while #s > 1 and tw(s, f, st) > maxw do s = s:sub(1, #s - 1) end
return s
end
local RCLIP = nil
local PH = nil
local function reg(id, x, y, w, h, act, frame)
if RCLIP then
local x0, y0 = math.max(x, RCLIP[1]), math.max(y, RCLIP[2])
local x1, y1 = math.min(x + w, RCLIP[1] + RCLIP[3]), math.min(y + h, RCLIP[2] + RCLIP[4])
if x1 <= x0 or y1 <= y0 then return end
x, y, w, h = x0, y0, x1 - x0, y1 - y0
end
nbtn = nbtn + 1
local b = btns[nbtn]
if not b then b = {}; btns[nbtn] = b end
b.id, b.x, b.y, b.w, b.h, b.act, b.frame = id, x, y, w, h, act, frame
end
local function dither_rr(x, y, w, h, r, dark)
r = math.min(r, w // 2, h // 2)
if r <= 0 then smudge.rect_dither(x, y, w, h, dark); return end
for j = 0, r - 1 do
local d = r - j
local ins = r - math.floor(math.sqrt(r * r - d * d))
smudge.rect_dither(x + ins, y + j, w - 2 * ins, 1, dark)
smudge.rect_dither(x + ins, y + h - 1 - j, w - 2 * ins, 1, dark)
end
smudge.rect_dither(x, y + r, w, h - 2 * r, dark)
end
STONE = true
MONO = false
local function ttint(x, y, w, h, k, mode) if STONE and smudge.tint and not SAVER then smudge.tint(x, y, w, h, k, mode or 3) end end
local TT = { bg = 8, face = 9, ring = 10, top = 11, panel = 12, pop = 13, prog = 14, off = 15, card = 16 }
local function badge_tint(cx, cy, r)
if STONE and smudge.tint_circle and not SAVER then smudge.tint_circle(cx, cy, r, MONO and 11 or 6, 3) end
end
