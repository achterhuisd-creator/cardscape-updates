local pts = {}
for r = 1, 3 do pts[r] = cellc[r * 10 + L[r]] end
local xa = P(262, 0); local xb = P(936, 0)
local seg = { { xa, pts[1][2] }, { pts[1][1], pts[1][2] }, { pts[2][1], pts[2][2] }, { pts[3][1], pts[3][2] }, { xb, pts[3][2] } }
local lens, tot = {}, 0
for q = 1, #seg - 1 do
local a1, b1 = seg[q], seg[q + 1]
if not GFX.ok() then smudge.line(fl(a1[1]), fl(a1[2]), fl(b1[1]), fl(b1[2]), 3) end
lens[q] = math.sqrt((b1[1] - a1[1]) ^ 2 + (b1[2] - a1[2]) ^ 2); tot = tot + lens[q]
end
if GFX.ok() then
local hot = (SL.win or 0) >= (SL.bet or 1) * 10
local cr, cg, cb = 255, 205, 90
if hot then cr, cg, cb = 255, 120, 70 end
local function at_d(d)
local acc = 0
for q = 1, #seg - 1 do
if d <= acc + lens[q] or q == #seg - 1 then
local a1, b1 = seg[q], seg[q + 1]
local dx, dy = (b1[1] - a1[1]) / math.max(1, lens[q]), (b1[2] - a1[2]) / math.max(1, lens[q])
local e = math.max(0, math.min(lens[q], d - acc))
return a1[1] + dx * e, a1[2] + dy * e, dx, dy
end
acc = acc + lens[q]
end
end
local GL = smudge.glass_sprite_quad
local function blob(x0, y0, x1, y1, wd, r, g, b, a)
if not GL then return end
local dx, dy = x1 - x0, y1 - y0
local ln = math.max(1, math.sqrt(dx * dx + dy * dy))
local ux, uy = dx / ln, dy / ln
local ex, ey = ux * wd, uy * wd
local nx, ny = -uy * wd, ux * wd
GL("art/puff_m.raw", 32, 32, x0 - ex + nx, y0 - ey + ny, x1 + ex + nx, y1 + ey + ny, x1 + ex - nx, y1 + ey - ny, x0 - ex - nx, y0 - ey - ny, r, g, b, a)
end
local function cbeam(d0, d1, wd, r, g, b, a)
if not GL then return end
d0 = math.max(0, d0); d1 = math.min(tot, d1)
local acc = 0
for q = 1, #seg - 1 do
local l0, l1 = acc, acc + lens[q]
acc = l1
local s0, s1 = math.max(l0, d0), math.min(l1, d1)
if s1 > s0 then
local x0, y0, dx, dy = at_d(s0); local x1, y1 = at_d(s1)
local nx, ny = -dy * wd, dx * wd
GL("art/solid_m.raw", 8, 8, x0 + nx, y0 + ny, x1 + nx, y1 + ny, x1 - nx, y1 - ny, x0 - nx, y0 - ny, r, g, b, a)
end
end
end
local function beam(d0, d1, wd, r, g, b, k)
local acc = 0
for q = 1, #seg - 1 do
local l0, l1 = acc, acc + lens[q]
acc = l1
local s0, s1 = math.max(l0, d0), math.min(l1, d1)
if s1 > s0 then
local x0, y0, dx, dy = at_d(s0); local x1, y1 = at_d(s1)
local nx, ny = -dy * wd, dx * wd
smudge.glow_quad(x0 + nx, y0 + ny, x1 + nx, y1 + ny, x1 - nx, y1 - ny, x0 - nx, y0 - ny, r, g, b, k)
end
end
end
local age = (now - SL.done) % 900
local u = math.min(1, age / 350)
local head = tot * (1 - (1 - u) ^ 2)
if u < 1 then
local tr = tot * 0.45
cbeam(head - tr, head, 7, cr, cg - 40, cb - 40, 0.55)
cbeam(head - tr * 0.6, head, 3, cr, cg, cb, 0.9)
beam(head - tr, head, 9, cr, cg, cb, 1.1)
beam(head - tr * 0.6, head, 2, 255, 255, 240, 2.6)
local hx, hy, dx, dy = at_d(head)
blob(hx - 1, hy, hx + 1, hy, 11, cr, cg - 60, cb - 60, 0.85)
smudge.glow_circle(hx, hy, 20, 255, 250, 225, 3.0)
smudge.glow_quad(hx - 34, hy - 1.5, hx + 34, hy - 1.5, hx + 34, hy + 1.5, hx - 34, hy + 1.5, 255, 255, 240, 2.4)
smudge.glow_quad(hx - 1.5, hy - 16, hx + 1.5, hy - 16, hx + 1.5, hy + 16, hx - 1.5, hy + 16, 255, 255, 240, 2.0)
for j = 1, 9 do
local d = head - j * 11
if d > 0 then
