end
function C.draw_tasks(S)
local cp = S.camp
if not cp.task or cp.x.tk2 == 0 then new_task(cp) end
local tk = cp.task
head(S, "Slayer master", cp.x.spts .. " pts")
level_panel(cp, 14, TOP + 2)
local y = TOP + 90
panel(20, y, W - 40, 170)
local mon = ADV.CB.MON[tk[1]] or ADV.CB.MON[1]
X.thumb(30, y + 10, mon[6], { show = true, art = string.format("art/ms%02d.raw", ADV.CB.mon_art(tk[1] or 1)) })
X.ltext(150, y + 14, mon[1], "ui12", "bold")
X.ltext(150, y + 44, string.format("Slay %d   (Slayer %d)", tk[2], mon[2]), "small", "bold")
X.ltext(150, y + 66, string.format("HP %d  max hit %d  weak %s", mon[3], mon[4], ({ "melee", "ranged", "magic" })[mon[5]]), "small")
X.bar(150, y + 92, W - 190, 18, math.min(1, tk[3] / tk[2]))
X.ltext(150, y + 116, string.format("%d / %d   streak %d", tk[3], tk[2], cp.x.sstreak), "small", "bold")
local rw = (tk[4] == 1) and (tk[5] .. " coins") or (tk[4] == 2) and (tk[5] .. " dust") or "a pack ticket"
X.ctext(W / 2, y + 144, "Reward: " .. rw .. " + Slayer points", "small")
local ready = tk[3] >= tk[2]
local by = y + 180
if ready then
X.button(24, by, W - 48, 64, "CLAIM REWARD", function() claim_task(S) end, { font = "ui10", id = "CLAIMTASK", dot = "!" })
else
X.button(24, by, W - 48, 64, "FIGHT " .. mon[1]:upper(), function() ADV.CB.slay(S) end, { font = "ui10", id = "SLAYFIGHT", sub = "your own combat" })
end
local hw = (W - 48 - 10) // 2
X.button(24, by + 72, hw, 56, "SKIP TASK", function() X.set_note(ADV.skip_task(S)); new_task(cp); X.save_now() end,
{ font = "ui10", sub = "10 pts", id = "NEWTASK" })
X.button(34 + hw, by + 72, hw, 56, "SLAYER SHOP", function() X.go("slayshop") end, { font = "ui10", id = "SLAYSHOP" })
X.button(24, by + 136, hw, 50, "ARMOURY", function() C.arm_back = "tasks"; X.go("armoury") end, { font = "small", id = "ARMOURY" })
X.button(34 + hw, by + 136, hw, 50, "DROPS", function() ADV.show_drops(ADV.CB.drops_slayer(math.max(1, math.min(#ADV.CB.MON, tk[1])))) end,
{ font = "small", sub = mon[1], id = "SLAYDROPS", nohelp = true })
X.draw_note(by + 196)
back_btn("adventure")
end
C.ready_count = ready_count
C.total_level = total_level
C.cur_skill = function() return cur end
C.skill_name = function(si) return SK[si] and SK[si].name or "Skill" end
C.item_index = IDX
C.item_name = function(i) return ITEMS[i][1] end
C.item_icon = function(i) return ITEMS[i][3] end
C.inv_n, C.inv_add, C.inv_take, C.withdraw, C.inv_used = inv_n, inv_add, inv_take, withdraw, inv_used
C.maxstam = maxstam
C.iron_block = function(w) return ADV.R and ADV.R.iron_block(w) or false end
C._data = { GATHER = GATHER, REC = REC, ITEMS = ITEMS, SK = SK, IDX = IDX, TOOLREQ = TOOLREQ }
local function daily_ok(cp) return clock_ok() and (cp.claimed ~= today() or (cp.dm and cp.dm[6] == 0 and count_item(cp, cp.dm[1]) >= cp.dm[2])) and true or false end
local K = { ITEMS = ITEMS, IDX = IDX, SK = SK, NS = NS, GATHER = GATHER, EQL = EQL, FIRST = ADV_FIRST, CROPS = CROPS,
ACH = ACH, ach_value = ach_value, mmss = mmss,
ready_count = ready_count, ach_ready = ach_ready, daily_ok = daily_ok, today = today, ensure_missions = ensure_missions,
set_cur = function(si) cur = si; rpage = 0 end,
is_mkt = function(i) return MKT_ITEM[i] end, unit_price = unit_price,
open_item = function(i) msel = i; mrange = 0; X.go("mktitem") end,
slevel = slevel, can_gather = can_gather, total_level = total_level, give_xp = give_xp, add_item = add_item, count_item = count_item, maxstam = maxstam,
panel = panel, sprite = sprite, head = head, back_btn = back_btn, mmss = mmss,
mkt_price = mkt_price, mkt_bucket = mkt_bucket, top = function() return TOP end,
inv_n = inv_n, inv_take = inv_take, inv_load = pinv_load, inv_slots = function() return inv_slots() end, food = FOOD,
inv_used = inv_used, stash = stash, count = count_item, take = function(cp, i, n) C.take_items(cp, i, n) end, nplots = FARM.n, REC = REC, STORES = STORES, SHOP_ITEMS = SHOP_ITEMS,
item_info = function(i) return item_info(i) end, GEAR = GEAR, MAX_LVL = MAX_LVL, tool_tier = tool_tier, TIERN = TIERN, TOOLN = TOOLN }
ADV.init(X, K, C)
C.WIKI = dofile("wiki.lua")(X, K, C, ADV)
C.ADV = ADV
return C
end
combat.lua
35872
return function(X, K, C, ADV, G)
local CB = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function I(id) return IDX[id] end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
local SK_MAGIC, SK_R, SK_M, SK_B, SK_RC = 8, 17, 18, 19, 20
local RANGED, MAGIC = {}, {}
for k = 1, 8 do RANGED[I("bow" .. k)] = true end
for _, id in ipairs({ "darkbow", "tbow" }) do RANGED[I(id)] = true end
for _, id in ipairs({ "bstaff", "trident", "kodai", "bstf", "mstf" }) do MAGIC[I(id)] = true end
local function style_of(i) if RANGED[i] then return 2 elseif MAGIC[i] then return 3 end return 1 end
local function weapons(cp, style, all)
local list = {}
for i = 1, #ITEMS do
local e = K.EQL[i]
if e and e[1] == 1 and style_of(i) == style and (all or C.gear_ok(cp, i)) then
local have = cp.inv[i] > 0
for k = 1, 5 do if cp.eq[k] == i then have = true end end
if have then list[#list + 1] = i end
end
end
table.sort(list, function(a, b) return K.EQL[a][2] + G.upg(a) > K.EQL[b][2] + G.upg(b) end)
return list
end
local SLOTKEY = { "mw", "rw", "gw" }
local function wpn(cp, style)
local i = cp.x[SLOTKEY[style]]
if i > 0 then for _, j in ipairs(weapons(cp, style)) do if j == i then return i end end end
return 0
end
local function wbonus(i) if i == 0 then return 0 end return K.EQL[i][2] + G.upg(i) end
local RUNES = { "air", "water", "earth", "fire", "chaos", "nature", "death", "blood", "soul" }
local SPELLS = {
{ "Wind strike", 1, 6, { { "rair", 2 } } },
{ "Water bolt", 15, 12, { { "rwater", 2 }, { "rchaos", 1 } } },
{ "Earth blast", 35, 20, { { "rearth", 3 }, { "rdeath", 1 } } },
{ "Fire wave", 55, 30, { { "rfire", 4 }, { "rblood", 1 } } },
{ "Soul surge", 80, 42, { { "rsoul", 2 }, { "rblood", 2 } } },
}
for _, sp in ipairs(SPELLS) do for _, r in ipairs(sp[4]) do r[1] = I(r[1]) end end
local function casts(cp, sp)
local n = 9999
for _, r in ipairs(sp[4]) do n = math.min(n, cp.inv[r[1]] // r[2]) end
return n
end
local function best_spell(cp)
local best
for _, sp in ipairs(SPELLS) do if lvl(cp, SK_MAGIC) >= sp[2] and casts(cp, sp) > 0 then best = sp end end
return best
end
CB.SPELLS = SPELLS
function CB.stats(cp)
local mel, rng, mag, blk = lvl(cp, SK_M), lvl(cp, SK_R), lvl(cp, SK_MAGIC), lvl(cp, SK_B)
local armour = 0
for k = 2, 5 do local i = cp.eq[k] or 0; local e = K.EQL[i]; if i > 0 and e then armour = armour + e[3] end end
local _, uh = G.upg_bonus(cp)
local sp = best_spell(cp)
return {
clvl = fl((math.max(mel, rng, mag) + blk) / 2),
mmax = 6 + mel + 2 * wbonus(wpn(cp, 1)),
rmax = 6 + rng + 2 * wbonus(wpn(cp, 2)),
gmax = sp and (sp[3] + fl(mag / 2) + 2 * wbonus(wpn(cp, 3))) or 0,
spell = sp,
hp = 40 + 4 * blk + armour + uh,
bchance = math.min(35, 5 + fl(blk * 0.3)),
red = math.min(25, fl(blk * 0.25)),
}
end
G.combat = CB.stats
local HEAL = { stew = 8, pie = 12, roast = 16, feast = 20, lstew = 22, spie = 26, mroast = 30, dfeast = 35, prest = 25, hpot = 30, shpot = 60 }
local FUSE = { patk = { "boost", 0.15, "+15% dmg" }, pover = { "boost", 0.30, "+30% dmg -10HP" }, ppray = { "pray", 0, "prayer" },
prest = { "restore", 25, "+25HP prayer" }, hpot = { "heal", 30, "+30 HP" }, shpot = { "heal", 60, "+60 HP" } }
local function fuse(i)
for id, u in pairs(FUSE) do if I(id) == i then return u[1], u[2], u[3] end end
for id, h in pairs(HEAL) do if I(id) == i then return "heal", h, "+" .. h .. " HP" end end
end
local function usable_count()
local n = 0
for _, e in ipairs(K.inv_slots()) do if fuse(e[1]) then n = n + 1 end end
return n
end
local function best_food(cp)
local bi, bh
for id, h in pairs(HEAL) do local i = I(id); if i and K.inv_n(i) > 0 and (not bh or h > bh) then bi, bh = i, h end end
return bi, bh
end
local function food_count(cp) local n = 0; for id in pairs(HEAL) do local i = I(id); if i then n = n + K.inv_n(i) end end return n end
local F
local function flog(t) table.insert(F.log, t); while #F.log > 4 do table.remove(F.log, 1) end end
function CB.start(S, o)
local c = CB.stats(S.camp)
F = { o = o, php = o.php or c.hp, pmax = c.hp, ehp = o.hp, emax = o.maxhp or o.hp, log = {}, turn = 0, over = false }
flog("You face " .. o.name .. "!")
X.go("fight")
end
local WSTYLE = { "MELEE", "RANGED", "MAGIC" }
local function finish(S, win, text)
F.over = true; F.win = win
F.result = text or ""
if F.o.on_end then F.result = F.o.on_end(S, win, F) or F.result end
if win and X.rnd(1, 3) == 1 then
local hp = F.emax or 50
local id = (hp >= 400 and X.rnd(1, 2) == 1) and "gtors" or (hp >= 200 and X.rnd(1, 2) == 1) and "gsnap"
or (hp >= 80 and X.rnd(1, 2) == 1) and "grana" or "ggua"
K.add_item(S.camp, I(id), 1)
F.result = (F.result or "") .. ", +1 " .. ITEMS[I(id)][1]
end
X.save_now()
end
local function f_act(S, kind, item)
if not F or F.over then return end
local cp = S.camp
local c = CB.stats(cp)
F.turn = F.turn + 1
local stance = false
if kind == "block" then
stance = true
local h = math.max(2, fl(F.pmax * 0.05))
F.php = math.min(F.pmax, F.php + h)
flog("You raise your guard (+" .. h .. " HP).")
K.give_xp(S, SK_B, 6)
elseif kind == "use" then
local k, v = fuse(item)
if not k or K.inv_n(item) < 1 then F.turn = F.turn - 1; return end
K.inv_take(item, 1); cp.stat[5] = cp.stat[5] + 1
F.bag = false
local nm = ITEMS[item][1]
if k == "heal" then F.php = math.min(F.pmax, F.php + v); flog("You use " .. nm .. " (+" .. v .. " HP).")
elseif k == "boost" then
F.boost = math.max(F.boost or 0, v)
if item == I("pover") then F.php = math.max(1, F.php - 10) end
flog(nm .. ": +" .. fl(v * 100) .. "% damage this fight!")
elseif k == "pray" then C.pray_full(S); flog(nm .. ": prayer restored.")
else F.php = math.min(F.pmax, F.php + v); C.pray_full(S); flog(nm .. ": +" .. v .. " HP and prayer restored.") end
elseif kind == "eat" then
local i, h = best_food(cp)
if not i then flog("No food in your inventory!"); F.turn = F.turn - 1; return end
K.inv_take(i, 1); cp.stat[5] = cp.stat[5] + 1
F.php = math.min(F.pmax, F.php + h)
flog("You eat " .. ITEMS[i][1] .. " (+" .. h .. " HP).")
else
local style = (kind == "melee") and 1 or ((kind == "ranged") and 2 or 3)
local mx = (style == 1) and c.mmax or ((style == 2) and c.rmax or c.gmax)
if style == 3 then
if not c.spell then flog("You need runes for a spell (Runecrafting)."); F.turn = F.turn - 1; return end
for _, r in ipairs(c.spell[4]) do cp.inv[r[1]] = cp.inv[r[1]] - r[2] end
end
local mult = ((F.o.weak == style) and 1.5 or 0.8) * (1 + G.R.kc_bonus(cp, F.o.kc)) * (1 + (F.boost or 0))
if X.rnd(1, 100) <= 80 then
local d = fl(X.rnd(fl(mx / 2), mx) * mult + 0.5)
F.ehp = F.o.on_hit and F.o.on_hit(d) or math.max(0, F.ehp - d)
local what = (style == 1) and "blade" or ((style == 2) and "arrow" or c.spell[1])
flog(string.format("Your %s hits for %d%s", what, d, (mult > 1) and " (weak spot!)" or ""))
K.give_xp(S, ({ SK_M, SK_R, SK_MAGIC })[style], math.max(1, fl(d * 0.6)))
if F.ehp <= 0 then finish(S, true); return end
else
flog((style == 3) and "Your spell fizzles!" or "You miss!")
end
end
local bmax = F.o.maxhit
local special = F.o.special and (F.turn % F.o.special == 0)
if special then bmax = bmax * 2 end
local bc = c.bchance + (stance and 35 or 0)
if X.rnd(1, 100) <= bc then
flog(F.o.name .. (special and "'s special" or "'s attack") .. " is BLOCKED!")
K.give_xp(S, SK_B, 4)
else
local d = X.rnd(fl(bmax / 3), bmax)
d = fl(d * (100 - c.red) / 100 + 0.5)
if F.prot then
if C.pray_drain(S) then d = fl(d / 2) else F.prot = false; flog("Out of prayer points.") end
end
F.php = math.max(0, F.php - d)
flog(string.format("%s %s you for %d.", F.o.name, special and "SLAMS" or "hits", d))
K.give_xp(S, SK_B, math.max(1, fl(d / 2)))
if F.php <= 0 then finish(S, false, "You were knocked out.") end
end
X.save_now()
end
local function mon_frame(x, y, sz, c, art)
smudge.draw_sprite(x, y, sz, sz, art or string.format((sz <= 96) and "art/s%02d.raw" or "art/l%02d.raw", c - 1))
smudge.rect(x - 5, y - 5, sz + 10, sz + 10, false, 3)
smudge.rect(x - 10, y - 10, sz + 20, sz + 20, false, 1)
end
CB.mon_frame = mon_frame
function C.draw_fight(S)
local cp = S.camp
if not F then X.go("adventure"); return end
local o = F.o
head(S, o.title or o.name, "")
local y = TOPY() + 2
if F.bag then mon_frame(W - 18 - 96, y + 14, 96, o.card, o.art and (o.art:gsub("/m(%d)", "/ms%1")))
elseif o.boss then G.boss_frame(W - 18 - 192, y + 34, 192, o.card, o.art) else mon_frame(W - 18 - 192, y + 30, 192, o.card, o.art) end
X.ltext(24, y + 4, X.fit(o.name, 220, "ui12", "bold"), "ui12", "bold")
X.bar(24, y + 40, 210, 20, F.ehp / math.max(1, F.emax))
X.ltext(24, y + 64, string.format("HP %d / %d", F.ehp, F.emax), "small", "bold")
X.ltext(24, y + 86, "Weak to " .. WSTYLE[o.weak], "small")
X.ltext(24, y + 106, o.special and ("Special every " .. o.special .. " turns") or ("Max hit " .. o.maxhit), "small")
local c = CB.stats(cp)
local py = y + 136
X.ltext(24, py, "You  (combat " .. c.clvl .. ")", "ui10", "bold")
X.bar(24, py + 26, 210, 20, F.php / F.pmax)
X.ltext(24, py + 50, string.format("HP %d / %d", F.php, F.pmax) .. ((F.boost or 0) > 0 and string.format("   +%d%% dmg", fl(F.boost * 100)) or ""), "small", "bold")
local ly = y + 246
if not X.saver() then smudge.rounded_rect(28, ly + 4, W - 48, 106, 8, true, 1) end
smudge.rounded_rect(24, ly, W - 48, 106, 8, true, 1, false)
smudge.rounded_rect(24, ly, W - 48, 106, 8, false, 2)
for i, l in ipairs(F.log) do X.ltext(36, ly + 6 + (i - 1) * 24, X.fit(l, W - 72, "small"), "small") end
local by = ly + 116
if F.over then
X.wrapped(30, by, F.result or "", W - 60, "ui10", 4)
local again = o.again
X.button(24, by + 104, W - 48, 64, F.win and "CONTINUE" or (again and "FIGHT AGAIN" or "CONTINUE"), function()
local f = F
if (not f.win) and again then again(S) else F = nil; X.go(o.back or "adventure"); if o.after then o.after(S, f) end end
end, { id = "FCONT" })
if o.drops then
X.button(96, H - 96, W - 24 - 96 - 130, 64, "BACK", function() F = nil; X.go(o.back or "adventure") end, { font = "ui10", nohelp = true })
X.button(W - 24 - 120, H - 96, 120, 64, "DROPS", function() ADV.show_drops(o.drops()) end, { font = "ui10", id = "FDROPS", nohelp = true })
else
X.button(24, H - 96, W - 48, 64, "BACK", function() F = nil; X.go(o.back or "adventure") end, { font = "ui10" })
end
return
end
if F.bag then
local gy = py + 4
smudge.rounded_rect(16, gy - 6, W - 32, H - 112 - gy, 12, true, 1, false)
smudge.rounded_rect(16, gy - 6, W - 32, H - 112 - gy, 12, false, 3)
X.reg("BAGPANEL", 16, gy - 6, W - 32, H - 112 - gy, function() end)
X.ctext(W / 2, gy, string.format("HP %d / %d   (an item uses your turn)", F.php, F.pmax), "small", "bold")
local slots = K.inv_slots()
local cw, chh = (W - 48 - 12) // 4, math.min(56, (H - 120 - (gy + 26)) // 7 - 4)
for s2 = 1, 28 do
local col, row = (s2 - 1) % 4, (s2 - 1) // 4
local bx, byy = 24 + col * (cw + 4), gy + 26 + row * (chh + 4)
local e = slots[s2]
if e then
local k, _, lab = fuse(e[1])
X.button(bx, byy, cw, chh, "", function() if k then f_act(S, "use", e[1]) else X.set_note(ITEMS[e[1]][1] .. " can't be used in a fight.") end end,
{ off = not k, id = "BAG" .. s2 })
sprite(bx + 5, byy + 3, 24, ITEMS[e[1]][3])
if k then X.ltext(bx + 32, byy + 4, X.fit(lab, cw - 36, "small", "bold"), "small", "bold") end
local nm = X.fit(ITEMS[e[1]][1], cw - 10, "small")
if not k then smudge.rounded_rect(bx + 3, byy + chh - 23, X.tw(nm, "small") + 6, X.lh("small") + 2, 3, true, 1, false) end
X.ltext(bx + 5, byy + chh - 22, nm, "small")
else
smudge.rounded_rect(bx, byy, cw, chh, 6, false, 1)
end
end
X.button(24, H - 96, W - 48, 64, "CLOSE ITEMS", function() F.bag = false end, { font = "ui10", id = "BAGCLOSE" })
return
end
local tw = (W - 48 - 16) // 3
X.button(24, by, tw, 64, "MELEE", function() f_act(S, "melee") end, { font = "ui10", sub = "max " .. c.mmax, id = "FMELEE" })
X.button(32 + tw, by, tw, 64, "RANGED", function() f_act(S, "ranged") end, { font = "ui10", sub = "max " .. c.rmax, id = "FRANGED" })
X.button(40 + 2 * tw, by, tw, 64, "MAGIC", function() f_act(S, "magic") end,
{ font = "ui10", sub = c.spell and ("max " .. c.gmax) or "no runes", off = not c.spell, id = "FMAGIC" })
X.button(24, by + 72, tw, 58, "BLOCK", function() f_act(S, "block") end, { font = "small", sub = "+35%, heal", id = "FBLOCK" })
local uc = usable_count()
X.button(32 + tw, by + 72, tw, 58, "ITEMS", function() F.bag = true end, { font = "small", sub = uc .. " food/pots", off = uc == 0, id = "FITEMS" })
local pp, pmx = C.pray_points(S)
X.button(40 + 2 * tw, by + 72, tw, 58, F.prot and "PRAY ON" or "PRAY", function()
if not F.prot and pp <= 0 then X.set_note("No prayer points left."); return end
F.prot = not F.prot
end, { font = "small", sub = pp .. "/" .. pmx, active = F.prot, id = "FPRAY" })
local function leave() local f = F; F = nil; if o.on_leave then o.on_leave(S, f) end; X.go(o.back or "adventure") end
if o.drops then
X.button(96, H - 96, W - 24 - 96 - 130, 64, "LEAVE", leave, { font = "ui10", id = "FLEAVE", nohelp = true })
X.button(W - 24 - 120, H - 96, 120, 64, "DROPS", function() ADV.show_drops(o.drops()) end, { font = "ui10", id = "FDROPS", nohelp = true })
else
X.button(24, H - 96, W - 48, 64, "LEAVE", leave, { font = "ui10", id = "FLEAVE" })
end
end
CB.WB_WEAK = { 2, 1, 1, 2 }
function CB.wb_fight(S)
local cp = S.camp
local slot, alive, _, boss, bi = G.wb_info(cp)
if not alive then X.set_note("The world boss is not here right now."); return end
local x = cp.x
CB.start(S, {
title = "World boss - " .. boss[1], name = boss[1], card = boss[3], boss = true, art = string.format("art/m%02d.raw", 17 + bi),
drops = function() return CB.drops_wb(cp, bi) end,
hp = x.wbhp, maxhp = x.wbmax, maxhit = fl(3 + 0.5 * CB.stats(cp).clvl), weak = CB.WB_WEAK[bi], special = 4, kc = "wb" .. bi,
back = "worldboss", again = CB.wb_fight,
on_hit = function(d) x.wbhp = math.max(0, x.wbhp - d); x.wbdmg = x.wbdmg + d; return x.wbhp end,
on_end = function(S2, win) if win then return G.wb_kill(S2) end return "Knocked out. Your damage stays on the boss - fight again!" end,
})
end
local MON = {
{ "Slime", 1, 18, 3, 1, 3, nil, 0, 1 }, { "Cave Beetle", 5, 26, 4, 2, 7, nil, 0, 1 },
{ "Wild Boar", 10, 34, 6, 1, 5, nil, 0, 2 }, { "Bone Snail", 15, 40, 6, 3, 15, nil, 0, 2 },
{ "Wailing Ghost", 20, 52, 8, 3, 13, nil, 0, 3 }, { "Goblin Grunt", 25, 64, 9, 1, 19, nil, 0, 3 },
{ "Mud Golem", 35, 90, 12, 1, 27, "gmaul", 40, 4 }, { "Venom Scorpion", 45, 110, 14, 2, 23, "leafb", 40, 5 },
{ "Skull Shrike", 55, 135, 16, 3, 29, "whip", 60, 6 }, { "Blood Crab", 65, 150, 18, 1, 20, nil, 0, 6 },
{ "Shadow Spider", 75, 175, 20, 2, 37, "darkbow", 50, 7 }, { "Razor Jaw", 85, 210, 24, 3, 34, "hclaw", 50, 8 },
{ "Ash Wraith", 87, 220, 25, 3, 33, nil, 0, 8, 37 }, { "Iron Troll", 89, 235, 26, 2, 27, nil, 0, 8, 38 },
{ "Frost Basilisk", 91, 250, 27, 1, 34, nil, 0, 8, 39 }, { "Abyss Eel", 93, 265, 28, 2, 42, nil, 0, 8, 40 },
{ "Bone Knight", 95, 280, 29, 3, 29, nil, 0, 8, 41 }, { "Hydra Spawn", 96, 295, 30, 1, 39, nil, 0, 8, 42 },
{ "Hoard Mimic", 97, 310, 31, 3, 43, nil, 0, 8, 43 }, { "Rune Serpent", 99, 330, 33, 2, 36, nil, 0, 8, 44 },
}
CB.MON = MON
function CB.mon_name(k) return MON[k] and MON[k][1] or "?" end
function CB.mon_art(k) return MON[k] and MON[k][10] or k end
function CB.pick_monster(cp)
local cand = {}
for k, m in ipairs(MON) do if lvl(cp, 14) >= m[2] then cand[#cand + 1] = k end end
return cand[X.rnd(math.max(1, #cand - 3), #cand)]
end
local DROP_ITEMS = { "log", "oak", "willow", "maple", "yew", "magic", "elder", "anc", "copper", "iron", "coal", "mith", "adam", "rstone", "dragon", "celes" }
local function mon_drop(S, k)
local cp = S.camp
local m = MON[k]
local coins = X.rnd(fl(m[3] / 2), m[3])
X.add_coins(coins)
local parts = { coins .. " coins" }
local t = m[9]
local pick = ({ DROP_ITEMS[t], DROP_ITEMS[8 + t] })[X.rnd(1, 2)]
local n = X.rnd(1, 3)
K.add_item(cp, I(pick), n); parts[#parts + 1] = n .. " " .. ITEMS[I(pick)][1]
if X.rnd(1, 3) == 1 then local r = I("r" .. RUNES[math.min(9, t + 1)]); local rn = X.rnd(3, 8); K.add_item(cp, r, rn); parts[#parts + 1] = rn .. " " .. ITEMS[r][1] end
if m[7] and G.lucky(m[8]) then ADV.grant(cp, m[7]); parts[#parts + 1] = "RARE: " .. ITEMS[I(m[7])][1] .. "!" end
if ADV.drop_clue(cp, 2, 25) then parts[#parts + 1] = "Medium clue!" end
return table.concat(parts, ", ")
end
function CB.drops_slayer(k)
local m = MON[k]
local t = m[9]
local rows = {
{ "Coins", fl(m[3] / 2) .. "-" .. m[3], 1 },
{ ITEMS[I(DROP_ITEMS[t])][1], "1-3", 0.5 }, { ITEMS[I(DROP_ITEMS[8 + t])][1], "1-3", 0.5 },
{ ITEMS[I("r" .. RUNES[math.min(9, t + 1)])][1], "3-8", 1 / 3 },
}
if m[7] then rows[#rows + 1] = { ITEMS[I(m[7])][1], "1", ADV.p(m[8], true) } end
rows[#rows + 1] = { "Medium clue scroll", "1", 1 / 25 }
ADV.herb_rows(rows, m[3])
rows[#rows + 1] = { "Bronze box", "1", ADV.p(10, true) }
rows[#rows + 1] = { "Silver box", "1", ADV.p(40, true) }
rows[#rows + 1] = { "Crystal key", "1", ADV.p(30, true) }
ADV.pet_row(rows, "pet14", 3000)
return m[1], rows, string.format("Slayer %d   %d HP   +%d Slayer xp", m[2], m[3], m[3])
end
function CB.drops_wb(cp, bi)
local boss = G.WBOSS[bi]
local rows = { { "Coins", "250+dmg/5", 1 }, { "Dust", "60", 1 }, { "RARE pack ticket", "1", 1 }, { "Silver box", "1", 1 },
{ "Gold box", "1", ADV.p(4, true) }, { ITEMS[I(boss[4])][1], "1", ADV.p(8, true) }, { "Hard clue scroll", "1", 1 / 3 } }
ADV.herb_rows(rows, cp.x.wbmax or 500)
return boss[1], rows, "when the boss dies (shared damage)"
end
function CB.drops_raid()
local pg = ADV.p(3, true)
local rows = { { "Coins", "300+dmg", 1 }, { "Dust", "80", 1 }, { "Pack ticket", "1", 1 },
{ "Gold box", "1", pg }, { "Silver box", "1", 1 - pg }, { "MYTHIC box", "1", ADV.p(50, true) }, { "Instance token", "1", ADV.p(3, true) } }
for _, u in ipairs({ "tbow", "kodai", "dclaws", "ancrobe" }) do rows[#rows + 1] = { ITEMS[I(u)][1], "1", ADV.p(12, true) / 4 } end
rows[#rows + 1] = { "Hard clue scroll", "1", 1 / 4 }
return "Raid chest", rows, "after room 5 (each room can drop herbs)"
end
function CB.drops_todt()
local rows = { { "Coins", "20+pts/4", 1 }, { "Supply items", "2-6 each", 1 }, { "Bronze box", "300+ pts", 1 },
{ "Silver box", "on a win", ADV.p(5, true) }, { "Pyromancer piece", "500+ pts", ADV.p(6, true) },
{ "Lumberjack piece", "500+ pts", ADV.p(8, true) } }
ADV.pet_row(rows, "phoenix", 50)
rows[#rows][2] = "500+ pts"
return "Wintertodt crate", rows, "1 supply roll per 100 points (logs, ores, fish)"
end
function CB.slay(S)
local cp = S.camp
local tk = cp.task
if not tk then return end
if tk[3] >= tk[2] then X.set_note("Task done! Claim your reward first."); return end
local k = math.max(1, math.min(#MON, tk[1]))
local m = MON[k]
if lvl(cp, 14) < m[2] then X.set_note("You need Slayer " .. m[2] .. " for " .. m[1] .. "."); return end
CB.start(S, {
title = "Slayer - " .. m[1], name = m[1], card = m[6], art = string.format("art/m%02d.raw", CB.mon_art(k)), hp = m[3], maxhp = m[3], maxhit = m[4], weak = m[5], kc = "slay",
drops = function() return CB.drops_slayer(k) end,
back = "tasks", again = CB.slay,
on_end = function(S2, win)
if not win then return "The " .. m[1] .. " got you. Eat some food and try again." end
tk[3] = tk[3] + 1
local t = "Killed! " .. mon_drop(S2, k) .. G.R.on_slayer_kill(S2) .. K.give_xp(S2, 14, m[3])
t = t .. G.pet_roll(S2, 14)
if tk[3] >= tk[2] then t = t .. "  TASK COMPLETE!" end
return t
end,
})
end
local RAID = {
{ "Tiki Mask", 21, 2 }, { "Hog Brute", 18, 1 }, { "Bone Shroom", 30, 3 }, { "Drill Knight", 26, 1 }, { "Mad Hatter", 33, 2 },
}
local RAID_U = { "tbow", "kodai", "dclaws", "ancrobe" }
local R
local function raid_room(S)
local cp = S.camp
local c = CB.stats(cp)
local rm = RAID[R.room]
local final = R.room == #RAID
local hp = final and (120 + 14 * c.clvl) or (40 + 6 * c.clvl)
CB.start(S, {
title = string.format("Raid room %d/5", R.room), name = rm[1], card = rm[2], boss = final, art = string.format("art/m%02d.raw", 12 + R.room),
hp = hp, maxhp = hp, maxhit = fl((final and 5 or 3) + (final and 0.55 or 0.45) * c.clvl), weak = rm[3], special = final and 3 or nil,
php = R.php, back = "raid", kc = "raid",
drops = function() return rm[1], ADV.herb_rows({}, hp), "raid room; the chest comes after room 5" end,
on_hit = function(d) R.pts = R.pts + d; return nil end,
on_end = function(S2, win, f)
R.php = f.php
if win then R.room = R.room + 1; return rm[1] .. " is down!" end
R.dead = true
return "You fell in the raid. The party drags you out."
end,
on_leave = function(S2, f) R.php = f.php end,
})
end
local start0 = CB.start
CB.start = function(S, o)
if o.on_hit then
local h = o.on_hit
o.on_hit = function(d) local r = h(d); if r == nil then return math.max(0, F.ehp - d) end return r end
end
start0(S, o)
end
local function raid_start(S)
local cp = S.camp
R = { room = 1, php = CB.stats(cp).hp, pts = 0 }
X.go("raid")
end
local function raid_chest(S)
local cp = S.camp
local pts = R.pts
local coins, dust = 300 + pts, 80
X.add_coins(coins); X.add_dust(dust); cp.tickets = cp.tickets + 1
cp.x.raids = cp.x.raids + 1
local t = string.format("Raid chest: %d coins, %d dust, a pack ticket", coins, dust)
t = t .. G.R.on_raid(S)
if G.lucky(12) then local u = RAID_U[X.rnd(1, #RAID_U)]; ADV.grant(cp, u); t = t .. "  PURPLE: " .. ITEMS[I(u)][1] .. "!" end
if ADV.drop_clue(cp, 3, 4) then t = t .. "  Hard clue!" end
R.done = t
X.set_note(t)
X.save_now()
end
function C.draw_raid(S)
local cp = S.camp
head(S, "Raid", "completed " .. cp.x.raids)
local y = TOPY() + 6
if not R then
panel(20, y, W - 40, 236)
X.ltext(34, y + 10, "Chambers of the Card King", "ui12", "bold")
X.wrapped(34, y + 48, "5 rooms: Tiki Mask, Hog Brute, Bone Shroom, Drill Knight and the Mad Hatter. Your HP carries over between rooms, so bring food. Clear all 5 for a chest with a 1 in 12 chance of a purple: Twisted bow, Kodai wand, Dragon claws or Ancestral robe.", W - 70, "small", 6)
local c = CB.stats(cp)
X.ltext(34, y + 206, string.format("Combat %d   HP %d   food %d", c.clvl, c.hp, food_count(cp)), "small", "bold")
X.button(24, y + 248, W - 48, 74, "ENTER", function() raid_start(S) end, { id = "RAIDGO" })
local hw = (W - 48 - 10) // 2
X.button(24, y + 330, hw, 60, "ARMOURY", function() C.arm_back = "raid"; X.go("armoury") end, { font = "ui10", id = "ARMOURY" })
X.button(34 + hw, y + 330, hw, 60, "DROPS", function() ADV.show_drops(CB.drops_raid()) end, { font = "ui10", id = "RAIDDROPS", nohelp = true })
back_btn("adventure")
return
end
for k, rm in ipairs(RAID) do
local bx = 24 + (k - 1) * 88
local done = k < R.room
if k == R.room and not R.dead then smudge.rounded_rect(bx, y, 80, 80, 8, true) else smudge.rounded_rect(bx, y, 80, 80, 8, false, 2) end
X.ctext(bx + 40, y + 14, tostring(k), "ui12", "bold", k == R.room and not R.dead)
X.ctext(bx + 40, y + 50, done and "done" or (k == #RAID and "BOSS" or "room"), "small", "bold", k == R.room and not R.dead)
end
local c = CB.stats(cp)
X.ctext(W / 2, y + 96, string.format("HP %d / %d    damage %d    food %d", R.php, c.hp, R.pts, food_count(cp)), "ui10", "bold")
local by = y + 130
if R.done then
X.wrapped(30, by, R.done, W - 60, "ui10", 4)
X.button(24, by + 110, W - 48, 70, "LEAVE THE RAID", function() R = nil end, { id = "RAIDEND" })
elseif R.dead then
X.wrapped(30, by, "You were knocked out in room " .. R.room .. ". No chest this time.", W - 60, "ui10", 3)
X.button(24, by + 110, W - 48, 70, "LEAVE THE RAID", function() R = nil end, { id = "RAIDEND" })
elseif R.room > #RAID then
X.ctext(W / 2, by + 10, "All rooms cleared!", "ui12", "bold")
X.button(24, by + 50, W - 48, 76, "OPEN THE CHEST", function() raid_chest(S) end, { id = "RAIDCHEST", dot = "!" })
else
X.ctext(W / 2, by, "Next: " .. RAID[R.room][1], "ui12", "bold")
X.button(24, by + 40, W - 48, 74, "ENTER ROOM " .. R.room, function() raid_room(S) end, { id = "RAIDROOM" })
X.button(24, by + 122, W - 48, 62, "EAT", function()
local i, h = best_food(cp)
if not i then X.set_note("No food in your inventory."); return end
K.inv_take(i, 1); cp.stat[5] = cp.stat[5] + 1; R.php = math.min(c.hp, R.php + h); X.set_note("Ate " .. ITEMS[i][1] .. " (+" .. h .. " HP).")
end, { font = "ui10", off = food_count(cp) == 0 or R.php >= c.hp, id = "RAIDEAT" })
X.button(24, by + 192, W - 48, 56, "GIVE UP", function() R = nil; X.set_note("You left the raid.") end, { font = "small", id = "RAIDQUIT" })
end
back_btn("adventure")
end
local T
local PYRO = { "pyro1", "pyro2", "pyro3", "pyro4" }
local function pyro_count(cp) local n = 0; for _, id in ipairs(PYRO) do if ADV.owns(cp, id) then n = n + 1 end end return n end
local function tlog(t) table.insert(T.log, t); while #T.log > 3 do table.remove(T.log, 1) end end
local function todt_start(S)
local cp = S.camp
T = { energy = 100, hp = CB.stats(cp).hp, roots = 0, kindling = 0, brazier = 1, pts = 0, log = {} }
tlog("The Wintertodt howls. Keep the brazier burning!")
X.go("todt")
end
local function todt_crate(S, won)
local cp = S.camp
local pts = won and T.pts or fl(T.pts / 2)
local parts = {}
local rolls = math.max(1, fl(pts / 100))
for _ = 1, rolls do
local pool = { "oak", "willow", "maple", "yew", "magic", "iron", "coal", "mith", "adam", "trout", "salmon", "lob", "pl3", "pl4" }
local id = pool[X.rnd(1, #pool)]
local n = X.rnd(2, 6)
K.add_item(cp, I(id), n); parts[#parts + 1] = n .. " " .. ITEMS[I(id)][1]
end
local coins = 20 + fl(pts / 4); X.add_coins(coins)
local t = string.format("Supply crate (%d pts): %d coins, %s", pts, coins, table.concat(parts, ", "))
if pts >= 500 and G.lucky(6) then
local miss = {}
for _, id in ipairs(PYRO) do if not ADV.owns(cp, id) then miss[#miss + 1] = id end end
if #miss > 0 then local id = miss[X.rnd(1, #miss)]; ADV.grant(cp, id); t = t .. "  " .. ITEMS[I(id)][1] .. "!" end
end
if pts >= 500 and G.lucky(8) then
local miss = {}
for k = 1, 4 do if not ADV.owns(cp, "lj" .. k) then miss[#miss + 1] = "lj" .. k end end
if #miss > 0 then local id = miss[X.rnd(1, #miss)]; ADV.grant(cp, id); t = t .. "  " .. ITEMS[I(id)][1] .. "!" end
end
if pts >= 500 and G.lucky(50) and not ADV.owns(cp, "phoenix") then ADV.grant(cp, "phoenix"); t = t .. "  PET: Phoenix!" end
cp.x.todt = cp.x.todt + 1
t = t .. G.R.on_todt(S, pts, won)
T.done = t
X.save_now()
end
local function todt_act(S, a)
if not T or T.done then return end
local cp = S.camp
if a == "chop" then T.roots = T.roots + 1; tlog("You chop a bruma root."); K.give_xp(S, 1, 8 + fl(lvl(cp, 1) / 5))
elseif a == "fletch" then
if T.roots < 1 then tlog("No roots to fletch."); return end
T.roots = T.roots - 1; T.kindling = T.kindling + 1; tlog("You fletch kindling."); K.give_xp(S, 6, 10 + fl(lvl(cp, 6) / 5))
elseif a == "feed" then
if T.brazier ~= 1 then tlog(T.brazier == 2 and "The brazier is broken!" or "The brazier is out!"); return end
local p
if T.kindling > 0 then T.kindling = T.kindling - 1; p = 25 elseif T.roots > 0 then T.roots = T.roots - 1; p = 10 else tlog("Nothing to burn."); return end
p = fl(p * (1 + G.R.kc_bonus(cp, "todt")) + 0.5)
K.give_xp(S, 21, 6 + fl(lvl(cp, 21) / 5))
T.pts = T.pts + p; T.energy = math.max(0, T.energy - fl(p / 3)); tlog("The flames roar! +" .. p .. " points")
elseif a == "fix" then
if T.brazier == 2 then T.brazier = 1; T.pts = T.pts + 25; tlog("You fix the brazier."); K.give_xp(S, 16, 20)
elseif T.brazier == 0 then T.brazier = 1; T.pts = T.pts + 6; tlog("You light the brazier.") else tlog("The brazier is fine."); return end
elseif a == "eat" then
local i, h = best_food(cp)
if not i then tlog("No food in your inventory!"); return end
K.inv_take(i, 1); cp.stat[5] = cp.stat[5] + 1; T.hp = math.min(CB.stats(cp).hp, T.hp + h); tlog("You eat (+" .. h .. " HP).")
end
local cold = math.max(0, X.rnd(1, 5) - pyro_count(cp))
T.hp = math.max(0, T.hp - cold)
if T.brazier == 1 then
local r = X.rnd(1, 100)
if r <= 12 then T.brazier = 2; tlog("The brazier BREAKS!") elseif r <= 20 then T.brazier = 0; tlog("The brazier goes out!") end
end
if T.energy <= 0 then tlog("The Wintertodt is subdued!"); todt_crate(S, true)
elseif T.hp <= 0 then tlog("The cold knocks you out..."); todt_crate(S, false) end
end
function C.draw_todt(S)
local cp = S.camp
head(S, "Wintertodt", "games " .. cp.x.todt)
local y = TOPY() + 6
if not T then
panel(20, y, W - 40, 220)
X.ltext(34, y + 10, "Wintertodt", "ui12", "bold")
X.wrapped(34, y + 46, "A skilling boss. Chop bruma roots, fletch them into kindling and feed the brazier until the Wintertodt's energy hits 0. Fix the brazier when it breaks, light it when it goes out, and eat when the cold hurts. 500+ points: chance of Pyromancer pieces (less cold) and the Phoenix pet.", W - 70, "small", 7)
X.button(24, y + 232, W - 48, 74, "START", function() todt_start(S) end, { id = "TODTGO" })
X.button(24, y + 314, W - 48, 56, "DROPS", function() ADV.show_drops(CB.drops_todt()) end, { font = "ui10", id = "TODTDROPS", nohelp = true })
back_btn("adventure")
return
end
local c = CB.stats(cp)
X.ltext(24, y, "Wintertodt energy", "small", "bold")
X.bar(24, y + 22, W - 48, 22, T.energy / 100)
X.ltext(24, y + 52, "Your HP", "small", "bold")
X.bar(24, y + 74, W / 2 - 40, 18, T.hp / c.hp)
X.rtext(W - 24, y + 52, "Points " .. T.pts, "ui10", "bold")
X.rtext(W - 24, y + 76, string.format("roots %d  kindling %d", T.roots, T.kindling), "small")
local bs = ({ [0] = "OUT", [1] = "BURNING", [2] = "BROKEN" })[T.brazier]
local bx, byy = W // 2, y + 160
smudge.rect(bx - 40, byy + 10, 80, 30, true)
smudge.rect(bx - 50, byy + 4, 100, 8, true)
if T.brazier == 1 then
for k = 0, 2 do smudge.triangle(bx - 30 + k * 30 - 12, byy + 4, bx - 30 + k * 30 + 12, byy + 4, bx - 30 + k * 30, byy - 40 + (k % 2) * 14, true) end
elseif T.brazier == 2 then smudge.line(bx - 30, byy + 12, bx + 10, byy + 38, 3, false)
end
X.ctext(bx, byy + 46, "Brazier: " .. bs, "ui10", "bold")
local ly = y + 236
for i, l in ipairs(T.log) do X.ltext(30, ly + (i - 1) * 22, X.fit(l, W - 60, "small"), "small") end
local by = ly + 72
if T.done then
X.wrapped(30, by, T.done, W - 60, "small", 5)
X.button(24, by + 116, W - 48, 64, "DONE", function() T = nil end, { id = "TODTDONE" })
back_btn("adventure")
return
end
local tw = (W - 48 - 16) // 3
X.button(24, by, tw, 64, "CHOP", function() todt_act(S, "chop") end, { font = "ui10", id = "TCHOP" })
X.button(32 + tw, by, tw, 64, "FLETCH", function() todt_act(S, "fletch") end, { font = "ui10", off = T.roots < 1, id = "TFLETCH" })
X.button(40 + 2 * tw, by, tw, 64, "FEED", function() todt_act(S, "feed") end, { font = "ui10", off = T.brazier ~= 1 or (T.roots + T.kindling) < 1, id = "TFEED" })
X.button(24, by + 72, tw, 58, T.brazier == 0 and "LIGHT" or "FIX", function() todt_act(S, "fix") end, { font = "ui10", off = T.brazier == 1, id = "TFIX", dot = (T.brazier ~= 1) and "!" or nil })
X.button(32 + tw, by + 72, tw, 58, "EAT", function() todt_act(S, "eat") end, { font = "ui10", off = food_count(cp) == 0, id = "TEAT" })
X.button(40 + 2 * tw, by + 72, tw, 58, "LEAVE", function() T = nil end, { font = "ui10", id = "TLEAVE" })
back_btn("adventure")
end
local apage = 0
local function alch_value(i) if K.is_mkt(i) then return K.unit_price(CB.S, i) end return fl(ITEMS[i][2] * 1.3 + 0.5) end
local function alch(S, i)
CB.S = S
local cp = S.camp
if lvl(cp, SK_MAGIC) < 21 then X.set_note("High Alchemy needs Magic 21."); return end
local nat, fire = I("rnature"), I("rfire")
if cp.inv[nat] < 1 or cp.inv[fire] < 3 then X.set_note("Needs 1 nature rune + 3 fire runes."); return end
if cp.inv[i] < 1 then return end
cp.inv[i] = cp.inv[i] - 1; cp.inv[nat] = cp.inv[nat] - 1; cp.inv[fire] = cp.inv[fire] - 3
local v = alch_value(i)
X.add_coins(v)
X.set_note("High Alchemy: " .. ITEMS[i][1] .. " -> " .. v .. " coins" .. K.give_xp(S, SK_MAGIC, 30))
X.save_now()
end
function C.draw_alch(S)
CB.S = S
local cp = S.camp
head(S, "High Alchemy", "")
local y0 = TOPY() + 2
X.ctext(W / 2, y0, string.format("1 nature + 3 fire runes each   (you have %d / %d)", cp.inv[I("rnature")], cp.inv[I("rfire")]), "small", "bold")
local list = {}
for i = 1, #ITEMS do if cp.inv[i] > 0 and not ITEMS[i][1]:find(" rune$") then list[#list + 1] = i end end
local per = 7
local pages = math.max(1, math.ceil(#list / per))
if apage >= pages then apage = pages - 1 end
local sp = rows_sp(y0 + 26, per + 1, 66)
local function alrow(n, k, by)
local i = list[n]
if i then
panel(20, by, W - 40, sp - 6)
sprite(30, by + (sp - 6 - 24) // 2, 24, ITEMS[i][3])
X.ltext(62, by + 4, X.fit(ITEMS[i][1] .. "  x" .. cp.inv[i], 250, "small", "bold"), "small", "bold")
X.ltext(62, by + sp - 30, alch_value(i) .. " coins", "small")
X.button(W - 24 - 110, by + 4, 100, sp - 14, "ALCH", function() alch(S, i) end, { font = "small", id = "ALCH" .. k })
end
end
local ny = y0 + 26 + per * sp
if not X.list("alch", y0 + 26, nil, #list, sp, function(n, by) alrow(n, n, by) end) then
for k = 1, per do alrow(apage * per + k, k, y0 + 26 + (k - 1) * sp) end
X.button(24, ny, 140, 44, "PREV", function() if apage > 0 then apage = apage - 1 end end, { font = "small", off = apage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (apage + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 44, "NEXT", function() if apage < pages - 1 then apage = apage + 1 end end, { font = "small", off = apage >= pages - 1, id = "NEXT" })
end
back_btn("bank")
end
function C.draw_armoury(S)
local cp = S.camp
local c = CB.stats(cp)
head(S, "Armoury", "combat " .. c.clvl)
local y = TOPY() + 4
panel(20, y, W - 40, 96)
X.ltext(34, y + 8, string.format("Melee %d   Ranged %d   Magic %d", c.mmax, c.rmax, c.gmax), "ui10", "bold")
X.ltext(34, y + 38, string.format("HP %d   Block %d%%   -%d%% damage", c.hp, c.bchance, c.red), "small")
X.ltext(34, y + 64, c.spell and ("Spell: " .. c.spell[1] .. " (" .. casts(cp, c.spell) .. " casts)") or "Spell: none (craft runes)", "small")
local cw = (W - 40 - 16) // 3
for st = 1, 3 do
local x0 = 20 + (st - 1) * (cw + 8)
local list = weapons(cp, st, true)
local cur = wpn(cp, st)
X.ctext(x0 + cw // 2, y + 108, WSTYLE[st], "small", "bold")
local sp = math.min(58, (H - 96 - 8 - (y + 132)) // 8)
local rows = { 0 }
for _, i in ipairs(list) do if #rows < 8 then rows[#rows + 1] = i end end
for k, i in ipairs(rows) do
local by = y + 132 + (k - 1) * sp
local name = (i == 0) and "none" or (ITEMS[i][1] .. ((G.upg(i) > 0) and (" +" .. G.upg(i)) or ""))
local ok, rsk, rl = true, nil, nil
if i > 0 then ok, rsk, rl = C.gear_ok(cp, i) end
X.button(x0, by, cw, sp - 6, "", function()
if not ok then X.set_note(string.format("You need %s level %d to wield that.", SK[rsk].name, rl)); return end
cp.x[SLOTKEY[st]] = i; X.save_now()
end, { id = ({ "MW", "RW", "GW" })[st] .. k, active = (cur == i), off = not ok })
X.ltext(x0 + 6, by + 4, X.fit(name, cw - 12, "small", "bold"), "small", "bold")
X.ltext(x0 + 6, by + sp - 30, (i == 0) and "+0" or (ok and ("+" .. wbonus(i)) or ("Lv " .. rl)), "small")
end
end
back_btn(C.arm_back or "adventure")
end
function CB.draw_combat_skill(S, si, y)
local cp = S.camp
local c = CB.stats(cp)
panel(20, y, W - 40, 200)
local lines = {
[SK_R] = { "Ranged levels raise your ranged max hit.", string.format("Ranged max hit: %d", c.rmax) },
[SK_M] = { "Melee levels raise your melee max hit.", string.format("Melee max hit: %d", c.mmax) },
[SK_B] = { "Block raises your max HP, block chance and damage reduction.", string.format("HP %d   block %d%%   -%d%% damage", c.hp, c.bchance, c.red) },
}
X.wrapped(34, y + 12, lines[si][1], W - 70, "ui10", 2)
X.ltext(34, y + 74, lines[si][2], "ui10", "bold")
X.ltext(34, y + 104, "Combat level " .. c.clvl, "small", "bold")
X.wrapped(34, y + 130, "Train it on Slayer monsters, in the raid and against the world boss.", W - 70, "small", 2)
X.button(24, y + 212, W - 48, 60, "ARMOURY", function() C.arm_back = "skill"; X.go("armoury") end, { font = "ui10", sub = "choose your weapons", id = "ARMOURY" })
end
CB.SCR = { "fight", "raid", "todt", "alch", "armoury" }
CB.PARENT = { fight = "adventure", raid = "adventure", todt = "adventure", alch = "bank", armoury = "adventure" }
return CB
end
data.lua
10447
local D = {}
D.elems = { "FIRE", "WATER", "EARTH", "STORM", "SHADOW", "LIGHT", "NATURE", "DREAM" }
D.tiers = { "COMMON", "UNCOMMON", "RARE", "LEGENDARY", "EXOTIC", "MYTHIC", "SECRET" }
D.ncards = 102
D.S2 = 52
D.S3 = 76
D.tier_cards = {}
for t = 0, 5 do
local l = {}
for k = 1, 8 do l[#l + 1] = t * 8 + k end
if t <= 2 then for k = 1, 8 do l[#l + 1] = D.S2 - 1 + t * 8 + k end end
if t >= 3 then for k = 1, 8 do l[#l + 1] = D.S3 - 1 + (t - 3) * 8 + k end end
D.tier_cards[t] = l
end
D.tier_cards[6] = { 49, 50, 51, 100, 101, 102 }
D.order, D.order_pos = {}, {}
for t = 0, 6 do for _, c in ipairs(D.tier_cards[t]) do D.order[#D.order + 1] = c; D.order_pos[c] = #D.order end end
function D.step(c, d)
local n = #D.order
local i = D.order_pos[c] or 1
return D.order[(i - 1 + d) % n + 1]
end
function D.pick(t, e, rnd)
e = e or rnd(1, 8)
if t <= 2 and rnd(1, 2) == 2 then return D.S2 - 1 + t * 8 + e end
if t >= 3 and t <= 5 and rnd(1, 2) == 2 then return D.S3 - 1 + (t - 3) * 8 + e end
return t * 8 + e
end
