C.parent_of = function(scr)
local m = { camp = "title", skills = "camp", skill = "skills", bank = "camp", missions = "camp", daily = "rewards",
expedition = "camp", training = "camp", achieve = "rewards", expsend = "expedition",
gear = "camp", shop = "camp", pet = "camp", tasks = "adventure", market = "camp", mktitem = "market" }
