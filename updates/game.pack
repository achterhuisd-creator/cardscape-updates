SCREENS.gear = function() C.draw_gear(S) end
SCREENS.shop = function() C.draw_shop(S) end
SCREENS.pet = function() C.draw_pet(S) end
SCREENS.tasks = function() C.draw_tasks(S) end
SCREENS.market = function() C.draw_market(S) end
