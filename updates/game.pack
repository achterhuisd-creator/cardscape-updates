local function inv_slots()
local t = {}
for _, e in ipairs(PINV) do
if stacks(e[1]) then t[#t + 1] = { e[1], e[2] } else for _ = 1, e[2] do t[#t + 1] = { e[1], 1 } end end
end
return t
end
