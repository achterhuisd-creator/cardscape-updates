smudge.glow_quad(x0 + 4, y0, x0 + 12, y0, x0 + 12, y1, x0 + 4, y1, 255, 255, 255, 0.35)
if r == 3 and SL.tease and SL.t0 and not SL["s3"] and now - SL.t0 > SL.stop[2] then
