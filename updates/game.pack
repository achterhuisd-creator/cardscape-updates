X.button(bx, by, cw, chh, "", function() isel = { slot = s2 }; drop_ok = false end, { active = on, id = "INV" .. s2 })
sprite(bx + 6, by + 3, 24, ITEMS[e[1]][3])
if stacks(e[1]) then X.ltext(bx + 36, by + 4, tostring(e[2]), "small", "bold") end
X.ltext(bx + 6, by + 24, X.fit(ITEMS[e[1]][1], cw - 12, "small"), "small", on and "bold" or nil)
else
smudge.rounded_rect(bx, by, cw, chh, 6, false, 1)
end
end
local ay = gy + 7 * (chh + 4) + 4
