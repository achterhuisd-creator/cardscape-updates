local function packs3d(x, y, w, h)
local rx, ry = V3.tilt_get("packs", x, y, w, h, 1.2)
local cx, cy = x + w / 2, y + h / 2
local sc = math.min(w / 330, h / 250)
local cr, sr, cxr, sxr = math.cos(ry), math.sin(ry), math.cos(rx), math.sin(rx)
local function P(px, py, pz)
px, py, pz = px * sc, py * sc, pz * sc
local x1, z1 = px * cr + pz * sr, -px * sr + pz * cr
local y2, z2 = py * cxr - z1 * sxr, py * sxr + z1 * cxr
local k = 900 / (900 + z2)
return cx + x1 * k, cy + y2 * k
end
local now = smudge.millis()
local PW, PH, TH = 116, 168, 6
local function area(q) local a = 0; for m = 0, 3 do local n = (m + 1) % 4; a = a + q[m * 2 + 1] * q[n * 2 + 2] - q[n * 2 + 1] * q[m * 2 + 2] end return a end
local function pack(ox, oy, oz, ang)
local ca, sa = math.cos(ang), math.sin(ang)
local function pt(u, v, dz) local a, b2 = P(ox + u * ca - v * sa, oy + u * sa + v * ca, oz + (dz or 0)); return a, b2 end
local function quad(u0, v0, u1, v1, dz0, dz1)
local a1, b1 = pt(u0, v0, dz0); local a2, b2 = pt(u1, v0, dz1 or dz0)
local a3, b3 = pt(u1, v1, dz1 or dz0); local a4, b4 = pt(u0, v1, dz0)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
if not SAVER then
local q = quad(-PW / 2, -PH / 2, PW / 2, PH / 2, 40)
smudge.draw_sprite_quad("art/bp_shadow.raw", 160, 232, q[1] + 8 * sc, q[2] + 10 * sc, q[3] + 8 * sc, q[4] + 10 * sc,
q[5] + 8 * sc, q[6] + 10 * sc, q[7] + 8 * sc, q[8] + 10 * sc, "art/bp_front_m.raw")
end
for _, sd in ipairs({ -1, 1 }) do
local u = sd * PW / 2 * 0.96
local q = quad(u, -PH / 2, u, PH / 2, -TH, TH)
if (area(q) > 0) == (sd > 0) then
smudge.draw_sprite_quad("art/bp_side.raw", 24, 232, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], "art/bp_side_m.raw")
end
end
local f = quad(-PW / 2, -PH / 2, PW / 2, PH / 2, -TH)
if area(f) > 0 then
smudge.draw_sprite_quad("art/bp_front.raw", 160, 232, f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8], "art/bp_front_m.raw")
if smudge.glare_quad then
local ph = 0.5 + ry * 2.2 + ox / 300
local x0 = -PW / 2 + (ph - 0.25) * PW * 1.4
local function cl(v) return math.max(-PW / 2 + 6, math.min(PW / 2 - 6, v)) end
local g = { pt(cl(x0), -PH / 2 + 14, -TH - 1) }
local g2 = { pt(cl(x0 + 16), -PH / 2 + 14, -TH - 1) }
local g3 = { pt(cl(x0 + 16 - 40), PH / 2 - 14, -TH - 1) }
local g4 = { pt(cl(x0 - 40), PH / 2 - 14, -TH - 1) }
smudge.glare_quad(g[1], g[2], g2[1], g2[2], g3[1], g3[2], g4[1], g4[2], false)
end
else
local b = quad(PW / 2, -PH / 2, -PW / 2, PH / 2, TH)
smudge.draw_sprite_quad("art/bp_back.raw", 160, 232, b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], "art/bp_back_m.raw")
end
end
pack(-74, 8, 34, -0.24)
pack(74, 8, 34, 0.24)
pack(0, 0, 0, 0)
for k, pos in ipairs({ { -150, -70 }, { 150, -40 }, { -120, 90 }, { 140, 100 }, { 0, -112 } }) do
local t = math.sin(now / 380 + k * 1.9)
if t > 0.25 then local a, b2 = P(pos[1], pos[2], 10); sparkle(math.floor(a), math.floor(b2), math.floor((5 + 8 * t) * sc)) end
end
end
