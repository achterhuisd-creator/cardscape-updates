UI.pic("inv_slot", bx + 2, by + 2, bx + 42, by + 42)
IV.slot_item({ id = rec.out, n = rec.n }, bx, by)
if not IV.can(rec) then UI.pic("dither", bx + 6, by + 6, bx + 38, by + 38) end
end
end
if MODE ~= "furnace" and MODE ~= "chest" then
UI.pic("inv_slot", gx + 362, gy + 10, gx + 402, gy + 50)
UI.pic("it_bk", gx + 366, gy + 14, gx + 398, gy + 46)
end
local TG = {}
for _, sl in ipairs(IV.slots()) do
if not (IV.BOOK and (sl[1] == "C" or sl[1] == "T" or sl[1] == "OUT")) then TG[#TG + 1] = { gx + sl[3] * 2, gy + sl[4] * 2, 44, 44, sl = sl } end
end
if IV.BOOK then
for _, b in ipairs(IV.book_cells()) do TG[#TG + 1] = { b[2], b[3], 42, 44, rec = b[1] } end
TG[#TG + 1] = { gx + 282, gy + 10, 36, 36, page = -1 }
TG[#TG + 1] = { gx + 322, gy + 10, 36, 36, page = 1 }
end
if MODE ~= "furnace" and MODE ~= "chest" then TG[#TG + 1] = { gx + 362, gy + 10, 40, 40, book = true } end
if MODE == "chest" and IV.CH and IV.CH[2] then
TG[#TG + 1] = { gx + 282, gy + 4, 32, 36, cpage = -1 }; TG[#TG + 1] = { gx + 368, gy + 4, 32, 36, cpage = 1 }
end
IV.TG = TG
local P = WD.PAD
if P and P.on then
local tg = P.cur and TG[P.cur]
if tg then UI.pic("hb_sel", tg[1], tg[2], tg[1] + tg[3], tg[2] + tg[4]) end
local n = WD.bn()
OT.c(W // 2, gy + IH + 14, X.fit(n.A .. ": take / put   " .. n.X .. ": half / one   " .. n.B .. ": throw   " .. n.Y .. ": close", W - 16, "small"), "small")
else
OT.c(W // 2, gy + IH + 14, X.fit("Drag to move. Hold still first: half. Drag out: drop.", W - 24, "small"), "small")
end
if D and D.it then
UI.pic("it_" .. D.it.id, D.x - 26, D.y - 46, D.x + 26, D.y + 6)
if D.it.n > 1 then UI.num(D.it.n, D.x + 30, D.y + 8) end
end
local tip, tx2, ty2 = nil, 0, 0
if P and P.on and P.mx then
local tg = P.cur and TG[P.cur]
if tg and not (D and D.it) then tip = IV.what(tg) end
tx2, ty2 = P.mx + 26, P.my - 10
elseif IV.TIP and ms() - IV.TIP[2] < 2200 then tip, tx2, ty2 = IV.TIP[1], IV.TIP[3], IV.TIP[4] end
local tw2 = tip and X.tw(tip, "small", "bold") or 0
if tip and tx2 + tw2 > W - 6 then tx2 = math.max(6, tx2 - tw2 - 60) end
if tip then
UI.tip(tx2 - 12, ty2 - 6, tx2 + tw2 + 12)
OT.l(tx2, ty2 - 2, tip, "small", "bold")
end
if P and P.on and P.mx then UI.pic("ui_cursor", fl(P.mx) - 2, fl(P.my) - 2, fl(P.mx) + 30, fl(P.my) + 30) end
end
function C.draw_wilds(S)
K.head(S, "The Wilds", "")
OT.colours(true)
local y0 = K.top()
local y1 = Hh - 8
V = { y0, y1 }
if not hd() then
smudge.rounded_rect(24, y0 + 40, W - 48, 160, 12, false, 2)
OT.c(W // 2, y0 + 70, "The Wilds", "ui12", "bold")
OT.c(W // 2, y0 + 110, X.fit("A world to walk in: on the phone only.", W - 80, "small"), "small")
K.back_btn("skills")
return
end
if WORLD == nil then draw_choose(y0); return end
if WORLD == "setup" then draw_setup(y0); return end
if WORLD == "list" then draw_list(y0); return end
if WORLD == "share" then draw_share(y0); return end
if WORLD == "join" then draw_join(y0); if WORLD == "join" then return end end
local t = ms()
if not LAST or t - LAST > 1500 then LOADING = t end
if LOADING then
LAST = t
local a = math.min(1, (t - LOADING) / LOAD_MS)
smudge.rect(0, y0, W, Hh - y0, true, 1, false)
NQ, CAP = 0, CAPW.all
UI.nine("ui_panel", 48, 6, 24, fl((y0 + Hh) / 2) - 80, W - 48, 140, 3)
OT.c(W // 2, fl((y0 + Hh) / 2) - 50, "The Wilds", "ui12", "bold")
OT.c(W // 2, fl((y0 + Hh) / 2) - 16, "Loading the world...", "small")
local bw = math.min(360, W - 80)
local bx, by = fl((W - bw) / 2), fl((y0 + Hh) / 2) + 14
smudge.rounded_rect(bx, by, bw, 18, 8, false, 2)
smudge.rounded_rect(bx + 3, by + 3, math.max(12, fl((bw - 6) * a)), 12, 6, true)
local o = -9
for j = 1, math.min(#ALL, 950) do
local i = ((WD.LOADK or 0) + j - 1) % #ALL + 1
local nm = ALL[i]
local x, y = 4 + (j % 80) * 6, y0 + 4 + (j // 80) * 6
smudge.hires_quad("^" .. nm, o, o, o, o, o, o, o, o, x, y, x + 4, y, x + 4, y + 4, x, y + 4)
end
WD.LOADK = ((WD.LOADK or 0) + 950) % math.max(1, #ALL)
if a >= 1 then LOADING = nil end
busy()
return
end
local dt = LAST and math.min(0.05, (t - LAST) / 1000) or 0
LAST = t
if MP then mp_tick(t, dt) end
WD.pad(t)
WX.T = WX.T + dt
MAP.paint(t)
move(dt)
local guest = MP and MP.role == "G"
if not guest then for _, L in pairs(WD.LV) do for i, F in pairs(L.FURN) do WD.ftick(F, dt) end end end
if MP and MP.st == 2 and next(MP.peers) then WD.msync(t) end
if WD.Z == 0 then WD.atick(t, dt) end
WD.gtick(t, dt)
if ABTN and not PANEL and not IV.open and t - ABTN.t0 >= 260 then ABTN.mining = true; WD.mine(dt) end
if WD.CB then
if PANEL or IV.open or not can_build() then WD.CB = nil else PL.face = WD.CB.face; WD.place(false) end
end
for k = #IV.DROPS, 1, -1 do
local d = IV.DROPS[k]
local d2 = (d.x - PL.x) ^ 2 + (d.y - PL.y) ^ 2
if (d.z or 0) == WD.Z and t - d.t0 > (d.wait and 2000 or 450) and d2 < 84 ^ 2 and d2 >= 30 ^ 2 then
local room = false
for j = 1, 36 do local it = IV.S[j]; if not it or (it.id == d.id and it.n < IV.max(it.id)) then room = true; break end end
if room then
local f = math.min(1, dt * 9)
d.x, d.y = d.x + (PL.x - d.x) * f, d.y + (PL.y - 8 - d.y) * f
d.fly = true
end
end
if (d.z or 0) == WD.Z and t - d.t0 > (d.wait and 2000 or 450) and (d.x - PL.x) ^ 2 + (d.y - PL.y) ^ 2 < 36 ^ 2 then
local left = IV.add(d.id, d.n, d.d)
if left < d.n then snd("wl_pop", 0.35); dirty = true; WD.pt("pt_spark", PL.x, PL.y, 0, -40, 0, 350, 12, X.rnd(-8, 8), -30) end
if left == 0 then table.remove(IV.DROPS, k); mp_send("y|" .. d.uid)
else
if left < d.n then d.n = left; mp_send(string.format("x|%s|%s|%d|%d|%d|%d|%d", d.uid, d.id, d.n, d.x, d.y, d.z or 0, d.d or 0)) end
if t - (IV.told or 0) > 4000 then IV.told = t; X.set_note("Your bag is full") end
end
end
end
if dirty and t - lastSave > 1500 then save() end
local vh = y1 - y0
local cx = fl(math.max(0, math.min(N * TS - W, PL.x - W / 2)) + 0.5)
local cy = fl(math.max(0, math.min(N * TS - vh, PL.y - vh / 2)) + 0.5)
local ox, oy = -cx, y0 - cy
NQ, CAP = 0, CAPW.w
smudge.set_clip(0, y0, W, vh)
do
NQ = NQ + 1
smudge.hires_quad("hd/wl_ui_mapbg_c.png", 0, y0, W, y0, W, y1, 0, y1, 0, y0, W, y0, W, y1, 0, y1)
end
do
local C = WD.CAM
if C.a ~= C.to then
local st = 200 * dt
C.a = (math.abs(C.to - C.a) <= st) and C.to or (C.a + ((C.to > C.a) and st or -st))
PL.sface = WD.sface(PL.face)
end
end
WD.camset(cx + W / 2, cy + vh / 2, y0, vh)
local TURN = WD.CAM.a ~= 0
local tx0, tx1 = math.max(0, fl(cx / TS)), math.min(N - 1, fl((cx + W) / TS))
local ty0, ty1 = math.max(0, fl(cy / TS)), math.min(N - 1, fl((cy + vh) / TS))
if TURN then
local xa, xb, ya, yb = math.huge, -math.huge, math.huge, -math.huge
for _, c in ipairs({ { 0, y0 }, { W, y0 }, { 0, y1 }, { W, y1 } }) do
local wx, wy = WD.unP(c[1], c[2])
xa, xb, ya, yb = math.min(xa, wx), math.max(xb, wx), math.min(ya, wy), math.max(yb, wy)
end
tx0, tx1 = math.max(0, fl(xa / TS) - 1), math.min(N - 1, fl(xb / TS) + 2)
ty0, ty1 = math.max(0, fl(ya / TS) - 1), math.min(N - 1, fl(yb / TS) + 4)
end
local WCOV = WX.cover()
local function draw_one(p, px, py, face)
if p.id then
local a = (t - p.t0) / 1000
local h = (a < 0.4) and math.sin(a / 0.4 * math.pi) * 16 or (math.sin(t / 320 + p.x) + 1) * 2
shadow(px, py, 26)
q("it_" .. p.id, px - 16, fl(py - 30 - h), px + 16, fl(py + 2 - h), true)
elseif p.an then
shadow(px, py, 54)
UI.animal(p.an, px, py + 4, face, UI.idle(p.step, 0, p))
else
shadow(px, py, 40)
WD.walkfx(p, t)
local mining = (p == PL) and ABTN and ABTN.mining
local sw, use = 0, false
if mining then sw, use = WD.swing() end
local hid = (p == PL) and (IV.S[ST.sel] and IV.S[ST.sel].id) or p.hold
local st = UI.idle(p.step, 0, p)
local tag = use and ("use_" .. face) or ((st == "i") and ("idle_" .. face)) or (face .. st)
p._tag, p._px, p._py = tag, px, py + 4
local hd = HANDS[tag]
local behind = (hd and hd[3]) and (hd[3] == 1) or (not (hd and hd[3]) and face == "up")
if behind then UI.held(hid, px, py + 4, face, sw, tag) end
UI.char((p == PL) and ST.look or (p.look or ST.parse(nil)), px, py + 4, face, st, 1, use)
if not behind then UI.held(hid, px, py + 4, face, sw, tag) end
end
end
local LIGHTS = {}
if TURN then WD.draw3(t, tx0, tx1, ty0, ty1, draw_one, LIGHTS, y0, y1) else
local wf = "t_wa" .. (fl(t / 260) % 4 + 1)
local bk, names = {}, {}
for ty = ty0, ty1 do for tx = tx0, tx1 do
local gi0 = ty * N + tx
if OPQ[WD.B[gi0] or ""] or OPQ[WD.B[gi0 + N] or ""] then goto hidden end
local g = WD.G[gi0] or "gr1"
if WCOV > 0.12 and (g == "gr1" or g == "di1" or g == "fl3" or g == "sa1") then g = g .. "_sn" .. ((WCOV > 0.6) and 2 or 1) end
local nm = (g == "wa") and wf or ("t_" .. g)
local l = bk[nm]
if not l then l = {}; bk[nm] = l; names[#names + 1] = nm end
l[#l + 1] = tx; l[#l + 1] = ty
::hidden::
end end
table.sort(names)
for _, nm in ipairs(names) do
local l = bk[nm]
for k = 1, #l, 2 do local sx, sy = l[k] * TS + ox, l[k + 1] * TS + oy; q(nm, sx, sy, sx + TS, sy + TS, true) end
end
do
local ff = fl(t / 650) % 2 + 1
local cov = WX.cover()
local sn = (cov > 0.6) and "fx_snow2" or "fx_snow1"
for ty = ty0, ty1 do for tx = tx0, tx1 do
local i = ty * N + tx
local g = WD.G[i]
local sx, sy = tx * TS + ox, ty * TS + oy
if g == "wa" then
if ty > 0 and WD.G[i - N] ~= "wa" then q("fx_foam_n" .. ff, sx, sy, sx + TS, sy + 9, true) end
if ty < N - 1 and WD.G[i + N] ~= "wa" then q("fx_foam_s" .. ff, sx, sy + TS - 9, sx + TS, sy + TS, true) end
if tx > 0 and WD.G[i - 1] ~= "wa" then q("fx_foam_w" .. ff, sx, sy, sx + 9, sy + TS, true) end
if tx < N - 1 and WD.G[i + 1] ~= "wa" then q("fx_foam_e" .. ff, sx + TS - 9, sy, sx + TS, sy + TS, true) end
end
end end
for k = #WD.FP, 1, -1 do
local f = WD.FP[k]
local a = t - f.t0
if a > 30000 or cov < 0.3 then table.remove(WD.FP, k)
else local x, y = fl(f.x + ox), fl(f.y + oy); q("pt_foot" .. math.min(3, 1 + fl(a / 10000)), x - 10, y - 6, x + 11, y + 6, true) end
end
end
local BB = WD.B
for ty = ty0, ty1 do
for tx = tx0, tx1 do
local i = ty * N + tx
if not BB[i] or IV.FLAT[BB[i]] then
local function sb(j) local v = BB[j]; return v and not IV.FLAT[v] and v ~= "tr" end
local m = ((tx > 0 and sb(i - 1)) and 1 or 0) + ((ty > 0 and sb(i - N)) and 2 or 0) + ((tx > 0 and ty > 0 and sb(i - N - 1)) and 4 or 0)
local sx, sy = tx * TS + ox, ty * TS + oy
local l, u = (tx > 0 and sb(i - 1)) and 1 or 0, (ty > 0 and sb(i - N)) and 1 or 0
local ul, r = (tx > 0 and ty > 0 and sb(i - N - 1)) and 1 or 0, (tx < N - 1 and sb(i + 1)) and 1 or 0
if m > 0 or r > 0 then q("sh" .. l .. u .. ul .. r, sx, sy, sx + TS, sy + TS, true) end
end
end
end
local list = {}
if MP then for nm, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then list[#list + 1] = { p.y, p } end end end
list[#list + 1] = { PL.y, PL }
for _, a in ipairs((WD.Z == 0) and WD.ANIM or {}) do
if a.x > cx - TS * 2 and a.x < cx + W + TS * 2 and a.y > cy - TS and a.y < cy + vh + TS * 2 then list[#list + 1] = { a.y, a } end
end
for _, d in ipairs(IV.DROPS) do
if (d.z or 0) == WD.Z and d.x > cx - TS and d.x < cx + W + TS and d.y > cy - TS and d.y < cy + vh + TS then list[#list + 1] = { d.y, d } end
end
table.sort(list, function(a, b) return a[1] < b[1] end)
local wi = 1
local function walkers(upto)
while list[wi] and list[wi][1] < upto do
local p = list[wi][2]
draw_one(p, fl(p.x + ox), fl(p.y + oy), p.face)
wi = wi + 1
end
end
local gi, gid = WD.ghost()
for ty = ty0, math.min(N - 1, ty1 + 1) do
if gi and gi // N == ty then
local sx, sy = (gi % N) * TS + ox, ty * TS + oy
if IV.PLANT[gid] then local pb = IV.PLANT[gid]; q("t_" .. ((pb == "sg") and "sg" or (pb .. "1")) .. "_gh", sx, sy - 12, sx + TS, sy + 36, true)
elseif IV.FLOOR[gid] or gid == "sd" or gid == "su" then q("t_" .. gid .. "_gh", sx, sy, sx + TS, sy + TS, true)
elseif IV.FLAT[gid] then q("t_" .. gid .. "_gh", sx, sy - 12, sx + TS, sy + 36, true)
else q("t_" .. gid .. "_gh", sx, sy - TS, sx + TS, sy + TS, true) end
end
walkers(ty * TS + 1)
for tx = tx0, tx1 do
local i = ty * N + tx
local b = WD.B[i]
if b == "to" then
local sx, sy = tx * TS + ox, ty * TS + oy
q("t_tl" .. (fl(t / 150 + i * 0.61) % 4 + 1), sx, sy - 12, sx + TS, sy + 36, true)
LIGHTS[#LIGHTS + 1] = { sx + TS / 2, sy, 150 }
elseif b == "sd" or b == "su" then
local sx, sy = tx * TS + ox, ty * TS + oy
q("t_" .. b, sx, sy, sx + TS, sy + TS, true)
elseif IV.GROWB[b] then
local sx, sy = tx * TS + ox, ty * TS + oy
if ABTN and ABTN.ti == i and ABTN.hitt and t - ABTN.hitt < 90 then sx = sx + 2 end
WD.swayq((b == "sg") and "t_sg" or ("t_" .. b .. WD.stage(i)), sx, sy - 12, sx + TS, sy + 36, WD.sway(t, i, 3))
elseif b == "tr" then
local sx, sy = tx * TS + ox, ty * TS + oy
if ABTN and ABTN.ti == i and ABTN.hitt and t - ABTN.hitt < 90 then sx = sx + ((t - ABTN.hitt < 45) and 3 or -2) end
q("shadow", fl(sx - 6), fl(sy + TS - 14), fl(sx + TS + 6), fl(sy + TS + 4), true)
WD.swayq("t_tr", sx - TS / 2, sy + TS - 144, sx + TS * 1.5, sy + TS, WD.sway(t, i, 4))
if ABTN and ABTN.ti == i and ABTN.shown then
q("crack" .. math.min(3, fl(ABTN.shown / (ABTN.need or 1) * 3) + 1), sx, sy - TS, sx + TS, sy + TS, true)
end
elseif b then
if b == "do" then b = WD.OPEN[i] and "do2" or "do1"
else
local bk2, fw2 = WD.B[i - N] == b, WD.B[i + N] ~= nil
if b == "fu" then if WD.FURN[i] and WD.FURN[i].burn > 0 then b = "fb" .. (fl(t / 140 + i * 0.37) % 4 + 1); LIGHTS[#LIGHTS + 1] = { tx * TS + ox + TS / 2, ty * TS + oy + 22, 130 } end
elseif b == "ct" or IV.CHESTB[b] then
elseif bk2 or fw2 then
local vn = JN[b]
if not vn then vn = { b .. "_nn", b .. "_nb", b .. "_nf" }; JN[b] = vn end
b = (bk2 and fw2) and vn[1] or bk2 and vn[2] or vn[3]
end
end
local sx, sy = tx * TS + ox, ty * TS + oy
if ABTN and ABTN.ti == i and ABTN.hitt and t - ABTN.hitt < 90 then sx = sx + ((t - ABTN.hitt < 45) and 3 or -2) end
if FULLTOP[WD.B[i + N] or ""] and HASTP[b] then
q(TNT(b), sx, sy - TS, sx + TS, sy, true)
else
q(TN(b), sx, sy - TS, sx + TS, sy + TS, true)
q("fx_front", sx, sy, sx + TS, sy + TS, true)
end
if WCOV > 0.5 then q("fx_snowtop", sx, sy - TS, sx + TS, sy, true) end
if ABTN and ABTN.ti == i and ABTN.shown then
local need = ABTN.need or 1
q("crack" .. math.min(3, fl(ABTN.shown / need * 3) + 1), sx, sy - TS, sx + TS, sy + TS, true)
end
end
end
end
walkers(math.huge)
do
local function cover(x, y, pty)
local wx, wy = x - ox, y - oy
local tx = fl(wx / TS)
if tx < 0 or tx >= N then return false end
local r0 = fl(wy / TS)
for r = r0, r0 + 1 do
if r > pty and r < N then local v = WD.B[r * N + tx]; if v and not IV.FLAT[v] and v ~= "tr" then return true end end
end
return false
end
local function sil(p, slot)
local cells = p._tag and SIL[p._tag]
if not cells then return end
local pty = fl(p.y / TS)
local x0, y0 = p._px - 36, p._py - 69
local cov = {}
for c = 0, 2 do for r = 0, 11 do
if cover(x0 + c * 24 + 12, y0 + r * 6 + 3, pty) then cov[c .. "_" .. r] = true end
end end
WD.sildraw(p, cov, slot)
end
sil(PL, 1)
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then sil(p, 2); break end end end
end
end
WD.fx(t, tx0, tx1, ty0, ty1)
WD.ptdraw(t)
local wnow, wnight = WX.draw(t, tx0, tx1, ty0, ty1, ox, oy, cx, cy, y0, y1, LIGHTS)
WX.sound(t, wnow, wnight)
smudge.set_clip()
if not MAP.open then MAP.world(ox, oy, y0, y1) end
if MP and ST.tags then
local ny = y0 + 100
for nm, p in pairs(MP.peers) do
if not p.new and (p.z or 0) == WD.Z then OT.c(fl(p.x + ox), fl(p.y + oy - 90), nm, "small", "bold")
elseif not p.new then
OT.c(W // 2, ny, nm .. ((p.z or 0) == 0 and " is up on the land" or (" is on level " .. p.z)), "small", "bold"); ny = ny + 24
end
end
end
CAP = CAPW.all
UI.pic("ui_round_s", 8, y0 + 8, 60, y0 + 60)
qfit("ui_power", 34, y0 + 33, 26)
X.reg("WLPOWER", 8, y0 + 8, 52, 52, function() PANEL = "menu" end, false)
WX.icons(y0)
if not PANEL and not IV.open and not MAP.open then MAP.corner(y0) end
if MP then
local txt = (MP.st ~= 2) and "Our world: connecting..." or (MP.block and (MP.block[1] .. " has another version")) or
((next(MP.peers) == nil) and "Our world: waiting for the other phone" or nil)
if txt then OT.c(W // 2, y0 + 70, X.fit(txt, W - 80, "small"), "small", "bold") end
end
if MAP.open and not PANEL and not IV.open then MAP.big(y0, y1)
elseif PANEL then
draw_panel(y0, y1)
local P = WD.PAD
if P and P.on and #WD.PB > 0 then
P.pcur = math.max(1, math.min(#WD.PB, P.pcur or 1))
local b = WD.PB[P.pcur]
local x, y, w, h = b[1] - 4, b[2] - 4, b[3] + 8, b[4] + 8
UI.pic("ui_yel", x, y, x + w, y + 4); UI.pic("ui_yel", x, y + h - 4, x + w, y + h)
UI.pic("ui_yel", x, y, x + 4, y + h); UI.pic("ui_yel", x + w - 4, y, x + w, y + h)
end
elseif IV.open then IV.draw(y0, y1)
else
local padon = WD.PAD and WD.PAD.on
if padon and t - (WD.PAD.hint or 0) < 8000 then
local n = WD.bn()
local bx0, by0 = hb_xy()
OT.c(W // 2, by0 - 30, X.fit(n.A .. ": hand   " .. n.X .. ": build   " .. n.Y .. ": bag   " .. n.LB .. "/" .. n.RB .. ": slot   " .. n.ST .. ": menu", W - 16, "small"), "small", "bold")
end
if not padon then
local jx, jy = stick_home()
if STICK then jx, jy = STICK.cx, STICK.cy end
UI.pic("ui_stick", jx - 66, jy - 66, jx + 66, jy + 66)
local kx, ky = jx, jy
if STICK then
local d = math.sqrt(STICK.dx ^ 2 + STICK.dy ^ 2)
local m = math.min(d, 40) / math.max(1, d)
kx, ky = jx + STICK.dx * m, jy + STICK.dy * m
end
UI.pic("ui_knob", kx - 30, ky - 30, kx + 30, ky + 30)
local ax, ay, ar = abtn_xy()
local pr = ABTN and 4 or 0
UI.pic("ui_round", ax - ar + pr, ay - ar + pr, ax + ar - pr, ay + ar - pr)
qfit("i_hand", ax, ay, 50 - pr)
local lab = "HAND"
local lw = X.tw(lab, "small", "bold") + 18
UI.pic("ui_btn", ax - lw // 2, ay + ar - 6, ax + lw // 2, ay + ar + 22)
OT.c(ax, ay + ar - 4, lab, "small", "bold")
if can_build() then
local cx2, cy2, cr = cbtn_xy()
local p2 = WD.CB and 3 or 0
UI.pic("ui_round", cx2 - cr + p2, cy2 - cr + p2, cx2 + cr - p2, cy2 + cr - p2)
UI.pic("ui_chisel", cx2 - 24 + p2, cy2 - 24 + p2, cx2 + 24 - p2, cy2 + 24 - p2)
local lw2 = X.tw("BUILD", "small", "bold") + 18
UI.pic("ui_btn", cx2 - lw2 // 2, cy2 + cr - 6, cx2 + lw2 // 2, cy2 + cr + 22)
OT.c(cx2, cy2 + cr - 4, "BUILD", "small", "bold")
end
end
local bx, by = hb_xy()
UI.pic("hb_bar", bx, by, bx + HBW, by + HBS)
for k = 1, 9 do IV.slot_item(IV.S[k], bx + (k - 1) * HBS, by) end
do
local it = IV.S[ST.sel]
local key = ST.sel .. ":" .. (it and it.id or "")
if key ~= WD.selk then WD.selk, WD.selt = key, t end
if it and t - (WD.selt or 0) < 2200 then
local mx = IV.dmax(it.id)
local txt = IV.NAME[it.id] .. (mx and ("   " .. (it.d or mx) .. " / " .. mx) or "")
local tw = X.tw(txt, "small", "bold")
local ly = ST.hbtop and (by + HBS + 8) or (by - 40)
UI.tip(W // 2 - tw // 2 - 14, ly, W // 2 + tw // 2 + 14)
OT.c(W // 2, ly + 4, txt, "small", "bold")
end
end
if HBP then
local sx = bx + 9 * HBS
UI.pic("hb_invp", sx, by, sx + HBS, by + HBS)
UI.pic("hb_bag", sx + 6, by + 8, sx + 38, by + 40)
end
local sx = bx + (ST.sel - 1) * HBS
UI.pic("hb_sel", sx, by, sx + HBS, by + HBS)
end
X.draw_note(y1 - 60)
busy()
end
F.SCR = { "wilds" }
F.PARENT = { wilds = "skills" }
F.state = function() return PL, MP end
F.panel = function(p) PANEL = p end
F.wd = function() return WD end
F.iv = function() return IV end
F.st = function() return ST end

-- CardScape diagnostic renderer profiler. This build intentionally records CPU
-- timings/counters only; it does not change draw order, assets, radii or quality.
local function render_clock() return (os and os.clock and os.clock()) or 0 end
WD.PROFILE = true
WD.PROFILE_STATS = {
 frames = 0, draw3_ms = 0, draw3_max_ms = 0,
 wx_ms = 0, wx_max_ms = 0, lights_ms = 0, lights_max_ms = 0,
 dark_ms = 0, dark_max_ms = 0, sort_ms = 0, sort_max_ms = 0,
 light_sources = 0, sort_entries = 0, last_report = 0
}
local RS = WD.PROFILE_STATS
local function prof_add(key, maxkey, dt)
 RS[key] = RS[key] + dt
 RS[maxkey] = math.max(RS[maxkey], dt)
end
local _lights = WX.lights
WX.lights = function(...)
 if not WD.PROFILE then return _lights(...) end
 local t0 = render_clock()
 local L = _lights(...)
 local dt = (render_clock() - t0) * 1000
 prof_add("lights_ms", "lights_max_ms", dt)
 RS.light_sources = #L
 return L
end
local _dark = WX.dark
WX.dark = function(...)
 if not WD.PROFILE then return _dark(...) end
 local t0 = render_clock()
 local r = _dark(...)
 prof_add("dark_ms", "dark_max_ms", (render_clock() - t0) * 1000)
 return r
end
local _draw3 = WD.draw3
WD.draw3 = function(...)
 if not WD.PROFILE then return _draw3(...) end
 local t0 = render_clock()
 local r = _draw3(...)
 prof_add("draw3_ms", "draw3_max_ms", (render_clock() - t0) * 1000)
 return r
end
local _wxdraw = WX.draw
WX.draw = function(...)
 if not WD.PROFILE then return _wxdraw(...) end
 local t0 = render_clock()
 local a, b = _wxdraw(...)
 prof_add("wx_ms", "wx_max_ms", (render_clock() - t0) * 1000)
 return a, b
end
local _wild_draw = C.draw_wilds
C.draw_wilds = function(S)
 if not WD.PROFILE then return _wild_draw(S) end
 local t0 = render_clock()
 local r = _wild_draw(S)
 local dt = (render_clock() - t0) * 1000
 RS.frames = RS.frames + 1
 if RS.frames - RS.last_report >= 120 then
  local n = RS.frames - RS.last_report
  local angle = (WD.CAM and WD.CAM.a) or 0
  local pool = WD.POOL3 and WD.POOL3.nk or 0
  local nq = WD.nq3 or 0
  local qg = WD.nqg or 0
  local fps = tonumber(smudge.fps) or 0
  print(string.format("CS_RENDER mode=%s angle=%.1f z=%s fps=%.1f frame_ms=%.3f draw3_avg=%.3f draw3_max=%.3f sort_avg=%.3f sort_max=%.3f sort_n=%d wx_avg=%.3f wx_max=%.3f lights_avg=%.3f lights_max=%.3f dark_avg=%.3f dark_max=%.3f light_n=%d nq3=%d nqg=%d", angle == 0 and "2d" or "45", angle, tostring(WD.Z), fps, dt, RS.draw3_ms / n, RS.draw3_max_ms, RS.sort_ms / n, RS.sort_max_ms, RS.sort_entries, RS.wx_ms / n, RS.wx_max_ms, RS.lights_ms / n, RS.lights_max_ms, RS.dark_ms / n, RS.dark_max_ms, RS.light_sources, nq, qg))
  RS.last_report = RS.frames
  RS.draw3_ms, RS.draw3_max_ms = 0, 0
  RS.wx_ms, RS.wx_max_ms = 0, 0
  RS.lights_ms, RS.lights_max_ms = 0, 0
  RS.dark_ms, RS.dark_max_ms = 0, 0
  RS.sort_ms, RS.sort_max_ms = 0, 0
 end
 return r
end
F.render_profile = function(on)
 WD.PROFILE = (on ~= false)
 return WD.PROFILE_STATS
end
F.render_profile_stats = function() return WD.PROFILE_STATS end
return F
end
