ltext(24, y, "Dust for coins", "ui12", "bold")
button(24, y + 34, hw, 60, "100 DUST", function() DX.swap(100) end, { font = "ui10", sub = "= 250 coins", off = S.dust < 100, id = "SWAP1" })
button(34 + hw, y + 34, hw, 60, "1000 DUST", function() DX.swap(1000) end, { font = "ui10", sub = "= 2500 coins", off = S.dust < 1000, id = "SWAP2" })
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go("packs") end, { font = "ui10" })
end
function DX.swap(n)
if S.dust < n then note = "Not enough dust."; return end
S.dust = S.dust - n; add_coins(n * 5 // 2); save_now()
note = string.format("%d dust -> %d coins.", n, n * 5 // 2)
end
function DX.well()
if S.dust < 1000 then note = string.format("The well wants 1000 dust (you have %d).", S.dust); return end
S.dust = S.dust - 1000
local r = rnd(1, 400)
if r == 1 then
local l = D.tier_cards[6]
local c = l[rnd(1, #l)]
local isnew = give_card(c)
note = "The well glows... A SECRET CARD: " .. cname(c) .. "!" .. (isnew and " (NEW!)" or "")
else
local k = rnd(1, 100)
if k <= 50 then
local n = rnd(400, 900); add_coins(n); note = "Splash! The well gives you " .. n .. " coins."
elseif k <= 80 then
S.camp.tickets = S.camp.tickets + 1; note = "Splash! A pack ticket floats up."
else
local list = {}
for c = 1, D.ncards do if S.lvl[c] > 0 and S.shiny[c] ~= 1 then list[#list + 1] = c end end
if #list > 0 then
local c = list[rnd(1, #list)]; S.shiny[c] = 1; note = "Sparkle! " .. cname(c) .. " turned shiny."
else
S.camp.rtickets = S.camp.rtickets + 1; note = "Sparkle! A rare pack ticket floats up."
end
end
end
save_now()
end
SCREENS.packs = function()
top_bar("Booster Packs", "")
res_bar(TOP + 4)
local p3 = V3.ok() and not SAVER
local by = H - 96 - 8 - 56
local oy = by - 8 - 64
local tk0, rt0 = S.camp.tickets, S.camp.rtickets
local ty = (tk0 > 0 or rt0 > 0) and (oy - 8 - 70) or oy
local y = p3 and (ty - 112) or (TOP + 262)
if p3 then packs3d(24, TOP + 36, W - 48, y - (TOP + 36) - 12) else deck_art(142, TOP + 30) end
ctext(W / 2, y, string.format("%d coins per pack", D.pack_cost), "ui12", "bold")
ctext(W / 2, y + 32, "3 cards, the last is UNCOMMON or better", "ui10")
ctext(W / 2, y + 58, "Com / Unc / Rare / Leg / Exo / Myth  (%)", "small")
ctext(W / 2, y + 80, "Cards 1-2: 55/25/13/4/1/<1   Card 3: 0/47/34/15/3/1", "small")
draw_note(y + 112)
local can = S.coins >= D.pack_cost
local tk, rt = S.camp.tickets, S.camp.rtickets
local bw = (tk > 0 and rt > 0) and ((W - 60) // 2) or (W - 48)
local bx = 24
local tky = p3 and ty or (y + 128)
if tk > 0 then
button(bx, tky, bw, 70, "USE TICKET", function() open_pack(true) end, { sub = tk .. " free pack" .. (tk > 1 and "s" or ""), font = "ui10", id = "TICKET" })
bx = bx + bw + 12
end
if rt > 0 then
button(bx, tky, bw, 70, "RARE TICKET", function() open_pack(true, true) end, { sub = rt .. " rare+ pack" .. (rt > 1 and "s" or ""), font = "ui10", id = "RTICKET" })
end
if tk == 0 and rt == 0 and not can and note == "" then
ctext(W / 2, y + 112, "Short on coins? Gather at the CAMP.", "small", "bold")
end
local mw = 104
local opy = p3 and oy or (y + 206)
button(24, opy, W - 48 - 2 * (mw + 8), 64, "OPEN PACK", function() open_pack() end, { sub = string.format("costs %d coins", D.pack_cost), off = not can, font = "ui10" })
for k, n in ipairs({ 5, 10 }) do
button(W - 24 - (3 - k) * (mw + 8) + 8, opy, mw, 64, "x" .. n, function() open_pack(nil, nil, nil, n) end,
{ sub = (D.pack_cost * n) .. "c", off = S.coins < D.pack_cost * n, font = "ui10", id = "OPEN" .. n })
end
local hw2 = (W - 48 - 16) // 3
local ely = p3 and by or (y + 278)
button(24, ely, hw2, 56, "ELEMENT", function() go("elempack") end, { sub = "one element, 70c", font = "small", id = "ELEMPACK" })
button(32 + hw2, ely, hw2, 56, "GRADING", function() go("grading") end, { sub = "free, +ATK", font = "small", id = "FRAMES",
dot = (GR and GR.ready_count() > 0) and GR.ready_count() or nil })
button(40 + 2 * hw2, ely, hw2, 56, "DUST SHOP", function() go("dustshop") end, { sub = short(S.dust) .. " dust", font = "small", id = "DUSTSHOP" })
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
local loop_on = false
local aura_last = nil
local function aura_tick()
local ok = (not SAVER) and ((scr == "reveal" and RV and RV.idx >= 1 and RV.idx <= 3) or scr == "detail")
if not ok then loop_on = false; return end
if CS_SMOOTH then
local now = smudge.millis()
anim_t = anim_t + math.min(100, now - (aura_last or now)) / 70
aura_last = now
local g = math.floor(anim_t / 2)
if g ~= CS_GLITCH then CS_GLITCH = g; gseed(g * 3 + 9); anim_v = grand(5) end
redraw()
after(16, aura_tick)
return
end
anim_t = anim_t + 1
gseed(anim_t * 3 + 9); anim_v = grand(5)
redraw()
local c = (scr == "detail") and sel or (RV and RV.list[RV.idx] and RV.list[RV.idx].c)
after((c and tier_of(c) == 5) and 450 or 70, aura_tick)
end
local function aura_start()
anim_t = 0; anim_v = 0; aura_last = nil
if SAVER then return end
if not loop_on then loop_on = true; after(70, aura_tick) end
end
start_opening = function()
if SAVER then RV.idx = 1; return end
if V3.ok() then
RV.idx = -1; RV.stage = "tear"; RV.tear = 0; RV.flip3 = {}; RV.st = smudge.millis()
return
end
RV.ns = ({ 1, 1, 2, 2, 3, 3, 3 })[math.min(RV.best, 6) + 1]
RV.fr = 1
local rv = RV
local function step()
if RV ~= rv or RV.idx ~= 0 then return end
RV.fr = RV.fr + 1
if RV.fr > RV.ns + 3 then
RV.idx = RV.multi and 4 or 1; focus = 1; loop_on = false; aura_start()
else
after((RV.fr == RV.ns + 3) and 900 or 60, step)
end
redraw()
end
after(60, step)
end
local function clip(x, y, w, h)
if x then RCLIP = { x, y, w, h } else RCLIP = nil end
if smudge.set_clip then if x then smudge.set_clip(x, y, w, h) else smudge.set_clip() end end
end
local SWIPE = {}
local function press(id)
for i = nbtn, 1, -1 do
local b = btns[i]
if b.id == id and b.act then b.act(); redraw(); return true end
end
if SWIPE[id] then SWIPE[id](); redraw(); return true end
return false
end
local function swipe_tabs(cur, set, lo, hi)
SWIPE.PREV = function() if cur() > lo then set(cur() - 1) end end
SWIPE.NEXT = function() if cur() < hi then set(cur() + 1) end end
end
local function scroll_list(id, y, h, n, rh, draw, x, w)
if not PH then return false end
h = h or (H - 96 - 10 - y)
local off = PH.begin(id, x or 0, y, w or (W - 16), h, n * rh)
for i = 1, n do
local ry = y + (i - 1) * rh - off
if ry + rh > y and ry < y + h then draw(i, ry) end
end
PH.finish()
return true
end
local GRID = { sub = {} }
function GRID.draw(id, tier, y0, rows, rh, cell)
local list = D.tier_cards[tier] or {}
local nrows = (#list + 3) // 4
local x0, step = 12, 116
local function row(i, ry)
for col = 0, 3 do
local c = list[(i - 1) * 4 + col + 1]
if c then cell(c, x0 + col * step, ry) end
end
end
if nrows > rows and PH then
x0, step = 6, 113
if scroll_list(id .. tier, y0, rows * rh, nrows, rh, row, 0, 459) then return end
x0, step = 12, 116
end
local per = rows * 4
local pages = math.max(1, (#list + per - 1) // per)
local sp = (GRID.sub[id] or 0) % pages
for i = 1, rows do row(sp * rows + i, y0 + (i - 1) * rh) end
if pages > 1 then ctext(W - 30, y0 - 18, (sp + 1) .. "/" .. pages, "small", "bold") end
end
function GRID.flip(id, tier) if #(D.tier_cards[tier] or {}) > 8 and not PH then GRID.sub[id] = (GRID.sub[id] or 0) + 1 end end
function GRID.count(tier, ok)
local n, list = 0, D.tier_cards[tier] or {}
for _, c in ipairs(list) do if (ok and ok(c)) or (not ok and S.lvl[c] > 0) then n = n + 1 end end
return n, #list
end
local function keyboard(o)
local rows = o.rows or { "1234567890", "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM" }
local most = 0
for _, r in ipairs(rows) do most = math.max(most, #r) end
local gap, kh, rg, ah = 5, 62, 6, 60
local kw = math.min(43, (W - 32 - (most - 1) * gap) // most)
local bottom = o.bottom or (H - 104)
local top = bottom - (#rows * (kh + rg) + ah)
for r, keys in ipairs(rows) do
local x0 = (W - (#keys * kw + (#keys - 1) * gap)) // 2
for k = 1, #keys do
local ch = keys:sub(k, k)
button(x0 + (k - 1) * (kw + gap), top + (r - 1) * (kh + rg), kw, kh, ch, function() o.key(ch) end,
{ font = "ui12", id = (o.id or "K") .. ch, nohelp = true })
end
end
local acts = o.actions or {}
local n = #acts
local aw = (W - 48 - (n - 1) * 6) // math.max(1, n)
for k, a in ipairs(acts) do
button(24 + (k - 1) * (aw + 6), bottom - ah, aw, ah, a[1], a[2], { font = "ui10", off = a[3], id = a[4], nohelp = true })
end
return top
end
local function camp_ctx()
return {
grid = GRID.draw, grid_flip = GRID.flip, grid_count = GRID.count, keyboard = keyboard,
card_away = function(c) return GR ~= nil and GR.busy(c) ~= nil end,
grading = function() return GR and GR.list() or {} end, grade_slots = function() return GR and GR.SLOTS or 3 end,
pet_info = function() if smudge.pet then local ok, p = pcall(smudge.pet); if ok and type(p) == "table" and p.exists then return p end end end,
scrolling = function() return PH ~= nil end,
tilt3d = function(...) if V3.ok() and not SAVER then return V3.tilt_get(...) end end,
moving = function(ms) V3.moving = math.max(V3.moving, smudge.millis() + ms) end,
swipe_tabs = swipe_tabs, tint = tint, ttint = ttint, TT = TT,
list = function(id, y, h, n, rh, draw, x, w) return scroll_list(id, y, h, n, rh, draw, x, w) end,
scroll_begin = function(...) return PH.begin(...) end, scroll_end = function() PH.finish() end,
D = D, W = W, H = H, TOP = TOP,
time = function() return (smudge.time and tonumber(smudge.time())) or os.time() end,
millis = smudge.millis, rnd = rnd,
set_note = function(m) note = m end,
mark_dirty = function() dirty = true end,
after = after, redraw = redraw,
fstep = function(ms) return (CS_SMOOTH and not SAVER) and 16 or ms end,
smooth = function() return CS_SMOOTH and not SAVER end,
add_dust = add_dust, add_coins = add_coins, save_now = save_now,
ctext = ctext, ltext = ltext, rtext = rtext, bar = bar, button = button,
draw_note = draw_note, res_bar = res_bar, wrapped = wrapped, saver = function() return SAVER end,
header = function(t, s2) top_bar(t, s2 or "") end,
top_bar = function(t, s2) top_bar(t, s2) end, bar_h = function() return bar_pad() + BAR_H end,
scr = function() return scr end,
go = function(n) go(n) end,
lh = lh, fit = fit, thumb = thumb, owned = owned, cname = cname, elem_of = elem_of, tier_of = tier_of, reg = reg,
elem_name = function(e) return D.elems[e] end,
lvl = function(c) return S.lvl[c] end,
xp = function(c) return S.xp[c] end,
xp_need = function(c) return D.xp_need[S.lvl[c]] or 1 end,
add_card_xp = function(c, n)
if S.lvl[c] < 1 or S.lvl[c] >= D.max_level then return false end
S.xp[c] = S.xp[c] + n
while S.lvl[c] < D.max_level and S.xp[c] >= D.xp_need[S.lvl[c]] do
S.xp[c] = S.xp[c] - D.xp_need[S.lvl[c]]; S.lvl[c] = S.lvl[c] + 1
end
if S.lvl[c] >= D.max_level then S.xp[c] = 0 end
dirty = true; save_now(); return true
end,
ncards = D.ncards, chip = chip, tier_name = function(c) return D.tiers[tier_of(c) + 1] end,
give_card = function(c) local n = give_card(c); dirty = true; return n end,
stat = function(k)
if k == "tower" then return S.tower elseif k == "shiny" then return shiny_count()
elseif k == "sets" then return sets_done() elseif k == "evolve" then return S.evolved
elseif k == "wins" then return S.wins elseif k == "found" then return found_count() elseif k == "packs" then return S.packs
elseif k == "mythics" then
local n = 0
for c = 41, 48 do if S.lvl[c] > 0 then n = n + 1 end end
return n
end
return 0
end,
tw = tw, short = short, wins = function() return S.wins end, stage = function() return S.stage end,
base_stats = base_stats, deck = function() return S.deck end, card_stats = function(c) return card_stats(c) end,
fight = function(pe) PE = pe; page = 0; go("quest") end,
bell = function(x, y, n, id, act) bell(x, y, n, id, act) end,
has_mythic = function() for c = 41, 48 do if S.lvl[c] > 0 then return true end end return false end,
}
end
local P3 = {}
function P3.pack(cx, cy, sc, rx, ry, tear, fly)
local cr, sr, cxr, sxr = math.cos(ry), math.sin(ry), math.cos(rx), math.sin(rx)
local function P(px, py, pz)
px, py, pz = px * sc, py * sc, pz * sc
local x1, z1 = px * cr + pz * sr, -px * sr + pz * cr
local y2, z2 = py * cxr - z1 * sxr, py * sxr + z1 * cxr
local k = 900 / (900 + z2)
return cx + x1 * k, cy + y2 * k
end
local PW, PH = 200, 290
local cut = 0.13
local sy = -PH / 2 + PH * cut
local function quad(pts, z)
local r = {}
for i = 1, 4 do local a, b = P(pts[i][1], pts[i][2], pts[i][3] or z); r[#r + 1] = a; r[#r + 1] = b end
return r
end
if not SAVER then
local q = quad({ { -PW / 2, -PH / 2 + (fly and PH * cut or 0) }, { PW / 2, -PH / 2 + (fly and PH * cut or 0) }, { PW / 2, PH / 2 }, { -PW / 2, PH / 2 } }, 30)
smudge.draw_sprite_quad("art/bp_shadow.raw", 160, 232, q[1] + 10 * sc, q[2] + 12 * sc, q[3] + 10 * sc, q[4] + 12 * sc, q[5] + 10 * sc, q[6] + 12 * sc, q[7] + 10 * sc, q[8] + 12 * sc, "art/bp_front_m.raw")
end
local body = quad({ { -PW / 2, sy }, { PW / 2, sy }, { PW / 2, PH / 2 }, { -PW / 2, PH / 2 } }, 0)
smudge.draw_sprite_quad("art/bp_front.raw", 160, 232, body[1], body[2], body[3], body[4], body[5], body[6], body[7], body[8], "art/bp_front_m.raw", 0, cut, 1, 1)
if fly and fly >= 1 then return P end
local a = -(tear or 0) * 0.55 - (fly or 0) * 2.2
local hx, hy = PW / 2, sy
local dx, dy = (fly or 0) * 160, -(fly or 0) * 220
local function rot(x, y)
local ux, uy = x - hx, y - hy
return hx + ux * math.cos(a) - uy * math.sin(a) + dx, hy + ux * math.sin(a) + uy * math.cos(a) + dy
end
local p1 = { rot(-PW / 2, -PH / 2) }; local p2 = { rot(PW / 2, -PH / 2) }; local p3 = { rot(PW / 2, sy) }; local p4 = { rot(-PW / 2, sy) }
local z = -10 * (tear or 0) - 40 * (fly or 0)
local st = quad({ { p1[1], p1[2] }, { p2[1], p2[2] }, { p3[1], p3[2] }, { p4[1], p4[2] } }, z)
smudge.draw_sprite_quad("art/bp_front.raw", 160, 232, st[1], st[2], st[3], st[4], st[5], st[6], st[7], st[8], "art/bp_front_m.raw", 0, 0, 1, cut)
return P
end
function P3.frame(cx, cy, sc, rx, ry, k)
local cr, sr, cxr, sxr = math.cos(ry), math.sin(ry), math.cos(rx), math.sin(rx)
local function P(px, py)
px, py = px * sc, py * sc
local x1, z1 = px * cr, -px * sr
local y2, z2 = py * cxr - z1 * sxr, py * sxr + z1 * cxr
local kk = 900 / (900 + z2)
return cx + x1 * kk, cy + y2 * kk
end
local PW, PH = 200, 290
local x0, x1, y0, y1 = -0.8 * PW, 0.8 * PW, PH / 2 - 1.45 * PH, PH / 2 + 0.05 * PH
local a1, b1 = P(x0, y0); local a2, b2 = P(x1, y0); local a3, b3 = P(x1, y1); local a4, b4 = P(x0, y1)
if not SAVER then
local q = { P(-PW / 2, -PH / 2) }; local q2 = { P(PW / 2, PH / 2) }
smudge.draw_sprite_quad("art/bp_shadow.raw", 160, 232, q[1] + 10 * sc, q[2] + 12 * sc, q2[1] + 10 * sc, q[2] + 12 * sc, q2[1] + 10 * sc, q2[2] + 12 * sc, q[1] + 10 * sc, q2[2] + 12 * sc, "art/bp_front_m.raw")
end
local nm = "art/pt" .. k
smudge.draw_sprite_quad(nm .. ".raw", 232, 316, a1, b1, a2, b2, a3, b3, a4, b4, nm .. "_m.raw")
end
function P3.touch(ev, x, y)
if true then return false end
if not (RV and RV.idx == -1 and RV.stage == "tear") then return false end
if ev == "down" then RV.td = { x0 = x, y0 = y, t0 = RV.tear }; return false end
if ev == "move" and RV.td then
RV.tear = math.max(0, math.min(1, RV.td.t0 + math.abs(x - RV.td.x0) / 220))
if RV.tear >= 0.8 then RV.stage = "fly"; RV.st = smudge.millis(); RV.td = nil end
return true
end
if ev == "release" and RV.td then RV.td = nil; if RV.stage == "tear" then RV.tear = 0 end; return true end
return false
end
function P3.spr(name, sw, sh, cx, cy, w, h, ang, tk)
local c, s2 = math.cos(ang or 0), math.sin(ang or 0)
local function pt(px, py) return cx + px * c - py * s2, cy + px * s2 + py * c end
local x1, y1 = pt(-w / 2, -h / 2); local x2, y2 = pt(w / 2, -h / 2); local x3, y3 = pt(w / 2, h / 2); local x4, y4 = pt(-w / 2, h / 2)
local p, m = "art/" .. name .. ".raw", "art/" .. name .. "_m.raw"
smudge.draw_sprite_quad(p, sw, sh, x1, y1, x2, y2, x3, y3, x4, y4, m)
if tk and smudge.tint_sprite_uv and not MONO then smudge.tint_sprite_uv(m, sw, sh, x1, y1, x2, y2, x3, y3, x4, y4, tk, 3, 0, 0, 1, 1) end
end
function P3.draw()
local now = smudge.millis()
top_bar("Booster Pack", "")
local cx, cy = W / 2, TOP + (H - TOP - 120) / 2
local sway = 0.05 * math.sin(now / 900)
local N = #RV.list
local cols = (N <= 3) and 3 or ((N <= 15) and 5 or 6)
local rows = (N + cols - 1) // cols
local SC = (N <= 3) and 1.12 or math.min((W - 10) / cols / 132 - 0.05, ((H - 290 - (TOP + 70)) / rows - 12) / 176)
local CWc, CHc = 132 * SC, 176 * SC
local gx = (N <= 3) and 157 or (W - 10) / cols
local gy = CHc + ((N <= 3) and 0 or 14)
local gy0 = (N <= 3) and (cy + 10) or (TOP + 70 + CHc / 2 + math.max(0, ((H - 290 - (TOP + 70)) - rows * gy) / 2))
local function card_pos(i, u)
local col, row = (i - 1) % cols, (i - 1) // cols
local inrow = math.min(cols, N - row * cols)
local rx0, ry0 = W / 2 + (col - (inrow - 1) / 2) * gx, gy0 + row * gy
local px0, py0 = W / 2 + ((i - 1) % 3 - 1) * 8, cy - 40 - ((i - 1) % 3 + 1) * 6
return px0 + (rx0 - px0) * u, py0 + (ry0 - py0) * u
end
if RV.stage == "tear" then
local u = now - (RV.st or now)
local T = { 380, 560, 740, 880, 1020, 1380 }
local k = 6
for i2 = 1, 6 do if u < T[i2] then k = i2; break end end
local shake = (k == 1) and math.sin(now / 40) * 0.05 * math.min(1, u / 200) or 0
P3.frame(cx, cy, 1.15, 0.06 * math.sin(now / 1300), sway + shake, k)
if u >= T[6] then RV.stage = "out"; RV.st = now end
return
end
if RV.stage == "fly" then
local fly = 0
if RV.stage == "tear" then
local u = (now - (RV.st or now)) / 700
sway = sway + 0.06 * math.sin(now / 45) * math.min(1, u * 2)
RV.tear = math.min(1, math.max(0, (u - 0.5) * 2))
if u >= 1 then RV.stage = "fly"; RV.st = now; RV.tear = 1 end
end
if RV.stage == "fly" then
fly = math.min(1, (now - RV.st) / 450)
if fly >= 1 then RV.stage = "out"; RV.st = now end
end
P3.pack(cx, cy, 1.15, 0.06 * math.sin(now / 1300), sway, RV.tear, fly)
return
end
if RV.stage == "out" then
local u = (now - RV.st) / 700
local d = math.min(1, u / 0.6)
P3.frame(cx, cy + d * d * (H - cy + 260), 1.15 * (1 - 0.25 * d), 0, sway, 6)
for i = 1, N do
local t2 = math.max(0, math.min(1, (u - 0.15 - (i - 1) * 0.5 / math.max(1, N)) / 0.45))
if t2 > 0 then
local g = t2 < 1 and (1 + 0.25 * math.sin(t2 * math.pi)) * t2 or 1
local x, y = card_pos(i, 1)
V3.render({ c = RV.list[i].c, cx = x, cy = y, CW = CWc * g, CH = CHc * g, rx = 0.05, ry = 0, back = true, inset = 8 * SC * g, depth = 0.6 })
if t2 < 0.6 then sparkle(math.floor(x + CWc * 0.45), math.floor(y - CHc * 0.45), math.floor(10 * SC + 4)) end
end
end
if u >= 1.2 then RV.stage = "flip" end
return
end
local all = true
local SHAKE = { 0, 60, 120, 220, 360, 520, 800 }
local st = {}
local burst, quake = nil, 0
for i = 1, N do
local r = RV.list[i]
local tr = tier_of(r.c)
local f = RV.flip3[i]
local c = { r = r, tr = tr, f = f, back = true, ry = 0.12 * math.sin(now / 1100 + i), te = nil, dx = 0, dy = 0 }
if f then
local sd, fd = SHAKE[tr + 1], (tr == 6) and 1100 or 520
if now - f < sd then
local a = 1.5 + tr * 1.2
c.dx = math.sin((now - f) / 22) * a; c.dy = math.cos((now - f) / 31) * a * 0.5
else
local u = math.min(1, (now - f - sd) / fd)
local ang = math.pi * (1 - u * u * (3 - 2 * u))
c.back = ang > math.pi / 2
c.ry = c.back and (ang - math.pi) or ang
if u >= 1 then
c.te = now - f - sd - fd
c.ry = 0.1 * math.sin(now / 1300 + i)
if tr == 4 then c.ry = c.ry + 0.35 * math.sin(c.te / 90) * math.exp(-c.te / 500) end
if tr == 0 and c.te < 260 then c.dy = -math.sin(math.pi * c.te / 260) * 14 end
if tr >= 3 and (not burst or tr > burst.tr or (tr == burst.tr and c.te < burst.te)) then burst = c end
if tr == 5 and c.te < 420 then quake = math.max(quake, 1 - c.te / 420) end
end
end
else all = false end
st[i] = c
end
local qx, qy = 0, 0
if quake > 0 then qx, qy = math.sin(now / 17) * 7 * quake, math.cos(now / 23) * 5 * quake end
for i = 1, N do local x, y = card_pos(i, 1); st[i].x, st[i].y = x + st[i].dx * SC + qx, y + st[i].dy * SC + qy end
for _, c in ipairs(st) do
local te, x, y = c.te, c.x, c.y
if te and c.tr == 6 and smudge.shade_quad then
smudge.shade_quad(0, TOP, W, TOP, W, H - 110, 0, H - 110, 0)
end
if te and c.tr == 3 then
local g = math.min(1, te / 300)
P3.spr("fx_sun", 192, 192, x, y, 330 * g * SC, 330 * g * SC, now / 1800, nil)
elseif te and c.tr == 4 then
local g = math.min(1, te / 300)
P3.spr("fx_circle", 192, 192, x, y + 20 * SC, 300 * g * SC, 300 * g * 0.9 * SC, -now / 2400, nil)
elseif te and c.tr == 5 and smudge.tint_sprite_uv then
local sep = (9 + 8 * math.max(0, 1 - te / 1500)) * SC
local gt = math.floor(now / 70)
for _, L in ipairs({ { 1, 18 }, { -1, 17 } }) do
for k = 0, 9 do
local h = (gt * 31 + k * 17 + (L[2] == 17 and 7 or 0)) % 19
local jit = (h < 5) and ((h % 2 == 0) and 1 or -1) * (4 + 2 * h) * SC or 0
local x0 = x - CWc / 2 + L[1] * sep + jit
local y0, y1 = y - CHc / 2 + k * CHc / 10, y - CHc / 2 + (k + 1) * CHc / 10
smudge.draw_sprite_quad("art/one_m.raw", 8, 8, x0, y0, x0 + CWc, y0, x0 + CWc, y1, x0, y1, "art/one_m.raw")
smudge.tint_sprite_uv("art/one_m.raw", 8, 8, x0, y0, x0 + CWc, y0, x0 + CWc, y1, x0, y1, L[2], 2, 0, 0, 1, 1)
end
end
end
end
for i = 1, N do
local c = st[i]
local r = c.r
V3.render({ c = r.c, cx = c.x, cy = c.y, CW = CWc, CH = CHc, rx = 0.05 * math.sin(now / 1500 + i), ry = c.ry, back = c.back,
inset = 8 * SC, depth = 0.6, layers = N <= 3 or (c.tr >= 3 and not c.back), fx = (not c.back) and c.tr or nil, shiny = (not c.back) and r.shiny })
if c.f and not c.back then
if N <= 3 then
ctext(c.x, c.y + CHc / 2 + 6, fit(cname(r.c), 152, "small", "bold"), "small", "bold")
ctext(c.x, c.y + CHc / 2 + 26, r.new and "NEW!" or "spare", "small")
elseif r.new then
ctext(c.x, c.y + CHc / 2 - 2, "NEW!", "small", "bold")
end
end
if not c.f then
reg("FLIP" .. i, math.floor(c.x - CWc / 2 - 4), math.floor(c.y - CHc / 2 - 4), math.floor(CWc + 8), math.floor(CHc + 8), function() RV.flip3[i] = smudge.millis() end, true)
end
end
for i, c in ipairs(st) do
local te, x, y = c.te, c.x, c.y
if te and c.tr == 0 and te < 400 then
local fr = math.min(4, te // 100 + 1)
P3.spr("fx_dust" .. fr, 96, 96, x, y + 78 * SC, 150 * SC, 110 * SC, 0, nil)
elseif te and c.tr == 1 and te < 1000 then
local u = te / 1000
for k = 0, 5 do
local a = k * math.pi / 3 + i
local d = (40 + u * 150) * SC
P3.spr("fx_leaf", 48, 48, x + math.cos(a) * d, y + math.sin(a) * d * 0.8 + u * u * 60 * SC, 34 * SC, 34 * SC, a + u * 6, nil)
end
elseif te and c.tr == 2 then
local u = (te % 1800) / 900
if u <= 1 then
smudge.circle(math.floor(x), math.floor(y), math.floor((60 + u * 120) * SC), false, math.max(1, math.floor(4 * (1 - u)) + 1))
for k = 0, 7 do
local a = k * math.pi / 4 + 0.3
local d = (70 + u * 110) * SC
P3.spr("fx_spark", 48, 48, x + math.cos(a) * d, y + math.sin(a) * d, 30 * (1 - u * 0.5) * SC, 30 * (1 - u * 0.5) * SC, 0, nil)
end
end
elseif te and c.tr == 3 then
for k = 0, 6 do
local t2 = (te - k * 120) % 2400
if te - k * 120 > 0 and t2 < 1000 then
local u = t2 / 1000
local cx2 = x + (((k * 53) % 180) - 90) * SC
local w2 = 30 * SC * math.abs(math.cos(now / 160 + k))
P3.spr("fx_coin", 48, 48, cx2, y + (-220 + u * 360) * SC, math.max(4, w2), 30 * SC, 0, nil)
end
end
elseif te and c.tr == 5 then
if te < 1300 or (te % 2000) < 500 then
for k = 0, 3 do
if ((now // 80) + k) % 3 ~= 0 then
local a = k * math.pi / 2 + 0.7
P3.spr("fx_bolt", 64, 64, x + math.cos(a) * 95 * SC, y + math.sin(a) * 110 * SC, 50 * SC, 50 * SC, 0, (k % 2 == 0) and 17 or 18)
end
end
end
elseif te and c.tr == 6 then
for k = 0, 4 do
local t2 = (te + k * 380) % 1400
local u = t2 / 1400
P3.spr("fx_shoot", 64, 64, W + 40 - u * (W + 120), TOP + 60 + ((k * 97) % 300) + u * 120, 56, 56, 0, (k % 2 == 0) and 7 or 5)
end
end
end
if burst then
local t = burst.tr
local g = 1 + 0.4 * math.max(0, 1 - burst.te / 220)
local tw2, th2 = 300 * g, 66 * g
local cx2, cy2 = W / 2 + qx, TOP + 60 + qy
if t == 5 and smudge.tint_sprite_uv then
for _, L in ipairs({ { 7, 18 }, { -7, 17 } }) do
local x0, y0 = cx2 - tw2 / 2 + L[1], cy2 - th2 / 2
smudge.draw_sprite_quad("art/fx_t5_m.raw", 256, 56, x0, y0, x0 + tw2, y0, x0 + tw2, y0 + th2, x0, y0 + th2, "art/fx_t5_m.raw")
smudge.tint_sprite_uv("art/fx_t5_m.raw", 256, 56, x0, y0, x0 + tw2, y0, x0 + tw2, y0 + th2, x0, y0 + th2, L[2], 2, 0, 0, 1, 1)
end
P3.spr("fx_t5", 256, 56, cx2, cy2, tw2, th2, 0, nil)
else
P3.spr("fx_t" .. t, 256, 56, cx2, cy2, tw2, th2, 0, (t == 6) and 7 or nil)
end
elseif not all then
ctext(W / 2, TOP + 44, "Tap a card to turn it over", "ui10", "bold")
end
if all and N > 3 then
local nnew = 0
for _, r in ipairs(RV.list) do if r.new then nnew = nnew + 1 end end
ctext(W / 2, H - 270, string.format("%d packs: %d cards, %d NEW!", RV.multi or (N // 3), N, nnew), "ui10", "bold")
res_bar(H - 240)
local n = RV.multi or (N // 3)
local cost = D.pack_cost * n
button(24, H - 190, W - 48, 76, "OPEN ANOTHER " .. n, function() open_pack(nil, nil, nil, n) end,
{ sub = cost .. " coins", off = S.coins < cost, id = "OPEN ANOTHER" })
button(24, H - 96, W - 48, 64, "DONE", function() RV = nil; go("packs") end, { font = "ui10", id = "SEECARDS" })
elseif all then
res_bar(H - 240)
local k = RV.kind or {}
local sub, off
if k[5] then sub = ((k[5] == 3) and 1200 or 400) .. " dust"; off = S.dust < ((k[5] == 3) and 1200 or 400)
elseif k[3] then sub = D.elems[k[3]] .. " pack, 70 coins"; off = S.coins < 70
elseif k[2] then sub = S.camp.rtickets .. " rare ticket(s) left"; off = S.camp.rtickets < 1
elseif k[1] then sub = S.camp.tickets .. " ticket(s) left"; off = S.camp.tickets < 1
else sub = string.format("costs %d coins", D.pack_cost); off = S.coins < D.pack_cost end
button(24, H - 190, W - 48, 76, "OPEN ANOTHER", function() open_pack(k[1], k[2], k[3], nil, k[5]) end, { sub = sub, off = off, id = "OPEN ANOTHER" })
button(24, H - 96, W - 48, 64, "DONE", function() local e = k[3]; RV = nil; go(e and "elempack" or "packs") end, { font = "ui10", id = "SEECARDS" })
else
button(24, H - 96, W - 48, 64, "TURN ALL", function()
local t0 = smudge.millis()
if N <= 3 then for i = 1, 3 do RV.flip3[i] = RV.flip3[i] or (t0 + (i - 1) * 350) end; return end
local ord = {}
for i = 1, N do if not RV.flip3[i] then ord[#ord + 1] = i end end
table.sort(ord, function(a, b) local ta, tb = tier_of(RV.list[a].c), tier_of(RV.list[b].c); if ta ~= tb then return ta < tb end return a < b end)
local t = t0
for _, i in ipairs(ord) do RV.flip3[i] = t; t = t + ((tier_of(RV.list[i].c) >= 3) and 1400 or 110) end
end, { font = "ui10", id = "TURNALL" })
end
end
local function reveal_tag(r)
local c = r.c
local pre = r.shiny and "SHINY! " or ""
if r.new then return pre .. "NEW CARD!" end
if S.lvl[c] >= D.max_level then return pre .. "Spare copy - max level" end
return pre .. string.format("Spare copy added (x%d)", S.spare[c])
end
pack_art = function(cx, cy, c)
local f = (c >= 1) and 3 or ((c <= 0) and 0 or ((c < 0.5) and 1 or 2))
smudge.draw_sprite(cx - 116, cy - 156, 232, 312, "art/pack_" .. f .. ".raw")
end
SCREENS.reveal = function()
if RV.idx == -1 then P3.draw(); return end
top_bar("Booster Pack", "")
local fx, fy = 136, TOP + 88
if RV.idx == 0 then
local f, ns, t = RV.fr, RV.ns, math.min(RV.best, 6)
local gl = (t == 5) and not SAVER
local cx, cy = W // 2, fy + 110
local function rays(r1, r2, n, th, rot)
for k = 0, n - 1 do
local a = k * 2 * math.pi / n + (rot or 0)
smudge.line(cx + math.floor(math.cos(a) * r1), cy + math.floor(math.sin(a) * r1),
cx + math.floor(math.cos(a) * r2), cy + math.floor(math.sin(a) * r2), th)
end
end
local function aura(k, dx)
if t >= 3 then rays(150, 165 + 18 * k, (t >= 4) and 16 or 10, (t >= 4) and 3 or 2, k * 0.12) end
if t >= 4 then
for r = 0, 1 do smudge.rounded_rect(cx - 100 - 6 * k - r * 8 + dx, cy - 132 - 6 * k - r * 8, 200 + 12 * k + r * 16, 264 + 12 * k + r * 16, 14, false, 1) end
end
if t >= 2 then
local d = 10 + 6 * k
sparkle(cx - 98 - d + dx, cy - 128 - d // 2, 10 + 3 * k); sparkle(cx + 98 + d + dx, cy - 128 - d // 2, 8 + 3 * k)
if t >= 3 then sparkle(cx - 98 - d + dx, cy + 124 + d // 2, 8 + 2 * k); sparkle(cx + 98 + d + dx, cy + 124 + d // 2, 10 + 2 * k) end
elseif t == 1 then
for _, p in ipairs({ { -96, -126 }, { 96, -126 }, { -96, 122 }, { 96, 122 } }) do smudge.circle(cx + p[1] + dx, cy + p[2], 3 + k, true) end
end
if t == 6 then
for q = 0, 3 do
local a = q * math.pi / 2 + k * 0.5
ctext(cx + math.floor(math.cos(a) * 140) + dx, cy + math.floor(math.sin(a) * 160) - 12, "?", "bitter14", "bold")
end
end
end
if f == 1 then
pack_art(cx, cy, 0)
for i = -1, 1 do smudge.line(cx - 60 + i * 60, cy + 136, cx - 40 + i * 60, cy + 150, 2); smudge.line(cx + 40 + i * 60 - 80, cy + 150, cx + 60 + i * 60 - 80, cy + 136, 2) end
ctext(W / 2, fy + 300, "Opening...", "ui12", "bold")
elseif f <= 1 + ns then
local k = f - 1
local dx = ((k % 2 == 1) and -1 or 1) * (8 + 3 * k)
if CS_SMOOTH and not SAVER then dx = math.floor(math.sin(smudge.millis() * 0.055) * (8 + 3 * k) + 0.5) end
if gl then gseed(f * 5 + 1); dx = grand(31) - 15 end
aura(k, dx)
pack_art(cx + dx, cy, k / (ns + 1))
for i = 0, 2 do
smudge.line(cx - 112 + dx, cy - 30 + i * 30, cx - 130 + dx, cy - 30 + i * 30, 3)
smudge.line(cx + 112 + dx, cy - 30 + i * 30, cx + 130 + dx, cy - 30 + i * 30, 3)
end
if gl then glitch_bands(cx - 100, cy - 130, 200, 260, f, 2 + k) end
local hint = (t == 6) and "? ? ?" or (t == 5) and "Op3n!ng..." or ((t >= 3) and "Something shines..." or ((t == 2) and "A glint inside..." or "Opening..."))
ctext(W / 2, fy + 300, hint, "ui12", "bold")
else
local b = f - 1 - ns
if not RV.shards then
gseed(RV.list[1].c * 7 + RV.best * 13 + 3)
local n = 26 + 8 * math.min(t, 5)
RV.shards = {}
for i = 1, n do
local px, py = cx - 80 + grand(160), cy - 110 + grand(220)
local vx, vy = px - cx, py - cy
local len = math.max(1, math.sqrt(vx * vx + vy * vy))
local sp = 60 + grand(60)
RV.shards[i] = { px, py, vx / len * sp, vy / len * sp, 7 + grand(14), grand(10) < 6 }
end
end
if b == 1 then pack_art(cx, cy, 1) end
for _, sh in ipairs(RV.shards) do
local x = math.floor(sh[1] + sh[3] * b * 1.1)
local y = math.floor(sh[2] + sh[4] * b * 1.1 + 10 * b * b)
local sz = math.max(3, sh[5] - 3 * b)
if y > TOP and y < H - 120 then
if sh[6] then smudge.rect(x, y, sz, sz, true) else smudge.rect(x, y, sz, sz, false, 2) end
end
end
if t >= 2 then rays(70, (b == 1) and 150 or 200, ({ 0, 0, 8, 12, 16, 20, 24 })[t + 1], (t >= 4) and 4 or 3, 0.2) end
if gl and b == 1 then smudge.invert_rect(cx - 150, cy - 150, 300, 300) end
local word = (t == 6) and "SECRET!" or (string.upper(D.tiers[t + 1]) .. ((t >= 2) and "!" or ""))
local bw = math.max(220, tw(word, "bitter14", "bold") + 60)
local by2 = cy - 34
local dark = t >= 3
if dark then
smudge.rounded_rect(cx - bw // 2 - 6, by2 - 6, bw + 12, 80, 16, true)
smudge.rounded_rect(cx - bw // 2 - 2, by2 - 2, bw + 4, 72, 14, false, 2, false)
else
smudge.rounded_rect(cx - bw // 2, by2, bw, 68, 12, true, 1, false)
smudge.rounded_rect(cx - bw // 2, by2, bw, 68, 12, false, 3)
end
ctext(cx, by2 + 6, word, "bitter14", "bold", dark)
local px, py, pw, ph, rr = cx - bw // 2, by2, bw, 68, 12
if dark then px, py, pw, ph, rr = px - 6, py - 6, pw + 12, 80, 16 end
tint(px, py, pw, ph, t, "ink")
tint(px, py + rr, pw, ph - 2 * rr, t, "paper"); tint(px + rr, py, pw - 2 * rr, ph, t, "paper")
for p = 0, t do
local sx = cx - t * 13 + p * 26
if dark then smudge.circle(sx, by2 + 52, 6, true, 1, false) else sparkle(sx, by2 + 52, 8) end
end
if t == 5 and not SAVER then glitch_bands(cx - bw // 2, by2, bw, 68, f, 3) end
ctext(W / 2, fy + 300, (b == 1) and "!!!" or ((RV.multi and "Best pull") or "Best card in this pack"), "ui12", "bold")
end
button(24, H - 96, W - 48, 64, "SKIP", function() timer_fn = nil; RV.idx = RV.multi and 4 or 1; focus = 1; loop_on = false; aura_start() end, { font = "ui10" })
return
end
if RV.idx <= 3 then
local r = RV.list[RV.idx]
local c = r.c
local t = tier_of(c)
local banner = (t == 6) and "* SECRET *" or (t == 5) and "* MYTHIC *" or ((t == 4) and "* EXOTIC *" or ((t == 3) and "* LEGENDARY *" or D.tiers[t + 1]))
ctext(W / 2, TOP + 4, banner, "bitter14", "bold")
if t >= 5 and not SAVER then glitch_bands(100, TOP + 4, 280, 30, math.floor(anim_t), 2) end
local bw2 = tw(banner, "bitter14", "bold") + 4
tint(W // 2 - bw2 // 2, TOP + 4, bw2, math.min(lh("bitter14"), 33), t, "ink")
ctext(W / 2, TOP + 38, string.format("Card %d of 3", RV.idx), "small")
bigcard(fx, fy, c, true)
if r.shiny or S.shiny[c] == 1 then glass(fx + 8, fy + 8, 192) end
if not SAVER then card_aura(fx, fy, anim_t, t) end
local y = fy + 228
ctext(W / 2, y, cname(c), "bitter14", "bold")
local etxt = D.elems[elem_of(c)] .. "  -  " .. D.tiers[t + 1]
local ew = tw(etxt, "ui10", "regular")
chip(W // 2 - (ew + 40) // 2 + 16, y + 46, elem_of(c))
ltext(W // 2 - (ew + 40) // 2 + 40, y + 34, etxt, "ui10")
ctext(W / 2, y + 62, reveal_tag(r), "ui10", "bold")
local a, h = card_stats(c)
ctext(W / 2, y + 92, string.format("ATK %d    HP %d    LV %d", a, h, S.lvl[c]), "ui10")
smudge.line(48, y + 128, W - 48, y + 128, 1)
wrapped(40, y + 140, (t == 4) and ("ABILITY: " .. D.ability[elem_of(c)]) or D.lore[c], W - 80, "ui10", 3)
ctext(W / 2, y + 224, "Strong vs " .. D.elems[D.beats[elem_of(c)]] .. "   -   Weak to " .. D.elems[D.weak[elem_of(c)]], "small")
button(24, H - 96, W - 48, 64, (RV.idx < 3) and "NEXT CARD" or "SEE SUMMARY", function() RV.idx = RV.idx + 1; focus = 1; aura_start() end)
return
end
if RV.multi then
local y = TOP + 6
ctext(W / 2, y, RV.multi .. " packs opened", "bitter14", "bold")
local cnt, nnew = { 0, 0, 0, 0, 0, 0, 0 }, 0
for _, r in ipairs(RV.list) do local t = tier_of(r.c); cnt[t + 1] = cnt[t + 1] + 1; if r.new then nnew = nnew + 1 end end
ctext(W / 2, y + 36, string.format("%d cards   %d NEW!", #RV.list, nnew), "ui10", "bold")
local ab = { "C", "U", "R", "L", "E", "M", "S" }
local p = {}
for t = 1, 7 do if cnt[t] > 0 then p[#p + 1] = ab[t] .. " " .. cnt[t] end end
ctext(W / 2, y + 62, table.concat(p, "   "), "small", "bold")
local sorted = {}
for _, r in ipairs(RV.list) do sorted[#sorted + 1] = r end
table.sort(sorted, function(a, b)
if a.new ~= b.new then return a.new end
if tier_of(a.c) ~= tier_of(b.c) then return tier_of(a.c) > tier_of(b.c) end
return a.c < b.c
end)
local seen, shown = {}, {}
for _, r in ipairs(sorted) do if not seen[r.c] and #shown < 8 then seen[r.c] = true; shown[#shown + 1] = r end end
for k, r in ipairs(shown) do
local col, row = (k - 1) % 4, (k - 1) // 4
local gx, gy = 12 + col * 116, y + 90 + row * 150
thumb(gx, gy, r.c, { show = true })
ctext(gx + 54, gy + 112, fit(cname(r.c), 112, "small", "bold"), "small", "bold")
if r.new then ctext(gx + 54, gy + 130, "NEW!", "small", "bold") end
end
local more = #RV.list - #shown
if more > 0 then ctext(W / 2, y + 392, "+" .. more .. " more cards - see them in the Album", "small") end
local n = RV.multi
local cost = D.pack_cost * n
button(24, H - 190, W - 48, 76, "OPEN ANOTHER " .. n, function() open_pack(nil, nil, nil, n) end,
{ sub = cost .. " coins", off = S.coins < cost, id = "OPEN ANOTHER" })
button(24, H - 96, W - 48, 64, "DONE", function() RV = nil; go("packs") end, { font = "ui10" })
return
end
local y = TOP + 10
ctext(W / 2, y, "Pack summary", "bitter14", "bold")
for i = 1, 3 do
local r = RV.list[i]
local x = 12 + (i - 1) * 156
thumb(x + 24, y + 50, r.c, { show = true })
ctext(x + 78, y + 166, fit(cname(r.c), 150, "small", "bold"), "small", "bold")
ctext(x + 78, y + 190, r.new and "NEW!" or "spare", "small")
end
res_bar(y + 250)
ctext(W / 2, y + 296, "Manage spare copies in the Album.", "ui10")
local k = RV.kind or {}
local sub, off
if k[5] then sub = ((k[5] == 3) and 1200 or 400) .. " dust"; off = S.dust < ((k[5] == 3) and 1200 or 400)
elseif k[3] then sub = D.elems[k[3]] .. " pack, 70 coins"; off = S.coins < 70
elseif k[2] then sub = S.camp.rtickets .. " rare ticket(s) left"; off = S.camp.rtickets < 1
elseif k[1] then sub = S.camp.tickets .. " ticket(s) left"; off = S.camp.tickets < 1
else sub = string.format("costs %d coins", D.pack_cost); off = S.coins < D.pack_cost end
button(24, H - 190, W - 48, 76, "OPEN ANOTHER", function() open_pack(k[1], k[2], k[3], nil, k[5]) end, { sub = sub, off = off, id = "OPEN ANOTHER" })
button(24, H - 96, W - 48, 64, "DONE", function() local e = k[3]; RV = nil; go(e and "elempack" or "packs") end, { font = "ui10" })
draw_note(H - 214)
end
local filt = 0
local dslot = 1
local FILT = { "ALL", "OWNED", "MISSING", "SPARES", "SHINY" }
local function filt_name()
if filt <= 4 then return FILT[filt + 1] end
return D.elems[filt - 4]
end
local function filt_ok(c)
if filt == 0 then return true end
if filt == 1 then return S.lvl[c] > 0 end
if filt == 2 then return S.lvl[c] == 0 end
if filt == 3 then return S.spare[c] > 0 end
if filt == 4 then return S.shiny[c] == 1 and S.lvl[c] > 0 end
return elem_of(c) == filt - 4
end
local BIND = { pg = {}, turn = nil, open_t = nil }
local POCK = { { 23, 70 }, { 79, 126 }, { 135, 183 } }
local POCKY = { { 9, 74 }, { 84, 148 }, { 159, 224 } }
function BIND.on() return V3.ok() and not SAVER end
function BIND.page(px, py, pw, ph, ang, cards, cellfn, back)
local function P(u, v)
local x = u * pw
local ca, sa = math.cos(ang or 0), math.sin(ang or 0)
local z = x * sa
local k = 700 / (700 - z * 0.35)
return px + x * ca * k, py + ph / 2 + (v - 0.5) * ph * k
end
local function Q(u0, v0, u1, v1)
local a1, b1 = P(u0, v0); local a2, b2 = P(u1, v0); local a3, b3 = P(u1, v1); local a4, b4 = P(u0, v1)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
local q = Q(0, 0, 1, 1)
if back then q = { q[3], q[4], q[1], q[2], q[7], q[8], q[5], q[6] } end
smudge.fill_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], false, TT.panel)
smudge.draw_sprite_quad("art/bind_page.raw", 192, 232, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
if back or not cards then return end
for i = 1, 9 do
local c = cards[i]
if c then
local cx, cy = POCK[(i - 1) % 3 + 1], POCKY[(i - 1) // 3 + 1]
cellfn(i, c, Q((cx[1] + 2) / 192, (cy[1] + 2) / 232, (cx[2] - 2) / 192, (cy[2] - 2) / 232), not ang or ang == 0)
end
end
end
function BIND.card(c, q, show)
local own = owned(c)
smudge.fill_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], false, card_tk())
local function L(u, v) return q[1] + (q[3] - q[1]) * u + (q[7] - q[1]) * v, q[2] + (q[4] - q[2]) * u + (q[8] - q[2]) * v end
if own or show then
local a1, b1 = L(0.06, 0.05); local a2, b2 = L(0.94, 0.05); local a3, b3 = L(0.94, 0.70); local a4, b4 = L(0.06, 0.70)
smudge.draw_sprite_quad(art_path(c, false), 96, 96, a1, b1, a2, b2, a3, b3, a4, b4)
else
smudge.draw_sprite_quad("art/card_back.raw", 192, 256, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
end
for k = 0, 3 do
local i, j = k * 2 + 1, ((k + 1) % 4) * 2 + 1
smudge.line(math.floor(q[i] + 0.5), math.floor(q[i + 1] + 0.5), math.floor(q[j] + 0.5), math.floor(q[j + 1] + 0.5), 1)
end
if smudge.glare_quad then
local sh = ((smudge.millis() / 3200 + q[1] / 700 + (BIND.shine or 0)) % 1.6) - 0.3
local function cl(v) return math.max(0, math.min(1, v)) end
if sh < 1.05 then
local s1, t1 = L(cl(sh + 0.2), 0); local s2, t2 = L(cl(sh + 0.4), 0); local s3, t3 = L(cl(sh), 1); local s4, t4 = L(cl(sh - 0.2), 1)
smudge.glare_quad(s1, t1, s2, t2, s3, t3, s4, t4, false)
end
end
return L
end
function BIND.target(fwd)
local cur = math.min(BIND.pg[page] or 0, BIND.npages(page) - 1)
local tt, tp = page, cur
if fwd then
if cur + 1 < BIND.npages(page) then tp = cur + 1 elseif page < 6 then tt, tp = page + 1, 0 end
else
if cur > 0 then tp = cur - 1 elseif page > 0 then tt, tp = page - 1, BIND.npages(page - 1) - 1 end
end
if tt == page and tp == cur then return nil end
return { ft = page, fp = cur, tt = tt, tp = tp, fwd = fwd }
end
function BIND.touch(ev, x, y)
if scr ~= "album" or not BIND.on() or not BIND.box then return false end
local b = BIND.box
local now = smudge.millis()
if ev == "down" then
if not BIND.turn and smudge.in_rect(x, y, b[1], b[2], b[3], b[4]) then BIND.d = { x0 = x, y0 = y, smp = { { x, now } } } end
return false
end
local d = BIND.d
if not d then return false end
if ev == "move" then
local dx = x - d.x0
d.smp[#d.smp + 1] = { x, now }; if #d.smp > 8 then table.remove(d.smp, 1) end
if not d.moved and math.abs(dx) > 12 then
d.moved = true
d.tg = BIND.target(dx < 0)
end
if d.moved and d.tg then
local prog = (d.tg.fwd and -dx or dx) / (b[3] * 0.9)
d.tg.prog = math.max(0, math.min(1, prog))
BIND.drag = d.tg
V3.moving = now + 600
end
return d.moved or false
end
if ev == "release" then
BIND.d = nil
local tg = d.tg
BIND.drag = nil
if d.moved and tg then
local s0 = d.smp[1]
for _, sm in ipairs(d.smp) do if now - sm[2] <= 100 then s0 = sm; break end end
local v = (x - s0[1]) / math.max(16, now - s0[2]) * (tg.fwd and -1 or 1)
tg.u0 = tg.prog or 0
tg.u1 = ((tg.prog or 0) > 0.35 or v > 0.5) and 1 or 0
tg.t = now
BIND.turn = tg
V3.moving = now + 900
end
return d.moved or false
end
return false
end
function BIND.npages(t) return math.max(1, ((#(D.tier_cards[t] or {})) + 8) // 9) end
function BIND.draw(y0, y1, cellfn)
local now = smudge.millis()
local n = BIND.npages(page)
BIND.pages = n
local cur = math.min(BIND.pg[page] or 0, n - 1); BIND.pg[page] = cur
local ph = y1 - y0 - 30
local pw = math.floor(ph * 192 / 232)
if pw > W - 40 then pw = W - 40; ph = math.floor(pw * 232 / 192) end
local px, py = math.floor((W - pw) / 2), y0
BIND.box = { px, py, pw, ph }
local function cards_of(p, tier)
local list = D.tier_cards[tier or page] or {}
local t = {} for i = 1, 9 do t[i] = list[p * 9 + i] end return t
end
local function flatcell(i, c, q, flat)
local L = BIND.card(c, q, false)
if BIND.dim and BIND.dim(c) and smudge.glare_quad then
smudge.glare_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], true)
end
if flat then
local x0, y0b = math.floor(q[1]), math.floor(q[2])
local w0, h0 = math.floor(q[3] - q[1]), math.floor(q[8] - q[2])
local nm = owned(c) and cname(c) or "???"
local lx, ly = L(0.5, 0.76)
ctext(lx, ly, fit(nm, w0 - 4, "small", "regular"), "small")
if GR and owned(c) then GR.badge(x0 - 2, y0b - 2, c) end
if owned(c) and S.spare[c] > 0 then
smudge.circle(x0 + w0 - 6, y0b + 8, 11, true)
ctext(x0 + w0 - 6, y0b + 8 - lh("small") // 2, S.spare[c] > 9 and "9+" or tostring(S.spare[c]), "small", "bold", true)
end
cellfn(c, x0, y0b, w0, h0)
end
end
local tr = BIND.drag or BIND.turn
if tr then
local u
if BIND.drag then u = tr.prog or 0
else
local u0, u1 = tr.u0 or 0, tr.u1 or 1
local k = math.min(1, (now - tr.t) / (120 + 420 * math.abs(u1 - u0)))
k = 1 - (1 - k) * (1 - k)
u = u0 + (u1 - u0) * k
if k >= 1 then u = u1 end
end
BIND.shine = u * 0.8
local fwd = tr.fwd
V3.moving = now + 300
if fwd then BIND.page(px, py, pw, ph, 0, cards_of(tr.tp, tr.tt), flatcell)
else BIND.page(px, py, pw, ph, 0, cards_of(tr.fp, tr.ft), flatcell) end
local ang = fwd and (u * math.pi) or ((1 - u) * math.pi)
local sheet = fwd and cards_of(tr.fp, tr.ft) or cards_of(tr.tp, tr.tt)
if ang < math.pi / 2 - 0.02 then BIND.page(px, py, pw, ph, ang, sheet, flatcell) end
if not BIND.drag and (now - tr.t) >= (120 + 420 * math.abs((tr.u1 or 1) - (tr.u0 or 0))) then
if (tr.u1 or 1) >= 1 then page = tr.tt; BIND.pg[tr.tt] = tr.tp; cur = tr.tp; n = BIND.npages(page) end
BIND.turn = nil
end
else
BIND.page(px, py, pw, ph, 0, cards_of(cur), flatcell)
end
if BIND.open_t then
if BIND.open_t == 0 then BIND.open_t = now end
V3.moving = now + 300
local u = math.min(1, (now - BIND.open_t) / 900)
u = u * u * (3 - 2 * u)
local ang = u * math.pi
local function P(uu, vv)
local x = uu * pw
local ca, sa = math.cos(ang), math.sin(ang)
local k = 700 / (700 - x * sa * 0.35)
return px + x * ca * k, py + ph / 2 + (vv - 0.5) * ph * k
end
local a1, b1 = P(0, 0); local a2, b2 = P(1, 0); local a3, b3 = P(1, 1); local a4, b4 = P(0, 1)
if ang < math.pi / 2 then
smudge.fill_quad(a1, b1, a2, b2, a3, b3, a4, b4, false, TT.panel)
smudge.draw_sprite_quad("art/bind_cover.raw", 192, 232, a1, b1, a2, b2, a3, b3, a4, b4)
end
if u >= 1 then BIND.open_t = nil end
end
local ty = py + ph + 6
local showk = cur
if tr and (tr.tt == page) then showk = ((BIND.drag and (tr.prog or 0) > 0.5) or (not BIND.drag and (tr.u1 or 1) >= 1)) and tr.tp or tr.fp end
for k = 0, n - 1 do
local dx2 = W // 2 - (n - 1) * 15 + k * 30
smudge.circle(dx2, ty + 9, (k == showk) and 8 or 6, k == showk, 2)
reg("BINDDOT" .. k, dx2 - 15, ty - 6, 30, 30, function()
if k == cur or BIND.turn then return end
BIND.turn = { ft = page, fp = cur, tt = page, tp = k, fwd = k > cur, u0 = 0, u1 = 1, t = smudge.millis() }
V3.moving = smudge.millis() + 900
end, true)
end
if n > 1 then ctext(W / 2, ty + 22, "hold a page and drag it over", "small") end
end
SCREENS.album = function()
local pick = (album_mode == "pick")
local dmode = (album_mode == "deck")
local smode = (album_mode == "show")
top_bar(smode and ("Showcase slot " .. sslot) or (dmode and "Pick Deck Card" or (pick and "Pick a Fighter" or "Album")),
pick and ("Stage " .. S.stage) or string.format("%d/%d", found_count(), D.ncards))
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
if not BIND.on() then swipe_tabs(function() return page end, function(t) page = t end, 0, 6) end
for i = 0, 6 do
local n, tot = GRID.count(i)
button(6 + i * 67, TOP + 6, 63, 56, tabs[i + 1], function() if page == i then GRID.flip("album", i) end; page = i end,
{ font = "small", sub = n .. "/" .. tot, active = (page == i) })
end
local y0 = TOP + 80
local view = (album_mode == "view")
local function cell_act(c)
if pick then
return function() if owned(c) then start_battle(c) else note = "You do not own that card yet." end end
elseif smode then
return function()
if not owned(c) then note = "You do not own that card yet."; return end
SHOW[sslot] = c; save_show(); go("title")
end
elseif dmode then
return function()
if not owned(c) then note = "You do not own that card yet."; return end
for i = 1, 3 do if S.deck[i] == c and i ~= dslot then note = "That card is already in your deck."; return end end
if GR and GR.busy(c) then note = cname(c) .. " is away for grading."; return end
S.deck[dslot] = c; save_now(); go("deck")
end
end
return function() sel = c; go("detail") end
end
local bind = BIND.on()
local ctrl_h = view and 54 or (smode and 86 or 60)
local res_y = H - 96 - 36
local yb = bind and (res_y - 8 - ctrl_h) or (y0 + 2 * 164 + 4)
if bind then
BIND.dim = function(c) return view and not filt_ok(c) end
BIND.draw(y0, yb - 2, function(c, x, y, w, h) reg("card" .. c, x, y, w, h, cell_act(c), true) end)
else
GRID.draw("album", page, y0, 2, 164, function(c, x, y)
if view and not filt_ok(c) then
smudge.rounded_rect(x, y, 108, 108, 8, false, 1)
else
thumb(x, y, c, { name = true, pips = true, badge = true })
end
local act
if pick then
act = function()
if owned(c) then start_battle(c) else note = "You do not own that card yet." end
end
elseif smode then
act = function()
if not owned(c) then note = "You do not own that card yet."; return end
SHOW[sslot] = c; save_show(); go("title")
end
elseif dmode then
act = function()
if not owned(c) then note = "You do not own that card yet."; return end
for i = 1, 3 do if S.deck[i] == c and i ~= dslot then note = "That card is already in your deck."; return end end
if GR and GR.busy(c) then note = cname(c) .. " is away for grading."; return end
S.deck[dslot] = c; save_now(); go("deck")
end
else
act = function() sel = c; go("detail") end
end
reg("card" .. c, x, y, 108, 150, act, true)
end)
end
local y = yb
if bind then y = yb - 8 else smudge.line(24, y, W - 24, y, 1) end
if view then
button(24, y + 8, W - 48, 54, "FILTER: " .. filt_name(), function() filt = (filt + 1) % 13 end, { font = "ui10", id = "FILTER" })
elseif smode then
ctext(W / 2, y + 12, "Tap a card you own to show it off on Home.", "ui10")
local hw = (W - 48 - 8) // 2
button(24, y + 36, hw, 50, "BEST 4", function() show_best(); go("title") end, { font = "ui10", sub = "fill all slots", id = "SHOWBEST" })
button(32 + hw, y + 36, hw, 50, "RESET", function() SHOW = { 25, 28, 30, 32 }; save_show(); go("title") end, { font = "ui10", sub = "default cards", id = "SHOWRESET" })
elseif dmode then
ctext(W / 2, y + 12, "Tap an owned card for this deck slot.", "ui10")
else
ctext(W / 2, y + 12, "Tap a card you own to take into battle.", "ui10")
ctext(W / 2, y + 40, "Higher levels hit harder and last longer.", "small")
end
if bind then res_bar(res_y) elseif not smode then res_bar(y + 70) end
draw_note(y + 106)
button(24, H - 96, W - 48, 64, "BACK", function() go(dmode and "deck" or "title") end, { font = "ui10" })
end
function V3.ok() return CS_SMOOTH and smudge.draw_sprite_quad ~= nil and smudge.fill_quad ~= nil end
function V3.open(c) V3.c = c; V3.lbl = nil; V3.last = nil; V3.rx, V3.ry, V3.drag = 0.35, -0.5, nil; go("card3d") end
function V3.touch(ev, x, y, sx_v)
if ev == "down" then V3.drag = { x0 = x, y0 = y }; V3.spin = nil
elseif ev == "move" and V3.drag then
V3.ty = math.max(-0.6, math.min(0.6, -(x - V3.drag.x0) / 260))
V3.tx = math.max(-0.5, math.min(0.5, (y - V3.drag.y0) / 320))
V3.drag.moved = true
elseif ev == "release" then
local vx = tonumber(sx_v) or 0
local _ = vx
V3.drag = nil
end
end
function V3.mini_touch(ev, x, y)
local m = V3.mini
if not m or not m.box or type(x) ~= "number" then return false end
local bx = m.box
if ev == "down" then
if smudge.in_rect(x, y, bx[1], bx[2], bx[3], bx[4]) then m.drag = { x0 = x, y0 = y }; return true end
m.drag = nil; return false
end
if not m.drag then return false end
if ev == "move" then
local dx, dy = x - m.drag.x0, y - m.drag.y0
if m.drag.moved or dx * dx + dy * dy > 64 then
m.drag.moved = true
m.ty = math.max(-0.55, math.min(0.55, -dx / 200))
m.tx = math.max(-0.45, math.min(0.45, dy / 240))
end
return true
end
if ev == "release" then local moved = m.drag.moved; m.drag = nil; return moved and true or false end
m.drag = nil
return false
end
V3.T = {}
function V3.tilt_get(id, x, y, w, h, amp)
local t = V3.T[id]
if not t then t = { rx = 0, ry = 0, tx = 0, ty = 0 }; V3.T[id] = t end
t.box = { x, y, w, h }; t.scr = scr; V3.T.cur = t
local now = smudge.millis()
local held = t.drag and t.drag.moved
local gx, gy = t.tx, t.ty
if not held then gx = 0.05 * amp * math.sin(now / 2100 + 1); gy = 0.12 * amp * math.sin(now / 1700) end
local dt = math.min(100, now - (t.last or now)); t.last = now
local k = 1 - math.exp(-dt / (held and 60 or 140))
t.rx = t.rx + (gx - t.rx) * k; t.ry = t.ry + (gy - t.ry) * k
return t.rx, t.ry
end
function V3.tilt_touch(ev, x, y)
local t = V3.T.cur
if not t or t.scr ~= scr or not t.box or type(x) ~= "number" then return false end
local bx = t.box
if ev == "down" then
if smudge.in_rect(x, y, bx[1], bx[2], bx[3], bx[4]) then t.drag = { x0 = x, y0 = y }; return true end
t.drag = nil; return false
end
if not t.drag then return false end
if ev == "move" then
t.drag.moved = true
t.ty = math.max(-0.24, math.min(0.24, -(x - t.drag.x0) / 380))
t.tx = math.max(-0.16, math.min(0.16, (y - t.drag.y0) / 480))
return true
end
if ev == "release" then local moved = t.drag.moved; t.drag = nil; return moved and true or false end
t.drag = nil
return false
end
for _, n in ipairs({ "touch", "mini_touch", "tilt_touch" }) do
local f = V3[n]
V3[n] = function(ev, ...)
local r = f(ev, ...)
if ev == "move" or ev == "release" or ev == "down" then V3.moving = smudge.millis() + 1600 end
return r
end
end
function V3.render(o)
local c, cx, cy, CW, CH, FOC = o.c, o.cx, o.cy, o.CW, o.CH, 900
local dp = o.depth or 1
local cr, sr, cxr, sxr = math.cos(o.ry), math.sin(o.ry), math.cos(o.rx), math.sin(o.rx)
local SC = o.scale or 1
local function P(x, y, z)
x, y, z = x * SC, y * SC, z * dp * SC
if o.proj then return o.proj(x, y, z) end
local x1, z1 = x * cr + z * sr, -x * sr + z * cr
local y2, z2 = y * cxr - z1 * sxr, y * sxr + z1 * cxr
local k = FOC / (FOC + z2)
return cx + x1 * k, cy + y2 * k
end
local function Q(x0, y0, x1, y1, z)
local a, b = P(x0, y0, z); local c2, d = P(x1, y0, z); local e, f = P(x1, y1, z); local g, h = P(x0, y1, z)
return a, b, c2, d, e, f, g, h
end
local hw, hh = CW / 2, CH / 2
local MG = tier_of(c) == 5 and anim_v > 0 and not SAVER
local GL = { a = "4", e = "3", i = "!", o = "0", s = "5", t = "7", l = "1", A = "4", E = "3", I = "!", O = "0", S = "5", T = "7",
["0"] = "O", ["1"] = "I", ["2"] = "Z", ["3"] = "E", ["4"] = "A", ["5"] = "S", ["6"] = "b", ["7"] = "T", ["8"] = "B", ["9"] = "g" }
local function corrupt(txt)
if not MG or not txt then return txt end
local out, i = {}, 0
for ch in txt:gmatch(".") do
i = i + 1
out[i] = ((i * 7 + anim_v * 3) % 4 == 0 and GL[ch]) or ch
end
return table.concat(out)
end
local function tquad(key, w, h, x0, y0, x1, y1, z)
if not MG then
local q = { Q(x0, y0, x1, y1, z) }
smudge.draw_sprite_quad(key, w, h, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
return
end
local NS = 5
for k = 0, NS - 1 do
local t0, t1 = k / NS, (k + 1) / NS
local dx = ((k * 7 + anim_v * 3) % 3 == 0) and (((k + anim_v) % 2 == 0) and 1 or -1) * (3 + 3 * anim_v) or 0
local q = { Q(x0 + dx, y0 + (y1 - y0) * t0, x1 + dx, y0 + (y1 - y0) * t1, z) }
smudge.draw_sprite_quad(key, w, h, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], nil, 0, t0, 1, t1)
end
end
local tk = (not SAVER) and card_tk() or 0
if o.back then
local sx, sy = (9 + o.ry * 34) * dp * SC, (13 - o.rx * 34) * dp * SC
local q = { Q(-hw, -hh, hw, hh, 12) }
