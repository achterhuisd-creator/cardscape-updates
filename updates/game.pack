sparkle(cx - 98 - d + dx, cy - 128 - d // 2, 10 + 3 * k); sparkle(cx + 98 + d + dx, cy - 128 - d // 2, 8 + 3 * k)
if t >= 3 then sparkle(cx - 98 - d + dx, cy + 124 + d // 2, 8 + 2 * k); sparkle(cx + 98 + d + dx, cy + 124 + d // 2, 10 + 2 * k) end
