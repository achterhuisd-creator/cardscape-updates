if side == 0 then x0, y0, dx, dy = -hw + u * CW, -hh - r0, 0, -1
elseif side == 1 then x0, y0, dx, dy = hw + r0, -hh + u * CH, 1, 0
elseif side == 2 then x0, y0, dx, dy = hw - u * CW, hh + r0, 0, 1
