local bk, fr = oct(bz), oct(fz)
fill_oct(bk, false, tk)
for k = 0, 7 do
local i, j = k * 2 + 1, ((k + 1) % 8) * 2 + 1
local xs = { bk[i], bk[j], fr[j], fr[i] }
