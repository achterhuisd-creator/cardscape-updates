SCREENS.deck = function()
top_bar("Deck & Sets", "")
ctext(W / 2, TOP + 4, "Your team of three", "ui12", "bold")
for i = 1, 3 do
local x = 12 + (i - 1) * 156
local c = S.deck[i]
if c ~= 0 and owned(c) then thumb(x + 24, TOP + 44, c, { name = true })
else
smudge.rounded_rect(x + 24, TOP + 44, 108, 108, 8, false, 2)
ctext(x + 78, TOP + 84, "EMPTY", "small", "bold")
end
reg("slot" .. i, x + 24, TOP + 44, 108, 130, function() dslot = i; album_mode = "deck"; page = 0; go("album") end, true)
end
local y = TOP + 196
wrapped(30, y, "Team spirit: a fighter in the deck gets +1 ATK and +2 HP for every other card in the deck.", W - 60, "ui10", 3)
local ts = 0
for t = 0, 5 do if tier_done(t) then ts = ts + 1 end end
ltext(30, y + 84, string.format("Set bonus now: +%d ATK, +%d HP on all cards", ts, ts * 2), "small", "bold")
local ec = 0
for e = 1, 8 do if elem_done(e) then ec = ec + 1 end end
ltext(30, y + 108, string.format("Element lines done: %d (+2 ATK for that element)", ec), "small")
button(24, y + 140, W - 48, 74, "SETS", function() go("sets") end, { sub = sets_done() .. " / 14 complete", font = "ui10" })
button(24, y + 224, W - 48, 56, "CLEAR DECK", function() S.deck = { 0, 0, 0 }; save_now(); note = "Deck cleared." end, { font = "ui10" })
draw_note(y + 288)
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
local spage = 0
local SET_DUST = { 20, 40, 60, 100, 150, 200 }
local function set_def(i)
if i <= 6 then
local n = 0
for k = 1, 8 do if S.lvl[(i - 1) * 8 + k] > 0 then n = n + 1 end end
return D.tiers[i] .. " set", n, 8, SET_DUST[i] .. " dust", function() add_dust(SET_DUST[i]) end
end
local e = i - 6
local n = 0
for t = 0, 5 do if S.lvl[t * 8 + e] > 0 then n = n + 1 end end
return D.elems[e] .. " line", n, 5, "30 dust + 100 coins", function() add_dust(30); add_coins(100) end
end
SCREENS.sets = function()
top_bar("Sets", sets_done() .. " / 14")
local per = 5
local pages = 3
if spage >= pages then spage = pages - 1 end
local function srow(i, k, by)
if i <= 14 then
local name, n, tot, rw, give = set_def(i)
local done = (S.setmask >> (i - 1)) & 1 == 1
smudge.rounded_rect(20, by, W - 40, 92, 10, true, 1, false)
smudge.rounded_rect(20, by, W - 40, 92, 10, false, 2)
ltext(34, by + 6, name, "ui10", "bold")
ltext(34, by + 34, "Reward: " .. rw, "small")
bar(34, by + 62, 200, 16, n / tot)
ltext(244, by + 62, n .. "/" .. tot, "small")
button(W - 24 - 130, by + 10, 120, 72, done and "DONE" or "CLAIM", function()
if (S.setmask >> (i - 1)) & 1 == 1 then return end
if n < tot then note = "Collect them all first."; return end
S.setmask = S.setmask | (1 << (i - 1)); give(); note = name .. " claimed!"; save_now()
end, { font = "small", off = done or n < tot, id = "SET" .. k })
end
end
local ny = TOP + 6 + per * 100 + 4
if not scroll_list("sets", TOP + 6, nil, 14, 100, function(i, by) srow(i, i, by) end) then
for k = 1, per do srow(spage * per + k, k, TOP + 6 + (k - 1) * 100) end
button(24, ny, 140, 46, "PREV", function() if spage > 0 then spage = spage - 1 end end, { font = "ui10", off = spage == 0, id = "PREV" })
ctext(W / 2, ny + 12, (spage + 1) .. " / " .. pages, "ui10")
button(W - 24 - 140, ny, 140, 46, "NEXT", function() if spage < pages - 1 then spage = spage + 1 end end, { font = "ui10", off = spage >= pages - 1, id = "NEXT" })
end
draw_note(ny + 52)
button(24, H - 96, W - 48, 64, "BACK", function() go("deck") end, { font = "ui10" })
end
local function save_opt() smudge.save("opt", SAVER and "1" or "0") end
GAME_VERSION = "3.40.1"
SCREENS.customtheme = function()
top_bar("Custom theme", "make it yours")
local y = TOP + 22
ltext(32, y, "Mix three colour groups. Changes preview immediately.", "small")
local function chooser(row_y, title, label, index, choices, key, set_index)
smudge.rounded_rect(24, row_y, W - 48, 104, 10, true, 1, false)
smudge.rounded_rect(24, row_y, W - 48, 104, 10, false, 2)
ltext(42, row_y + 12, title, "ui10", "bold")
ctext(W / 2, row_y + 43, label, "ui12", "bold")
button(38, row_y + 62, 104, 34, "PREV", function() set_index(index == 1 and #choices or index - 1); apply_theme() end, { font = "small", id = key .. "PREV" })
button(W - 142, row_y + 62, 104, 34, "NEXT", function() set_index(index % #choices + 1); apply_theme() end, { font = "small", id = key .. "NEXT" })
end
chooser(y + 30, "ROOM & PANELS", CT.bases[CT.bg][1], CT.bg, CT.bases, "CUSTOMBASE", function(v) CT.bg = v; smudge.save("custombg", tostring(v)) end)
chooser(y + 150, "ACCENT & BUTTONS", CT.accents[CT.accent][1], CT.accent, CT.accents, "CUSTOMACCENT", function(v) CT.accent = v; smudge.save("customaccent", tostring(v)) end)
chooser(y + 270, "CARD BACKGROUND", CT.cards[CT.card][1], CT.card, CT.cards, "CUSTOMCARD", function(v) CT.card = v; smudge.save("customcard", tostring(v)) end)
thumb(W // 2 - 54, y + 390, 20, { show = true, name = false })
button(24, H - 96, W - 48, 64, "DONE", function() theme_i = CT.custom; smudge.save("style", "custom"); apply_theme(); go("settings") end, { font = "ui10", id = "CUSTOMDONE" })
end
SCREENS.settings = function()
top_bar("Settings", "v" .. GAME_VERSION .. (smudge.app and " app" or ""))
local y = TOP + 8
if not SAVER then smudge.rounded_rect(24 + 3, y + 4, W - 48, 112, 10, true) end
smudge.rounded_rect(24, y, W - 48, 112, 10, true, 1, false)
smudge.rounded_rect(24, y, W - 48, 112, 10, false, 2)
ltext(44, y + 14, "Battery saver", "ui12", "bold")
ltext(44, y + 50, "Light mode: no animations,", "small")
ltext(44, y + 74, "no shadows, fewer refreshes.", "small")
local sx, sy, sw, sh = W - 24 - 24 - 104, y + 30, 104, 52
smudge.rounded_rect(sx, sy, sw, sh, 26, SAVER, 3, true)
if SAVER then
smudge.circle(sx + sw - 26, sy + sh // 2, 18, true, 1, false)
ctext(sx + 30, sy + (sh - lh("small")) // 2, "ON", "small", "bold", true)
else
smudge.circle(sx + 26, sy + sh // 2, 18, true)
ctext(sx + sw - 30, sy + (sh - lh("small")) // 2, "OFF", "small", "bold")
end
reg("SAVER", 24, y, W - 48, 112, function() SAVER = not SAVER; save_opt(); note = SAVER and "Battery saver is ON." or "Battery saver is OFF." end, false)
local hw2 = (W - 48 - 12) // 2
button(24, y + 124, hw2, 60, CLEAN and "CLEANUP: ON" or "CLEANUP: OFF",
function() CLEAN = not CLEAN; smudge.save("clean", CLEAN and "1" or "0"); apply_clean(); note = CLEAN and "A black clean-up flash every 40 screens removes ghosting." or "No more black clean-up flashes." end,
{ font = "ui10", sub = "flash every 40 screens", active = CLEAN, id = "CLEAN" })
button(36 + hw2, y + 124, hw2, 60, "STYLE: " .. THEMES[theme_i][2],
function()
if smudge.set_tint then theme_i = theme_i % #THEMES + 1
else theme_i = (theme_i == CT.classic) and 1 or CT.classic end
smudge.save("style", THEMES[theme_i][1]); apply_theme()
note = THEMES[theme_i][3] and (smudge.tint and "Style: " .. THEMES[theme_i][2] .. ". Tap again for the next one." or "Stone look (the colours show in the phone app).") or "Classic look: white and clean."
end, { font = "ui10", sub = "tap for the next", id = "STYLE" })
local ly = y + 196
if CS_SMOOTH then
button(24, ly, hw2, 60, FX_GLINT and "GLINT: ON" or "GLINT: OFF",
function() FX_GLINT = not FX_GLINT; smudge.save("fxglint", FX_GLINT and "1" or "0"); note = FX_GLINT and "A glint of light runs over the buttons now and then." or "No more glint over the buttons." end,
{ font = "ui10", sub = "light over buttons", active = FX_GLINT, id = "FXGLINT" })
button(36 + hw2, ly, hw2, 60, FX_RIP and "RIPPLE: ON" or "RIPPLE: OFF",
function() FX_RIP = not FX_RIP; smudge.save("fxrip", FX_RIP and "1" or "0"); note = FX_RIP and "A ripple spreads where you tap a button." or "No more ripple when you tap." end,
{ font = "ui10", sub = "ring where you tap", active = FX_RIP, id = "FXRIP" })
button(24, ly + 72, W - 48, 52, "CUSTOMIZE THEME", function() theme_i = CT.custom; apply_theme(); go("customtheme") end,
{ font = "ui10", sub = "choose your own room and card colours", id = "CUSTOMTHEME" })
draw_note(ly + 136)
else
ltext(32, ly, "What battery saver changes", "ui10", "bold")
local items = {
"Pack opening and card outlines stand still.",
"Card effects stand still.",
"No drop shadows, so screens draw faster.",
"Enemy answers instantly in battles.",
"Camp timers stop refreshing the screen.",
}
for i, t in ipairs(items) do ltext(40, ly + 30 + (i - 1) * 26, "- " .. fit(t, W - 90, "small", "regular"), "small") end
draw_note(ly + 160)
end
local by = H - 270
if smudge.frame_ms and not CS_SMOOTH then
local d, r = smudge.frame_ms()
if d and r and (d > 0 or r > 0) then ctext(W / 2, by - 38, string.format("Last screen: drawing %d ms, e-ink %d ms", d, r), "small") end
end
smudge.line(24, by - 10, W - 24, by - 10, 1)
ctext(W / 2, by, "Danger zone", "small")
button(24, by + 26, W - 48, 64, confirm_reset and "TAP AGAIN TO ERASE EVERYTHING" or "RESET PROGRESS",
function()
if confirm_reset then
S = new_state(); C.reset_act(); PE = nil; save_now(); confirm_reset = false; note = "Progress erased."
else confirm_reset = true; note = "This erases cards, coins and the camp." end
end, { font = "ui10", off = true })
local hw = (W - 48 - 12) // 2
local cloud = (not smudge.app) and smudge.cloud_sync
local bw = cloud and (W - 48 - 24) // 3 or hw
if smudge.app then
button(24, H - 366, bw, 60, "SYNC WITH READER", function() save_now(); smudge.sync() end,
{ font = "small", sub = "copy your progress", id = "SYNC" })
else
button(24, H - 366, bw, 60, confirm_phone and "TAP TO START" or (cloud and "WI-FI SYNC" or "SYNC WITH PHONE"),
function()
if not smudge.phone_play then
note = "Install the new CardScape firmware to sync with the phone app."
elseif confirm_phone then
confirm_phone = false; save_now(); smudge.phone_play()
else
confirm_phone = true
note = "Opens Wi-Fi. Then tap SYNC in the CardScape app on your phone. The reader restarts when it's done."
end
end, { font = "small", sub = "with the app", active = confirm_phone, id = "SYNC" })
end
if cloud then
button(24 + bw + 12, H - 366, bw, 60, "CLOUD SYNC", function() confirm_phone = false; save_now(); smudge.cloud_sync() end,
{ font = "small", sub = "now", id = "CLOUDNOW" })
local st = smudge.cloud_status and smudge.cloud_status()
local head, line, full = "Cloud sync", "never ran on this reader yet", nil
if st then
local t, when, res = st:match("^(%-?%d+)\t([^\t]*)\t([^\n]*)")
if res then
res = res:gsub("^cloud: ", "")
local ago = ""
local now = tonumber(smudge.time and smudge.time() or 0) or 0
t = tonumber(t) or 0
if t > 1600000000 and now >= t then
local d = now - t
ago = d < 60 and "just now" or (d < 3600 and (d // 60) .. " min ago" or (d < 86400 and (d // 3600) .. " h ago" or (d // 86400) .. " d ago"))
end
local wn = ({ start = "at start", quit = "at quit", sleep = "at sleep", button = "now" })[when] or when
head = "Cloud sync " .. wn .. (ago ~= "" and (", " .. ago) or "")
line = res
full = head .. ": " .. res
end
end
ctext(W / 2, H - 170, head, "small", "bold")
ctext(W / 2, H - 146, fit(line, W - 48, "small", "regular"), "small")
reg("CLOUDSTAT", 24, H - 174, W - 48, 54, function() note = full or (head .. ": " .. line) end, false)
end
button(24 + (cloud and 2 * (bw + 12) or (hw + 12)), H - 366, bw, 60, "QUIT GAME", function() save_now(); smudge.exit() end,
{ font = cloud and "small" or "ui10", sub = cloud and "saves first" or "progress is saved", id = "QUIT" })
button(24, H - 96, W - 48, 64, "BACK", function() confirm_phone = false; go("title") end, { font = "ui10" })
end
