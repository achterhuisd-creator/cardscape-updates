local filt = 0
local dslot = 1
local FILT = { "ALL", "OWNED", "MISSING", "SPARES", "SHINY" }
local function filt_name()
if filt <= 4 then return FILT[filt + 1] end
return D.elems[filt - 4]
end
local function filt_ok(c)
if filt == 0 then return true end
if filt == 1 then return S.lvl[c] > 0 end
if filt == 2 then return S.lvl[c] == 0 end
if filt == 3 then return S.spare[c] > 0 end
if filt == 4 then return S.shiny[c] == 1 and S.lvl[c] > 0 end
return elem_of(c) == filt - 4
end
local BIND = { pg = {}, turn = nil, open_t = nil }
local PK_ROWS = { { 19, 114 }, { 122, 218 }, { 226, 320 } }
BIND.PL = { path = "art/bind_pl", off = 34, w = 266, h = 349, sw = 192, sh = 232,
cols = { { 30, 101 }, { 110, 182 }, { 190, 261 } }, rows = PK_ROWS }
BIND.PR = { path = "art/bind_pr", off = 34, w = 266, h = 349, sw = 192, sh = 232,
cols = { { 4, 76 }, { 85, 157 }, { 166, 237 } }, rows = PK_ROWS }
BIND.SP = { path = "art/bind_sp", w = 68, h = 349, sw = 48, sh = 232 }
BIND.CF = { off = 0, w = 335, h = 370, sw = 192, sh = 232 }
BIND.CB = { path = "art/bind_pl", off = 0, w = 266, h = 349, sw = 192, sh = 232, cols = BIND.PL.cols, rows = PK_ROWS }
function BIND.on() return V3.ok() and not SAVER end
function BIND.sheet(path, q, sw, sh)
sw, sh = sw or 192, sh or 232
smudge.draw_sprite_quad(path .. ".raw", sw, sh, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], path .. "_m.raw")
if smudge.tint_sprite_uv then
smudge.tint_sprite_uv(path .. "_m.raw", sw, sh, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], card_tk(), 3, 0, 0, 1, 1)
end
end
function BIND.spine(sx, cy, U)
local p = BIND.SP
local x0, x1, y0, y1 = sx - p.w / 2 * U, sx + p.w / 2 * U, cy - p.h / 2 * U, cy + p.h / 2 * U
BIND.sheet(p.path, { x0, y0, x1, y0, x1, y1, x0, y1 }, p.sw, p.sh)
end
function BIND.leaf(sx, cy, U, a, cards, cellfn, cover)
local ca, sa = math.cos(a), math.sin(a)
local left = ca < 0
local pic
if cover then
if left then pic = BIND.CB else pic = BIND.CF; pic.path = cover end
else pic = left and BIND.PL or BIND.PR end
local function P(u, v)
local x = (pic.off + u * pic.w) * U
local k = 700 / (700 - x * sa * 0.35)
return sx + x * ca * k, cy + (v - 0.5) * pic.h * U * k
end
local function Q(u0, v0, u1, v1)
if left then u0, u1 = 1 - u0, 1 - u1 end
local a1, b1 = P(u0, v0); local a2, b2 = P(u1, v0); local a3, b3 = P(u1, v1); local a4, b4 = P(u0, v1)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
BIND.sheet(pic.path, Q(0, 0, 1, 1), pic.sw, pic.sh)
if (cover and not left) or not cards then return end
local rest = math.abs(sa) < 0.01
for i = 1, 9 do
local c = cards[i]
if c then
local cx, cy2 = pic.cols[(i - 1) % 3 + 1], pic.rows[(i - 1) // 3 + 1]
local q = Q((cx[1] + 2) / pic.w, (cy2[1] + 2) / pic.h, (cx[2] - 2) / pic.w, (cy2[2] - 2) / pic.h)
local xa, xb = math.min(q[1], q[3], q[5], q[7]), math.max(q[1], q[3], q[5], q[7])
if xb > 0 and xa < W and xb - xa >= 2 then cellfn(i, c, q, rest) end
end
end
end
function BIND.card(c, q, show) CT.base(true); local r = BIND.card_(c, q, show); CT.base(false); return r end
function BIND.card_(c, q, show)
local own = owned(c)
smudge.fill_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], false, card_tk())
local function L(u, v) return q[1] + (q[3] - q[1]) * u + (q[7] - q[1]) * v, q[2] + (q[4] - q[2]) * u + (q[8] - q[2]) * v end
if own or show then
local a1, b1 = L(0.06, 0.05); local a2, b2 = L(0.94, 0.05); local a3, b3 = L(0.94, 0.70); local a4, b4 = L(0.06, 0.70)
smudge.draw_sprite_quad(art_path(c, false), 96, 96, a1, b1, a2, b2, a3, b3, a4, b4)
local p, mw, mh = EVO.spr(c)
if p and own then
EVO.quad(c, false, function(u, v) return L(0.06 + (5 + u) / 96 * 0.88, 0.05 + (96 - 5 - mh + v) / 96 * 0.65) end, card_tk())
end
else
smudge.draw_sprite_quad("art/card_back.raw", 192, 256, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
end
for k = 0, 3 do
local i, j = k * 2 + 1, ((k + 1) % 4) * 2 + 1
smudge.line(math.floor(q[i] + 0.5), math.floor(q[i + 1] + 0.5), math.floor(q[j] + 0.5), math.floor(q[j + 1] + 0.5), 1)
end
if smudge.glare_quad then
local sh = ((smudge.millis() / 3200 + q[1] / 700 + (BIND.shine or 0)) % 1.6) - 0.3
local function cl(v) return math.max(0, math.min(1, v)) end
if sh < 1.05 then
local s1, t1 = L(cl(sh + 0.2), 0); local s2, t2 = L(cl(sh + 0.4), 0); local s3, t3 = L(cl(sh), 1); local s4, t4 = L(cl(sh - 0.2), 1)
smudge.glare_quad(s1, t1, s2, t2, s3, t3, s4, t4, false)
end
end
return L
end
function BIND.target(fwd)
local cur = math.min(BIND.pg[page] or 0, BIND.npages(page) - 1)
local tt, tp = page, cur
if fwd then
if cur + 1 < BIND.npages(page) then tp = cur + 1 elseif page < 6 then tt, tp = page + 1, 0 end
else
if cur > 0 then tp = cur - 1 elseif page > 0 then tt, tp = page - 1, BIND.npages(page - 1) - 1 end
end
if tt == page and tp == cur then return nil end
return { ft = page, fp = cur, tt = tt, tp = tp, fwd = fwd }
end
function BIND.stouch(ev, x, y)
local b = BIND.sbox
local now = smudge.millis()
if ev == "down" then
if not BIND.sturn and smudge.in_rect(x, y, b[1], b[2], b[3], b[4]) then BIND.d = { x0 = x, smp = { { x, now } } } end
return false
end
local d = BIND.d
if not d then return false end
if ev == "move" then
local dx = x - d.x0
d.smp[#d.smp + 1] = { x, now }; if #d.smp > 8 then table.remove(d.smp, 1) end
if not d.moved and math.abs(dx) > 12 then
d.moved = true
if BIND.mode == "closed" then
if dx < 0 then d.tg = { cover = true, open = true, fwd = true } end
elseif dx > 0 and page == 0 and (BIND.pg[0] or 0) < 2 then
d.tg = { cover = true, open = false, fwd = false }
else
local cs = (BIND.pg[page] or 0) // 2
local tt, ts = page, cs + ((dx < 0) and 1 or -1)
if ts >= BIND.nspreads(page) then tt, ts = page + 1, 0
elseif ts < 0 then tt = page - 1; ts = (tt >= 0) and (BIND.nspreads(tt) - 1) or 0 end
if tt >= 0 and tt <= 6 then d.tg = { fwd = dx < 0, ft = page, fs = cs, tt = tt, ts = ts } end
end
end
if d.moved and d.tg then
d.tg.prog = math.max(0, math.min(1, (d.tg.fwd and -dx or dx) / (b[3] * 0.6)))
BIND.sdrag = d.tg
V3.moving = now + 600
end
return d.moved or false
end
if ev == "release" then
BIND.d = nil
local tg = d.tg
BIND.sdrag = nil
if d.moved and tg then
local s0 = d.smp[1]
for _, sm in ipairs(d.smp) do if now - sm[2] <= 100 then s0 = sm; break end end
local v = (x - s0[1]) / math.max(16, now - s0[2]) * (tg.fwd and -1 or 1)
local go_on = (tg.prog or 0) > 0.35 or v > 0.5
if tg.cover then
local p0 = tg.prog or 0
BIND.cturn = { u0 = tg.open and p0 or (1 - p0), u1 = ((go_on == tg.open) and 1 or 0), t = now }
else
tg.u0 = tg.prog or 0
tg.u1 = go_on and 1 or 0
tg.t = now
BIND.sturn = tg; SND.play("page", 0.55)
end
V3.moving = now + 900
end
return d.moved or false
end
return false
end
function BIND.touch(ev, x, y)
if scr ~= "album" or not BIND.on() then return false end
if BIND.mode ~= "zoom" then
if (BIND.mode == "spread" or BIND.mode == "closed") and BIND.sbox and not BIND.open_t and not BIND.cturn then return BIND.stouch(ev, x, y) end
return false
end
if not BIND.box then return false end
local b = BIND.box
local now = smudge.millis()
if ev == "down" then
if not BIND.turn and smudge.in_rect(x, y, b[1], b[2], b[3], b[4]) then BIND.d = { x0 = x, y0 = y, smp = { { x, now } } } end
return false
end
local d = BIND.d
if not d then return false end
if ev == "move" then
local dx = x - d.x0
d.smp[#d.smp + 1] = { x, now }; if #d.smp > 8 then table.remove(d.smp, 1) end
if not d.moved and math.abs(dx) > 12 then
d.moved = true
d.tg = BIND.target(dx < 0)
end
if d.moved and d.tg then
local prog = (d.tg.fwd and -dx or dx) / (b[3] * 0.9)
d.tg.prog = math.max(0, math.min(1, prog))
BIND.drag = d.tg
V3.moving = now + 600
end
return d.moved or false
end
if ev == "release" then
BIND.d = nil
local tg = d.tg
BIND.drag = nil
if d.moved and tg then
local s0 = d.smp[1]
for _, sm in ipairs(d.smp) do if now - sm[2] <= 100 then s0 = sm; break end end
local v = (x - s0[1]) / math.max(16, now - s0[2]) * (tg.fwd and -1 or 1)
tg.u0 = tg.prog or 0
tg.u1 = ((tg.prog or 0) > 0.35 or v > 0.5) and 1 or 0
tg.t = now
BIND.turn = tg; SND.play("page", 0.55)
V3.moving = now + 900
end
return d.moved or false
end
return false
end
function BIND.npages(t) return math.max(1, ((#(D.tier_cards[t] or {})) + 8) // 9) end
function BIND.cards(t, p)
if p < 0 or p >= BIND.npages(t) then return nil end
local list = D.tier_cards[t] or {}
local r = {} for i = 1, 9 do r[i] = list[p * 9 + i] end return r
end
function BIND.nspreads(t) return (BIND.npages(t) + 1) // 2 end
function BIND.draw(y0, y1, cellfn)
BIND.mode = BIND.mode or "spread"
if BIND.mode == "zoom" then return BIND.draw_zoom(y0, y1, cellfn) end
local now = smudge.millis()
local U = math.min((W - 16) / 600, (y1 - y0 - 50) / 370)
local pw, ph = math.floor(300 * U), math.floor(349 * U)
local sx, py = W // 2, y0 + math.max(0, (y1 - y0 - 50 - math.floor(370 * U)) // 2) + math.floor(11 * U)
local cy = py + ph / 2
BIND.sbox = { sx - pw, py, 2 * pw, ph }
local cs = (BIND.pg[page] or 0) // 2
local function cell(i, c, q, rest)
BIND.card(c, q, false)
if BIND.dim and BIND.dim(c) and smudge.glare_quad then smudge.glare_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], true) end
end
local function L(tier, sp) return BIND.cards(tier, 2 * (sp or 0)) end
local function R(tier, sp) return BIND.cards(tier, 2 * (sp or 0) + 1) end
local function leaf(a, cards) BIND.leaf(sx, cy, U, a, cards, cell) end
local oc = nil
if BIND.open_t then BIND.open_t = nil; BIND.cturn = { u0 = 0, u1 = 1, t = now } end
local sd = BIND.sdrag
if sd and sd.cover then
oc = sd.open and (sd.prog or 0) or (1 - (sd.prog or 0))
elseif BIND.cturn then
local ct = BIND.cturn
local k = math.min(1, (now - ct.t) / (150 + 700 * math.abs(ct.u1 - ct.u0)))
k = k * k * (3 - 2 * k)
oc = ct.u0 + (ct.u1 - ct.u0) * k
if k >= 1 then BIND.cturn = nil; BIND.mode = (ct.u1 >= 1) and "spread" or "closed"; oc = nil end
end
if BIND.mode == "closed" and not oc then
local cs = sx - 167 * U
local bx = math.floor(cs)
BIND.sbox = { bx, py, math.floor(335 * U), ph }
BIND.leaf(cs, cy, U, 0, nil, nil, DX.cover())
reg("BINDOPEN", bx, py, math.floor(335 * U), ph, function() BIND.cturn = { u0 = 0, u1 = 1, t = smudge.millis() }; V3.moving = smudge.millis() + 1200 end, true)
ctext(W / 2, py + ph + 14, "tap or swipe the binder to open it", "small")
return
end
if oc then
V3.moving = now + 300
local e = oc
local sxx = sx - 133 * U * (1 - e)
BIND.spine(sxx, cy, U)
BIND.leaf(sxx, cy, U, 0, R(page, cs), cell)
BIND.leaf(sxx - 34 * U, cy, U, e * math.pi, L(page, cs), cell, DX.cover())
return
end
local tr = (BIND.sdrag and not BIND.sdrag.cover and BIND.sdrag) or BIND.sturn
if tr then
local u
if tr == BIND.sdrag then u = tr.prog or 0
else
local k = math.min(1, (now - tr.t) / (120 + 420 * math.abs((tr.u1 or 1) - (tr.u0 or 0))))
k = 1 - (1 - k) * (1 - k)
u = (tr.u0 or 0) + ((tr.u1 or 1) - (tr.u0 or 0)) * k
if k >= 1 then
if (tr.u1 or 1) >= 1 then page = tr.tt; BIND.pg[tr.tt] = 2 * (tr.ts or 0) end
BIND.sturn = nil
end
end
V3.moving = now + 300
BIND.shine = u * 0.8
local nt, ns, ct, cs2 = tr.tt, tr.ts or 0, tr.ft, tr.fs or 0
BIND.spine(sx, cy, U)
if tr.fwd then
leaf(math.pi, L(ct, cs2)); leaf(0, R(nt, ns))
local a = u * math.pi
if a < math.pi / 2 then leaf(a, R(ct, cs2)) else leaf(a, L(nt, ns)) end
else
leaf(math.pi, L(nt, ns)); leaf(0, R(ct, cs2))
local a = (1 - u) * math.pi
if a < math.pi / 2 then leaf(a, R(nt, ns)) else leaf(a, L(ct, cs2)) end
end
else
BIND.spine(sx, cy, U)
leaf(math.pi, L(page, cs)); leaf(0, R(page, cs))
reg("BINDL", sx - pw, py, pw, ph, function() BIND.mode = "zoom"; BIND.pg[page] = 2 * cs end, true)
reg("BINDR", sx, py, pw, ph, function() if R(page, cs) then BIND.mode = "zoom"; BIND.pg[page] = 2 * cs + 1 end end, true)
end
ctext(W / 2, py + ph + 10, (page == 0 and cs == 0) and "tap a page to zoom in - swipe right to close" or "tap a page to zoom in", "small")
end
function BIND.draw_zoom(y0, y1, cellfn)
local now = smudge.millis()
local n = BIND.npages(page)
BIND.pages = n
local cur = math.min(BIND.pg[page] or 0, n - 1); BIND.pg[page] = cur
local U = math.min((W - 24) / 334, (y1 - y0 - 56) / 349)
local pw, ph = math.floor(334 * U), math.floor(349 * U)
local px, py = math.floor((W - pw) / 2), y0
local cy = py + ph / 2
BIND.box = { px, py, pw, ph }
local flatcell
local function SX(p) return (p % 2 == 0) and (px + 300 * U) or (px + 34 * U) end
local function nocell(i, c, q) flatcell(i, c, q, false) end
local function cards_of(p, tier) return BIND.cards(tier or page, p) end
local function E(p) return p - p % 2 end
flatcell = function(i, c, q, flat)
local L = BIND.card(c, q, false)
if BIND.dim and BIND.dim(c) and smudge.glare_quad then
smudge.glare_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], true)
end
if flat then
local x0, y0b = math.floor(q[1]), math.floor(q[2])
local w0, h0 = math.floor(q[3] - q[1]), math.floor(q[8] - q[2])
local nm = owned(c) and cname(c) or "???"
local lx, ly = L(0.5, 0.76)
ctext(lx, ly, fit(nm, w0 - 4, "small", "regular"), "small")
if GR and owned(c) then GR.badge(x0 - 2, y0b - 2, c) end
if owned(c) and S.spare[c] > 0 then
smudge.circle(x0 + w0 - 6, y0b + 8, 11, true)
ctext(x0 + w0 - 6, y0b + 8 - lh("small") // 2, S.spare[c] > 9 and "9+" or tostring(S.spare[c]), "small", "bold", true)
end
cellfn(c, x0, y0b, w0, h0)
end
end
local tr = BIND.drag or BIND.turn
if tr then
local u
if BIND.drag then u = tr.prog or 0
else
local u0, u1 = tr.u0 or 0, tr.u1 or 1
local k = math.min(1, (now - tr.t) / (120 + 420 * math.abs(u1 - u0)))
k = 1 - (1 - k) * (1 - k)
u = u0 + (u1 - u0) * k
if k >= 1 then u = u1 end
end
BIND.shine = u * 0.8
local fwd = tr.fwd
V3.moving = now + 300
local sx = SX(tr.fp) + (SX(tr.tp) - SX(tr.fp)) * u
local ef, et = E(tr.fp), E(tr.tp)
BIND.spine(sx, cy, U)
if tr.ft == tr.tt and ef == et then
BIND.leaf(sx, cy, U, math.pi, cards_of(ef, tr.ft), nocell); BIND.leaf(sx, cy, U, 0, cards_of(ef + 1, tr.ft), nocell)
elseif fwd then
BIND.leaf(sx, cy, U, math.pi, cards_of(ef, tr.ft), nocell); BIND.leaf(sx, cy, U, 0, cards_of(et + 1, tr.tt), nocell)
local a = u * math.pi
BIND.leaf(sx, cy, U, a, (a < math.pi / 2) and cards_of(ef + 1, tr.ft) or cards_of(et, tr.tt), nocell)
else
BIND.leaf(sx, cy, U, math.pi, cards_of(et, tr.tt), nocell); BIND.leaf(sx, cy, U, 0, cards_of(ef + 1, tr.ft), nocell)
local a = (1 - u) * math.pi
BIND.leaf(sx, cy, U, a, (a < math.pi / 2) and cards_of(et + 1, tr.tt) or cards_of(ef, tr.ft), nocell)
end
if not BIND.drag and (now - tr.t) >= (120 + 420 * math.abs((tr.u1 or 1) - (tr.u0 or 0))) then
if (tr.u1 or 1) >= 1 then page = tr.tt; BIND.pg[tr.tt] = tr.tp; cur = tr.tp; n = BIND.npages(page) end
BIND.turn = nil
end
else
local sx = SX(cur)
BIND.spine(sx, cy, U)
local e = E(cur)
BIND.leaf(sx, cy, U, math.pi, cards_of(e), (cur == e) and flatcell or nocell)
BIND.leaf(sx, cy, U, 0, cards_of(e + 1), (cur == e + 1) and flatcell or nocell)
end
if false then
V3.moving = now + 300
local u = math.min(1, (now - BIND.open_t) / 900)
u = u * u * (3 - 2 * u)
local ang = u * math.pi
local function P(uu, vv)
local x = uu * pw
local ca, sa = math.cos(ang), math.sin(ang)
local k = 700 / (700 - x * sa * 0.35)
return px + x * ca * k, py + ph / 2 + (vv - 0.5) * ph * k
end
local a1, b1 = P(0, 0); local a2, b2 = P(1, 0); local a3, b3 = P(1, 1); local a4, b4 = P(0, 1)
if ang < math.pi / 2 then
smudge.fill_quad(a1, b1, a2, b2, a3, b3, a4, b4, false, TT.panel)
smudge.draw_sprite_quad(DX.cover() .. ".raw", 192, 232, a1, b1, a2, b2, a3, b3, a4, b4)
end
if u >= 1 then BIND.open_t = nil end
end
local ty = py + ph + 6
local showk = cur
if tr and (tr.tt == page) then showk = ((BIND.drag and (tr.prog or 0) > 0.5) or (not BIND.drag and (tr.u1 or 1) >= 1)) and tr.tp or tr.fp end
for k = 0, n - 1 do
local dx2 = W // 2 - (n - 1) * 15 + k * 30
smudge.circle(dx2, ty + 9, (k == showk) and 8 or 6, k == showk, 2)
reg("BINDDOT" .. k, dx2 - 15, ty - 6, 30, 30, function()
if k == cur or BIND.turn then return end
BIND.turn = { ft = page, fp = cur, tt = page, tp = k, fwd = k > cur, u0 = 0, u1 = 1, t = smudge.millis() }; SND.play("page", 0.55)
V3.moving = smudge.millis() + 900
end, true)
end
if n > 1 then ltext(24, ty + 22, "hold a page and drag it over", "small") end
button(W - 24 - 130, ty + 4, 130, 40, "BOTH PAGES", function() BIND.mode = "spread"; BIND.turn = nil end, { font = "small", id = "BINDBOTH", nohelp = true })
end
SCREENS.album = function()
local pick = (album_mode == "pick")
local dmode = (album_mode == "deck")
local smode = (album_mode == "show")
top_bar(smode and ("Showcase slot " .. sslot) or (dmode and "Pick Deck Card" or (pick and "Pick a Fighter" or "Album")),
pick and ("Stage " .. S.stage) or string.format("%d/%d", found_count(), D.ncards))
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
if not BIND.on() then swipe_tabs(function() return page end, function(t) page = t end, 0, 6) end
for i = 0, 6 do
local n, tot = GRID.count(i)
button(6 + i * 67, TOP + 6, 63, 56, tabs[i + 1], function() if page == i then GRID.flip("album", i) end; page = i end,
{ font = "small", sub = n .. "/" .. tot, active = (page == i) })
end
local y0 = TOP + 80
local view = (album_mode == "view")
local function cell_act(c)
if pick then
return function() if owned(c) then start_battle(c) else note = "You do not own that card yet." end end
elseif smode then
return function()
if not owned(c) then note = "You do not own that card yet."; return end
SHOW[sslot] = c; save_show(); go("title")
end
elseif dmode then
return function()
if not owned(c) then note = "You do not own that card yet."; return end
for i = 1, 3 do if S.deck[i] == c and i ~= dslot then note = "That card is already in your deck."; return end end
if GR and GR.busy(c) then note = cname(c) .. " is away for grading."; return end
S.deck[dslot] = c; save_now(); go("deck")
end
end
return function() sel = c; go("detail") end
end
local bind = BIND.on()
local ctrl_h = view and 54 or (smode and 86 or 60)
local res_y = H - 96 - 36
local yb = bind and (res_y - 8 - ctrl_h) or (y0 + 2 * 164 + 4)
if bind then
BIND.dim = function(c) return view and not filt_ok(c) end
BIND.draw(y0, yb - 2, function(c, x, y, w, h) reg("card" .. c, x, y, w, h, cell_act(c), true) end)
else
GRID.draw("album", page, y0, 2, 164, function(c, x, y)
if view and not filt_ok(c) then
smudge.rounded_rect(x, y, 108, 108, 8, false, 1)
else
thumb(x, y, c, { name = true, pips = true, badge = true })
end
local act
if pick then
act = function()
if owned(c) then start_battle(c) else note = "You do not own that card yet." end
end
elseif smode then
act = function()
if not owned(c) then note = "You do not own that card yet."; return end
SHOW[sslot] = c; save_show(); go("title")
end
elseif dmode then
act = function()
if not owned(c) then note = "You do not own that card yet."; return end
for i = 1, 3 do if S.deck[i] == c and i ~= dslot then note = "That card is already in your deck."; return end end
if GR and GR.busy(c) then note = cname(c) .. " is away for grading."; return end
S.deck[dslot] = c; save_now(); go("deck")
end
else
act = function() sel = c; go("detail") end
end
reg("card" .. c, x, y, 108, 150, act, true)
end)
end
local y = yb
if bind then y = yb - 8 else smudge.line(24, y, W - 24, y, 1) end
if view then
local hw = (W - 48 - 8) // 2
button(24, y + 8, hw, 54, "FILTER: " .. filt_name(), function() filt = (filt + 1) % 13 end, { font = "ui10", id = "FILTER" })
local sn, sc = SELL_SPARES(true)
local sure = SELLSP_T and smudge.millis() - SELLSP_T < 4000
button(32 + hw, y + 8, hw, 54, sure and "SURE?" or "SELL SPARES", function()
if sn == 0 then note = "No spare copies to sell."; SELLSP_T = nil; return end
if not sure then SELLSP_T = smudge.millis(); return end
SELLSP_T = nil
local n, got = SELL_SPARES(false)
note = string.format("Sold %d spare%s for %s coins.", n, n == 1 and "" or "s", short(got))
end, { font = (sure or sn == 0) and "ui10" or "small", sub = sure and (sn .. " for " .. short(sc) .. " coins") or (sn > 0 and (sn .. " spares") or "none"), off = sn == 0, id = "SELLSPARES" })
elseif smode then
ctext(W / 2, y + 12, "Tap a card you own to show it off on Home.", "ui10")
local hw = (W - 48 - 8) // 2
button(24, y + 36, hw, 50, "BEST 4", function() show_best(); go("title") end, { font = "ui10", sub = "fill all slots", id = "SHOWBEST" })
button(32 + hw, y + 36, hw, 50, "RESET", function() SHOW = { 25, 28, 30, 32 }; save_show(); go("title") end, { font = "ui10", sub = "default cards", id = "SHOWRESET" })
elseif dmode then
ctext(W / 2, y + 12, "Tap an owned card for this deck slot.", "ui10")
else
ctext(W / 2, y + 12, "Tap a card you own to take into battle.", "ui10")
ctext(W / 2, y + 40, "Higher levels hit harder and last longer.", "small")
end
if bind then res_bar(res_y) elseif not smode then res_bar(y + 70) end
draw_note(y + 106)
button(24, H - 96, W - 48, 64, "BACK", function() go(dmode and "deck" or "title") end, { font = "ui10" })
end
function V3.ok() return CS_SMOOTH and smudge.draw_sprite_quad ~= nil and smudge.fill_quad ~= nil end
function V3.open(c) V3.c = c; V3.lbl = nil; V3.last = nil; V3.rx, V3.ry, V3.drag = 0.35, -0.5, nil; go("card3d") end
function V3.touch(ev, x, y, sx_v)
if ev == "down" then V3.drag = { x0 = x, y0 = y }; V3.spin = nil
elseif ev == "move" and V3.drag then
V3.ty = math.max(-0.6, math.min(0.6, -(x - V3.drag.x0) / 260))
V3.tx = math.max(-0.5, math.min(0.5, (y - V3.drag.y0) / 320))
V3.drag.moved = true
elseif ev == "release" then
local vx = tonumber(sx_v) or 0
local _ = vx
V3.drag = nil
end
end
function V3.mini_touch(ev, x, y)
local m = V3.mini
if not m or not m.box or type(x) ~= "number" then return false end
local bx = m.box
if ev == "down" then
if smudge.in_rect(x, y, bx[1], bx[2], bx[3], bx[4]) then m.drag = { x0 = x, y0 = y }; return true end
m.drag = nil; return false
end
if not m.drag then return false end
if ev == "move" then
local dx, dy = x - m.drag.x0, y - m.drag.y0
if m.drag.moved or dx * dx + dy * dy > 64 then
m.drag.moved = true
m.ty = math.max(-0.55, math.min(0.55, -dx / 200))
m.tx = math.max(-0.45, math.min(0.45, dy / 240))
end
return true
end
if ev == "release" then local moved = m.drag.moved; m.drag = nil; return moved and true or false end
m.drag = nil
return false
end
V3.T = {}
function V3.tilt_get(id, x, y, w, h, amp)
local t = V3.T[id]
if not t then t = { rx = 0, ry = 0, tx = 0, ty = 0 }; V3.T[id] = t end
t.box = { x, y, w, h }; t.scr = scr; V3.T.cur = t
local now = smudge.millis()
local held = t.drag and t.drag.moved
local gx, gy = t.tx, t.ty
if not held then gx = 0.05 * amp * math.sin(now / 2100 + 1); gy = 0.12 * amp * math.sin(now / 1700) end
local dt = math.min(100, now - (t.last or now)); t.last = now
local k = 1 - math.exp(-dt / (held and 60 or 140))
t.rx = t.rx + (gx - t.rx) * k; t.ry = t.ry + (gy - t.ry) * k
return t.rx, t.ry
end
function V3.tilt_touch(ev, x, y)
local t = V3.T.cur
if not t or t.scr ~= scr or not t.box or type(x) ~= "number" then return false end
local bx = t.box
if ev == "down" then
if smudge.in_rect(x, y, bx[1], bx[2], bx[3], bx[4]) then t.drag = { x0 = x, y0 = y }; return true end
t.drag = nil; return false
end
if not t.drag then return false end
if ev == "move" then
t.drag.moved = true
t.ty = math.max(-0.24, math.min(0.24, -(x - t.drag.x0) / 380))
t.tx = math.max(-0.16, math.min(0.16, (y - t.drag.y0) / 480))
return true
end
if ev == "release" then local moved = t.drag.moved; t.drag = nil; return moved and true or false end
t.drag = nil
return false
end
for _, n in ipairs({ "touch", "mini_touch", "tilt_touch" }) do
local f = V3[n]
V3[n] = function(ev, ...)
local r = f(ev, ...)
if ev == "move" or ev == "release" or ev == "down" then V3.moving = smudge.millis() + 1600 end
return r
end
end
function V3.render(o) CT.base(true); V3.render_(o); CT.base(false) end
function V3.render_(o)
local c, cx, cy, CW, CH, FOC = o.c, o.cx, o.cy, o.CW, o.CH, 900
local dp = o.depth or 1
local cr, sr, cxr, sxr = math.cos(o.ry), math.sin(o.ry), math.cos(o.rx), math.sin(o.rx)
local SC = o.scale or 1
local function P(x, y, z)
x, y, z = x * SC, y * SC, z * dp * SC
if o.proj then return o.proj(x, y, z) end
local x1, z1 = x * cr + z * sr, -x * sr + z * cr
local y2, z2 = y * cxr - z1 * sxr, y * sxr + z1 * cxr
local k = FOC / (FOC + z2)
return cx + x1 * k, cy + y2 * k
end
local function Q(x0, y0, x1, y1, z)
local a, b = P(x0, y0, z); local c2, d = P(x1, y0, z); local e, f = P(x1, y1, z); local g, h = P(x0, y1, z)
return a, b, c2, d, e, f, g, h
end
local hw, hh = CW / 2, CH / 2
local MG = tier_of(c) == 5 and anim_v > 0 and not SAVER
local GL = { a = "4", e = "3", i = "!", o = "0", s = "5", t = "7", l = "1", A = "4", E = "3", I = "!", O = "0", S = "5", T = "7",
["0"] = "O", ["1"] = "I", ["2"] = "Z", ["3"] = "E", ["4"] = "A", ["5"] = "S", ["6"] = "b", ["7"] = "T", ["8"] = "B", ["9"] = "g" }
local function corrupt(txt)
if not MG or not txt then return txt end
local out, i = {}, 0
for ch in txt:gmatch(".") do
i = i + 1
out[i] = ((i * 7 + anim_v * 3) % 4 == 0 and GL[ch]) or ch
end
return table.concat(out)
end
local function tquad(key, w, h, x0, y0, x1, y1, z)
