if FX >= 2 then
for k = 0, 3 do
local sx2, sy2 = (k == 1 or k == 2) and 1 or -1, (k >= 2) and 1 or -1
local x, y = sx2 * (hw + e), sy2 * (hh + e)
local ln = 22
L3(x, y, x - sx2 * ln, y, fzz - 3, 4); L3(x, y, x, y - sy2 * ln, fzz - 3, 4)
local d = 6
local qx, qy = x + sx2 * 5, y + sy2 * 5
L3(qx - d, qy, qx, qy - d, fzz - 4, 2); L3(qx, qy - d, qx + d, qy, fzz - 4, 2)
L3(qx + d, qy, qx, qy + d, fzz - 4, 2); L3(qx, qy + d, qx - d, qy, fzz - 4, 2)
end
end
if FX >= 3 and smudge.glare_quad then
local per = 3200
local ph = (now % per) / per
if ph < 0.45 and FX ~= 6 then
local aw = ax1 - ax0
local top0 = ax0 - aw * 0.6 + (ph / 0.45) * aw * 2.1
local function cl(v) return math.max(ax0, math.min(ax1, v)) end
local sk, wd = aw * 0.45, aw * 0.22
local x0, y0 = P(cl(top0), ay0, -1); local x1, y1 = P(cl(top0 + wd), ay0, -1)
local x2, y2 = P(cl(top0 + wd - sk), ay1, -1); local x3, y3 = P(cl(top0 - sk), ay1, -1)
smudge.glare_quad(x0, y0, x1, y1, x2, y2, x3, y3, true)
end
for k = 0, 3 do
local tw2 = math.sin(now / 300 + k * 1.6)
if tw2 > 0.2 then
local sx2, sy2 = (k == 1 or k == 2) and 1 or -1, (k >= 2) and 1 or -1
local px, py = P(sx2 * (hw + 9), sy2 * (hh + 9), fzz - 5)
sparkle(math.floor(px), math.floor(py), math.floor((6 + 9 * tw2) * SC))
end
end
end
if FX == 6 then
local e2 = 9
L3(-hw - e2, -hh - e2, hw + e2, -hh - e2, fzz - 2, 1); L3(hw + e2, -hh - e2, hw + e2, hh + e2, fzz - 2, 1)
L3(hw + e2, hh + e2, -hw - e2, hh + e2, fzz - 2, 1); L3(-hw - e2, hh + e2, -hw - e2, -hh - e2, fzz - 2, 1)
if not case and o.label then
local cy0, cw2 = -hh - 6, 22
local cz = fzz - 6
L3(-cw2, cy0, cw2, cy0, cz, 3)
L3(-cw2, cy0, -cw2 - 4, cy0 - 20, cz, 2); L3(-cw2 - 4, cy0 - 20, -cw2 / 2, cy0 - 9, cz, 2)
L3(-cw2 / 2, cy0 - 9, 0, cy0 - 26, cz, 2); L3(0, cy0 - 26, cw2 / 2, cy0 - 9, cz, 2)
L3(cw2 / 2, cy0 - 9, cw2 + 4, cy0 - 20, cz, 2); L3(cw2 + 4, cy0 - 20, cw2, cy0, cz, 2)
local gx, gy = P(0, cy0 - 30, cz)
sparkle(math.floor(gx), math.floor(gy), math.floor((7 + 4 * math.sin(now / 260)) * SC))
end
if smudge.glare_quad then
local per = 2600
for b2 = 0, 1 do
local ph = ((now + b2 * per / 2) % per) / per
local top0 = -hw - CW * 0.5 + ph * CW * 2.0
local function cl(v) return math.max(-hw, math.min(hw, v)) end
local sk, wd = CW * 0.5, CW * (b2 == 0 and 0.09 or 0.05)
local x0, y0 = P(cl(top0), -hh, -1); local x1, y1 = P(cl(top0 + wd), -hh, -1)
local x2, y2 = P(cl(top0 + wd - sk), hh, -1); local x3, y3 = P(cl(top0 - sk), hh, -1)
smudge.glare_quad(x0, y0, x1, y1, x2, y2, x3, y3, false)
if smudge.tint_quad and not SAVER then smudge.tint_quad(x0, y0, x1, y1, x2, y2, x3, y3, (b2 == 0) and 7 or 5, 3) end
end
end
for i = 0, 7 do
local ph = ((now / 2800) + i / 8) % 1
local side = (i % 2 == 0) and -1 or 1
local x = side * (hw + 14 + ((i * 37) % 3) * 6)
local y = hh + 10 - ph * (CH + 20)
local px, py = P(x, y, fzz - 4)
local r = math.floor((3 + 7 * math.sin(ph * math.pi)) * SC)
if r >= 2 then
sparkle(math.floor(px), math.floor(py), r)
if smudge.tint_quad and not SAVER then
local col = (i % 2 == 0) and 7 or 5
smudge.tint_quad(px, py - r - 2, px + r * 0.7 + 2, py, px, py + r + 2, px - r * 0.7 - 2, py, col, 1)
end
end
end
if smudge.glass_sprite_quad and not SAVER then
local gx0, gy0, gx1, gy1, gz, cut = -hw, -hh, hw, hh, 0, 0
if case then gx0, gy0, gx1, gy1, gz, cut = kx0, ky0, kx1, ky1, fz, CH8 end
local poly = (cut > 0) and { { gx0 + cut, gy0 }, { gx1 - cut, gy0 }, { gx1, gy0 + cut }, { gx1, gy1 - cut },
{ gx1 - cut, gy1 }, { gx0 + cut, gy1 }, { gx0, gy1 - cut }, { gx0, gy0 + cut } }
or { { gx0, gy0 }, { gx1, gy0 }, { gx1, gy1 }, { gx0, gy1 } }
local n = #poly
local nrm = {}
for i = 1, n do
local p0, p1 = poly[i], poly[i % n + 1]
local ex, ey = p1[1] - p0[1], p1[2] - p0[2]
local l = math.sqrt(ex * ex + ey * ey)
nrm[i] = { ey / l, -ex / l }
end
local function off(i, d, ox, oy)
local n1, n2 = nrm[(i - 2) % n + 1], nrm[i]
local mx, my = n1[1] + n2[1], n1[2] + n2[2]
local ml = math.sqrt(mx * mx + my * my)
mx, my = mx / ml, my / ml
local k = d / math.max(0.5, mx * n2[1] + my * n2[2])
return P(poly[i][1] + mx * k + (ox or 0), poly[i][2] + my * k + (oy or 0), gz)
end
local gk = math.max(0.35, CW / 270)
local function band(d0, d1, r, g, b2, a, sides, ox, oy)
d0, d1 = d0 * gk, d1 * gk
for i = 1, n do
if not sides or sides[i] then
local j = i % n + 1
local a1, b1 = off(i, d0, ox, oy); local a2, b3 = off(j, d0, ox, oy)
local a3, b4 = off(j, d1, ox, oy); local a4, b5 = off(i, d1, ox, oy)
smudge.glass_sprite_quad("art/one_m.raw", 8, 8, a1, b1, a2, b3, a3, b4, a4, b5, r, g, b2, a)
end
end
end
gseed(now // 60 + c * 13)
local roll = grand(100)
local lit = 1
if roll < 6 then lit = 0.12 elseif roll < 14 then lit = 0.55 end
local sides = nil
if grand(100) < 10 then sides = {}; local dark = grand(n) + 1; for i = 1, n do sides[i] = (i ~= dark) end end
local hum = 0.92 + 0.08 * math.sin(now / 37)
local L = lit * hum
band(-1, 2, 255, 200, 250, 0.95 * L, sides)
for k = 0, 9 do
local u = k / 9
local d0, d1 = 2 + 36 * u ^ 1.4, 2 + 36 * ((k + 1) / 9.5) ^ 1.4
band(d0, d1, math.floor(255 - 105 * u), math.floor(70 - 20 * u), math.floor(220 + 35 * u), 0.5 * L * (1 - u) ^ 1.6 + 0.02 * L, sides)
end
local gp = now % 3700
if gp < 150 then
gseed(now // 3700 + c * 7)
local dx1, dy1 = -(8 + grand(8)), -(3 + grand(6))
local dx2, dy2 = 8 + grand(8), 3 + grand(6)
band(-1, 2, 170, 60, 255, 0.95, nil, dx1, dy1)
band(-1, 2, 0, 230, 255, 0.95, nil, dx2, dy2)
local xa, ya = P(-hw, -hh, 0); local xb, yb = P(hw, hh, 0)
local sx0, sx1 = math.floor(math.min(xa, xb)), math.floor(math.max(xa, xb))
local sy0, sy1 = math.min(ya, yb), math.max(ya, yb)
for _ = 1, 2 do
local yy = math.floor(sy0 + (sy1 - sy0) * (0.1 + grand(80) / 100))
smudge.invert_rect(sx0, yy, sx1 - sx0, 3 + grand(5))
end
end
V3.moving = math.max(V3.moving or 0, smudge.millis() + 100)
end
end
elseif FX == 5 then
gseed(math.floor(now / 140) * 11 + c)
local e = 5
for side = 0, 3 do
local off = grand(7) - 3
local gap, glen = 0.1 + grand(60) / 100, 0.06 + grand(14) / 100
local function seg(t0, t1)
local function pt(t2)
if side == 0 then return -hw - e + t2 * (CW + 2 * e), -hh - e + off
elseif side == 1 then return hw + e + off, -hh - e + t2 * (CH + 2 * e)
elseif side == 2 then return hw + e - t2 * (CW + 2 * e), hh + e + off
else return -hw - e + off, hh + e - t2 * (CH + 2 * e) end
end
local x0, y0 = pt(t0); local x1, y1 = pt(t1)
L3(x0, y0, x1, y1, -7, 3)
end
seg(0, gap); seg(math.min(1, gap + glen), 1)
end
if anim_v > 0 then
for z2 = 0, 3 do
if grand(10) < 6 then
local yy = ay0 + (ay1 - ay0) * (z2 + grand(100) / 100) / 4
local hh2 = 3 + grand(7)
local sh = (grand(41) - 20)
local q = { Q(math.max(ax0, ax0 + sh), yy, math.min(ax1, ax1 + sh), yy + hh2, -2) }
smudge.fill_quad(q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], grand(2) == 0, tk)
end
end
end
end
if case then
local g = GR.grade(c)
local function L(x0, y0, x1, y1, z, t)
local a, b2 = P(x0, y0, z); local c2, d = P(x1, y1, z)
smudge.line(math.floor(a + 0.5), math.floor(b2 + 0.5), math.floor(c2 + 0.5), math.floor(d + 0.5), t or 1)
end
local function rrect(x0, y0, x1, y1, z, ch, t)
local pts = { x0 + ch, y0, x1 - ch, y0, x1, y0 + ch, x1, y1 - ch, x1 - ch, y1, x0 + ch, y1, x0, y1 - ch, x0, y0 + ch }
for m = 0, 7 do local n = (m + 1) % 8; L(pts[m * 2 + 1], pts[m * 2 + 2], pts[n * 2 + 1], pts[n * 2 + 2], z, t) end
end
local function box(x0, y0, x1, y1, z, t) rrect(x0, y0, x1, y1, z, 0, t) end
box(-hw - 6, -hh - 6, hw + 6, hh + 6, 3, 1)
rrect(-hw - 6, -hh - 6, hw + 6, hh + 6, fz, 3, 1)
local lx0, ly0, lx1, ly1 = kx0 + 8, ky0 + 8, kx1 - 8, -hh - 14
local lq = { Q(lx0, ly0, lx1, ly1, fz) }
smudge.fill_quad(lq[1], lq[2], lq[3], lq[4], lq[5], lq[6], lq[7], lq[8], false, tk)
box(lx0, ly0, lx1, ly1, fz, 2)
box(lx0 + 3, ly0 + 3, lx1 - 3, ly1 - 3, fz, 1)
local gx0, gy0, gx1, gy1 = lx0 + 8, ly0 + 7, lx0 + 60, ly1 - 7
local gq = { Q(gx0, gy0, gx1, gy1, fz) }
smudge.fill_quad(gq[1], gq[2], gq[3], gq[4], gq[5], gq[6], gq[7], gq[8], true, tk)
local bx0, bx1 = lx1 - 54, lx1 - 8
local seed = c * 131 + g * 17
local x = bx0
while x < bx1 do
seed = (seed * 1103 + 12345) % 65536
local wdt = 1 + seed % 3
if (seed // 8) % 3 ~= 0 then for xx = x, math.min(bx1, x + wdt - 1) do L(xx, ly0 + 8, xx, ly0 + 38, fz, 1) end end
x = x + wdt + 1
end
local hq = { Q(bx0, ly0 + 44, bx1, ly1 - 7, fz) }
smudge.fill_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], true, tk)
if smudge.glare_quad then smudge.glare_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], (math.floor(o.ry * 20) % 2) == 0) end
box(bx0, ly0 + 44, bx1, ly1 - 7, fz, 1)
if smudge.text_sprite then
local key = c * 100 + g + (MG and anim_v * 100000 or 0)
if V3.glbl ~= key then
local cert = string.format("CERT %04d %03d%02d", 7300 + c * 37 % 2700, c, g * 7 % 100)
local gn = tostring(g)
if MG and anim_v >= 3 then gn = ({ "?", GL[gn:sub(1, 1)] or "#", "#" })[anim_v - 2] end
smudge.text_sprite("lblgnum", 48, 40, gn, "bitter14", nil, nil)
smudge.text_sprite("lblg1", 144, 46, corrupt(fit(cname(c), 142, "ui10", "bold")), "ui10", corrupt(GR.word(g)), "small")
smudge.text_sprite("lblg2", 144, 20, corrupt(cert), "small", nil, nil)
V3.glbl = key
end
local nq = { Q(gx0 + 4, gy0 + 4, gx1 - 4, gy1 - 4, fz) }
smudge.fill_quad(nq[1], nq[2], nq[3], nq[4], nq[5], nq[6], nq[7], nq[8], false, tk)
local gcx, gcy = (gx0 + gx1) / 2, (gy0 + gy1) / 2
local sq = { Q(gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz) }
tquad("lblgnum", 48, 40, gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz)
local mx0, mx1 = gx1 + 6, bx0 - 6
tquad("lblg1", 144, 46, mx0, ly0 + 4, mx1, ly0 + 4 + 46 * (mx1 - mx0) / 144, fz)
tquad("lblg2", 144, 20, mx0, ly1 - 4 - 20 * (mx1 - mx0) / 144, mx1, ly1 - 4, fz)
end
box(gx0, gy0, gx1, gy1, fz, 2)
rrect(kx0, ky0, kx1, ky1, fz, CH8, 3)
rrect(kx0 + 4, ky0 + 4, kx1 - 4, ky1 - 4, fz, 6, 1)
L(kx0 + 4, ly1 + 6, kx1 - 4, ly1 + 6, fz, 1)
for yy = -hh + 30, hh - 30, 12 do
L(kx0 + 1, yy, kx0 + 4, yy, fz, 1); L(kx1 - 4, yy, kx1 - 1, yy, fz, 1)
end
if smudge.glare_quad then
local p = 0.5 + o.ry * 1.4 - o.rx * 1.0
local cw2 = kx1 - kx0
local t0 = kx0 - cw2 * 0.5 + p * cw2 * 1.6
local function cl(v) return math.max(kx0 + 4, math.min(kx1 - 4, v)) end
local gy = ly1 + 8
local x0, y0 = P(cl(t0), gy, fz); local x1, y1 = P(cl(t0 + 22), gy, fz)
local x2, y2 = P(cl(t0 + 22 - cw2 * 0.5), ky1 - 4, fz); local x3, y3 = P(cl(t0 - cw2 * 0.5), ky1 - 4, fz)
smudge.glare_quad(x0, y0, x1, y1, x2, y2, x3, y3, false)
end
end
end
SCREENS.card3d = function()
local c = V3.c
local now = smudge.millis()
top_bar(cname(c), D.tiers[tier_of(c) + 1])
local gx, gy = V3.tx, V3.ty
local held = V3.drag and V3.drag.moved
if not held then gx = 0.12 * math.sin(now / 1700 + 1); gy = 0.24 * math.sin(now / 1300) end
local dt = math.min(100, now - (V3.last or now)); V3.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
V3.rx = V3.rx + (gx - V3.rx) * k
if V3.spin and not held then
local sp = V3.spin
if math.abs(sp.v) > 0.0022 then
sp.a = sp.a + sp.v * dt; sp.v = sp.v * math.exp(-dt / 900)
else
local tgt = math.floor(sp.a / (2 * math.pi) + 0.5) * 2 * math.pi
sp.a = sp.a + (tgt - sp.a) * (1 - math.exp(-dt / 160))
if math.abs(tgt - sp.a) < 0.01 then V3.ry = sp.a - tgt; V3.spin = nil end
end
if V3.spin then V3.ry = sp.a; V3.moving = now + 1600 end
else
V3.spin = nil
V3.ry = V3.ry + (gy - V3.ry) * k
end
if tier_of(c) == 5 and not SAVER then
local g = math.floor(now / 140)
if g ~= V3.gl then V3.gl = g; gseed(g * 3 + 9); anim_v = (math.floor(now) % 2200 < 520) and grand(5) or 0 end
end
local graded = GR and GR.grade(c) > 0
local CW, CH = graded and 250 or 270, graded and 344 or 370
local bw, bh = graded and CW + 28 or CW, graded and CH + 110 or CH
local y0, y1 = TOP + 10, H - 150
local sc = math.min((W - 60) / bw, (y1 - y0) / bh) * (graded and 0.87 or 0.92)
local cy = (y0 + y1) / 2 + (graded and 41 * sc or 0)
local ry = math.atan(math.sin(V3.ry), math.cos(V3.ry))
local back = math.cos(ry) < 0
if back then ry = math.atan(math.sin(ry + math.pi), math.cos(ry + math.pi)) end
V3.render({ c = c, cx = W // 2, cy = cy, CW = CW, CH = CH, scale = sc, back = back,
rx = V3.rx, ry = ry, inset = 22, label = true, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
ctext(W / 2, H - 132, "Drag to tilt the card - tap to close", "small")
reg("CLOSE3D", 0, TOP, W, H - TOP, function() go("detail") end, false)
end
SCREENS.detail = function()
local c = sel
local own = owned(c)
top_bar(own and cname(c) or "Undiscovered card", own and ("LV " .. S.lvl[c]) or "")
res_bar(TOP + 2)
local ax, ay = 24, TOP + 40
if own and V3.ok() and not SAVER then
local now = smudge.millis()
local m = V3.mini
if not m or m.c ~= c then m = { c = c, rx = 0, ry = 0, tx = 0, ty = 0 }; V3.mini = m end
m.box = { ax, ay, 208, 208 }
local held = m.drag and m.drag.moved
local gx, gy = m.tx, m.ty
if not held then gx = 0.08 * math.sin(now / 1700 + 1); gy = 0.16 * math.sin(now / 1300) end
local dt = math.min(100, now - (m.last or now)); m.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
m.rx = m.rx + (gx - m.rx) * k; m.ry = m.ry + (gy - m.ry) * k
V3.render({ c = c, cx = ax + 104, cy = ay + 104, CW = 208, CH = 208, inset = 8, depth = 0.6,
rx = m.rx, ry = m.ry, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
else
bigcard(ax, ay, c, own)
if own and S.shiny[c] == 1 then glass(ax + 8, ay + 8, 192) end
end
if own and GR then GR.badge(ax + 4, ay + 4, c, true) end
if own and not V3.ok() then EVO.badge(ax + 11, ay + 197, c, true) end
if EVO.fx and EVO.fx.c == c and not SAVER then
local k = (smudge.millis() - EVO.fx.t) / 1100
if k < 1 then
for r = 0, 2 do
local q = k * 1.6 - r * 0.25
if q > 0 and q < 1 then
local g = math.floor(4 + q * 30)
smudge.rounded_rect(ax - g, ay - g, 208 + 2 * g, 208 + 2 * g, 14 + g // 3, false, math.max(1, math.floor(4 * (1 - q))))
end
end
if k < 0.18 and smudge.glare_quad then smudge.glare_quad(ax + 8, ay + 8, ax + 200, ay + 8, ax + 200, ay + 200, ax + 8, ay + 200, false) end
local ty = ay + 90 - math.floor(k * 30)
local tw2 = tw("EVOLVED!", "ui12", "bold") + 24
smudge.rounded_rect(ax + 104 - tw2 // 2, ty - 4, tw2, lh("ui12") + 8, 10, true)
ctext(ax + 104, ty, "EVOLVED!", "ui12", "bold", true)
V3.moving = smudge.millis() + 200
else EVO.fx = nil end
end
if own and V3.ok() then reg("CARD3D", ax, ay, 208, 208, function() V3.open(c) end, false) end
if own and not SAVER and tier_of(c) >= 1 and not V3.ok() then card_aura(ax, ay, anim_t, tier_of(c)) end
local t, e = tier_of(c), elem_of(c)
local x, w = 250, 206
local gtxt = (own and GR and GR.grade(c) > 0) and ("  G" .. GR.grade(c) .. " +" .. GR.atk(c)) or ""
ltext(x, ay + 2, fit(D.tiers[t + 1] .. ((own and S.shiny[c] == 1) and "  SHINY" or "") .. gtxt, w, "ui10", "bold"), "ui10", "bold")
tint(x, ay + 2, tw(D.tiers[t + 1], "ui10", "bold") + 1, lh("ui10") - 2, t, "ink")
chip(x + 16, ay + 38, e)
ltext(x + 40, ay + 28, D.elems[e], "ui12", "bold")
smudge.line(x, ay + 62, x + w, ay + 62, 1)
if own then
local a, h = card_stats(c)
local as = C.asc(c)
ltext(x, ay + 70, fit(string.format("Level %d / %d", S.lvl[c], D.max_level) .. ((as > 0) and ("  " .. string.rep("*", as)) or "")
.. ((EVO.n(c) > 0) and ("  EVO " .. EVO.n(c)) or "") .. ((DX.m(c) > 0) and ("  M" .. DX.m(c)) or ""), w, "ui10", "bold"), "ui10", "bold")
if S.lvl[c] >= D.max_level then
if as < 5 then
local du, sp, sc = C.asc_cost(c)
button(x, ay + 94, w, 46, "ASCEND " .. (as + 1) .. "/5", function() C.ascend(S, c) end,
{ font = "small", sub = string.format("%d dust %d spare %d scale", du, sp, sc), id = "ASCEND" })
else ltext(x, ay + 110, "FULLY ASCENDED", "small", "bold") end
else
local frac = S.xp[c] / D.xp_need[S.lvl[c]]
bar(x, ay + 98, w, 18, frac)
ltext(x, ay + 120, string.format("%d / %d xp", S.xp[c], D.xp_need[S.lvl[c]]), "small")
end
icon_sword(x + 12, ay + 160); ltext(x + 34, ay + 148, "ATK  " .. a, "ui12", "bold")
icon_heart(x + 12, ay + 192); ltext(x + 34, ay + 178, "HP   " .. h, "ui12", "bold")
else
ltext(x, ay + 72, "Not found yet.", "ui10", "bold")
wrapped(x, ay + 100, (tier_of(c) == 6) and "A secret. It can only drop from a pack." or "Find it in a pack or craft it with dust.", w, "small", 4)
end
local y = ay + 222
ltext(24, y, "Strong vs " .. D.elems[D.beats[e]], "ui10")
rtext(W - 24, y, "Weak to " .. D.elems[D.weak[e]], "ui10")
local ly = y + 30
if own then
if t == 4 then ly = wrapped(24, ly, D.ability[e], W - 48, "ui10", 3)
else ly = wrapped(24, ly, D.lore[c], W - 48, "ui10", 3) end
end
local sy = ay + 222 + 30 + 84
if CS_SMOOTH then sy = math.max(sy, H - 96 - 10 - 176) end
if own then
local ry = CS_SMOOTH and (sy - 66) or (sy + 176)
local hw = (W - 48 - 10) // 2
local tt2 = tier_of(c) + 1
if S.shiny[c] == 1 then
button(24, ry, hw, 56, "SHINY", function() note = "This card is already shiny." end, { font = "small", sub = "already shiny", off = true, id = "MKSHINY" })
else
local sc2 = DX.SHINY[tt2]
button(24, ry, hw, 56, "MAKE SHINY", function()
if S.dust < sc2 then note = string.format("Making it shiny costs %d dust (you have %d).", sc2, S.dust); return end
S.dust = S.dust - sc2; S.shiny[c] = 1; save_now()
note = cname(c) .. " is shiny now! (+1 ATK, +2 HP)"; aura_start()
end, { font = "small", sub = sc2 .. " dust", off = S.dust < sc2, id = "MKSHINY" })
end
local mc = DX.mcost(c)
local maxed = S.lvl[c] >= D.max_level
button(34 + hw, ry, hw, 56, "MASTERY " .. (DX.m(c) + 1), function()
if not maxed then note = "Mastery starts once a card is level " .. D.max_level .. "."; return end
if DX.m(c) >= 99 then note = "Mastery 99: the very top."; return end
if S.dust < mc then note = string.format("The next mastery star costs %d dust (you have %d).", mc, S.dust); return end
S.dust = S.dust - mc; DX.mast[c] = DX.m(c) + 1; DX.save(); save_now()
note = string.format("%s: mastery %d! (+1 ATK, +2 HP)", cname(c), DX.m(c))
end, { font = "small", sub = maxed and (mc .. " dust, +1 ATK +2 HP") or ("at level " .. D.max_level), off = (not maxed) or S.dust < mc, id = "MASTERY" })
end
smudge.line(24, sy, W - 24, sy, 2)
if own then
ltext(24, sy + 12, "Spares: " .. S.spare[c], "ui12", "bold")
if S.spare[c] > 0 and CHAT_READY() then
local ask = GIFTC and GIFTC[1] == c and smudge.millis() - GIFTC[2] < 4000
button(W - 24 - 150 - 118, sy + 4, 108, 52, ask and "SURE?" or "GIFT", function() CHAT_GIFT(c) end,
{ font = "ui10", sub = ask and "tap again" or "in the chat", active = ask, id = "GIFTCARD" })
elseif S.spare[c] > 0 then
button(W - 24 - 150 - 118, sy + 4, 108, 52, F.card_asking(c) and "SURE?" or "GIFT", function() F.gift_card_tap(c) end,
{ font = "ui10", sub = "1 copy", active = F.card_asking(c), id = "GIFTCARD" })
end
button(W - 24 - 150, sy + 4, 150, 52, all_mode and "ALL" or "ONE", function() all_mode = not all_mode end,
{ font = "ui10", sub = "copies per tap" })
local n = all_mode and S.spare[c] or math.min(1, S.spare[c])
local tt = tier_of(c) + 1
if S.spare[c] > 0 then
button(24, sy + 70, 138, 96, "SELL", function() spare_action("sell") end,
{ sub = string.format("+%d coins", D.sell_value[tt] * n) })
local maxed = S.lvl[c] >= D.max_level
if maxed and t < 6 then
local done = EVO.n(c) >= EVO.MAX
local ec = EVO.cost(c)
button(171, sy + 70, 138, 96, done and "EVOLVED" or ("EVOLVE " .. (EVO.n(c) + 1) .. "/" .. EVO.MAX), function() evolve(c) end,
{ font = done and "ui10" or "small", sub = done and "fully" or string.format("3 + %d dust", ec), off = done or S.spare[c] < 3 or S.dust < ec, id = "EVOLVE" })
else
button(171, sy + 70, 138, 96, "MERGE", function() spare_action("merge") end,
{ sub = maxed and "max level" or string.format("+%d xp", D.xp_value[tt] * n), off = maxed })
end
button(318, sy + 70, 138, 96, "DUST", function() spare_action("dust") end,
{ sub = string.format("+%d dust", D.dust_value[tt] * n) })
else
ctext(W / 2, sy + 84, "No spares. Duplicates from packs land here.", "small")
end
elseif tier_of(c) == 6 then
ctext(W / 2, sy + 20, "SECRET CARD - cannot be crafted", "ui10", "bold")
ctext(W / 2, sy + 56, "Any secret: 1 in 10,000,000 per pulled card", "small")
else
local cost = D.craft_cost[t + 1]
ltext(24, sy + 12, string.format("Craft cost: %d dust  (you have %d)", cost, S.dust), "ui10", "bold")
button(24, sy + 70, W - 48, 96, "CRAFT", function() craft_card(c) end,
{ sub = string.format("%d dust", cost), off = S.dust < cost })
end
draw_note(H - 134)
if own and CHAT_READY() then
local bw4 = (W - 48 - 24) // 4
button(24, H - 96, bw4, 64, "PREV", function() sel = D.step(sel, -1); note = ""; anim_t = 0 end, { font = "ui10" })
button(32 + bw4, H - 96, bw4, 64, "BACK", function() go("album") end, { font = "ui10" })
button(40 + 2 * bw4, H - 96, bw4, 64, "SHOW", function()
smudge.pet_chat_card("card", c, cname(c), CHAT_CARD_LINE(c)); note = cname(c) .. " is in the chat now."
end, { font = "ui10", sub = "in the chat", id = "SHOWCHAT" })
button(48 + 3 * bw4, H - 96, bw4, 64, "NEXT", function() sel = D.step(sel, 1); note = ""; anim_t = 0 end, { font = "ui10" })
else
button(24, H - 96, 120, 64, "PREV", function() sel = D.step(sel, -1); note = ""; anim_t = 0 end, { font = "ui10" })
button(156, H - 96, 168, 64, "BACK", function() go("album") end, { font = "ui10" })
button(336, H - 96, 120, 64, "NEXT", function() sel = D.step(sel, 1); note = ""; anim_t = 0 end, { font = "ui10" })
end
end
local function info_line(e)
return "Weak to " .. D.elems[D.weak[e]] .. "   -   Strong vs " .. D.elems[D.beats[e]]
end
SCREENS.quest = function()
local e = PE
top_bar(e.duel and F.duel_title() or e.wb and ("WORLD BOSS - " .. e.name) or e.lair and ("BOSS - " .. e.name) or (e.wild and ("Wilderness lvl " .. e.wild * 10)) or (e.tower and ((e.boss and "BOSS - " or "Tower - ") .. "Floor " .. e.tower) or (e.boss and ("BOSS - Stage " .. S.stage) or ("Quest - Stage " .. S.stage))), "")
local ey = TOP + 4
local ee = e.eelem or elem_of(e.ec)
thumb(16, ey, e.ec, { show = true, art = e.art })
local x = 138
ltext(x, ey, fit(e.name or cname(e.ec), W - x - 10, "ui12", "bold"), "ui12", "bold")
chip(x + 16, ey + 44, ee)
ltext(x + 38, ey + 32, D.elems[ee] .. " - " .. ((e.lair or e.wb) and "BOSS" or (e.wild and "WILDERNESS" or D.tiers[tier_of(e.ec) + 1])), "small")
icon_heart(x + 12, ey + 70); ltext(x + 30, ey + 58, "HP " .. e.eh, "ui10", "bold")
icon_sword(x + 142, ey + 70); ltext(x + 160, ey + 58, "ATK " .. e.ea, "ui10", "bold")
ltext(x, ey + 84, "Weak to  " .. D.elems[D.weak[ee]], "ui10", "bold")
ltext(x, ey + 108, "Strong vs " .. D.elems[D.beats[ee]], "small")
if e.boss then ltext(x + 170, ey + 4, "BOSS", "small", "bold") end
ctext(W / 2, ey + 132, "Choose a fighter. Dots: your cards strong here.", "small")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
swipe_tabs(function() return page end, function(t) page = t end, 0, 6)
for i = 0, 6 do
local n = GRID.count(i, function(c) return S.lvl[c] > 0 and mult(elem_of(c), ee) == 2 end)
local tx = 6 + i * 67
button(tx, ey + 156, 63, 52, tabs[i + 1], function() if page == i then GRID.flip("fight", i) end; page = i end,
{ font = "small", sub = " ", active = (page == i), id = tabs[i + 1] })
local bx, by = tx + 31, ey + 156 + 36
if n > 0 then
smudge.circle(bx, by, 10, true); ctext(bx, by - lh("small") // 2, tostring(n), "small", "bold", true); badge_tint(bx, by, 10)
else
smudge.circle(bx, by, 10, true, 1, false); smudge.circle(bx, by, 10, false, 1)
ctext(bx, by - lh("small") // 2, "0", "small")
end
end
local y0 = ey + 220
GRID.draw("fight", page, y0, 2, 172, function(c, gx, gy)
thumb(gx, gy, c, { name = true })
if owned(c) then
local a, h = card_stats(c)
ctext(gx + 54, gy + 130, string.format("A%d  H%d", a, h), "small")
local mo, mt = mult(elem_of(c), ee), mult(ee, elem_of(c))
local tag
if mo == 2 then tag = "STRONG x2"
elseif mo == 0.5 then tag = "WEAK x1/2"
elseif mt == 2 then tag = "HIT BY x2"
else tag = "EVEN" end
ctext(gx + 54, gy + 150, tag, "small", "bold")
local bx, by = gx + 94, gy + 14
if mo == 2 then
smudge.circle(bx, by, 13, true); ctext(bx, by - lh("small") // 2, "x2", "small", "bold", true); badge_tint(bx, by, 13)
elseif mo == 0.5 then
smudge.circle(bx, by, 13, true, 1, false); smudge.circle(bx, by, 13, false, 2)
ctext(bx, by - lh("small") // 2, "/2", "small", "bold")
end
end
reg("card" .. c, gx, gy, 108, 168, function()
if owned(c) then start_battle(c) else note = "You do not own that card yet." end
end, true)
end)
draw_note(y0 + 2 * 172)
button(24, H - 96, W - 48, 64, "BACK", function()
if e.duel then PE = nil; F.duel_quit(); return end
if e.lair or e.wild or e.wb then local back = e.wb and "worldboss" or ((e.lair == 9) and "questinfo" or (e.lair and "lairs" or "wild")); PE = nil; go(back) else go("title") end
end, { font = "ui10" })
end
local function leave_battle()
local won, tower = B.win, B.tower
if B.duel then B = nil; PE = nil; F.duel_next(); return end
if B.lair or B.wild or B.wb then local back = C.adv_back(B); B = nil; PE = nil; go(back); return end
B = nil
if won then
if tower then new_tower_enemy(S.tower + 1) else new_enemy() end
end
go("quest")
end
SCREENS.battle = function()
local boss = B.boss
top_bar(B.duel and F.duel_title() or B.wb and ("WORLD BOSS - " .. ename()) or B.lair and ("BOSS - " .. ename()) or (B.wild and ("Wilderness lvl " .. B.wild * 10)) or (B.tower and ("Tower - Floor " .. B.tower) or (boss and ("BOSS - Stage " .. B.stage) or ("Stage " .. B.stage))), "")
local ee, pe = eelem(), elem_of(B.pc)
local ey = TOP + 4
ltext(24, ey, ename(), "ui12", "bold")
chip(40, ey + 40, ee)
ltext(64, ey + 32, D.elems[ee] .. " - " .. ((B.lair or B.wb) and "BOSS" or (B.wild and "WILDERNESS" or D.tiers[tier_of(B.ec) + 1])), "small")
bar(24, ey + 58, 300, 24, B.ehp / B.emax)
ltext(24, ey + 88, string.format("HP %d / %d   ATK %d", B.ehp, B.emax, B.eatk) .. stt(B.es), "small", "bold")
ltext(24, ey + 112, info_line(ee), "small")
local py = TOP + 146
if V3.ok() and not SAVER then
local now = smudge.millis()
local function pose(fx, side)
local dx, dy, rx, ry = 0, 0, 0.06 * math.sin(now / 1500 + side), -0.28 * side + 0.05 * math.sin(now / 1200 + side)
if fx then
local u = (now - fx.t) / 450
if u >= 0 and u < 1 then
local sw = math.sin(u * math.pi)
if fx.k == "lunge" then dx, dy, rx = dx + 70 * sw * side, dy - 44 * sw * side, rx - 0.35 * sw * side
elseif fx.k == "hit" then dx = dx + math.sin(u * 38) * 9 * (1 - u); ry = ry + math.sin(u * 25) * 0.35 * (1 - u)
elseif fx.k == "guard" then ry = ry + 1.15 * sw * side end
end
end
return dx, dy, rx, ry
end
local function fall(r, win_side)
if B.over and B.endt then
local u = math.min(1, (now - B.endt) / 600)
return r + 1.25 * u * u, u
end
return r, 0
end
if B.over and not B.endt then B.endt = now end
local edx, edy, erx, ery = pose(B.fxe, -1)
local pdx, pdy, prx, pry = pose(B.fxp, 1)
if B.over then
if B.win then erx = fall(erx) elseif not B.fled then prx = fall(prx) end
end
V3.render({ c = B.ec, cx = 402 + edx, cy = ey + 56 + edy, CW = 104, CH = 104, rx = erx, ry = ery, inset = 6, depth = 0.6,
art = B.art, layers = not B.art, fx = (not B.art) and tier_of(B.ec) or nil })
V3.render({ c = B.pc, cx = 78 + pdx, cy = py + 56 + pdy, CW = 104, CH = 104, rx = prx, ry = pry, inset = 6, depth = 0.6,
layers = true, fx = tier_of(B.pc), shiny = S.shiny[B.pc] == 1 })
else
thumb(348, ey, B.ec, { show = true, art = B.art })
thumb(24, py, B.pc, { show = true })
end
ltext(150, py, cname(B.pc), "ui12", "bold")
ltext(150, py + 28, string.format("LV %d - %s", S.lvl[B.pc], D.elems[pe]) .. ((tier_of(B.pc) == 4) and (" - " .. D.ability_short[pe]) or ""), "small")
bar(150, py + 58, 300, 24, B.php / B.pmax)
ltext(150, py + 88, string.format("HP %d / %d   ATK %d", B.php, B.pmax, B.patk) .. stt(B.ps), "small", "bold")
ltext(150, py + 114, "Energy", "small")
for i = 1, 5 do smudge.circle(238 + (i - 1) * 24, py + 122, 8, i <= B.energy, 2) end
ltext(24, py + 138, info_line(pe), "small")
ctext(W / 2, py + 164, string.format("Your hits %s     Their hits %s", mult_txt(mult(pe, ee)), mult_txt(mult(ee, pe))), "small", "bold")
local ly = py + 190
if not SAVER then smudge.rounded_rect(28, ly + 4, W - 48, 108, 8, true, 1) end
smudge.rounded_rect(24, ly, W - 48, 108, 8, true, 1, false)
smudge.rounded_rect(24, ly, W - 48, 108, 8, false, 2)
for i, line in ipairs(B.log) do ltext(36, ly + 6 + (i - 1) * 24, fit(line, W - 72, "small", "regular"), "small") end
if B.over then
local y = ly + 124
ctext(W / 2, y, B.win and "VICTORY!" or (B.fled and "RETREATED" or (B.wb and "KNOCKED BACK" or "DEFEATED")), "bitter14", "bold")
if B.reward > 0 then
icon_coin(W / 2 - 50, y + 54); ltext(W / 2 - 32, y + 42, "+" .. B.reward .. " coins", "ui12", "bold")
end
if B.lair or B.wild or B.wb then
local t = (B.dust and B.win) and ("+" .. B.dust .. " dust  ") or ""
ctext(W / 2, y + 78, fit(t .. (B.bonus or ""), W - 40, "ui10", "regular"), "ui10")
elseif B.win and not B.duel then
local extra = B.scales and (string.format("  +%d Boss scale", B.scales)) or ""
if B.dust then extra = extra .. "  +" .. B.dust .. " dust" end
if B.tower then ctext(W / 2, y + 78, string.format("Next: floor %d", S.tower + 1) .. extra, "ui10")
else ctext(W / 2, y + 78, string.format("Next: stage %d", S.stage) .. extra, "ui10") end
if B.bonus then ctext(W / 2, y + 100 - 2, B.bonus, "small", "bold") end
end
button(24, y + 108, W - 48, 76, "CONTINUE", function() leave_battle() end)
return
end
local by = ly + 138
draw_note(by - 26)
local busy = B.busy
button(24, by, W - 48, 74, "ATTACK", function() player_act("attack") end, { off = busy })
button(24, by + 82, 210, 74, "GUARD", function() player_act("guard") end, { off = busy, sub = "heal + halve hit" })
button(246, by + 82, 210, 74, "SPECIAL", function() player_act("special") end,
{ off = busy or B.energy < 3, sub = "3 energy, double hit" })
local pp, pmx = C.pray_points(S)
button(246, by + 164, 210, 52, B.prot and "PRAY: ON" or "PRAY: OFF", function()
if not B.prot and pp <= 0 then note = "No prayer points. Restore them at the altar."; return end
B.prot = not B.prot
note = B.prot and ("Protect from " .. D.elems[eelem()] .. ": half damage.") or "Prayer off."
end, { font = "small", sub = pp .. "/" .. pmx .. " points", active = B.prot, off = busy, id = "PRAY" })
button(24, by + 164, 210, 52, "RETREAT", function()
if B.retreat then
B.over = true; B.win = false; B.reward = 0; B.fled = true; blog("You retreated.")
else
B.retreat = true; note = "Tap RETREAT again to give up."
end
end, { font = "ui10", off = busy })
end
local TR = { cx = 0, tx = 0, vx = 0 }
function TR.items()
local cp, WO = S.camp, C.ADV and C.ADV.WO
local L = {}
for _, c in ipairs(D.tier_cards[6]) do
L[#L + 1] = { kind = "card", c = c, got = owned(c), name = owned(c) and cname(c) or "Secret card",
how = "A secret card: 1 in 10 million per card from packs (the Mythic box, the well and LEGEND+ packs help)." }
end
if WO then
for k, r in ipairs(WO.REGIONS) do
L[#L + 1] = { kind = "sec", k = k, got = WO.get("sec" .. k) == 1, name = r[1] .. " secret", how = "EXPLORE " .. r[1] .. " on the world map: 3% per trip." }
end
for k = 7, #WO.REGIONS do
local r = WO.REGIONS[k]
if r[9] then
local id = ({ [7] = "tlhide", [8] = "sscale", [9] = "wscale", [10] = "rcryst" })[k]
L[#L + 1] = { kind = "drop", id = id, got = WO.get("sp" .. k) == 1, name = id and C.item_name and C.item_name(r[9]) or "Special drop",
how = "Defeat the " .. r[6] .. " in " .. r[1] .. ": 1 in 8." }
end
end
end
local tot, mx = 0, 0
for i = 1, #cp.ach do tot = tot + (cp.ach[i] or 0); mx = mx + 5 end
local frac = (mx > 0) and tot / mx or 0
for t, need in ipairs({ 0.25, 0.6, 1 }) do
L[#L + 1] = { kind = "cup", t = t, got = frac >= need, name = ({ "Bronze", "Silver", "Gold" })[t] .. " cup",
how = string.format("Achievement stars: %d / %d (%d%% needed).", tot, mx, math.floor(need * 100)) }
end
local all = true
for _, it in ipairs(L) do if not it.got then all = false end end
L[#L + 1] = { kind = "star", got = all, name = "Crystal star", how = "Everything else in this hall." }
local n = 0 for _, it in ipairs(L) do if it.got then n = n + 1 end end
return L, n
end
function TR.touch(ev, x, y)
if scr ~= "trophies" or not TR.box or type(x) ~= "number" then return false end
local now = smudge.millis()
if ev == "down" then
if smudge.in_rect(x, y, TR.box[1], TR.box[2], TR.box[3], TR.box[4]) then TR.d = { x0 = x, c0 = TR.tx, smp = { { x, now } } }; TR.vx = 0 end
return false
end
local d = TR.d
if not d then return false end
if ev == "move" then
if d.moved or math.abs(x - d.x0) > 10 then
d.moved = true
TR.tx = TR.clamp(d.c0 - (x - d.x0) / TR.k)
d.smp[#d.smp + 1] = { x, now }; if #d.smp > 8 then table.remove(d.smp, 1) end
V3.moving = now + 600
end
return d.moved or false
end
if ev == "release" then
TR.d = nil
if d.moved then
local s0 = d.smp[1]
for _, sm in ipairs(d.smp) do if now - sm[2] <= 90 then s0 = sm; break end end
TR.vx = -(x - s0[1]) / math.max(16, now - s0[2]) / TR.k
V3.moving = now + 1500
end
return d.moved or false
end
return false
end
SCREENS.trophies = function()
local L, got = TR.items()
top_bar("Trophy room", got .. " / " .. #L)
local now = smudge.millis()
local y0, h0 = TOP + 6, H - 96 - 110 - TOP
local SP = 150
local LEN = (#L - 1) * SP
function TR.clamp(v) return math.max(0, math.min(LEN, v)) end
local dt = math.min(60, now - (TR.last or now)); TR.last = now
if not TR.d and TR.vx ~= 0 then
TR.tx = TR.clamp(TR.tx + TR.vx * dt); TR.vx = TR.vx * math.exp(-dt / 300)
if math.abs(TR.vx) < 0.01 then TR.vx = 0 end
end
TR.cx = TR.cx + (TR.tx - TR.cx) * (1 - math.exp(-dt / (TR.d and 50 or 110)))
if not (V3.ok() and smudge.draw_sprite_quad and smudge.fill_quad) then
local half = (#L + 1) // 2
for i, it in ipairs(L) do
local col, row = (i - 1) // half, (i - 1) % half
ltext(24 + col * (W - 48) // 2, y0 + 10 + row * 24, fit((it.got and "* " or "- ") .. it.name, (W - 60) // 2, "small", it.got and "bold" or "regular"), "small", it.got and "bold" or "regular")
end
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go(TR.ret or "title"); TR.ret = nil end, { font = "ui10" })
return
end
TR.box = { 0, y0, W, h0 }
local HH, D0, FOC = 150, 230, 700
local ccy = y0 + h0 / 2
local ZS = h0 / (2 * HH * 1.15)
TR.k = ZS * 0.8
local function P(x, y, z)
local k = FOC / (FOC + z) * ZS
return W / 2 + (x - TR.cx) * k, ccy + y * k, k
end
local function quad(x0, y0q, z0, x1, y1q, z1, x2, y2q, z2, x3, y3q, z3)
local a1, b1 = P(x0, y0q, z0); local a2, b2 = P(x1, y1q, z1); local a3, b3 = P(x2, y2q, z2); local a4, b4 = P(x3, y3q, z3)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
if smudge.set_clip then smudge.set_clip(0, y0, W, h0) end
local TW = 2 * HH * 2
local xs = TR.cx - W * 0.9
local i0 = math.floor(xs / TW)
for i = i0, i0 + 5 do
local xa, xb = i * TW - 300, (i + 1) * TW - 300 + 6
local q = quad(xa, -HH - 4, D0, xb, -HH - 4, D0, xb, HH + 4, D0, xa, HH + 4, D0)
smudge.draw_sprite_quad("art/th_back.raw", 256, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
local c2 = quad(xa, -HH, -60, xb, -HH, -60, xb, -HH, D0, xa, -HH, D0)
smudge.draw_sprite_quad("art/th_ceil.raw", 256, 128, c2[1], c2[2], c2[3], c2[4], c2[5], c2[6], c2[7], c2[8])
end
do
local BS = 100
local xa0 = math.floor((TR.cx - W * 0.9) / BS) * BS
for zb0 = -60, D0 - 1, BS do
local zb1 = math.min(D0, zb0 + BS)
local vv = (zb1 - zb0) / BS
for xi = 0, math.ceil(W * 2 / BS) do
local xa = xa0 + xi * BS
local q = quad(xa, HH, zb1 + 1, xa + BS + 1, HH, zb1 + 1, xa + BS + 1, HH, zb0, xa, HH, zb0)
smudge.draw_sprite_quad("art/th_tile.raw", 128, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], nil, 0, 1 - vv, 1, 1)
end
end
local cz0, cz1 = D0 * 0.5 - 40, D0 * 0.5 + 40
local r = quad(xa0, HH, cz1, xa0 + W * 2, HH, cz1, xa0 + W * 2, HH, cz0, xa0, HH, cz0)
smudge.fill_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], false, TT.bg)
if smudge.glare_quad then smudge.glare_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], true) end
if smudge.shade_quad then smudge.shade_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], 0) end
for _, zz in ipairs({ cz0, cz0 + 6, cz1 - 6, cz1 }) do
local a1, b1 = P(xa0, HH, zz); local a2, b2 = P(xa0 + W * 2, HH, zz)
smudge.line(math.floor(a1), math.floor(b1), math.floor(a2), math.floor(b2), (zz == cz0 or zz == cz1) and 2 or 1)
end
end
for _, ex in ipairs({ -300, LEN + 300 }) do
local q = (ex < 0) and quad(ex, -HH, -60, ex, -HH, D0, ex, HH, D0, ex, HH, -60) or quad(ex, -HH, D0, ex, -HH, -60, ex, HH, -60, ex, HH, D0)
smudge.draw_sprite_quad("art/th_side.raw", 256, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
end
local pick, pd = nil, 1e9
for i, it in ipairs(L) do
local x = (i - 1) * SP
if math.abs(x - TR.cx) < W * 1.0 then
local z = D0 * 0.5
local bx, by, k = P(x, HH, z)
local function spr(nm, sw, sh, w, h, lift)
w, h, lift = w * 0.75, h * 0.75, (lift or 0) * 0.75
local x0, y1 = bx - w * k / 2, by - lift * k
local p = "art/" .. nm
smudge.draw_sprite_quad(p .. ".raw", sw, sh, x0, y1 - h * k, x0 + w * k, y1 - h * k, x0 + w * k, y1, x0, y1, p .. "_m.raw")
return x0, y1 - h * k, w * k, h * k
end
local top
if it.kind == "card" then
local fx, fy, fw, fh = spr("tp4", 128, 128, 150, 150)
local function E(u, v)
local tx, ty = 45 + (87 - 45) * u, 22 + (26 - 22) * u
local bx2, by2 = 39 + (82 - 39) * u, 78 + (82 - 78) * u
return fx + fw * (tx + (bx2 - tx) * v) / 128, fy + fh * (ty + (by2 - ty) * v) / 128
end
local function EQ(u0, v0, u1, v1)
local a1, b1 = E(u0, v0); local a2, b2 = E(u1, v0); local a3, b3 = E(u1, v1); local a4, b4 = E(u0, v1)
return a1, b1, a2, b2, a3, b3, a4, b4
end
if it.got then
local q1, q2, q3, q4, q5, q6, q7, q8 = EQ(0, 0, 1, 1)
smudge.fill_quad(q1, q2, q3, q4, q5, q6, q7, q8, false, card_tk())
local a1, b1, a2, b2, a3, b3, a4, b4 = EQ(0.08, 0.06, 0.92, 0.72)
smudge.draw_sprite_quad(string.format("art/s%02d.raw", it.c - 1), 96, 96, a1, b1, a2, b2, a3, b3, a4, b4)
else
local a1, b1, a2, b2, a3, b3, a4, b4 = EQ(0, 0, 1, 1)
smudge.draw_sprite_quad("art/card_back.raw", 192, 256, a1, b1, a2, b2, a3, b3, a4, b4)
end
top = fy
elseif it.kind == "sec" then
local _, py = spr("tp1", 128, 128, 120, 120)
local _, ty = spr((it.got and "lm" or "lm") .. it.k .. (it.got and "" or "_n"), 96, 96, 96, 96, 92)
top = ty
elseif it.kind == "drop" then
local fx, fy, fw, fh = spr("tp2", 128, 128, 120, 150)
if it.id then
local iw = fw * 0.42
local ix, iy = fx + fw / 2 - iw / 2, fy + fh * 0.32
local p = "art/it_" .. it.id
smudge.draw_sprite_quad(p .. ".raw", 24, 24, ix, iy, ix + iw, iy, ix + iw, iy + iw, ix, iy + iw, p .. "_m.raw")
end
top = fy
elseif it.kind == "cup" then
local _, cy2 = spr("tp3", 128, 128, 110, 100)
local _, ty = spr("tp" .. (4 + it.t), 128, 128, 100, 100, 74)
top = ty
else
local _, ty = spr("tp8", 128, 128, 150, 150)
top = ty
end
if not it.got and smudge.shade_quad then
local w2 = 80 * k
smudge.shade_quad(bx - w2 / 2, top, bx + w2 / 2, top, bx + w2 / 2, by, bx - w2 / 2, by, 0)
local lx, ly = math.floor(bx), math.floor((top + by) / 2)
smudge.rounded_rect(lx - 12, ly - 4, 24, 20, 4, true); smudge.circle(lx, ly - 8, 7, false, 3)
smudge.rect(lx - 1, ly + 3, 3, 7, true, 1, false)
end
local d2 = math.abs(x - TR.cx)
if d2 < pd then pd = d2; pick = { it = it, x = x, i = i } end
reg("TROPHY" .. i, math.floor(bx - 40 * k), math.floor(top), math.floor(80 * k), math.floor(by - top), function() TR.tx = x end, true)
end
end
if smudge.set_clip then smudge.set_clip() end
if pick then
local it = pick.it
local py = y0 + h0 + 10
ctext(W / 2, py, it.name .. (it.got and "" or "  (locked)"), "ui12", "bold")
wrapped(30, py + 36, it.got and "In your collection." or it.how, W - 60, "small", 3)
end
ctext(W / 2, y0 + h0 - 26, "drag to walk along the hall", "small")
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go(TR.ret or "title"); TR.ret = nil end, { font = "ui10" })
end
SCREENS.stats = function()
top_bar("Statistics", "")
local y = TOP + 6
local rows = {
{ "Packs opened", S.packs }, { "Cards found", found_count() .. " / " .. D.ncards },
{ "Spare copies", spare_total() }, { "Shiny cards", shiny_count() },
{ "Sets complete", sets_done() .. " / 14" }, { "Evolutions", S.evolved },
{ "Battles won", S.wins }, { "Quest stage", S.stage }, { "Tower floor", S.tower },
{ "Coins earned", S.earned }, { "Coins now", S.coins }, { "Dust", S.dust },
}
for i, r in ipairs(rows) do
ltext(32, y + (i - 1) * 28, r[1], "ui10")
rtext(W - 32, y + (i - 1) * 28, tostring(r[2]), "ui10", "bold")
smudge.line(24, y + (i - 1) * 28 + 25, W - 24, y + (i - 1) * 28 + 25, 1)
end
local ry = y + 12 * 28 + 4
ctext(W / 2, ry, "Rank: " .. D.ranks[math.min(5, found_count() // 8 + 1)], "ui12", "bold")
for t = 0, 5 do
local n, tot = GRID.count(t)
ltext(32, ry + 34 + t * 22, D.tiers[t + 1], "small")
bar(160, ry + 34 + t * 22, 290, 16, n / tot)
end
button(24, H - 172, W - 48, 64, "CAMP & ADVENTURE", function() go("hiscores") end, { font = "ui10", sub = "skills, bosses, quests, clues...", id = "HISCORES" })
button(24, H - 248, W - 48, 64, "TROPHY ROOM", function() TR.ret = "stats"; go("trophies") end, { font = "ui10", sub = "everything you've collected, on show", id = "TROPHIES" })
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
SCREENS.elempack = function()
top_bar("Element Pack", "")
ctext(W / 2, TOP + 4, "3 cards, all of one element. 70 coins.", "ui10")
ctext(W / 2, TOP + 30, "Last card is still uncommon or better.", "small")
for e = 1, 8 do
local col, row = (e - 1) % 2, (e - 1) // 2
button(24 + col * 222, TOP + 62 + row * 94, 210, 86, D.elems[e], function() open_pack(false, false, e) end,
{ sub = "70 coins", off = S.coins < 70, id = "EP" .. e })
chip(24 + col * 222 + 30, TOP + 62 + row * 94 + 43, e)
end
res_bar(TOP + 62 + 4 * 94 + 4)
draw_note(TOP + 62 + 4 * 94 + 40)
button(24, H - 96, W - 48, 64, "BACK", function() go("packs") end, { font = "ui10" })
end
SCREENS.deck = function()
top_bar("Deck & Sets", "")
ctext(W / 2, TOP + 4, "Your team of three", "ui12", "bold")
for i = 1, 3 do
local x = 12 + (i - 1) * 156
local c = S.deck[i]
if c ~= 0 and owned(c) then thumb(x + 24, TOP + 44, c, { name = true })
else
smudge.rounded_rect(x + 24, TOP + 44, 108, 108, 8, false, 2)
ctext(x + 78, TOP + 84, "EMPTY", "small", "bold")
end
reg("slot" .. i, x + 24, TOP + 44, 108, 130, function() dslot = i; album_mode = "deck"; page = 0; go("album") end, true)
end
local y = TOP + 196
wrapped(30, y, "Team spirit: a fighter in the deck gets +1 ATK and +2 HP for every other card in the deck.", W - 60, "ui10", 3)
local ts = 0
for t = 0, 5 do if tier_done(t) then ts = ts + 1 end end
ltext(30, y + 84, string.format("Set bonus now: +%d ATK, +%d HP on all cards", ts, ts * 2), "small", "bold")
local ec = 0
for e = 1, 8 do if elem_done(e) then ec = ec + 1 end end
ltext(30, y + 108, string.format("Element lines done: %d (+2 ATK for that element)", ec), "small")
button(24, y + 140, W - 48, 74, "SETS", function() go("sets") end, { sub = sets_done() .. " / 14 complete", font = "ui10" })
button(24, y + 224, W - 48, 56, "CLEAR DECK", function() S.deck = { 0, 0, 0 }; save_now(); note = "Deck cleared." end, { font = "ui10" })
draw_note(y + 288)
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
local spage = 0
local SET_DUST = { 20, 40, 60, 100, 150, 200 }
local function set_def(i)
if i <= 6 then
local n = 0
for k = 1, 8 do if S.lvl[(i - 1) * 8 + k] > 0 then n = n + 1 end end
return D.tiers[i] .. " set", n, 8, SET_DUST[i] .. " dust", function() add_dust(SET_DUST[i]) end
end
local e = i - 6
local n = 0
for t = 0, 5 do if S.lvl[t * 8 + e] > 0 then n = n + 1 end end
return D.elems[e] .. " line", n, 5, "30 dust + 100 coins", function() add_dust(30); add_coins(100) end
end
SCREENS.sets = function()
top_bar("Sets", sets_done() .. " / 14")
local per = 5
local pages = 3
if spage >= pages then spage = pages - 1 end
local function srow(i, k, by)
if i <= 14 then
local name, n, tot, rw, give = set_def(i)
local done = (S.setmask >> (i - 1)) & 1 == 1
smudge.rounded_rect(20, by, W - 40, 92, 10, true, 1, false)
smudge.rounded_rect(20, by, W - 40, 92, 10, false, 2)
ltext(34, by + 6, name, "ui10", "bold")
ltext(34, by + 34, "Reward: " .. rw, "small")
bar(34, by + 62, 200, 16, n / tot)
ltext(244, by + 62, n .. "/" .. tot, "small")
button(W - 24 - 130, by + 10, 120, 72, done and "DONE" or "CLAIM", function()
if (S.setmask >> (i - 1)) & 1 == 1 then return end
if n < tot then note = "Collect them all first."; return end
S.setmask = S.setmask | (1 << (i - 1)); give(); note = name .. " claimed!"; save_now()
end, { font = "small", off = done or n < tot, id = "SET" .. k })
end
end
local ny = TOP + 6 + per * 100 + 4
if not scroll_list("sets", TOP + 6, nil, 14, 100, function(i, by) srow(i, i, by) end) then
for k = 1, per do srow(spage * per + k, k, TOP + 6 + (k - 1) * 100) end
button(24, ny, 140, 46, "PREV", function() if spage > 0 then spage = spage - 1 end end, { font = "ui10", off = spage == 0, id = "PREV" })
ctext(W / 2, ny + 12, (spage + 1) .. " / " .. pages, "ui10")
button(W - 24 - 140, ny, 140, 46, "NEXT", function() if spage < pages - 1 then spage = spage + 1 end end, { font = "ui10", off = spage >= pages - 1, id = "NEXT" })
end
draw_note(ny + 52)
button(24, H - 96, W - 48, 64, "BACK", function() go("deck") end, { font = "ui10" })
end
local function save_opt() smudge.save("opt", SAVER and "1" or "0") end
GAME_VERSION = "3.64.0"
SCREENS.customtheme = function()
top_bar("Custom theme", "make it yours")
local y = TOP + 22
ltext(32, y, "Pick a colour and a ground. Changes show right away.", "small")
smudge.rounded_rect(24, y + 30, W - 48, 104, 10, true, 1, false)
smudge.rounded_rect(24, y + 30, W - 48, 104, 10, false, 2)
ltext(42, y + 42, "COLOUR", "ui10", "bold")
ctext(W / 2, y + 73, CT.accents[CT.accent][1], "ui12", "bold")
local function set(v) CT.accent = v; smudge.save("customaccent", tostring(v)); theme_i = CT.custom; smudge.save("style", "custom"); apply_theme() end
button(38, y + 92, 104, 34, "PREV", function() set(CT.accent == 1 and #CT.accents or CT.accent - 1) end, { font = "small", id = "CUSTOMACCENTPREV" })
button(W - 142, y + 92, 104, 34, "NEXT", function() set(CT.accent % #CT.accents + 1) end, { font = "small", id = "CUSTOMACCENTNEXT" })
local hw = (W - 48 - 12) // 2
for k, nm in ipairs({ "DARK GROUND", "LIGHT GROUND" }) do
button(24 + (k - 1) * (hw + 12), y + 150, hw, 56, nm, function()
CT.ground = k; smudge.save("customground", tostring(k)); theme_i = CT.custom; smudge.save("style", "custom"); apply_theme()
end, { font = "ui10", active = (CT.ground or 1) == k, id = "CUSTOMGROUND" .. k })
end
thumb(W // 2 - 54, y + 226, 20, { show = true, name = false })
button(24, H - 96, W - 48, 64, "DONE", function() theme_i = CT.custom; smudge.save("style", "custom"); apply_theme(); go("settings") end, { font = "ui10", id = "CUSTOMDONE" })
end
SCREENS.vibes = function()
top_bar("Vibration lab", "pack opening")
local y = TOP + 8
if not smudge.vibrate then
wrapped(30, y + 20, "Vibrations need the newest phone app (it can't vibrate yet). Install the app update, then come back here.", W - 60, "ui10", 4)
button(24, H - 96, W - 48, 64, "BACK", function() go("settings") end, { font = "ui10" })
return
end
button(24, y, W - 48, 56, VIB.on and "IN PACK OPENING: ON" or "IN PACK OPENING: OFF", function()
VIB.on = not VIB.on; VIB.save(); note = VIB.on and "Packs vibrate now when they open." or "Packs open without vibrating."
end, { font = "ui10", active = VIB.on, sub = VIB.on and "tap to switch off" or "test them first, then switch on", id = "VIBON" })
local sw = (W - 48 - 16) // 3
for k = 1, 3 do
button(24 + (k - 1) * (sw + 8), y + 66, sw, 44, VIB.SN[k], function() VIB.str = k; VIB.save(); VIB.play("t3", true) end,
{ font = "small", active = VIB.str == k, id = "VIBSTR" .. k })
end
local ry = y + 122
local rh = math.min(58, (H - 96 - 70 - ry) // #VIB.EV)
for i, e in ipairs(VIB.EV) do
local yy = ry + (i - 1) * rh
local L = VIB.len[e[1]] or 100
ltext(26, yy + (rh - 8 - lh("small")) // 2, fit(e[2], 150, "small", "bold"), "small", "bold")
button(176, yy, 84, rh - 8, "TEST", function() VIB.play(e[1], true) end, { font = "small", off = L <= 0, id = "VIBT" .. i })
button(270, yy, 52, rh - 8, "-", function()
VIB.len[e[1]] = (L <= 50) and 0 or (L - 25); VIB.save(); VIB.play(e[1], true)
end, { font = "ui10", off = L <= 0, id = "VIBM" .. i })
ctext(362, yy + (rh - 8 - lh("small")) // 2, (L <= 0) and "OFF" or (L .. "%"), "small", "bold")
button(404, yy, 52, rh - 8, "+", function()
VIB.len[e[1]] = (L <= 0) and 50 or math.min(200, L + 25); VIB.save(); VIB.play(e[1], true)
end, { font = "ui10", off = L >= 200, id = "VIBP" .. i })
end
local py = ry + #VIB.EV * rh + 4
button(24, py, W - 48, 56, "PLAY A WHOLE PACK", function()
VIB.play("tear", true)
local seq = { { 1100, "flip" }, { 1600, "t1" }, { 1900, "flip" }, { 2400, "t2" }, { 2700, "flip" }, { 3500, "t4" } }
local t0 = smudge.millis()
VIB.q = {}
for _, s2 in ipairs(seq) do VIB.q[#VIB.q + 1] = { t0 + s2[1], s2[2] } end
end, { font = "ui10", sub = "tear, three cards, an exotic last", id = "VIBPACK" })
draw_note(py + 64)
button(24, H - 96, W - 48, 64, "BACK", function() go("settings") end, { font = "ui10" })
end
SCREENS.settings = function()
top_bar("Settings", "v" .. GAME_VERSION .. (smudge.app and " app" or ""))
local y = TOP + 8
if not SAVER then smudge.rounded_rect(24 + 3, y + 4, W - 48, 112, 10, true) end
smudge.rounded_rect(24, y, W - 48, 112, 10, true, 1, false)
smudge.rounded_rect(24, y, W - 48, 112, 10, false, 2)
ltext(44, y + 14, "Battery saver", "ui12", "bold")
ltext(44, y + 50, "Light mode: no animations,", "small")
ltext(44, y + 74, "no shadows, fewer refreshes.", "small")
local sx, sy, sw, sh = W - 24 - 24 - 104, y + 30, 104, 52
smudge.rounded_rect(sx, sy, sw, sh, 26, SAVER, 3, true)
if SAVER then
smudge.circle(sx + sw - 26, sy + sh // 2, 18, true, 1, false)
ctext(sx + 30, sy + (sh - lh("small")) // 2, "ON", "small", "bold", true)
else
smudge.circle(sx + 26, sy + sh // 2, 18, true)
ctext(sx + sw - 30, sy + (sh - lh("small")) // 2, "OFF", "small", "bold")
end
reg("SAVER", 24, y, W - 48, 112, function() SAVER = not SAVER; save_opt(); note = SAVER and "Battery saver is ON." or "Battery saver is OFF." end, false)
local hw2 = (W - 48 - 12) // 2
button(24, y + 124, hw2, 60, CLEAN and "CLEANUP: ON" or "CLEANUP: OFF",
function() CLEAN = not CLEAN; smudge.save("clean", CLEAN and "1" or "0"); apply_clean(); note = CLEAN and "A black clean-up flash every 40 screens removes ghosting." or "No more black clean-up flashes." end,
{ font = "ui10", sub = "flash every 40 screens", active = CLEAN, id = "CLEAN" })
button(36 + hw2, y + 124, hw2, 60, "STYLE: " .. THEMES[theme_i][2],
function()
if smudge.set_tint then theme_i = theme_i % #THEMES + 1
else theme_i = (theme_i == CT.classic) and 1 or CT.classic end
smudge.save("style", THEMES[theme_i][1]); apply_theme()
note = THEMES[theme_i][3] and (smudge.tint and "Style: " .. THEMES[theme_i][2] .. ". Tap again for the next one." or "Stone look (the colours show in the phone app).") or "Classic look: white and clean."
end, { font = "ui10", sub = "tap for the next", id = "STYLE" })
local ly = y + 196
if CS_SMOOTH then
button(24, ly, hw2, 60, FX_GLINT and "GLINT: ON" or "GLINT: OFF",
function() FX_GLINT = not FX_GLINT; smudge.save("fxglint", FX_GLINT and "1" or "0"); note = FX_GLINT and "A glint of light runs over the buttons now and then." or "No more glint over the buttons." end,
{ font = "ui10", sub = "light over buttons", active = FX_GLINT, id = "FXGLINT" })
button(36 + hw2, ly, hw2, 60, FX_RIP and "RIPPLE: ON" or "RIPPLE: OFF",
function() FX_RIP = not FX_RIP; smudge.save("fxrip", FX_RIP and "1" or "0"); note = FX_RIP and "A ripple spreads where you tap a button." or "No more ripple when you tap." end,
{ font = "ui10", sub = "ring where you tap", active = FX_RIP, id = "FXRIP" })
local cw = smudge.vibrate and hw2 or (W - 48)
button(24, ly + 72, cw, 52, "CUSTOMIZE THEME", function() theme_i = CT.custom; apply_theme(); go("customtheme") end,
{ font = "ui10", sub = smudge.vibrate and "your own colour" or "pick your own colour", id = "CUSTOMTHEME" })
if smudge.vibrate then
button(36 + hw2, ly + 72, hw2, 52, "VIBRATIONS", function() VIB.load(); go("vibes") end,
{ font = "ui10", sub = VIB.on and "on in packs" or "test and tune", id = "VIBES" })
end
if smudge.music then
button(24, ly + 136, hw2, 56, SND.music and "MUSIC: ON" or "MUSIC: OFF", function()
SND.music = not SND.music; smudge.save("music", SND.music and "1" or "0"); SND.apply()
note = SND.music and "Calm music plays in the background." or "No music."
end, { font = "ui10", sub = "calm background loop", active = SND.music, id = "MUSIC" })
button(36 + hw2, ly + 136, hw2, 56, SND.sfx and "SOUNDS: ON" or "SOUNDS: OFF", function()
SND.sfx = not SND.sfx; smudge.save("sfx", SND.sfx and "1" or "0"); if SND.sfx then SND.play("secret", 0.6) end
note = SND.sfx and "Sound effects are on (like a secret card's sound)." or "No sound effects."
end, { font = "ui10", sub = "effects, e.g. secret cards", active = SND.sfx, id = "SOUNDS" })
end
local sy2 = ly + (smudge.music and 200 or 136)
button(24, sy2, hw2, 56, SNOW.on and "SNOW: ON" or "SNOW: OFF", function() go("snowfx") end,
{ font = "ui10", sub = "speed, density, size", active = SNOW.on, id = "SNOW" })
draw_note(sy2 + 64)
else
ltext(32, ly, "What battery saver changes", "ui10", "bold")
local items = {
"Pack opening and card outlines stand still.",
"Card effects stand still.",
"No drop shadows, so screens draw faster.",
"Enemy answers instantly in battles.",
"Camp timers stop refreshing the screen.",
}
for i, t in ipairs(items) do ltext(40, ly + 30 + (i - 1) * 26, "- " .. fit(t, W - 90, "small", "regular"), "small") end
draw_note(ly + 160)
end
local by = H - 270
if smudge.frame_ms and not CS_SMOOTH then
local d, r = smudge.frame_ms()
if d and r and (d > 0 or r > 0) then ctext(W / 2, by - 38, string.format("Last screen: drawing %d ms, e-ink %d ms", d, r), "small") end
end
smudge.line(24, by - 10, W - 24, by - 10, 1)
ctext(W / 2, by, "Danger zone", "small")
button(24, by + 26, W - 48, 64, confirm_reset and "TAP AGAIN TO ERASE EVERYTHING" or "RESET PROGRESS",
function()
if confirm_reset then
S = new_state(); C.reset_act(); PE = nil; save_now(); confirm_reset = false; note = "Progress erased."
else confirm_reset = true; note = "This erases cards, coins and the camp." end
end, { font = "ui10", off = true })
local hw = (W - 48 - 12) // 2
local cloud = (not smudge.app) and smudge.cloud_sync
local bw = cloud and (W - 48 - 24) // 3 or hw
if smudge.app then
button(24, H - 366, bw, 60, "SYNC WITH READER", function() save_now(); smudge.sync() end,
{ font = "small", sub = "copy your progress", id = "SYNC" })
else
button(24, H - 366, bw, 60, confirm_phone and "TAP TO START" or (cloud and "WI-FI SYNC" or "SYNC WITH PHONE"),
function()
if not smudge.phone_play then
note = "Install the new CardScape firmware to sync with the phone app."
elseif confirm_phone then
confirm_phone = false; save_now(); smudge.phone_play()
else
confirm_phone = true
note = "Opens Wi-Fi. Then tap SYNC in the CardScape app on your phone. The reader restarts when it's done."
end
end, { font = "small", sub = "with the app", active = confirm_phone, id = "SYNC" })
end
if cloud then
button(24 + bw + 12, H - 366, bw, 60, "CLOUD SYNC", function() confirm_phone = false; save_now(); smudge.cloud_sync() end,
{ font = "small", sub = "now", id = "CLOUDNOW" })
local st = smudge.cloud_status and smudge.cloud_status()
local head, line, full = "Cloud sync", "never ran on this reader yet", nil
if st then
local t, when, res = st:match("^(%-?%d+)\t([^\t]*)\t([^\n]*)")
if res then
res = res:gsub("^cloud: ", "")
local ago = ""
local now = tonumber(smudge.time and smudge.time() or 0) or 0
t = tonumber(t) or 0
if t > 1600000000 and now >= t then
local d = now - t
ago = d < 60 and "just now" or (d < 3600 and (d // 60) .. " min ago" or (d < 86400 and (d // 3600) .. " h ago" or (d // 86400) .. " d ago"))
end
local wn = ({ start = "at start", quit = "at quit", sleep = "at sleep", button = "now" })[when] or when
head = "Cloud sync " .. wn .. (ago ~= "" and (", " .. ago) or "")
line = res
full = head .. ": " .. res
end
end
ctext(W / 2, H - 170, head, "small", "bold")
ctext(W / 2, H - 146, fit(line, W - 48, "small", "regular"), "small")
reg("CLOUDSTAT", 24, H - 174, W - 48, 54, function() note = full or (head .. ": " .. line) end, false)
end
button(24 + (cloud and 2 * (bw + 12) or (hw + 12)), H - 366, bw, 60, "QUIT GAME", function() save_now(); smudge.exit() end,
{ font = cloud and "small" or "ui10", sub = cloud and "saves first" or "progress is saved", id = "QUIT" })
button(24, H - 96, W - 48, 64, "BACK", function() confirm_phone = false; go("title") end, { font = "ui10" })
end
SCREENS.camp = function() C.draw_camp(S) end
SCREENS.missions = function() C.draw_missions(S) end
SCREENS.skills = function() C.draw_skills(S) end
SCREENS.skill = function() C.draw_skill(S) end
SCREENS.bank = function() C.draw_bank(S) end
SCREENS.daily = function() C.draw_daily(S) end
SCREENS.expedition = function() C.draw_expedition(S) end
SCREENS.expsend = function() C.draw_expsend(S) end
SCREENS.cardpick = function() C.draw_cardpick(S) end
SCREENS.training = function() C.draw_training(S) end
SCREENS.achieve = function() C.draw_achieve(S) end
SCREENS.gear = function() C.draw_gear(S) end
SCREENS.shop = function() C.draw_shop(S) end
SCREENS.pet = function() C.draw_pet(S) end
