local f = 1 - j / 10
sx, sy = sx - ddy * h * 22 * (1 - f), sy + ddx * h * 22 * (1 - f) + (1 - f) * 8
blob(sx - 1, sy, sx + 1, sy, 1.5 + 2 * f, cr, cg - 30, cb - 30, 0.8 * f)
smudge.glow_circle(sx, sy, 2 + 3 * f, 255, 240, 200, 2.2 * f)
end
end
else
cbeam(0, tot, 3, cr, cg - 40, cb - 40, 0.22 + 0.08 * math.sin(t * 10))
beam(0, tot, 8, cr, cg, cb, 0.75 + 0.15 * math.sin(t * 10))
beam(0, tot, 1.5, 255, 250, 235, 1.4)
for j = 0, 2 do
local d = ((now / 700 + j / 3) % 1) * tot
local px, py = at_d(d)
cbeam(d - 40, d, 3, cr, cg - 20, cb - 20, 0.55)
blob(px - 1, py, px + 1, py, 7, cr, cg - 60, cb - 60, 0.85)
beam(d - 40, d, 5, 255, 250, 230, 1.2)
smudge.glow_circle(px, py, 9, 255, 250, 230, 2.0)
end
end
for r = 1, shownLine.n do
