panel = { 0x432d23, 0xfff0e2 }, pop = { 0xffd7a8, 0x2b1910 }, prog = { 0x68402e, 0xf18a4c }, off = { 0x3b2a22, 0x98745e } } },
{ "dark", "DARK", {
bg = { 0x0a0a0a, 0xf0f0f0 }, face = { 0x1e1e1e, 0xffffff }, ring = { 0x2a2a2a, 0xbdbdbd }, top = { 0xffffff, 0x141414 },
panel = { 0x161616, 0xe8e8e8 }, pop = { 0xffffff, 0x222222 }, prog = { 0x2a2a2a, 0xe0e0e0 }, off = { 0x161616, 0x5a5a5a },
card = { 0x050505, 0xf2f2f2 } } },
{ "retro", "RETRO GREEN", {
bg = { 0x9bbc0f, 0x0f380f }, face = { 0x306230, 0x9bbc0f }, ring = { 0x8bac0f, 0x0f380f }, top = { 0x9bbc0f, 0x0f380f },
panel = { 0x8bac0f, 0x0f380f }, pop = { 0x9bbc0f, 0x0f380f }, prog = { 0x8bac0f, 0x306230 }, off = { 0x8bac0f, 0x306230 } }, mono = true },
{ "classic", "CLASSIC", nil },
}
local theme_i = 1
local CT = { classic = #THEMES, custom = #THEMES + 1, bg = 1, accent = 1, card = 1 }
THEMES[CT.custom] = { "custom", "CUSTOM", true }
CT.bases = {
{ "MIDNIGHT", { 0x192235, 0xe6edf9 } }, { "FOREST", { 0x203126, 0xe7f0df } },
{ "PLUM", { 0x302239, 0xf0e4f5 } }, { "SAND", { 0x403522, 0xf5edcf } },
{ "OCEAN", { 0x17313b, 0xe0f4f4 } }, { "CHARCOAL", { 0x292b30, 0xe8e9ed } },
{ "BURGUNDY", { 0x3a2028, 0xf4e1e5 } }, { "PINE", { 0x1c342f, 0xe1f1e9 } },
}
CT.accents = {
{ "GOLD", { 0x5b4820, 0xffd66e } }, { "CYAN", { 0x28566a, 0x82e5f2 } },
{ "PINK", { 0x66354b, 0xffa9cb } }, { "LIME", { 0x3d5529, 0xc9ef78 } },
{ "VIOLET", { 0x49366c, 0xc8aaff } }, { "CORAL", { 0x6b3d2b, 0xffa477 } },
{ "BLUE", { 0x294b78, 0x9acbff } }, { "MINT", { 0x28594a, 0x91e8c5 } },
}
CT.cards = {
{ "PARCHMENT", { 0x51452f, 0xf3e6c7 } }, { "ICE", { 0x31536a, 0xe0f4ff } },
{ "BLUSH", { 0x684452, 0xffe5ed } }, { "SAGE", { 0x3d5940, 0xe5efd9 } },
{ "LILAC", { 0x51436b, 0xeee5ff } }, { "CREAM", { 0x59422e, 0xfff0d7 } },
{ "SLATE", { 0x3c4653, 0xe3eaf2 } }, { "MINT", { 0x31594f, 0xe0f5ed } },
}
function CT.colors()
local base = CT.bases[CT.bg][2]
local accent = CT.accents[CT.accent][2]
local card = CT.cards[CT.card][2]
return { bg = base, panel = base, face = accent, ring = accent, top = accent, pop = accent, prog = accent, off = base,
card = { card[2], card[1] } }
end
function CT.card_pair(colors)
local a, b = colors.bg[1], colors.bg[2]
local function lum(v) return ((v >> 16) * 3 + ((v >> 8) & 255) * 6 + (v & 255)) end
local light, dark = a, b
if lum(a) < lum(b) then light, dark = b, a end
local function lift(v)
local r, g, bl = v >> 16, (v >> 8) & 255, v & 255
r, g, bl = r + (255 - r) * 0.55, g + (255 - g) * 0.55, bl + (255 - bl) * 0.55
return (math.floor(r) << 16) | (math.floor(g) << 8) | math.floor(bl)
end
return { lift(light), dark }
end
local function apply_theme()
local t = THEMES[theme_i]
STONE = t[3] ~= nil
MONO = t.mono == true
if not t[3] or not smudge.set_tint then return end
local colors = (t[1] == "custom") and CT.colors() or t[3]
local function rgb(v) return v >> 16, (v >> 8) & 255, v & 255 end
for part, k in pairs(TT) do
local c = colors[part]
if not c and part == "card" then c = CT.card_pair(colors) end
local r1, g1, b1 = rgb(c[1]); local r2, g2, b2 = rgb(c[2])
smudge.set_tint(k, r1, g1, b1, r2, g2, b2)
end
end
local function card_tk() return MONO and 8 or ((STONE and smudge.set_tint) and TT.card or 0) end
local HELP_X, HELP_W = 24, 64
local help_open = false
local BFX = { press = nil, rel = nil, rip = nil }
function BFX.live() return CS_SMOOTH and not SAVER end
function BFX.sink(id)
local p = BFX.press
if not p or p.id ~= id then return 0 end
if not BFX.rel and smudge.millis() - p.t > 2500 then BFX.rel = smudge.millis() end
if not BFX.rel then return 1 end
local e = smudge.millis() - BFX.rel
if e < 70 then return 1 - (e / 70) * 1.3 end
if e < 170 then return -0.3 * (1 - (e - 70) / 100) end
return 0
end
function BFX.busy()
local now = smudge.millis()
if BFX.press and not BFX.rel and now - BFX.press.t > 2500 then BFX.rel = now end
if BFX.press and BFX.rel and now - BFX.rel >= 200 then BFX.press, BFX.rel = nil, nil end
if BFX.press then return true end
if FX_RIP and BFX.rip and now - BFX.rip.t < 550 then return true end
return FX_GLINT and (now % 8000) < 2200
end
function BFX.clip(x, y, w, h)
if not smudge.set_clip then return false end
if RCLIP then
local x0, y0 = math.max(x, RCLIP[1]), math.max(y, RCLIP[2])
local x1, y1 = math.min(x + w, RCLIP[1] + RCLIP[3]), math.min(y + h, RCLIP[2] + RCLIP[4])
if x1 <= x0 or y1 <= y0 then return false end
x, y, w, h = x0, y0, x1 - x0, y1 - y0
end
smudge.set_clip(x, y, w, h)
return true
end
function BFX.unclip() if RCLIP then smudge.set_clip(RCLIP[1], RCLIP[2], RCLIP[3], RCLIP[4]) else smudge.set_clip() end end
function BFX.over(x, y, w, h, ring, id, ox, oy)
local now = smudge.millis()
local fx, fy, fw, fh = x + ring + 1, y + ring + 1, w - 2 * ring - 2, h - 2 * ring - 2
local r = BFX.rip
local glint = FX_GLINT and w >= 90 and h >= 44 and BFX.press == nil
local ph = glint and ((now % 8000) - oy * 1.4) or -1
local riping = FX_RIP and r and r.id == id and now - r.t < 550
local pressed = BFX.press and BFX.press.id == id and not BFX.rel
if pressed then smudge.rounded_rect(fx, fy, fw, fh, STONE and 3 or 6, false, 2, true) end
if not riping and not (ph >= 0 and ph < 900) then
if pressed and STONE then ttint(fx, fy, fw, fh, TT.face) end
return
end
if not BFX.clip(fx, fy, fw, fh) then return end
if ph >= 0 and ph < 900 then
local p = math.floor(ph / 900 * (fw + fh + 60)) - 30
if STONE then
smudge.line(fx + p - fh, fy + fh, fx + p, fy, 4, true)
smudge.line(fx + p - fh + 10, fy + fh, fx + p + 10, fy, 1, true)
else
smudge.line(fx + p - fh, fy + fh, fx + p, fy, 2, true)
smudge.line(fx + p - fh + 7, fy + fh, fx + p + 7, fy, 1, true)
end
end
if riping then
local u = (now - r.t) / 550
local rad = math.floor(8 + u * math.max(w, h) * 0.9)
smudge.circle(r.x + (x - ox), r.y + (y - oy), rad, false, u < 0.5 and 4 or 2, true)
if u < 0.4 then smudge.circle(r.x + (x - ox), r.y + (y - oy), math.floor(rad * 0.55), false, 1, true) end
end
if STONE then ttint(fx, fy, fw, fh, TT.face) end
BFX.unclip()
end
function BFX.touch(ev, x, y)
local now = smudge.millis()
if ev == "down" then
BFX.press, BFX.rel = nil, nil
for i = nbtn, 1, -1 do
local bt = btns[i]
if bt.frame == false and smudge.in_rect(x, y, bt.x, bt.y, bt.w, bt.h) then BFX.press = { id = bt.id, x = x, y = y, t = now }; break end
end
elseif ev == "move" then
local p = BFX.press
if p and not BFX.rel and (math.abs(x - p.x) > 12 or math.abs(y - p.y) > 12) then BFX.press = nil end
elseif ev == "release" then
if BFX.press and not BFX.rel then BFX.rel = now end
end
end
function BFX.tap(bt, x, y)
local now = smudge.millis()
BFX.rip = { id = bt.id, x = x, y = y, t = now }
if not BFX.press or BFX.press.id ~= bt.id or not BFX.rel then BFX.press = { id = bt.id, x = x, y = y, t = now }; BFX.rel = now end
end
local function button(x, y, w, h, label, act, o)
o = o or {}
if (o.dot == nil or o.dot == false or o.dot == 0) and C and C.badge_for and S then
local count = C.badge_for(o.target or o.id or label, S)
if count and count > 0 then o.dot = count end
end
if y >= H - 112 and y <= H - 86 and x >= 20 and not o.nohelp then
local s = (W - 48 - HELP_W - 8) / (W - 48)
x = math.floor(HELP_X + HELP_W + 8 + (x - 24) * s + 0.5); w = math.floor(w * s + 0.5)
end
local f = o.font or "ui12"
local ring = (w < 90) and 2 or ((h < 50) and 3 or 6)
local ox, oy, live = x, y, BFX.live() and not o.off
if live then
local k = BFX.sink(o.id or label)
if k ~= 0 then x = x + math.floor(3 * k + 0.5); y = y + math.floor(4 * k + 0.5) end
end
if STONE then
if not o.off and not SAVER then smudge.rounded_rect(ox + 3, oy + 4, w, h, 6, true) end
smudge.rounded_rect(x, y, w, h, 6, true)
if o.off then
dither_rr(x + 2, y + 2, w - 4, h - 4, 4, false)
ttint(x, y, w + 3, h + 4, TT.off, 1)
ttint(x + 2, y + 2, w - 4, h - 4, TT.off, 2)
else
smudge.rounded_rect(x + 2, y + 2, w - 4, h - 4, 4, true, 1, false)
if ring == 6 then
smudge.rect_dither(x + 3, y + 3, w - 6, 3, false)
smudge.rect_dither(x + 3, y + h - 6, w - 6, 3, true)
smudge.rect_dither(x + 3, y + 6, 3, h - 12, false)
smudge.rect_dither(x + w - 6, y + 6, 3, h - 12, true)
smudge.line(x + 3, y + 3, x + w - 4, y + 3, 1, false)
end
if ring == 6 then smudge.rect(x + ring, y + ring, w - 2 * ring, h - 2 * ring, false, 1)
else smudge.rounded_rect(x + ring, y + ring, w - 2 * ring, h - 2 * ring, 6 - ring, false, 1, false) end
ttint(x, y, w + 3, h + 4, TT.ring, 1)
ttint(x + 2, y + 2, w - 4, h - 4, TT.ring, 2)
ttint(x + ring + 1, y + ring + 1, w - 2 * ring - 2, h - 2 * ring - 2, TT.face)
end
if o.active then
if ring == 6 then smudge.rect(x + ring, y + ring, w - 2 * ring, h - 2 * ring, false, 2)
else smudge.rounded_rect(x + ring, y + ring, w - 2 * ring, h - 2 * ring, 6 - ring, false, 2, false) end
smudge.rect(x + ring + 3, y + ring + 3, w - 2 * ring - 6, h - 2 * ring - 6, false, 1)
end
else
if not o.off and not SAVER then smudge.rounded_rect(ox + 4, oy + 5, w, h, 10, true) end
smudge.rounded_rect(x, y, w, h, 10, true, 1, false)
if o.off then dither_rr(x + 1, y + 1, w - 2, h - 2, 9, false) end
smudge.rounded_rect(x, y, w, h, 10, false, o.off and 1 or 2)
if o.active then smudge.rounded_rect(x + 5, y + 5, w - 10, h - 10, 7, false, 1) end
end
local function lbl(cx, ty, t, ft, st) ctext(cx, ty, t, ft, st) end
local inset = STONE and (ring + ((w < 90) and 1 or 2)) or 6
local cx, maxw = x + w / 2, w - 2 * inset
if o.icon then cx = x + o.icon + (w - o.icon) / 2; maxw = w - o.icon - inset - 4 end
local roomh = h - 2 * inset + 4
local function shrink() if f == "bitter14" then f = "ui12" elseif f == "ui12" then f = "ui10" elseif f == "ui10" then f = "small" else return false end return true end
while tw(label, f, "bold") > maxw and shrink() do end
while o.sub and lh(f) + lh("small") + 2 > roomh and shrink() do end
local lst = "bold"
if tw(label, f, "bold") > maxw then lst = "regular" end
if CS_CUTLOG and tw(label, f, lst) > maxw then CS_CUTLOG[#CS_CUTLOG + 1] = scr .. ": " .. label end
label = fit(label, maxw, f, lst)
if o.sub then
local l1, l2 = lh(f), lh("small")
local y1 = y + (h - l1 - l2 - 2) // 2
if CS_CUTLOG and tw(o.sub, "small", o.off and "bold" or "regular") > maxw then CS_CUTLOG[#CS_CUTLOG + 1] = scr .. ": " .. o.sub end
local sub = fit(o.sub, maxw, "small", o.off and "bold" or "regular")
lbl(cx, y1, label, f, lst)
lbl(cx, y1 + l1 + 2, sub, "small", o.off and "bold" or "regular")
else
lbl(cx, y + (h - lh(f)) // 2, label, f, lst)
end
if live then BFX.over(x, y, w, h, STONE and ring or 4, o.id or label, ox, oy) end
reg(o.id or label, ox, oy, w, h, act, false)
if o.dot and o.dot ~= 0 and o.dot ~= false then
local dx, dy = x + w - 8, y + 8
smudge.circle(dx, dy, 13, true, 1, false)
smudge.circle(dx, dy, 11, true)
local s = (type(o.dot) == "number") and tostring(math.min(9, o.dot)) or "!"
ctext(dx, dy - lh("small") // 2, s, "small", "bold", true)
badge_tint(dx, dy, 11)
end
end
local function bell(x, y, n, id, act, light)
if light then smudge.invert_rect(x + 4, y + 3, 32, 32) end
smudge.draw_sprite(x + 4, y + 3, 32, 32, "art/ui_bell.raw")
if light then smudge.invert_rect(x + 4, y + 3, 32, 32) end
if act then reg(id or "INBOX", x, y, 40, 38, act, false) end
if n and n > 0 then
smudge.circle(x + 38, y + 4, 12, true, 1, false)
smudge.circle(x + 38, y + 4, 10, true)
ctext(x + 38, y + 4 - lh("small") // 2, tostring(math.min(9, n)), "small", "bold", true)
badge_tint(x + 38, y + 4, 10)
end
end
local BAR_H = 46
local function bar_pad()
local p = 4
if smudge.get_metrics then local m = smudge.get_metrics(); if m and m.top_padding then p = m.top_padding end end
return p
end
local function top_bar(t, s2)
local pad = bar_pad()
reg("TOPBAR", 0, 0, W, pad + BAR_H + 2, function() if C and C.toggle_drop then C.toggle_drop() end end, false)
local subw = (s2 and s2 ~= "") and (tw(s2, "small") + 16) or 0
if STONE then
smudge.rect(0, 0, W, pad + BAR_H + 2, true)
smudge.rect_dither(0, pad + BAR_H - 2, W, 2, false)
ttint(0, 0, W, pad + BAR_H + 3, TT.top)
ltext(16, pad + 8, fit(t or "", W - 86 - subw, "ui12", "bold"), "ui12", "bold", true)
if subw > 0 then ltext(W - 66 - tw(s2, "small"), pad + 12, s2, "small", "regular", true) end
bell(W - 54, pad + 4, (C and C.unread) and C.unread() or 0, nil, nil, true)
smudge.line(0, pad + BAR_H + 2, W, pad + BAR_H + 2, 1)
return
end
ltext(16, pad + 8, fit(t or "", W - 86 - subw, "ui12", "bold"), "ui12", "bold")
if subw > 0 then rtext(W - 66, pad + 12, s2, "small") end
bell(W - 54, pad + 4, (C and C.unread) and C.unread() or 0)
smudge.line(0, pad + BAR_H, W, pad + BAR_H, 2)
end
local function draw_focus()
if not use_focus or nbtn == 0 then return end
if focus > nbtn then focus = 1 end
local b = btns[focus]
if not b then return end
if b.frame then smudge.rounded_rect(b.x - 4, b.y - 4, b.w + 8, b.h + 8, 10, false, 3)
else smudge.invert_rect(b.x, b.y, b.w, b.h) end
end
local note_seen, note_at = "", 0
local NOTE_MS = 2600
local function draw_note(y) end
local function draw_popup()
if note == "" then note_seen = ""; return end
if note ~= note_seen then note_seen = note; note_at = smudge.millis() end
local f = "small"
local maxw = W - 100
local res = smudge.wrapped_text(note, maxw, f, "bold", 3)
local n = #res.lines
local lw = 0
for _, l in ipairs(res.lines) do lw = math.max(lw, tw(l, f, "bold")) end
local bw = math.min(W - 40, lw + 36)
local bh = n * (lh(f) + 2) + 20
local bx, by = (W - bw) // 2, H - 112 - bh - 10
if not SAVER then smudge.rounded_rect(bx + 3, by + 4, bw, bh, 12, true) end
smudge.rounded_rect(bx - 2, by - 2, bw + 4, bh + 4, 14, true, 1, false)
smudge.rounded_rect(bx, by, bw, bh, 12, true)
for i, l in ipairs(res.lines) do ctext(W / 2, by + 10 + (i - 1) * (lh(f) + 2), l, f, "bold", true) end
ttint(bx - 2, by - 2, bw + 7, bh + 8, TT.pop, 1)
ttint(bx + 5, by + 5, bw - 10, bh - 10, TT.pop, 2)
end
local function bar(x, y, w, h, frac)
smudge.rect_dither(x + 2, y + 2, w - 4, h - 4, false)
smudge.rect(x, y, w, h, false, 2)
if not SAVER then
smudge.rect(x + w, y + 3, 3, h, true)
smudge.rect(x + 3, y + h, w, 3, true)
end
if frac > 0 then
local fw = math.max(3, math.floor((w - 6) * math.min(1, frac)))
smudge.rect(x + 3, y + 3, fw, h - 6, true)
end
ttint(x + 2, y + 2, w - 4, h - 4, TT.prog)
end
local function glyph(x, y, name, px) smudge.draw_sprite(x - px // 2, y - px // 2, px, px, "art/" .. name .. ".raw") end
local function icon_coin(x, y) glyph(x, y, "ui_coin", 24) end
local function icon_gem(x, y) glyph(x, y, "ui_gem", 24) end
local function icon_heart(x, y) glyph(x, y, "ui_heart", 24) end
local function icon_sword(x, y) glyph(x, y, "ui_sword", 24) end
local function chip(x, y, e) glyph(x, y, "e" .. (e - 1), 32) end
local function res_bar(y)
icon_coin(36, y + 14); ltext(54, y + 2, short(S.coins), "ui10", "bold")
icon_gem(150, y + 14); ltext(168, y + 2, short(S.dust), "ui10", "bold")
rtext(W - 24, y + 2, string.format("Cards %d/%d", found_count(), D.ncards), "ui10", "bold")
end
local function art_path(c, big)
local v = 0
if tier_of(c) == 5 and not SAVER then v = anim_v end
local k = big and "l" or "s"
if v > 0 then return string.format("art/%s%02d_%d.raw", k, c - 1, v) end
return string.format("art/%s%02d.raw", k, c - 1)
end
local TMODE = { ink = 1, paper = 2, both = 3 }
local function tint(x, y, w, h, t, mode)
if MONO then return end
if smudge.tint and not SAVER then smudge.tint(x, y, w, h, t + 1, TMODE[mode or "both"]) end
end
local function card_frame(x, y, w, h, t)
if not SAVER then smudge.rounded_rect(x + 4, y + 5, w, h, 8, true) end
smudge.rounded_rect(x, y, w, h, 8, true, 1, false)
smudge.rounded_rect(x, y, w, h, 8, false, 2)
if t >= 1 then smudge.rounded_rect(x + 4, y + 4, w - 8, h - 8, 5, false, 1) end
if t >= 2 then
smudge.circle(x + 11, y + 11, 3, true); smudge.circle(x + w - 11, y + 11, 3, true)
smudge.circle(x + 11, y + h - 11, 3, true); smudge.circle(x + w - 11, y + h - 11, 3, true)
end
if t == 3 or t == 4 then smudge.rounded_rect(x - 3, y - 3, w + 6, h + 6, 10, false, 1) end
if t == 4 or t == 6 then
smudge.rounded_rect(x - 6, y - 6, w + 12, h + 12, 12, false, 1)
for _, p in ipairs({ { x - 3, y - 3 }, { x + w + 3, y - 3 }, { x - 3, y + h + 3 }, { x + w + 3, y + h + 3 } }) do
smudge.triangle(p[1], p[2] - 7, p[1] - 7, p[2], p[1] + 7, p[2], true)
smudge.triangle(p[1], p[2] + 7, p[1] - 7, p[2], p[1] + 7, p[2], true)
end
end
if t >= 5 then
smudge.rounded_rect(x - 3, y - 3, w + 6, h + 6, 10, false, 1)
local u = w // 8
smudge.rect(x - 8, y + u * 2, 9, 3, true); smudge.rect(x + w - 1, y + u * 4, 9, 3, true)
smudge.rect(x + u * 3, y - 7, 14, 3, true); smudge.rect(x + u * 5, y + h + 4, 14, 3, true)
smudge.rect(x - 6, y + h - u * 2, 7, 3, true); smudge.rect(x + w, y + u, 7, 3, true)
end
if smudge.tint and not SAVER then smudge.tint(x, y, w, h, card_tk(), 3) end
end
local function card_back(x, y, w, h)
smudge.rect_dither(x, y, w, h, false)
if smudge.tint and not SAVER then smudge.tint(x, y, w, h, card_tk(), 3) end
local cx, cy = x + w // 2, y + h // 2
smudge.circle(cx, cy, 22, true, 1, false)
smudge.circle(cx, cy, 22, false, 2)
ctext(cx, cy - lh("ui12") // 2, "?", "ui12", "bold")
end
local sparkle
local function glass(x, y, sz)
local function band(a, w, flip)
local p = { { a, 0 }, { a + w, 0 }, { 0, a + w }, { 0, a } }
for _, q in ipairs(p) do if flip then q[1], q[2] = sz - q[1], sz - q[2] end end
local function P(k) return x + math.floor(p[k][1]), y + math.floor(p[k][2]) end
local x1, y1 = P(1); local x2, y2 = P(2); local x3, y3 = P(3); local x4, y4 = P(4)
smudge.triangle(x1, y1, x2, y2, x3, y3, true, 1, false)
smudge.triangle(x1, y1, x3, y3, x4, y4, true, 1, false)
smudge.line(x1, y1, x4, y4, 1); smudge.line(x2, y2, x3, y3, 1)
end
band(sz * 0.12, sz * 0.10)
band(sz * 0.27, sz * 0.04)
band(sz * 0.10, sz * 0.05, true)
smudge.rect(x - 1, y - 1, sz + 2, sz + 2, false, 1)
smudge.rect(x + 3, y + 3, sz - 6, sz - 6, false, 1)
smudge.line(x + 1, y + 1, x + sz - 3, y + 1, 1, false)
smudge.line(x + 1, y + 1, x + 1, y + sz - 3, 1, false)
end
local function thumb(x, y, c, o)
o = o or {}
card_frame(x, y, 108, 108, tier_of(c))
if o.show or owned(c) then
smudge.draw_sprite(x + 6, y + 6, 96, 96, o.art or art_path(c, false))
if smudge.tint and not SAVER then smudge.tint(x + 6, y + 6, 96, 96, card_tk(), 3) end
else
card_back(x + 8, y + 8, 92, 92)
end
if S.shiny[c] == 1 and (owned(c) or o.show) then glass(x + 6, y + 6, 96); sparkle(x + 16, y + 16, 9) end
if o.name then
local s = (owned(c) or o.show) and cname(c) or "???"
ctext(x + 54, y + 112, fit(s, 108, "small", "regular"), "small", "regular")
end
if o.pips and owned(c) then
for i = 1, 5 do smudge.circle(x + 30 + (i - 1) * 12, y + 140, 4, i <= S.lvl[c], 1) end
end
if GR and owned(c) then GR.badge(x + 2, y + 2, c) end
if o.badge and S.spare[c] > 0 then
local bx, by = x + 96, y + 12
smudge.circle(bx, by, 14, true)
ctext(bx, by - lh("small") // 2, S.spare[c] > 9 and "9+" or tostring(S.spare[c]), "small", "bold", true)
badge_tint(bx, by, 14)
end
end
local function bigcard(x, y, c, show)
card_frame(x, y, 208, 208, tier_of(c))
if show then
smudge.draw_sprite(x + 8, y + 8, 192, 192, art_path(c, true))
if smudge.tint and not SAVER then smudge.tint(x + 8, y + 8, 192, 192, card_tk(), 3) end
else card_back(x + 12, y + 12, 184, 184) end
if show and GR then GR.badge(x + 4, y + 4, c, true) end
end
sparkle = function(cx, cy, r)
local w = math.max(2, r // 5)
local h = math.max(3, math.floor(r * 0.62))
smudge.triangle(cx, cy - r, cx - w, cy, cx + w, cy, true)
smudge.triangle(cx, cy + r, cx - w, cy, cx + w, cy, true)
smudge.triangle(cx - h, cy, cx, cy - w, cx, cy + w, true)
smudge.triangle(cx + h, cy, cx, cy - w, cx, cy + w, true)
if r >= 10 then
local d = r // 2
smudge.line(cx - d, cy - d, cx + d, cy + d, 1); smudge.line(cx - d, cy + d, cx + d, cy - d, 1)
end
end
local gs = 1
local function lcg31(a, m, c)
a = a % 2147483648
local ah, al = (a // 65536) + 0.0, (a % 65536) + 0.0
local v = ((ah * m) % 32768 * 65536 + al * m + c) % 2147483648
return math.tointeger(v) or math.floor(v)
end
local function gseed(n) gs = lcg31(n, 2654435761, 12345) end
local function grand(n) gs = lcg31(gs, 1103515245, 12345); return (gs // 65536) % n end
local function glitch_bands(x, y, w, h, t, n)
gseed(t * 7 + 3)
for _ = 1, n do
local by = y + grand(math.max(1, h - 8))
local bh = 3 + grand(11)
local bx = x - 14 + grand(14)
smudge.invert_rect(bx, by, w + 28 - grand(14), math.min(bh, y + h - by))
end
end
local function glitch_blocks(x, y, w, h, t, n)
gseed(t * 13 + 5)
for _ = 1, n do
local bx, by = x - 18 + grand(w + 36), y - 14 + grand(h + 28)
smudge.rect(bx, by, 4 + grand(14), 2 + grand(4), true)
end
end
local function logo_back(x, y, w, h)
card_frame(x, y, w, h, 2)
smudge.rect_dither(x + 10, y + 10, w - 20, h - 20, true)
if w < 150 then
smudge.line(x + w // 2, y + 18, x + w // 2, y + h - 18, 2, false)
return
end
smudge.rounded_rect(x + 16, y + 16, w - 32, h - 32, 6, false, 2, false)
local cx, cy = x + w // 2, y + h // 2 - 12
smudge.circle(cx, cy, 50, true, 1, false)
smudge.circle(cx, cy, 50, false, 3)
smudge.circle(cx, cy, 42, false, 1)
smudge.triangle(cx, cy - 34, cx - 30, cy + 17, cx + 30, cy + 17, false, 3)
smudge.triangle(cx, cy + 34, cx - 30, cy - 17, cx + 30, cy - 17, false, 3)
smudge.circle(cx, cy, 8, true)
local bw = math.min(w - 44, 176)
smudge.rounded_rect(cx - bw // 2, y + h - 52, bw, 30, 6, true, 1, false)
smudge.rounded_rect(cx - bw // 2, y + h - 52, bw, 30, 6, false, 2)
ctext(cx, y + h - 52 + (30 - lh("small")) // 2, "CARDSCAPE", "small", "bold")
end
local function deck_art(x, y)
smudge.draw_sprite(W // 2 - 148, y - 2, 296, 224, "art/pack_shelf.raw")
end
local anim_t = 0
local function perim(u, x0, y0, sz)
u = u % (4 * sz)
if u < sz then return x0 + u, y0 end
if u < 2 * sz then return x0 + sz, y0 + (u - sz) end
if u < 3 * sz then return x0 + sz - (u - 2 * sz), y0 + sz end
return x0, y0 + sz - (u - 3 * sz)
end
local function mythic_aura(cx0, cy0, t)
local m, sz = 12, 208 + 24
local x0, y0 = cx0 - m, cy0 - m
gseed(t * 11 + 1)
for e = 0, 3 do
if e <= t then
local off = grand(9) - 4
local gap, glen = 16 + grand(140), 12 + grand(34)
local a = x0 + gap
if e == 0 then
smudge.line(x0, y0 + off, a, y0 + off, 3); smudge.line(a + glen, y0 + off, x0 + sz, y0 + off, 3)
elseif e == 1 then
smudge.line(x0 + sz + off, y0, x0 + sz + off, y0 + gap, 3); smudge.line(x0 + sz + off, y0 + gap + glen, x0 + sz + off, y0 + sz, 3)
elseif e == 2 then
smudge.line(x0 + sz, y0 + sz + off, a, y0 + sz + off, 3); smudge.line(a - glen, y0 + sz + off, x0, y0 + sz + off, 3)
else
smudge.line(x0 + off, y0 + sz, x0 + off, y0 + gap, 3); smudge.line(x0 + off, y0 + gap - glen, x0 + off, y0, 3)
end
end
end
glitch_bands(cx0, cy0, 208, 208, t, 2 + t % 3)
glitch_blocks(x0, y0, sz, sz, t, 9)
gseed(t * 17 + 7)
for z = 0, 5 do
if grand(10) < 7 then
local by, bh = cy0 + 8 + z * 32 + grand(24), 3 + grand(9)
bh = math.min(bh, cy0 + 200 - by)
local sh = grand(41) - 20
local x1 = math.max(cx0 + 8, cx0 + 8 + sh)
local w1 = math.min(cx0 + 200, cx0 + 200 + sh) - x1
smudge.invert_rect(x1, by, w1, bh)
if sh > 0 then smudge.rect(cx0 + 8, by, sh, bh, true) elseif sh < 0 then smudge.rect(cx0 + 200 + sh, by, -sh, bh, true) end
end
end
for _ = 1, 4 do
local by = cy0 + 8 + grand(190)
smudge.rect(cx0 + 8 + grand(40), by, 120 + grand(72), 2, true)
end
end
local function card_aura(cx0, cy0, t, tier)
if tier == 5 then mythic_aura(cx0, cy0, CS_SMOOTH and math.floor(t / 2) or t); return end
if tier >= 6 then tier = 4 end
local m, sz = 12, 208 + 24
local x0, y0 = cx0 - m, cy0 - m
local th = 2 + math.min(tier, 2) + ((tier == 4) and 1 or 0)
local sw = 5
local n = math.min(1, t / sw)
local reach = n * 2 * sz
local step = 12
local px, py = perim(0, x0, y0, sz)
local qx, qy = px, py
local d = step
while d <= reach + 0.1 do
local ax, ay = perim(d, x0, y0, sz)
smudge.line(px, py, ax, ay, th)
local bx, by = perim(-d, x0, y0, sz)
smudge.line(qx, qy, bx, by, th)
px, py, qx, qy = ax, ay, bx, by
d = d + step
end
if tier >= 2 and t > sw then
local stars = (tier == 4) and 5 or ((tier == 3) and 3 or 1)
local speed = (tier == 4) and 66 or ((tier == 3) and 52 or 40)
local head = (t - sw) * speed
for k = 0, stars - 1 do
local u = head + k * (4 * sz) / stars
for j = 1, 4 do
local tx, ty = perim(u - j * 15, x0, y0, sz)
smudge.circle(math.floor(tx), math.floor(ty), 5 - j, true)
end
local hx, hy = perim(u, x0, y0, sz)
sparkle(math.floor(hx), math.floor(hy), (tier >= 3) and 20 or 15)
end
end
end
local function wrapped(x, y, text, maxw, f, maxlines)
local res = smudge.wrapped_text(text, maxw, f, "regular", maxlines)
local l = lh(f)
for i, line in ipairs(res.lines) do ltext(x, y + (i - 1) * (l + 2), line, f) end
return y + #res.lines * (l + 2)
end
local function save_show() smudge.save("show", table.concat(SHOW, ";")) end
local function load_show()
local raw = smudge.load("show", "") or ""
local t = {}
for v in raw:gmatch("%d+") do t[#t + 1] = tonumber(v) end
if #t == 4 then
for i = 1, 4 do if t[i] < 1 or t[i] > D.ncards then return end end
SHOW = t
end
end
local function show_best()
local list = {}
for c = 1, D.ncards do if owned(c) then list[#list + 1] = c end end
table.sort(list, function(a, b)
local ta, tb = tier_of(a), tier_of(b)
if ta ~= tb then return ta > tb end
local sa, sb = S.shiny[a] == 1 and 1 or 0, S.shiny[b] == 1 and 1 or 0
if sa ~= sb then return sa > sb end
if S.lvl[a] ~= S.lvl[b] then return S.lvl[a] > S.lvl[b] end
return a < b
end)
for i = 1, 4 do if list[i] then SHOW[i] = list[i] end end
save_show()
end
