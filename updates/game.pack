{ "Wilderness K/D", cp.x.wk .. " / " .. cp.x.wd }, { "Trawler trips", tostring(cp.x.trawl) },
{ "Best BA wave", tostring(cp.x.bab) }, { "Collection log", log_count(cp) .. " / " .. NLOG }, { "Random events", tostring(cp.x.rev) },
}
