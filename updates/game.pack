end
function C.draw_cardpick(S)
local cp = S.camp
local train = (C.pick_back == "training")
local petmode = (C.pick_back == "pet")
local wmode = (C.pick_back == "workers")
head(S, wmode and "Assign a worker" or (petmode and "Choose your pet" or (train and "Train which card?" or "Send which card?")), "")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
X.swipe_tabs(function() return cpage end, function(t) cpage = t end, 0, 6)
for i = 0, 6 do
local n, tot = X.grid_count(i)
X.button(6 + i * 67, TOP + 6, 63, 56, tabs[i + 1], function() if cpage == i then X.grid_flip("cpick", i) end; cpage = i end, { font = "small", sub = n .. "/" .. tot, active = (cpage == i), id = "TAB" .. i })
end
local y0 = TOP + 80
X.grid("cpick", cpage, y0, 2, 164, function(c, x, y)
X.thumb(x, y, c, { name = true })
if X.owned(c) and exp_busy(cp, c) and not train then X.ctext(x + 54, y + 132, "away", "small", "bold") end
if train and X.owned(c) then X.ctext(x + 54, y + 132, "Lv " .. X.lvl(c), "small", "bold") end
X.reg("card" .. c, x, y, 108, 150, function()
if not X.owned(c) then X.set_note("You do not own that card yet."); return end
if X.card_away(c) then X.set_note(X.cname(c) .. " is away for grading: back within 30 minutes."); return end
if wmode then
ADV.G.set_worker(S, c); X.go("workers")
elseif petmode then
cp.pet = c; X.set_note(X.cname(c) .. " is now your pet."); X.save_now(); X.go("pet")
elseif train then
if X.lvl(c) >= 5 then X.set_note("That card is already max level."); return end
train_c = c; X.go("training")
else
if exp_busy(cp, c) then X.set_note("That card is already away."); return end
pick_card = c; X.go("expsend")
end
end, true)
end)
X.draw_note(y0 + 2 * 164 + 6)
back_btn(wmode and "workers" or (petmode and "pet" or (train and "training" or "expedition")))
end
