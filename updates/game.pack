X.ltext(156, TOP + 74, "item on every gather", "small")
X.ltext(156, TOP + 104, "Higher tier cards", "small")
X.ltext(156, TOP + 126, "help more.", "small")
else
X.ctext(W / 2, TOP + 70, "No pet yet.", "ui12", "bold")
X.ctext(W / 2, TOP + 110, "A card follows you around camp", "small")
X.ctext(W / 2, TOP + 132, "and sometimes finds extra loot.", "small")
end
X.button(24, TOP + 208, W - 48, 70, "CHOOSE PET", function() C.pick_back = "pet"; cpage = 0; X.go("cardpick") end, { font = "ui10", id = "CHOOSEPET" })
X.button(24, TOP + 288, W - 48, 60, "SEND PET HOME", function() cp.pet = 0; X.set_note("Your pet went home."); X.save_now() end,
{ font = "ui10", off = cp.pet == 0, id = "NOPET" })
X.draw_note(TOP + 360)
