{ "INSTANCES", get("tok") .. " tokens, " .. get("ik") .. " kills", "instance" },
{ "IRON MODE", R.iron() and "ON" or "off", "iron" },
{ "MEGA PETS", nm .. " / 16", "megapets" },
}
local sp = rows_sp(y + 28, #list, 82)
for k, b in ipairs(list) do
X.button(24, y + 28 + (k - 1) * sp, W - 48, sp - 8, b[1], function() X.go(b[3]) end,
{ sub = b[2], id = b[1], dot = b[4] })
end
back_btn("rewards")
end
function C.draw_login(S)
head(S, "Daily login", "day " .. get("ls") .. " / 28")
local y = TOPY() + 6
local cw, ch = (W - 40) // 7, 70
local s = get("ls")
local nextd = login_ready() and (s % 28 + 1) or 0
for d = 1, 28 do
local col, row = (d - 1) % 7, (d - 1) // 7
local x, by = 20 + col * cw, y + row * (ch + 6)
local done = (d <= s) and not (nextd ~= 0 and s == 28)
if d == nextd then smudge.rounded_rect(x + 2, by, cw - 4, ch, 6, true)
else smudge.rounded_rect(x + 2, by, cw - 4, ch, 6, false, (d == 28) and 3 or 1) end
X.ctext(x + cw // 2, by + 4, tostring(d), "small", "bold", d == nextd)
X.ctext(x + cw // 2, by + 30, LOGIN[d][1], "small", (d == 28) and "bold" or nil, d == nextd)
if done and d ~= nextd then
smudge.line(x + cw - 24, by + ch - 14, x + cw - 18, by + ch - 8, 3)
smudge.line(x + cw - 18, by + ch - 8, x + cw - 8, by + ch - 22, 3)
end
end
local by = y + 4 * (ch + 6) + 10
X.button(24, by, W - 48, 76, login_ready() and ("CLAIM DAY " .. nextd) or "CLAIMED TODAY", function() login_claim(S) end,
{ off = not login_ready(), sub = login_ready() and ("reward: " .. LOGIN[nextd][1]) or "come back tomorrow", id = "LOGINCLAIM", dot = login_ready() and "!" or nil })
X.wrapped(30, by + 90, "Log in every day. Day 28 is the big chest (Mythic box, Gold box, 3 RARE tickets, 500 dust), then the calendar starts again. Missing a day only sets you back 3 days.", W - 60, "small", 4)
X.draw_note(by + 190)
back_btn("perks")
end
local ppage, pconfirm = 0, 0
function C.draw_prestige(S)
local cp = S.camp
head(S, "Prestige", "max " .. PMAX)
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "At 99: reset to 1 for +5% xp and +5% drops, forever.", "small")
local per = 10
local pages = math.ceil(#SK / per)
local sp = rows_sp(y0 + 26, per + 1, 60)
local function prrow(si, by)
if SK[si] then
local p, lv = get("p" .. si), lvl(cp, si)
panel(20, by, W - 40, sp - 6)
sprite(28, by + (sp - 6 - 32) // 2, 32, "sk" .. (si - 1))
X.ltext(68, by + 4, SK[si].name, "small", "bold")
X.ltext(68, by + sp - 30, "Lv " .. lv .. "   " .. (p > 0 and (string.rep("*", p) .. " +" .. 5 * p .. "%") or "no prestige"), "small")
local ok = lv >= 99 and p < PMAX
local lab = (pconfirm == si) and "SURE?" or (p >= PMAX and "MAX" or "PRESTIGE")
X.button(W - 24 - 130, by + 4, 120, sp - 14, lab, function()
if pconfirm == si then pconfirm = 0; do_prestige(S, si) else pconfirm = si; X.set_note("Tap again: " .. SK[si].name .. " goes back to level 1.") end
end, { font = "small", off = not ok, active = pconfirm == si, id = "PRES" .. si, dot = ok and "!" or nil })
end
end
local ny = y0 + 26 + per * sp
if not X.list("prestige", y0 + 26, nil, #SK, sp, prrow) then
for k = 1, per do prrow(ppage * per + k, y0 + 26 + (k - 1) * sp) end
X.button(24, ny, 140, 44, "PREV", function() ppage = math.max(0, ppage - 1); pconfirm = 0 end, { font = "small", off = ppage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (ppage + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 44, "NEXT", function() ppage = math.min(pages - 1, ppage + 1); pconfirm = 0 end, { font = "small", off = ppage >= pages - 1, id = "NEXT" })
end
back_btn("skills")
end
function C.draw_luck(S)
local cp = S.camp
head(S, "Luck gear", "+" .. fl(R.luck() * 100 + 0.5) .. "% luck")
local y = TOPY() + 6
for k, g in ipairs(LUCK) do
local by = y + (k - 1) * 180
local L = get(g.key)
panel(20, by, W - 40, 170)
X.ltext(34, by + 10, g.name .. (L > 0 and (" +" .. L) or " (not made)"), "ui12", "bold")
X.ltext(34, by + 46, "Luck +" .. (2 * L) .. "%   (max +20%)", "ui10", "bold")
for s = 1, 10 do
local sx = 34 + (s - 1) * 22
if s <= L then smudge.rect(sx, by + 78, 18, 14, true) else smudge.rect(sx, by + 78, 18, 14, false, 1) end
end
if L < 10 then
local c, sc, sd, du = luck_cost(L)
local mat = (g.mat == "scale") and (sc .. " Boss scales") or (sd .. " stardust")
X.ltext(34, by + 104, string.format("Next: %d coins, %d dust", c, du), "small")
X.ltext(34, by + 128, "+ " .. mat, "small")
X.button(W - 24 - 150, by + 100, 140, 58, L == 0 and "MAKE" or "UPGRADE", function() luck_up(S, k) end, { font = "ui10", id = "LUCK" .. k })
else
X.ltext(34, by + 104, "Fully upgraded!", "small", "bold")
end
end
X.wrapped(30, y + 366, "Luck makes rare rolls easier: boss uniques, raid purples, pets, mega pets, Pyromancer pieces, the rare prizes in boxes and the forge. Iron Mode adds +5%.", W - 60, "small", 4)
X.draw_note(y + 460)
back_btn("perks")
end
function C.draw_titles(S)
local cp = S.camp
local cur = R.title(cp)
head(S, "Titles", cur or "")
local y0 = TOPY() + 4
local n = #KC + 1
local sp = rows_sp(y0, n, 80)
for k = 1, n do
local by = y0 + (k - 1) * sp
panel(20, by, W - 40, sp - 6)
local t = title_of(cp, k)
if k <= #KC then
local e = KC[k]
local cnt, tier = kc_count(cp, e.key), kc_tier(cp, e.key)
local nxt = e.ms[tier + 1]
X.ltext(34, by + 4, e.name .. "  KC " .. cnt, "small", "bold")
X.ltext(34, by + sp - 30, (t or ("next title at " .. e.ms[1])) .. (tier > 0 and ("  +" .. 2 * tier .. "%") or "") .. (nxt and tier > 0 and ("  next " .. nxt) or ""), "small")
else
X.ltext(34, by + 4, "Iron Mode", "small", "bold")
X.ltext(34, by + sp - 30, R.iron() and "Ironman" or "turn Iron Mode on", "small")
end
X.button(W - 24 - 120, by + 4, 110, sp - 14, get("title") == k and "WORN" or "WEAR", function()
if get("title") == k then V.title = 0 else V.title = k end; save()
end, { font = "small", off = not t, active = get("title") == k, id = "TITLE" .. k })
end
back_btn("perks")
end
function C.draw_instance(S)
local cp = S.camp
head(S, "Instances", get("tok") .. " tokens")
local y = TOPY() + 4
panel(20, y, W - 40, 92)
X.ltext(34, y + 8, "Kills left: " .. get("ik"), "ui12", "bold")
X.wrapped(34, y + 40, "1 token = 10 boss kills, any time.", W - 220, "small", 2)
X.button(W - 24 - 150, y + 12, 140, 68, "USE TOKEN", function()
if get("tok") < 1 then X.set_note("No Instance tokens."); return end
add("tok", -1); add("ik", 10); X.set_note("Instance open: 10 kills."); X.save_now()
end, { font = "small", sub = "+10 kills", off = get("tok") < 1, id = "USETOKEN", dot = (get("tok") > 0 and get("ik") == 0) and "!" or nil })
local list = inst_bosses()
local sp = math.min(108, (H - 104 - (y + 100)) // #list)
for k, b in ipairs(list) do
local by = y + 100 + (k - 1) * sp
panel(20, by, W - 40, sp - 6)
local az = math.min(96, sp - 10)
smudge.draw_sprite(28, by + 2, 96, az, string.format("art/ms%02d.raw", b.m))
smudge.rect(27, by + 1, 98, az + 2, false, 2)
X.ltext(136, by + 8, b.name, "ui10", "bold")
X.ltext(136, by + 38, "Weak to " .. ({ "MELEE", "RANGED", "MAGIC" })[b.weak], "small")
X.ltext(136, by + 60, "KC " .. kc_count(cp, b.kc), "small", "bold")
X.button(210, by + 52, 90, 32, "DROPS", function() ADV.show_drops(inst_drops(cp, k)) end, { font = "small", id = "IDROPS" .. k, nohelp = true })
X.button(W - 24 - 120, by + 10, 110, sp - 26, "FIGHT", function() inst_fight(S, k) end, { font = "ui10", off = get("ik") < 1, id = "IFIGHT" .. k })
end
X.draw_note(y + 100 + #list * sp)
back_btn("perks")
end
local iconfirm = false
function C.draw_iron(S)
head(S, "Iron Mode", R.iron() and "ON" or "off")
local y = TOPY() + 6
panel(20, y, W - 40, 300)
X.ltext(34, y + 10, R.iron() and "You are an Ironman" or "Become an Ironman?", "ui12", "bold")
local hx, hy = W - 100, y + 14
smudge.rounded_rect(hx, hy, 56, 60, 14, true)
smudge.rect(hx + 10, hy + 26, 36, 8, true, 1, false)
smudge.rect(hx + 26, hy + 34, 4, 22, true, 1, false)
X.wrapped(34, y + 92, "Rules: you can't buy card packs with coins, buy from the Market, place GE bids or buy shop offers. Tickets, boxes and everything you make still work.", W - 70, "small", 5)
X.wrapped(34, y + 200, "Rewards: +10% xp in every skill, +5% luck and the Ironman title. After turning it off you have to wait 24 hours to turn it back on.", W - 70, "small", 4)
local wait = 86400 - (now() - get("ioff"))
local can_on = get("ioff") == 0 or wait <= 0
local lab
if R.iron() then lab = iconfirm and "SURE? TURN OFF" or "TURN OFF"
else lab = iconfirm and "SURE? TURN ON" or "TURN ON" end
X.button(24, y + 316, W - 48, 76, lab, function()
if (not R.iron()) and not can_on then X.set_note("Iron Mode can be turned on again in " .. K.mmss(wait) .. "."); return end
if not iconfirm then iconfirm = true; return end
iconfirm = false
if R.iron() then V.iron = 0; V.ioff = now(); if get("title") == #KC + 1 then V.title = 0 end; save(); X.set_note("Iron Mode is off.")
else V.iron = 1; save(); X.set_note("Iron Mode ON. Good luck, Ironman!") end
X.save_now()
end, { off = (not R.iron()) and not can_on, active = iconfirm, sub = ((not R.iron()) and not can_on) and ("again in " .. K.mmss(wait)) or nil, id = "IRONTOGGLE" })
X.draw_note(y + 404)
back_btn("perks")
end
function C.draw_megapets(S)
local cp = S.camp
head(S, "Mega pets", "")
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "Gathering with a pet you own can rarely make it MEGA.", "small")
local sp = rows_sp(y0 + 26, 9, 66)
for si = 1, 16 do
local col, row = (si - 1) % 2, (si - 1) // 2
local bw = (W - 48 - 8) // 2
local bx, by = 24 + col * (bw + 8), y0 + 26 + row * sp
local has = I("pet" .. si) and ADV.owns(cp, "pet" .. si)
local mega = R.mega(si)
if mega then smudge.rounded_rect(bx, by, bw, sp - 6, 8, true) else smudge.rounded_rect(bx, by, bw, sp - 6, 8, false, has and 2 or 1) end
local nm = ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
X.ltext(bx + 10, by + 4, X.fit(nm, bw - 20, "small", "bold"), "small", "bold", mega)
X.ltext(bx + 10, by + sp - 32, mega and "MEGA!" or (has and "owned" or "not found"), "small", nil, mega)
end
X.wrapped(30, y0 + 26 + 8 * sp + 4, "Mega pets are a giant version of your skilling pet (just for show, like RuneScape pets). Mythic boxes can also hold one.", W - 60, "small", 3)
back_btn("perks")
end
return R
end
runecraft.lua
7357
return function(X, C, ADV, H, K)
local F = {}
local fl = math.floor
local SI = 20
local function ms() return X.millis() end
local LIST = {}
for ri in ipairs(H.REC[SI]) do LIST[#LIST + 1] = ri end
local sel = nil
local RC = { trail = {}, drawing = false, ri = nil, res = nil, flash = 0, tick = 0 }
local L, SS, POP = nil, nil, nil
local SHAPES = {}
do
local p = {}
for k = 0, 50 do local a = k * 0.25; local r = 0.08 + a * 0.072; p[#p + 1] = { math.cos(a) * r, math.sin(a) * r } end
SHAPES[1] = p
p = {}
for k = 0, 30 do local x = -0.9 + 1.8 * k / 30; p[#p + 1] = { x, math.sin(k / 30 * math.pi * 3) * 0.35 } end
SHAPES[2] = p
SHAPES[3] = { { -0.85, 0.6 }, { -0.3, -0.35 }, { 0, 0.05 }, { 0.35, -0.6 }, { 0.85, 0.6 }, { -0.85, 0.6 } }
SHAPES[4] = { { -0.6, 0.7 }, { -0.4, -0.2 }, { -0.15, 0.25 }, { 0.05, -0.75 }, { 0.3, 0.15 }, { 0.45, -0.25 }, { 0.6, 0.7 }, { -0.6, 0.7 } }
SHAPES[5] = { { 0.2, -0.85 }, { -0.4, 0.05 }, { 0.15, 0.05 }, { -0.3, 0.85 }, { 0.5, -0.15 }, { -0.05, -0.15 }, { 0.35, -0.85 } }
p = {}
for k = 0, 20 do local a = math.pi * (1.15 + 0.7 * k / 20); p[#p + 1] = { 0.2 + math.cos(a) * 0.9, 0.55 + math.sin(a) * 0.9 } end
for k = 0, 20 do local a = math.pi * (1.85 + 0.7 * k / 20); p[#p + 1] = { -0.2 + math.cos(a) * 0.9 * -1, 0.55 - math.sin(a) * 0.9 * -1 } end
SHAPES[6] = { { -0.7, 0.7 }, { -0.5, 0.1 }, { 0, -0.3 }, { 0.5, -0.65 }, { 0.7, -0.75 }, { 0.6, -0.2 }, { 0.3, 0.3 }, { -0.2, 0.6 }, { -0.7, 0.7 } }
SHAPES[7] = { { -0.55, -0.75 }, { 0.55, -0.75 }, { -0.55, 0.75 }, { 0.55, 0.75 }, { -0.55, -0.75 } }
p = {}
p[#p + 1] = { 0, -0.85 }
for k = 0, 24 do local a = math.pi * (-0.15 + 1.3 * k / 24); p[#p + 1] = { math.cos(a) * 0.5, 0.3 + math.sin(a) * 0.5 } end
p[#p + 1] = { 0, -0.85 }
SHAPES[8] = p
p = {}
for k = 0, 48 do local a = k / 48 * math.pi * 2; p[#p + 1] = { math.sin(a) * 0.8, math.sin(a) * math.cos(a) * 0.7 } end
SHAPES[9] = p
end
local function shape_of(ri) return SHAPES[ri] or SHAPES[1] end
local function centre() return L.x + L.w / 2, L.y + L.h * (170 / 355), math.min(L.w * 0.36, L.h * 0.3) end
local function pts(ri)
local cx, cy, rr = centre()
local S = shape_of(ri)
local out = {}
for i = 1, #S - 1 do
local ax, ay, bx, by = cx + S[i][1] * rr, cy + S[i][2] * rr, cx + S[i + 1][1] * rr, cy + S[i + 1][2] * rr
local n = math.max(1, fl(math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2) / 6))
for k = 0, n - 1 do out[#out + 1] = { ax + (bx - ax) * k / n, ay + (by - ay) * k / n } end
end
out[#out + 1] = { cx + S[#S][1] * rr, cy + S[#S][2] * rr }
return out
end
local function near(p, list)
local m = 1e9
for _, q in ipairs(list) do local d = (p[1] - q[1]) ^ 2 + (p[2] - q[2]) ^ 2; if d < m then m = d end end
return math.sqrt(m)
end
local function score(ri)
local P = pts(ri)
if #RC.trail < 6 then return 0 end
local on = 0
for _, p in ipairs(RC.trail) do if near(p, P) < 20 then on = on + 1 end end
local cov = 0
for _, q in ipairs(P) do if near(q, RC.trail) < 22 then cov = cov + 1 end end
return fl(100 * (on / #RC.trail) * (cov / #P) + 0.5)
end
local function finish(S)
local cp = S.camp
local r = H.REC[SI][RC.ri]
local s = score(RC.ri)
local f = s >= 92 and 1.5 or s >= 80 and 1.25 or s >= 60 and 1 or s >= 35 and 0.75 or 0.5
local o = r[5]
local n = math.max(1, fl(o.n * f + 0.5))
ADV.fw = nil
ADV.on_make(S)
H.add_item(cp, o.id, n)
cp.stat[2] = cp.stat[2] + 1
local xp = H.xp_amt(cp, fl(r[3] * (s >= 92 and 1.25 or 1) + 0.5), SI)
if GFX and L then GFX.tapxy = { x = X.W / 2, y = L.ry - 40 } end
X.set_note(string.format("%d%% traced: %d %s%s  (+%d xp)", s, n, H.ITEMS[o.id][1], s >= 92 and "  (PERFECT TRACE!)" or "", xp) .. H.give_xp(S, SI, xp) .. ADV.G.pet_roll(S, SI))
RC.res = s; RC.flash = ms(); RC.ri = nil
POP = { t0 = ms(), text = s .. "%  +" .. n .. " " .. H.ITEMS[o.id][1] }
K.snd(s >= 80 and "rc_done" or "fm_pick", 0.5); K.vib("sf_bolt")
X.mark_dirty(); X.save_now()
end
RUNET = {}
function RUNET.touch(ev, px, py)
if not SS or not L or not K.hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
if ev == "down" then
if not (px >= L.x and px < L.x + L.w and py >= L.y and py < L.y + L.h) then return false end
local cp = SS.camp
local ri = LIST[sel]
local r = H.REC[SI][ri]
local why = K.why_not(cp, SI, r, "Runecrafting")
if why then X.set_note(why); return true end
for _, nd in ipairs(r[4]) do C.take_items(cp, nd[1], nd[2]) end
RC.ri, RC.drawing, RC.trail, RC.res = ri, true, { { px, py } }, nil
K.busy(); return true
end
if not RC.drawing then return false end
if ev == "move" or ev == "nudge" then
local l = RC.trail[#RC.trail]
if (px - l[1]) ^ 2 + (py - l[2]) ^ 2 > 9 then RC.trail[#RC.trail + 1] = { px, py } end
if #RC.trail > 600 then table.remove(RC.trail, 1) end
if ms() - RC.tick > 120 then RC.tick = ms(); K.snd("rc_trace", 0.25) end
K.busy(); return true
end
if ev == "release" or ev == "up" or ev == "tap" then RC.drawing = false; finish(SS); K.busy(); return true end
return false
end
local function draw_scene(S)
local t = ms()
local HD = K.hd()
local x, y = L.x, L.y
local cx, cy, rr = centre()
if not HD then
smudge.rect(x, y, L.w, L.h, false, 2)
smudge.circle(fl(cx), fl(cy), fl(rr), false, 3)
X.ctext(fl(cx), fl(cy) - 10, "ALTAR", "ui12", "bold")
X.ctext(fl(cx), fl(cy + rr + 20), "Tap the altar to craft.", "small")
X.reg("RCSCN", x, y, L.w, L.h, function()
local why = K.why_not(S.camp, SI, H.REC[SI][LIST[sel]], "Runecrafting")
if why then X.set_note(why); return end
H.make(S, SI, LIST[sel])
end, false)
return false
end
K.tile("hd/rc_altar_c.png", x, y, x + L.w, y + L.h)
local P = pts(RC.ri or LIST[sel])
local big = (fl(t / 400) % 2 == 0) and 3 or 2
for i = 1, #P, 2 do
local p = P[i]
smudge.circle(fl(p[1]), fl(p[2]), big + 1, true)
smudge.circle(fl(p[1]), fl(p[2]), big, true, 1, false)
end
smudge.circle(fl(P[1][1]), fl(P[1][2]), 9, false, 3); smudge.circle(fl(P[1][1]), fl(P[1][2]), 9, false, 1, false)
for i = 2, #RC.trail do
local a, b = RC.trail[i - 1], RC.trail[i]
K.tline(a[1], a[2], b[1], b[2], 9, true)
end
for i = 2, #RC.trail do
local a, b = RC.trail[i - 1], RC.trail[i]
K.tline(a[1], a[2], b[1], b[2], 4, false)
end
local msg = RC.drawing and "Trace it in one stroke" or (RC.res and (RC.res .. "%: trace the next one") or "Start at the circle and trace the rune")
K.pill(x + L.w / 2, y + 10, msg)
local anim = RC.drawing
if K.pop(L, POP, t) then anim = true end
return anim
end
function F.draw(S, y)
local cp = S.camp
SS = S
L = K.layout(y)
if not sel then
sel = 1
for k, ri in ipairs(LIST) do local r = H.REC[SI][ri]; if H.slevel(cp, SI) >= r[2] and H.can_make(cp, r) then sel = k end end
end
if draw_scene(S) then K.busy() end
local r = H.REC[SI][LIST[sel]]
local why = K.why_not(cp, SI, r, "Runecrafting")
K.picker(LIST, L.ry, sel, r[1] .. "  (Lv " .. r[2] .. ")", (why and why:find("^You") and why) or H.need_text(cp, r), function(d)
if RC.drawing then return end
sel = (sel - 1 + d) % #LIST + 1; RC.trail = {}; RC.res = nil
end, "RC")
local bw = fl((X.W - 48 - 6) / 2)
X.button(24, L.by, bw, 52, "QUICK x5", function() H.make_many(S, SI, LIST[sel], 5) end, { font = "small", id = "RCQUICK", sub = "no bonus", off = why ~= nil, nohelp = true })
X.button(24 + bw + 6, L.by, X.W - 48 - bw - 6, 52, "BANK", function() H.bank_loot(S) end,
{ font = "small", id = "GBANK", sub = H.inv_used() .. "/" .. H.INV_MAX, nohelp = true })
end
F.state = function() return RC end
F.pts = function(ri) return pts(ri or LIST[sel]) end
return F
end
safe.lua
18399
return function(X, K, C, ADV, G)
local SF = {}
local W, H = X.W, X.H
local fl = math.floor
local head, back_btn = K.head, K.back_btn
local function TOPY() return K.top() end
local function ms() return X.millis() end
local THIEF = 12
local PHONE = smudge.smooth == true
local function busy()
if not PHONE then return end
GFX.sweeping = true
if not GFX.on then X.redraw() end
end
local function snd(n, v) if SND then SND.play(n, v) end end
local function fx() return PHONE and GFX.ok() end
local SAFES = {
{ "Shop safe", 1, 3, 2, 60, 100, 140, 60 },
{ "Guild strongbox", 20, 3, 1, 250, 400, 420, 60 },
{ "Bank vault", 40, 4, 1, 700, 1000, 1100, 75 },
{ "Royal treasury", 60, 4, 0, 1500, 2200, 2400, 80 },
{ "Dragon hoard vault", 80, 5, 0, 3000, 4500, 5000, 95 },
}
local N = 100
local SENS = 0.7
local REV = 0.8
local ST = nil
local streak = tonumber(smudge.load("safestreak", "0") or "0") or 0
local function mult() return 1 + math.min(streak, 20) * 0.1 end
local function save_streak() smudge.save("safestreak", tostring(streak)) end
local function wrap(n) return n % N end
local function dist(a, b) local d = math.abs(wrap(a) - wrap(b)); return math.min(d, N - d) end
local function tol(S, sf)
local lv = C.slevel(S.camp, THIEF)
return sf[4] + ((lv >= sf[2] + 25) and 1 or 0)
end
local function new_combo(n)
local t, last = {}, 0
for k = 1, n do
local v
repeat v = X.rnd(0, N - 1) until dist(v, last) >= 12
t[k] = v; last = v
end
return t
end
local function want(k) return (k % 2 == 1) and 1 or -1 end
local function start(S, i)
local sf = SAFES[i]
if C.slevel(S.camp, THIEF) < sf[2] then X.set_note("You need Thieving level " .. sf[2] .. "."); return end
if C.thief_stunned and C.thief_stunned() then X.set_note("You're stunned!"); return end
ST = { i = i, combo = new_combo(sf[3]), k = 1, pos = 0, wrong = 0, t0 = ms(), click = -1e9, clicked = false,
shake = -1e9, bolt = {}, tol = tol(S, sf), open = nil,
rdir = 0, rstart = 0, ext = 0 }
snd("safe_bolt", 0.4)
end
local function caught(S, why)
if C.thief_stun then C.thief_stun(5000) end
snd("safe_alarm", 0.8)
local lost = streak > 0 and ("  Streak of " .. streak .. " lost.") or ""
streak = 0; save_streak()
X.set_note(why .. " You're stunned for 5 seconds." .. lost)
ST = nil
end
local function opened(S)
local sf = SAFES[ST.i]
local cp = S.camp
ADV.on_action(S, THIEF)
local m = mult()
local c = fl(X.rnd(sf[5], sf[6]) * m + 0.5)
local xp = C.xp_amt(cp, fl(sf[7] * m + 0.5), THIEF)
X.add_coins(c)
cp.stat[8] = cp.stat[8] + 1
streak = streak + 1; save_streak()
ST.open = ms(); ST.prize = c; ST.m = m
snd("safe_open", 0.8)
X.set_note(string.format("The %s swings open: %d coins  (+%d xp)%s", sf[1]:lower(), c, xp,
m > 1 and string.format("  streak x%.1f", m) or "") .. C.give_xp(S, THIEF, xp) .. ADV.G.pet_roll(S, THIEF))
X.mark_dirty(); X.save_now()
end
local function lock_in(S, n)
n = wrap(fl(n + 0.5))
if dist(n, ST.combo[ST.k]) <= ST.tol then
ST.bolt[ST.k] = ms()
ST.k = ST.k + 1
snd("safe_bolt", 0.8)
if VIB then VIB.play("sf_bolt", true) end
if ST.k > #ST.combo then opened(S) end
else
ST.wrong = ST.wrong + 1
ST.shake = ms()
snd("safe_wrong", 0.8)
if VIB then VIB.play("sf_wrong", true) end
if ST.wrong >= 3 then caught(S, "The guard heard you fumbling!")
else ST.msg = { "Nothing moves at " .. n .. "  (" .. (3 - ST.wrong) .. " tries left)", ms() } end
end
end
local function turn(S, by, stop_at_click)
if not ST or ST.open or by == 0 then return end
local d = by > 0 and 1 or -1
local ra = fl(ST.pos + 0.5)
local tgt = ST.combo[ST.k]
if stop_at_click and d == want(ST.k) then
for s = 1, math.abs(by) do
if dist(ra + s * d, tgt) == 0 then by = s * d; break end
end
end
ST.pos = ST.pos + by
local rb = fl(ST.pos + 0.5)
if ST.rdir == 0 then ST.rdir, ST.rstart, ST.ext = d, ST.pos - by, ST.pos
elseif d == ST.rdir then
if (d > 0 and ST.pos > ST.ext) or (d < 0 and ST.pos < ST.ext) then ST.ext = ST.pos end
elseif math.abs(ST.pos - ST.ext) >= REV then
local was, ext, len = ST.rdir, ST.ext, math.abs(ST.ext - ST.rstart)
ST.rdir, ST.rstart, ST.ext = d, ext, ST.pos
if was == want(ST.k) and len >= 1 then
lock_in(S, ext)
if not ST or ST.open then return end
end
end
if ra == rb then return end
ST.clicked = false
local step = rb > ra and 1 or -1
if d == want(ST.k) then
for n = ra + step, rb, step do if dist(n, tgt) == 0 then ST.clicked = true end end
end
if ST.clicked then
if ms() - ST.click > 120 then
snd("safe_click", 0.9)
if VIB then VIB.play("sf_click", true) end
end
ST.click = ms()
elseif ms() - (ST.tick or 0) > 45 then
ST.tick = ms(); snd("safe_tick", 0.3)
if VIB then VIB.play("sf_tick", true) end
end
end
local drag = nil
local DIAL = { x = 0, y = 0, r = 0 }
local SS = nil
SAFE = SAFE or {}
function SAFE.touch(ev, x, y)
if not ST or ST.open or type(x) ~= "number" or type(y) ~= "number" then drag = nil; return false end
local dx, dy = x - DIAL.x, y - DIAL.y
if ev == "down" then
drag = nil
local d = math.sqrt(dx * dx + dy * dy)
if d <= DIAL.r * 1.35 and d >= DIAL.r * 0.1 then drag = { a = math.atan(dy, dx), moved = false }; return true end
return false
end
if not drag then return false end
if ev == "move" then
local a = math.atan(dy, dx)
local da = a - drag.a
if da > math.pi then da = da - 2 * math.pi elseif da < -math.pi then da = da + 2 * math.pi end
drag.a = a
if math.abs(da) > 0.001 then drag.moved = true end
ST.target = (ST.target or ST.pos) - da / (2 * math.pi) * N * SENS
busy()
return true
elseif ev == "release" then return true
elseif ev == "up" or ev == "tap" then local m = drag.moved; drag = nil; return m end
return false
end
SF.SCR = { "safe" }
SF.PARENT = { safe = "skill" }
local AW, AH = 1086, 1448
local HOLE = { 541, 752, 231 }
local PLATE = { 282, 300, 803, 390 }
local function pic(x, y, w, h)
smudge.draw_sprite_quad("art/safe_door.raw", 480, 640, x, y, x + w, y, x + w, y + h, x, y + h)
if fx() and smudge.hires_quad then
for j = 0, 1 do for i = 0, 1 do
local x0, x1 = x + w * i / 2, x + w * (i + 1) / 2
local y0, y1 = y + h * j / 2, y + h * (j + 1) / 2
smudge.hires_quad(string.format("hd/safe_door_%d%d.png", j, i), x0, y0, x1, y0, x1, y1, x0, y1)
end end
end
end
local function pic_quad(q)
smudge.draw_sprite_quad("art/safe_door.raw", 480, 640, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], "art/safe_door_m.raw")
if fx() and smudge.hires_quad then
local function B(u, v)
local tx, ty = q[1] + (q[3] - q[1]) * u, q[2] + (q[4] - q[2]) * u
local bx, by = q[7] + (q[5] - q[7]) * u, q[8] + (q[6] - q[8]) * u
return tx + (bx - tx) * v, ty + (by - ty) * v
end
for j = 0, 1 do for i = 0, 1 do
local ax, ay = B(i / 2, j / 2); local bx, by = B((i + 1) / 2, j / 2)
local cx, cy = B((i + 1) / 2, (j + 1) / 2); local dx, dy = B(i / 2, (j + 1) / 2)
smudge.hires_quad(string.format("hd/safe_door_%d%d.png", j, i), ax, ay, bx, by, cx, cy, dx, dy)
end end
end
do
local function B(u, v)
local tx, ty = q[1] + (q[3] - q[1]) * u, q[2] + (q[4] - q[2]) * u
local bx, by = q[7] + (q[5] - q[7]) * u, q[8] + (q[6] - q[8]) * u
return tx + (bx - tx) * v, ty + (by - ty) * v
end
local hu, hv = HOLE[1] / AW, HOLE[2] / AH
for ring = 1, 3 do
local rr = ({ 1.0, 0.92, 0.36 })[ring]
local ru, rv = HOLE[3] * rr / AW, HOLE[3] * rr / AH
local ink = ring ~= 2
for k = 0, 23 do
local a0, a1 = k / 24 * 2 * math.pi, (k + 1) / 24 * 2 * math.pi
local x0, y0 = B(hu, hv)
local x1, y1 = B(hu + math.cos(a0) * ru, hv + math.sin(a0) * rv)
local x2, y2 = B(hu + math.cos(a1) * ru, hv + math.sin(a1) * rv)
smudge.fill_quad(x0, y0, x1, y1, x2, y2, x0, y0, ink, nil, true)
end
end
end
end
local function bolts(x0, y0, x1, y1)
local n = #ST.combo
local g = 8
local bw = math.min(70, (x1 - x0 - (n - 1) * g) // n)
local bh = math.max(16, math.min(26, fl(y1 - y0 - 6)))
local xs = x0 + ((x1 - x0) - (n * bw + (n - 1) * g)) // 2
local by = fl((y0 + y1) / 2 - bh / 2)
for k = 1, n do
local bx = fl(xs + (k - 1) * (bw + g))
local t = ST.bolt[k]
local u = t and math.min(1, (ms() - t) / 220) or 0
if t and u < 1 then busy() end
local slide = fl(u * bw * 0.3)
smudge.rounded_rect(bx, by, bw, bh, 5, true)
if not t then
smudge.rounded_rect(bx + 3, by + 3, bw - 6, bh - 6, 4, true, 1, false)
if k == ST.k then X.ctext(bx + bw / 2, by + bh // 2 - X.lh("small") // 2, "?", "small", "bold") end
else
smudge.rounded_rect(bx + 3 + slide, by + 3, bw - 6 - slide, bh - 6, 4, false, 1, false)
X.ctext(bx + bw / 2 + slide / 2, by + bh // 2 - X.lh("small") // 2, tostring(ST.combo[k]), "small", "bold", true)
if fx() then smudge.glow_circle(bx + bw / 2, by + bh / 2, bw * 0.5, 120, 255, 140, 0.5 * (1 - u) + 0.25) end
end
end
end
local function dial(cx, cy, R, now)
local pos = ST and ST.pos or 0
local wob = 0
if ST and now - ST.click < 160 then wob = math.sin((now - ST.click) / 160 * math.pi * 3) * 0.6 * (1 - (now - ST.click) / 160); busy() end
if ST and now - ST.shake < 360 then wob = wob + math.sin((now - ST.shake) / 360 * math.pi * 6) * 2.5 * (1 - (now - ST.shake) / 360); busy() end
local rot = (pos + wob) / N * 2 * math.pi
smudge.circle(fl(cx), fl(cy), fl(R) + 6, true)
smudge.circle(fl(cx), fl(cy), fl(R) + 1, true, 1, false)
smudge.circle(fl(cx), fl(cy), fl(R) - 1, false, 2)
local big = R >= 110
for n = 0, N - 1 do
local a = (n / N) * 2 * math.pi - rot - math.pi / 2
local ca, sa = math.cos(a), math.sin(a)
local l = (n % 10 == 0) and 0.2 or ((n % 5 == 0) and 0.13 or 0.08)
if big or n % 2 == 0 then
smudge.line(fl(cx + ca * (R - 4)), fl(cy + sa * (R - 4)), fl(cx + ca * R * (1 - l)), fl(cy + sa * R * (1 - l)), (n % 10 == 0) and 2 or 1)
end
if n % 10 == 0 then
local tx, ty = cx + ca * R * 0.66, cy + sa * R * 0.66
X.ctext(fl(tx), fl(ty) - X.lh("small") // 2, tostring(n), "small", "bold")
end
end
local kr = R * 0.36
smudge.circle(fl(cx), fl(cy), fl(kr) + 3, true)
smudge.circle(fl(cx), fl(cy), fl(kr), true, 1, false)
for g = 0, 11 do
local a = g / 12 * 2 * math.pi - rot
smudge.line(fl(cx + math.cos(a) * kr * 0.55), fl(cy + math.sin(a) * kr * 0.55), fl(cx + math.cos(a) * kr * 0.95), fl(cy + math.sin(a) * kr * 0.95), 2)
end
smudge.circle(fl(cx), fl(cy), fl(kr * 0.4), true)
smudge.circle(fl(cx), fl(cy), fl(kr * 0.4) - 3, false, 1, false)
smudge.triangle(fl(cx - 11), fl(cy - R - 9), fl(cx + 11), fl(cy - R - 9), fl(cx), fl(cy - R + 9), true)
smudge.triangle(fl(cx - 7), fl(cy - R - 6), fl(cx + 7), fl(cy - R - 6), fl(cx), fl(cy - R + 4), true, 1, false)
if fx() then
smudge.glow_quad(cx - R * 0.75, cy - R * 0.8, cx - R * 0.55, cy - R * 0.8, cx - R * 0.05, cy + R * 0.2, cx - R * 0.25, cy + R * 0.2, 255, 255, 255, 0.1)
if ST and now - ST.click < 500 then
smudge.glow_circle(cx, cy - R, 26, 255, 225, 140, 1.6 * (1 - (now - ST.click) / 500)); busy()
end
end
end
local function pill(cx, cy, txt, font)
local tw = X.tw(txt, font, "bold") + 20
local th = X.lh(font) + 8
smudge.rounded_rect(fl(cx - tw / 2), fl(cy - th / 2), tw, th, th // 2, true)
smudge.rounded_rect(fl(cx - tw / 2) + 2, fl(cy - th / 2) + 2, tw - 4, th - 4, th // 2 - 2, false, 1, false)
X.ctext(fl(cx), fl(cy) - X.lh(font) // 2, txt, font, "bold", true)
end
function C.draw_safe(S)
SS = S
local now = ms()
if ST and ST.target and not ST.open then
local dt = math.min(50, now - (ST.lastF or now)); ST.lastF = now
local gap = ST.target - ST.pos
if math.abs(gap) > 0.002 then
local k = 1 - math.exp(-dt / 70)
local step = gap * math.max(k, 0.05)
if math.abs(step) > 3 then step = (step > 0) and 3 or -3 end
turn(S, step)
if not ST then return C.draw_safe(S) end
busy()
else ST.target = nil end
else if ST then ST.lastF = now end end
head(S, "Crack a safe", "Thieving " .. C.slevel(S.camp, THIEF))
local y = TOPY() + 4
if not ST then
X.wrapped(30, y + 2, "Turn the wheel until it clicks, then turn back the other way: that locks the number in. Three wrong numbers and the guard hears you.", W - 60, "small", 3)
local ly = y + 66
local lv = C.slevel(S.camp, THIEF)
local m = mult()
for i, s in ipairs(SAFES) do
local lock = lv < s[2]
local sub = lock and ("Needs Lv " .. s[2]) or string.format("%d numbers  %d-%d coins  +%d xp", s[3], fl(s[5] * m + 0.5), fl(s[6] * m + 0.5), fl(s[7] * m + 0.5))
X.button(24, ly + (i - 1) * 70, W - 48, 64, s[1], function() start(S, i) end,
{ sub = sub, off = lock, font = "ui10", id = "SAFE" .. i })
end
local sy = ly + #SAFES * 70 + 4
X.ctext(W / 2, sy, streak > 0 and string.format("Streak %d: rewards x%.1f (caught: back to x1)", streak, m)
or "Open safes in a row for a streak: +10% each, up to x3", "small", "bold")
X.draw_note(sy + 30)
back_btn("skill")
return
end
local sf = SAFES[ST.i]
local turnTxt = ST.open and string.format("Open! +%d coins", ST.prize)
or string.format("Number %d of %d: turn %s, then back", ST.k, #ST.combo, want(ST.k) < 0 and "RIGHT >" or "< LEFT")
if ST.msg and not ST.open and now - ST.msg[2] < 1800 then turnTxt = ST.msg[1]; busy() end
X.ctext(W / 2, y + 2, turnTxt, "ui10", "bold")
local VX0, VY0, VX1, VY1 = 150, 252, 932, 1212
local ctrl = PHONE and 34 or 96
local vtop = y + 32
local room = H - vtop - 96 - ctrl
local vw = math.min(W - 8, fl(room * (VX1 - VX0) / (VY1 - VY0)))
local s = vw / (VX1 - VX0)
local vh = fl((VY1 - VY0) * s)
vtop = vtop + math.max(0, (room - vh) // 2)
local vx = (W - vw) // 2
local dx, dtop = vx - VX0 * s, vtop - VY0 * s
local dw, dh = AW * s, AH * s
local function P(ax, ay) return dx + ax * s, dtop + ay * s end
if smudge.set_clip then smudge.set_clip(vx, vtop, vw, vh) end
local cx, cy = P(HOLE[1], HOLE[2])
local R = HOLE[3] * s - 7
DIAL.x, DIAL.y, DIAL.r = cx, cy, R
if ST.open then
local age = now - ST.open
local u = math.min(1, age / 900)
busy()
local ix, iy = P(120, 260); local ix2, iy2 = P(966, 1300)
local iw, ih = ix2 - ix, iy2 - iy
local icx, icy = ix + iw / 2, iy + ih * 0.62
ix, iy, iw, ih = vx, vtop, vw, vh
icx, icy = ix + iw / 2, iy + ih * 0.62
smudge.rect(fl(ix), fl(iy), fl(iw), fl(ih), true)
local bh = ih / 9
for r = 0, 8 do
local yy = iy + r * bh
smudge.line(fl(ix + 4), fl(yy), fl(ix + iw - 4), fl(yy), 1, false)
local off = (r % 2 == 0) and 0 or iw / 8
for c = 0, 4 do local xx = ix + off + c * iw / 4; if xx > ix + 4 and xx < ix + iw - 4 then smudge.line(fl(xx), fl(yy), fl(xx), fl(yy + bh), 1, false) end end
end
smudge.tint(fl(ix), fl(iy), fl(iw), fl(ih), 1, 1)
local shy = iy + ih * 0.42
smudge.rect(fl(ix + 10), fl(shy), fl(iw - 20), 8, true)
smudge.rect(fl(ix + 10), fl(shy), fl(iw - 20), 2, true, 1, false)
smudge.tint(fl(ix + 10), fl(shy), fl(iw - 20), 8, 4, 3)
local function stack(x0, n)
for k = 0, n - 1 do
local yy = shy - 6 - k * 6
smudge.draw_sprite_quad("art/ui_coin.raw", 24, 24, x0 - 12, yy - 8, x0 + 12, yy - 8, x0 + 12, yy + 4, x0 - 12, yy + 4, "art/ui_coin_m.raw")
end
end
for k, n in ipairs({ 5, 8, 3, 6, 9, 4, 7 }) do stack(ix + iw * (k / 8), n) end
local csz = math.min(iw * 0.55, ih * 0.45)
if fx() then
local ba = (age - 250) / 600
if ba >= 0 and ba < 1 then
smudge.glow_circle(icx, icy, csz * (0.3 + 1.1 * ba), 255, 225, 140, 2.6 * (1 - ba))
smudge.glow_circle(icx, icy, csz * 0.35, 255, 250, 225, 3.0 * (1 - ba) ^ 2)
end
local ga = math.min(1, math.max(0, (age - 400) / 500))
local p = 0.5 + 0.5 * math.sin(now / 1000 * 2.4)
smudge.glow_circle(icx, icy, csz * (0.72 + 0.08 * p), 255, 200, 90, ga * (1.0 + 0.4 * p))
end
local ox0, oy0, ox1, oy1 = icx - csz / 2, icy - csz / 2, icx + csz / 2, icy + csz / 2
smudge.draw_sprite_quad("art/slot_chesto.raw", 96, 96, ox0, oy0, ox1, oy0, ox1, oy1, ox0, oy1, "art/slot_chesto_m.raw")
if fx() and smudge.hires_quad then smudge.hires_quad("hd/slot_chesto_c.png", ox0, oy0, ox1, oy0, ox1, oy1, ox0, oy1) end
local pt = "+" .. ST.prize .. " coins"
local ptw = X.tw(pt, "ui12", "bold") + 28
local py = iy + ih * 0.16
smudge.rounded_rect(fl(W / 2 - ptw / 2), fl(py), fl(ptw), 44, 12, true)
smudge.rounded_rect(fl(W / 2 - ptw / 2) + 3, fl(py) + 3, fl(ptw) - 6, 38, 10, false, 1, false)
X.ctext(W / 2, fl(py + 22) - X.lh("ui12") // 2, pt, "ui12", "bold", true)
if ST.m and ST.m > 1 then X.ctext(W / 2, fl(py + 50), string.format("streak x%.1f", ST.m), "small", "bold", true) end
local th = (1 - (1 - u) ^ 3) * 1.45
local cw = math.cos(th)
local grow = 1 + 0.22 * math.sin(th)
local rx = dx + dw * cw
local ry0, ry1 = dtop - dh * (grow - 1) / 2, dtop + dh + dh * (grow - 1) / 2
if cw > 0.03 then pic_quad({ dx, dtop, rx, ry0, rx, ry1, dx, dtop + dh }) end
else
pic(dx, dtop, dw, dh)
local px0, py0 = P(PLATE[1], PLATE[2]); local px1, py1 = P(PLATE[3], PLATE[4])
bolts(px0, py0, px1, py1)
dial(cx, cy, R, now)
local _, ly = P(0, 1120)
pill(W / 2, ly, tostring(wrap(fl(ST.pos + 0.5))), "ui12")
if (PHONE and now - ST.click < 700) or (not PHONE and ST.clicked) then
pill(W / 2, ly - X.lh("ui12") - 14, "*click*", "small")
if PHONE then busy() end
end
end
if smudge.set_clip then smudge.set_clip() end
smudge.rounded_rect(vx - 2, vtop - 2, vw + 4, vh + 4, 10, false, 2)
if ST.open then
local age = now - ST.open - 450
local sx0, sy0 = W / 2, vtop + vh * 0.55
local tx, ty = W * 0.56, 22
for k = 1, 22 do
local a = age - k * 45
if a > 0 and a < 900 then
local u = a / 900
local h = ((k * 7919) % 101) / 101 - 0.5
local mx, my = sx0 + h * W * 0.7, sy0 - vh * 0.45 - math.abs(h) * 60
local x = (1 - u) ^ 2 * sx0 + 2 * (1 - u) * u * mx + u * u * tx
local y = (1 - u) ^ 2 * sy0 + 2 * (1 - u) * u * my + u * u * ty
local hw = math.max(1, 9 * math.abs(math.cos(a / 80 + k)))
smudge.draw_sprite_quad("art/ui_coin.raw", 24, 24, x - hw, y - 9, x + hw, y - 9, x + hw, y + 9, x - hw, y + 9, "art/ui_coin_m.raw")
if fx() then local f = (hw / 9) ^ 10; if f > 0.05 then smudge.glow_circle(x - 3, y - 3, 4 + 4 * f, 255, 250, 220, 2.2 * f) end end
if k % 4 == 0 and u > 0.95 and not ST["c" .. k] then ST["c" .. k] = true; snd("coin", 0.25) end
end
end
end
local by = vtop + vh + 6
if ST.open then
X.button(24, by, (W - 54) // 2, 56, "AGAIN", function() start(S, ST.i) end, { font = "ui10", id = "SAFEAGAIN", sub = sf[1] })
X.button(30 + (W - 54) // 2, by, (W - 54) // 2, 56, "OTHER SAFES", function() ST = nil end, { font = "ui10", id = "SAFELIST" })
else
if not PHONE then
local g = 6
local bw = (W - 48 - 3 * g) // 4
local b = { { "<<", 10 }, { "<", 1 }, { ">", -1 }, { ">>", -10 } }
for k, v in ipairs(b) do
X.button(24 + (k - 1) * (bw + g), by, bw, 56, v[1], function() turn(S, v[2], math.abs(v[2]) > 1) end,
{ font = "ui12", id = "SAFEB" .. k })
end
by = by + 62
end
X.ctext(W / 2, by + 4, string.format("tries %d   streak %d%s", 3 - ST.wrong, streak,
""), "small", "bold")
end
X.draw_note(H - 140)
back_btn("skill")
end
function SF.state() return ST end
function SF.reset() ST = nil end
function SF.streak() return streak end
SF.turn, SF.start, SF.DIAL = turn, start, DIAL
__SAFE = SF
return SF
end
scroll.lua
3605
return function(X)
local P = {}
local views = {}
local live = {}
local grab = nil
local eat = false
local last = X.millis()
local cur = nil
function P.frame() live = {} end
function P.begin(id, x, y, w, h, total)
local v = views[id]
if not v then v = { off = 0, v = 0 }; views[id] = v end
v.max = math.max(0, total - h)
if v.off > v.max or v.off < 0 then
if X.smooth() and not (grab and grab.id == id) then v.sp = true
elseif not X.smooth() then v.off = math.max(0, math.min(v.max, v.off)) end
end
cur = { id = id, x = x, y = y, w = w, h = h, total = total }
live[#live + 1] = cur
X.clip(x, y, w, h)
return math.floor(v.off + 0.5)
end
function P.finish()
X.clip()
local c = cur
cur = nil
if not c or c.total <= c.h then return end
local v = views[c.id]
local bx = c.x + c.w + 3
local th = math.max(40, c.h * c.h // c.total)
local ty = c.y + math.floor((c.h - th) * (math.max(0, math.min(v.max, v.off)) / math.max(1, v.max)) + 0.5)
smudge.rect(bx + 3, c.y, 1, c.h, true)
smudge.rounded_rect(bx, ty, 7, th, 3, true)
end
function P.scroll_to(id, off) local v = views[id]; if v then v.off = off; v.v = 0 end end
local function band(v, raw)
if not X.smooth() then return math.max(0, math.min(v.max, raw)) end
if raw < 0 then return -math.min(110, -raw * 0.35) end
if raw > v.max then return v.max + math.min(110, (raw - v.max) * 0.35) end
return raw
end
local function inside(w, x, y) return x >= w.x and x < w.x + w.w and y >= w.y and y < w.y + w.h end
function P.touch(ev, x, y, vx, vy)
if ev == "down" then
eat = false
grab = { x0 = x, y0 = y }
for i = #live, 1, -1 do
local w = live[i]
if inside(w, x, y) then
local v = views[w.id]
if math.abs(v.v) > 0.05 then eat = true end
v.v = 0; v.sp = false
grab.id, grab.off0 = w.id, v.off
break
end
end
return eat
end
if not grab then return false end
local dx, dy = x - grab.x0, y - grab.y0
if not grab.dir and (math.abs(dx) > 8 or math.abs(dy) > 8) then
grab.dir = (math.abs(dy) >= math.abs(dx)) and "v" or "h"
end
if ev == "move" then
if grab.dir == "v" and grab.id then
local v = views[grab.id]
local old = v.off
v.off = band(v, grab.off0 - dy)
return v.off ~= old
end
return false
end
if ev == "release" then
local changed = false
if grab.dir == "v" and grab.id then
changed = true
local v = views[grab.id]
v.off = band(v, grab.off0 - dy)
local sp = -(vy or 0)
if math.abs(sp) < 0.1 then sp = 0 end
if X.smooth() and (v.off < 0 or v.off > v.max) then v.v = 0; v.sp = true; last = X.millis()
elseif X.smooth() then v.v = math.max(-6, math.min(6, sp)); last = X.millis()
else v.off = math.max(0, math.min(v.max, v.off + sp * 250)) end
elseif grab.dir == "h" and math.abs(dx) > 70 and math.abs(dx) > 2 * math.abs(dy) then
if dx < 0 then X.press("NEXT") else X.press("PREV") end
changed = true
end
grab = nil
return changed
end
return false
end
function P.eat_tap() local e = eat; eat = false; return e end
function P.update()
local now = X.millis()
local dt = math.min(50, now - last)
last = now
local moving = false
for _, v in pairs(views) do
if v.v ~= 0 then
v.off = v.off + v.v * dt
local out = v.off < 0 or (v.max and v.off > v.max)
v.v = v.v * ((out and 0.72 or 0.94) ^ (dt / 16))
if out and (math.abs(v.v) < 0.25 or v.off < -90 or v.off > v.max + 90) then v.v = 0; v.sp = true end
if math.abs(v.v) < 0.02 then v.v = 0; if out then v.sp = true end end
moving = true
elseif v.sp and v.off >= 0 and v.off <= (v.max or 0) then v.sp = false
elseif v.sp then
local b = v.off < 0 and 0 or (v.max or 0)
v.off = b + (v.off - b) * math.exp(-dt / 85)
if math.abs(v.off - b) < 0.5 then v.off = b; v.sp = false end
moving = true
end
end
return moving
end
return P
end
