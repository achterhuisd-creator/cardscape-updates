local a1, b1 = SP(x0, y0, z0); local a2, b2 = SP(x1, y1, z1); local a3, b3 = SP(x2, y2, z2); local a4, b4 = SP(x3, y3, z3)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
