ADV.XPT = {}
do
local acc = 0
ADV.XPT[1] = 0
for l = 1, 98 do
acc = acc + math.floor(l + 300 * 2 ^ (l / 7))
ADV.XPT[l + 1] = math.floor((math.floor(acc / 4) / 65 + 6 * l) * 1.75)
end
end
function ADV.init(X, K, C)
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local function TOPY() return K.top() end
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function I(id) return IDX[id] end
local function lvl(cp, si) return K.slevel(cp, si) end
local NSK = K.NS
local XF = { "eq5", "pp", "spts", "sdone", "sstreak", "q1", "q2", "q3", "q4", "q5", "q6",
"q1w", "q2w", "q3w", "q4w", "q5w", "q6w",
"kc1", "kc2", "kc3", "kc4", "kc5", "kc6", "kc7", "kc8", "kc9",
"cs1", "cs2", "cs3", "cd1", "cd2", "cd3", "clt", "cls", "clk", "cla", "cln", "clh",
"g1t", "g1i", "g1q", "g1p", "g1b", "g2t", "g2i", "g2q", "g2p", "g2b", "g3t", "g3i", "g3q", "g3p", "g3b",
"log1", "log2", "log3", "house", "honour", "trawl", "ba", "bab", "wk", "wd", "rev", "maxtot", "tfish",
"np1", "np2", "np3", "ne1", "ne2", "nd", "nt", "na", "nm", "nc", "nq", "nst",
"log4", "log5", "goldsi", "goldgi", "goldn", "stardust", "starid", "starhp", "starmined",
"w1c", "w1s", "w1t", "w2c", "w2s", "w2t", "w3c", "w3s", "w3t",
"dia", "dcd", "dc1", "dc2", "dc3", "dct1", "dct2", "dct3", "dcb1", "dcb2", "dcb3", "dcc", "dcs", "dcl", "msells",
"wbslot", "wbhp", "wbdmg", "wbkills", "wbbest", "nwb", "nstar", "petn",
"mw", "rw", "wbmax",
"gw", "raids", "todt", "tk2", "slk",
"log6", "log7", "log8", "log9", "trips",
"plots", "f4c", "f4t", "f5c", "f5t", "f6c", "f6t", "np4", "np5", "np6",
"bank" }
ADV.XF = XF
function ADV.fresh(cp) cp.x = {}; for _, k in ipairs(XF) do cp.x[k] = 0 end; cp.x.pp = 10 end
local FIRST = K.FIRST
local LOGJ = {}
for j, a in ipairs(ADV.items) do if not a[6] then LOGJ[#LOGJ + 1] = j end end
local NLOG = #LOGJ
ADV.LOGJ = LOGJ
local function log_has(cp, j)
local w = cp.x["log" .. ((j - 1) // 20 + 1)] or 0
return (w // (2 ^ ((j - 1) % 20))) % 2 == 1
end
local function log_count(cp) local n = 0; for _, j in ipairs(LOGJ) do if log_has(cp, j) then n = n + 1 end end return n end
ADV.log_count = function(cp) return log_count(cp), NLOG end
function ADV.on_item(cp, i)
if not cp.x or i < FIRST then return end
local j = i - FIRST + 1
if j > #ADV.items or ADV.items[j][6] or log_has(cp, j) then return end
local key = "log" .. ((j - 1) // 20 + 1)
cp.x[key] = (cp.x[key] or 0) + 2 ^ ((j - 1) % 20)
ADV.newlog = ITEMS[i][1]
end
local function grant(cp, id, n) K.add_item(cp, I(id), n or 1) end
ADV.grant = function(cp, id, n) grant(cp, id, n) end
local function owns(cp, id)
local i = I(id)
if cp.inv[i] > 0 then return true end
for k = 1, 5 do if cp.eq[k] == i then return true end end
return false
end
local ROOMS = {
{ "Garden", "Crops grow 25% faster", 100, { { "pl1", 8 } }, 1, 120 },
{ "Kitchen", "20% chance of a double meal", 200, { { "pl2", 8 }, { "ibar", 3 } }, 10, 260 },
{ "Workshop", "Smithing/Fletching/Crafting: 10% chance to keep your materials", 300, { { "pl3", 10 }, { "sbar", 4 } }, 20, 450 },
{ "Chapel", "+10 prayer points, +10% Prayer xp", 400, { { "pl4", 10 }, { "abar", 3 } }, 35, 800 },
{ "Portal room", "Magic teleports cost no runes", 600, { { "pl5", 10 }, { "rbar", 3 } }, 50, 1300 },
{ "Trophy room", "Boss uniques more common", 600, { { "pl6", 10 }, { "scale", 3 } }, 60, 1800 },
{ "Menagerie", "Bird nests, gems and clue bottles twice as common", 500, { { "pl7", 10 }, { "potato", 10 } }, 70, 2400 },
{ "Games room", "+25% minigame rewards", 500, { { "pl8", 10 }, { "cap", 2 } }, 80, 3200 },
}
for _, r in ipairs(ROOMS) do for _, nd in ipairs(r[4]) do nd[1] = I(nd[1]) end end
local function room(cp, k) return cp.x and (cp.x.house // (2 ^ (k - 1))) % 2 == 1 end
ADV.room = room
function ADV.stam_bonus(cp) return 0 end
function ADV.regen_mult(cp) return 1 end
function ADV.rare_mult(cp, si) return room(cp, 7) and 2 or 1 end
function ADV.grow_mult(cp) return room(cp, 1) and 0.75 or 1 end
function ADV.double_meal(cp) return room(cp, 2) and X.rnd(1, 100) <= 20 end
local OUTFIT = { [1] = "lj", [2] = "pr", [3] = "ang" }
local PIECE = { 0.004, 0.008, 0.006, 0.002 }
function ADV.xp_bonus(cp, si)
if not si or not cp.x then return 0 end
local m = 0
local o = OUTFIT[si]
if o then
local all = true
for k = 1, 4 do if owns(cp, o .. k) then m = m + PIECE[k] else all = false end end
if all then m = 0.025 end
end
if room(cp, 4) and si == 13 then m = m + 0.10 end
return m
end
ADV.OUTFIT = OUTFIT
function ADV.on_level(S, si, lv)
local cp = S.camp
local txt = ""
if lv >= 99 and not owns(cp, "cape" .. si) then grant(cp, "cape" .. si); txt = "  " .. SK[si].name .. " cape!" end
if lv >= 99 and not owns(cp, "maxcape") then
local all = true
for k = 1, NSK do if lvl(cp, k) < 99 then all = false end end
if all then grant(cp, "maxcape"); txt = txt .. "  MAX CAPE!" end
end
local tot = K.total_level(cp)
if tot > cp.x.maxtot then cp.x.maxtot = tot end
ADV.fw = si
return txt
end
local function pp_max(cp) return 10 + lvl(cp, 13) // 2 + (room(cp, 4) and 10 or 0) end
function C.pray_points(S) return S.camp.x.pp, pp_max(S.camp) end
function C.pray_full(S) S.camp.x.pp = pp_max(S.camp) end
function C.pray_drain(S)
local cp = S.camp
if cp.x.pp <= 0 then return false end
cp.x.pp = cp.x.pp - 1
cp.sxp[13] = cp.sxp[13] + 2
return true
end
local CLUE_N = { "Easy", "Medium", "Hard" }
local CLUE_U = { { "beret", "hmask", "bshirt" }, { "rboots", "gscarf", "hsandal" }, { "3ahelm", "3abody", "gaxe" } }
local function drop_clue(cp, tier, chance)
if X.rnd(1, chance) == 1 then
cp.x["cs" .. tier] = math.min(9, cp.x["cs" .. tier] + 1)
ADV.cluenote = CLUE_N[tier] .. " clue scroll!"
return true
end
return false
end
ADV.drop_clue = drop_clue
local CLUE_KINDS = 6
local function clue_step(cp)
local x = cp.x
local t = x.clt
local k = X.rnd(1, CLUE_KINDS)
x.clk = k; x.clh = 0
if k == 1 then
local cand = {}
for si = 1, 4 do for _, g in ipairs(K.GATHER[si]) do if K.can_gather(cp, si, g) then cand[#cand + 1] = g[4] end end end
x.cla = cand[X.rnd(1, #cand)]; x.cln = ({ 5, 10, 15 })[t]
elseif k == 2 then x.cla = 0; x.cln = ({ 2, 4, 6 })[t]
elseif k == 3 then x.cla = X.rnd(1, 8); x.cln = t
elseif k == 4 then x.cla = 0; x.cln = ({ 2, 4, 6 })[t]
elseif k == 5 then x.cla = X.rnd(1, 16); x.cln = ({ 3, 6, 10 })[t]
else x.cla = 0; x.cln = t end
end
local function clue_text(cp)
local x = cp.x
local k = x.clk
if k == 1 then return string.format("Gather %d %s", x.cln, ITEMS[x.cla][1])
elseif k == 2 then return string.format("Win %d fights of any kind", x.cln)
elseif k == 3 then return string.format("Defeat %d %s cards", x.cln, X.elem_name(x.cla))
elseif k == 4 then return string.format("Make %d things at any skill", x.cln)
elseif k == 5 then return string.format("Bring %d %s to the clue master", x.cln, ITEMS[x.cla][1])
else return string.format("Sell at the market %d times", x.cln) end
end
local function clue_progress(cp, kind, a, n)
local x = cp.x
if x.clt == 0 or x.clk ~= kind then return end
if (kind == 1 or kind == 3) and a ~= x.cla then return end
x.clh = math.min(x.cln, x.clh + (n or 1))
end
local function casket(S, t)
local cp = S.camp
local coins = X.rnd(({ 30, 80, 200 })[t], ({ 80, 200, 500 })[t])
local dust = ({ 5, 15, 40 })[t]
X.add_coins(coins); X.add_dust(dust)
local txt = string.format("Casket: %d coins, %d dust", coins, dust)
if X.rnd(1, 3) == 1 then cp.tickets = cp.tickets + 1; txt = txt .. ", ticket" end
if t == 3 and X.rnd(1, 3) == 1 then cp.rtickets = cp.rtickets + 1; txt = txt .. ", RARE ticket" end
if X.rnd(1, ({ 6, 5, 4 })[t]) == 1 then
local u = CLUE_U[t][X.rnd(1, 3)]
grant(cp, u); txt = txt .. ", " .. ITEMS[I(u)][1] .. "!"
end
cp.x["cd" .. t] = cp.x["cd" .. t] + 1
return txt
end
local function clue_check(S)
local cp = S.camp
local x = cp.x
if x.clt == 0 then return end
if x.clk == 5 and x.clh < x.cln then
local have = K.count(cp, x.cla)
if have < x.cln then X.set_note(string.format("You need %d %s (you have %d).", x.cln, ITEMS[x.cla][1], have)); return end
K.take(cp, x.cla, x.cln); x.clh = x.cln
end
if x.clh < x.cln then X.set_note("Not done yet: " .. clue_text(cp)); return end
x.cls = x.cls - 1
if x.cls <= 0 then
local t = x.clt
x.clt = 0
X.set_note(casket(S, t))
else
clue_step(cp)
X.set_note("The clue leads on... " .. x.cls .. " step(s) left.")
end
X.save_now()
end
local function clue_start(S, t)
local cp = S.camp
local x = cp.x
if x.clt ~= 0 then X.set_note("Finish your current clue first."); return end
if x["cs" .. t] < 1 then X.set_note("You have no " .. CLUE_N[t] .. " clue scrolls."); return end
x["cs" .. t] = x["cs" .. t] - 1
x.clt = t; x.cls = t + 1
clue_step(cp)
X.set_note("You read the clue...")
X.save_now()
end
function ADV.on_gain(S, item, n) clue_progress(S.camp, 1, item, n) end
function ADV.on_make(S) clue_progress(S.camp, 4, 0, 1) end
function ADV.on_market_sell(S) clue_progress(S.camp, 6, 0, 1); S.camp.x.msells = S.camp.x.msells + 1 end
local EVENTS = {
{ "Strange Old Man", "\"Which skill uses a pickaxe?\"", { "Fishing", "Mining", "Cooking" }, 2 },
{ "Sandwich Lady", "\"Have a sandwich! Pick the baguette.\"", { "Kebab", "Pie", "Baguette" }, 3 },
{ "Genie", "\"Rub my lamp: pick a skill for XP.\"", nil, 0 },
{ "Evil Tree", "An evil tree sprouts next to you!", { "CHOP IT", "Ignore it", "Run away" }, 1 },
{ "Drill Demon", "\"Drop and give me... a star jump!\"", { "Push-up", "Star jump", "Sit-up" }, 2 },
}
function ADV.on_action(S, si)
local cp = S.camp
ADV.fw = nil
if drop_clue(cp, 1, 220) then X.set_note(ADV.cluenote) end
local T = rawget(_G, "__CPQ_TEST")
if T and not T.events then return end
if X.rnd(1, 1500) == 1 then grant(cp, "frog"); X.set_note("A frog hops by and leaves you a Frog token!") end
end
local function mystery_box(S)
local cp = S.camp
local r = X.rnd(1, 10)
if r == 1 then grant(cp, "frog"); return "a Frog token!" end
if r <= 4 then local c = X.rnd(20, 60); X.add_coins(c); return c .. " coins" end
if r <= 7 then X.add_dust(10); return "10 dust" end
if r <= 9 then local c = X.rnd(10, 30); X.add_coins(c); return c .. " coins" end
cp.tickets = cp.tickets + 1; return "a pack ticket"
end
local function event_pick(S, k)
local e = ADV.ev
ADV.ev = nil
if not e then return end
local cp = S.camp
local ev = EVENTS[e.id]
cp.x.rev = cp.x.rev + 1
if e.id == 3 then
local si = ({ e.si, 9, 13 })[k]
local amt = 10 * lvl(cp, si)
X.set_note("XP lamp: +" .. amt .. " " .. SK[si].name .. " xp" .. K.give_xp(S, si, amt))
elseif k == ev[4] then
if e.id == 4 then
local item = I(({ "log", "oak", "willow", "maple", "yew", "magic", "elder", "anc" })[math.min(8, 1 + lvl(cp, 1) // 12)])
K.add_item(cp, item, 4)
X.set_note("You chop the evil tree: 4 " .. ITEMS[item][1] .. "! " .. K.give_xp(S, 1, 20 + lvl(cp, 1)))
else
X.set_note(ev[1] .. " is pleased. Mystery box: " .. mystery_box(S))
end
else
X.set_note(ev[1] .. " sends you away with nothing.")
end
X.save_now()
end
function ADV.draw_event(S)
local e = ADV.ev
if not e then return end
local ev = EVENTS[e.id]
local y0 = TOPY() + 40
X.reg("EVBLOCK", 0, 0, W, H, function() end)
if not X.saver() then smudge.rounded_rect(30, y0 + 6, W - 52, 330, 12, true) end
smudge.rounded_rect(24, y0, W - 52, 330, 12, true, 1, false)
smudge.rounded_rect(24, y0, W - 52, 330, 12, false, 3)
sprite(40, y0 + 14, 24, "i_box")
X.ltext(74, y0 + 14, "RANDOM EVENT: " .. ev[1], "ui10", "bold")
X.wrapped(44, y0 + 50, ev[2], W - 100, "ui10", 2)
local opts = ev[3] or { SK[e.si].name, "Cooking", "Prayer" }
for k = 1, 3 do
X.button(44, y0 + 110 + (k - 1) * 70, W - 112, 62, opts[k], function() event_pick(S, k) end, { font = "ui10", id = "EV" .. k })
end
end
local QUESTS = {
{ "Cook's Assistant", 1, "The cook needs ingredients for the Duke's birthday cake.",
{ { "give", { { "shrimp", 3 }, { "potato", 2 }, { "log", 3 } } } }, { xp = { 9, 200 }, coins = 60 }, "200 Cooking xp, 60 coins" },
{ "The Lost Kitten", 2, "John the kitten ran off into the woods. Lure him home.",
{ { "give", { { "trout", 3 } } }, { "wins", 3 }, { "give", { { "cap", 1 } } } }, { item = "catbell", coins = 100 }, "Cat bell, 100 coins" },
{ "Druidic Ritual", 1, "The druids need an offering for their stone circle.",
{ { "give", { { "cabbage", 2 }, { "pumpkin", 2 } } } }, { xp = { 10, 300 }, xp2 = { 13, 250 } }, "300 Farming xp, 250 Prayer xp" },
{ "07-04-26", 3, "A date to remember. Prepare the perfect sunset picnic.",
{ { "give", { { "star", 3 }, { "hat", 1 } } }, { "lvl", 9, 15 }, { "give", { { "roast", 1 } } } }, { item = "locket", rticket = 1 }, "Love locket, RARE ticket" },
{ "Dragon Slayer", 5, "The dragon Cinderwing terrorises Crandor. Build a ship, sail out and slay her.",
{ { "give", { { "sbar", 3 }, { "maple", 2 } } }, { "lvl", 5, 20 }, { "boss", 9 } }, { item = "ads", coins = 300 }, "Anti-dragon shield, 300 coins, King Black Dragon lair", 4 },
{ "Monkey Madness", 4, "Sneak onto Ape Atoll and stop the demon's plan.",
{ { "give", { { "abar", 4 }, { "yew", 4 } } }, { "wins", 10 } }, { item = "dscim", coins = 500 }, "Dragon scimitar, 500 coins", 0, 5 },
}
for _, q in ipairs(QUESTS) do for _, st in ipairs(q[4]) do if st[1] == "give" then for _, nd in ipairs(st[2]) do nd[1] = I(nd[1]) end end end end
local function qdone(cp, q) return cp.x["q" .. q] > #QUESTS[q][4] end
local function qpoints(cp) local n = 0; for q = 1, #QUESTS do if qdone(cp, q) then n = n + QUESTS[q][2] end end return n end
ADV.qpoints = qpoints
local qsel = 1
local function quest_req_ok(cp, q)
local Q = QUESTS[q]
if Q[7] and Q[7] > 0 and qpoints(cp) < Q[7] then return false, "Needs " .. Q[7] .. " quest points" end
if Q[8] and not qdone(cp, Q[8]) then return false, "Needs " .. QUESTS[Q[8]][1] end
return true
end
local function step_text(cp, q)
local st = QUESTS[q][4][cp.x["q" .. q]]
if not st then return "" end
if st[1] == "give" then
local p = {}
for _, nd in ipairs(st[2]) do p[#p + 1] = string.format("%d %s (%d)", nd[2], ITEMS[nd[1]][1], K.count(cp, nd[1])) end
return "Bring: " .. table.concat(p, ", ")
elseif st[1] == "wins" then return string.format("Win %d fights (%d so far)", st[2], math.max(0, X.wins() - cp.x["q" .. q .. "w"]))
elseif st[1] == "lvl" then return string.format("Reach %s level %d (now %d)", SK[st[2]].name, st[3], lvl(cp, st[2]))
else return "Defeat Cinderwing on Crandor!" end
end
local function quest_finish(S, q)
local cp = S.camp
local r = QUESTS[q][5]
if r.xp then K.give_xp(S, r.xp[1], r.xp[2]) end
if r.xp2 then K.give_xp(S, r.xp2[1], r.xp2[2]) end
if r.coins then X.add_coins(r.coins) end
if r.item then grant(cp, r.item) end
if r.rticket then cp.rtickets = cp.rtickets + 1 end
local all = true
for k = 1, #QUESTS do if not qdone(cp, k) then all = false end end
local txt = "Quest complete! +" .. QUESTS[q][2] .. " QP"
if all and not owns(cp, "qcape") then grant(cp, "qcape"); txt = txt .. " Quest cape!" end
X.set_note(txt)
end
local function quest_advance(S, q)
local cp = S.camp
cp.x["q" .. q] = cp.x["q" .. q] + 1
cp.x["q" .. q .. "w"] = X.wins()
if qdone(cp, q) then quest_finish(S, q) else X.set_note("Quest journal updated.") end
X.save_now()
end
local function quest_act(S, q)
local cp = S.camp
local x = cp.x
if x["q" .. q] == 0 then
local ok, why = quest_req_ok(cp, q)
if not ok then X.set_note(why .. "."); return end
x["q" .. q] = 1; x["q" .. q .. "w"] = X.wins()
X.set_note("Quest started: " .. QUESTS[q][1]); X.save_now(); return
end
local st = QUESTS[q][4][x["q" .. q]]
if not st then return end
if st[1] == "give" then
for _, nd in ipairs(st[2]) do if K.count(cp, nd[1]) < nd[2] then X.set_note("You still need " .. nd[2] .. " " .. ITEMS[nd[1]][1] .. "."); return end end
for _, nd in ipairs(st[2]) do K.take(cp, nd[1], nd[2]) end
quest_advance(S, q)
elseif st[1] == "wins" then
if X.wins() - x["q" .. q .. "w"] >= st[2] then quest_advance(S, q) else X.set_note("Win more fights first.") end
elseif st[1] == "lvl" then
if lvl(cp, st[2]) >= st[3] then quest_advance(S, q) else X.set_note("Train " .. SK[st[2]].name .. " first.") end
else
ADV.fight_lair(S, 9)
end
end
local LAIRS = {
{ "Azure Drake", 1, 160, 15, 25, "visage", "Fire breath every 3rd turn (x2 unless Anti-dragon shield)" },
{ "Reef Lurker", 2, 150, 13, 26, "trident", "Heals 8 HP every 2nd turn" },
{ "Drill Mole", 3, 170, 12, 27, "mclaw", "Burrows every 4th turn: your next hit misses" },
{ "Prism Eye", 4, 180, 15, 28, "shelm", "Changes element every turn" },
{ "Leech Skull", 5, 220, 17, 29, "whip", "Drains half of every hit it lands" },
{ "Kiln Golem", 6, 260, 18, 30, "sshield", "Only x2 hits do full damage" },
{ "Thorn Stalk", 7, 140, 12, 31, "bstaff", "Regrows 4 HP every turn" },
{ "Frost Phantom", 8, 200, 16, 32, "vshard", "Every 3rd turn: shields and dazes you" },
{ "Cinderwing", 1, 150, 14, 17, nil, "Fire breath every 3rd turn (x2 unless Anti-dragon shield)" },
}
ADV.LAIRS = LAIRS
local function lair_req(cp, k)
if k == 1 and not qdone(cp, 5) then return "Dragon Slayer quest" end
if k == 2 and lvl(cp, 14) < 20 then return "Slayer 20" end
if k == 4 and qpoints(cp) < 6 then return "6 quest points" end
if k == 5 and lvl(cp, 14) < 60 then return "Slayer 60" end
if k == 6 and lvl(cp, 14) < 50 then return "Slayer 50" end
if k == 8 and lvl(cp, 14) < 40 then return "Slayer 40" end
return nil
end
function ADV.fight_lair(S, k)
local cp = S.camp
local L = LAIRS[k]
if k <= 8 then local r = lair_req(cp, k); if r then X.set_note("Requires " .. r .. "."); return end end
X.fight({ ec = L[5], ea = L[4], eh = L[3], boss = true, lair = k, name = L[1], eelem = L[2], art = string.format("art/ms%02d.raw", 21 + k) })
end
function C.has_ads(S) return owns(S.camp, "ads") end
local function fight_wild(S, depth)
local t = math.min(5, depth)
local ec = X.D.pick(t, nil, X.rnd)
local a, h = X.base_stats(ec)
X.fight({ ec = ec, ea = a + 3 * depth + 2, eh = h + 18 * depth, boss = false, wild = depth })
end
local function wild_loss(cp)
local lost = {}
for _ = 1, 3 do
local cand = {}
for i = 1, FIRST - 1 do if cp.inv[i] > 1 then cand[#cand + 1] = i end end
if #cand == 0 then break end
local i = cand[X.rnd(1, #cand)]
local n = cp.inv[i] // 2
cp.inv[i] = cp.inv[i] - n
lost[#lost + 1] = n .. " " .. ITEMS[i][1]
end
return lost
end
function C.adv_end(S, B, win)
if B.wb then return end
local cp = S.camp
B.reward = 0
if B.lair then
local k = B.lair
if win then
cp.x["kc" .. k] = cp.x["kc" .. k] + 1
local coins = 50 + 15 * k
X.add_coins(coins); X.add_dust(10 + 3 * k)
B.reward = coins; B.dust = 10 + 3 * k
local parts = { "KC " .. cp.x["kc" .. k] }
if k == 9 then
if cp.x.q5 == 3 then quest_advance(S, 5) end
parts[#parts + 1] = "Cinderwing is slain!"
else
if X.rnd(1, room(cp, 6) and 9 or 12) == 1 then grant(cp, LAIRS[k][6]); parts[#parts + 1] = "UNIQUE: " .. ITEMS[I(LAIRS[k][6])][1] .. "!" end
if drop_clue(cp, 3, 12) then parts[#parts + 1] = "Hard clue!" elseif drop_clue(cp, 2, 6) then parts[#parts + 1] = "Medium clue!" end
end
B.bonus = table.concat(parts, "  ")
else
B.reward = 0; B.bonus = "The boss was too strong."
end
else
local d = B.wild
if win then
cp.x.wk = cp.x.wk + 1
local coins = 2 * (20 + 10 * d)
X.add_coins(coins); X.add_dust(3 * d)
B.reward = coins; B.dust = 3 * d
local extra = "Wilderness kill " .. cp.x.wk
if drop_clue(cp, 3, 22 - 2 * d) then extra = extra .. "  Hard clue!" elseif drop_clue(cp, 2, 8) then extra = extra .. "  Medium clue!" end
B.bonus = extra
else
cp.x.wd = cp.x.wd + 1
local lost = wild_loss(cp)
B.bonus = (#lost > 0) and ("Lost: " .. table.concat(lost, ", ")) or "You had nothing to lose."
end
end
end
function C.adv_back(B) if B.wb then return "worldboss" elseif B.lair == 9 then return "questinfo" elseif B.lair then return "lairs" end return "wild" end
function ADV.on_kill(S, elem, tier)
local cp = S.camp
clue_progress(cp, 2, 0, 1)
clue_progress(cp, 3, elem, 1)
if drop_clue(cp, 1, 30) then ADV.cluenote = "Easy clue scroll!" elseif drop_clue(cp, 2, 60) then ADV.cluenote = "Medium clue scroll!" end
end
function ADV.on_task_done(S, need)
local cp = S.camp
local x = cp.x
x.sdone = x.sdone + 1
x.sstreak = x.sstreak + 1
local pts = 10 + ((x.sstreak % 10 == 0) and 50 or 0)
x.spts = x.spts + pts
local t = "  +" .. pts .. " Slayer points" .. K.give_xp(S, 14, 20 * need)
if drop_clue(cp, 2, 3) then t = t .. "  Medium clue!" end
return t
end
function ADV.task_need(cp) return X.rnd(3, 5) + lvl(cp, 14) // 15 end
function ADV.skip_task(S)
local x = S.camp.x
if x.spts >= 10 then x.spts = x.spts - 10; x.sstreak = 0; return "Task skipped (-10 points)." end
x.sstreak = 0
return "Task skipped."
end
local function ge_fill(S)
local cp = S.camp
local x = cp.x
local b0 = K.mkt_bucket()
local msg
for k = 1, 3 do
local p = "g" .. k
if x[p .. "t"] > 0 then
local i, q, pr = x[p .. "i"], x[p .. "q"], x[p .. "p"]
local from = math.max(x[p .. "b"] + 1, b0 - 400)
local filled = false
for b = from, b0 do
local mp = K.mkt_price(i, b)
if (x[p .. "t"] == 1 and mp <= pr) or (x[p .. "t"] == 2 and mp >= pr) then filled = true; break end
end
if filled then
if x[p .. "t"] == 1 then
local room_n = math.max(0, C.bank_cap(cp) - cp.inv[i])
local got = math.min(q, room_n)
K.add_item(cp, i, got)
ADV.pf_buy(i, got, pr)
if got < q then X.add_coins((q - got) * pr) end
msg = string.format("GE: bought %d %s.", got, ITEMS[i][1])
else
X.add_coins(q * pr)
ADV.pf_sell(cp, i, q, pr, true)
clue_progress(cp, 6, 0, 1)
msg = string.format("GE: sold %d %s for %d coins.", q, ITEMS[i][1], q * pr)
end
x[p .. "t"] = 0
ADV.notify(msg, "geoffers")
else
x[p .. "b"] = b0
end
end
end
if msg then X.set_note(msg); X.save_now() end
end
ADV.ge_fill = ge_fill
function ADV.ge_place(S, kind, i)
local cp = S.camp
local x = cp.x
local slot
for k = 1, 3 do if x["g" .. k .. "t"] == 0 then slot = k; break end end
if not slot then X.set_note("All 3 GE slots are in use."); return end
local p = K.mkt_price(i, K.mkt_bucket())
local pre = "g" .. slot
if kind == 1 then
if ADV.R.iron_block("place GE bids") then return end
local pr = math.max(1, fl(p * 0.85))
local q = math.min(10, C.bank_cap(cp) - cp.inv[i])
if q <= 0 then X.set_note("Your bank is full of that."); return end
if S.coins < pr * q then X.set_note(string.format("A bid for %d costs %d coins.", q, pr * q)); return end
S.coins = S.coins - pr * q
x[pre .. "t"], x[pre .. "i"], x[pre .. "q"], x[pre .. "p"], x[pre .. "b"] = 1, i, q, pr, K.mkt_bucket()
X.set_note(string.format("GE bid: %d %s at %dc each.", q, ITEMS[i][1], pr))
else
local q = math.min(10, cp.inv[i])
if q <= 0 then X.set_note("You have none to offer."); return end
local pr = math.ceil(p * 1.15)
cp.inv[i] = cp.inv[i] - q
x[pre .. "t"], x[pre .. "i"], x[pre .. "q"], x[pre .. "p"], x[pre .. "b"] = 2, i, q, pr, K.mkt_bucket()
X.set_note(string.format("GE ask: %d %s at %dc each.", q, ITEMS[i][1], pr))
end
X.save_now()
end
local function ge_cancel(S, k)
local cp = S.camp
local x = cp.x
local p = "g" .. k
if x[p .. "t"] == 1 then X.add_coins(x[p .. "q"] * x[p .. "p"]) elseif x[p .. "t"] == 2 then K.add_item(cp, x[p .. "i"], x[p .. "q"]) end
x[p .. "t"] = 0
X.set_note("Offer cancelled. Everything was returned.")
X.save_now()
end
function ADV.ge_count(cp) local n = 0; for k = 1, 3 do if cp.x["g" .. k .. "t"] > 0 then n = n + 1 end end return n end
local EX = { r0 = "A number of wooden logs.", r1 = "Ore. Smelt it into a bar.", r2 = "Smells fishy.",
i_hunt = "From a fresh catch.", i_bar = "A heavy metal bar.", i_good = "Fine handiwork.",
i_crop = "Freshly picked.", i_food = "Looks tasty.", i_scale = "A rare trophy from a boss.",
i_cape = "The cape of a true master.", i_box = "Ribbit.", i_pot = "A potion in a glass vial.",
i_plank = "A sawn wooden plank for building.", i_rune = "A small stone with magic power.",
i_sword = "A sharp, well-balanced blade.", i_staff = "A staff that channels magic.",
i_pet = "A loyal little companion.", i_clue = "A mysterious clue scroll.",
i_sup = "Equipment: buy or make it once, it is never used up.", i_tool = "A handy tool. It is not used up.",
i_herb = "An ingredient for Herblore.", i_ess = "Pure magic stone, ready for Runecrafting. Rune equipment is made from it too.", i_gem = "A shiny gem.", i_nest = "A bird's nest. Sell it or keep it." }
function ADV.examine(i)
local n = ITEMS[i][1]
local base = EX[ITEMS[i][5] or ITEMS[i][3]] or "It's an item."
return n .. ": " .. base
end
local TR = nil
local TR_EV = { { "A leak springs in the hull!", 1 }, { "The boat fills with water!", 2 }, { "The net tears!", 3 },
{ "A big wave hits the side!", 2 }, { "Tentacles grab the net!", 3 } }
local function trawler_start(S)
local cp = S.camp
TR = { round = 1, hull = 3, catch = 0, ev = X.rnd(1, #TR_EV), log = "You set sail..." }
X.go("trawler")
end
local function trawler_pick(S, k)
if not TR or TR.done then return end
local ok = (k == TR_EV[TR.ev][2])
if ok then TR.catch = TR.catch + 1; TR.log = "Well done! The net stays full."
else TR.hull = TR.hull - 1; TR.log = "That did not help..." end
TR.round = TR.round + 1
if TR.hull <= 0 or TR.round > 6 then
TR.done = true
local cp = S.camp
local fishes = { "shrimp", "trout", "salmon", "sword", "lob", "shark", "manta", "levi" }
local best = 1
for gi, g in ipairs(K.GATHER[3]) do if lvl(cp, 3) >= g[2] then best = gi end end
local n = TR.catch * 2 + (room(cp, 8) and TR.catch // 2 or 0)
if TR.hull <= 0 then n = n // 2 end
local item = I(fishes[best])
K.add_item(cp, item, n)
cp.x.trawl = cp.x.trawl + 1; cp.x.tfish = cp.x.tfish + n
local xp = (10 + lvl(cp, 3)) * TR.catch
local txt = string.format("Trawler: %d %s, +%d Fishing xp", n, ITEMS[item][1], xp) .. K.give_xp(S, 3, xp)
if TR.catch >= 4 and X.rnd(1, 3) == 1 then
local miss = {}
for p = 1, 4 do if not owns(cp, "ang" .. p) then miss[#miss + 1] = p end end
if #miss > 0 then local p = miss[X.rnd(1, #miss)]; grant(cp, "ang" .. p); txt = txt .. "  " .. ITEMS[I("ang" .. p)][1] .. "!" end
end
TR.result = txt
X.set_note(txt)
X.save_now()
else
TR.ev = X.rnd(1, #TR_EV)
end
end
local BA = nil
local function ba_play(S)
local cp = S.camp
local deck = X.deck()
local P, names = 0, {}
for k = 1, 3 do local c = deck[k]; if c and c > 0 and X.owned(c) then local a, h = X.card_stats(c); P = P + a * h; names[#names + 1] = X.cname(c) end end
if #names == 0 then X.set_note("Set up your DECK (3 cards) on the home screen first."); return end
if now() < (ADV.ba_next or 0) then X.set_note(string.format("The next Barbarian Assault game starts in %d s.", ADV.ba_next - now())); return end
ADV.ba_next = now() + 120
local waves, lines = 0, {}
for w = 1, 10 do
local Sw = 150 * 1.45 ^ (w - 1)
local ch = math.min(0.95, 1.3 * P / (P + Sw))
if X.rnd(1, 1000) <= ch * 1000 then waves = w; lines[#lines + 1] = string.format("Wave %d: cleared", w)
else lines[#lines + 1] = string.format("Wave %d: overrun by Penance", w); break end
end
local hon = waves * 10 + (waves == 10 and 50 or 0)
if room(cp, 8) then hon = hon + hon // 4 end
cp.x.honour = cp.x.honour + hon
cp.x.ba = cp.x.ba + 1
if waves > cp.x.bab then cp.x.bab = waves end
BA = { lines = lines, hon = hon, waves = waves, team = table.concat(names, ", "), power = P }
X.set_note(string.format("Barbarian Assault: %d waves, +%d honour.", waves, hon))
X.save_now()
X.go("ba")
end
local function ba_buy(S, k)
local cp = S.camp
local cost = ({ 400, 150 })[k]
if cp.x.honour < cost then X.set_note("Need " .. cost .. " honour points."); return end
cp.x.honour = cp.x.honour - cost
if k == 1 then grant(cp, "torso"); X.set_note("You got a Fighter torso!")
else cp.rtickets = cp.rtickets + 1; X.set_note("You got a RARE pack ticket.") end
X.save_now()
end
local SCR = { "trackpick", "portfolio", "inbox", "adventure", "quests", "questinfo", "lairs", "wild", "clues", "colog", "house", "minigames",
"trawler", "ba", "hiscores", "geoffers", "slayshop" }
C.adv_screens = SCR
local PARENT = { trackpick = "inbox", portfolio = "market", inbox = "title", adventure = "camp", quests = "adventure", questinfo = "quests", lairs = "adventure", wild = "adventure",
clues = "adventure", colog = "adventure", house = "adventure", minigames = "adventure",
trawler = "minigames", ba = "minigames", hiscores = "stats", geoffers = "market", slayshop = "tasks" }
ADV.PARENT = PARENT
local lpage = 0
local function fit_small(s) if #s > 38 then return s:sub(1, 36) .. ".." end return s end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
function C.draw_adventure(S)
local cp = S.camp
ge_fill(S)
head(S, "Adventure", ADV.R.title(cp) or (ADV.R.iron() and "IRON" or ""))
local y = TOPY() + 2
local cur, mx = cp.x.pp, pp_max(cp)
X.ctext(W / 2, y, string.format("Quest points %d/16   Prayer %d/%d   Slayer pts %d", qpoints(cp), cur, mx, cp.x.spts), "small", "bold")
local list = {
{ "QUESTS", "a1", "journal", function() X.go("quests") end },
{ "BOSSES", "a2", "lairs", function() X.go("lairs") end },
{ "WILDERNESS", "a3", "risky!", function() X.go("wild") end },
{ "SLAYER", "sk13", "tasks, shop", function() X.go("tasks") end, "tasks" },
{ "CLUES", "a4", (cp.x.cs1 + cp.x.cs2 + cp.x.cs3 > 0) and "scrolls!" or "scrolls", function() X.go("clues") end },
{ "MINIGAMES", "a5", "trawler, BA", function() X.go("minigames") end },
{ "HOUSE", "a6", "rooms", function() X.go("house") end },
{ "COLLECTION", "a7", log_count(cp) .. "/" .. NLOG, function() lpage = 0; X.go("colog") end },
{ "ALTAR", "a9", "restore prayer", function() cp.x.pp = pp_max(cp); X.set_note("You pray at the altar. Prayer restored.") end },
{ "WORLD BOSS", "a2", "every 1.5 h", function() X.go("worldboss") end },
{ "STAR", "a10", "shooting star", function() X.go("star") end },
{ "WORKERS", "a11", "idle gathering", function() X.go("workers") end },
{ "DIARIES", "h2", "area perks", function() X.go("diary") end },
{ "CHALLENGES", "h3", "daily streak", function() X.go("challenges") end },
{ "RAIDS", "a12", "5-room dungeon", function() X.go("raid") end },
{ "WINTERTODT", "a13", "skilling boss", function() X.go("todt") end },
{ "LOOT", "a14", "boxes, wheel", function() X.go("loot") end },
{ "PERKS", "a15", "login, prestige", function() X.go("perks") end },
}
local bw = (W - 48 - 12) // 2
local y0 = y + 28
local nrow = math.ceil(#list / 2)
local sp = rows_sp(y0, nrow, 70)
local gb = ADV.G.badges(S)
for k, b in ipairs(list) do
local col, row = (k - 1) % 2, (k - 1) // 2
local bx, by = 24 + col * (bw + 12), y0 + row * sp
local bd = C.badges(S)
local dots = { QUESTS = bd.quests, CLUES = bd.clues, SLAYER = bd.tasks, ["WORLD BOSS"] = gb.wb, STAR = gb.star, WORKERS = gb.workers, DIARIES = gb.dia, CHALLENGES = gb.dc, LOOT = (gb.loot > 0) and gb.loot or nil, PERKS = (gb.perks > 0) and "!" or nil }
X.button(bx, by, bw, sp - 6, b[1], b[4], { sub = b[3], id = b[1], font = (#b[1] > 8) and "ui10" or "ui12", dot = dots[b[1]], icon = 44 })
sprite(bx + 8, by + (sp - 6 - 32) // 2, 32, b[2])
end
X.draw_note(y0 + nrow * sp)
back_btn("camp")
end
function C.draw_quests(S)
local cp = S.camp
head(S, "Quests", qpoints(cp) .. " QP")
local y0 = TOPY() + 4
local sp = rows_sp(y0, #QUESTS, 84)
local function qrow(q, by)
local Q = QUESTS[q]
local st = cp.x["q" .. q]
local status = qdone(cp, q) and "COMPLETE" or (st > 0 and "in progress" or (quest_req_ok(cp, q) and "not started" or "locked"))
X.button(20, by, W - 40, sp - 6, "", function() qsel = q; X.go("questinfo") end, { id = "QUEST" .. q, dot = ADV.quest_ready(cp, q) and "!" or nil })
X.ltext(34, by + 6, Q[1], "ui10", "bold")
X.ltext(34, by + sp - 34, status, "small", qdone(cp, q) and "bold" or "regular")
X.rtext(W - 34, by + 6, Q[2] .. " QP", "small", "bold")
end
if sp < 84 and X.list("quests", y0, H - 104 - y0, #QUESTS, 84, function(q, by) sp = 84; qrow(q, by) end) then
else for q = 1, #QUESTS do qrow(q, y0 + (q - 1) * sp) end end
back_btn("adventure")
end
function C.draw_questinfo(S)
local cp = S.camp
local q = qsel
local Q = QUESTS[q]
head(S, Q[1], Q[2] .. " QP")
local y = TOPY() + 6
panel(20, y, W - 40, 120)
X.wrapped(34, y + 10, Q[3], W - 70, "ui10", 2)
X.wrapped(34, y + 70, "Reward: " .. Q[6], W - 70, "small", 2)
local st = cp.x["q" .. q]
y = y + 136
local label, off = "START QUEST", false
if qdone(cp, q) then
X.ctext(W / 2, y, "Quest complete!", "ui12", "bold"); label = "DONE"; off = true
elseif st == 0 then
local ok, why = quest_req_ok(cp, q)
X.ctext(W / 2, y, ok and "Ready to start." or why, "ui10", "bold"); off = not ok
else
X.ctext(W / 2, y, string.format("Step %d of %d", st, #Q[4]), "ui10", "bold")
X.wrapped(30, y + 32, step_text(cp, q), W - 60, "ui10", 3)
local kind = Q[4][st][1]
label = (kind == "give") and "HAND OVER" or (kind == "boss" and "FIGHT ELVARG" or "CHECK")
end
X.button(24, y + 120, W - 48, 70, label, function() quest_act(S, q) end, { off = off, id = "QACT", dot = ADV.quest_ready(cp, q) and "!" or nil })
X.draw_note(y + 200)
back_btn("quests")
end
local function lair_drops(cp, k)
local L = LAIRS[k]
local rows = { { "Coins", tostring(50 + 15 * k), 1 }, { "Dust", tostring(10 + 3 * k), 1 } }
if k ~= 9 then
rows[#rows + 1] = { ITEMS[I(L[6])][1], "1", 1 / (room(cp, 6) and 9 or 12) }
rows[#rows + 1] = { "Hard clue scroll", "1", 1 / 12 }
rows[#rows + 1] = { "Medium clue scroll", "1", (11 / 12) / 6 }
end
return L[1], rows, "card battle boss" .. (room(cp, 6) and " (trophy room: uniques more common)" or "")
end
local function wild_drops()
local rows = {}
for d = 1, 5 do rows[#rows + 1] = { string.format("Coins (Lv %d-%d)", (d - 1) * 10 + 1, d * 10), tostring(2 * (20 + 10 * d)), 1 } end
for d = 1, 5 do rows[#rows + 1] = { string.format("Dust (Lv %d-%d)", (d - 1) * 10 + 1, d * 10), tostring(3 * d), 1 } end
for d = 1, 5 do
local ph = 1 / (22 - 2 * d)
rows[#rows + 1] = { string.format("Hard clue (Lv %d-%d)", (d - 1) * 10 + 1, d * 10), "1", ph }
end
rows[#rows + 1] = { "Medium clue (no hard)", "1", 1 / 8 }
return "Wilderness", rows, "lose a fight and you drop half of 3 bank stacks"
end
ADV.lair_drops, ADV.wild_drops = lair_drops, wild_drops
function C.draw_lairs(S)
local cp = S.camp
