friends.lua
62539
return function(X)
local F = {}
local W, H = X.W, X.H
local fl = math.floor
local AL = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
local AIX = {}
for k = 1, #AL do AIX[AL:sub(k, k)] = k - 1 end
local GIFT, DUEL = 1, 2
local function put(bits, v, n) for k = n - 1, 0, -1 do bits[#bits + 1] = (v >> k) & 1 end end
local function take(bits, pos, n)
local v = 0
for k = 0, n - 1 do v = v * 2 + (bits[pos + k] or 0) end
return v, pos + n
end
local function check(bits, n)
local h = 4099
for k = 1, n do h = (h * 33 + bits[k] * 7 + k) % 65521 end
return h
end
local function to_code(bits)
local nb = #bits
put(bits, check(bits, nb), 16)
while #bits % 5 ~= 0 do bits[#bits + 1] = 0 end
local s = ""
for k = 1, #bits, 5 do
local v = take(bits, k, 5)
if k > 1 and (k - 1) % 25 == 0 then s = s .. "-" end
s = s .. AL:sub(v + 1, v + 1)
end
return s
end
local function from_code(str, nbits)
str = tostring(str or ""):upper():gsub("[^%w]", "")
local bits = {}
for k = 1, #str do
local v = AIX[str:sub(k, k)]
if not v then return nil end
put(bits, v, 5)
end
if #bits < nbits + 16 or #bits >= nbits + 16 + 5 then return nil end
for k = nbits + 17, #bits do if bits[k] ~= 0 then return nil end end
local want = take(bits, nbits + 1, 16)
if check(bits, nbits) ~= want then return nil end
return bits
end
F.clean = function(s) return tostring(s or ""):upper():gsub("[^%w]", "") end
local GIFT_BITS = 21 + 3 + 2 + 10 + 21
local DUEL_BITS = 3 + 3 * (7 + 9 + 11)
local MAXAMT = 2097151
local function S() return X.S() end
local function list_load(key) local t = {} for v in (smudge.load(key, "") or ""):gmatch("[^;]+") do t[#t + 1] = v end return t end
local function list_save(key, t, max) while #t > max do table.remove(t, 1) end smudge.save(key, table.concat(t, ";")) end
local function iron(what) return X.iron_block and X.iron_block(what) end
local made = nil
local function make_gift(what, id, n, desc)
local bits = {}
put(bits, X.rnd(0, MAXAMT), 21); put(bits, GIFT, 3); put(bits, what, 2); put(bits, id, 10); put(bits, n, 21)
local code = to_code(bits)
local sent = list_load("giftsent")
sent[#sent + 1] = code .. "|" .. desc
list_save("giftsent", sent, 6)
made = { code, desc }
X.save_now()
X.go("friends")
X.set_note("Gift code made: " .. desc .. ". Send the code to your friend.")
return code
end
F.gift_coins = function(n)
local s = S()
if iron("give gifts") then return end
n = math.max(1, math.min(MAXAMT, fl(n)))
if s.coins < n then X.set_note("You don't have " .. X.cnum(n) .. " coins."); return end
X.add_coins(-n)
return make_gift(0, 0, n, X.cnum(n) .. " coins")
end
F.gift_item = function(i, n)
local cp = S().camp
if iron("give gifts") then return end
n = math.min(n, cp.inv[i])
if n < 1 then X.set_note("Nothing of that in the bank."); return end
cp.inv[i] = cp.inv[i] - n
return make_gift(1, i, n, n .. " x " .. X.item_name(i))
end
F.gift_card = function(c)
local s = S()
if iron("give gifts") then return end
if s.spare[c] < 1 then X.set_note("You need a spare copy to give away."); return end
s.spare[c] = s.spare[c] - 1
return make_gift(2, c, 1, "a " .. X.cname(c) .. " card")
end
local cconf = nil
F.card_asking = function(c) return cconf and cconf[1] == c and X.time() - cconf[2] <= 10 end
F.gift_card_tap = function(c)
if not F.card_asking(c) then
cconf = { c, X.time() }
X.set_note("Tap GIFT again: one spare " .. X.cname(c) .. " leaves your album as a gift code.")
return
end
cconf = nil
F.gift_card(c)
end
local function redeem(bits, code)
local s = S()
local p = 25
local what, id, n
what, p = take(bits, p, 2); id, p = take(bits, p, 10); n, p = take(bits, p, 21)
local used = list_load("giftsused")
for _, u in ipairs(used) do if u == code then X.set_note("You already used this gift code."); return false end end
if iron("take gifts") then return false end
local got
if what == 0 then
X.add_coins(n); got = X.cnum(n) .. " coins"
elseif what == 1 then
if id < 1 or id > X.nitems() then X.set_note("This gift is from a newer game version. Update first."); return false end
local cp = s.camp
if X.bank_cap(cp) - cp.inv[id] < n then
X.set_note("Your bank can't hold " .. n .. " more " .. X.item_name(id) .. ". Upgrade it in the BANK first.")
return false
end
cp.inv[id] = cp.inv[id] + n; got = n .. " x " .. X.item_name(id)
elseif what == 2 then
if id < 1 or id > X.ncards then X.set_note("This gift is from a newer game version. Update first."); return false end
X.give_card(id); got = "a " .. X.cname(id) .. " card"
else
X.set_note("That code doesn't work."); return false
end
used[#used + 1] = code
list_save("giftsused", used, 300)
X.save_now()
X.go("friends")
X.set_note("Gift received: " .. got .. "!")
return true
end
local duel = nil
F.my_duel_code = function()
local s = S()
local bits = {}
put(bits, DUEL, 3)
for k = 1, 3 do
local c = s.deck[k]
if not c or c == 0 or s.lvl[c] < 1 then return nil end
local a, h = X.card_stats(c)
put(bits, c, 7); put(bits, fl(math.max(1, math.min(511, a))), 9); put(bits, fl(math.max(1, math.min(2047, h))), 11)
end
return to_code(bits)
end
local function duel_fight()
local d = duel.cards[duel.round]
X.fight({ ec = d[1], ea = d[2], eh = d[3], name = "Friend's " .. X.cname(d[1]), duel = duel.round })
end
local function start_duel(bits, code)
local p = 4
local cards = {}
for k = 1, 3 do
local c, a, h
c, p = take(bits, p, 7); a, p = take(bits, p, 9); h, p = take(bits, p, 11)
if c < 1 or c > X.ncards then X.set_note("This duel code is from a newer game version. Update first."); return false end
cards[k] = { c, math.max(1, a), math.max(1, h) }
end
duel = { cards = cards, round = 1, res = {}, code = code }
duel_fight()
return true
end
F.duel_title = function() return duel and ("Duel - round " .. duel.round .. " of 3") or "Duel" end
F.duel_end = function(win) if duel then duel.res[duel.round] = win end end
F.duel_next = function()
if not duel then X.go("friends"); return end
if duel.round < 3 then duel.round = duel.round + 1; duel_fight(); return end
local w = 0
for k = 1, 3 do if duel.res[k] then w = w + 1 end end
duel.wins = w
if w >= 2 then
local done = list_load("duelswon")
local first = true
for _, u in ipairs(done) do if u == duel.code then first = false end end
if first then
done[#done + 1] = duel.code; list_save("duelswon", done, 100)
X.add_coins(100); S().camp.tickets = S().camp.tickets + 1
duel.prize = "+100 coins and a pack ticket (first win against this code)"
end
X.save_now()
end
X.go("duel")
end
F.duel_quit = function() duel = nil; X.go("friends") end
local typed = ""
F.open_entry = function() typed = ""; X.go("codeentry") end
local function enter()
local code = F.clean(typed)
local gb = from_code(code, GIFT_BITS)
if gb and take(gb, 22, 3) == GIFT then
redeem(gb, code)
return
end
local db = from_code(code, DUEL_BITS)
if db and take(db, 1, 3) == DUEL then start_duel(db, code); return end
X.set_note("That code doesn't work. Check every letter (no 0, O, 1 or I in codes).")
end
F.type = function(s) typed = s end
F.enter = enter
function F.draw_entry()
X.top_bar("Enter a code", "")
local y = X.TOP + 8
X.ctext(W / 2, y, "A gift code or a duel code from a friend", "small")
local c = F.clean(typed)
local shown = c:gsub("(%w%w%w%w%w)", "%1-"):gsub("%-$", "")
smudge.rounded_rect(24, y + 30, W - 48, 64, 10, false, 3)
X.ctext(W / 2, y + 30 + (64 - X.lh("ui12")) // 2, shown ~= "" and shown or "_", "ui12", "bold")
X.ctext(W / 2, y + 102, #c .. " letters  (gift 15, duel 20)", "small")
X.keyboard({ rows = { "23456789", "QWERTYUP", "ASDFGHJKL", "ZXCVBNM" }, id = "K",
key = function(ch) if #F.clean(typed) < 24 then typed = typed .. ch end end,
actions = { { "DELETE", function() typed = F.clean(typed):sub(1, -2) end, typed == "", "KDEL" },
{ "CLEAR", function() typed = "" end, typed == "", "KCLR" },
{ "OK", enter, #c < 15, "KOK" } } })
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("friends") end, { font = "ui10" })
end
local PER = 30
local function read_total() return smudge.read_minutes and tonumber(smudge.read_minutes()) or nil end
F.bookworm_on = function() return read_total() ~= nil end
F.bookworm_claim = function()
local t = read_total()
if not t then return nil end
local s = S()
local done = tonumber(smudge.load("bookworm", "") or "")
if not done or done > t then smudge.save("bookworm", tostring(t)); return nil end
local n0, n1 = done // PER, t // PER
if n1 <= n0 then return nil end
local tk, rt = 0, 0
for k = n0 + 1, n1 do if k % 4 == 0 then rt = rt + 1 else tk = tk + 1 end end
s.camp.tickets = s.camp.tickets + tk; s.camp.rtickets = s.camp.rtickets + rt
smudge.save("bookworm", tostring(t))
X.save_now()
local parts = {}
if tk > 0 then parts[#parts + 1] = tk .. " pack ticket" .. (tk > 1 and "s" or "") end
if rt > 0 then parts[#parts + 1] = rt .. " RARE ticket" .. (rt > 1 and "s" or "") end
return string.format("Bookworm: you read %d min - %s!", (n1 - n0) * PER, table.concat(parts, " and "))
end
F.bookworm_line = function()
local t = read_total()
if not t then return nil end
local done = tonumber(smudge.load("bookworm", "") or "") or t
local left = PER - (t - (done // PER) * PER)
if left <= 0 then left = PER end
return string.format("Bookworm: %d min of reading to the next pack ticket (every 4th is RARE)", left)
end
local amounts = { 100, 500, 1000, 5000, 10000, 50000, 100000, 500000, 1000000 }
local ai = 3
local show_duel = false
function F.draw_friends()
local s = S()
X.top_bar("Friends", "")
local y = X.TOP + 6
X.ltext(24, y, "Gift codes", "ui12", "bold")
X.wrapped(24, y + 30, "Give coins, an item (BANK: tap it, GIFT) or a spare card (ALBUM: GIFT). Your friend types the code in. Each code works once.", W - 48, "small", 3)
local gy = y + 98
local sw = 56
X.button(24, gy, sw, 56, "-", function() if ai > 1 then ai = ai - 1 end end, { font = "ui12", off = ai == 1, id = "AMTDOWN" })
X.button(24 + sw + 6, gy, 150, 56, X.cnum(amounts[ai]), function() end, { font = "ui10", sub = "coins", id = "AMT" })
X.button(24 + sw + 162, gy, sw, 56, "+", function() if ai < #amounts then ai = ai + 1 end end, { font = "ui12", off = ai == #amounts, id = "AMTUP" })
X.button(24 + 2 * sw + 168, gy, W - 48 - 2 * sw - 168, 56, "GIFT COINS", function() F.gift_coins(amounts[ai]) end,
{ font = "small", off = s.coins < amounts[ai], id = "GIFTCOINS" })
local cy = gy + 66
local sent = list_load("giftsent")
if made then
smudge.rounded_rect(24, cy, W - 48, 76, 10, false, 3)
X.ctext(W / 2, cy + 6, made[1], "ui12", "bold")
X.ctext(W / 2, cy + 44, X.fit("Your gift: " .. made[2], W - 64, "small", "regular"), "small")
elseif #sent > 0 then
X.ltext(24, cy, "Codes you made (newest last)", "small", "bold")
for k = math.max(1, #sent - 1), #sent do
local code, desc = sent[k]:match("^([^|]*)|(.*)$")
X.ltext(24, cy + 24 + (k - math.max(1, #sent - 1)) * 24, X.fit((code or "") .. "  " .. (desc or ""), W - 48, "small", "regular"), "small")
end
else
X.ctext(W / 2, cy + 24, "No gift codes made yet.", "small")
end
local dy = cy + 92
smudge.line(24, dy - 8, W - 24, dy - 8, 1)
X.ltext(24, dy, "Duel codes", "ui12", "bold")
X.wrapped(24, dy + 30, "Your deck as a code: your friend fights your 3 cards (best of 3).", W - 48, "small", 2)
local hw = (W - 48 - 12) // 2
local my = F.my_duel_code()
X.button(24, dy + 76, hw, 60, "MY DUEL CODE", function()
if not my then X.set_note("Put 3 cards in your DECK first."); return end
show_duel = not show_duel
end, { font = "small", sub = "your deck", active = show_duel, id = "MYDUEL" })
X.button(36 + hw, dy + 76, hw, 60, "ENTER A CODE", F.open_entry, { font = "small", sub = "gift or duel", id = "ENTERCODE" })
if show_duel and my then
smudge.rounded_rect(24, dy + 146, W - 48, 56, 10, false, 3)
X.ctext(W / 2, dy + 146 + (56 - X.lh("ui10")) // 2, my, "ui10", "bold")
end
local bl = F.bookworm_line()
if bl then X.wrapped(24, H - 160, bl, W - 48, "small", 2) end
X.button(24, H - 96, W - 48, 64, "BACK", function() made = nil; show_duel = false; X.go("title") end, { font = "ui10" })
end
function F.draw_duel()
X.top_bar("Duel result", "")
local y = X.TOP + 10
if not duel then X.go("friends"); return end
local w = duel.wins or 0
X.ctext(W / 2, y, w >= 2 and "YOU WON THE DUEL!" or "YOU LOST THE DUEL", "bitter14", "bold")
X.ctext(W / 2, y + 50, string.format("%d - %d", w, 3 - w), "bitter14", "bold")
for k = 1, 3 do
local d = duel.cards[k]
X.ltext(40, y + 110 + (k - 1) * 34, string.format("Round %d: %s", k, X.cname(d[1])), "ui10")
X.rtext(W - 40, y + 110 + (k - 1) * 34, duel.res[k] and "WON" or "LOST", "ui10", "bold")
end
if duel.prize then X.wrapped(24, y + 230, duel.prize, W - 48, "small", 2) end
X.wrapped(24, y + 290, "Tell your friend the score, and send them your own duel code to fight back.", W - 48, "small", 3)
X.button(24, H - 176, W - 48, 64, "FIGHT AGAIN", function() duel.round = 1; duel.res = {}; duel.prize = nil; duel_fight() end, { font = "ui10", id = "DUELAGAIN" })
X.button(24, H - 96, W - 48, 64, "DONE", F.duel_quit, { font = "ui10", id = "DUELDONE" })
end
local FPRICE = { 10000, 20000, 50000, 100000, 250000, 500000, 1000000 }
local framed = nil
local function frames_load()
framed = {}
for v in (smudge.load("frames", "") or ""):gmatch("%d+") do framed[tonumber(v)] = true end
end
F.framed = function(c) if not framed then frames_load() end return framed[c] == true end
F.frame_price = function(c) return FPRICE[math.min(#FPRICE, X.tier_of(c) + 1)] end
F.buy_frame = function(c)
local s = S()
if F.framed(c) then return false end
local p = F.frame_price(c)
if s.coins < p then X.set_note("A gold frame for this card costs " .. X.cnum(p) .. " coins."); return false end
X.add_coins(-p)
framed[c] = true
local t = {}
for k in pairs(framed) do t[#t + 1] = k end
table.sort(t)
smudge.save("frames", table.concat(t, ","))
X.save_now()
X.set_note("Gold frame for " .. X.cname(c) .. "! It shows everywhere the card does.")
return true
end
F.draw_frame = function(x, y, sz)
smudge.rect(x - 4, y - 4, sz + 8, sz + 8, false, 2)
smudge.rect(x - 1, y - 1, sz + 2, sz + 2, false, 1)
local j = (sz >= 150) and 9 or 6
for _, p in ipairs({ { x - 3, y - 3 }, { x + sz + 3, y - 3 }, { x - 3, y + sz + 3 }, { x + sz + 3, y + sz + 3 } }) do
smudge.triangle(p[1] - j, p[2], p[1], p[2] - j, p[1] + j, p[2], true)
smudge.triangle(p[1] - j, p[2], p[1], p[2] + j, p[1] + j, p[2], true)
end
end
local fpage, fconf = 0, nil
function F.draw_frames()
local s = S()
X.top_bar("Gold frames", X.cnum(s.coins) .. "c")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
X.swipe_tabs(function() return fpage end, function(t) fpage = t; fconf = nil end, 0, 6)
for i = 0, 6 do
X.button(6 + i * 67, X.TOP + 6, 63, 56, tabs[i + 1], function() if fpage == i then X.grid_flip("frames", i) end; fpage = i; fconf = nil end,
{ font = "small", sub = FPRICE[i + 1] >= 1000000 and (FPRICE[i + 1] // 1000000) .. "M" or (FPRICE[i + 1] // 1000) .. "k", active = (fpage == i), id = "FT" .. i })
end
local y0 = X.TOP + 82
X.grid("frames", fpage, y0, 2, 176, function(c, x, y)
X.thumb(x, y, c, { name = true })
local own = X.owned(c)
X.ctext(x + 54, y + 134, not own and "not found" or (F.framed(c) and "FRAMED" or (fconf == c and "TAP AGAIN" or X.cnum(F.frame_price(c)))), "small", "bold")
X.reg("FRAME" .. c, x, y, 108, 160, function()
if not own then X.set_note("Find this card first."); return end
if F.framed(c) then X.set_note("This card already has a gold frame."); return end
if s.coins < F.frame_price(c) then fconf = nil; X.set_note("A gold frame for this card costs " .. X.cnum(F.frame_price(c)) .. " coins."); return end
if fconf ~= c then fconf = c; X.set_note("Tap again: a gold frame for " .. X.cname(c) .. " costs " .. X.cnum(F.frame_price(c)) .. " coins."); return end
fconf = nil; F.buy_frame(c)
end, true)
end)
local n = 0
for c = 1, X.ncards do if F.framed(c) then n = n + 1 end end
X.ctext(W / 2, y0 + 2 * 176 + 4, n .. " / " .. X.ncards .. " cards framed. Pure decoration: no stats.", "small")
X.button(24, H - 96, W - 48, 64, "BACK", function() fconf = nil; X.go("packs") end, { font = "ui10" })
end
local KINDS = { "Cat", "Bunny", "Dragon", "Blob" }
local STAGES = { [0] = "Egg", "Baby", "Young", "Grown-up" }
local function bob() return (X.smooth and X.smooth()) and math.floor(math.sin(X.millis() / 260) * 4 + 0.5) or 0 end
local ART = { [1] = "cat" }
local hop_until = 0
local function asleep(p)
if p.sleepleft ~= nil then return p.sleepleft > 0 end
return p.hour and (p.hour >= 23 or p.hour < 7) and X.millis() >= hop_until
end
local light_want, light_at = nil, 0
local function hms(n) return string.format("%d:%02d:%02d", n // 3600, n // 60 % 60, n % 60) end
local function art_frame(p)
local mood = math.min(p.food, p.fun, p.clean)
if mood < 25 then return 3, 0 end
if asleep(p) then
return 1, (X.smooth and X.smooth()) and math.floor(math.sin(X.millis() / 900) * 2 + 0.5) or 0
end
if not (X.smooth and X.smooth()) then return 0, 0 end
local t = X.millis()
if t < hop_until then
local ph = (hop_until - t) / 700
return 1, -math.floor(math.abs(math.sin(ph * math.pi * 2)) * 14)
end
local dy = math.floor(math.sin(t / 420) * 2 + 0.5)
local b = t % 4300
if b < 130 or (t // 4300 % 3 == 0 and b > 330 and b < 450) then return 1, dy end
if t % 2400 > 1700 then return 2, dy + 2 end
return 0, dy
end
local PICT = nil
local function pic(x, y, w, h, name)
if PICT then
local k = PICT.k
local x0, y0 = PICT.tx + (x - PICT.ax) * k, PICT.ty + (y - PICT.ay) * k
local x1, y1 = x0 + w * k, y0 + h * k
smudge.draw_sprite_quad("art/" .. name .. ".raw", w, h, x0, y0, x1, y0, x1, y1, x0, y1, "art/" .. name .. "_m.raw")
return
end
smudge.draw_sprite(x, y, w, h, "art/" .. name .. ".raw", "art/" .. name .. "_m.raw")
end
local function draw_pet(p, cx, cy)
if ART[p.kind] and p.stage >= 1 then
local f, dy = art_frame(p)
local sz = 176
pic(cx - sz // 2, cy - sz // 2 + dy, sz, sz, string.format("pet_%s_%d_%d", ART[p.kind], p.stage, f))
return
end
local mood = math.min(p.food, p.fun, p.clean)
if p.stage == 0 then
local f = (p.xp >= 30) and 3 or 0
if X.smooth and X.smooth() and not asleep(p) then
local t = X.millis() % 3200
if t > 2300 and t < 2500 then f = 1 elseif t >= 2500 and t < 2700 then f = 2 elseif t >= 2700 and t < 2900 then f = 1 end
if X.millis() < hop_until then f = ((X.millis() // 90) % 2 == 0) and 1 or 2 end
end
pic(cx - 88, cy - 88, 176, 176, "pet_egg_" .. f)
return
end
if p.stage == -1 then
local w, h = 104, 136
local ex, ey = cx - w // 2, cy - h // 2 + 6 + bob() // 2
if not X.saver() then smudge.rounded_rect(ex + 5, ey + 6, w, h, w // 2, true) end
smudge.rounded_rect(ex, ey, w, h, w // 2, true, 1, false)
smudge.rounded_rect(ex, ey, w, h, w // 2, false, 3)
for _, sp in ipairs({ { 22, 34, 9 }, { 70, 52, 6 }, { 34, 92, 7 }, { 80, 100, 5 } }) do smudge.circle(ex + sp[1], ey + sp[2], sp[3], true) end
local cr = math.min(4, p.xp // 10)
local pts = { { 6, 66 }, { 26, 56 }, { 42, 72 }, { 60, 54 }, { 78, 70 }, { 98, 60 } }
for k = 1, cr + 1 do smudge.line(ex + pts[k][1], ey + pts[k][2], ex + pts[k + 1][1], ey + pts[k + 1][2], 3) end
return
end
local r = ({ 44, 54, 64 })[p.stage]
local y = cy + 20 - r // 2 + bob()
if p.kind == 1 then
smudge.triangle(cx - r + 6, y - r // 2, cx - r // 2, y - r - 22, cx - 6, y - r + 6, true)
smudge.triangle(cx + r - 6, y - r // 2, cx + r // 2, y - r - 22, cx + 6, y - r + 6, true)
elseif p.kind == 2 then
smudge.rounded_rect(cx - r // 2 - 12, y - r - 46, 22, 62, 11, true, 1, false); smudge.rounded_rect(cx - r // 2 - 12, y - r - 46, 22, 62, 11, false, 3)
smudge.rounded_rect(cx + r // 2 - 10, y - r - 46, 22, 62, 11, true, 1, false); smudge.rounded_rect(cx + r // 2 - 10, y - r - 46, 22, 62, 11, false, 3)
elseif p.kind == 3 then
smudge.triangle(cx - r // 2, y - r + 8, cx - r // 2 - 8, y - r - 26, cx - r // 2 + 14, y - r + 4, true)
smudge.triangle(cx + r // 2, y - r + 8, cx + r // 2 + 8, y - r - 26, cx + r // 2 - 14, y - r + 4, true)
smudge.triangle(cx - r - 2, y - 6, cx - r - 36, y - 34, cx - r - 20, y + 16, true)
smudge.triangle(cx + r + 2, y - 6, cx + r + 36, y - 34, cx + r + 20, y + 16, true)
else
smudge.line(cx, y - r, cx + 10, y - r - 26, 3); smudge.circle(cx + 12, y - r - 30, 7, true)
end
if not X.saver() then smudge.circle(cx + 5, y + 6, r, true) end
smudge.circle(cx, y, r, true, 1, false)
smudge.circle(cx, y, r, false, 3)
smudge.circle(cx, y + r // 3, r // 2, false, 1)
if p.clean < 35 then for k = 0, 4 do smudge.circle(cx - r // 2 + k * (r // 4), y + r // 2 - (k % 2) * 10, 3, true) end end
local ex, ey = r // 3, y - r // 5
if p.busy then
smudge.line(cx - ex - 8, ey, cx - ex + 8, ey, 3); smudge.line(cx + ex - 8, ey, cx + ex + 8, ey, 3)
else
smudge.circle(cx - ex, ey, 7, true); smudge.circle(cx + ex, ey, 7, true)
smudge.circle(cx - ex + 2, ey - 2, 2, true, 1, false); smudge.circle(cx + ex + 2, ey - 2, 2, true, 1, false)
end
local my = y + r // 6
if mood >= 50 then
smudge.line(cx - 14, my, cx - 6, my + 8, 3); smudge.line(cx - 6, my + 8, cx + 6, my + 8, 3); smudge.line(cx + 6, my + 8, cx + 14, my, 3)
elseif mood >= 25 then
smudge.line(cx - 10, my + 4, cx + 10, my + 4, 3)
else
smudge.line(cx - 14, my + 8, cx - 6, my, 3); smudge.line(cx - 6, my, cx + 6, my, 3); smudge.line(cx + 6, my, cx + 14, my + 8, 3)
smudge.circle(cx + ex + 4, ey + 16, 4, true)
end
if p.kind == 1 then for s2 = -1, 1, 2 do smudge.line(cx + s2 * 18, my - 4, cx + s2 * 40, my - 8, 1); smudge.line(cx + s2 * 18, my, cx + s2 * 40, my + 2, 1) end end
end
local VERB = { feed = "fed", play = "played with", clean = "cleaned", pet = "petted", treat = "gave a treat to", hatch = "found" }
local function pet_says(p)
if p.stage == 0 then return "(the egg wobbles a little...)" end
if asleep(p) then return (p.sleepleft or 0) > 0 and "Zzz... zzz... (lights off)" or "Zzz... zzz..." end
if p.food < 25 and p.food <= p.fun and p.food <= p.clean then return "I'm so hungry..." end
if p.fun < 25 and p.fun <= p.clean then return "Play with me, please?" end
if p.clean < 25 then return "I feel a bit dirty..." end
if p.lastwho ~= "" and p.lastwho ~= p.me and p.lastwho == p.partner and p.lastago < 3 * 3600 and VERB[p.lastact] then
return p.partner .. " " .. VERB[p.lastact] .. " me!"
end
if p.streak >= 2 then return p.streak .. " days in a row together!" end
if p.together then return "We're a team today!" end
if p.food < 50 then return "A snack would be nice..." end
local h = p.hour or 12
if h < 11 then return "Good morning, " .. p.me .. "!" end
if h < 18 then return "Let's play!" end
return "What a nice day it was."
end
local function bubble(text, cx, y)
local w = math.min(W - 40, X.tw(text, "small", "bold") + 28)
local x = cx - w // 2
if not X.saver() then smudge.rounded_rect(x + 3, y + 4, w, 34, 12, true) end
smudge.rounded_rect(x, y, w, 34, 12, true, 1, false)
smudge.rounded_rect(x, y, w, 34, 12, false, 2)
smudge.triangle(cx - 8, y + 33, cx + 8, y + 33, cx, y + 44, true)
X.ctext(cx, y + (34 - X.lh("small")) // 2, text, "small", "bold")
end
local MILES = { { 3, "300 coins", function(s) X.add_coins(300) end }, { 7, "a RARE ticket", function(s) s.camp.rtickets = s.camp.rtickets + 1 end },
{ 14, "1,500 coins + a ticket", function(s) X.add_coins(1500); s.camp.tickets = s.camp.tickets + 1 end },
{ 30, "2 RARE tickets", function(s) s.camp.rtickets = s.camp.rtickets + 2 end }, { 60, "5,000 coins", function(s) X.add_coins(5000) end },
{ 100, "3 RARE tickets", function(s) s.camp.rtickets = s.camp.rtickets + 3 end } }
local function next_mile(p)
local got = tonumber(smudge.load("petstreak", "0")) or 0
if p.streak < got then got = 0; smudge.save("petstreak", "0") end
for _, m in ipairs(MILES) do if m[1] > got then return m, p.streak >= m[1] end end
return nil, false
end
local FX = {}
local say_text, say_until = nil, 0
local shown = {}
local seek = nil
local function smooth() return X.smooth and X.smooth() end
local function fx(k, d, o)
o = o or {}; o.k = k; o.t = X.millis(); o.d = d or 1400
FX[#FX + 1] = o
if not smooth() then X.after(o.d + 50, X.redraw) end
end
local function say(t, ms) say_text = t; say_until = X.millis() + (ms or 2600) end
local GAIN = { feed = "+35 food", play = "+30 fun", clean = "+40 clean", pet = "+8 fun", treat = "+50 food +10 fun" }
local LINES = {
feed = { "Nom nom nom!", "Yummy!", "So tasty!" }, play = { "Again! Again!", "Wheee!", "Got it!" },
clean = { "Squeaky clean!", "Bubbles!", "So fresh!" }, pet = { "Purrr...", "More, please!", "That's the spot!" },
treat = { "A TREAT?! Best day ever!", "Mmmm, special!", "You're the best!" },
tap = { "Hehe!", "Hi!", "Purrr...", "Boop!", "That tickles!", "Mrrp?" },
}
local function pick(t) return t[X.rnd(1, #t)] end
local PCS = { food = 80, play = 64, clean = 72, pet = 80, treat = 64, heart = 32, box = 112, plant = 112, basket = 112 }
local function pcs(name, x, y, sc)
local n = PCS[name]
local w = n * (sc or 1)
local path, m = "art/pc_" .. name .. ".raw", "art/pc_" .. name .. "_m.raw"
if smudge.draw_sprite_quad then
local x0, y0 = math.floor(x - w / 2 + 0.5), math.floor(y - w + 0.5)
local x1, y1 = x0 + math.floor(w + 0.5), math.floor(y + 0.5)
smudge.draw_sprite_quad(path, n, n, x0, y0, x1, y0, x1, y1, x0, y1, m)
else smudge.draw_sprite(math.floor(x - n / 2), math.floor(y - n), n, n, path, m) end
end
local function heart(x, y, r)
if smudge.draw_sprite_quad then pcs("heart", x, y + r + 4, (2 * r + 10) / 32); return end
smudge.circle(x - r // 2, y, r // 2 + 1, true); smudge.circle(x + r // 2, y, r // 2 + 1, true)
smudge.triangle(x - r - 1, y + 1, x + r + 1, y + 1, x, y + r + 3, true)
end
local function star(x, y, r, t)
smudge.line(x - r, y, x + r, y, t or 2); smudge.line(x, y - r, x, y + r, t or 2)
smudge.line(x - r // 2, y - r // 2, x + r // 2, y + r // 2, 1); smudge.line(x - r // 2, y + r // 2, x + r // 2, y - r // 2, 1)
end
local function bubble_o(x, y, r)
smudge.circle(x, y, r, true, 1, false); smudge.circle(x, y, r, false, 2)
if r > 5 then smudge.circle(x - r // 3, y - r // 3, math.max(1, r // 4), true) end
end
local function yarn(x, y, r, fr)
if smudge.draw_sprite_quad then
local nm = "art/yarn" .. (((fr or 0) % 4) + 1)
local x0, y0, x1, y1 = math.floor(x - r + 0.5), math.floor(y - r + 0.5), math.floor(x + r + 0.5), math.floor(y + r + 0.5)
smudge.draw_sprite_quad(nm .. ".raw", 64, 64, x0, y0, x1, y0, x1, y1, x0, y1, nm .. "_m.raw")
return
end
if true then pcs("play", x, y + r + 6, (2 * r + 22) / 64); return end
smudge.circle(x, y, r, true, 1, false); smudge.circle(x, y, r, false, 2)
smudge.line(x - r + 3, y - 3, x + r - 3, y + 4, 1); smudge.line(x - r + 4, y + 4, x + r - 5, y - 5, 1); smudge.line(x - 2, y - r + 2, x + 3, y + r - 2, 1)
end
local function bowl(x, y)
if true then pcs("food", x, y + 18, 0.9); return end
smudge.rounded_rect(x - 30, y - 6, 60, 22, 10, true, 1, false); smudge.rounded_rect(x - 30, y - 6, 60, 22, 10, false, 3)
smudge.rect(x - 34, y - 8, 68, 5, true)
for k = 0, 4 do smudge.circle(x - 18 + k * 9, y - 11 + (k % 2) * 2, 4, true) end
end
local FUR = { deco = false, boxes = {},
list = { { id = "bed", name = "cat bed", price = 400 }, { id = "shelf", name = "bookshelf", price = 600 }, { id = "lamp", name = "floor lamp", price = 300 } } }
FUR.queue = {}
local function parse(str) local t = {} for k, v in (str or ""):gmatch("(%a+)=(%d)") do t[k] = tonumber(v) end return t end
function FUR.get()
local t = parse(smudge.load("petfur", ""))
if FUR.shared then
local sh = parse(FUR.shared)
for k, v in pairs(sh) do t[k] = v end
for _, q in ipairs(FUR.queue) do t[q[1]] = q[2] end
end
return t
end
function FUR.set(t)
local old = FUR.get()
local o = {}
for _, f in ipairs(FUR.list) do if t[f.id] then o[#o + 1] = f.id .. "=" .. t[f.id] end end
smudge.save("petfur", table.concat(o, ","))
if FUR.shared then
for _, f in ipairs(FUR.list) do
if t[f.id] and t[f.id] ~= old[f.id] then FUR.queue[#FUR.queue + 1] = { f.id, t[f.id] } end
end
end
end
function FUR.sync(p)
if p.fur == nil then FUR.shared = nil; return end
local sh = parse(p.fur)
if not FUR.merged then
FUR.merged = true
for k, v in pairs(parse(smudge.load("petfur", ""))) do if sh[k] == nil then FUR.queue[#FUR.queue + 1] = { k, v } end end
end
FUR.shared = p.fur
local q = FUR.queue[1]
if q and sh[q[1]] == q[2] then table.remove(FUR.queue, 1); q = FUR.queue[1] end
if q and not p.busy and X.millis() >= (FUR.next or 0) then
FUR.next = X.millis() + 4000
smudge.pet_do("fur:" .. q[1] .. "=" .. q[2])
end
end
function FUR.placed(id) return FUR.get()[id] == 1 end
function FUR.spot(id, a, b, D)
if id == "bed" then return -a + 10, -a + 140, b - 89, D * 0.18, 128, 88
elseif id == "shelf" then return -a + 4, -a + 134, b - 130, D - 6, 128, 128 end
return a - 122, a - 78, b - 110, D - 24, 64, 160
end
function FUR.flat(id, w)
if id == "bed" then return 6, -50, 96, 64
elseif id == "shelf" then return w - 196, -88, 88, 88 end
return 112, -104, 40, 104
end
function FUR.shown()
local t, out = FUR.get(), {}
for _, f in ipairs(FUR.list) do
if t[f.id] == 1 then out[#out + 1] = { f, "in" } elseif FUR.deco then out[#out + 1] = { f, "ghost" } end
end
return out
end
local YB = { st = "rest", x = 110, y = 0, z = 0, vx = 0, vy = 0, vz = 0, t = 0, last = 0, petx = 0, R = 12 }
local RP, RD, RT = nil, 170, nil
local function room3d_setup(x, y, w, h)
local rx, ry
if X.tilt then rx, ry = X.tilt("petroom", x, y, w, h, 1) end
if not rx or not smudge.draw_sprite_quad or not smudge.fill_quad then RP = nil; return end
local ccx, ccy, FOC, EY, PZ = x + w / 2, y + h / 2, 480, -45, 0
local cr, sr, cxr, sxr = math.cos(ry), math.sin(ry), math.cos(rx), math.sin(rx)
RT = { rx, ry }
RP = function(px, py, pz)
local z = pz - PZ
local x1, z1 = px * cr + z * sr, -px * sr + z * cr
local y1 = py - EY
local y2, z2 = y1 * cxr - z1 * sxr, y1 * sxr + z1 * cxr
local k = FOC / (FOC + z2 + PZ)
return ccx + x1 * k, ccy + EY + y2 * k, k
end
end
local function room3d(p, x, y, w, h, noplant)
local a, b = w / 2, h / 2
local function q(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3)
local p0, q0 = RP(x0, y0, z0); local p1, q1 = RP(x1, y1, z1); local p2, q2 = RP(x2, y2, z2); local p3, q3 = RP(x3, y3, z3)
return p0, q0, p1, q1, p2, q2, p3, q3
end
local function face(tex, ...) smudge.draw_sprite_quad("art/" .. tex .. ".raw", 256, 256, ...) end
local D = RD
face("room_w_ceil", q(-a, -b, D, a, -b, D, a, -b, 0, -a, -b, 0))
face("room_w_floor", q(-a, b, D, a, b, D, a, b, 0, -a, b, 0))
face("room_w_side", q(-a, -b, 0, -a, -b, D, -a, b, D, -a, b, 0))
face("room_w_side", q(a, -b, D, a, -b, 0, a, b, 0, a, b, D))
face("room_w_back", q(-a, -b, D, a, -b, D, a, b, D, -a, b, D))
if p.sleepleft and p.sleepleft > 0 and smudge.shade_quad then
local function shade_face(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3, phase)
local v = { q(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3) }
smudge.shade_quad(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], phase)
end
shade_face(-a, -b, D, a, -b, D, a, -b, 0, -a, -b, 0, 0)
shade_face(-a, b, D, a, b, D, a, b, 0, -a, b, 0, 1)
shade_face(-a, -b, 0, -a, -b, D, -a, b, D, -a, b, 0, 0)
shade_face(a, -b, D, a, -b, 0, a, b, 0, a, b, D, 1)
shade_face(-a, -b, D, a, -b, D, a, b, D, -a, b, D, 0)
end
local function L(x0, y0, z0, x1, y1, z1, t)
local p0, q0 = RP(x0, y0, z0); local p1, q1 = RP(x1, y1, z1)
smudge.line(math.floor(p0 + 0.5), math.floor(q0 + 0.5), math.floor(p1 + 0.5), math.floor(q1 + 0.5), t or 1)
end
for _, c in ipairs({ { -a, -b }, { a, -b }, { a, b }, { -a, b } }) do L(c[1], c[2], 0, c[1], c[2], D, 2) end
L(-a, -b, D, a, -b, D, 2); L(a, -b, D, a, b, D, 2); L(a, b, D, -a, b, D, 2); L(-a, b, D, -a, -b, D, 2)
local night = p.hour and (p.hour >= 20 or p.hour < 7)
local ww, wh = 264, 240
local wx0, wy0 = -ww / 2, -b + 18
local px0, py0 = wx0 + ww * 26 / 176, wy0 + wh * 6 / 160
local px1, py1 = wx0 + ww * 150 / 176, wy0 + wh * 139 / 160
local FAR, WIN = 260, 0.72
local base = (1 - WIN) / 2
local function cl(v) return math.max(0.01, math.min(1 - WIN - 0.01, v)) end
local u0 = cl(base - FAR * math.sin(RT[2]) / (px1 - px0) * WIN)
local v0 = cl(base + FAR * math.sin(RT[1]) / (py1 - py0) * WIN)
local oq = { q(px0, py0, D, px1, py0, D, px1, py1, D, px0, py1, D) }
smudge.draw_sprite_quad(night and "art/room_out_night.raw" or "art/room_out_day.raw", 256, 256,
oq[1], oq[2], oq[3], oq[4], oq[5], oq[6], oq[7], oq[8], nil, u0, v0, u0 + WIN, v0 + WIN)
local wq = { q(wx0, wy0, D - 2, wx0 + ww, wy0, D - 2, wx0 + ww, wy0 + wh, D - 2, wx0, wy0 + wh, D - 2) }
smudge.draw_sprite_quad("art/room_win.raw", 176, 160, wq[1], wq[2], wq[3], wq[4], wq[5], wq[6], wq[7], wq[8], "art/room_win_m.raw")
local dark = p.sleepleft and p.sleepleft > 0
FUR.boxes = {}
local items = noplant and {} or FUR.shown()
table.sort(items, function(i, j) return select(4, FUR.spot(i[1].id, a, b, D)) > select(4, FUR.spot(j[1].id, a, b, D)) end)
for _, it in ipairs(items) do
local id = it[1].id
local x0, x1, top, z, pw, ph = FUR.spot(id, a, b, D)
local fq = { q(x0, top, z, x1, top, z, x1, b, z, x0, b, z) }
local nm = "art/fur_" .. id .. ((id ~= "lamp" and (dark or it[2] == "ghost")) and "_n" or "")
if dark and id == "lamp" and smudge.glare_quad and it[2] == "in" then
local lx, ly = (x0 + x1) / 2, top + (b - top) * 0.22
local g = { q(lx - 10, ly, z, lx + 10, ly, z, lx + 90, b, z - 70, lx - 90, b, z - 70) }
smudge.glare_quad(g[1], g[2], g[3], g[4], g[5], g[6], g[7], g[8], false)
end
smudge.draw_sprite_quad(nm .. ".raw", pw, ph, fq[1], fq[2], fq[3], fq[4], fq[5], fq[6], fq[7], fq[8], nm .. "_m.raw")
local mx, my = math.min(fq[1], fq[7]), fq[2]
FUR.boxes[id] = { math.floor(mx), math.floor(my), math.floor(math.max(fq[3], fq[5]) - mx), math.floor(math.max(fq[6], fq[8]) - my), it[2] }
end
if not noplant then
local f = smooth() and (X.millis() // 450) % 4 or 0
local pn = "art/room_plant_" .. f
local pz = D * 0.36
local pq = { q(a - 84, b - 116, pz, a - 12, b - 116, pz, a - 12, b - 8, pz, a - 84, b - 8, pz) }
smudge.draw_sprite_quad(pn .. ".raw", 72, 108, pq[1], pq[2], pq[3], pq[4], pq[5], pq[6], pq[7], pq[8], pn .. "_m.raw")
end
end
local function room3d_front(x, y, w, h)
local a, b = w / 2, h / 2
local pts = {}
for _, c in ipairs({ { -a, -b }, { a, -b }, { a, b }, { -a, b } }) do local px, py = RP(c[1], c[2], 0); pts[#pts + 1] = { px, py } end
for k = 1, 4 do local u, v = pts[k], pts[k % 4 + 1]; smudge.line(math.floor(u[1] + 0.5), math.floor(u[2] + 0.5), math.floor(v[1] + 0.5), math.floor(v[2] + 0.5), 4) end
end
function YB.step(now, a, b, D)
local dt = math.min(40, math.max(0, now - (YB.last > 0 and YB.last or now))); YB.last = now
if YB.st ~= "rest" and X.moving then X.moving(300) end
local R = YB.R
YB.b = b
if YB.st == "rest" then YB.x, YB.y, YB.z = a - 140, b - R, D * 0.14 end
if YB.st == "fly" then
local n = math.max(1, math.ceil(dt / 10)); local h = dt / n
for _ = 1, n do
YB.vy = YB.vy + 0.0016 * h
YB.x, YB.y, YB.z = YB.x + YB.vx * h, YB.y + YB.vy * h, YB.z + YB.vz * h
YB.roll = (YB.roll or 0) + math.sqrt(YB.vx * YB.vx + YB.vz * YB.vz) * h
YB.fr = math.floor(YB.roll / (R * 0.8))
if YB.y > b - R then
YB.y = b - R
if YB.vy > 0 then YB.vy = -YB.vy * 0.55; YB.vx = YB.vx * 0.85; YB.vz = YB.vz * 0.85; if math.abs(YB.vy) < 0.07 then YB.vy = 0 end end
end
if YB.y < -b + R then YB.y = -b + R; YB.vy = math.abs(YB.vy) * 0.5 end
if YB.x < -a + R then YB.x = -a + R; YB.vx = math.abs(YB.vx) * 0.6 elseif YB.x > a - R then YB.x = a - R; YB.vx = -math.abs(YB.vx) * 0.6 end
if YB.z > D - R then YB.z = D - R; YB.vz = -math.abs(YB.vz) * 0.6 elseif YB.z < R then YB.z = R; YB.vz = math.abs(YB.vz) * 0.6 end
if YB.vy == 0 then YB.vx = YB.vx * (1 - 0.004 * h); YB.vz = YB.vz * (1 - 0.004 * h) end
end
if (YB.vy == 0 and math.abs(YB.vx) + math.abs(YB.vz) < 0.02) or now - YB.t > 6000 then YB.st = "wait"; YB.t = now; YB.y = b - R end
end
local tx = 0
if YB.st == "fly" or YB.st == "wait" then tx = math.max(-a + 70, math.min(a - 70, YB.x)) end
YB.petx = YB.petx + (tx - YB.petx) * math.min(1, dt / 260)
if YB.st == "wait" and math.abs(YB.petx - tx) < 12 and now - YB.t > 300 then YB.st = "fetched"; YB.t = now; return "got" end
if YB.st == "fetched" and now - YB.t > 1300 then YB.st = "rest" end
end
function YB.draw(a, b, D)
if YB.st == "hold" then yarn(math.floor(YB.hx), math.floor(YB.hy), math.floor(YB.sr), YB.fr or 0); return end
local R = YB.R
local x, y, z = YB.x, YB.y, YB.z
if YB.st == "fetched" then x, y, z = YB.petx + 36, b - 34, D * 0.42 - 24 end
local sx, sy, k = RP(x, y, z)
if YB.st ~= "fetched" and smudge.shade_quad then
local s1, t1 = RP(x - R, b, z - R * 0.6); local s2, t2 = RP(x + R, b, z - R * 0.6)
local s3, t3 = RP(x + R, b, z + R * 0.6); local s4, t4 = RP(x - R, b, z + R * 0.6)
smudge.shade_quad(s1, t1, s2, t2, s3, t3, s4, t4, 0)
end
if YB.st == "rest" then YB.sx, YB.sy, YB.k = sx, sy, k end
YB.sr = math.max(6, R * k)
yarn(math.floor(sx), math.floor(sy), math.floor(YB.sr), YB.fr or 0)
end
F.YB = YB
function F.pet_touch(ev, x, y)
if X.scr() ~= "ourpet" or not YB.can then if YB.st == "hold" then YB.st = "rest" end return false end
if ev == "down" then
if YB.st == "rest" and YB.sx and (x - YB.sx) ^ 2 + (y - YB.sy) ^ 2 < math.max(40, YB.sr * 2.8) ^ 2 then
YB.st = "hold"; YB.hx, YB.hy = x, y; YB.smp = { { x, y, X.millis() } }
return true
end
return false
end
if YB.st ~= "hold" then return false end
local now = X.millis()
YB.hx, YB.hy = x, y
YB.smp[#YB.smp + 1] = { x, y, now }; if #YB.smp > 10 then table.remove(YB.smp, 1) end
if ev == "release" then
local s0 = YB.smp[1]
for _, sm in ipairs(YB.smp) do if now - sm[3] <= 100 then s0 = sm; break end end
local dt = math.max(16, now - s0[3])
local vxs, vys = (x - s0[1]) / dt, (y - s0[2]) / dt
local k = YB.k or 1
YB.x = YB.x + (x - YB.sx) / k
YB.y = math.max(-YB.b + 30, YB.y + math.min(0, (y - YB.sy) / k))
YB.st = "fly"; YB.t = now
if (smudge.load("petyarn", "") or "") == "" then smudge.save("petyarn", "1") end
if vys > -0.25 and math.abs(vxs) < 0.25 then YB.vx, YB.vy, YB.vz = 0, 0, 0; return true end
YB.vx = math.max(-0.9, math.min(0.9, vxs * 0.45))
YB.vz = math.max(0.05, math.min(0.8, -vys * 0.35))
YB.vy = math.max(-1.1, math.min(-0.2, vys * 0.5))
end
return true
end
function FUR.tap(f, s, p)
local t = FUR.get()
if t[f.id] == 1 then t[f.id] = 0; FUR.set(t); X.set_note("The " .. f.name .. " is put away (tap it to put it back)."); return end
if t[f.id] == 0 then t[f.id] = 1; FUR.set(t); X.set_note("The " .. f.name .. " is back in the room."); return end
if s.coins < f.price then X.set_note("A " .. f.name .. " costs " .. f.price .. " coins (you have " .. s.coins .. ")."); return end
X.add_coins(-f.price); t[f.id] = 1; FUR.set(t); X.save_now()
X.set_note("You bought a " .. f.name .. " for " .. p.name .. "!"); fx("hearts", 1200); hop_until = X.millis() + 700
if p.stage >= 1 then say(f.id == "bed" and "A bed! I'll sleep in it tonight!" or "Ooh, it looks so cosy now!") end
end
local function room(p, x, y, w, h, cx, floor, noplant)
if RP then room3d(p, x, y, w, h, noplant); return end
smudge.draw_sprite(x, y, w, h, "art/room_bg.raw")
smudge.rect(x, y, w, h, false, 2)
local night = p.hour and (p.hour >= 20 or p.hour < 7)
pic(x + 58, y + 38, 104, 104, night and "room_window_night" or "room_window_day")
FUR.boxes = {}
for _, it in ipairs(noplant and {} or FUR.shown()) do
local fx0, fy0, fw, fh = FUR.flat(it[1].id, w)
pic(x + fx0, floor + fy0, fw, fh, "fur_" .. it[1].id .. "_r")
if it[2] == "ghost" then smudge.rect_dither(x + fx0, floor + fy0, fw, fh, 1) end
FUR.boxes[it[1].id] = { x + fx0, floor + fy0, fw, fh, it[2] }
end
if not noplant then
local f = smooth() and (X.millis() // 450) % 4 or 0
pic(x + w - 86, floor - 104, 72, 108, "room_plant_" .. f)
end
end
local function draw_fx(cx, top, floor)
local now, keep = X.millis(), {}
for _, e in ipairs(FX) do
local u = (now - e.t) / e.d
local alive = u < 1
if not smooth() then u = 0.45 end
if alive then
keep[#keep + 1] = e
if e.k == "hearts" or e.k == "treat" then
for i = 0, (e.k == "treat" and 6 or 4) do
local v = (u * 1.3 - i * 0.08)
if v > 0 and v < 1 then
local side = (i % 2 == 0) and -1 or 1
local hx = cx + side * (88 + (i % 3) * 14) + math.floor(math.sin(v * 6 + i) * 6)
heart(hx, top + 130 - math.floor(v * 110) - (i // 2) * 14, 9 + (i % 2) * 3)
end
end
if e.k == "treat" then
for i = 0, 5 do local a = i * 1.047 + u * 2; star(cx + math.floor(math.cos(a) * 92), top + 84 + math.floor(math.sin(a) * 70), 7) end
if u < 0.55 then pcs("treat", cx + 64 - math.floor(u * 70), top + 150, 0.8) end
elseif u < 0.8 then
pcs("pet", cx + math.floor(math.sin(u * 14) * 26) + 20, top + 64, 0.85)
end
elseif e.k == "food" then
bowl(cx + 54, floor - 8)
if u < 0.7 then for i = 0, 3 do smudge.circle(cx + 30 + i * 10, floor - 30 + math.floor(((u * 4 + i * 0.3) % 1) * 18), 2, true) end end
elseif e.k == "ball" then
local bx = cx - 150 + math.floor(u * 300)
local by = floor - 12 - math.floor(math.abs(math.sin(u * math.pi * 3)) * 60)
yarn(bx, by, 14, math.floor(u * 14))
elseif e.k == "bubbles" then
if u < 0.75 then pcs("clean", cx + math.floor(math.sin(u * 16) * 40), top + 120 + math.floor(math.cos(u * 11) * 10), 0.8) end
for i = 0, 8 do
local v = (u * 1.2 - (i % 4) * 0.07)
if v > 0 and v < 1 then bubble_o(cx - 80 + i * 20, floor - 20 - math.floor(v * 140) + (i % 3) * 8, 6 + (i * 5) % 9) end
end
if u > 0.6 then star(cx - 50, top + 60, 9); star(cx + 56, top + 40, 7); star(cx + 30, top + 110, 6) end
elseif e.k == "found" then
for i = 0, 7 do local a = i * 0.785; local r = 40 + math.floor(u * 60)
star(cx + math.floor(math.cos(a) * r), top + 90 + math.floor(math.sin(a) * r * 0.8), 6) end
elseif e.k == "levelup" then
for i = 0, 15 do
local fx0 = (i * 53) % 400 - 200
local cyf = top - 10 + math.floor(u * 200) + (i * 37) % 60
if (i % 3) == 0 then smudge.rect(cx + fx0, cyf, 6, 6, true) elseif (i % 3) == 1 then star(cx + fx0, cyf, 5) else smudge.circle(cx + fx0, cyf, 3, true) end
end
local tw = X.tw(e.text, "ui10", "bold") + 24
smudge.rounded_rect(cx - tw // 2, top - 76, tw, 34, 10, true); X.ctext(cx, top - 71, e.text, "ui10", "bold", true)
end
if e.gain and u < 1 then
local gy = top + 70 - math.floor(u * 50)
local tw = X.tw(e.gain, "small", "bold") + 14
smudge.rounded_rect(cx + 50, gy, tw, 22, 8, true, 1, false); smudge.rounded_rect(cx + 50, gy, tw, 22, 8, false, 2)
X.ltext(cx + 57, gy + 2, e.gain, "small", "bold")
end
end
end
FX = keep
end
local function minibar(x, y, w, label, v, key)
local t = v
if smooth() then
shown[key] = shown[key] or v
shown[key] = shown[key] + (v - shown[key]) * 0.12
if math.abs(shown[key] - v) < 0.5 then shown[key] = v end
t = math.floor(shown[key] + 0.5)
end
local low = v < 25
local blink = low and smooth() and (X.millis() // 450) % 2 == 0
X.ltext(x, y, (low and "! " or "") .. label, "small", "bold")
X.rtext(x + w, y, v .. "%", "small", "bold")
if not blink then X.bar(x, y + 20, w, 12, t / 100) else smudge.rect(x, y + 20, w, 12, false, 2) end
end
local WISH = { { "feed", 2, "Feed me twice" }, { "play", 2, "Play with me twice" }, { "clean", 1, "I want a bath" },
{ "pet", 3, "Cuddles! Pet me 3 times" }, { "treat", 1, "A treat, pretty please" }, { "seek", 1, "Hide and seek with me" } }
local function hash(t) local h = 7; for i = 1, #t do h = (h * 31 + t:byte(i)) % 1000003 end return h end
local function wish_of(p, newer)
local list = {}
for _, w in ipairs(WISH) do
if not (w[1] == "treat" and not newer) and not (w[1] == "seek" and p.stage == 0) then list[#list + 1] = w end
end
return list[hash((p.day or "") .. (p.name or "") .. (p.me or "")) % #list + 1]
end
local function wish_state(p)
local d, n, c = (smudge.load("petwish", "") or ""):match("^(.-)|(%d+)|(%d)$")
if d ~= p.day then return 0, false end
return tonumber(n) or 0, c == "1"
end
local function wish_count(p, newer, act)
local w = wish_of(p, newer)
if not w or w[1] ~= act then return end
local n, c = wish_state(p)
if c then return end
smudge.save("petwish", p.day .. "|" .. (n + 1) .. "|0")
if n + 1 == w[2] then say(p.name .. " is so happy: wish come true!", 3000) end
end
local function care(p, s, act, newer)
if act == "treat" then
local i = X.food_in_bank and X.food_in_bank()
if not i then X.set_note("A treat is food from your bank (cook some at the CAMP)."); return end
s.camp.inv[i] = s.camp.inv[i] - 1; X.save_now()
X.set_note("You give " .. p.name .. " a " .. X.item_name(i):lower() .. ".")
end
hop_until = X.millis() + 700
smudge.pet_do(act)
local kind = ({ feed = "food", play = "ball", clean = "bubbles", pet = "hearts", treat = "treat" })[act]
fx(kind, act == "play" and 1800 or 1500, { gain = GAIN[act] })
if p.stage >= 1 then say(pick(LINES[act])) end
wish_count(p, newer, act)
end
local SPOTS = { "box", "plant", "basket" }
local function seek_state(p)
local d, w = (smudge.load("petseek", "") or ""):match("^(.-)|(%d+)$")
return d == p.day and (tonumber(w) or 0) or 0
end
local function draw_spot(k, x, floor, picked, here, sc)
sc = sc or 1
if smudge.draw_sprite_quad then
pcs(({ "box", "plant", "basket" })[k], x, floor + 2, sc)
if picked and here then
local ey = floor - math.floor(({ 74, 88, 58 })[k] * sc)
for _, ox in ipairs({ -12, 12 }) do
smudge.triangle(x + ox - 12, ey + 4, x + ox, ey - 24, x + ox + 12, ey + 4, true)
smudge.triangle(x + ox - 7, ey + 1, x + ox, ey - 15, x + ox + 7, ey + 1, true, 1, false)
end
star(x - 44, ey - 20, 7); star(x + 44, ey - 14, 6)
elseif picked then
X.ctext(x, floor - math.floor(126 * sc), "empty!", "small", "bold")
end
return
end
if k == 1 then
smudge.rect(x - 34, floor - 56, 68, 56, true, 1, false); smudge.rect(x - 34, floor - 56, 68, 56, false, 3)
smudge.line(x - 34, floor - 56, x - 46, floor - 70, 3); smudge.line(x + 34, floor - 56, x + 46, floor - 70, 3)
smudge.line(x - 12, floor - 40, x + 12, floor - 40, 2)
elseif k == 2 then
smudge.rounded_rect(x - 22, floor - 40, 44, 40, 6, true, 1, false); smudge.rounded_rect(x - 22, floor - 40, 44, 40, 6, false, 3)
for j = -2, 2 do smudge.circle(x + j * 14, floor - 62 - (2 - math.abs(j)) * 10, 14, true) end
else
smudge.rounded_rect(x - 40, floor - 38, 80, 38, 14, true, 1, false); smudge.rounded_rect(x - 40, floor - 38, 80, 38, 14, false, 3)
for j = 0, 4 do smudge.line(x - 30 + j * 15, floor - 34, x - 30 + j * 15, floor - 4, 1) end
smudge.line(x - 30, floor - 38, x - 18, floor - 66, 3); smudge.line(x + 30, floor - 38, x + 18, floor - 66, 3); smudge.line(x - 18, floor - 66, x + 18, floor - 66, 3)
end
if picked and here then
local ey = floor - (k == 1 and 56 or k == 2 and 84 or 40)
for _, ox in ipairs({ -12, 12 }) do
smudge.triangle(x + ox - 12, ey + 4, x + ox, ey - 24, x + ox + 12, ey + 4, true)
smudge.triangle(x + ox - 7, ey + 1, x + ox, ey - 15, x + ox + 7, ey + 1, true, 1, false)
end
star(x - 40, ey - 20, 7); star(x + 40, ey - 14, 6)
elseif picked then
X.ctext(x, floor - 110, "empty!", "small", "bold")
end
end
function F.draw_pet_shared()
local s = S()
X.top_bar("Our pet", "")
local y = X.TOP + 6
if not smudge.pet then
X.wrapped(24, y + 40, "The shared pet needs the newest CardScape firmware on the reader (or use the phone app).", W - 48, "ui10", 4)
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("title") end, { font = "ui10" })
return
end
local p = smudge.pet()
if not p.setup or not p.exists then
X.wrapped(24, y + 10, p.setup and (p.reader and "Set up. The pet comes with the next sync: quit the game, or tap SYNC NOW." or "Connected. Hatch your pet in SET UP (only one of you does this), then you both see it here.")
or "One pet for the two of you: you both feed it, play with it and keep it clean, and see what the other did. Every day you both take care of it, you each get a pack ticket.", W - 48, "ui10", 6)
X.wrapped(24, y + 190, p.reader and "On the reader: set the pet up in the phone app first, then do one Wi-Fi sync (Settings > WI-FI SYNC); the app hands the pet to the reader."
or "You need a small private GitHub repository for the pet and a token for it (the app README explains it). Both phones use the same repository and token.", W - 48, "small", 5)
if p.status ~= "" then X.ctext(W / 2, y + 300, p.status, "small", "bold") end
if smudge.pet_setup then
X.button(24, y + 330, W - 48, 64, "SET UP", function() smudge.pet_setup() end, { font = "ui10", sub = "repository, token, names", id = "PETSETUP" })
elseif p.setup and smudge.cloud_sync then
X.button(24, y + 330, W - 48, 64, "SYNC NOW", function() smudge.cloud_sync() end, { font = "ui10", sub = "gets the pet", id = "PETSYNC" })
end
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("title") end, { font = "ui10" })
return
end
local newer = p.hour ~= nil
FUR.sync(p)
if light_want ~= nil then
local el = X.time() - light_at
if el > 20 or (light_want == "off") == ((p.sleepleft or 0) > 0) then light_want = nil
else p.sleepleft = (light_want == "off") and math.max(1, 36000 - el) or 0 end
end
local lights = p.sleepleft ~= nil
p.streak = p.streak or 0; p.lastwho = p.lastwho or ""; p.lastago = p.lastago or 0
local seen = smudge.load("petlvl", "")
local mark = p.level .. "," .. p.stage
if seen ~= mark then
local sl, ss = seen:match("^(%d+),(%-?%d+)$")
smudge.save("petlvl", mark)
if sl and (tonumber(ss) < p.stage) then fx("levelup", 3200, { text = p.stage == 1 and p.name .. " hatched!" or p.name .. " grew up!" }); say("Look at me now!", 3200)
elseif sl and tonumber(sl) < p.level then fx("levelup", 2600, { text = "Level " .. p.level .. "!" }) end
end
X.ctext(W / 2, y, p.name, "bitter14", "bold")
X.ctext(W / 2, y + 32, string.format("%s %s - level %d - %d day%s old%s", STAGES[p.stage], KINDS[p.kind] or "", p.level, p.age, p.age == 1 and "" or "s",
p.streak >= 2 and string.format(" - %d days together", p.streak) or ""), "small")
local sx, sy, sw, sh = 24, y + 54, W - 48, 290
local is3d = smooth() and not X.saver() and smudge.draw_sprite_quad ~= nil and smudge.fill_quad ~= nil and X.tilt ~= nil
local block_y = H - 356
if is3d then
local avail = block_y - 8 - sy
sh = math.max(260, math.min(400, avail))
sy = sy + math.max(0, (avail - sh) // 2)
end
local floor = sy + 256
local cx = W // 2
local ptop = floor - 172
room3d_setup(sx, sy, sw, sh)
if RP and smudge.set_clip then smudge.set_clip(0, sy - 6, W, sh + 10) end
room(p, sx, sy, sw, sh, cx, floor, seek ~= nil)
local pict3 = nil
YB.can = RP ~= nil and not seek and p.stage >= 1 and not asleep(p) and not FUR.deco and not p.busy
if not YB.can and YB.st ~= "rest" then YB.st = "rest"; YB.petx = 0 end
if RP and YB.can then
if YB.step(X.millis(), sw / 2, sh / 2, RD) == "got" then
hop_until = X.millis() + 700; fx("hearts", 1100); say(pick(LINES.play), 1600)
end
end
if RP then
local px, py, k = RP(YB.can and YB.petx or 0, sh / 2 - 22, RD * 0.42)
local kk = k
if asleep(p) and p.stage >= 1 and not seek and FUR.placed("bed") then
local x0, x1, _, z = FUR.spot("bed", sw / 2, sh / 2, RD)
px, py, k = RP((x0 + x1) / 2, sh / 2 - 24, z + 6)
kk = k * 0.62
end
pict3 = { ax = cx, ay = floor, tx = px, ty = py, k = kk, cx = cx, ptop = ptop }
cx, ptop, floor = math.floor(px), math.floor(py - (floor - ptop) * kk), math.floor(py)
end
if seek then
local sp = pict3 and math.floor(150 * pict3.k) or 136
local xs = { cx - sp, cx, cx + sp }
for k = 1, 3 do
draw_spot(k, xs[k], floor, seek.pick ~= nil and (k == seek.pick or k == seek.hide), k == seek.hide, pict3 and pict3.k or 1)
if not seek.pick then X.reg("SEEK" .. k, xs[k] - 56, floor - 110, 112, 112, function()
seek.pick = k; seek.t = X.millis()
if k == seek.hide then
local w = seek_state(p)
local msg = "You found " .. p.name .. "!"
if w < 3 then
local coins = 20 + 2 * p.level
X.add_coins(coins); smudge.save("petseek", p.day .. "|" .. (w + 1)); X.save_now()
msg = msg .. " +" .. coins .. " coins" .. (w + 1 == 3 and " (that's all coins for today)" or "")
end
if not p.busy then smudge.pet_do("play") end
wish_count(p, newer, "seek")
X.set_note(msg)
else
X.set_note(p.name .. " was hiding in the " .. SPOTS[seek.hide] .. "!")
end
if smooth() then X.after(1800, function()
if seek and seek.pick then local won = seek.pick == seek.hide; seek = nil; fx("found", 1200); say(won and "You found me!" or "Hehe, missed me!") end
end) end
end, true) end
end
if seek.pick then
X.ctext(cx, sy + 14, seek.pick == seek.hide and "Found!" or "Not there...", "ui10", "bold")
X.reg("SEEKDONE", sx, sy, sw, sh, function()
local won = seek.pick == seek.hide
seek = nil; fx("found", 1200); say(won and "You found me!" or "Hehe, missed me!")
end, true)
else
X.ctext(cx, sy + 14, "Where is " .. p.name .. "? Tap a hiding spot.", "small", "bold")
end
else
local ball_behind = YB.can and YB.st ~= "hold" and YB.z > RD * 0.42 and YB.st ~= "fetched"
if ball_behind then YB.draw(sw / 2, sh / 2, RD) end
if pict3 then PICT = pict3; draw_pet(p, pict3.cx, pict3.ptop + 88); PICT = nil else draw_pet(p, cx, ptop + 88) end
if YB.can and not ball_behind then YB.draw(sw / 2, sh / 2, RD) end
if asleep(p) and p.stage >= 1 then
local zt = smooth() and (X.millis() // 600) % 3 or 2
for k = 0, zt do X.ltext(cx + 60 + k * 16, ptop + 40 - k * 16, k == 2 and "Z" or "z", k == 2 and "ui12" or "ui10", "bold") end
end
local text = (not asleep(p) and X.millis() < say_until and say_text) or pet_says(p)
if not FUR.deco then bubble(text, cx, sy + 8) end
draw_fx(cx, ptop, floor)
if not FUR.deco then X.reg("PETTAP", cx - 80, ptop + 40, 160, 130, function()
if p.stage == 0 then hop_until = X.millis() + 700; say("(something moves inside...)"); fx("found", 900); return end
if asleep(p) then say("Zzz... (shh, it's sleeping)"); return end
hop_until = X.millis() + 700; fx("hearts", 1200); say(pick(LINES.tap), 1800)
end, true) end
end
if lights then
local dark = asleep(p) and not seek
if dark and not (RP and smudge.shade_quad) then smudge.invert_rect(sx + 3, sy + 3, sw - 6, sh - 6) end
local lx, ly = sx + sw - 110, sy + 40
if RP then
local a, b = sw / 2, sh / 2
local x0, y0, k = RP(a - 62, -b + 54, RD)
local x1, y1 = RP(a - 22, -b + 118, RD)
local sn = "art/" .. (dark and "room_switch_off" or "room_switch_on")
smudge.draw_sprite_quad(sn .. ".raw", 40, 64, x0, y0, x1, y0, x1, y1, x0, y1, sn .. "_m.raw")
lx, ly = math.floor((x0 + x1) / 2) - 20, math.floor(y0)
X.ctext(lx + 20, math.floor(y1) + 2, dark and "OFF" or "ON", "small", "bold", dark)
else
pic(lx, ly, 40, 64, dark and "room_switch_off" or "room_switch_on")
X.ctext(lx + 20, ly + 66, dark and "OFF" or "ON", "small", "bold", dark)
end
X.reg("PETLIGHT", lx - 10, ly - 8, 60, 96, function()
if p.busy then return end
seek = nil
local off = not asleep(p)
light_want, light_at = off and "off" or "on", X.time()
smudge.pet_do(off and "lightoff" or "lighton")
if off then X.set_note("Lights off. " .. p.name .. " sleeps for 10 hours. Sweet dreams!")
else X.set_note("Lights on: " .. p.name .. " is awake.") end
end, true)
if dark then
local t = "Sleeping  " .. hms(p.sleepleft)
local tw = X.tw(t, "ui10", "bold") + 28
smudge.rounded_rect(cx - tw // 2, sy + sh - 44, tw, 34, 12, true, 1, false)
smudge.rounded_rect(cx - tw // 2, sy + sh - 44, tw, 34, 12, false, 2)
X.ctext(cx, sy + sh - 40, t, "ui10", "bold")
if not smooth() then X.after(1000, function() if X.scr() == "ourpet" then X.redraw() end end) end
end
end
if RP then room3d_front(sx, sy, sw, sh); if smudge.set_clip then smudge.set_clip() end end
if FUR.deco then
local t = FUR.get()
local hdr = "Tap a piece: buy it, put it in or away"
local hw0 = X.tw(hdr, "small", "bold") + 20
smudge.rounded_rect(W // 2 - hw0 // 2, sy + 6, hw0, 26, 10, true, 1, false); smudge.rounded_rect(W // 2 - hw0 // 2, sy + 6, hw0, 26, 10, false, 2)
X.ctext(W // 2, sy + 8, hdr, "small", "bold")
for _, f in ipairs(FUR.list) do
local bx = FUR.boxes[f.id]
if bx then
local lab = (t[f.id] == 1) and "PUT AWAY" or ((t[f.id] == 0) and "PUT IN" or (f.price .. " coins"))
local tw = X.tw(lab, "small", "bold") + 14
local tx, ty = math.floor(bx[1] + bx[3] / 2 - tw / 2), math.max(sy + 36, bx[2] - 26)
tx = math.max(sx + 4, math.min(sx + sw - tw - 4, tx))
smudge.rounded_rect(tx, ty, tw, 22, 8, true, 1, false); smudge.rounded_rect(tx, ty, tw, 22, 8, false, 2)
X.ctext(tx + tw // 2, ty + 1, lab, "small", "bold")
X.reg("FUR" .. f.id, math.min(tx, bx[1]), ty, math.max(tw, bx[3]), bx[2] + bx[4] - ty, function() FUR.tap(f, s, p) end, true)
end
end
elseif YB.can and YB.st == "rest" and not seek and (smudge.load("petyarn", "") or "") == "" and YB.sx then
X.ctext(math.floor(YB.sx), math.floor(YB.sy) - 44, "throw me!", "small", "bold")
end
local by = is3d and math.max(sy + sh + 8, block_y) or (sy + sh + 8)
local bw3 = (W - 48 - 24) // 3
minibar(24, by, bw3, "Food", p.food, "food")
minibar(36 + bw3, by, bw3, "Fun", p.fun, "fun")
minibar(48 + 2 * bw3, by, bw3, "Clean", p.clean, "clean")
by = by + 42
local food = X.food_in_bank and X.food_in_bank()
local bw = (W - 48 - 4 * 6) // 5
local acts = { { "FEED", "feed" }, { "PLAY", "play" }, { "CLEAN", "clean" }, { "PET", "pet" }, { "TREAT", "treat" } }
if not newer then acts[5] = nil; bw = (W - 48 - 3 * 6) // 4 end
for k, a in ipairs(acts) do
local sleeping = lights and asleep(p)
X.button(24 + (k - 1) * (bw + 6), by, bw, 48, a[1], function()
if sleeping then X.set_note(p.name .. " is asleep. Switch the light on to wake it up."); return end
seek = nil; care(p, s, a[2], newer)
end, { font = "small", off = p.busy or sleeping or (a[2] == "treat" and not food), id = "PET" .. a[1] })
end
local ry = by + 54
local hw = (W - 48 - 10) // 2
local w = wish_of(p, newer)
local wn, wc = wish_state(p)
local wdone = w and wn >= w[2]
local wcoins = 80 + 15 * p.level
X.button(24, ry, hw, 48, wc and "WISH DONE" or (wdone and "WISH COME TRUE!" or string.format("WISH %d/%d", math.min(wn, w[2]), w[2])), function()
if wc then X.set_note(p.name .. " has a new wish tomorrow."); return end
if not wdone then X.set_note(p.name .. "'s wish for you today: " .. w[3] .. "."); return end
smudge.save("petwish", p.day .. "|" .. wn .. "|1")
X.add_coins(wcoins)
local msg = "Wish come true: +" .. wcoins .. " coins"
if X.rnd(1, 5) == 1 then s.camp.tickets = s.camp.tickets + 1; msg = msg .. " and a pack ticket" end
X.save_now(); X.set_note(msg .. "!"); fx("treat", 1500); hop_until = X.millis() + 700
end, { font = "small", sub = wc and "tomorrow again" or (wdone and ("+" .. wcoins .. " coins") or w[3]), off = wc, id = "PETWISH" })
local sw_ = seek_state(p)
X.button(34 + hw, ry, hw, 48, "HIDE & SEEK", function()
if p.stage == 0 then X.set_note("An egg can't hide yet. Hatch it first!"); return end
if asleep(p) then X.set_note(p.name .. " is asleep." .. (lights and " Switch the light on first." or " Play hide and seek in the daytime.")); return end
if seek then seek = nil; return end
seek = { hide = X.rnd(1, 3) }
end, { font = "small", sub = seek and "stop" or (sw_ < 3 and ("find it: +" .. (20 + 2 * p.level) .. "c") or "just for fun"), id = "PETSEEK", off = p.stage == 0 })
ry = ry + 54
local claimed = smudge.load("petday", "") == p.day
local mile, mile_ok = next_mile(p)
if p.together and not claimed then
X.button(24, ry, hw, 48, "TOGETHER", function()
smudge.save("petday", p.day); s.camp.tickets = s.camp.tickets + 1; X.save_now()
X.set_note("You both took care of " .. p.name .. " today: +1 pack ticket!"); fx("hearts", 1400)
end, { font = "small", sub = "+1 pack ticket", id = "PETBONUS" })
elseif mile and mile_ok then
X.button(24, ry, hw, 48, mile[1] .. " DAYS!", function()
mile[3](s); smudge.save("petstreak", tostring(mile[1])); X.save_now()
X.set_note(mile[1] .. " days in a row together: " .. mile[2] .. "!"); fx("levelup", 2600, { text = mile[1] .. " days together!" })
end, { font = "small", sub = mile[2], id = "PETSTREAK" })
else
X.button(24, ry, hw, 48, "TOGETHER", function()
X.set_note(p.together and ("Come back tomorrow" .. (mile and (": " .. mile[1] .. " days in a row gives " .. mile[2]) or "") .. ".")
or ("Take care of " .. p.name .. " today, you and " .. (p.partner ~= "" and p.partner or "your friend") .. ": +1 pack ticket each."))
end, { font = "small", sub = p.together and "done today" or "both care today", off = true, id = "PETBONUS" })
end
local gift_today = smudge.load("petgift", "") == p.day
local happy = math.min(p.food, p.fun, p.clean) >= 60 and p.stage >= 1
X.button(34 + hw, ry, hw, 48, "GIFT", function()
if gift_today then X.set_note(p.name .. " brings you a gift once a day."); return end
if not happy then X.set_note("A happy " .. p.name .. " (everything over 60%) brings you a gift once a day."); return end
smudge.save("petgift", p.day)
local coins = 50 + 10 * p.level
local msg = p.name .. " found " .. coins .. " coins for you"
X.add_coins(coins)
if X.rnd(1, 10) == 1 then s.camp.tickets = s.camp.tickets + 1; msg = msg .. " and a pack ticket" end
hop_until = X.millis() + 700; fx("found", 1300); say("I found this for you!")
X.save_now(); X.set_note(msg .. "!")
end, { font = "small", sub = gift_today and "tomorrow again" or (happy and "it found something!" or "when it's happy"), off = gift_today or not happy, id = "PETGIFT" })
local ly = ry + 56
if #p.log >= 1 then X.ltext(24, ly, X.fit(p.log[1], W - 48, "small", "regular"), "small") end
if p.reader and smudge.cloud_sync then
X.button(24, H - 152, W - 48, 46, p.status ~= "" and p.status or "SYNC NOW", function() smudge.cloud_sync() end,
{ font = "small", sub = "tap to sync now", id = "PETSYNC" })
elseif p.status ~= "" then X.ctext(W / 2, H - 126, p.status, "small", "bold") end
local bw2 = (W - 48 - 10) // 2
X.button(24, H - 96, bw2, 64, "BACK", function() seek = nil; FUR.deco = false; X.go("title") end, { font = "ui10" })
X.button(34 + bw2, H - 96, bw2, 64, FUR.deco and "DONE" or "DECORATE", function()
FUR.deco = not FUR.deco; seek = nil
end, { font = "ui10", sub = FUR.deco and "back to the pet" or "bed, shelf, lamp", id = "PETDECO" })
end
local away = nil
F.check_away = function(last)
local lines = {}
local bw = F.bookworm_claim()
if bw then lines[#lines + 1] = { bw, function() X.go("packs") end } end
local t = X.time()
if last and last > 1500000000 and t - last >= 15 * 60 then
for _, n in ipairs(X.notes_since(last)) do lines[#lines + 1] = n end
end
if #lines == 0 then return false end
away = { secs = (last and last > 1500000000) and (t - last) or 0, lines = lines }
return true
end
local function dur(s)
if s >= 86400 then return (s // 86400) .. " d " .. ((s % 86400) // 3600) .. " h" end
if s >= 3600 then return (s // 3600) .. " h " .. ((s % 3600) // 60) .. " min" end
return (s // 60) .. " min"
end
function F.draw_away()
X.top_bar("Welcome back", "")
local y = X.TOP + 8
if not away then X.go("title"); return end
if away.secs > 0 then X.ctext(W / 2, y, "You were away for " .. dur(away.secs) .. ".", "ui10", "bold") end
X.ctext(W / 2, y + 30, "Tap a line to go there.", "small")
local rh = 64
local per = math.max(1, (H - 200 - (y + 62)) // rh)
for k = 1, math.min(per, #away.lines) do
local l = away.lines[k]
local by = y + 62 + (k - 1) * rh
X.button(24, by, W - 48, rh - 8, "", function() away = nil; l[2]() end, { id = "AWAY" .. k })
smudge.circle(44, by + (rh - 8) // 2, 6, true)
X.wrapped(60, by + 6, l[1], W - 100, "small", 2)
end
if #away.lines > per then X.ctext(W / 2, y + 62 + per * rh, "+" .. (#away.lines - per) .. " more in the notifications (tap the top bar)", "small") end
X.button(24, H - 96, W - 48, 64, "CONTINUE", function() away = nil; X.go("title") end, { font = "ui10", id = "AWAYOK" })
end
return F
end
grade.lua
8751
return function(X)
local GR = {}
local W, H = X.W, X.H
local DUR = 1800
local SLOTS = 3
local WORD = { "POOR", "GOOD", "VERY GOOD", "VG-EX", "EXCELLENT", "EX-MT", "NEAR MINT", "NM-MT", "MINT", "GEM MINT" }
local FIRST = { 4, 6, 9, 13, 17, 18, 15, 10, 6, 2 }
local UP = { 80, 70, 60, 50, 40, 32, 24, 15, 6 }
local grades, slots
local function S() return X.S() end
local function now() return X.time() end
local function save()
local t = {}
for c, g in pairs(grades) do t[#t + 1] = c .. ":" .. g end
table.sort(t)
smudge.save("grades", table.concat(t, ","))
local q = {}
for _, s in ipairs(slots) do q[#q + 1] = s[1] .. ":" .. s[2] end
smudge.save("grading", table.concat(q, ","))
end
local function roll(g)
if g <= 0 then
local r, a = X.rnd(1, 100), 0
for k, p in ipairs(FIRST) do a = a + p; if r <= a then return k end end
return 5
end
if g >= 10 then return 10 end
return (X.rnd(1, 100) <= UP[g]) and g + 1 or g
end
local function load()
grades, slots = {}, {}
for c, g in (smudge.load("grades", "") or ""):gmatch("(%d+):(%d+)") do grades[tonumber(c)] = math.max(1, math.min(10, tonumber(g))) end
for c, t in (smudge.load("grading", "") or ""):gmatch("(%d+):(%d+)") do slots[#slots + 1] = { tonumber(c), tonumber(t) } end
if smudge.load("gmig", "") == "" then
local n = 0
for v in (smudge.load("frames", "") or ""):gmatch("%d+") do
local c = tonumber(v)
if c and not grades[c] then grades[c] = math.max(7, roll(0)); n = n + 1 end
end
smudge.save("gmig", "1")
if n > 0 then save(); GR.migrated = n end
end
end
local function ensure()
if not grades then load() end
local t, fix = now(), false
for _, sl in ipairs(slots) do if sl[2] > t + DUR then sl[2] = t + DUR; fix = true end end
if fix then save() end
end
function GR.reload() grades = nil end
function GR.grade(c) ensure(); return grades[c] or 0 end
function GR.atk(c) return GR.grade(c) // 2 end
function GR.word(g) return WORD[g] or "" end
function GR.price(c) return 0 end
function GR.up_chance(c) local g = GR.grade(c); return g >= 10 and 0 or (g == 0 and 100 or UP[g]) end
function GR.list() ensure(); local t = {} for k, s in ipairs(slots) do t[k] = { s[1], s[2] } end return t end
GR.SLOTS = SLOTS
function GR.busy(c) ensure(); for _, s in ipairs(slots) do if s[1] == c then return s end end return nil end
function GR.ready_count() ensure(); local n = 0; for _, s in ipairs(slots) do if now() >= s[2] then n = n + 1 end end return n end
function GR.send(c)
ensure()
local s = S()
if not X.owned(c) then X.set_note("Find this card first."); return false end
if GR.busy(c) then X.set_note("This card is already away for grading."); return false end
if GR.grade(c) >= 10 then X.set_note(X.cname(c) .. " is already GEM MINT 10: it can't get better."); return false end
if #slots >= SLOTS then X.set_note("The grader takes " .. SLOTS .. " cards at a time. Collect one first."); return false end
local cp = s.camp
for k = 1, 2 do if cp.exp[k][1] == c then X.set_note(X.cname(c) .. " is on an expedition. Send it when it's back."); return false end end
for k = 1, 3 do if cp.x["w" .. k .. "c"] == c then X.set_note(X.cname(c) .. " is working (workers). Take it off first."); return false end end
local left = {}
for i = 1, 3 do if s.deck[i] == c then s.deck[i] = 0; left[#left + 1] = "your deck" end end
if cp.pet == c then cp.pet = 0; left[#left + 1] = "being your pet" end
slots[#slots + 1] = { c, now() + DUR }
save(); X.save_now()
X.set_note(X.cname(c) .. " is away for grading: back in 30 minutes." .. (#left > 0 and (" (It left " .. table.concat(left, " and ") .. ".)") or ""))
return true
end
function GR.break_case(c)
ensure()
local s = S()
if (grades[c] or 0) == 0 then X.set_note("This card isn't in a grading case."); return false end
if GR.busy(c) then X.set_note("It's away for grading right now."); return false end
local cp = s.camp
grades[c] = nil
save()
if s.spare[c] > 0 then
s.spare[c] = s.spare[c] - 1
X.set_note("Case broken: " .. X.cname(c) .. " is ungraded again. It cost 1 spare copy.")
else
s.lvl[c] = 0; s.xp[c] = 0; s.shiny[c] = 0
for i = 1, 3 do if s.deck[i] == c then s.deck[i] = 0 end end
if cp.pet == c then cp.pet = 0 end
for k = 1, 3 do if cp.x["w" .. k .. "c"] == c then cp.x["w" .. k .. "c"] = 0 end end
X.set_note("Case broken: " .. X.cname(c) .. " is gone (no spares). Find it again in packs.")
end
X.save_now()
return true
end
function GR.collect(k)
ensure()
local sl = slots[k]
if not sl or now() < sl[2] then return end
table.remove(slots, k)
local c, old = sl[1], grades[sl[1]] or 0
local g = roll(old)
grades[c] = g
save(); X.save_now()
if old == 0 then X.set_note(string.format("%s is back: GRADE %d %s! (+%d ATK)", X.cname(c), g, WORD[g], g // 2))
elseif g > old then X.set_note(string.format("%s went up: GRADE %d %s! (+%d ATK)", X.cname(c), g, WORD[g], g // 2))
else X.set_note(string.format("%s stays GRADE %d %s. Try again?", X.cname(c), g, WORD[g])) end
GR.last = c
end
function GR.tick()
ensure()
if GR.migrated then local n = GR.migrated; GR.migrated = nil; return "Gold frames became card grading: " .. n .. " framed card" .. (n == 1 and "" or "s") .. " got a free grade (7 or better)." end
return nil
end
function GR.badge(x, y, c, big)
local g = GR.grade(c)
local away = GR.busy(c)
if g == 0 and not away then return end
local w, h = big and 46 or 30, big and 30 or 22
smudge.rounded_rect(x + 4, y + 4, w, h, 5, true)
smudge.rounded_rect(x + 5, y + 5, w - 2, h - 2, 4, false, 1, false)
X.ctext(x + 4 + w // 2, y + 4 + (h - X.lh(big and "ui12" or "small")) // 2, away and "..." or tostring(g), big and "ui12" or "small", "bold", true)
end
local gpage, gconf, gmode = 0, nil, "grade"
function GR.draw()
ensure()
local s = S()
X.top_bar("Card grading", "free")
local y = X.TOP + 4
local sw = (W - 48 - 2 * 8) // 3
for k = 1, SLOTS do
local sx = 24 + (k - 1) * (sw + 8)
smudge.rounded_rect(sx, y, sw, 150, 10, false, 2)
local sl = slots[k]
if sl then
X.thumb(sx + (sw - 108) // 2, y + 6, sl[1], {})
local left = sl[2] - now()
if left <= 0 then
X.button(sx + 6, y + 112, sw - 12, 34, "COLLECT", function() GR.collect(k) end, { font = "small", id = "GCOL" .. k, nohelp = true })
else
X.ctext(sx + sw // 2, y + 120, string.format("%d:%02d", left // 60, left % 60), "ui10", "bold")
end
else
X.ctext(sx + sw // 2, y + 56, "empty", "small")
X.ctext(sx + sw // 2, y + 80, "tap a card", "small")
end
end
local hw = (W - 48 - 8) // 2
X.button(24, y + 154, hw, 34, "GRADE (free)", function() gmode = "grade"; gconf = nil end, { font = "small", active = gmode == "grade", id = "GMODE1", nohelp = true })
X.button(32 + hw, y + 154, hw, 34, "BREAK CASE", function() gmode = "break"; gconf = nil end, { font = "small", active = gmode == "break", id = "GMODE2", nohelp = true })
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
X.swipe_tabs(function() return gpage end, function(t) gpage = t; gconf = nil end, 0, 6)
local ty = y + 196
for i = 0, 6 do
X.button(6 + i * 67, ty, 63, 50, tabs[i + 1], function() if gpage == i then X.grid_flip("grading", i) end; gpage = i; gconf = nil end,
{ font = "small", sub = (function() local n, t = X.grid_count(i, function(c) return GR.grade(c) > 0 end); return n .. "/" .. t end)(),
active = (gpage == i), id = "GT" .. i })
end
local y0 = ty + 62
X.grid("grading", gpage, y0, 2, 162, function(c, x, yy)
X.thumb(x, yy, c, { name = false })
local own = X.owned(c)
local g = GR.grade(c)
local txt
if not own then txt = "not found"
elseif GR.busy(c) then txt = "away"
elseif gconf == c then txt = "TAP AGAIN"
elseif gmode == "break" then txt = g > 0 and ("break G" .. g) or "-"
elseif g >= 10 then txt = "GEM MINT"
elseif g > 0 then txt = "G" .. g .. "  " .. UP[g] .. "% up"
else txt = "send" end
X.ctext(x + 54, yy + 116, txt, "small", "bold")
X.reg("GRADE" .. c, x, yy, 108, 140, function()
if not own then X.set_note("Find this card first."); return end
if gmode == "break" then
if GR.grade(c) == 0 then X.set_note("Only a graded card has a case to break."); return end
if gconf ~= c then
gconf = c
if S().spare[c] > 0 then
X.set_note(string.format("Tap again to break the case of %s: its grade is gone and it costs 1 spare copy (you have %d).", X.cname(c), S().spare[c]))
else
X.set_note(string.format("WARNING: no spares! Breaking the case loses %s itself (back to not found). Tap again to break it.", X.cname(c)))
end
return
end
gconf = nil; GR.break_case(c); return
end
if gconf ~= c then
gconf = c
local g2 = GR.grade(c)
X.set_note(g2 == 0 and string.format("Tap again: send %s for grading (free, 30 minutes).", X.cname(c))
or string.format("Tap again: grade %s again (free, %d%% chance to go up from %d).", X.cname(c), GR.up_chance(c), g2))
return
end
gconf = nil; GR.send(c)
end, true)
end)
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("packs") end, { font = "ui10" })
end
return GR
end
