blob(c[1] + math.cos(a1) * rr2, c[2] + math.sin(a1) * rr2, c[1] + math.cos(a2) * rr2, c[2] + math.sin(a2) * rr2, 3, cr, cg - 40, cb - 40, 0.6 * (1 - ba))
end
smudge.glow_circle(c[1], c[2], c[4] * 0.25, 255, 255, 240, 2.4 * (1 - ba) ^ 2)
