}
D.tier_line = { "A tiny hatchling.", "A quick learner.", "A seasoned fighter.", "A legend of old.", "A rare wonder.", "A glitch in the world.", "A secret." }
D.ability = {
"Scorch: every hit sets the enemy burning.",
"Tidal Mend: heals 3 HP at the start of each turn.",
"Stone Hide: all damage taken is reduced by 3.",
"Double Strike: 30% chance to hit twice.",
"Eclipse Bite: drains half of the damage dealt.",
"Second Dawn: revives once with half HP.",
"Thornbark: reflects 2 damage to attackers.",
"Lucid Haze: enemy attacks miss 30% of the time.",
}
D.ability_short = { "SCORCH", "MEND", "STONE", "DOUBLE", "DRAIN", "DAWN", "THORNS", "HAZE" }
D.elem_atk = { 7, 6, 5, 8, 9, 8, 7, 8 }
D.elem_hp  = { 24, 28, 36, 20, 26, 30, 32, 28 }
D.tier_atk = { 0, 1, 3, 7, 10, 12, 20 }
D.tier_hp  = { 0, 4, 8, 16, 22, 28, 45 }
D.beats = { 7, 1, 4, 2, 8, 5, 3, 6 }
D.weak = {}
for e = 1, 8 do D.weak[D.beats[e]] = e end
D.sell_value  = { 3, 5, 8, 20, 35, 60, 500 }
D.dust_value  = { 5, 9, 15, 50, 90, 150, 400 }
D.xp_value    = { 20, 30, 40, 80, 110, 160, 300 }
D.craft_cost  = { 25, 45, 70, 200, 380, 600, 99999 }
D.xp_need     = { 30, 60, 100, 150 }
D.max_level   = 5
D.max_spare   = 99
D.pack_cost   = 30
D.start_coins = 100
D.ranks = { "Rookie", "Collector", "Expert", "Master", "Legend" }
return D
farming.lua
16278
return function(X, C, ADV, H)
local F = {}
local W, Hh = X.W, X.H
local fl = math.floor
local SI = 10
local PHONE = smudge.smooth == true
local function hd() return PHONE and GFX and GFX.ok and GFX.ok() and smudge.hires_quad end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function vib(p) if VIB then VIB.play(p, true) end end
local function now() return X.time() end
local function ms() return X.millis() end
local CROPS, ITEMS = H.CROPS, H.ITEMS
local NPLOT = 9
local WEEDT = 45 * 60
local WET = 3600
local COMPOST = 15
local TOOLS = { { "rake", "RAKE" }, { "plant", "PLANT" }, { "water", "WATER" }, { "compost", "COMPOST" } }
local tool = "rake"
local sel = 1
local PL = {}
local SCN = nil
local SS = nil
local PARTS = {}
local POUR = nil
local SWIPE = nil
local TRAIL = {}
local LAST = nil
local function g(cp, f, k) return cp.x[f .. k] or 0 end
local function sx(cp, f, k, v) cp.x[f .. k] = v end
local function weeds(cp, k)
local r = g(cp, "fr", k)
if r == 0 then return 3 end
return math.min(3, g(cp, "fd", k) + fl((now() - r) / WEEDT))
end
local function wet(cp, k) return math.max(0, math.min(1, (g(cp, "fw", k) - now()) / WET)) end
local function stage(cp, k)
local pl = cp.plots[k]
if pl[1] == 0 then return -1 end
if now() >= pl[2] then return 4 end
local s0 = g(cp, "fs", k)
if s0 == 0 or pl[2] <= s0 then return 2 end
return math.min(3, fl((now() - s0) / (pl[2] - s0) * 4))
end
local function burst(kind, x, y, n)
for _ = 1, n do
PARTS[#PARTS + 1] = { kind = kind, x = x, y = y, vx = (X.rnd(0, 100) - 50) * 1.2, vy = -30 - X.rnd(0, 60), t0 = ms() }
end
if #PARTS > 40 then table.remove(PARTS, 1) end
end
local function rake(S, k, px, py)
local cp = S.camp
local w = weeds(cp, k)
if w == 0 then return false end
sx(cp, "fd", k, w - 1); sx(cp, "fr", k, now())
burst("leaf", px, py, 5); snd("fm_rake", 0.4); vib("sf_click")
if w - 1 == 0 then X.set_note("Plot " .. k .. " is clear.") end
X.mark_dirty(); X.save_now()
return true
end
local function plant(S, k, quiet)
local cp = S.camp
local cr = CROPS[sel]
if k > H.nplots(cp) or cp.plots[k][1] ~= 0 then if not quiet then X.set_note("Something is growing here already.") end; return false end
if weeds(cp, k) > 0 then if not quiet then X.set_note("Rake the weeds first (RAKE: swipe over the plot).") end; return false end
if H.slevel(cp, SI) < cr[2] then if not quiet then X.set_note("You need Farming level " .. cr[2] .. ".") end; return false end
if S.coins < cr[7] then if not quiet then X.set_note("Seeds cost " .. cr[7] .. " coins.") end; return false end
S.coins = S.coins - cr[7]
local t = now()
cp.plots[k] = { sel, t + fl(cr[3] * 60 * ADV.grow_mult(cp)) }
sx(cp, "fs", k, t); sx(cp, "fa", k, 0)
if wet(cp, k) > 0 then sx(cp, "fa", k, 1) end
if not quiet then
local p = PL[k]
if p then burst("dirt", p[1] + p[3] / 2, p[2] + p[4] / 2, 6) end
snd("fm_plant", 0.45)
X.set_note(string.format("Planted %s. Ready in %d minutes.", cr[1], cr[3])); X.save_now()
end
return true
end
local function water(cp, k, secs)
local t = now()
local w0 = math.max(g(cp, "fw", k), t)
local w1 = math.min(t + WET, w0 + secs)
if w1 <= w0 then return false end
local pl = cp.plots[k]
if pl[1] ~= 0 and pl[2] > t then
local gain = math.max(0, math.min(w1, pl[2]) - w0) * 0.2 / 1.2
pl[2] = fl(pl[2] - gain)
sx(cp, "fa", k, 1)
end
sx(cp, "fw", k, w1)
return true
end
local function compost(S, k)
local cp = S.camp
if cp.plots[k][1] ~= 0 then X.set_note("Compost goes in before planting."); return end
if g(cp, "fm", k) == 1 then X.set_note("This plot is composted already."); return end
if S.coins < COMPOST then X.set_note("Compost costs " .. COMPOST .. " coins."); return end
S.coins = S.coins - COMPOST
sx(cp, "fm", k, 1)
local p = PL[k]
if p then burst("dirt", p[1] + p[3] / 2, p[2] + p[4] / 2, 8) end
snd("fm_plant", 0.4)
X.set_note("Composted: +1 crop at harvest (" .. COMPOST .. " coins)."); X.mark_dirty(); X.save_now()
end
local function harvest(S, k, quiet)
local cp = S.camp
local pl = cp.plots[k]
if k > H.nplots(cp) or pl[1] == 0 or pl[2] > now() then return nil end
local cr = CROPS[pl[1]]
local n = X.rnd(cr[4], cr[5])
local bonus = g(cp, "fm", k) + ((weeds(cp, k) == 0) and 1 or 0) + g(cp, "fa", k)
n = n + bonus
local hnote = ADV.G.pet_roll(S, SI)
H.stash(cp, cr[8], n)
cp.plots[k] = { 0, 0 }
sx(cp, "fm", k, 0); sx(cp, "fa", k, 0); sx(cp, "fs", k, 0)
cp.stat[3] = cp.stat[3] + 1
local xp = H.xp_amt(cp, cr[6], SI)
local lv = H.give_xp(S, SI, xp)
local p = PL[k]
if p then burst("pick", p[1] + p[3] / 2, p[2] + p[4] / 2, 12) end
if not quiet then
snd("fm_pick", 0.5); vib("sf_bolt")
X.set_note(string.format("Harvested %d %s%s  (+%d xp)", n, ITEMS[cr[8]][1], bonus > 0 and ("  (+" .. bonus .. " for looking after it)") or "", xp) .. lv .. hnote)
X.save_now()
end
return cr[8], n, xp, lv .. hnote, bonus
end
local function plant_all(S)
local cp = S.camp
local cr = CROPS[sel]
if H.slevel(cp, SI) < cr[2] then X.set_note("You need Farming level " .. cr[2] .. "."); return end
local n, weedy = 0, 0
for k = 1, H.nplots(cp) do
if cp.plots[k][1] == 0 then
if weeds(cp, k) > 0 then weedy = weedy + 1 elseif plant(S, k, true) then n = n + 1 end
end
end
if n == 0 then
X.set_note(weedy > 0 and "Rake the weeds first (RAKE: swipe over a plot)." or (S.coins < cr[7] and ("Seeds cost " .. cr[7] .. " coins.") or "No empty plots."))
return
end
snd("fm_plant", 0.45)
X.set_note(string.format("Planted %s in %d plot%s (%d coins). Ready in %d minutes.", cr[1], n, n > 1 and "s" or "", n * cr[7], cr[3])
.. (weedy > 0 and ("  (" .. weedy .. " weedy plot" .. (weedy > 1 and "s" or "") .. " skipped)") or ""))
X.save_now()
end
local function harvest_all(S)
local cp = S.camp
local got, order, xp, extra, bon = {}, {}, 0, "", 0
for k = 1, H.nplots(cp) do
local it, n, x, t, b = harvest(S, k, true)
if it then
if not got[it] then got[it] = 0; order[#order + 1] = it end
got[it] = got[it] + n; xp = xp + x; extra = extra .. t; bon = bon + b
end
end
if #order == 0 then X.set_note("Nothing is ripe yet."); return end
local parts = {}
for _, it in ipairs(order) do parts[#parts + 1] = got[it] .. " " .. ITEMS[it][1] end
snd("fm_pick", 0.5)
X.set_note("Harvested " .. table.concat(parts, ", ") .. (bon > 0 and ("  (+" .. bon .. " for care)") or "") .. string.format("  (+%d xp)", xp) .. extra)
X.save_now()
end
local function use(S, k, px, py)
local cp = S.camp
if k > H.nplots(cp) then H.buy_plot(S); return end
if stage(cp, k) == 4 then harvest(S, k); return end
if tool == "rake" then if not rake(S, k, px, py) then X.set_note("No weeds here.") end
elseif tool == "plant" then plant(S, k)
elseif tool == "water" then
if water(cp, k, PHONE and 600 or WET) then snd("fm_water", 0.4); X.mark_dirty(); X.save_now() else X.set_note("The soil is soaked.") end
elseif tool == "compost" then compost(S, k) end
end
FARMT = {}
local function plot_at(px, py)
for k = 1, NPLOT do local p = PL[k]; if p and px >= p[1] and px < p[1] + p[3] and py >= p[2] - 8 and py < p[2] + p[4] then return k end end
end
function FARMT.touch(ev, px, py)
if not SS or not hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
local cp = SS.camp
if ev == "down" then
local k = plot_at(px, py)
local inside = SCN and px >= SCN[1] and px < SCN[1] + SCN[3] and py >= SCN[2] and py < SCN[2] + SCN[4]
if not k and not inside then return false end
SWIPE = { k = k, x = px, y = py, dir = 0, done = {}, moved = false, k0 = k }
TRAIL = { { px, py, ms() } }
if not k then busy(); return true end
if stage(cp, k) == 4 then busy(); return true end
if tool == "water" and k <= H.nplots(cp) then POUR = { k = k, x = px, y = py, t = ms(), snd = 0 }; busy(); return true end
use(SS, k, px, py); busy()
return true
end
if not SWIPE then return false end
if ev == "move" or ev == "nudge" then
local k = plot_at(px, py)
if POUR then if k and k <= H.nplots(cp) then POUR.k = k end; POUR.x, POUR.y = px, py; busy(); return true end
if math.abs(px - SWIPE.x) + math.abs(py - SWIPE.y) > 4 then SWIPE.moved = true end
TRAIL[#TRAIL + 1] = { px, py, ms() }
if #TRAIL > 14 then table.remove(TRAIL, 1) end
if k and k <= H.nplots(cp) and stage(cp, k) == 4 and not SWIPE.done[k] and SWIPE.moved then
SWIPE.done[k] = true
harvest(SS, k)
elseif k and k <= H.nplots(cp) then
if tool == "rake" then
local d = px > SWIPE.x + 6 and 1 or (px < SWIPE.x - 6 and -1 or 0)
if d ~= 0 then
if d ~= SWIPE.dir then SWIPE.dir = d; rake(SS, k, px, py) end
SWIPE.x = px
end
end
end
busy()
return true
end
if ev == "release" or ev == "up" or ev == "tap" then
if not SWIPE.moved and not POUR and SWIPE.k0 and stage(cp, SWIPE.k0) == 4 then harvest(SS, SWIPE.k0) end
SWIPE = nil
if POUR then POUR = nil; X.save_now() end
return true
end
return false
end
local function pic(n, x, y, w, h, sway)
local s = sway or 0
local o = -9
smudge.hires_quad("^hd/fm_" .. n .. "_c.png", o, o, o, o, o, o, o, o, x + s, y, x + w + s, y, x + w, y + h, x, y + h)
end
local function drop_icon(x, y)
smudge.circle(x + 4, y + 9, 4, true)
smudge.triangle(x, y + 8, x + 8, y + 8, x + 4, y + 1, true)
end
local function draw_patch(S, x, y, sw, sh)
local cp = S.camp
local t = ms()
local HD = hd()
local n = H.nplots(cp)
SCN = { x, y, sw, sh }
if HD then
local lx, rx = x + 0.75, x + sw - 1.75
smudge.hires_quad("hd/fm_grass_c.png", lx, y, rx, y, rx, y + sh, lx, y + sh, x, y, x + sw, y, x + sw, y + sh, x, y + sh)
else
smudge.rect(x, y, sw, sh, false, 2)
smudge.line(x, y + 12, x + sw, y + 12, 2); smudge.line(x, y + sh - 10, x + sw, y + sh - 10, 2)
end
local top, bot = 28, 22
local pitch = (sh - top - bot) / 3
local pw = fl((sw - 28 - 20) / 3)
local ph = fl(pitch - 29)
local anim = false
for k = 1, NPLOT do
local c, r = (k - 1) % 3, fl((k - 1) / 3)
local px, py = fl(x + 14 + c * (pw + 10)), fl(y + top + r * pitch)
PL[k] = { px, py, pw, ph }
if k > n then
local up = H.FARM_UP[k - 3]
if HD then smudge.rounded_rect(px + 10, py + ph / 2 - 20, pw - 20, 44, 10, true, 1, false) end
smudge.rounded_rect(px + 10, fl(py + ph / 2 - 20), pw - 20, 44, 10, false, 2)
X.ctext(px + pw // 2, fl(py + ph / 2 - 17), "Plot " .. k, "small", "bold")
X.ctext(px + pw // 2, fl(py + ph / 2 + 2), up and string.format("Lv %d  %dc", up[1], up[2]) or "", "small")
if not HD then smudge.rect_dither(px, py, pw, ph, false) end
else
local st = stage(cp, k)
local w = weeds(cp, k)
local sway = 0
if HD then
pic("soil", px, py, pw, ph)
if g(cp, "fm", k) == 1 then pic("compost", px, py, pw, ph) end
if st == 0 then pic("seeds", px, py, pw, ph)
elseif st > 0 then
local cr = cp.plots[k][1]
sway = (st >= 2) and math.sin(t / 650 + k * 1.7) * 1.4 or 0
if st >= 2 then anim = true end
local eh = ph * 73 / 67
pic("c" .. cr .. "_" .. st, px, py + ph - eh, pw, eh, sway)
end
if w > 0 then pic("weeds" .. w, px, py, pw, ph, math.sin(t / 500 + k) * 0.6); anim = true end
if st == 4 and fl(t / 400) % 2 == 0 then
local qx, qy = px + pw - 10, py + 8
smudge.rect(qx - 4, qy - 1, 9, 3, true, 1, false); smudge.rect(qx - 1, qy - 4, 3, 9, true, 1, false)
end
if st == 4 then anim = true end
else
smudge.rect(px, py, pw, ph, false, 2)
for q = 1, 2 do smudge.line(px + 4, fl(py + q * ph / 3), px + pw - 4, fl(py + q * ph / 3), 1) end
if st >= 0 then
for rr = 0, 3 do for cc = 0, 3 do
local ax, ay = fl(px + 14 + cc * (pw - 28) / 3), fl(py + (rr + 1) * ph / 4 - 3)
if st == 0 then smudge.rect(ax - 1, ay, 3, 2, true)
else
local hh = ({ 4, 8, 12, 14 })[st]
smudge.line(ax, ay, ax, ay - hh, 1)
if st >= 2 then smudge.line(ax - 3, ay - hh / 2, ax, ay - hh / 2 - 2, 1); smudge.line(ax + 3, ay - hh / 2 - 1, ax, ay - hh / 2 - 3, 1) end
if st == 4 then smudge.circle(ax, ay - hh, 3, true) elseif st == 3 then smudge.circle(ax, ay - hh, 2, false, 1) end
end
end end
end
for q = 1, w * 3 do
local wx, wy = px + 6 + (q * 37 + k * 11) % (pw - 12), py + 8 + (q * 23 + k * 7) % (ph - 12)
smudge.line(wx, wy, wx - 3, wy - 5, 1); smudge.line(wx, wy, wx + 3, wy - 5, 1)
end
if g(cp, "fm", k) == 1 then smudge.rect_dither(px + 2, py + ph - 6, pw - 4, 4, true) end
end
local by = py + ph + 3
smudge.rounded_rect(px, by, pw, 20, 7, true, 1, false)
smudge.rounded_rect(px, by, pw, 20, 7, false, 1)
drop_icon(px + 5, by + 2)
local bw = fl(pw * 0.36)
local wv = wet(cp, k)
smudge.rect(px + 17, by + 6, bw, 9, false, 1)
if wv > 0 then smudge.rect(px + 19, by + 8, fl((bw - 4) * wv), 5, true) end
if wv > 0 then anim = true end
local txt
if st == 4 then txt = "READY"
elseif st >= 0 then txt = H.mmss(cp.plots[k][2] - now())
else txt = (w > 0) and "weeds" or "empty" end
X.rtext(px + pw - 6, by + 1, txt, "small", st == 4 and "bold" or nil)
end
if not HD then
X.reg("FPLOT" .. k, px, py, pw, ph + 22, function()
local kk = k
if kk > H.nplots(cp) then H.buy_plot(S); return end
use(S, kk, px + pw / 2, py + ph / 2)
end, false)
end
end
if HD and POUR then
local p = PL[POUR.k]
if p then
local cx, cy = POUR.x - 34, POUR.y - 70
pic("can", cx, cy, 40, 26)
for q = 0, 5 do
local f = ((t / 380) + q / 6) % 1
pic("drop", cx + 2 + (q % 3) * 3 - f * 6, cy + 8 + f * 48, 2, 6)
end
end
anim = true
end
if HD and #TRAIL > 1 then
local any = false
for i = 2, #TRAIL do
local a, b = TRAIL[i - 1], TRAIL[i]
local age = t - b[3]
if age < 260 then
any = true
local wd = age < 120 and 3 or 2
smudge.line(fl(a[1]), fl(a[2]), fl(b[1]), fl(b[2]), wd + 2)
smudge.line(fl(a[1]), fl(a[2]), fl(b[1]), fl(b[2]), wd, false)
end
end
if any then anim = true else TRAIL = {} end
end
if HD then
local keep = {}
for _, q in ipairs(PARTS) do
local s = (t - q.t0) / 1000
if s < 0.9 then
keep[#keep + 1] = q
local qx, qy = q.x + q.vx * s, q.y + q.vy * s + 160 * s * s
local sz = q.kind == "leaf" and 6 or 4
pic(q.kind, qx, qy, sz, q.kind == "leaf" and 4 or 4)
end
end
PARTS = keep
if #PARTS > 0 then anim = true end
end
return anim
end
function F.draw(S, y)
local cp = S.camp
SS = S
local t = ms()
local dt = LAST and math.min(0.1, (t - LAST) / 1000) or 0
LAST = t
if POUR then
if water(cp, POUR.k, dt * WET / 1.4) then
if t - POUR.snd > 450 then POUR.snd = t; snd("fm_water", 0.35) end
end
end
local by = Hh - 96 - 60
local sw = 464
local sh = fl(math.min(500, by - 8 - y - 120))
local x = fl((W - sw) / 2)
local anim = draw_patch(S, x, y, sw, sh)
if anim or POUR then busy() else LAST = nil end
local ty = y + sh + 6
local tw = fl((W - 48 - 3 * 5) / 4)
for i, tl in ipairs(TOOLS) do
X.button(24 + (i - 1) * (tw + 5), ty, tw, 48, tl[2], function() tool = tl[1]; X.mark_dirty() end,
{ font = "small", id = "FT" .. tl[1], active = tool == tl[1], nohelp = true })
end
local ry = ty + 54
local cr = CROPS[sel]
X.button(24, ry, 48, 48, "<", function() sel = (sel - 2) % #CROPS + 1 end, { font = "ui12", id = "FSPREV", nohelp = true })
X.button(W - 72, ry, 48, 48, ">", function() sel = sel % #CROPS + 1 end, { font = "ui12", id = "FSNEXT", nohelp = true })
smudge.rounded_rect(78, ry, W - 156, 48, 10, false, 1)
local lock = H.slevel(cp, SI) < cr[2]
X.ctext(W // 2, ry + 2, cr[1] .. " seeds", "ui10", "bold")
X.ctext(W // 2, ry + 25, lock and ("Farming level " .. cr[2]) or string.format("Lv %d  Â·  %d min  Â·  %dc", cr[2], cr[3], cr[7]), "small")
local bw = fl((W - 48 - 12) / 3)
local ready, empty = 0, 0
for k = 1, H.nplots(cp) do local st = stage(cp, k); if st == 4 then ready = ready + 1 elseif st < 0 then empty = empty + 1 end end
X.button(24, by, bw, 52, "PLANT ALL", function() plant_all(S) end, { font = "small", id = "PLANTALL", sub = empty .. " empty", off = empty == 0, nohelp = true })
X.button(24 + bw + 6, by, bw, 52, "HARVEST ALL", function() harvest_all(S) end,
{ font = "small", id = "HARVESTALL", sub = ready .. " ready", off = ready == 0, dot = ready > 0 and ready or nil, nohelp = true })
local n = H.nplots(cp)
if n < NPLOT then
local up = H.FARM_UP[n - 2]
X.button(24 + 2 * (bw + 6), by, W - 48 - 2 * (bw + 6), 52, "PLOT " .. (n + 1), function() H.buy_plot(S) end,
{ font = "small", id = "BUYPLOT", sub = up and string.format("%dc, Lv %d", up[2], up[1]) or "", off = up and (S.coins < up[2] or H.slevel(cp, SI) < up[1]), nohelp = true })
else
X.button(24 + 2 * (bw + 6), by, W - 48 - 2 * (bw + 6), 52, "BANK", function() H.bank_loot(S) end,
{ font = "small", id = "GBANK", sub = H.inv_used() .. "/" .. H.INV_MAX, nohelp = true })
end
end
F.weeds, F.wet, F.stage = weeds, wet, stage
F.set_tool = function(t) tool = t end
F.set_seed = function(s) sel = s end
return F
end
firemaking.lua
16192
return function(X, C, ADV, H, K)
local F = {}
local fl = math.floor
local SI = 21
local function ms() return X.millis() end
local LIST = {}
for ri in ipairs(H.REC[SI]) do LIST[#LIST + 1] = ri end
local sel = nil
local L, SS, POP, LAST = nil, nil, nil, nil
local ST = nil
local STEPS = { "STRIKE", "BLOW", "TWIGS", "STICKS", "THE LOG" }
local function reset()
ST = { phase = 1, sparks = {}, ember = nil, heat = 0, breath = 1, blowing = false, flame = 0, twigs = 0, sticks = 0,
log = false, catch = 0, done = nil, clean = true, swipe = nil, striker = nil, drag = nil, smoke = {}, blowsnd = 0,
crack = 0, strikes = 0, warm = 0 }
end
reset()
local function tier() return LIST[sel] or 1 end
local function need_log() return 0.6 + 0.025 * tier() end
local FP = {
fi_flame1 = { 83, 138 },
fi_flame2 = { 66, 113 },
fi_flame3 = { 55, 75 },
fi_flame4 = { 39, 88 },
fi_flint = { 132, 89, 0.990, 0.018, 0.907, 0.334 },
fi_striker = { 83, 32 },
fi_tinder = { 61, 49 },
fi_char = { 61, 49 },
fi_twig = { 22, 53 },
fi_twigs = { 39, 66 },
fi_stick = { 44, 91 },
fi_sticks = { 55, 59 },
fi_log1 = { 55, 46 },
fi_log2 = { 55, 52 },
fi_log3 = { 55, 50 },
fi_log4 = { 55, 48 },
fi_log5 = { 55, 47 },
fi_log6 = { 55, 50 },
fi_log7 = { 55, 50 },
fi_log8 = { 55, 47 },
}
local function fp(n, cx, cy, w, ang, ax, ay) local q = FP[n]; return K.pic(n, q[1], q[2], cx, cy, w, ang, ax, ay) end
local function P(px, py) return L.x + px * L.w / 256, L.y + py * L.h / 355 end
local function pit() return P(128.8, 247) end
local function hand() local x, y = P(62, 132); local q = FP.fi_flint; local w = 240; return x, y, w, w * q[2] / q[1] end
local function edge()
local hx, hy, hw, hh = hand()
local q = FP.fi_flint
return hx + (q[3] - 0.5) * hw, hy + (q[4] - 0.5) * hh, hx + (q[5] - 0.5) * hw, hy + (q[6] - 0.5) * hh
end
local PILES = { twig = { 42, 316 }, stick = { 128, 318 }, log = { 214, 318 } }
local function pile_at(px, py)
for k, p in pairs(PILES) do local x, y = P(p[1], p[2]); if (px - x) ^ 2 + (py - y) ^ 2 < 66 * 66 then return k end end
end
local function note(t) if GFX and L then GFX.tapxy = { x = X.W / 2, y = L.ry - 40 } end; X.set_note(t) end
local function strike(sp, down)
ST.strikes = ST.strikes + 1
local good = math.min(1, sp / 1400) * math.max(0.2, math.min(1, down * 1.3 + 0.3))
local ex, ey = edge()
for _ = 1, fl(4 + good * 26) do
ST.sparks[#ST.sparks + 1] = { x = ex, y = ey + X.rnd(0, 20), vx = X.rnd(-50, 40 + fl(80 * good)), vy = X.rnd(-110, 20),
t0 = ms(), life = 400 + X.rnd(0, fl(500 + 600 * good)), hot = 0.5 + good * 0.5 }
end
K.snd("fi_strike", 0.25 + 0.3 * good); K.vib("sf_click")
if good < 0.35 then note("A weak strike: swipe faster, down and across the flint's edge.") end
end
local function feed(S, kind)
local f = ST.flame
if kind == "twig" then
if ST.phase ~= 3 then note(ST.phase < 3 and "Get a flame going first." or "Twigs are done: now the sticks."); return end
if f < 0.2 then ST.flame = math.max(0, f - 0.12); ST.clean = false; K.snd("fi_smother", 0.4); note("Too soon: the flame is too small for a twig. Let it grow (blow on it)."); return end
ST.twigs = ST.twigs + 1; ST.flame = math.min(1, f + 0.16); K.snd("fi_crackle", 0.5)
if ST.twigs >= 3 then ST.phase = 4; note("The twigs catch. Now two sticks (bottom middle), when it burns higher.")
else note("A twig on (" .. ST.twigs .. "/3). Another when it burns up.") end
elseif kind == "stick" then
if ST.phase ~= 4 then note(ST.phase < 4 and "Twigs first: sticks smother a small flame." or "Sticks are done: now the log."); return end
if f < 0.45 then ST.flame = math.max(0, f - 0.2); ST.clean = false; K.snd("fi_smother", 0.45); note("Too soon: the stick smothers it. Let the twigs burn higher first."); return end
ST.sticks = ST.sticks + 1; ST.flame = math.min(1, f + 0.14); K.snd("fi_crackle", 0.55)
if ST.sticks >= 2 then ST.phase = 5; note("The sticks burn. Now the log, when the flame is high enough (the mark on the bar).")
else note("A stick on (" .. ST.sticks .. "/2).") end
else
if ST.phase ~= 5 or ST.log then note(ST.log and "The log is on: keep the flame up until it catches." or "Twigs and sticks first."); return end
if f < need_log() then ST.flame = math.max(0, f - 0.3); ST.clean = false; K.snd("fi_smother", 0.5)
for _ = 1, 10 do local x, y = pit(); ST.smoke[#ST.smoke + 1] = { x = x + X.rnd(-40, 40), y = y - 10, t0 = ms() } end
note("Too big too soon: the log smothers the flame. Let it burn higher first."); return end
ST.log = true; ST.flame = math.min(1, f + 0.08); K.snd("fi_crackle", 0.6)
note("The log is on. Now it has to catch: keep the flame up, blow on it (hold).")
end
end
local function finished(S)
local cp = S.camp
local ri = LIST[sel]
local r = H.REC[SI][ri]
local why = K.why_not(cp, SI, r, "Firemaking")
if why then note(why); return end
for _, nd in ipairs(r[4]) do C.take_items(cp, nd[1], nd[2]) end
ADV.fw = nil
ADV.on_make(S)
cp.stat[2] = cp.stat[2] + 1
local xp = H.xp_amt(cp, fl(r[3] * 3 * (ST.clean and 1.25 or 1) + 0.5), SI)
note(string.format("%s fire!  (+%d xp%s)", ST.clean and "A clean, roaring" or "A roaring", xp, ST.clean and ", clean: +25%" or "") .. H.give_xp(S, SI, xp) .. ADV.G.pet_roll(S, SI))
POP = { t0 = ms(), text = "+" .. xp .. " xp" }
K.snd("fi_whoosh", 0.6); K.vib("sf_bolt")
ST.done = ms()
X.mark_dirty(); X.save_now()
end
local function step(S, dt)
local t = ms()
local px, py = pit()
local keep = {}
for _, s in ipairs(ST.sparks) do
local a = (t - s.t0) / 1000
local x, y = s.x + s.vx * a, s.y + s.vy * a + 350 * a * a
if y > py - 6 and s.vy + 700 * a > 0 then
local hit = ST.phase == 1 and (x - px) ^ 2 + ((y - py) * 2.4) ^ 2 < 70 * 70 and t - s.t0 < s.life
if hit then ST.warm = (ST.warm or 0) + 0.08 * s.hot * (0.7 + X.rnd(0, 60) / 100) end
if hit and ST.warm >= 1 then
ST.ember = { x = x, y = py - 2 }; ST.phase = 2; ST.heat = 0.2; K.snd("fi_crackle", 0.3)
note("An ember! Hold your finger down to blow on it gently, let go to breathe in.")
end
elseif t - s.t0 < s.life then keep[#keep + 1] = s end
end
ST.sparks = keep
if ST.phase == 1 then ST.warm = math.max(0, (ST.warm or 0) - dt * 0.03) end
if ST.phase == 2 then
if ST.blowing and ST.breath > 0 then
ST.heat = ST.heat + dt * 0.16; ST.breath = math.max(0, ST.breath - dt * 0.4)
if t - ST.blowsnd > 600 then ST.blowsnd = t; K.snd("fi_blow", 0.4) end
if ST.breath <= 0 then note("Out of breath: let go to breathe in.") end
if X.rnd(1, 100) <= 30 then ST.smoke[#ST.smoke + 1] = { x = ST.ember.x + X.rnd(-8, 8), y = ST.ember.y - 6, t0 = t } end
else ST.heat = ST.heat - dt * 0.09; ST.breath = math.min(1, ST.breath + dt * 0.55) end
if ST.heat <= 0 then ST.phase = 1; ST.ember = nil; ST.clean = false; ST.warm = 0.5; note("The ember died. Strike again.") end
if ST.heat >= 1 then ST.phase = 3; ST.flame = 0.3; K.snd("fi_whoosh", 0.4); note("The tinder flames up! Now three twigs (bottom left), before it burns out.") end
elseif ST.phase >= 3 and not ST.done then
local fuel = ST.twigs * 0.1 + ST.sticks * 0.15 + (ST.log and 0.2 or 0)
ST.flame = ST.flame - dt * 0.035 * math.max(0.3, 1 - fuel)
if ST.blowing and ST.breath > 0 then
ST.flame = math.min(1, ST.flame + dt * 0.12); ST.breath = math.max(0, ST.breath - dt * 0.4)
if t - ST.blowsnd > 600 then ST.blowsnd = t; K.snd("fi_blow", 0.35) end
elseif not ST.blowing then ST.breath = math.min(1, ST.breath + dt * 0.55) end
if ST.log then
ST.catch = ST.catch + dt * math.max(0, ST.flame - 0.45) * 0.2 * (1 - tier() * 0.05)
if ST.catch >= 1 then finished(S) end
end
if ST.flame <= 0 then
ST.phase, ST.flame, ST.twigs, ST.sticks, ST.log, ST.catch, ST.ember, ST.clean = 1, 0, 0, 0, false, 0, nil, false
note("The fire went out. Strike again.")
end
end
if ST.phase >= 3 then
if t - ST.crack > 300 + X.rnd(0, 700) then ST.crack = t; K.snd("fi_crackle", 0.15 + 0.35 * ST.flame) end
if X.rnd(1, 100) <= 6 + ST.flame * 10 then ST.smoke[#ST.smoke + 1] = { x = px + X.rnd(-20, 20), y = py - 30 - ST.flame * 70, t0 = t } end
end
if ST.done and t - ST.done > 7000 then local s = sel; reset(); sel = s end
local sk = {}
for _, s in ipairs(ST.smoke) do if t - s.t0 < 2400 then sk[#sk + 1] = s end end
ST.smoke = sk
end
FIRET = {}
function FIRET.touch(ev, px, py)
if not SS or not L or not K.hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
local inside = px >= L.x and px < L.x + L.w and py >= L.y and py < L.y + L.h
if ev == "down" then
if not inside or ST.done then return inside end
local cp = SS.camp
local why = K.why_not(cp, SI, H.REC[SI][LIST[sel]], "Firemaking")
if why then note(why); return true end
if ST.phase == 1 then ST.swipe = { px, py, ms() }; ST.striker = { px, py }
elseif ST.phase == 2 then ST.blowing = true
else
local k = pile_at(px, py)
if k then ST.drag = { kind = k, x = px, y = py } else ST.blowing = true end
end
K.busy(); return true
end
if ev == "move" or ev == "nudge" then
if ST.swipe then
local l = ST.swipe
local t = ms()
local x0, y0, x1, y1 = edge()
local ex = (x0 + x1) / 2
if l[1] >= ex and px < ex and py > y0 - 40 and py < y1 + 50 then
local d = math.sqrt((px - l[1]) ^ 2 + (py - l[2]) ^ 2)
strike(d / math.max(0.008, (t - l[3]) / 1000), (py - l[2]) / math.max(1, d))
end
ST.swipe = { px, py, t }; ST.striker = { px, py }
end
if ST.drag then ST.drag.x, ST.drag.y = px, py end
K.busy(); return ST.swipe ~= nil or ST.drag ~= nil or ST.blowing
end
if ev == "release" or ev == "up" or ev == "tap" then
local was = ST.swipe or ST.drag or ST.blowing
ST.swipe, ST.striker, ST.blowing = nil, nil, false
if ST.drag then
local d = ST.drag; ST.drag = nil
local x, y = pit()
if (d.x - x) ^ 2 + (d.y - y) ^ 2 < 110 * 110 then feed(SS, d.kind) else note("Drop it on the fire.") end
end
return was and true or false
end
return false
end
local function draw_scene(S)
local t = ms()
local HD = K.hd()
local x, y = L.x, L.y
if not HD then
smudge.rect(x, y, L.w, L.h, false, 2)
local cx, cy = pit()
smudge.circle(fl(cx), fl(cy), 60, false, 3)
X.ctext(fl(cx), fl(cy) - 10, "FIRE PIT", "ui12", "bold")
X.ctext(fl(cx), fl(cy) + 80, "Tap to light one.", "small")
X.reg("FISCN", x, y, L.w, L.h, function()
local why = K.why_not(S.camp, SI, H.REC[SI][LIST[sel]], "Firemaking")
if why then X.set_note(why); return end
H.make(S, SI, LIST[sel])
end, false)
return false
end
K.tile("hd/fi_night_c.png", x, y, x + L.w, y + L.h)
local px, py = pit()
local f = ST.phase >= 3 and ST.flame or (ST.phase == 2 and ST.heat * 0.3 or 0)
if ST.done then f = 1 end
if f > 0.02 then K.pic("fi_light", 128, 128, px, py - 20, 160 + f * 420) end
fp((ST.phase >= 3 or ST.heat > 0.5) and "fi_char" or "fi_tinder", px, py, 110, 0, 0.5, 0.7)
if ST.phase == 1 and (ST.warm or 0) > 0.15 then
K.pic("fi_ember", 32, 32, px, py - 2, 20 + ST.warm * 40)
if X.rnd(1, 100) <= fl(ST.warm * 12) then ST.smoke[#ST.smoke + 1] = { x = px + X.rnd(-12, 12), y = py - 6, t0 = t } end
end
for k = 1, ST.twigs do fp("fi_twig", px + (k - 2) * 12, py - 6, 40, math.pi / 2 + (k - 2) * 0.55) end
for k = 1, ST.sticks do fp("fi_stick", px, py - 8 - k * 4, 50, math.pi / 2 + (k == 1 and 0.4 or -0.4)) end
if ST.log or ST.done then fp("fi_log" .. tier(), px, py - 8, 78, 0) end
if f > 0.02 and ST.phase >= 3 or ST.done then
local sz = f < 0.38 and 1 or (f < 0.72 and 2 or 3)
local GW, GH = ({ 30, 36, 42 })[sz], ({ 24, 34, 46 })[sz]
local lo = ({ 0, 0.38, 0.72 })[sz]
local px3 = 2.6 + 0.9 * math.min(1, (f - lo) / 0.36)
local fr = fl(t / 85) % 12 + 1
K.pic("fi_px" .. sz .. "_" .. fr, GW, GH, px, py + 2, GW * px3, 0, 0.5, 1)
end
if ST.phase == 2 and ST.ember then
local pulse = 0.85 + 0.15 * math.sin(t / (ST.blowing and 50 or 200))
K.pic("fi_ember", 32, 32, ST.ember.x, ST.ember.y, (24 + ST.heat * 70) * pulse)
if ST.blowing then for k = 1, 3 do K.pic("fi_spark" .. (k % 2 + 1), 3, 3, ST.ember.x + X.rnd(-10, 10), ST.ember.y - X.rnd(0, fl(20 * ST.heat + 4)), 8) end end
end
for _, s in ipairs(ST.smoke) do
local a = (t - s.t0) / 2400
K.pic("fi_smoke", 24, 24, s.x + math.sin(a * 6 + s.x) * 10, s.y - a * 110, 20 + a * 50)
end
for _, s in ipairs(ST.sparks) do
local a = (t - s.t0) / 1000
K.pic("fi_spark" .. (a * 1000 < s.life * 0.5 and 1 or 2), 3, 3, s.x + s.vx * a, s.y + s.vy * a + 350 * a * a, 8)
end
if ST.phase >= 3 and not ST.done and f > 0.3 then
for k = 1, 3 do local a = ((t / 1400) + k / 3) % 1; K.pic("fi_spark2", 3, 3, px + math.sin(k * 7 + t / 500) * 30, py - 40 - a * 160 * f, 6) end
end
if ST.phase == 1 then
local hx, hy, hw = hand()
fp("fi_flint", hx, hy, hw)
local sx, sy = (ST.striker and ST.striker[1]) or (hx + hw * 0.55), (ST.striker and ST.striker[2]) or (hy - hw * 0.25)
fp("fi_striker", sx, sy, 130, 0.45, 0.85, 0.3)
local x0, y0, x1, y1 = edge()
for k = 0, 7 do
local a = k / 7
local qx, qy = (x0 + 90) - a * 150, (y0 - 70) + a * 160
smudge.circle(fl(qx), fl(qy), 4, true); smudge.circle(fl(qx), fl(qy), 2, true, 1, false)
end
end
if ST.phase >= 3 and not ST.done then
local function pile(k, nm, pw, ph, active, label)
local qx, qy = P(PILES[k][1], PILES[k][2])
local q = FP[nm]
fp(nm, qx, qy, math.min(100, 84 * q[1] / q[2]))
if active then K.ring(qx, qy, 58, 2) end
K.pill(qx, qy + 34, label, "small")
end
pile("twig", "fi_twigs", 0, 0, ST.phase == 3, "TWIGS " .. ST.twigs .. "/3")
pile("stick", "fi_sticks", 0, 0, ST.phase == 4, "STICKS " .. ST.sticks .. "/2")
pile("log", "fi_log" .. tier(), 0, 0, ST.phase == 5 and not ST.log, "LOG")
end
if ST.drag then
if ST.drag.kind == "twig" then fp("fi_twig", ST.drag.x, ST.drag.y, 40, math.pi / 2)
elseif ST.drag.kind == "stick" then fp("fi_stick", ST.drag.x, ST.drag.y, 50, math.pi / 2)
else fp("fi_log" .. tier(), ST.drag.x, ST.drag.y, 78) end
end
local sx = x + 10
for k = 1, 5 do
local s = STEPS[k]
local tw = X.tw(s, "small", "bold") + 12
local on = ST.phase == k and not ST.done
if on then smudge.rounded_rect(sx, y + 8, tw, 22, 8, true) else smudge.rounded_rect(sx, y + 8, tw, 22, 8, true, 1, false) end
smudge.rounded_rect(sx, y + 8, tw, 22, 8, false, 1)
X.ctext(sx + tw // 2, y + 10, s, "small", "bold", on)
if ST.phase > k or ST.done then smudge.line(sx + 4, y + 19, sx + tw - 4, y + 19, 2) end
sx = sx + tw + 4
end
local function bar(by, label, v, marks, dither)
smudge.rounded_rect(x + 10, by, 200, 22, 7, true, 1, false); smudge.rounded_rect(x + 10, by, 200, 22, 7, false, 1)
X.ltext(x + 16, by + 2, label, "small", "bold")
smudge.rect(x + 74, by + 5, 128, 12, false, 1)
if dither then smudge.rect_dither(x + 76, by + 7, fl(124 * math.min(1, v)), 8, true) else smudge.rect(x + 76, by + 7, fl(124 * math.min(1, v)), 8, true) end
for _, m in ipairs(marks or {}) do smudge.rect(fl(x + 76 + 124 * m) - 1, by + 3, 3, 16, true) end
end
if ST.phase == 2 then bar(y + 36, "ember", ST.heat); bar(y + 60, "breath", ST.breath, nil, true)
elseif ST.phase >= 3 and not ST.done then
local m = ST.phase == 3 and { 0.2 } or (ST.phase == 4 and { 0.45 } or { need_log() })
bar(y + 36, "flame", ST.flame, m)
bar(y + 60, "breath", ST.breath, nil, true)
if ST.log then bar(y + 84, "catch", ST.catch) end
end
if K.pop(L, POP, t) then return true end
return true
end
function F.draw(S, y)
local cp = S.camp
SS = S
L = K.layout(y)
if not sel then
sel = 1
for k, ri in ipairs(LIST) do local r = H.REC[SI][ri]; if H.slevel(cp, SI) >= r[2] and H.can_make(cp, r) then sel = k end end
end
local t = ms()
local dt = LAST and math.min(0.05, (t - LAST) / 1000) or 0
LAST = t
if K.hd() then step(S, dt) end
if draw_scene(S) and K.hd() then K.busy() else LAST = nil end
local r = H.REC[SI][LIST[sel]]
local why = K.why_not(cp, SI, r, "Firemaking")
K.picker(LIST, L.ry, sel, r[1] .. "  (Lv " .. r[2] .. ")", (why and why:find("^You") and why) or (H.need_text(cp, r) .. "  Â·  +" .. r[3] * 3 .. " xp by hand"), function(d)
if ST.phase > 1 and not ST.done then X.set_note("Finish this fire first (or NEW FIRE)."); return end
sel = (sel - 1 + d) % #LIST + 1
end, "FI")
local bw = fl((X.W - 48 - 6) / 2)
X.button(24, L.by, bw, 52, "NEW FIRE", function() local s = sel; reset(); sel = s end, { font = "small", id = "FINEW", sub = "start over", nohelp = true })
X.button(24 + bw + 6, L.by, X.W - 48 - bw - 6, 52, "QUICK x5", function() H.make_many(S, SI, LIST[sel], 5) end,
{ font = "small", id = "FIQUICK", sub = "the old way", off = why ~= nil, nohelp = true })
end
F.state = function() return ST end
F.feed = function(S, k) feed(S, k) end
F.edge = function() return edge() end
F.pit = function() return pit() end
return F
end
fishing.lua
32966
return function(X, C, ADV, H)
local F = {}
local W, Hh = X.W, X.H
local fl = math.floor
local SI = 3
local GATHER = H.GATHER[3]
local ITEMS, IDX = H.ITEMS, H.IDX
local PHONE = smudge.smooth == true
local function fx() return PHONE and GFX and GFX.ok and GFX.ok() end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function now() return X.time() end
local function ms() return X.millis() end
local WAIT = { 8, 12, 16, 24, 32, 45, 60, 80 }
local CATCH = { 1, 1, 1, 2, 2, 3, 4, 5 }
local BAIT = {
{ "Worms", 1, 0, 1.00, 0, 0 },
{ "Bread paste", 10, 5, 0.85, 10, 0 },
{ "Feather lure", 25, 0, 0.70, 20, 5, "feather" },
{ "Glowworms", 45, 40, 0.55, 30, 10 },
{ "Kraken bait", 65, 100, 0.45, 40, 15 },
{ "Golden lure", 85, 250, 0.35, 50, 25 },
}
local ROD = { { "Wooden rod", 0 }, { "Oak rod", 1000 }, { "Willow rod", 4000 }, { "Yew rod", 15000 }, { "Magic rod", 50000 }, { "Dragon rod", 150000 } }
local LINES = { { 1, 0 }, { 15, 2500 }, { 40, 20000 } }
local function lv(cp) return H.slevel(cp, SI) end
local function nlines(cp) return 1 end
local function rod(cp) return 0 end
local function refund(S)
local cp = S.camp
local c = 0
for r = 1, math.min(#ROD - 1, cp.x.frod or 0) do c = c + ROD[r + 1][2] end
for k = 1, math.min(2, cp.x.fln or 0) do c = c + LINES[k + 1][2] end
for k = 2, 3 do cp.x["fc" .. k] = 0 end
if (cp.x.frod or 0) ~= 0 or (cp.x.fln or 0) ~= 0 then
cp.x.frod, cp.x.fln = 0, 0
if c > 0 then X.add_coins(c); X.set_note("Fishing now has one rod: " .. c .. " coins back for your rods and lines.") end
X.mark_dirty(); X.save_now()
end
end
local function spot_ok(cp, gi)
local g = GATHER[gi]
if lv(cp) < g[2] then return "Needs Lv " .. g[2] end
if g[9] and ADV.qpoints(cp) < g[9] then return "Needs " .. g[9] .. " quest points" end
if not H.has_gear(cp, g[3]) then return "Needs a " .. H.GEAR[g[3]][1] .. " (" .. H.GEAR[g[3]][2] .. ")" end
if g[8] and not H.have_item(cp, g[8]) then return "Needs a " .. ITEMS[g[8]][1]:lower() .. " (SHOP)" end
return nil
end
local function wait_for(cp, gi, b)
local g = GATHER[gi]
local succ = H.success_pct(cp, SI, g)
local t = WAIT[gi] * BAIT[b][4] * (1 - 0.08 * rod(cp)) * (1.3 - 0.3 * succ / 100)
return math.max(2, fl(t + 0.5))
end
local function uses(gi, b)
local need = {}
if GATHER[gi][3] == 1 then need.feather = (need.feather or 0) + 1 end
if BAIT[b][7] then need[BAIT[b][7]] = (need[BAIT[b][7]] or 0) + 1 end
return need
end
local function spot(cp)
local s = cp.x.fsp or 0
if s < 1 or s > #GATHER then s = 1 end
return s
end
local function bait(cp)
local b = cp.x.fbt or 0
if b < 1 or b > #BAIT or lv(cp) < BAIT[b][2] then b = 1 end
return b
end
local BUB = nil
local bub_next = 0
local ANIM = {}
local after_snd = nil
local REEL = {}
local REEL_MS = 900
local function cast(S, k, quiet, px, py, sx, sy)
local cp = S.camp
if k > nlines(cp) or (cp.x["fc" .. k] or 0) ~= 0 then return false end
local gi, b = spot(cp), bait(cp)
local why = spot_ok(cp, gi)
if why then if not quiet then X.set_note(GATHER[gi][1] .. ": " .. why .. ".") end; return false end
for id, n in pairs(uses(gi, b)) do
local i = IDX[id]
if i and H.count_item(cp, i) < n then
if not quiet then X.set_note("You need " .. n .. " " .. ITEMS[i][1]:lower() .. " for this cast (FISHING shop or Hunter).") end
return false
end
end
local cost = BAIT[b][3]
if cost > 0 then
if S.coins < cost then if not quiet then X.set_note("Not enough coins for " .. BAIT[b][1]:lower() .. " (" .. cost .. " each).") end; return false end
X.add_coins(-cost)
end
for id, n in pairs(uses(gi, b)) do if IDX[id] then H.take_items(cp, IDX[id], n) end end
px = math.max(0.1, math.min(0.9, px or 0.5)); py = math.max(0.15, math.min(0.85, py or 0.6))
cp.x["fc" .. k] = gi * 10 + b
cp.x.fpf = 0
if BUB and ms() < BUB.t1 and math.abs(px - BUB.px) < 0.1 and math.abs(py - BUB.py) < 0.09 then
cp.x.fpf = 1
BUB.hit = true
end
cp.x["fp" .. k] = fl(px * 99) * 100 + fl(py * 99)
cp.x["fe" .. k] = now() + math.max(2, fl(wait_for(cp, gi, b) * (1.1 - 0.25 * py) + 0.5))
local dur = fl(520 + 420 * py)
ANIM[k] = { kind = "cast", t0 = ms(), dur = dur, sx = sx, sy = sy, py = py, perfect = cp.x.fpf == 1 }
snd("flip", 0.45)
after_snd = { t = ms() + dur, k = k }
X.mark_dirty()
return true
end
local function reel(S, k, quiet)
local cp = S.camp
local code = cp.x["fc" .. k] or 0
if code == 0 then return false end
if now() < (cp.x["fe" .. k] or 0) then if not quiet then X.set_note("Nothing has bitten yet: wait for the bobber to dip.") end; return false end
local gi, b = code // 10, code % 10
local g = GATHER[gi]
if not g or not BAIT[b] then cp.x["fc" .. k] = 0; return false end
local fish = g[4]
if H.inv_room(fish) < 1 then X.set_note("Your inventory is full: tap BANK first. The fish stays on the line."); return false end
ADV.on_action(S, SI)
local n = CATCH[gi]
local bonus = ""
if X.rnd(1, 100) <= BAIT[b][6] then n = n * 2; bonus = " (double!)" end
local perfect = (cp.x.fpf or 0) == 1
if perfect then n = n * 2; bonus = bonus .. " (perfect throw!)"; cp.x.fpf = 0 end
if cp.pet > 0 and X.rnd(1, 100) <= 4 + 3 * X.tier_of(cp.pet) then n = n + 1; bonus = bonus .. " (pet)" end
H.stash(cp, fish, n)
ADV.on_gain(S, fish, n)
local xp = H.xp_amt(cp, fl(g[7] * CATCH[gi] * 1.5 * (1 + BAIT[b][5] / 100) * (perfect and 1.5 or 1) + 0.5), SI)
local note = string.format("+%d %s%s  (+%d xp)", n, ITEMS[fish][1], bonus, xp)
note = note .. H.rare_drop(S, SI) .. ADV.G.pet_roll(S, SI)
local lvn = H.give_xp(S, SI, xp)
if lvn ~= "" then note = lvn:gsub("^%s+", "") .. "  " .. note end
if ADV.cluenote then note = ADV.cluenote .. "  " .. note; ADV.cluenote = nil end
if H.inv_used() >= H.INV_MAX then note = note .. "  Your inventory is full!" end
cp.stat[1] = cp.stat[1] + 1
cp.x["fc" .. k] = 0
ANIM[k] = { kind = "reel", t0 = ms(), fish = fish }
snd("fish_splash", 0.7)
if not quiet then X.set_note(note) end
X.mark_dirty()
return true, note
end
local function buy_rod(S)
local cp = S.camp
local r = rod(cp) + 1
if not ROD[r + 1] then return end
local c = ROD[r + 1][2]
if S.coins < c then X.set_note("A " .. ROD[r + 1][1]:lower() .. " costs " .. c .. " coins."); return end
X.add_coins(-c); cp.x.frod = r
snd("buy", 0.7)
X.set_note("You now fish with a " .. ROD[r + 1][1]:lower() .. ": every wait is shorter.")
X.mark_dirty(); X.save_now()
end
local function buy_line(S)
local cp = S.camp
local k = nlines(cp) + 1
local L = LINES[k]
if not L then return end
if lv(cp) < L[1] then X.set_note("Line " .. k .. " needs Fishing level " .. L[1] .. "."); return end
if S.coins < L[2] then X.set_note("Line " .. k .. " costs " .. L[2] .. " coins."); return end
X.add_coins(-L[2]); cp.x.fln = k - 1
snd("buy", 0.7)
X.set_note("You can now fish with " .. k .. " lines at once.")
X.mark_dirty(); X.save_now()
end
local view = "fish"
local function tint_round(cx, cy, r, k, mode)
cx, cy, r = fl(cx), fl(cy), fl(r)
for dy = -r, r do
local hw = fl(math.sqrt(math.max(0, r * r - dy * dy)))
smudge.tint(cx - hw, cy + dy, 2 * hw + 1, 1, k, mode)
end
end
local function tint_rr(x, y, w, h, r, k, mode)
x, y, w, h = fl(x), fl(y), fl(w), fl(h)
r = math.min(r, w // 2, h // 2)
for j = 0, r - 1 do
local d = r - j - 0.5
local ins = r - fl(math.sqrt(math.max(0, r * r - d * d)))
smudge.tint(x + ins, y + j, w - 2 * ins, 1, k, mode)
smudge.tint(x + ins, y + h - 1 - j, w - 2 * ins, 1, k, mode)
end
smudge.tint(x, y + r, w, h - 2 * r, k, mode)
end
local T_WATER, T_PLATE, T_CAP = 12, 11, 13
local SCN = nil
local SW = nil
local WHIP = nil
local SS = nil
local MAN = nil
local WHEEL = nil
FISHT = FISHT or {}
local function rod_geo(x, y, w, h, t)
local rx, ry = x + w * 0.42, y + h - 4
local rl = math.min(170, h * 0.36)
local tx, ty = rx - 30, ry - rl
if SW then
local dx, dy = SW.x - tx, SW.y - ty
local d = math.sqrt(dx * dx + dy * dy)
local m = math.min(28, d * 0.22) / math.max(1, d)
tx, ty = tx + dx * m, ty + dy * m
elseif WHIP and t - WHIP < 900 then
local u = t - WHIP
local o = -math.sin(u / 55) * math.exp(-u / 210) * 22
tx, ty = tx + o * 0.5, ty + o
end
return rx, ry, tx, ty
end
local function draw_rod(rx, ry, tx, ty)
local cx, cy = rx - 6, ry - (ry - ty) * 0.6
local px, py = rx, ry
for s2 = 1, 8 do
local u = s2 / 8
local qx = (1 - u) ^ 2 * rx + 2 * (1 - u) * u * cx + u * u * tx
local qy = (1 - u) ^ 2 * ry + 2 * (1 - u) * u * cy + u * u * ty
local th = ((u < 0.35) and 6 or (u < 0.7 and 4 or 2.5)) / 2
local dx, dy = qx - px, qy - py
local d = math.max(0.01, math.sqrt(dx * dx + dy * dy))
local nx, ny = -dy / d * th, dx / d * th
smudge.fill_quad(fl(px + nx), fl(py + ny), fl(qx + nx), fl(qy + ny), fl(qx - nx), fl(qy - ny), fl(px - nx), fl(py - ny), true, nil, true)
px, py = qx, qy
end
smudge.circle(fl(rx - 3), fl(ry - 26), 9, true)
smudge.circle(fl(rx - 3), fl(ry - 26), 5, true, 1, false)
smudge.line(fl(rx - 3), fl(ry - 26), fl(rx + 7), fl(ry - 30), 2)
end
local function ellipse(cx, cy, rx, ry)
local px, py
for q = 0, 20 do
local a = q / 20 * 2 * math.pi
local qx, qy = cx + math.cos(a) * rx, cy + math.sin(a) * ry
if px then smudge.line(fl(px), fl(py), fl(qx), fl(qy), 1) end
px, py = qx, qy
end
end
local function float_at(cx, cy, sc, cap)
local r = math.max(3, fl(8 * sc + 0.5))
smudge.circle(fl(cx), fl(cy), r, true)
smudge.circle(fl(cx), fl(cy), r - 2, true, 1, false)
if cap then tint_round(cx, cy, r - 2, T_CAP, 2) end
end
local function release(x, y, vx, vy)
local s2 = SW; SW = nil
if not s2 or not SCN then return false end
local w, h = SCN[3], SCN[4]
vx, vy = tonumber(vx) or 0, tonumber(vy) or 0
local dy = s2.y0 - y
local power = math.max(-vy / 2.6, dy / (h * 1.1))
if power < 0.12 then
if dy > 8 then snd("tap", 0.3) end
return true
end
local dirx, diry = vx, vy
if vx * vx + vy * vy < 0.09 then dirx, diry = x - s2.x0, y - s2.y0 end
local side = math.max(-1, math.min(1, dirx / math.max(1, -diry, 0.3)))
if diry >= 0 then side = 0 end
local px = 0.5 + side * 0.45 + (x - (SCN[1] + w / 2)) / w * 0.35
local py = math.min(0.95, 0.1 + power)
WHIP = ms()
if VIB then VIB.play("sf_click", true) end
cast(SS, 1, false, px, py, x, y)
return true
end
function FISHT.touch(ev, x, y, vx, vy)
if not SS or not SCN or type(x) ~= "number" or type(y) ~= "number" then return false end
local cp = SS.camp
if MAN and WHEEL then
local a = math.atan(y - WHEEL[2], x - WHEEL[1])
if ev == "down" then
if x >= SCN[1] and x < SCN[1] + SCN[3] and y >= SCN[2] and y < SCN[2] + SCN[4] then MAN.hold = true; MAN.last = a; busy() end
return false
elseif ev == "move" and MAN.hold then
local d = a - MAN.last
if d > math.pi then d = d - 2 * math.pi elseif d < -math.pi then d = d + 2 * math.pi end
local dx, dy = x - WHEEL[1], y - WHEEL[2]
if dx * dx + dy * dy > 144 then MAN.spin = MAN.spin + math.abs(d); MAN.vis = MAN.vis + d end
MAN.last = a
busy(); return true
elseif ev == "release" then if MAN.hold then MAN.hold = false; return true end
elseif ev == "up" or ev == "tap" then MAN.hold = false
end
return false
end
if ev == "down" then
SW = nil
if (cp.x.fc1 or 0) == 0 and x >= SCN[1] and x < SCN[1] + SCN[3] and y >= SCN[2] and y < SCN[2] + SCN[4] then
SW = { x0 = x, y0 = y, x = x, y = y }
busy()
end
return false
end
if not SW then return false end
if ev == "move" then
SW.x = math.max(SCN[1] + 8, math.min(SCN[1] + SCN[3] - 8, x))
SW.y = math.max(SCN[2] + 8, math.min(SCN[2] + SCN[4] - 8, y))
busy(); return true
elseif ev == "release" then return release(x, y, vx, vy)
elseif ev == "up" or ev == "tap" then SW = nil; return false
end
return false
end
local SHAD = nil
local JUMP = nil
local jump_next = 0
local DFLY = { x = 0.2, y = 0.3, tx = 0.3, ty = 0.4, t = 0 }
local LT = nil
local function shadow(cx, cy, sc, dir, ph)
local rx, ry = 34 * sc, 11 * sc
local tw = math.sin(ph) * 6 * sc
for r = -ry, ry do
local hw = rx * math.sqrt(math.max(0, 1 - (r / ry) ^ 2))
local yy = fl(cy + r)
local x0 = fl(cx - hw); if (x0 + yy) % 2 == 1 then x0 = x0 + 1 end
for q = x0, fl(cx + hw), 2 do smudge.rect(q, yy, 1, 1, true) end
end
local bx = cx - dir * rx * 0.9
for r = -8, 8 do
local yy = fl(cy + r * sc + tw * (1 - math.abs(r) / 8))
local len = (4 + math.abs(r) * 1.2) * sc
local xa, xb = bx, bx - dir * len
if xa > xb then xa, xb = xb, xa end
local x0 = fl(xa); if (x0 + yy) % 2 == 1 then x0 = x0 + 1 end
for q = x0, fl(xb), 2 do smudge.rect(q, yy, 1, 1, true) end
end
end
local function reed(bx, by, hgt, t, k)
local sway = PHONE and math.sin(t / 900 + k * 1.7) * 5 or 0
local tx, ty = bx + sway, by - hgt
smudge.line(fl(bx), fl(by), fl(bx + sway * 0.4), fl(by - hgt * 0.5), 2)
smudge.line(fl(bx + sway * 0.4), fl(by - hgt * 0.5), fl(tx), fl(ty), 2)
smudge.rounded_rect(fl(tx - 3), fl(ty - 4), 7, 16, 3, true)
smudge.line(fl(tx), fl(ty - 4), fl(tx), fl(ty - 9), 1)
return tx, ty
end
local function pad(cx, cy, r, t, k, flower)
local b = PHONE and math.sin(t / 1100 + k) * 1.5 or 0
cy = cy + b
for q = -r * 0.38, r * 0.38 do
local hw = r * math.sqrt(math.max(0, 1 - (q / (r * 0.38)) ^ 2))
smudge.line(fl(cx - hw), fl(cy + q), fl(cx + hw), fl(cy + q), 1, false)
end
ellipse(cx, cy, r, r * 0.38)
smudge.line(fl(cx), fl(cy), fl(cx + r * 0.8), fl(cy - r * 0.18), 1)
if flower then
smudge.circle(fl(cx - r * 0.2), fl(cy - 5), 5, true, 1, false)
smudge.circle(fl(cx - r * 0.2), fl(cy - 5), 5, false, 1)
smudge.circle(fl(cx - r * 0.2), fl(cy - 5), 2, true)
end
end
local function life(S, x, y, w, h, t, gi)
local dt = LT and math.min(0.1, (t - LT) / 1000) or 0; LT = t
local function at(px, py) return x + 30 + (w - 60) * px, y + h - 90 - (h - 190) * py, 1 - 0.4 * py end
if not SHAD then
SHAD = {}
for q = 1, 3 do SHAD[q] = { x = X.rnd(10, 90) / 100, y = X.rnd(15, 90) / 100, dir = (q % 2 == 0) and 1 or -1, sp = X.rnd(4, 9) / 100, ph = q } end
end
for _, f in ipairs(SHAD) do
if PHONE then
f.x = f.x + f.dir * f.sp * dt
f.ph = f.ph + dt * 9
f.y = f.y + math.sin(t / 1700 + f.ph * 0.05) * 0.01 * dt
if f.x < -0.05 then f.dir = 1 elseif f.x > 1.05 then f.dir = -1 end
end
local fx2, fy2, sc = at(f.x, f.y)
shadow(fx2, fy2, sc, f.dir, f.ph)
end
pad(x + 52, y + h * 0.30, 26, t, 1, true)
pad(x + w - 64, y + h * 0.18, 20, t, 2, false)
pad(x + w - 40, y + h * 0.52, 24, t, 3, false)
for q = 0, 3 do reed(x + 8 + q * 9, y + h - 8, 70 + (q % 2) * 26 + q * 6, t, q) end
for q = 0, 2 do reed(x + w - 10 - q * 10, y + h * 0.78 - q * 4, 60 + q * 14, t, q + 4) end
local dx0, dw = fl(x + w * 0.42 - 90), 180
local dy0 = y + h - 36
smudge.rect(dx0, dy0, dw, 36, false)
for q = 1, 2 do smudge.line(dx0, dy0 + q * 12, dx0 + dw, dy0 + q * 12, 1) end
for q = 0, 6 do local o = (q % 3) * 12; smudge.line(dx0 + 12 + q * 26, dy0 + o + 3, dx0 + 12 + q * 26, dy0 + o + 9, 1) end
smudge.rect(dx0, dy0, dw, 36, false, 2)
smudge.tint(dx0, dy0, dw, 36, T_PLATE, 3)
if not PHONE then return end
if not JUMP and t >= jump_next then
JUMP = { x = X.rnd(15, 85) / 100, y = X.rnd(30, 90) / 100, t0 = t, dir = (X.rnd(1, 2) == 1) and 1 or -1, it = GATHER[gi][4] }
end
if JUMP then
local u = (t - JUMP.t0) / 1100
local jx, jy, sc = at(JUMP.x, JUMP.y)
if u >= 1.6 then JUMP = nil; jump_next = t + X.rnd(5000, 12000)
else
if u < 0.3 then ellipse(jx, jy + 4, (8 + 30 * u) * sc, (3 + 9 * u) * sc) end
if u < 1 then
local hx = jx + JUMP.dir * (u - 0.5) * 50 * sc
local hy = jy - math.sin(u * math.pi) * 46 * sc
local ang = JUMP.dir * (u - 0.5) * 2.4
local sz = 13 * sc
local ca, sa = math.cos(ang) * sz, math.sin(ang) * sz
local nm = "art/" .. ITEMS[JUMP.it][3]
smudge.draw_sprite_quad(nm .. ".raw", 24, 24, hx - ca + sa, hy - sa - ca, hx + ca + sa, hy + sa - ca, hx + ca - sa, hy + sa + ca, hx - ca - sa, hy - sa + ca, nm .. "_m.raw")
if not JUMP.s1 then JUMP.s1 = true; snd("fish_splash", 0.15) end
else
local v = u - 1
local ex = jx + JUMP.dir * 25 * sc
ellipse(ex, jy + 4, (8 + 40 * v) * sc, (3 + 12 * v) * sc)
if v > 0.15 then ellipse(ex, jy + 4, (4 + 40 * (v - 0.15)) * sc, (2 + 12 * (v - 0.15)) * sc) end
for d = 0, 4 do
local du = math.min(1, v * 2.2)
if du < 1 then smudge.circle(fl(ex + math.cos(d * 1.3) * 18 * du * sc), fl(jy - math.sin(du * math.pi) * 12 * sc), 2, true) end
end
if not JUMP.s2 then JUMP.s2 = true; snd("fish_splash", 0.2) end
end
end
end
local D = DFLY
if t >= D.t then D.tx, D.ty, D.t = X.rnd(10, 90) / 100, X.rnd(40, 98) / 100, t + X.rnd(1500, 3500) end
D.x = D.x + (D.tx - D.x) * math.min(1, dt * 3); D.y = D.y + (D.ty - D.y) * math.min(1, dt * 3)
local qx, qy = at(D.x, D.y); qy = qy - 40 + math.sin(t / 130) * 2
local fl2 = (t // 40) % 2 == 0
smudge.line(fl(qx - 9), fl(qy), fl(qx + 7), fl(qy), 2)
ellipse(qx - 1, qy - (fl2 and 5 or 3), 6, fl2 and 3 or 2); ellipse(qx + 3, qy - (fl2 and 4 or 3), 5, fl2 and 3 or 2)
if fx() then
for q = 0, 5 do
local ph = (t / 1400 + q * 0.29) % 1
if ph < 0.4 then
local gx = x + 20 + ((q * 131 + fl(t / 1400 + q * 0.29) * 57) % (w - 40))
local gy = y + 20 + ((q * 89 + fl(t / 1400 + q * 0.29) * 113) % (h - 60))
smudge.glow_circle(gx, gy, 8, 255, 250, 220, math.sin(ph / 0.4 * math.pi) * 0.9)
end
end
end
end
local function scene(S, x, y, w, h)
local cp = S.camp
local t = ms()
SS = S
SCN = { x, y, w, h }
busy()
if after_snd and t >= after_snd.t then snd("fish_splash", 0.4); if VIB then VIB.play("sf_tick", true) end; after_snd = nil end
smudge.rect(x, y, w, h, false)
smudge.rect_dither(x, y, w, h, false)
for r = 0, 5 do
local wy = y + 18 + r * (h - 40) / 5
local ws = 0.6 + 0.4 * r / 5
for c = 0, 4 do
local wx = x + ((c * 97 + r * 53 + (PHONE and t / 90 or 0)) % (w - 30)) + 6
smudge.line(fl(wx), fl(wy), fl(wx + 8 * ws), fl(wy - 3 * ws), 1)
smudge.line(fl(wx + 8 * ws), fl(wy - 3 * ws), fl(wx + 16 * ws), fl(wy), 1)
end
end
smudge.rect(x, y, w, h, false, 2)
smudge.tint(x, y, w, h, 8, 2)
life(S, x, y, w, h, t, spot(cp))
local any = false
local k = 1
local rx, ry, tipx, tipy = rod_geo(x, y, w, h, t)
if WHIP and t - WHIP < 900 then busy(); any = true end
local code = cp.x.fc1 or 0
local fp = cp.x.fp1 or 0
local pxf, pyf = (fp // 100) / 99, (fp % 100) / 99
if fp == 0 then pxf, pyf = 0.5, 0.6 end
local bx, by = x + 30 + (w - 60) * pxf, y + h - 90 - (h - 190) * pyf
local bsc = 1 - 0.4 * pyf
local function bubbles(cx, cy, sc, life, seed)
for q = 0, 9 do
local ph = ((t / 900) + q * 0.37 + seed) % 1
local ox = math.sin(q * 2.3 + seed * 5) * 22 * sc + math.sin(t / 300 + q) * 2
local oy = math.cos(q * 1.7) * 8 * sc - ph * 14 * sc
local r = math.max(1, fl((3 + 1.5 * (q % 3)) * sc * (0.6 + ph) * life))
if ph < 0.85 then smudge.circle(fl(cx + ox), fl(cy + oy), r, false, 1)
else smudge.circle(fl(cx + ox), fl(cy + oy), r + 2, false, 1) end
end
end
if code == 0 and PHONE then
if not BUB and t >= bub_next then
BUB = { px = X.rnd(15, 85) / 100, py = X.rnd(20, 85) / 100, t0 = t, t1 = t + X.rnd(5000, 8000) }
end
end
if BUB and (t >= BUB.t1 or BUB.hit) and not (BUB.hit and code ~= 0) then BUB = nil; bub_next = t + X.rnd(4000, 11000) end
if BUB and code == 0 then
local qx, qy = x + 30 + (w - 60) * BUB.px, y + h - 90 - (h - 190) * BUB.py
local sc = 1 - 0.4 * BUB.py
local life = math.min(1, (t - BUB.t0) / 500, (BUB.t1 - t) / 500)
bubbles(qx, qy, sc, life, 0)
ellipse(qx, qy + 3, 24 * sc * life, 8 * sc * life)
end
if code == 0 then
local A = ANIM[k]
if A and A.kind == "reel" and t - A.t0 < 900 then
local u = (t - A.t0) / 900
local fxp, fyp = tipx + (rx - tipx) * u, tipy - math.sin(u * math.pi) * 70 + (ry - tipy) * u
local nm = "art/" .. ITEMS[A.fish][3]
local sz = 22 + 10 * math.sin(u * math.pi)
local ang = (u - 0.5) * 2.2
local ca, sa = math.cos(ang) * sz, math.sin(ang) * sz
smudge.draw_sprite_quad(nm .. ".raw", 24, 24,
fxp - ca + sa, fyp - sa - ca, fxp + ca + sa, fyp + sa - ca, fxp + ca - sa, fyp + sa + ca, fxp - ca - sa, fyp - sa + ca, nm .. "_m.raw")
if fx() then smudge.glow_circle(tipx, tipy, 30 * (1 - u) + 6, 255, 255, 255, 1.4 * (1 - u)) end
busy(); any = true
end
local fx2, fy2
if SW then fx2, fy2 = SW.x, SW.y
else
fx2 = tipx + (PHONE and math.sin(t / 600) * 3 or 0); fy2 = tipy + 34
end
smudge.line(fl(tipx), fl(tipy), fl(fx2), fl(fy2), 1)
draw_rod(rx, ry, tipx, tipy)
float_at(fx2, fy2, SW and 1.15 or 1, true)
if not SW and not (A and A.kind == "reel" and t - A.t0 < 900) then
X.ctext(fl(x + w / 2 - 60), fl(y + h * 0.42) - 22, PHONE and "grab the float" or "tap to", "small", "bold")
X.ctext(fl(x + w / 2 - 60), fl(y + h * 0.42) - 4, PHONE and "and THROW it" or "CAST", "ui10", "bold")
end
if SW then any = true end
else
local left = (cp.x.fe1 or 0) - now()
local on = left <= 0
local A = ANIM[k]
local cbx, cby, csc = bx, by, bsc
local flying = false
if A and A.kind == "cast" and t - A.t0 < A.dur then
flying = true
local u = (t - A.t0) / A.dur
local sx, sy = A.sx or tipx, A.sy or tipy
local gx, gy = sx + (bx - sx) * u, sy + (by - sy) * u
local lift = math.sin(u * math.pi) * (50 + 150 * (A.py or 0.5))
cbx, cby = gx, gy - lift
csc = (1.15 + (bsc - 1.15) * u) * (1 + 0.3 * math.sin(u * math.pi))
local sw = math.max(2, fl(8 * csc * (1 - 0.5 * math.sin(u * math.pi))))
smudge.line(fl(gx - sw), fl(gy + 6), fl(gx + sw), fl(gy + 6), 2)
tint_round(gx, gy + 6, sw, T_WATER, 1)
busy(); any = true
end
local bob = (PHONE and not on and not flying) and math.sin(t / 420 + k) * 2 or 0
local dip = 0
if on and not flying then dip = PHONE and (math.max(0, math.sin(t / 160 + k)) * 7) or 5 end
cby = cby + bob + dip
local manual = PHONE and on and not flying and not REEL[k]
if manual and not MAN then
local gi = code // 10
MAN = { p = 0, need = (5 + (gi - 1) * 0.8) * 2 * math.pi, last = 0, hold = false, n = 0, t = t, vis = 0,
spin = 0, rs = 0, ten = 0, pull = false, next = t + 900, slip = 0, gi = gi, side = 0, dir = 1 }
elseif not manual then MAN = nil; WHEEL = nil end
if MAN then
local dt = math.min(0.1, (t - MAN.t) / 1000); MAN.t = t
local spin = MAN.spin; MAN.spin = 0
MAN.rs = MAN.rs + (spin / math.max(0.008, dt) - MAN.rs) * math.min(1, dt * 8)
local gain = math.min(spin, dt * 7)
if t >= MAN.next then
MAN.pull = not MAN.pull
if MAN.pull then
MAN.next = t + X.rnd(1000, 1700 + MAN.gi * 110); MAN.p0 = t
MAN.dir = (X.rnd(1, 2) == 1) and -1 or 1
snd("fish_splash", 0.35); if VIB then VIB.play("sf_bolt", true) end
else MAN.next = t + X.rnd(1100, 2400) end
end
if MAN.pull then
if t - MAN.p0 > 250 and MAN.rs > 1.5 then
MAN.ten = MAN.ten + dt * (0.15 + MAN.rs * 0.035)
if X.rnd(1, 3) == 1 and VIB then VIB.play("sf_tick", true) end
elseif MAN.rs <= 1.5 then
MAN.ten = math.max(0, MAN.ten - dt * 0.7)
local sl = dt * 2.6
MAN.p = math.max(0, MAN.p - sl); MAN.vis = MAN.vis - sl; MAN.slip = MAN.slip + sl
if MAN.slip > 0.3 then MAN.slip = 0; snd("safe_tick", 0.25); if VIB then VIB.play("sf_tick", true) end end
end
MAN.p = MAN.p + gain * 0.3
else
MAN.p = MAN.p + gain * 0.8
MAN.ten = MAN.ten + (math.min(0.5, MAN.rs / 25) - MAN.ten) * math.min(1, dt * 2.5)
end
if MAN.ten >= 1 then
MAN = nil; WHEEL = nil; WHIP = t
cp.x.fc1 = 0
snd("fish_splash", 0.6); if VIB then VIB.play("sf_wrong", true) end
X.set_note("Snap! The line broke and the fish swam off. Throw again, and let it run when it pulls.")
X.mark_dirty()
return true
end
local u = math.min(1, MAN.p / MAN.need)
local want = fl(MAN.p / (math.pi / 6))
if want > MAN.n then
MAN.n = want
snd("safe_tick", (want % 3 == 0) and 0.6 or 0.35); if VIB then VIB.play("sf_tick", true) end
elseif want < MAN.n then MAN.n = want end
local e = u ^ 1.3
local thr = MAN.pull and 1 or 0.3
MAN.side = MAN.side + ((MAN.pull and MAN.dir * 70 or 0) - MAN.side) * math.min(1, dt * 1.6)
cbx = cbx + MAN.side * (1 - u)
cbx = cbx + (tipx - cbx) * e + math.sin(t / 35) * 4 * thr * (1 - u)
cby = cby + (tipy - cby) * e + math.sin(t / 45) * 3 * (1 - u) + (MAN.pull and 3 or 0)
csc = csc + (1 - csc) * e
any = true
if u >= 1 then
MAN = nil; WHEEL = nil
reel(S, k)
return true
end
end
local R = REEL[k]
if R then
local u = math.max(0, math.min(1, (t - R.t0) / REEL_MS))
local e = u * u
cbx, cby = cbx + (tipx - cbx) * e, cby + (tipy - cby) * e + math.sin(t / 40) * 2 * (1 - u)
csc = csc + (1 - csc) * e
local want = fl(16 * u ^ 0.75)
while R.n < want do
R.n = R.n + 1
snd("safe_tick", 0.55); if VIB then VIB.play("sf_tick", true) end
end
busy(); any = true
end
local px, py = tipx, tipy
local sag = flying and 2 or ((R or MAN) and (MAN and 10 * (1 - MAN.ten) or 4) or 16)
for s2 = 1, 12 do
local u = s2 / 12
local qx = tipx + (cbx - tipx) * u
local qy = tipy + (cby - tipy) * u + math.sin(u * math.pi) * sag
smudge.line(fl(px), fl(py), fl(qx), fl(qy), 1)
px, py = qx, qy
end
if not flying and not R then
for q = 0, 1 do
local u = ((t + q * 1300) % 2600) / 2600
if PHONE or q == 0 then ellipse(cbx, cby + 5 * csc, (10 + 34 * u) * csc, (4 + 11 * u) * csc) end
end
if MAN and MAN.pull then
local u = (t % 500) / 500
ellipse(cbx, cby + 5 * csc, (8 + 20 * u) * csc, (3 + 7 * u) * csc)
end
end
draw_rod(rx, ry, tipx, tipy)
float_at(cbx, cby, csc, true)
if not flying and A and A.kind == "cast" and t - A.t0 < A.dur + 700 and not R then
local u = (t - A.t0 - A.dur) / 700
for d = 0, 5 do
local ang = d / 6 * math.pi * 2 + 0.4
local du = math.min(1, u * 1.6)
local ddx = math.cos(ang) * 20 * du * bsc
local ddy = -math.sin(du * math.pi) * 16 * bsc + math.sin(ang) * 6 * du
if du < 1 then smudge.circle(fl(cbx + ddx), fl(cby + ddy), 2, true) end
end
ellipse(cbx, cby + 4, (10 + 30 * u) * bsc, (4 + 10 * u) * bsc)
if u > 0.3 then ellipse(cbx, cby + 4, (6 + 30 * (u - 0.3)) * bsc, (3 + 10 * (u - 0.3)) * bsc) end
busy(); any = true
end
if MAN then
local wr = fl(math.min(72, h * 0.16))
local wcx, wcy = x + w - wr - 14, y + h - wr - 14
WHEEL = { wcx, wcy, wr }
smudge.circle(fl(wcx), fl(wcy), wr, true, 1, false)
local pic = GFX and GFX.ok() and smudge.hires_quad
local ha = MAN.vis
local hx, hy = wcx + math.cos(ha) * (pic and (wr + 2) * 0.86 or (wr - 12)), wcy + math.sin(ha) * (pic and (wr + 2) * 0.86 or (wr - 12))
if pic then
local R = wr + 2
local ca, sa = math.cos(MAN.vis) * R, math.sin(MAN.vis) * R
smudge.hires_quad("hd/fish_reel_c.png", wcx - ca + sa, wcy - sa - ca, wcx + ca + sa, wcy + sa - ca,
wcx + ca - sa, wcy + sa + ca, wcx - ca - sa, wcy - sa + ca)
end
if not pic then
tint_round(wcx, wcy, wr, T_PLATE, 2)
smudge.circle(fl(wcx), fl(wcy), wr, false, 3)
for q = 0, 5 do
local ang = MAN.vis + q * math.pi / 3
smudge.line(fl(wcx), fl(wcy), fl(wcx + math.cos(ang) * (wr - 6)), fl(wcy + math.sin(ang) * (wr - 6)), 2)
end
smudge.circle(fl(hx), fl(hy), 13, true)
tint_round(hx, hy, 9, T_CAP, 2)
smudge.circle(fl(wcx), fl(wcy), 9, true)
end
local u = math.min(1, MAN.p / MAN.need)
local steps = fl(48 * u)
for q = 0, steps - 1 do
local a1, a2 = -math.pi / 2 + q / 48 * 2 * math.pi, -math.pi / 2 + (q + 1) / 48 * 2 * math.pi
smudge.line(fl(wcx + math.cos(a1) * (wr + 7)), fl(wcy + math.sin(a1) * (wr + 7)), fl(wcx + math.cos(a2) * (wr + 7)), fl(wcy + math.sin(a2) * (wr + 7)), 4)
end
if fx() and MAN.hold then smudge.glow_circle(hx, hy, 16, 255, 220, 120, 0.8) end
local mw, mh = 20, 2 * wr
local mx, my = wcx - wr - 14 - mw, wcy - wr
X.ctext(fl(x + w - wr - 50), fl(my - 34), MAN.pull and "IT PULLS! let it run" or (MAN.hold and "reel it in!" or "SPIN the reel"), "ui10", "bold")
smudge.rounded_rect(fl(mx), fl(my), mw, mh, 7, false)
smudge.rounded_rect(fl(mx), fl(my), mw, mh, 7, false, 2)
local fh = fl((mh - 6) * math.min(1, MAN.ten))
if fh > 2 then
smudge.rect(fl(mx + 3), fl(my + mh - 3 - fh), mw - 6, fh, true)
tint_rr(mx + 3, my + mh - 3 - fh, mw - 6, fh, 4, MAN.ten > 0.7 and 6 or T_CAP, 1)
end
local fw, mx2 = 0, mx
if MAN.ten > 0.7 and fx() then smudge.glow_circle(mx + mw / 2, my + mh - 3 - fh, 14, 255, 90, 60, 0.9) end
end
if (cp.x.fpf or 0) == 1 and not flying and not R then
bubbles(cbx, cby + 2, csc, 1, 0.5)
if A and A.kind == "cast" and A.perfect and t - A.t0 < A.dur + 1400 then
local u = (t - A.t0 - A.dur) / 1400
if not A.said then A.said = true; snd("slot_gwin", 0.5); if VIB then VIB.play("sf_bolt", true) end end
X.ctext(fl(cbx), fl(cby - 50 - 20 * u), "PERFECT THROW!", "ui10", "bold")
X.ctext(fl(cbx), fl(cby - 30 - 20 * u), "double catch", "small")
if fx() then smudge.glow_circle(cbx, cby, 40 * (1 - u) + 10, 255, 230, 140, 1.4 * (1 - u)) end
end
end
if on and not R and not flying then
any = true
local pw = 56
local plx, ply = fl(bx - pw / 2), fl(by - 46)
smudge.rounded_rect(plx, ply, pw, 26, 8, true)
X.ctext(fl(bx), ply + 13 - X.lh("small") // 2, "BITE!", "small", "bold", true)
tint_rr(plx, ply, pw, 26, 8, T_PLATE, 3)
if PHONE and not MAN then local u = (t % 540) / 540; ellipse(cbx, cby + 5, 12 + 18 * u, 4 + 6 * u) end
if fx() then smudge.glow_circle(cbx, cby, 22, 255, 220, 120, 1.0 + 0.5 * math.sin(t / 120)) end
if not PHONE then X.ctext(fl(x + w / 2), fl(y + 10), "tap to REEL", "small", "bold") end
elseif not on and not flying then
X.ctext(fl(bx), fl(by + 16), H.mmss(left), "ui10", "bold")
local gi = code // 10
X.ctext(fl(bx), fl(by + 38), X.fit(GATHER[gi] and GATHER[gi][1] or "", 200, "small"), "small")
end
if R and t - R.t0 >= REEL_MS then
REEL[k] = nil
local ok, note = reel(S, k, R.quiet)
if R.all and ok then F.lastnote = note end
end
busy()
end
X.reg("FLINE1", fl(x), y, fl(w), h, function()
if (cp.x.fc1 or 0) == 0 then
if PHONE then X.set_note("Put your finger on the float, swing up and let go: the faster, the further out.") else cast(S, 1) end
elseif now() >= (cp.x.fe1 or 0) then
if PHONE then X.set_note("Spin the reel with your finger to wind the fish in."); return end
if not REEL[1] then REEL[1] = { t0 = ms(), n = 0 }; snd("slot_hold", 0.35) end
else X.set_note("Nothing has bitten yet: wait for the float to dip.") end
end, false)
return any
end
function F.draw(S, y)
local cp = S.camp
refund(S)
local x0, w0 = 24, W - 48
local gi, b = spot(cp), bait(cp)
local function picker(yy, label, name, sub, off, prev, nxt, id)
X.button(x0, yy, 48, 52, "<", prev, { font = "ui12", id = id .. "P" })
X.button(x0 + w0 - 48, yy, 48, 52, ">", nxt, { font = "ui12", id = id .. "N" })
smudge.rounded_rect(x0 + 54, yy, w0 - 108, 52, 10, false, 1)
X.ltext(x0 + 64, yy + 4, label, "small")
X.ltext(x0 + 64, yy + 22, X.fit(name, w0 - 128, "ui10"), "ui10", "bold", off)
if sub then X.rtext(x0 + w0 - 60, yy + 6, X.fit(sub, 170, "small"), "small") end
end
local why = spot_ok(cp, gi)
if view == "gear" then
local yy = y
picker(yy, "SPOT", GATHER[gi][1] .. "  (" .. ITEMS[GATHER[gi][4]][1] .. ")", why or (wait_for(cp, gi, b) .. "s a bite" .. (GATHER[gi][3] == 1 and ", 1 feather" or "")), false,
function() cp.x.fsp = (gi - 2) % #GATHER + 1; X.mark_dirty() end, function() cp.x.fsp = gi % #GATHER + 1; X.mark_dirty() end, "FSPOT")
yy = yy + 64
X.ltext(x0, yy, "Bait (better with your Fishing level)", "ui10", "bold")
yy = yy + 26
local cb = bait(cp)
for i, b in ipairs(BAIT) do
local lock = lv(cp) < b[2]
local sub = lock and ("Needs Fishing " .. b[2])
or string.format("%s  waits -%d%%  +%d%% xp%s", b[7] and ("1 " .. ITEMS[IDX[b[7]]][1]:lower() .. " a cast") or (b[3] > 0 and (b[3] .. "c a cast") or "free"), fl((1 - b[4]) * 100 + 0.5), b[5],
b[6] > 0 and ("  " .. b[6] .. "% double") or "")
X.button(x0, yy, w0, 48, (i == cb and "> " or "") .. b[1], function() cp.x.fbt = i; X.mark_dirty() end,
{ font = "small", id = "FBAIT" .. i, off = lock, sub = sub })
yy = yy + 52
end
local g1, g2 = H.has_gear(cp, 1), H.has_gear(cp, 2)
if IDX.feather then X.ltext(x0, yy + 26, "Feathers: " .. H.count_item(cp, IDX.feather) .. "  (fly fishing and the Feather lure use one a cast)", "small") end
X.ltext(x0, yy + 4, X.fit(string.format("Fly rod: %s   Harpoon: %s", g1 and "yes" or ("make: " .. H.GEAR[1][2]), g2 and "yes" or ("make: " .. H.GEAR[2][2])), w0, "small"), "small")
X.button(x0, Hh - 96 - 56, w0, 48, "BACK TO THE WATER", function() view = "fish" end, { font = "ui10", id = "FBACK" })
X.draw_note(Hh - 96 - 84)
return
end
local by = Hh - 96 - (PHONE and 60 or 118)
local sy = y
scene(S, x0, sy, w0, by - 8 - sy)
local ready, idle = 0, 0
for k = 1, nlines(cp) do
local c = cp.x["fc" .. k] or 0
if c == 0 then idle = idle + 1 elseif now() >= (cp.x["fe" .. k] or 0) then ready = ready + 1 end
end
local bw = (w0 - 12) // 3
local sub = X.fit(GATHER[gi][1] .. ", " .. BAIT[b][1]:lower(), 2 * bw - 10, "small")
if PHONE then
X.button(x0, by, 2 * bw + 6, 52, "SPOT & BAIT", function() view = "gear" end, { font = "ui10", id = "FGEAR", sub = sub })
else
X.button(x0, by, bw, 52, "CAST", function() cast(S, 1) end, { font = "ui10", id = "FCASTALL", off = idle == 0 or why ~= nil })
X.button(x0 + bw + 6, by, bw, 52, "REEL IN", function()
if (cp.x.fc1 or 0) ~= 0 and now() >= (cp.x.fe1 or 0) and not REEL[1] then REEL[1] = { t0 = ms(), n = 0 }; snd("slot_hold", 0.35) end
end, { font = "ui10", id = "FREELALL", off = ready == 0, dot = ready > 0 and ready or nil })
X.button(x0, by + 58, w0, 52, "SPOT & BAIT", function() view = "gear" end, { font = "ui10", id = "FGEAR", sub = sub })
end
X.button(x0 + 2 * (bw + 6), by, w0 - 2 * (bw + 6), 52, "BANK " .. H.inv_used() .. "/" .. H.INV_MAX, function() H.bank_loot(S) end,
{ font = "ui10", id = "GBANK", nohelp = true, dot = (H.inv_used() >= H.INV_MAX) and "!" or nil })
X.draw_note(sy + 6)
end
function F.ready(cp)
local n = 0
for k = 1, nlines(cp) do if (cp.x["fc" .. k] or 0) ~= 0 and now() >= (cp.x["fe" .. k] or 0) then n = n + 1 end end
return n
end
F.cast, F.reel, F.buy_rod, F.buy_line = cast, reel, buy_rod, buy_line
F.bub = function() return BUB end
F.BAIT, F.ROD = BAIT, ROD
return F
end
friends.lua
62577
return function(X)
local F = {}
local W, H = X.W, X.H
local fl = math.floor
local AL = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
local AIX = {}
for k = 1, #AL do AIX[AL:sub(k, k)] = k - 1 end
local GIFT, DUEL = 1, 2
local function put(bits, v, n) for k = n - 1, 0, -1 do bits[#bits + 1] = (v >> k) & 1 end end
local function take(bits, pos, n)
local v = 0
for k = 0, n - 1 do v = v * 2 + (bits[pos + k] or 0) end
return v, pos + n
end
local function check(bits, n)
local h = 4099
for k = 1, n do h = (h * 33 + bits[k] * 7 + k) % 65521 end
return h
end
local function to_code(bits)
local nb = #bits
put(bits, check(bits, nb), 16)
while #bits % 5 ~= 0 do bits[#bits + 1] = 0 end
local s = ""
for k = 1, #bits, 5 do
local v = take(bits, k, 5)
if k > 1 and (k - 1) % 25 == 0 then s = s .. "-" end
s = s .. AL:sub(v + 1, v + 1)
end
return s
end
local function from_code(str, nbits)
str = tostring(str or ""):upper():gsub("[^%w]", "")
local bits = {}
for k = 1, #str do
local v = AIX[str:sub(k, k)]
if not v then return nil end
put(bits, v, 5)
end
if #bits < nbits + 16 or #bits >= nbits + 16 + 5 then return nil end
for k = nbits + 17, #bits do if bits[k] ~= 0 then return nil end end
local want = take(bits, nbits + 1, 16)
if check(bits, nbits) ~= want then return nil end
return bits
end
F.clean = function(s) return tostring(s or ""):upper():gsub("[^%w]", "") end
local GIFT_BITS = 21 + 3 + 2 + 10 + 21
local DUEL_BITS = 3 + 3 * (7 + 9 + 11)
local MAXAMT = 2097151
local function S() return X.S() end
local function list_load(key) local t = {} for v in (smudge.load(key, "") or ""):gmatch("[^;]+") do t[#t + 1] = v end return t end
local function list_save(key, t, max) while #t > max do table.remove(t, 1) end smudge.save(key, table.concat(t, ";")) end
local function iron(what) return X.iron_block and X.iron_block(what) end
local made = nil
local function make_gift(what, id, n, desc)
local bits = {}
put(bits, X.rnd(0, MAXAMT), 21); put(bits, GIFT, 3); put(bits, what, 2); put(bits, id, 10); put(bits, n, 21)
local code = to_code(bits)
local sent = list_load("giftsent")
sent[#sent + 1] = code .. "|" .. desc
list_save("giftsent", sent, 6)
made = { code, desc }
X.save_now()
X.go("friends")
X.set_note("Gift code made: " .. desc .. ". Send the code to your friend.")
return code
end
F.gift_coins = function(n)
local s = S()
if iron("give gifts") then return end
n = math.max(1, math.min(MAXAMT, fl(n)))
if s.coins < n then X.set_note("You don't have " .. X.cnum(n) .. " coins."); return end
X.add_coins(-n)
return make_gift(0, 0, n, X.cnum(n) .. " coins")
end
F.gift_item = function(i, n)
local cp = S().camp
if iron("give gifts") then return end
n = math.min(n, cp.inv[i])
if n < 1 then X.set_note("Nothing of that in the bank."); return end
cp.inv[i] = cp.inv[i] - n
return make_gift(1, i, n, n .. " x " .. X.item_name(i))
end
F.gift_card = function(c)
local s = S()
if iron("give gifts") then return end
if s.spare[c] < 1 then X.set_note("You need a spare copy to give away."); return end
s.spare[c] = s.spare[c] - 1
return make_gift(2, c, 1, "a " .. X.cname(c) .. " card")
end
local cconf = nil
F.card_asking = function(c) return cconf and cconf[1] == c and X.time() - cconf[2] <= 10 end
F.gift_card_tap = function(c)
if not F.card_asking(c) then
cconf = { c, X.time() }
X.set_note("Tap GIFT again: one spare " .. X.cname(c) .. " leaves your album as a gift code.")
return
end
cconf = nil
F.gift_card(c)
end
local function redeem(bits, code)
local s = S()
local p = 25
local what, id, n
what, p = take(bits, p, 2); id, p = take(bits, p, 10); n, p = take(bits, p, 21)
local used = list_load("giftsused")
for _, u in ipairs(used) do if u == code then X.set_note("You already used this gift code."); return false end end
if iron("take gifts") then return false end
local got
if what == 0 then
X.add_coins(n); got = X.cnum(n) .. " coins"
elseif what == 1 then
if id < 1 or id > X.nitems() then X.set_note("This gift is from a newer game version. Update first."); return false end
local cp = s.camp
if X.bank_cap(cp) - cp.inv[id] < n then
X.set_note("Your bank can't hold " .. n .. " more " .. X.item_name(id) .. ". Upgrade it in the BANK first.")
return false
end
cp.inv[id] = cp.inv[id] + n; got = n .. " x " .. X.item_name(id)
elseif what == 2 then
if id < 1 or id > X.ncards then X.set_note("This gift is from a newer game version. Update first."); return false end
X.give_card(id); got = "a " .. X.cname(id) .. " card"
else
X.set_note("That code doesn't work."); return false
end
used[#used + 1] = code
list_save("giftsused", used, 300)
X.save_now()
X.go("friends")
X.set_note("Gift received: " .. got .. "!")
return true
end
local duel = nil
F.my_duel_code = function()
local s = S()
local bits = {}
put(bits, DUEL, 3)
for k = 1, 3 do
local c = s.deck[k]
if not c or c == 0 or s.lvl[c] < 1 then return nil end
local a, h = X.card_stats(c)
put(bits, c, 7); put(bits, fl(math.max(1, math.min(511, a))), 9); put(bits, fl(math.max(1, math.min(2047, h))), 11)
end
return to_code(bits)
end
local function duel_fight()
local d = duel.cards[duel.round]
X.fight({ ec = d[1], ea = d[2], eh = d[3], name = "Friend's " .. X.cname(d[1]), duel = duel.round })
end
local function start_duel(bits, code)
local p = 4
local cards = {}
for k = 1, 3 do
local c, a, h
c, p = take(bits, p, 7); a, p = take(bits, p, 9); h, p = take(bits, p, 11)
if c < 1 or c > X.ncards then X.set_note("This duel code is from a newer game version. Update first."); return false end
cards[k] = { c, math.max(1, a), math.max(1, h) }
end
duel = { cards = cards, round = 1, res = {}, code = code }
duel_fight()
return true
end
F.duel_title = function() return duel and ("Duel - round " .. duel.round .. " of 3") or "Duel" end
F.duel_end = function(win) if duel then duel.res[duel.round] = win end end
F.duel_next = function()
if not duel then X.go("friends"); return end
if duel.round < 3 then duel.round = duel.round + 1; duel_fight(); return end
local w = 0
for k = 1, 3 do if duel.res[k] then w = w + 1 end end
duel.wins = w
if w >= 2 then
local done = list_load("duelswon")
local first = true
for _, u in ipairs(done) do if u == duel.code then first = false end end
if first then
done[#done + 1] = duel.code; list_save("duelswon", done, 100)
X.add_coins(100); S().camp.tickets = S().camp.tickets + 1
duel.prize = "+100 coins and a pack ticket (first win against this code)"
end
X.save_now()
end
X.go("duel")
end
F.duel_quit = function() duel = nil; X.go("friends") end
local typed = ""
F.open_entry = function() typed = ""; X.go("codeentry") end
local function enter()
local code = F.clean(typed)
local gb = from_code(code, GIFT_BITS)
if gb and take(gb, 22, 3) == GIFT then
redeem(gb, code)
return
end
local db = from_code(code, DUEL_BITS)
if db and take(db, 1, 3) == DUEL then start_duel(db, code); return end
X.set_note("That code doesn't work. Check every letter (no 0, O, 1 or I in codes).")
end
F.type = function(s) typed = s end
F.enter = enter
function F.draw_entry()
X.top_bar("Enter a code", "")
local y = X.TOP + 8
X.ctext(W / 2, y, "A gift code or a duel code from a friend", "small")
local c = F.clean(typed)
local shown = c:gsub("(%w%w%w%w%w)", "%1-"):gsub("%-$", "")
smudge.rounded_rect(24, y + 30, W - 48, 64, 10, false, 3)
X.ctext(W / 2, y + 30 + (64 - X.lh("ui12")) // 2, shown ~= "" and shown or "_", "ui12", "bold")
X.ctext(W / 2, y + 102, #c .. " letters  (gift 15, duel 20)", "small")
X.keyboard({ rows = { "23456789", "QWERTYUP", "ASDFGHJKL", "ZXCVBNM" }, id = "K",
key = function(ch) if #F.clean(typed) < 24 then typed = typed .. ch end end,
actions = { { "DELETE", function() typed = F.clean(typed):sub(1, -2) end, typed == "", "KDEL" },
{ "CLEAR", function() typed = "" end, typed == "", "KCLR" },
{ "OK", enter, #c < 15, "KOK" } } })
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("friends") end, { font = "ui10" })
end
local PER = 30
local function read_total() return smudge.read_minutes and tonumber(smudge.read_minutes()) or nil end
F.bookworm_on = function() return read_total() ~= nil end
F.bookworm_claim = function()
local t = read_total()
if not t then return nil end
local s = S()
local done = tonumber(smudge.load("bookworm", "") or "")
if not done or done > t then smudge.save("bookworm", tostring(t)); return nil end
local n0, n1 = done // PER, t // PER
if n1 <= n0 then return nil end
local tk, rt = 0, 0
for k = n0 + 1, n1 do if k % 4 == 0 then rt = rt + 1 else tk = tk + 1 end end
s.camp.tickets = s.camp.tickets + tk; s.camp.rtickets = s.camp.rtickets + rt
smudge.save("bookworm", tostring(t))
X.save_now()
local parts = {}
if tk > 0 then parts[#parts + 1] = tk .. " pack ticket" .. (tk > 1 and "s" or "") end
if rt > 0 then parts[#parts + 1] = rt .. " RARE ticket" .. (rt > 1 and "s" or "") end
return string.format("Bookworm: you read %d min - %s!", (n1 - n0) * PER, table.concat(parts, " and "))
end
F.bookworm_line = function()
local t = read_total()
if not t then return nil end
local done = tonumber(smudge.load("bookworm", "") or "") or t
local left = PER - (t - (done // PER) * PER)
if left <= 0 then left = PER end
return string.format("Bookworm: %d min of reading to the next pack ticket (every 4th is RARE)", left)
end
local amounts = { 100, 500, 1000, 5000, 10000, 50000, 100000, 500000, 1000000 }
local ai = 3
local show_duel = false
function F.draw_friends()
local s = S()
X.top_bar("Friends", "")
local y = X.TOP + 6
X.ltext(24, y, "Gift codes", "ui12", "bold")
X.wrapped(24, y + 30, "Give coins, an item (BANK: tap it, GIFT) or a spare card (ALBUM: GIFT). Your friend types the code in. Each code works once.", W - 48, "small", 3)
local gy = y + 98
local sw = 56
X.button(24, gy, sw, 56, "-", function() if ai > 1 then ai = ai - 1 end end, { font = "ui12", off = ai == 1, id = "AMTDOWN" })
X.button(24 + sw + 6, gy, 150, 56, X.cnum(amounts[ai]), function() end, { font = "ui10", sub = "coins", id = "AMT" })
X.button(24 + sw + 162, gy, sw, 56, "+", function() if ai < #amounts then ai = ai + 1 end end, { font = "ui12", off = ai == #amounts, id = "AMTUP" })
X.button(24 + 2 * sw + 168, gy, W - 48 - 2 * sw - 168, 56, "GIFT COINS", function() F.gift_coins(amounts[ai]) end,
{ font = "small", off = s.coins < amounts[ai], id = "GIFTCOINS" })
local cy = gy + 66
local sent = list_load("giftsent")
if made then
smudge.rounded_rect(24, cy, W - 48, 76, 10, false, 3)
X.ctext(W / 2, cy + 6, made[1], "ui12", "bold")
X.ctext(W / 2, cy + 44, X.fit("Your gift: " .. made[2], W - 64, "small", "regular"), "small")
elseif #sent > 0 then
X.ltext(24, cy, "Codes you made (newest last)", "small", "bold")
for k = math.max(1, #sent - 1), #sent do
local code, desc = sent[k]:match("^([^|]*)|(.*)$")
X.ltext(24, cy + 24 + (k - math.max(1, #sent - 1)) * 24, X.fit((code or "") .. "  " .. (desc or ""), W - 48, "small", "regular"), "small")
end
else
X.ctext(W / 2, cy + 24, "No gift codes made yet.", "small")
end
local dy = cy + 92
smudge.line(24, dy - 8, W - 24, dy - 8, 1)
X.ltext(24, dy, "Duel codes", "ui12", "bold")
X.wrapped(24, dy + 30, "Your deck as a code: your friend fights your 3 cards (best of 3).", W - 48, "small", 2)
local hw = (W - 48 - 12) // 2
local my = F.my_duel_code()
X.button(24, dy + 76, hw, 60, "MY DUEL CODE", function()
if not my then X.set_note("Put 3 cards in your DECK first."); return end
show_duel = not show_duel
end, { font = "small", sub = "your deck", active = show_duel, id = "MYDUEL" })
X.button(36 + hw, dy + 76, hw, 60, "ENTER A CODE", F.open_entry, { font = "small", sub = "gift or duel", id = "ENTERCODE" })
if show_duel and my then
smudge.rounded_rect(24, dy + 146, W - 48, 56, 10, false, 3)
X.ctext(W / 2, dy + 146 + (56 - X.lh("ui10")) // 2, my, "ui10", "bold")
end
local bl = F.bookworm_line()
if bl then X.wrapped(24, H - 160, bl, W - 48, "small", 2) end
X.button(24, H - 96, W - 48, 64, "BACK", function() made = nil; show_duel = false; X.go("title") end, { font = "ui10" })
end
function F.draw_duel()
X.top_bar("Duel result", "")
local y = X.TOP + 10
if not duel then X.go("friends"); return end
local w = duel.wins or 0
X.ctext(W / 2, y, w >= 2 and "YOU WON THE DUEL!" or "YOU LOST THE DUEL", "bitter14", "bold")
X.ctext(W / 2, y + 50, string.format("%d - %d", w, 3 - w), "bitter14", "bold")
for k = 1, 3 do
local d = duel.cards[k]
X.ltext(40, y + 110 + (k - 1) * 34, string.format("Round %d: %s", k, X.cname(d[1])), "ui10")
X.rtext(W - 40, y + 110 + (k - 1) * 34, duel.res[k] and "WON" or "LOST", "ui10", "bold")
end
if duel.prize then X.wrapped(24, y + 230, duel.prize, W - 48, "small", 2) end
X.wrapped(24, y + 290, "Tell your friend the score, and send them your own duel code to fight back.", W - 48, "small", 3)
X.button(24, H - 176, W - 48, 64, "FIGHT AGAIN", function() duel.round = 1; duel.res = {}; duel.prize = nil; duel_fight() end, { font = "ui10", id = "DUELAGAIN" })
X.button(24, H - 96, W - 48, 64, "DONE", F.duel_quit, { font = "ui10", id = "DUELDONE" })
end
local FPRICE = { 10000, 20000, 50000, 100000, 250000, 500000, 1000000 }
local framed = nil
local function frames_load()
framed = {}
for v in (smudge.load("frames", "") or ""):gmatch("%d+") do framed[tonumber(v)] = true end
end
F.framed = function(c) if not framed then frames_load() end return framed[c] == true end
F.frame_price = function(c) return FPRICE[math.min(#FPRICE, X.tier_of(c) + 1)] end
F.buy_frame = function(c)
local s = S()
if F.framed(c) then return false end
local p = F.frame_price(c)
if s.coins < p then X.set_note("A gold frame for this card costs " .. X.cnum(p) .. " coins."); return false end
X.add_coins(-p)
framed[c] = true
local t = {}
for k in pairs(framed) do t[#t + 1] = k end
table.sort(t)
smudge.save("frames", table.concat(t, ","))
X.save_now()
X.set_note("Gold frame for " .. X.cname(c) .. "! It shows everywhere the card does.")
return true
end
F.draw_frame = function(x, y, sz)
smudge.rect(x - 4, y - 4, sz + 8, sz + 8, false, 2)
smudge.rect(x - 1, y - 1, sz + 2, sz + 2, false, 1)
local j = (sz >= 150) and 9 or 6
for _, p in ipairs({ { x - 3, y - 3 }, { x + sz + 3, y - 3 }, { x - 3, y + sz + 3 }, { x + sz + 3, y + sz + 3 } }) do
smudge.triangle(p[1] - j, p[2], p[1], p[2] - j, p[1] + j, p[2], true)
smudge.triangle(p[1] - j, p[2], p[1], p[2] + j, p[1] + j, p[2], true)
end
end
local fpage, fconf = 0, nil
function F.draw_frames()
local s = S()
X.top_bar("Gold frames", X.cnum(s.coins) .. "c")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
X.swipe_tabs(function() return fpage end, function(t) fpage = t; fconf = nil end, 0, 6)
for i = 0, 6 do
X.button(6 + i * 67, X.TOP + 6, 63, 56, tabs[i + 1], function() if fpage == i then X.grid_flip("frames", i) end; fpage = i; fconf = nil end,
{ font = "small", sub = FPRICE[i + 1] >= 1000000 and (FPRICE[i + 1] // 1000000) .. "M" or (FPRICE[i + 1] // 1000) .. "k", active = (fpage == i), id = "FT" .. i })
end
local y0 = X.TOP + 82
local grows = X.grid("frames", fpage, y0, 2, 176, function(c, x, y)
X.thumb(x, y, c, { name = true })
local own = X.owned(c)
X.ctext(x + 54, y + 134, not own and "not found" or (F.framed(c) and "FRAMED" or (fconf == c and "TAP AGAIN" or X.cnum(F.frame_price(c)))), "small", "bold")
X.reg("FRAME" .. c, x, y, 108, 160, function()
if not own then X.set_note("Find this card first."); return end
if F.framed(c) then X.set_note("This card already has a gold frame."); return end
if s.coins < F.frame_price(c) then fconf = nil; X.set_note("A gold frame for this card costs " .. X.cnum(F.frame_price(c)) .. " coins."); return end
if fconf ~= c then fconf = c; X.set_note("Tap again: a gold frame for " .. X.cname(c) .. " costs " .. X.cnum(F.frame_price(c)) .. " coins."); return end
fconf = nil; F.buy_frame(c)
end, true)
end, H - 96 - 30)
local n = 0
for c = 1, X.ncards do if F.framed(c) then n = n + 1 end end
X.ctext(W / 2, y0 + (grows or 2) * 176 + 4, n .. " / " .. X.ncards .. " cards framed. Pure decoration: no stats.", "small")
X.button(24, H - 96, W - 48, 64, "BACK", function() fconf = nil; X.go("packs") end, { font = "ui10" })
end
local KINDS = { "Cat", "Bunny", "Dragon", "Blob" }
local STAGES = { [0] = "Egg", "Baby", "Young", "Grown-up" }
local function bob() return (X.smooth and X.smooth()) and math.floor(math.sin(X.millis() / 260) * 4 + 0.5) or 0 end
local ART = { [1] = "cat" }
local hop_until = 0
local function asleep(p)
if p.sleepleft ~= nil then return p.sleepleft > 0 end
return p.hour and (p.hour >= 23 or p.hour < 7) and X.millis() >= hop_until
end
local light_want, light_at = nil, 0
local function hms(n) return string.format("%d:%02d:%02d", n // 3600, n // 60 % 60, n % 60) end
local function art_frame(p)
local mood = math.min(p.food, p.fun, p.clean)
if mood < 25 then return 3, 0 end
if asleep(p) then
return 1, (X.smooth and X.smooth()) and math.floor(math.sin(X.millis() / 900) * 2 + 0.5) or 0
end
if not (X.smooth and X.smooth()) then return 0, 0 end
local t = X.millis()
if t < hop_until then
local ph = (hop_until - t) / 700
return 1, -math.floor(math.abs(math.sin(ph * math.pi * 2)) * 14)
end
local dy = math.floor(math.sin(t / 420) * 2 + 0.5)
local b = t % 4300
if b < 130 or (t // 4300 % 3 == 0 and b > 330 and b < 450) then return 1, dy end
if t % 2400 > 1700 then return 2, dy + 2 end
return 0, dy
end
local PICT = nil
local function pic(x, y, w, h, name)
if PICT then
local k = PICT.k
local x0, y0 = PICT.tx + (x - PICT.ax) * k, PICT.ty + (y - PICT.ay) * k
local x1, y1 = x0 + w * k, y0 + h * k
smudge.draw_sprite_quad("art/" .. name .. ".raw", w, h, x0, y0, x1, y0, x1, y1, x0, y1, "art/" .. name .. "_m.raw")
return
end
smudge.draw_sprite(x, y, w, h, "art/" .. name .. ".raw", "art/" .. name .. "_m.raw")
end
local function draw_pet(p, cx, cy)
if ART[p.kind] and p.stage >= 1 then
local f, dy = art_frame(p)
local sz = 176
pic(cx - sz // 2, cy - sz // 2 + dy, sz, sz, string.format("pet_%s_%d_%d", ART[p.kind], p.stage, f))
return
end
local mood = math.min(p.food, p.fun, p.clean)
if p.stage == 0 then
local f = (p.xp >= 30) and 3 or 0
if X.smooth and X.smooth() and not asleep(p) then
local t = X.millis() % 3200
if t > 2300 and t < 2500 then f = 1 elseif t >= 2500 and t < 2700 then f = 2 elseif t >= 2700 and t < 2900 then f = 1 end
if X.millis() < hop_until then f = ((X.millis() // 90) % 2 == 0) and 1 or 2 end
end
pic(cx - 88, cy - 88, 176, 176, "pet_egg_" .. f)
return
end
if p.stage == -1 then
local w, h = 104, 136
local ex, ey = cx - w // 2, cy - h // 2 + 6 + bob() // 2
if not X.saver() then smudge.rounded_rect(ex + 5, ey + 6, w, h, w // 2, true) end
smudge.rounded_rect(ex, ey, w, h, w // 2, true, 1, false)
smudge.rounded_rect(ex, ey, w, h, w // 2, false, 3)
for _, sp in ipairs({ { 22, 34, 9 }, { 70, 52, 6 }, { 34, 92, 7 }, { 80, 100, 5 } }) do smudge.circle(ex + sp[1], ey + sp[2], sp[3], true) end
local cr = math.min(4, p.xp // 10)
local pts = { { 6, 66 }, { 26, 56 }, { 42, 72 }, { 60, 54 }, { 78, 70 }, { 98, 60 } }
for k = 1, cr + 1 do smudge.line(ex + pts[k][1], ey + pts[k][2], ex + pts[k + 1][1], ey + pts[k + 1][2], 3) end
return
end
local r = ({ 44, 54, 64 })[p.stage]
local y = cy + 20 - r // 2 + bob()
if p.kind == 1 then
smudge.triangle(cx - r + 6, y - r // 2, cx - r // 2, y - r - 22, cx - 6, y - r + 6, true)
smudge.triangle(cx + r - 6, y - r // 2, cx + r // 2, y - r - 22, cx + 6, y - r + 6, true)
elseif p.kind == 2 then
smudge.rounded_rect(cx - r // 2 - 12, y - r - 46, 22, 62, 11, true, 1, false); smudge.rounded_rect(cx - r // 2 - 12, y - r - 46, 22, 62, 11, false, 3)
smudge.rounded_rect(cx + r // 2 - 10, y - r - 46, 22, 62, 11, true, 1, false); smudge.rounded_rect(cx + r // 2 - 10, y - r - 46, 22, 62, 11, false, 3)
elseif p.kind == 3 then
smudge.triangle(cx - r // 2, y - r + 8, cx - r // 2 - 8, y - r - 26, cx - r // 2 + 14, y - r + 4, true)
smudge.triangle(cx + r // 2, y - r + 8, cx + r // 2 + 8, y - r - 26, cx + r // 2 - 14, y - r + 4, true)
smudge.triangle(cx - r - 2, y - 6, cx - r - 36, y - 34, cx - r - 20, y + 16, true)
smudge.triangle(cx + r + 2, y - 6, cx + r + 36, y - 34, cx + r + 20, y + 16, true)
else
smudge.line(cx, y - r, cx + 10, y - r - 26, 3); smudge.circle(cx + 12, y - r - 30, 7, true)
end
if not X.saver() then smudge.circle(cx + 5, y + 6, r, true) end
smudge.circle(cx, y, r, true, 1, false)
smudge.circle(cx, y, r, false, 3)
smudge.circle(cx, y + r // 3, r // 2, false, 1)
if p.clean < 35 then for k = 0, 4 do smudge.circle(cx - r // 2 + k * (r // 4), y + r // 2 - (k % 2) * 10, 3, true) end end
local ex, ey = r // 3, y - r // 5
if p.busy then
smudge.line(cx - ex - 8, ey, cx - ex + 8, ey, 3); smudge.line(cx + ex - 8, ey, cx + ex + 8, ey, 3)
else
smudge.circle(cx - ex, ey, 7, true); smudge.circle(cx + ex, ey, 7, true)
smudge.circle(cx - ex + 2, ey - 2, 2, true, 1, false); smudge.circle(cx + ex + 2, ey - 2, 2, true, 1, false)
end
local my = y + r // 6
if mood >= 50 then
smudge.line(cx - 14, my, cx - 6, my + 8, 3); smudge.line(cx - 6, my + 8, cx + 6, my + 8, 3); smudge.line(cx + 6, my + 8, cx + 14, my, 3)
elseif mood >= 25 then
smudge.line(cx - 10, my + 4, cx + 10, my + 4, 3)
else
smudge.line(cx - 14, my + 8, cx - 6, my, 3); smudge.line(cx - 6, my, cx + 6, my, 3); smudge.line(cx + 6, my, cx + 14, my + 8, 3)
smudge.circle(cx + ex + 4, ey + 16, 4, true)
end
if p.kind == 1 then for s2 = -1, 1, 2 do smudge.line(cx + s2 * 18, my - 4, cx + s2 * 40, my - 8, 1); smudge.line(cx + s2 * 18, my, cx + s2 * 40, my + 2, 1) end end
end
local VERB = { feed = "fed", play = "played with", clean = "cleaned", pet = "petted", treat = "gave a treat to", hatch = "found" }
local function pet_says(p)
if p.stage == 0 then return "(the egg wobbles a little...)" end
if asleep(p) then return (p.sleepleft or 0) > 0 and "Zzz... zzz... (lights off)" or "Zzz... zzz..." end
if p.food < 25 and p.food <= p.fun and p.food <= p.clean then return "I'm so hungry..." end
if p.fun < 25 and p.fun <= p.clean then return "Play with me, please?" end
if p.clean < 25 then return "I feel a bit dirty..." end
if p.lastwho ~= "" and p.lastwho ~= p.me and p.lastwho == p.partner and p.lastago < 3 * 3600 and VERB[p.lastact] then
return p.partner .. " " .. VERB[p.lastact] .. " me!"
end
if p.streak >= 2 then return p.streak .. " days in a row together!" end
if p.together then return "We're a team today!" end
if p.food < 50 then return "A snack would be nice..." end
local h = p.hour or 12
if h < 11 then return "Good morning, " .. p.me .. "!" end
if h < 18 then return "Let's play!" end
return "What a nice day it was."
end
local function bubble(text, cx, y)
local w = math.min(W - 40, X.tw(text, "small", "bold") + 28)
local x = cx - w // 2
if not X.saver() then smudge.rounded_rect(x + 3, y + 4, w, 34, 12, true) end
smudge.rounded_rect(x, y, w, 34, 12, true, 1, false)
smudge.rounded_rect(x, y, w, 34, 12, false, 2)
smudge.triangle(cx - 8, y + 33, cx + 8, y + 33, cx, y + 44, true)
X.ctext(cx, y + (34 - X.lh("small")) // 2, text, "small", "bold")
end
local MILES = { { 3, "300 coins", function(s) X.add_coins(300) end }, { 7, "a RARE ticket", function(s) s.camp.rtickets = s.camp.rtickets + 1 end },
{ 14, "1,500 coins + a ticket", function(s) X.add_coins(1500); s.camp.tickets = s.camp.tickets + 1 end },
{ 30, "2 RARE tickets", function(s) s.camp.rtickets = s.camp.rtickets + 2 end }, { 60, "5,000 coins", function(s) X.add_coins(5000) end },
{ 100, "3 RARE tickets", function(s) s.camp.rtickets = s.camp.rtickets + 3 end } }
local function next_mile(p)
local got = tonumber(smudge.load("petstreak", "0")) or 0
if p.streak < got then got = 0; smudge.save("petstreak", "0") end
for _, m in ipairs(MILES) do if m[1] > got then return m, p.streak >= m[1] end end
return nil, false
end
local FX = {}
local say_text, say_until = nil, 0
local shown = {}
local seek = nil
local function smooth() return X.smooth and X.smooth() end
local function fx(k, d, o)
o = o or {}; o.k = k; o.t = X.millis(); o.d = d or 1400
FX[#FX + 1] = o
if not smooth() then X.after(o.d + 50, X.redraw) end
end
local function say(t, ms) say_text = t; say_until = X.millis() + (ms or 2600) end
local GAIN = { feed = "+35 food", play = "+30 fun", clean = "+40 clean", pet = "+8 fun", treat = "+50 food +10 fun" }
local LINES = {
feed = { "Nom nom nom!", "Yummy!", "So tasty!" }, play = { "Again! Again!", "Wheee!", "Got it!" },
clean = { "Squeaky clean!", "Bubbles!", "So fresh!" }, pet = { "Purrr...", "More, please!", "That's the spot!" },
treat = { "A TREAT?! Best day ever!", "Mmmm, special!", "You're the best!" },
tap = { "Hehe!", "Hi!", "Purrr...", "Boop!", "That tickles!", "Mrrp?" },
}
local function pick(t) return t[X.rnd(1, #t)] end
local PCS = { food = 80, play = 64, clean = 72, pet = 80, treat = 64, heart = 32, box = 112, plant = 112, basket = 112 }
local function pcs(name, x, y, sc)
local n = PCS[name]
local w = n * (sc or 1)
local path, m = "art/pc_" .. name .. ".raw", "art/pc_" .. name .. "_m.raw"
if smudge.draw_sprite_quad then
local x0, y0 = math.floor(x - w / 2 + 0.5), math.floor(y - w + 0.5)
local x1, y1 = x0 + math.floor(w + 0.5), math.floor(y + 0.5)
smudge.draw_sprite_quad(path, n, n, x0, y0, x1, y0, x1, y1, x0, y1, m)
else smudge.draw_sprite(math.floor(x - n / 2), math.floor(y - n), n, n, path, m) end
end
local function heart(x, y, r)
if smudge.draw_sprite_quad then pcs("heart", x, y + r + 4, (2 * r + 10) / 32); return end
smudge.circle(x - r // 2, y, r // 2 + 1, true); smudge.circle(x + r // 2, y, r // 2 + 1, true)
smudge.triangle(x - r - 1, y + 1, x + r + 1, y + 1, x, y + r + 3, true)
end
local function star(x, y, r, t)
smudge.line(x - r, y, x + r, y, t or 2); smudge.line(x, y - r, x, y + r, t or 2)
smudge.line(x - r // 2, y - r // 2, x + r // 2, y + r // 2, 1); smudge.line(x - r // 2, y + r // 2, x + r // 2, y - r // 2, 1)
end
local function bubble_o(x, y, r)
smudge.circle(x, y, r, true, 1, false); smudge.circle(x, y, r, false, 2)
if r > 5 then smudge.circle(x - r // 3, y - r // 3, math.max(1, r // 4), true) end
end
local function yarn(x, y, r, fr)
if smudge.draw_sprite_quad then
local nm = "art/yarn" .. (((fr or 0) % 4) + 1)
local x0, y0, x1, y1 = math.floor(x - r + 0.5), math.floor(y - r + 0.5), math.floor(x + r + 0.5), math.floor(y + r + 0.5)
smudge.draw_sprite_quad(nm .. ".raw", 64, 64, x0, y0, x1, y0, x1, y1, x0, y1, nm .. "_m.raw")
return
end
if true then pcs("play", x, y + r + 6, (2 * r + 22) / 64); return end
smudge.circle(x, y, r, true, 1, false); smudge.circle(x, y, r, false, 2)
smudge.line(x - r + 3, y - 3, x + r - 3, y + 4, 1); smudge.line(x - r + 4, y + 4, x + r - 5, y - 5, 1); smudge.line(x - 2, y - r + 2, x + 3, y + r - 2, 1)
end
local function bowl(x, y)
if true then pcs("food", x, y + 18, 0.9); return end
smudge.rounded_rect(x - 30, y - 6, 60, 22, 10, true, 1, false); smudge.rounded_rect(x - 30, y - 6, 60, 22, 10, false, 3)
smudge.rect(x - 34, y - 8, 68, 5, true)
for k = 0, 4 do smudge.circle(x - 18 + k * 9, y - 11 + (k % 2) * 2, 4, true) end
end
local FUR = { deco = false, boxes = {},
list = { { id = "bed", name = "cat bed", price = 400 }, { id = "shelf", name = "bookshelf", price = 600 }, { id = "lamp", name = "floor lamp", price = 300 } } }
FUR.queue = {}
local function parse(str) local t = {} for k, v in (str or ""):gmatch("(%a+)=(%d)") do t[k] = tonumber(v) end return t end
function FUR.get()
local t = parse(smudge.load("petfur", ""))
if FUR.shared then
local sh = parse(FUR.shared)
for k, v in pairs(sh) do t[k] = v end
for _, q in ipairs(FUR.queue) do t[q[1]] = q[2] end
end
return t
end
function FUR.set(t)
local old = FUR.get()
local o = {}
for _, f in ipairs(FUR.list) do if t[f.id] then o[#o + 1] = f.id .. "=" .. t[f.id] end end
smudge.save("petfur", table.concat(o, ","))
if FUR.shared then
for _, f in ipairs(FUR.list) do
if t[f.id] and t[f.id] ~= old[f.id] then FUR.queue[#FUR.queue + 1] = { f.id, t[f.id] } end
end
end
end
function FUR.sync(p)
if p.fur == nil then FUR.shared = nil; return end
local sh = parse(p.fur)
if not FUR.merged then
FUR.merged = true
for k, v in pairs(parse(smudge.load("petfur", ""))) do if sh[k] == nil then FUR.queue[#FUR.queue + 1] = { k, v } end end
end
FUR.shared = p.fur
local q = FUR.queue[1]
if q and sh[q[1]] == q[2] then table.remove(FUR.queue, 1); q = FUR.queue[1] end
if q and not p.busy and X.millis() >= (FUR.next or 0) then
FUR.next = X.millis() + 4000
smudge.pet_do("fur:" .. q[1] .. "=" .. q[2])
end
end
function FUR.placed(id) return FUR.get()[id] == 1 end
function FUR.spot(id, a, b, D)
if id == "bed" then return -a + 10, -a + 140, b - 89, D * 0.18, 128, 88
elseif id == "shelf" then return -a + 4, -a + 134, b - 130, D - 6, 128, 128 end
return a - 122, a - 78, b - 110, D - 24, 64, 160
end
function FUR.flat(id, w)
if id == "bed" then return 6, -50, 96, 64
elseif id == "shelf" then return w - 196, -88, 88, 88 end
return 112, -104, 40, 104
end
function FUR.shown()
local t, out = FUR.get(), {}
for _, f in ipairs(FUR.list) do
if t[f.id] == 1 then out[#out + 1] = { f, "in" } elseif FUR.deco then out[#out + 1] = { f, "ghost" } end
end
return out
end
local YB = { st = "rest", x = 110, y = 0, z = 0, vx = 0, vy = 0, vz = 0, t = 0, last = 0, petx = 0, R = 12 }
local RP, RD, RT = nil, 170, nil
local function room3d_setup(x, y, w, h)
local rx, ry
if X.tilt then rx, ry = X.tilt("petroom", x, y, w, h, 1) end
if not rx or not smudge.draw_sprite_quad or not smudge.fill_quad then RP = nil; return end
local ccx, ccy, FOC, EY, PZ = x + w / 2, y + h / 2, 480, -45, 0
local cr, sr, cxr, sxr = math.cos(ry), math.sin(ry), math.cos(rx), math.sin(rx)
RT = { rx, ry }
RP = function(px, py, pz)
local z = pz - PZ
local x1, z1 = px * cr + z * sr, -px * sr + z * cr
local y1 = py - EY
local y2, z2 = y1 * cxr - z1 * sxr, y1 * sxr + z1 * cxr
local k = FOC / (FOC + z2 + PZ)
return ccx + x1 * k, ccy + EY + y2 * k, k
end
end
local function room3d(p, x, y, w, h, noplant)
local a, b = w / 2, h / 2
local function q(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3)
local p0, q0 = RP(x0, y0, z0); local p1, q1 = RP(x1, y1, z1); local p2, q2 = RP(x2, y2, z2); local p3, q3 = RP(x3, y3, z3)
return p0, q0, p1, q1, p2, q2, p3, q3
end
local function face(tex, ...) smudge.draw_sprite_quad("art/" .. tex .. ".raw", 256, 256, ...) end
local D = RD
face("room_w_ceil", q(-a, -b, D, a, -b, D, a, -b, 0, -a, -b, 0))
face("room_w_floor", q(-a, b, D, a, b, D, a, b, 0, -a, b, 0))
face("room_w_side", q(-a, -b, 0, -a, -b, D, -a, b, D, -a, b, 0))
face("room_w_side", q(a, -b, D, a, -b, 0, a, b, 0, a, b, D))
face("room_w_back", q(-a, -b, D, a, -b, D, a, b, D, -a, b, D))
if p.sleepleft and p.sleepleft > 0 and smudge.shade_quad then
local function shade_face(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3, phase)
local v = { q(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3) }
smudge.shade_quad(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], phase)
end
shade_face(-a, -b, D, a, -b, D, a, -b, 0, -a, -b, 0, 0)
shade_face(-a, b, D, a, b, D, a, b, 0, -a, b, 0, 1)
shade_face(-a, -b, 0, -a, -b, D, -a, b, D, -a, b, 0, 0)
shade_face(a, -b, D, a, -b, 0, a, b, 0, a, b, D, 1)
shade_face(-a, -b, D, a, -b, D, a, b, D, -a, b, D, 0)
end
local function L(x0, y0, z0, x1, y1, z1, t)
local p0, q0 = RP(x0, y0, z0); local p1, q1 = RP(x1, y1, z1)
smudge.line(math.floor(p0 + 0.5), math.floor(q0 + 0.5), math.floor(p1 + 0.5), math.floor(q1 + 0.5), t or 1)
end
for _, c in ipairs({ { -a, -b }, { a, -b }, { a, b }, { -a, b } }) do L(c[1], c[2], 0, c[1], c[2], D, 2) end
L(-a, -b, D, a, -b, D, 2); L(a, -b, D, a, b, D, 2); L(a, b, D, -a, b, D, 2); L(-a, b, D, -a, -b, D, 2)
local night = p.hour and (p.hour >= 20 or p.hour < 7)
local ww, wh = 264, 240
local wx0, wy0 = -ww / 2, -b + 18
local px0, py0 = wx0 + ww * 26 / 176, wy0 + wh * 6 / 160
local px1, py1 = wx0 + ww * 150 / 176, wy0 + wh * 139 / 160
local FAR, WIN = 260, 0.72
local base = (1 - WIN) / 2
local function cl(v) return math.max(0.01, math.min(1 - WIN - 0.01, v)) end
local u0 = cl(base - FAR * math.sin(RT[2]) / (px1 - px0) * WIN)
local v0 = cl(base + FAR * math.sin(RT[1]) / (py1 - py0) * WIN)
local oq = { q(px0, py0, D, px1, py0, D, px1, py1, D, px0, py1, D) }
smudge.draw_sprite_quad(night and "art/room_out_night.raw" or "art/room_out_day.raw", 256, 256,
oq[1], oq[2], oq[3], oq[4], oq[5], oq[6], oq[7], oq[8], nil, u0, v0, u0 + WIN, v0 + WIN)
local wq = { q(wx0, wy0, D - 2, wx0 + ww, wy0, D - 2, wx0 + ww, wy0 + wh, D - 2, wx0, wy0 + wh, D - 2) }
smudge.draw_sprite_quad("art/room_win.raw", 176, 160, wq[1], wq[2], wq[3], wq[4], wq[5], wq[6], wq[7], wq[8], "art/room_win_m.raw")
local dark = p.sleepleft and p.sleepleft > 0
FUR.boxes = {}
local items = noplant and {} or FUR.shown()
table.sort(items, function(i, j) return select(4, FUR.spot(i[1].id, a, b, D)) > select(4, FUR.spot(j[1].id, a, b, D)) end)
for _, it in ipairs(items) do
local id = it[1].id
local x0, x1, top, z, pw, ph = FUR.spot(id, a, b, D)
local fq = { q(x0, top, z, x1, top, z, x1, b, z, x0, b, z) }
local nm = "art/fur_" .. id .. ((id ~= "lamp" and (dark or it[2] == "ghost")) and "_n" or "")
if dark and id == "lamp" and smudge.glare_quad and it[2] == "in" then
local lx, ly = (x0 + x1) / 2, top + (b - top) * 0.22
local g = { q(lx - 10, ly, z, lx + 10, ly, z, lx + 90, b, z - 70, lx - 90, b, z - 70) }
smudge.glare_quad(g[1], g[2], g[3], g[4], g[5], g[6], g[7], g[8], false)
end
smudge.draw_sprite_quad(nm .. ".raw", pw, ph, fq[1], fq[2], fq[3], fq[4], fq[5], fq[6], fq[7], fq[8], nm .. "_m.raw")
local mx, my = math.min(fq[1], fq[7]), fq[2]
FUR.boxes[id] = { math.floor(mx), math.floor(my), math.floor(math.max(fq[3], fq[5]) - mx), math.floor(math.max(fq[6], fq[8]) - my), it[2] }
end
if not noplant then
local f = smooth() and (X.millis() // 450) % 4 or 0
local pn = "art/room_plant_" .. f
local pz = D * 0.36
local pq = { q(a - 84, b - 116, pz, a - 12, b - 116, pz, a - 12, b - 8, pz, a - 84, b - 8, pz) }
smudge.draw_sprite_quad(pn .. ".raw", 72, 108, pq[1], pq[2], pq[3], pq[4], pq[5], pq[6], pq[7], pq[8], pn .. "_m.raw")
end
end
local function room3d_front(x, y, w, h)
local a, b = w / 2, h / 2
local pts = {}
for _, c in ipairs({ { -a, -b }, { a, -b }, { a, b }, { -a, b } }) do local px, py = RP(c[1], c[2], 0); pts[#pts + 1] = { px, py } end
for k = 1, 4 do local u, v = pts[k], pts[k % 4 + 1]; smudge.line(math.floor(u[1] + 0.5), math.floor(u[2] + 0.5), math.floor(v[1] + 0.5), math.floor(v[2] + 0.5), 4) end
end
function YB.step(now, a, b, D)
local dt = math.min(40, math.max(0, now - (YB.last > 0 and YB.last or now))); YB.last = now
if YB.st ~= "rest" and X.moving then X.moving(300) end
local R = YB.R
YB.b = b
if YB.st == "rest" then YB.x, YB.y, YB.z = a - 140, b - R, D * 0.14 end
if YB.st == "fly" then
local n = math.max(1, math.ceil(dt / 10)); local h = dt / n
for _ = 1, n do
YB.vy = YB.vy + 0.0016 * h
YB.x, YB.y, YB.z = YB.x + YB.vx * h, YB.y + YB.vy * h, YB.z + YB.vz * h
YB.roll = (YB.roll or 0) + math.sqrt(YB.vx * YB.vx + YB.vz * YB.vz) * h
YB.fr = math.floor(YB.roll / (R * 0.8))
if YB.y > b - R then
YB.y = b - R
if YB.vy > 0 then YB.vy = -YB.vy * 0.55; YB.vx = YB.vx * 0.85; YB.vz = YB.vz * 0.85; if math.abs(YB.vy) < 0.07 then YB.vy = 0 end end
end
if YB.y < -b + R then YB.y = -b + R; YB.vy = math.abs(YB.vy) * 0.5 end
if YB.x < -a + R then YB.x = -a + R; YB.vx = math.abs(YB.vx) * 0.6 elseif YB.x > a - R then YB.x = a - R; YB.vx = -math.abs(YB.vx) * 0.6 end
if YB.z > D - R then YB.z = D - R; YB.vz = -math.abs(YB.vz) * 0.6 elseif YB.z < R then YB.z = R; YB.vz = math.abs(YB.vz) * 0.6 end
if YB.vy == 0 then YB.vx = YB.vx * (1 - 0.004 * h); YB.vz = YB.vz * (1 - 0.004 * h) end
end
if (YB.vy == 0 and math.abs(YB.vx) + math.abs(YB.vz) < 0.02) or now - YB.t > 6000 then YB.st = "wait"; YB.t = now; YB.y = b - R end
end
local tx = 0
if YB.st == "fly" or YB.st == "wait" then tx = math.max(-a + 70, math.min(a - 70, YB.x)) end
YB.petx = YB.petx + (tx - YB.petx) * math.min(1, dt / 260)
if YB.st == "wait" and math.abs(YB.petx - tx) < 12 and now - YB.t > 300 then YB.st = "fetched"; YB.t = now; return "got" end
if YB.st == "fetched" and now - YB.t > 1300 then YB.st = "rest" end
end
function YB.draw(a, b, D)
if YB.st == "hold" then yarn(math.floor(YB.hx), math.floor(YB.hy), math.floor(YB.sr), YB.fr or 0); return end
local R = YB.R
local x, y, z = YB.x, YB.y, YB.z
if YB.st == "fetched" then x, y, z = YB.petx + 36, b - 34, D * 0.42 - 24 end
local sx, sy, k = RP(x, y, z)
if YB.st ~= "fetched" and smudge.shade_quad then
local s1, t1 = RP(x - R, b, z - R * 0.6); local s2, t2 = RP(x + R, b, z - R * 0.6)
local s3, t3 = RP(x + R, b, z + R * 0.6); local s4, t4 = RP(x - R, b, z + R * 0.6)
smudge.shade_quad(s1, t1, s2, t2, s3, t3, s4, t4, 0)
end
if YB.st == "rest" then YB.sx, YB.sy, YB.k = sx, sy, k end
YB.sr = math.max(6, R * k)
yarn(math.floor(sx), math.floor(sy), math.floor(YB.sr), YB.fr or 0)
end
F.YB = YB
function F.pet_touch(ev, x, y)
if X.scr() ~= "ourpet" or not YB.can then if YB.st == "hold" then YB.st = "rest" end return false end
if ev == "down" then
if YB.st == "rest" and YB.sx and (x - YB.sx) ^ 2 + (y - YB.sy) ^ 2 < math.max(40, YB.sr * 2.8) ^ 2 then
YB.st = "hold"; YB.hx, YB.hy = x, y; YB.smp = { { x, y, X.millis() } }
return true
end
return false
end
if YB.st ~= "hold" then return false end
local now = X.millis()
YB.hx, YB.hy = x, y
YB.smp[#YB.smp + 1] = { x, y, now }; if #YB.smp > 10 then table.remove(YB.smp, 1) end
if ev == "release" then
local s0 = YB.smp[1]
for _, sm in ipairs(YB.smp) do if now - sm[3] <= 100 then s0 = sm; break end end
local dt = math.max(16, now - s0[3])
local vxs, vys = (x - s0[1]) / dt, (y - s0[2]) / dt
local k = YB.k or 1
YB.x = YB.x + (x - YB.sx) / k
YB.y = math.max(-YB.b + 30, YB.y + math.min(0, (y - YB.sy) / k))
YB.st = "fly"; YB.t = now
if (smudge.load("petyarn", "") or "") == "" then smudge.save("petyarn", "1") end
if vys > -0.25 and math.abs(vxs) < 0.25 then YB.vx, YB.vy, YB.vz = 0, 0, 0; return true end
YB.vx = math.max(-0.9, math.min(0.9, vxs * 0.45))
YB.vz = math.max(0.05, math.min(0.8, -vys * 0.35))
YB.vy = math.max(-1.1, math.min(-0.2, vys * 0.5))
end
return true
end
function FUR.tap(f, s, p)
local t = FUR.get()
if t[f.id] == 1 then t[f.id] = 0; FUR.set(t); X.set_note("The " .. f.name .. " is put away (tap it to put it back)."); return end
if t[f.id] == 0 then t[f.id] = 1; FUR.set(t); X.set_note("The " .. f.name .. " is back in the room."); return end
if s.coins < f.price then X.set_note("A " .. f.name .. " costs " .. f.price .. " coins (you have " .. s.coins .. ")."); return end
X.add_coins(-f.price); t[f.id] = 1; FUR.set(t); X.save_now()
X.set_note("You bought a " .. f.name .. " for " .. p.name .. "!"); fx("hearts", 1200); hop_until = X.millis() + 700
if p.stage >= 1 then say(f.id == "bed" and "A bed! I'll sleep in it tonight!" or "Ooh, it looks so cosy now!") end
end
local function room(p, x, y, w, h, cx, floor, noplant)
if RP then room3d(p, x, y, w, h, noplant); return end
smudge.draw_sprite(x, y, w, h, "art/room_bg.raw")
smudge.rect(x, y, w, h, false, 2)
local night = p.hour and (p.hour >= 20 or p.hour < 7)
pic(x + 58, y + 38, 104, 104, night and "room_window_night" or "room_window_day")
FUR.boxes = {}
for _, it in ipairs(noplant and {} or FUR.shown()) do
local fx0, fy0, fw, fh = FUR.flat(it[1].id, w)
pic(x + fx0, floor + fy0, fw, fh, "fur_" .. it[1].id .. "_r")
if it[2] == "ghost" then smudge.rect_dither(x + fx0, floor + fy0, fw, fh, 1) end
FUR.boxes[it[1].id] = { x + fx0, floor + fy0, fw, fh, it[2] }
end
if not noplant then
local f = smooth() and (X.millis() // 450) % 4 or 0
pic(x + w - 86, floor - 104, 72, 108, "room_plant_" .. f)
end
end
local function draw_fx(cx, top, floor)
local now, keep = X.millis(), {}
for _, e in ipairs(FX) do
local u = (now - e.t) / e.d
local alive = u < 1
if not smooth() then u = 0.45 end
if alive then
keep[#keep + 1] = e
if e.k == "hearts" or e.k == "treat" then
for i = 0, (e.k == "treat" and 6 or 4) do
local v = (u * 1.3 - i * 0.08)
if v > 0 and v < 1 then
local side = (i % 2 == 0) and -1 or 1
local hx = cx + side * (88 + (i % 3) * 14) + math.floor(math.sin(v * 6 + i) * 6)
heart(hx, top + 130 - math.floor(v * 110) - (i // 2) * 14, 9 + (i % 2) * 3)
end
end
if e.k == "treat" then
for i = 0, 5 do local a = i * 1.047 + u * 2; star(cx + math.floor(math.cos(a) * 92), top + 84 + math.floor(math.sin(a) * 70), 7) end
if u < 0.55 then pcs("treat", cx + 64 - math.floor(u * 70), top + 150, 0.8) end
elseif u < 0.8 then
pcs("pet", cx + math.floor(math.sin(u * 14) * 26) + 20, top + 64, 0.85)
end
elseif e.k == "food" then
bowl(cx + 54, floor - 8)
if u < 0.7 then for i = 0, 3 do smudge.circle(cx + 30 + i * 10, floor - 30 + math.floor(((u * 4 + i * 0.3) % 1) * 18), 2, true) end end
elseif e.k == "ball" then
local bx = cx - 150 + math.floor(u * 300)
local by = floor - 12 - math.floor(math.abs(math.sin(u * math.pi * 3)) * 60)
yarn(bx, by, 14, math.floor(u * 14))
elseif e.k == "bubbles" then
if u < 0.75 then pcs("clean", cx + math.floor(math.sin(u * 16) * 40), top + 120 + math.floor(math.cos(u * 11) * 10), 0.8) end
for i = 0, 8 do
local v = (u * 1.2 - (i % 4) * 0.07)
if v > 0 and v < 1 then bubble_o(cx - 80 + i * 20, floor - 20 - math.floor(v * 140) + (i % 3) * 8, 6 + (i * 5) % 9) end
end
if u > 0.6 then star(cx - 50, top + 60, 9); star(cx + 56, top + 40, 7); star(cx + 30, top + 110, 6) end
elseif e.k == "found" then
for i = 0, 7 do local a = i * 0.785; local r = 40 + math.floor(u * 60)
star(cx + math.floor(math.cos(a) * r), top + 90 + math.floor(math.sin(a) * r * 0.8), 6) end
elseif e.k == "levelup" then
for i = 0, 15 do
local fx0 = (i * 53) % 400 - 200
local cyf = top - 10 + math.floor(u * 200) + (i * 37) % 60
if (i % 3) == 0 then smudge.rect(cx + fx0, cyf, 6, 6, true) elseif (i % 3) == 1 then star(cx + fx0, cyf, 5) else smudge.circle(cx + fx0, cyf, 3, true) end
end
local tw = X.tw(e.text, "ui10", "bold") + 24
smudge.rounded_rect(cx - tw // 2, top - 76, tw, 34, 10, true); X.ctext(cx, top - 71, e.text, "ui10", "bold", true)
end
if e.gain and u < 1 then
local gy = top + 70 - math.floor(u * 50)
local tw = X.tw(e.gain, "small", "bold") + 14
smudge.rounded_rect(cx + 50, gy, tw, 22, 8, true, 1, false); smudge.rounded_rect(cx + 50, gy, tw, 22, 8, false, 2)
X.ltext(cx + 57, gy + 2, e.gain, "small", "bold")
end
end
end
FX = keep
end
local function minibar(x, y, w, label, v, key)
local t = v
if smooth() then
shown[key] = shown[key] or v
shown[key] = shown[key] + (v - shown[key]) * 0.12
if math.abs(shown[key] - v) < 0.5 then shown[key] = v end
t = math.floor(shown[key] + 0.5)
end
local low = v < 25
local blink = low and smooth() and (X.millis() // 450) % 2 == 0
X.ltext(x, y, (low and "! " or "") .. label, "small", "bold")
X.rtext(x + w, y, v .. "%", "small", "bold")
if not blink then X.bar(x, y + 20, w, 12, t / 100) else smudge.rect(x, y + 20, w, 12, false, 2) end
end
local WISH = { { "feed", 2, "Feed me twice" }, { "play", 2, "Play with me twice" }, { "clean", 1, "I want a bath" },
{ "pet", 3, "Cuddles! Pet me 3 times" }, { "treat", 1, "A treat, pretty please" }, { "seek", 1, "Hide and seek with me" } }
local function hash(t) local h = 7; for i = 1, #t do h = (h * 31 + t:byte(i)) % 1000003 end return h end
local function wish_of(p, newer)
local list = {}
for _, w in ipairs(WISH) do
if not (w[1] == "treat" and not newer) and not (w[1] == "seek" and p.stage == 0) then list[#list + 1] = w end
end
return list[hash((p.day or "") .. (p.name or "") .. (p.me or "")) % #list + 1]
end
local function wish_state(p)
local d, n, c = (smudge.load("petwish", "") or ""):match("^(.-)|(%d+)|(%d)$")
if d ~= p.day then return 0, false end
return tonumber(n) or 0, c == "1"
end
local function wish_count(p, newer, act)
local w = wish_of(p, newer)
if not w or w[1] ~= act then return end
local n, c = wish_state(p)
if c then return end
smudge.save("petwish", p.day .. "|" .. (n + 1) .. "|0")
if n + 1 == w[2] then say(p.name .. " is so happy: wish come true!", 3000) end
end
local function care(p, s, act, newer)
if act == "treat" then
local i = X.food_in_bank and X.food_in_bank()
if not i then X.set_note("A treat is food from your bank (cook some at the CAMP)."); return end
s.camp.inv[i] = s.camp.inv[i] - 1; X.save_now()
X.set_note("You give " .. p.name .. " a " .. X.item_name(i):lower() .. ".")
end
hop_until = X.millis() + 700
smudge.pet_do(act)
local kind = ({ feed = "food", play = "ball", clean = "bubbles", pet = "hearts", treat = "treat" })[act]
fx(kind, act == "play" and 1800 or 1500, { gain = GAIN[act] })
if p.stage >= 1 then say(pick(LINES[act])) end
wish_count(p, newer, act)
end
local SPOTS = { "box", "plant", "basket" }
local function seek_state(p)
local d, w = (smudge.load("petseek", "") or ""):match("^(.-)|(%d+)$")
return d == p.day and (tonumber(w) or 0) or 0
end
local function draw_spot(k, x, floor, picked, here, sc)
sc = sc or 1
if smudge.draw_sprite_quad then
pcs(({ "box", "plant", "basket" })[k], x, floor + 2, sc)
if picked and here then
local ey = floor - math.floor(({ 74, 88, 58 })[k] * sc)
for _, ox in ipairs({ -12, 12 }) do
smudge.triangle(x + ox - 12, ey + 4, x + ox, ey - 24, x + ox + 12, ey + 4, true)
smudge.triangle(x + ox - 7, ey + 1, x + ox, ey - 15, x + ox + 7, ey + 1, true, 1, false)
end
star(x - 44, ey - 20, 7); star(x + 44, ey - 14, 6)
elseif picked then
X.ctext(x, floor - math.floor(126 * sc), "empty!", "small", "bold")
end
return
end
if k == 1 then
smudge.rect(x - 34, floor - 56, 68, 56, true, 1, false); smudge.rect(x - 34, floor - 56, 68, 56, false, 3)
smudge.line(x - 34, floor - 56, x - 46, floor - 70, 3); smudge.line(x + 34, floor - 56, x + 46, floor - 70, 3)
smudge.line(x - 12, floor - 40, x + 12, floor - 40, 2)
elseif k == 2 then
smudge.rounded_rect(x - 22, floor - 40, 44, 40, 6, true, 1, false); smudge.rounded_rect(x - 22, floor - 40, 44, 40, 6, false, 3)
for j = -2, 2 do smudge.circle(x + j * 14, floor - 62 - (2 - math.abs(j)) * 10, 14, true) end
else
smudge.rounded_rect(x - 40, floor - 38, 80, 38, 14, true, 1, false); smudge.rounded_rect(x - 40, floor - 38, 80, 38, 14, false, 3)
for j = 0, 4 do smudge.line(x - 30 + j * 15, floor - 34, x - 30 + j * 15, floor - 4, 1) end
smudge.line(x - 30, floor - 38, x - 18, floor - 66, 3); smudge.line(x + 30, floor - 38, x + 18, floor - 66, 3); smudge.line(x - 18, floor - 66, x + 18, floor - 66, 3)
end
if picked and here then
local ey = floor - (k == 1 and 56 or k == 2 and 84 or 40)
for _, ox in ipairs({ -12, 12 }) do
smudge.triangle(x + ox - 12, ey + 4, x + ox, ey - 24, x + ox + 12, ey + 4, true)
smudge.triangle(x + ox - 7, ey + 1, x + ox, ey - 15, x + ox + 7, ey + 1, true, 1, false)
end
star(x - 40, ey - 20, 7); star(x + 40, ey - 14, 6)
elseif picked then
X.ctext(x, floor - 110, "empty!", "small", "bold")
end
end
function F.draw_pet_shared()
local s = S()
X.top_bar("Our pet", "")
local y = X.TOP + 6
if not smudge.pet then
X.wrapped(24, y + 40, "The shared pet needs the newest CardScape firmware on the reader (or use the phone app).", W - 48, "ui10", 4)
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("title") end, { font = "ui10" })
return
end
local p = smudge.pet()
if not p.setup or not p.exists then
X.wrapped(24, y + 10, p.setup and (p.reader and "Set up. The pet comes with the next sync: quit the game, or tap SYNC NOW." or "Connected. Hatch your pet in SET UP (only one of you does this), then you both see it here.")
or "One pet for the two of you: you both feed it, play with it and keep it clean, and see what the other did. Every day you both take care of it, you each get a pack ticket.", W - 48, "ui10", 6)
X.wrapped(24, y + 190, p.reader and "On the reader: set the pet up in the phone app first, then do one Wi-Fi sync (Settings > WI-FI SYNC); the app hands the pet to the reader."
or "You need a small private GitHub repository for the pet and a token for it (the app README explains it). Both phones use the same repository and token.", W - 48, "small", 5)
if p.status ~= "" then X.ctext(W / 2, y + 300, p.status, "small", "bold") end
if smudge.pet_setup then
X.button(24, y + 330, W - 48, 64, "SET UP", function() smudge.pet_setup() end, { font = "ui10", sub = "repository, token, names", id = "PETSETUP" })
elseif p.setup and smudge.cloud_sync then
X.button(24, y + 330, W - 48, 64, "SYNC NOW", function() smudge.cloud_sync() end, { font = "ui10", sub = "gets the pet", id = "PETSYNC" })
end
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("title") end, { font = "ui10" })
return
end
local newer = p.hour ~= nil
FUR.sync(p)
if light_want ~= nil then
local el = X.time() - light_at
if el > 20 or (light_want == "off") == ((p.sleepleft or 0) > 0) then light_want = nil
else p.sleepleft = (light_want == "off") and math.max(1, 36000 - el) or 0 end
end
local lights = p.sleepleft ~= nil
p.streak = p.streak or 0; p.lastwho = p.lastwho or ""; p.lastago = p.lastago or 0
local seen = smudge.load("petlvl", "")
local mark = p.level .. "," .. p.stage
if seen ~= mark then
local sl, ss = seen:match("^(%d+),(%-?%d+)$")
smudge.save("petlvl", mark)
if sl and (tonumber(ss) < p.stage) then fx("levelup", 3200, { text = p.stage == 1 and p.name .. " hatched!" or p.name .. " grew up!" }); say("Look at me now!", 3200)
elseif sl and tonumber(sl) < p.level then fx("levelup", 2600, { text = "Level " .. p.level .. "!" }) end
end
X.ctext(W / 2, y, p.name, "bitter14", "bold")
X.ctext(W / 2, y + 32, string.format("%s %s - level %d - %d day%s old%s", STAGES[p.stage], KINDS[p.kind] or "", p.level, p.age, p.age == 1 and "" or "s",
p.streak >= 2 and string.format(" - %d days together", p.streak) or ""), "small")
local sx, sy, sw, sh = 24, y + 54, W - 48, 290
local is3d = smooth() and not X.saver() and smudge.draw_sprite_quad ~= nil and smudge.fill_quad ~= nil and X.tilt ~= nil
local block_y = H - 356
if is3d then
local avail = block_y - 8 - sy
sh = math.max(260, math.min(400, avail))
sy = sy + math.max(0, (avail - sh) // 2)
end
local floor = sy + 256
local cx = W // 2
local ptop = floor - 172
room3d_setup(sx, sy, sw, sh)
if RP and smudge.set_clip then smudge.set_clip(0, sy - 6, W, sh + 10) end
room(p, sx, sy, sw, sh, cx, floor, seek ~= nil)
local pict3 = nil
YB.can = RP ~= nil and not seek and p.stage >= 1 and not asleep(p) and not FUR.deco and not p.busy
if not YB.can and YB.st ~= "rest" then YB.st = "rest"; YB.petx = 0 end
if RP and YB.can then
if YB.step(X.millis(), sw / 2, sh / 2, RD) == "got" then
hop_until = X.millis() + 700; fx("hearts", 1100); say(pick(LINES.play), 1600)
end
end
if RP then
local px, py, k = RP(YB.can and YB.petx or 0, sh / 2 - 22, RD * 0.42)
local kk = k
if asleep(p) and p.stage >= 1 and not seek and FUR.placed("bed") then
local x0, x1, _, z = FUR.spot("bed", sw / 2, sh / 2, RD)
px, py, k = RP((x0 + x1) / 2, sh / 2 - 24, z + 6)
kk = k * 0.62
end
pict3 = { ax = cx, ay = floor, tx = px, ty = py, k = kk, cx = cx, ptop = ptop }
cx, ptop, floor = math.floor(px), math.floor(py - (floor - ptop) * kk), math.floor(py)
end
if seek then
local sp = pict3 and math.floor(150 * pict3.k) or 136
local xs = { cx - sp, cx, cx + sp }
for k = 1, 3 do
draw_spot(k, xs[k], floor, seek.pick ~= nil and (k == seek.pick or k == seek.hide), k == seek.hide, pict3 and pict3.k or 1)
if not seek.pick then X.reg("SEEK" .. k, xs[k] - 56, floor - 110, 112, 112, function()
seek.pick = k; seek.t = X.millis()
if k == seek.hide then
local w = seek_state(p)
local msg = "You found " .. p.name .. "!"
if w < 3 then
local coins = 20 + 2 * p.level
X.add_coins(coins); smudge.save("petseek", p.day .. "|" .. (w + 1)); X.save_now()
msg = msg .. " +" .. coins .. " coins" .. (w + 1 == 3 and " (that's all coins for today)" or "")
end
if not p.busy then smudge.pet_do("play") end
wish_count(p, newer, "seek")
X.set_note(msg)
else
X.set_note(p.name .. " was hiding in the " .. SPOTS[seek.hide] .. "!")
end
if smooth() then X.after(1800, function()
if seek and seek.pick then local won = seek.pick == seek.hide; seek = nil; fx("found", 1200); say(won and "You found me!" or "Hehe, missed me!") end
end) end
end, true) end
end
if seek.pick then
X.ctext(cx, sy + 14, seek.pick == seek.hide and "Found!" or "Not there...", "ui10", "bold")
X.reg("SEEKDONE", sx, sy, sw, sh, function()
local won = seek.pick == seek.hide
seek = nil; fx("found", 1200); say(won and "You found me!" or "Hehe, missed me!")
end, true)
else
X.ctext(cx, sy + 14, "Where is " .. p.name .. "? Tap a hiding spot.", "small", "bold")
end
else
local ball_behind = YB.can and YB.st ~= "hold" and YB.z > RD * 0.42 and YB.st ~= "fetched"
if ball_behind then YB.draw(sw / 2, sh / 2, RD) end
if pict3 then PICT = pict3; draw_pet(p, pict3.cx, pict3.ptop + 88); PICT = nil else draw_pet(p, cx, ptop + 88) end
if YB.can and not ball_behind then YB.draw(sw / 2, sh / 2, RD) end
if asleep(p) and p.stage >= 1 then
local zt = smooth() and (X.millis() // 600) % 3 or 2
for k = 0, zt do X.ltext(cx + 60 + k * 16, ptop + 40 - k * 16, k == 2 and "Z" or "z", k == 2 and "ui12" or "ui10", "bold") end
end
local text = (not asleep(p) and X.millis() < say_until and say_text) or pet_says(p)
if not FUR.deco then bubble(text, cx, sy + 8) end
draw_fx(cx, ptop, floor)
if not FUR.deco then X.reg("PETTAP", cx - 80, ptop + 40, 160, 130, function()
if p.stage == 0 then hop_until = X.millis() + 700; say("(something moves inside...)"); fx("found", 900); return end
if asleep(p) then say("Zzz... (shh, it's sleeping)"); return end
hop_until = X.millis() + 700; fx("hearts", 1200); say(pick(LINES.tap), 1800)
end, true) end
end
if lights then
local dark = asleep(p) and not seek
if dark and not (RP and smudge.shade_quad) then smudge.invert_rect(sx + 3, sy + 3, sw - 6, sh - 6) end
local lx, ly = sx + sw - 110, sy + 40
if RP then
local a, b = sw / 2, sh / 2
local x0, y0, k = RP(a - 62, -b + 54, RD)
local x1, y1 = RP(a - 22, -b + 118, RD)
local sn = "art/" .. (dark and "room_switch_off" or "room_switch_on")
smudge.draw_sprite_quad(sn .. ".raw", 40, 64, x0, y0, x1, y0, x1, y1, x0, y1, sn .. "_m.raw")
lx, ly = math.floor((x0 + x1) / 2) - 20, math.floor(y0)
X.ctext(lx + 20, math.floor(y1) + 2, dark and "OFF" or "ON", "small", "bold", dark)
else
pic(lx, ly, 40, 64, dark and "room_switch_off" or "room_switch_on")
X.ctext(lx + 20, ly + 66, dark and "OFF" or "ON", "small", "bold", dark)
end
X.reg("PETLIGHT", lx - 10, ly - 8, 60, 96, function()
if p.busy then return end
seek = nil
local off = not asleep(p)
light_want, light_at = off and "off" or "on", X.time()
smudge.pet_do(off and "lightoff" or "lighton")
if off then X.set_note("Lights off. " .. p.name .. " sleeps for 10 hours. Sweet dreams!")
else X.set_note("Lights on: " .. p.name .. " is awake.") end
end, true)
if dark then
local t = "Sleeping  " .. hms(p.sleepleft)
local tw = X.tw(t, "ui10", "bold") + 28
smudge.rounded_rect(cx - tw // 2, sy + sh - 44, tw, 34, 12, true, 1, false)
smudge.rounded_rect(cx - tw // 2, sy + sh - 44, tw, 34, 12, false, 2)
X.ctext(cx, sy + sh - 40, t, "ui10", "bold")
if not smooth() then X.after(1000, function() if X.scr() == "ourpet" then X.redraw() end end) end
end
end
if RP then room3d_front(sx, sy, sw, sh); if smudge.set_clip then smudge.set_clip() end end
if FUR.deco then
local t = FUR.get()
local hdr = "Tap a piece: buy it, put it in or away"
local hw0 = X.tw(hdr, "small", "bold") + 20
smudge.rounded_rect(W // 2 - hw0 // 2, sy + 6, hw0, 26, 10, true, 1, false); smudge.rounded_rect(W // 2 - hw0 // 2, sy + 6, hw0, 26, 10, false, 2)
X.ctext(W // 2, sy + 8, hdr, "small", "bold")
for _, f in ipairs(FUR.list) do
local bx = FUR.boxes[f.id]
if bx then
local lab = (t[f.id] == 1) and "PUT AWAY" or ((t[f.id] == 0) and "PUT IN" or (f.price .. " coins"))
local tw = X.tw(lab, "small", "bold") + 14
local tx, ty = math.floor(bx[1] + bx[3] / 2 - tw / 2), math.max(sy + 36, bx[2] - 26)
tx = math.max(sx + 4, math.min(sx + sw - tw - 4, tx))
smudge.rounded_rect(tx, ty, tw, 22, 8, true, 1, false); smudge.rounded_rect(tx, ty, tw, 22, 8, false, 2)
X.ctext(tx + tw // 2, ty + 1, lab, "small", "bold")
X.reg("FUR" .. f.id, math.min(tx, bx[1]), ty, math.max(tw, bx[3]), bx[2] + bx[4] - ty, function() FUR.tap(f, s, p) end, true)
end
end
elseif YB.can and YB.st == "rest" and not seek and (smudge.load("petyarn", "") or "") == "" and YB.sx then
X.ctext(math.floor(YB.sx), math.floor(YB.sy) - 44, "throw me!", "small", "bold")
end
local by = is3d and math.max(sy + sh + 8, block_y) or (sy + sh + 8)
local bw3 = (W - 48 - 24) // 3
minibar(24, by, bw3, "Food", p.food, "food")
minibar(36 + bw3, by, bw3, "Fun", p.fun, "fun")
minibar(48 + 2 * bw3, by, bw3, "Clean", p.clean, "clean")
by = by + 42
local food = X.food_in_bank and X.food_in_bank()
local bw = (W - 48 - 4 * 6) // 5
local acts = { { "FEED", "feed" }, { "PLAY", "play" }, { "CLEAN", "clean" }, { "PET", "pet" }, { "TREAT", "treat" } }
if not newer then acts[5] = nil; bw = (W - 48 - 3 * 6) // 4 end
for k, a in ipairs(acts) do
local sleeping = lights and asleep(p)
X.button(24 + (k - 1) * (bw + 6), by, bw, 48, a[1], function()
if sleeping then X.set_note(p.name .. " is asleep. Switch the light on to wake it up."); return end
seek = nil; care(p, s, a[2], newer)
end, { font = "small", off = p.busy or sleeping or (a[2] == "treat" and not food), id = "PET" .. a[1] })
end
local ry = by + 54
local hw = (W - 48 - 10) // 2
local w = wish_of(p, newer)
local wn, wc = wish_state(p)
local wdone = w and wn >= w[2]
local wcoins = 80 + 15 * p.level
X.button(24, ry, hw, 48, wc and "WISH DONE" or (wdone and "WISH COME TRUE!" or string.format("WISH %d/%d", math.min(wn, w[2]), w[2])), function()
if wc then X.set_note(p.name .. " has a new wish tomorrow."); return end
if not wdone then X.set_note(p.name .. "'s wish for you today: " .. w[3] .. "."); return end
smudge.save("petwish", p.day .. "|" .. wn .. "|1")
X.add_coins(wcoins)
local msg = "Wish come true: +" .. wcoins .. " coins"
if X.rnd(1, 5) == 1 then s.camp.tickets = s.camp.tickets + 1; msg = msg .. " and a pack ticket" end
X.save_now(); X.set_note(msg .. "!"); fx("treat", 1500); hop_until = X.millis() + 700
end, { font = "small", sub = wc and "tomorrow again" or (wdone and ("+" .. wcoins .. " coins") or w[3]), off = wc, id = "PETWISH" })
local sw_ = seek_state(p)
X.button(34 + hw, ry, hw, 48, "HIDE & SEEK", function()
if p.stage == 0 then X.set_note("An egg can't hide yet. Hatch it first!"); return end
if asleep(p) then X.set_note(p.name .. " is asleep." .. (lights and " Switch the light on first." or " Play hide and seek in the daytime.")); return end
if seek then seek = nil; return end
seek = { hide = X.rnd(1, 3) }
end, { font = "small", sub = seek and "stop" or (sw_ < 3 and ("find it: +" .. (20 + 2 * p.level) .. "c") or "just for fun"), id = "PETSEEK", off = p.stage == 0 })
ry = ry + 54
local claimed = smudge.load("petday", "") == p.day
local mile, mile_ok = next_mile(p)
if p.together and not claimed then
X.button(24, ry, hw, 48, "TOGETHER", function()
smudge.save("petday", p.day); s.camp.tickets = s.camp.tickets + 1; X.save_now()
X.set_note("You both took care of " .. p.name .. " today: +1 pack ticket!"); fx("hearts", 1400)
end, { font = "small", sub = "+1 pack ticket", id = "PETBONUS" })
elseif mile and mile_ok then
X.button(24, ry, hw, 48, mile[1] .. " DAYS!", function()
mile[3](s); smudge.save("petstreak", tostring(mile[1])); X.save_now()
X.set_note(mile[1] .. " days in a row together: " .. mile[2] .. "!"); fx("levelup", 2600, { text = mile[1] .. " days together!" })
end, { font = "small", sub = mile[2], id = "PETSTREAK" })
else
X.button(24, ry, hw, 48, "TOGETHER", function()
X.set_note(p.together and ("Come back tomorrow" .. (mile and (": " .. mile[1] .. " days in a row gives " .. mile[2]) or "") .. ".")
or ("Take care of " .. p.name .. " today, you and " .. (p.partner ~= "" and p.partner or "your friend") .. ": +1 pack ticket each."))
end, { font = "small", sub = p.together and "done today" or "both care today", off = true, id = "PETBONUS" })
end
local gift_today = smudge.load("petgift", "") == p.day
local happy = math.min(p.food, p.fun, p.clean) >= 60 and p.stage >= 1
X.button(34 + hw, ry, hw, 48, "GIFT", function()
if gift_today then X.set_note(p.name .. " brings you a gift once a day."); return end
if not happy then X.set_note("A happy " .. p.name .. " (everything over 60%) brings you a gift once a day."); return end
smudge.save("petgift", p.day)
local coins = 50 + 10 * p.level
local msg = p.name .. " found " .. coins .. " coins for you"
X.add_coins(coins)
if X.rnd(1, 10) == 1 then s.camp.tickets = s.camp.tickets + 1; msg = msg .. " and a pack ticket" end
hop_until = X.millis() + 700; fx("found", 1300); say("I found this for you!")
X.save_now(); X.set_note(msg .. "!")
end, { font = "small", sub = gift_today and "tomorrow again" or (happy and "it found something!" or "when it's happy"), off = gift_today or not happy, id = "PETGIFT" })
local ly = ry + 56
if #p.log >= 1 then X.ltext(24, ly, X.fit(p.log[1], W - 48, "small", "regular"), "small") end
if p.reader and smudge.cloud_sync then
X.button(24, H - 152, W - 48, 46, p.status ~= "" and p.status or "SYNC NOW", function() smudge.cloud_sync() end,
{ font = "small", sub = "tap to sync now", id = "PETSYNC" })
elseif p.status ~= "" then X.ctext(W / 2, H - 126, p.status, "small", "bold") end
local bw2 = (W - 48 - 10) // 2
X.button(24, H - 96, bw2, 64, "BACK", function() seek = nil; FUR.deco = false; X.go("title") end, { font = "ui10" })
X.button(34 + bw2, H - 96, bw2, 64, FUR.deco and "DONE" or "DECORATE", function()
FUR.deco = not FUR.deco; seek = nil
end, { font = "ui10", sub = FUR.deco and "back to the pet" or "bed, shelf, lamp", id = "PETDECO" })
end
local away = nil
F.check_away = function(last)
local lines = {}
local bw = F.bookworm_claim()
if bw then lines[#lines + 1] = { bw, function() X.go("packs") end } end
local t = X.time()
if last and last > 1500000000 and t - last >= 15 * 60 then
for _, n in ipairs(X.notes_since(last)) do lines[#lines + 1] = n end
end
if #lines == 0 then return false end
away = { secs = (last and last > 1500000000) and (t - last) or 0, lines = lines }
return true
end
local function dur(s)
if s >= 86400 then return (s // 86400) .. " d " .. ((s % 86400) // 3600) .. " h" end
if s >= 3600 then return (s // 3600) .. " h " .. ((s % 3600) // 60) .. " min" end
return (s // 60) .. " min"
end
function F.draw_away()
X.top_bar("Welcome back", "")
local y = X.TOP + 8
if not away then X.go("title"); return end
if away.secs > 0 then X.ctext(W / 2, y, "You were away for " .. dur(away.secs) .. ".", "ui10", "bold") end
X.ctext(W / 2, y + 30, "Tap a line to go there.", "small")
local rh = 64
local per = math.max(1, (H - 200 - (y + 62)) // rh)
for k = 1, math.min(per, #away.lines) do
local l = away.lines[k]
local by = y + 62 + (k - 1) * rh
X.button(24, by, W - 48, rh - 8, "", function() away = nil; l[2]() end, { id = "AWAY" .. k })
smudge.circle(44, by + (rh - 8) // 2, 6, true)
X.wrapped(60, by + 6, l[1], W - 100, "small", 2)
end
if #away.lines > per then X.ctext(W / 2, y + 62 + per * rh, "+" .. (#away.lines - per) .. " more in the notifications (tap the top bar)", "small") end
X.button(24, H - 96, W - 48, 64, "CONTINUE", function() away = nil; X.go("title") end, { font = "ui10", id = "AWAYOK" })
end
return F
end
grade.lua
8764
return function(X)
local GR = {}
local W, H = X.W, X.H
local DUR = 1800
local SLOTS = 3
local WORD = { "POOR", "GOOD", "VERY GOOD", "VG-EX", "EXCELLENT", "EX-MT", "NEAR MINT", "NM-MT", "MINT", "GEM MINT" }
local FIRST = { 4, 6, 9, 13, 17, 18, 15, 10, 6, 2 }
local UP = { 80, 70, 60, 50, 40, 32, 24, 15, 6 }
local grades, slots
local function S() return X.S() end
local function now() return X.time() end
local function save()
local t = {}
for c, g in pairs(grades) do t[#t + 1] = c .. ":" .. g end
table.sort(t)
smudge.save("grades", table.concat(t, ","))
local q = {}
for _, s in ipairs(slots) do q[#q + 1] = s[1] .. ":" .. s[2] end
smudge.save("grading", table.concat(q, ","))
end
local function roll(g)
if g <= 0 then
local r, a = X.rnd(1, 100), 0
for k, p in ipairs(FIRST) do a = a + p; if r <= a then return k end end
return 5
end
if g >= 10 then return 10 end
return (X.rnd(1, 100) <= UP[g]) and g + 1 or g
end
local function load()
grades, slots = {}, {}
for c, g in (smudge.load("grades", "") or ""):gmatch("(%d+):(%d+)") do grades[tonumber(c)] = math.max(1, math.min(10, tonumber(g))) end
for c, t in (smudge.load("grading", "") or ""):gmatch("(%d+):(%d+)") do slots[#slots + 1] = { tonumber(c), tonumber(t) } end
if smudge.load("gmig", "") == "" then
local n = 0
for v in (smudge.load("frames", "") or ""):gmatch("%d+") do
local c = tonumber(v)
if c and not grades[c] then grades[c] = math.max(7, roll(0)); n = n + 1 end
end
smudge.save("gmig", "1")
if n > 0 then save(); GR.migrated = n end
end
end
local function ensure()
if not grades then load() end
local t, fix = now(), false
for _, sl in ipairs(slots) do if sl[2] > t + DUR then sl[2] = t + DUR; fix = true end end
if fix then save() end
end
function GR.reload() grades = nil end
function GR.grade(c) ensure(); return grades[c] or 0 end
function GR.atk(c) return GR.grade(c) // 2 end
function GR.word(g) return WORD[g] or "" end
function GR.price(c) return 0 end
function GR.up_chance(c) local g = GR.grade(c); return g >= 10 and 0 or (g == 0 and 100 or UP[g]) end
function GR.list() ensure(); local t = {} for k, s in ipairs(slots) do t[k] = { s[1], s[2] } end return t end
GR.SLOTS = SLOTS
function GR.busy(c) ensure(); for _, s in ipairs(slots) do if s[1] == c then return s end end return nil end
function GR.ready_count() ensure(); local n = 0; for _, s in ipairs(slots) do if now() >= s[2] then n = n + 1 end end return n end
function GR.send(c)
ensure()
local s = S()
if not X.owned(c) then X.set_note("Find this card first."); return false end
if GR.busy(c) then X.set_note("This card is already away for grading."); return false end
if GR.grade(c) >= 10 then X.set_note(X.cname(c) .. " is already GEM MINT 10: it can't get better."); return false end
if #slots >= SLOTS then X.set_note("The grader takes " .. SLOTS .. " cards at a time. Collect one first."); return false end
local cp = s.camp
for k = 1, 2 do if cp.exp[k][1] == c then X.set_note(X.cname(c) .. " is on an expedition. Send it when it's back."); return false end end
for k = 1, 3 do if cp.x["w" .. k .. "c"] == c then X.set_note(X.cname(c) .. " is working (workers). Take it off first."); return false end end
local left = {}
for i = 1, 3 do if s.deck[i] == c then s.deck[i] = 0; left[#left + 1] = "your deck" end end
if cp.pet == c then cp.pet = 0; left[#left + 1] = "being your pet" end
slots[#slots + 1] = { c, now() + DUR }
save(); X.save_now()
X.set_note(X.cname(c) .. " is away for grading: back in 30 minutes." .. (#left > 0 and (" (It left " .. table.concat(left, " and ") .. ".)") or ""))
return true
end
function GR.break_case(c)
ensure()
local s = S()
if (grades[c] or 0) == 0 then X.set_note("This card isn't in a grading case."); return false end
if GR.busy(c) then X.set_note("It's away for grading right now."); return false end
local cp = s.camp
grades[c] = nil
save()
if s.spare[c] > 0 then
s.spare[c] = s.spare[c] - 1
X.set_note("Case broken: " .. X.cname(c) .. " is ungraded again. It cost 1 spare copy.")
else
s.lvl[c] = 0; s.xp[c] = 0; s.shiny[c] = 0
for i = 1, 3 do if s.deck[i] == c then s.deck[i] = 0 end end
if cp.pet == c then cp.pet = 0 end
for k = 1, 3 do if cp.x["w" .. k .. "c"] == c then cp.x["w" .. k .. "c"] = 0 end end
X.set_note("Case broken: " .. X.cname(c) .. " is gone (no spares). Find it again in packs.")
end
X.save_now()
return true
end
function GR.collect(k)
ensure()
local sl = slots[k]
if not sl or now() < sl[2] then return end
table.remove(slots, k)
local c, old = sl[1], grades[sl[1]] or 0
local g = roll(old)
grades[c] = g
save(); X.save_now()
if old == 0 then X.set_note(string.format("%s is back: GRADE %d %s! (+%d ATK)", X.cname(c), g, WORD[g], g // 2))
elseif g > old then X.set_note(string.format("%s went up: GRADE %d %s! (+%d ATK)", X.cname(c), g, WORD[g], g // 2))
else X.set_note(string.format("%s stays GRADE %d %s. Try again?", X.cname(c), g, WORD[g])) end
GR.last = c
end
function GR.tick()
ensure()
if GR.migrated then local n = GR.migrated; GR.migrated = nil; return "Gold frames became card grading: " .. n .. " framed card" .. (n == 1 and "" or "s") .. " got a free grade (7 or better)." end
return nil
end
function GR.badge(x, y, c, big)
local g = GR.grade(c)
local away = GR.busy(c)
if g == 0 and not away then return end
local w, h = big and 46 or 30, big and 30 or 22
smudge.rounded_rect(x + 4, y + 4, w, h, 5, true)
smudge.rounded_rect(x + 5, y + 5, w - 2, h - 2, 4, false, 1, false)
X.ctext(x + 4 + w // 2, y + 4 + (h - X.lh(big and "ui12" or "small")) // 2, away and "..." or tostring(g), big and "ui12" or "small", "bold", true)
end
local gpage, gconf, gmode = 0, nil, "grade"
function GR.draw()
ensure()
local s = S()
X.top_bar("Card grading", "free")
local y = X.TOP + 4
local sw = (W - 48 - 2 * 8) // 3
for k = 1, SLOTS do
local sx = 24 + (k - 1) * (sw + 8)
smudge.rounded_rect(sx, y, sw, 150, 10, false, 2)
local sl = slots[k]
if sl then
X.thumb(sx + (sw - 108) // 2, y + 6, sl[1], {})
local left = sl[2] - now()
if left <= 0 then
X.button(sx + 6, y + 112, sw - 12, 34, "COLLECT", function() GR.collect(k) end, { font = "small", id = "GCOL" .. k, nohelp = true })
else
X.ctext(sx + sw // 2, y + 120, string.format("%d:%02d", left // 60, left % 60), "ui10", "bold")
end
else
X.ctext(sx + sw // 2, y + 56, "empty", "small")
X.ctext(sx + sw // 2, y + 80, "tap a card", "small")
end
end
local hw = (W - 48 - 8) // 2
X.button(24, y + 154, hw, 34, "GRADE (free)", function() gmode = "grade"; gconf = nil end, { font = "small", active = gmode == "grade", id = "GMODE1", nohelp = true })
X.button(32 + hw, y + 154, hw, 34, "BREAK CASE", function() gmode = "break"; gconf = nil end, { font = "small", active = gmode == "break", id = "GMODE2", nohelp = true })
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
X.swipe_tabs(function() return gpage end, function(t) gpage = t; gconf = nil end, 0, 6)
local ty = y + 196
for i = 0, 6 do
X.button(6 + i * 67, ty, 63, 50, tabs[i + 1], function() if gpage == i then X.grid_flip("grading", i) end; gpage = i; gconf = nil end,
{ font = "small", sub = (function() local n, t = X.grid_count(i, function(c) return GR.grade(c) > 0 end); return n .. "/" .. t end)(),
active = (gpage == i), id = "GT" .. i })
end
local y0 = ty + 62
X.grid("grading", gpage, y0, 2, 162, function(c, x, yy)
X.thumb(x, yy, c, { name = false })
local own = X.owned(c)
local g = GR.grade(c)
local txt
if not own then txt = "not found"
elseif GR.busy(c) then txt = "away"
elseif gconf == c then txt = "TAP AGAIN"
elseif gmode == "break" then txt = g > 0 and ("break G" .. g) or "-"
elseif g >= 10 then txt = "GEM MINT"
elseif g > 0 then txt = "G" .. g .. "  " .. UP[g] .. "% up"
else txt = "send" end
X.ctext(x + 54, yy + 116, txt, "small", "bold")
X.reg("GRADE" .. c, x, yy, 108, 140, function()
if not own then X.set_note("Find this card first."); return end
if gmode == "break" then
if GR.grade(c) == 0 then X.set_note("Only a graded card has a case to break."); return end
if gconf ~= c then
gconf = c
if S().spare[c] > 0 then
X.set_note(string.format("Tap again to break the case of %s: its grade is gone and it costs 1 spare copy (you have %d).", X.cname(c), S().spare[c]))
else
X.set_note(string.format("WARNING: no spares! Breaking the case loses %s itself (back to not found). Tap again to break it.", X.cname(c)))
end
return
end
gconf = nil; GR.break_case(c); return
end
if gconf ~= c then
gconf = c
local g2 = GR.grade(c)
X.set_note(g2 == 0 and string.format("Tap again: send %s for grading (free, 30 minutes).", X.cname(c))
or string.format("Tap again: grade %s again (free, %d%% chance to go up from %d).", X.cname(c), GR.up_chance(c), g2))
return
end
gconf = nil; GR.send(c)
end, true)
end, H - 96 - 50)
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go("packs") end, { font = "ui10" })
end
return GR
end
grind.lua
25615
return function(X, K, C, ADV)
local G = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function I(id) return IDX[id] end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
local function hash01(a, b) local v = math.sin(a * 12.9898 + (b % 100003) * 78.233) * 43758.5453; return v - math.floor(v) end
local function kv_load(name)
local t = {}
for part in (smudge.load(name, "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then t[k] = tonumber(v) end
end
return t
end
local function kv_save(name, t)
local p = {}
for k, v in pairs(t) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
smudge.save(name, table.concat(p, ";"))
end
local M, U, A
function G.load() M = kv_load("mastery"); U = kv_load("upgrades"); A = kv_load("ascend") end
G.load()
local PET_CH = 3000
function G.pet_roll(S, si)
local cp = S.camp
if not I("pet" .. si) then return "" end
if ADV.owns(cp, "pet" .. si) then return G.R and G.R.mega_roll(S, si, PET_CH) or "" end
if not G.lucky(PET_CH) then return "" end
ADV.grant(cp, "pet" .. si)
cp.x.petn = cp.x.petn + 1
local n = ITEMS[I("pet" .. si)][1]
ADV.notify("New pet: " .. n .. "!", "colog")
return "  You feel like you're being followed... " .. n .. "!"
end
local MSTAR = { 200, 1000, 3000 }
local function mstars(n) local s = 0; for _, t in ipairs(MSTAR) do if n >= t then s = s + 1 end end return s end
G.mstars = mstars
local function mkey(si, gi) return "m" .. si .. "_" .. gi end
function G.mastery(si, gi) local n = M[mkey(si, gi)] or 0; return mstars(n), n end
local function mastery_add(key, name, n)
local before = mstars(M[key] or 0)
M[key] = (M[key] or 0) + n
local after = mstars(M[key])
kv_save("mastery", M)
if after > before then
ADV.notify(name .. " mastery star " .. after .. "/3! (+1 per action)", "skills")
return "  MASTERY STAR " .. after .. "!"
end
return ""
end
function G.on_gather(S, si, gi, item, n)
local cp = S.camp
local x = cp.x
local note = ""
local xm = 1
local st = mstars(M[mkey(si, gi)] or 0)
n = n + st
if x.goldn > 0 and x.goldsi == si and x.goldgi == gi then
n = n * 2; xm = 2
x.goldn = x.goldn - 1
note = note .. (x.goldn > 0 and ("  GOLDEN x2 (" .. x.goldn .. " left)") or "  The golden glow fades.")
elseif X.rnd(1, 50) == 1 then
x.goldsi, x.goldgi, x.goldn = si, gi, 10
note = note .. "  It turns GOLDEN! x2 for 10 actions"
end
local pb, pn = G.R.gather_bonus(si)
n = n + pb; note = note .. pn
note = note .. mastery_add(mkey(si, gi), ITEMS[item][1], n)
note = note .. G.pet_roll(S, si)
return n, xm, note
end
function G.on_harvest(S, crop, n)
local key = "c" .. crop
local st = mstars(M[key] or 0)
n = n + st + G.R.gather_bonus(10)
local note = mastery_add(key, ITEMS[K.CROPS[crop][8]][1], n) .. G.pet_roll(S, 10)
return n, note
end
function G.node_tag(cp, si, gi)
local st = mstars(M[mkey(si, gi)] or 0)
local t = (st > 0) and ("  " .. string.rep("*", st)) or ""
if cp.x.goldn > 0 and cp.x.goldsi == si and cp.x.goldgi == gi then t = t .. "  GOLD x" .. cp.x.goldn end
return t
end
local function best_node(cp, si)
local best
for gi, g in ipairs(K.GATHER[si]) do
if K.can_gather(cp, si, g) and (not g[8] or cp.inv[g[8]] > 0) then best = gi end
end
return best or 1
end
local function w_rate(c) return 1 + X.tier_of(c) end
local function w_pending(cp, k)
local x = cp.x
local c = x["w" .. k .. "c"]
if c == 0 then return 0, 0 end
local secs = math.min(8 * 3600, math.max(0, now() - x["w" .. k .. "t"]))
return fl(secs / 3600 * w_rate(c)), secs
end
local wslot = 1
function G.set_worker(S, c)
local x = S.camp.x
for k = 1, 3 do if k ~= wslot and x["w" .. k .. "c"] == c then X.set_note("That card already works."); return end end
x["w" .. wslot .. "c"] = c
if x["w" .. wslot .. "s"] == 0 then x["w" .. wslot .. "s"] = 1 end
x["w" .. wslot .. "t"] = now()
X.set_note(X.cname(c) .. " starts working.")
X.save_now()
end
local function w_collect(S, k)
local cp = S.camp
local x = cp.x
local n = w_pending(cp, k)
local si = x["w" .. k .. "s"]
if n <= 0 then X.set_note("Nothing gathered yet."); return end
local g = K.GATHER[si][best_node(cp, si)]
local used = ""
if g[8] then
if K.count_item(cp, g[8]) < 1 then X.set_note("Your worker needs a " .. ITEMS[g[8]][1]:lower() .. " (buy one in the SHOP or make it)."); return end
end
K.add_item(cp, g[4], n)
local xp = 0
x["w" .. k .. "t"] = now()
X.set_note(string.format("Collected %d %s (+%d xp)", n, ITEMS[g[4]][1], xp) .. used .. K.give_xp(S, si, xp))
X.save_now()
end
function G.workers_ready(cp)
local n = 0
for k = 1, 3 do local p, secs = w_pending(cp, k); if p > 0 and secs >= 8 * 3600 then n = n + 1 end end
return n
end
local STAR_SLOT = 3 * 3600
local function star_now()
local t = now()
local slot = t // STAR_SLOT
local start = slot * STAR_SLOT + fl(hash01(slot, 7) * 3600)
local size = 1 + fl(hash01(slot, 11) * 9)
if t >= start and t < start + 45 * 60 then return slot, size, start + 45 * 60 end
return nil, nil, start > t and start or ((slot + 1) * STAR_SLOT + fl(hash01(slot + 1, 7) * 3600))
end
G.star_now = star_now
local function star_state(cp)
local slot, size, t_end = star_now()
if not slot then return nil, t_end end
local x = cp.x
if x.starid ~= slot then x.starid = slot; x.starmined = size; x.starhp = 20 end
if x.starmined <= 0 then return nil, t_end end
return { slot = slot, layer = x.starmined, hp = x.starhp, ends = t_end }
end
G.star_state = star_state
local function star_mine(S)
local cp = S.camp
local st = star_state(cp)
if not st then X.set_note("No star right now."); return end
local need = st.layer * 10 - 9
if lvl(cp, 2) < need then X.set_note("This layer needs Mining " .. need .. "."); return end
local x = cp.x
local dust = 1 + ((lvl(cp, 2) >= need + 20) and 1 or 0)
x.stardust = x.stardust + dust
x.starhp = x.starhp - 1
local note = string.format("+%d stardust", dust) .. K.give_xp(S, 2, 15 * st.layer)
if x.starhp <= 0 then
x.starmined = x.starmined - 1; x.starhp = 20
note = note .. (x.starmined > 0 and ("  Layer " .. x.starmined .. " uncovered!") or "  The star crumbles to dust.")
end
X.set_note(note)
X.save_now()
end
local STAR_SHOP = {
{ "Prospector piece (+Mining xp)", 120, function(cp)
for k = 1, 4 do if not ADV.owns(cp, "pr" .. k) then ADV.grant(cp, "pr" .. k); return end end
X.add_dust(20)
end },
{ "Gem bag (rare ores)", 40, function(cp)
local ores = { "adam", "rstone", "dragon", "celes" }
for _ = 1, 3 do K.add_item(cp, I(ores[X.rnd(1, 4)]), 1) end
end },
{ "RARE pack ticket", 120, function(cp) cp.rtickets = cp.rtickets + 1 end },
{ "Star hat (+6 HP)", 150, function(cp) ADV.grant(cp, "sthat") end },
{ "Star robe (+10 HP)", 200, function(cp) ADV.grant(cp, "strobe") end },
{ "Celestial ring (+3/+6)", 400, function(cp) ADV.grant(cp, "cring") end },
}
G.STAR_SHOP = STAR_SHOP
local AREAS = {
{ "Forest", { 1, 4, 10 } }, { "Mines", { 2, 5 } }, { "Coast", { 3, 9 } },
{ "Arcane", { 8, 13, 15 } }, { "Workshop", { 6, 7, 16 } }, { "Wilderness", { 14, 11, 12 } },
}
local TIERS = { { "Easy", 15 }, { "Medium", 40 }, { "Hard", 70 }, { "Elite", 90 } }
local function dia_bit(a, t) return (a - 1) * 4 + t end
local function dia_done(cp, a, t) return (cp.x.dia // (2 ^ (dia_bit(a, t) - 1))) % 2 == 1 end
local function dia_ok(cp, a, t)
local need = TIERS[t][2]
for _, si in ipairs(AREAS[a][2]) do if lvl(cp, si) < need then return false end end
if a == 6 and cp.x.wk < ({ 1, 10, 30, 75 })[t] then return false end
if t > 1 and not dia_done(cp, a, t - 1) then return false end
return true
end
local function dia_claim(S, a, t)
local cp = S.camp
if dia_done(cp, a, t) or not dia_ok(cp, a, t) then return end
cp.x.dia = cp.x.dia + 2 ^ (dia_bit(a, t) - 1)
local coins, dust = 100 * t, 25 * t
X.add_coins(coins); X.add_dust(dust)
if t >= 3 then cp.rtickets = cp.rtickets + 1 end
X.set_note(string.format("%s %s diary done! +%d coins, +%d dust%s.", AREAS[a][1], TIERS[t][1], coins, dust,
t >= 3 and ", RARE ticket" or ""))
X.save_now()
end
function G.xp_bonus(cp, si)
if not cp.x then return 0 end
local m = 0
for a, ar in ipairs(AREAS) do
for _, s in ipairs(ar[2]) do
if s == si then for t = 1, 4 do if dia_done(cp, a, t) then m = m + ((t == 4) and 0.10 or 0.05) end end end
end
end
return m
end
function G.dia_ready(cp)
local n = 0
for a = 1, #AREAS do for t = 1, 4 do if not dia_done(cp, a, t) and dia_ok(cp, a, t) then n = n + 1 end end end
return n
end
local DC = {
{ "Gather %d times", function(S) return S.camp.stat[1] end, { 25, 40, 60 } },
{ "Win %d fights", function(S) return X.wins() end, { 3, 5, 8 } },
{ "Make %d items", function(S) return S.camp.stat[2] end, { 8, 15, 25 } },
{ "Sell at the market %d times", function(S) return S.camp.x.msells end, { 2, 4, 6 } },
{ "Open %d packs", function(S) return X.stat("packs") end, { 2, 4, 6 } },
{ "Harvest %d crops", function(S) return S.camp.stat[3] end, { 1, 2, 3 } },
}
local function today() return now() // 86400 end
local function dc_roll(S)
local cp = S.camp
local x = cp.x
if x.dcd == today() then return end
x.dcd = today(); x.dcc = 0
local pool = {}
for i = 1, #DC do pool[i] = i end
for k = 1, 3 do
local tp = table.remove(pool, X.rnd(1, #pool))
x["dc" .. k] = tp
x["dct" .. k] = DC[tp][3][X.rnd(1, 3)]
x["dcb" .. k] = DC[tp][2](S)
end
end
local function dc_prog(S, k)
local x = S.camp.x
local tp = x["dc" .. k]
if tp == 0 then return 0, 1 end
return math.min(x["dct" .. k], DC[tp][2](S) - x["dcb" .. k]), x["dct" .. k]
end
local function dc_all(S) for k = 1, 3 do local p, t = dc_prog(S, k); if p < t then return false end end return true end
function G.dc_ready(S) dc_roll(S); return (S.camp.x.dcc == 0 and dc_all(S)) and 1 or 0 end
local function dc_claim(S)
local cp = S.camp
local x = cp.x
dc_roll(S)
if x.dcc == 1 or not dc_all(S) then return end
x.dcc = 1
x.dcs = (x.dcl == today() - 1) and (x.dcs + 1) or 1
x.dcl = today()
local coins = 60 + 20 * math.min(x.dcs, 10)
X.add_coins(coins); X.add_dust(15)
local extra = ""
if x.dcs % 30 == 0 then cp.rtickets = cp.rtickets + 3; extra = " +3 RARE tickets!"
elseif x.dcs % 14 == 0 then cp.rtickets = cp.rtickets + 1; extra = " +RARE ticket!"
elseif x.dcs % 7 == 0 then cp.tickets = cp.tickets + 2; extra = " +2 tickets!" end
extra = extra .. G.R.on_challenge(S)
X.set_note(string.format("Challenge chest: %d coins, 15 dust. Streak %d.%s", coins, x.dcs, extra))
X.save_now()
end
function C.asc(c) return A["c" .. c] or 0 end
function C.asc_bonus(c) local s = A["c" .. c] or 0; return 2 * s, 5 * s end
function C.asc_cost(c)
local s = (A["c" .. c] or 0) + 1
return 40 * s * (X.tier_of(c) + 1), s, s
end
function C.ascend(S, c)
local s = C.asc(c)
if s >= 5 then X.set_note("Already 5 ascension stars."); return end
local dust, spares, scales = C.asc_cost(c)
local cp = S.camp
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
if S.spare[c] < spares then X.set_note("Need " .. spares .. " spare copies."); return end
if cp.inv[I("scale")] < scales then X.set_note("Need " .. scales .. " Boss scales (Tower / quest bosses)."); return end
S.dust = S.dust - dust; S.spare[c] = S.spare[c] - spares; cp.inv[I("scale")] = cp.inv[I("scale")] - scales
A["c" .. c] = s + 1
kv_save("ascend", A)
X.set_note(X.cname(c) .. " ascends to star " .. (s + 1) .. "! +2 ATK +5 HP")
X.save_now()
end
local UP_CH = { 100, 100, 100, 85, 75, 65, 55, 45, 35, 25 }
local UP_BAR = { "ibar", "ibar", "ibar", "sbar", "sbar", "mbar", "mbar", "abar", "rbar", "rbar" }
function G.upg(i) return U["i" .. i] or 0 end
function G.upg_bonus(cp)
local a, h = 0, 0
for k = 1, 5 do
local i = cp.eq[k] or 0
if i > 0 then
local L = U["i" .. i] or 0
if k == 1 then a = a + L elseif k == 2 or k == 3 then h = h + 3 * L else a = a + fl(L / 2 + 0.5); h = h + L end
end
end
return a, h
end
function G.upgrade(S, i)
local cp = S.camp
local L = U["i" .. i] or 0
if L >= 10 then X.set_note("Already +10."); return end
local bar, dust = I(UP_BAR[L + 1]), 10 * (L + 1)
if cp.inv[bar] < 2 then X.set_note("Need 2 " .. ITEMS[bar][1] .. "."); return end
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
cp.inv[bar] = cp.inv[bar] - 2; S.dust = S.dust - dust
if X.rnd(1, 100) <= UP_CH[L + 1] then
U["i" .. i] = L + 1; kv_save("upgrades", U)
X.set_note(ITEMS[i][1] .. " is now +" .. (L + 1) .. "!")
else
X.set_note("The upgrade failed... materials lost (" .. UP_CH[L + 1] .. "% chance).")
end
X.save_now()
end
function G.upg_cost_text(i)
local L = U["i" .. i] or 0
if L >= 10 then return "MAX +10" end
return string.format("2 %s, %d dust, %d%%", ITEMS[I(UP_BAR[L + 1])][1], 10 * (L + 1), UP_CH[L + 1])
end
local WB_SLOT, WB_UP, WB_HP = 5400, 1800, 900
local WBOSS = {
{ "Quill Behemoth", 1, 25, "wb1" }, { "Bandit King", 5, 29, "wb2" }, { "Totem Lord", 3, 27, "wb3" }, { "Thunder Rooster", 4, 28, "wb4" },
}
G.WBOSS = WBOSS
local function wb_now()
local t = now()
local slot = t // WB_SLOT
local up = t - slot * WB_SLOT < WB_UP
return slot, up, up and (slot * WB_SLOT + WB_UP) or ((slot + 1) * WB_SLOT), WBOSS[slot % #WBOSS + 1]
end
G.wb_now = wb_now
local function wb_state(cp)
local slot, up, t_next, boss = wb_now()
local x = cp.x
if x.wbslot ~= slot then
x.wbslot = slot; x.wbdmg = 0
x.wbmax = 200 + 35 * ADV.CB.stats(cp).clvl
x.wbhp = x.wbmax
end
return slot, up and x.wbhp > 0, t_next, boss
end
local boss_frame
boss_frame = function(x, y, sz, c, art)
smudge.draw_sprite(x, y, sz, sz, art or string.format("art/l%02d.raw", c - 1))
smudge.rect(x - 6, y - 6, sz + 12, sz + 12, false, 4)
smudge.rect(x - 12, y - 12, sz + 24, sz + 24, false, 2)
for _, p in ipairs({ { x - 12, y - 12, 1, 1 }, { x + sz + 12, y - 12, -1, 1 }, { x - 12, y + sz + 12, 1, -1 }, { x + sz + 12, y + sz + 12, -1, -1 } }) do
local px, py, dx, dy = p[1], p[2], p[3], p[4]
smudge.triangle(px, py, px + dx * 26, py, px, py + dy * 26, true)
smudge.triangle(px - dx * 8, py - dy * 8, px + dx * 6, py, px, py + dy * 6, true)
end
for k = 0, 3 do
local t = fl((k + 1) * sz / 5)
smudge.circle(x - 9, y + t, 3, true); smudge.circle(x + sz + 9, y + t, 3, true)
end
smudge.rounded_rect(x + sz // 2 - 40, y - 24, 80, 24, 6, true)
X.ctext(x + sz // 2, y - 22, "BOSS", "small", "bold", true)
end
G.boss_frame = boss_frame
function G.wb_info(cp) local slot, alive, t_next, boss = wb_state(cp); return slot, alive, t_next, boss, slot % #WBOSS + 1 end
function G.wb_kill(S)
local cp = S.camp
local x = cp.x
local boss = WBOSS[x.wbslot % #WBOSS + 1]
x.wbkills = x.wbkills + 1
x.wbbest = math.max(x.wbbest, x.wbdmg)
local coins = 250 + fl(x.wbdmg / 5)
X.add_coins(coins); X.add_dust(60)
cp.rtickets = cp.rtickets + 1
local t = string.format("%s is DEFEATED! +%d coins, 60 dust, RARE ticket", boss[1], coins)
t = t .. G.R.on_wb_kill(S, x.wbslot % #WBOSS + 1)
if G.lucky(8) then ADV.grant(cp, boss[4]); t = t .. "  UNIQUE: " .. ITEMS[I(boss[4])][1] .. "!" end
if ADV.drop_clue(cp, 3, 3) then t = t .. "  Hard clue!" end
X.set_note(t)
return t
end
function G.check(S)
local cp = S.camp
local x = cp.x
local slot, alive, _, boss = wb_state(cp)
if alive and x.nwb ~= slot then x.nwb = slot; ADV.notify("World boss " .. boss[1] .. " has spawned! 30 minutes left.", "worldboss") end
local st = star_state(cp)
if st and x.nstar ~= st.slot then x.nstar = st.slot; ADV.notify("A shooting star (layer " .. st.layer .. ") has landed!", "star") end
for k = 1, 3 do
local p, secs = w_pending(cp, k)
local key = "w" .. k .. "t"
if p > 0 and secs >= 8 * 3600 and G["wn" .. k] ~= x[key] then G["wn" .. k] = x[key]; ADV.notify("Worker " .. k .. " is full (8 h). Collect!", "workers") end
end
G.R.check(S)
if G.WO then G.WO.check(S) end
end
function G.badges(S)
local cp = S.camp
local _, alive = wb_state(cp)
local rb = G.R.badges(S)
return { wb = alive and 1 or 0, star = star_state(cp) and 1 or 0, workers = G.workers_ready(cp), dia = G.dia_ready(cp), dc = G.dc_ready(S),
loot = rb.loot, perks = rb.perks }
end
G.SCR = { "worldboss", "star", "starshop", "workers", "diary", "challenges" }
G.PARENT = { worldboss = "adventure", star = "adventure", starshop = "star", workers = "camp", diary = "rewards", challenges = "rewards" }
function C.draw_worldboss(S)
local cp = S.camp
local slot, alive, t_next, boss = wb_state(cp)
head(S, "World boss", "every 1.5 h")
local y = TOPY() + 6
panel(20, y, W - 40, 262)
local bi = slot % #WBOSS + 1
boss_frame(32, y + 40, 192, boss[3], string.format("art/m%02d.raw", 17 + bi))
X.ltext(246, y + 14, boss[1], "ui12", "bold")
X.ltext(246, y + 46, "Weak to " .. ((ADV.CB.WB_WEAK[bi] == 1) and "MELEE" or "RANGED"), "small", "bold")
if alive then
X.ltext(246, y + 74, "Leaves in " .. K.mmss(t_next - now()), "small", "bold")
X.bar(246, y + 110, W - 280, 18, cp.x.wbhp / math.max(1, cp.x.wbmax))
X.ltext(246, y + 134, string.format("HP %d / %d", cp.x.wbhp, cp.x.wbmax), "small", "bold")
X.ltext(246, y + 158, "Your damage: " .. cp.x.wbdmg, "small")
else
X.ltext(246, y + 74, cp.x.wbhp <= 0 and "Defeated!" or "Not here", "ui10", "bold")
X.ltext(246, y + 104, "Next in " .. K.mmss(t_next - now()), "small", "bold")
X.ltext(246, y + 134, "Kills " .. cp.x.wbkills, "small")
X.ltext(246, y + 156, "Best dmg " .. cp.x.wbbest, "small")
end
local c = G.combat(cp)
X.wrapped(30, y + 270, string.format("You fight it yourself: combat level %d, HP %d, melee max %d, ranged max %d. Kill it within 30 minutes for coins, dust, a RARE ticket and a 1 in 8 unique.", c.clvl, c.hp, c.mmax, c.rmax), W - 60, "small", 4)
local tw = (W - 48 - 16) // 3
X.button(24, y + 356, tw, 70, "FIGHT", function() ADV.CB.wb_fight(S) end, { off = not alive, id = "WBFIGHT", dot = alive and "!" or nil })
X.button(32 + tw, y + 356, tw, 70, "ARMOURY", function() C.arm_back = "worldboss"; X.go("armoury") end, { font = "ui10", sub = "weapons", id = "ARMOURY" })
X.button(40 + 2 * tw, y + 356, tw, 70, "DROPS", function() ADV.show_drops(ADV.CB.drops_wb(cp, bi)) end, { font = "ui10", sub = "chances", id = "WBDROPS", nohelp = true })
back_btn("adventure")
end
function C.draw_star(S)
local cp = S.camp
local st, t_next = star_state(cp)
head(S, "Shooting star", cp.x.stardust .. " dust")
local y = TOPY() + 6
panel(20, y, W - 40, 220)
local cx, cy = W // 2, y + 90
if st then
local f = (st.hp > 12) and 0 or ((st.hp > 4) and 2 or 3)
local smooth = X.smooth and X.smooth()
if f == 0 and smooth and (X.millis() // 700) % 2 == 1 then f = 1 end
local dx = (smooth and X.millis() < (G.star_hit or 0)) and fl(math.sin(X.millis() / 25) * 5) or 0
smudge.draw_sprite(cx - 68 + dx, y + 8, 136, 136, "art/star_" .. f .. ".raw")
smudge.circle(cx + 66, y + 26, 18, true)
X.ctext(cx + 66, y + 26 - X.lh("ui10") // 2, tostring(st.layer), "ui10", "bold", true)
X.ctext(W / 2, y + 160, string.format("Layer %d  (Mining %d)   %d/20 left", st.layer, st.layer * 10 - 9, st.hp), "ui10", "bold")
X.ctext(W / 2, y + 188, "Gone in " .. K.mmss(st.ends - now()), "small")
else
smudge.draw_sprite(cx - 68, y + 4, 136, 136, "art/star_3.raw")
X.ctext(W / 2, y + 150, "No star right now.", "ui10", "bold")
X.ctext(W / 2, y + 178, "Next star in " .. K.mmss(t_next - now()), "small")
end
X.button(24, y + 232, W - 48, 70, "MINE", function() G.star_hit = X.millis() + 220; star_mine(S) end, { off = not st, id = "STARMINE" })
X.button(24, y + 310, W - 48, 60, "STARDUST SHOP", function() X.go("starshop") end, { font = "ui10", id = "STARSHOP" })
back_btn("adventure")
end
function C.draw_starshop(S)
local cp = S.camp
head(S, "Stardust shop", cp.x.stardust .. " dust")
local y0 = TOPY() + 4
local sp = rows_sp(y0, #STAR_SHOP, 76)
