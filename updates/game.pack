do
local st, sb = TOP + 52 + 5 * 88 + 34, H - 108
if sb - st >= 120 and GFX and GFX.shopscene then
local cd
for k = 1, 5 do
local o = offers[k]
if o and o.kind ~= "item" and o.c and (cp.shopm >> (k - 1)) & 1 == 0 then cd = o.c end
end
local bh = math.min(240, sb - st)
GFX.shopscene(st + (sb - st - bh) // 2, bh, cd)
end
end
back_btn("camp")
end
