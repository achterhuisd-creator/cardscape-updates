local function reveal_tag(r)
local c = r.c
local pre = r.shiny and "SHINY! " or ""
if r.new then return pre .. "NEW CARD!" end
if S.lvl[c] >= D.max_level then return pre .. "Spare copy - max level" end
return pre .. string.format("Spare copy added (x%d)", S.spare[c])
end
pack_art = function(cx, cy, c)
local f = (c >= 1) and 3 or ((c <= 0) and 0 or ((c < 0.5) and 1 or 2))
smudge.draw_sprite(cx - 116, cy - 156, 232, 312, "art/pack_" .. f .. ".raw")
end
