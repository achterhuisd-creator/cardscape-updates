smudge.fill_quad(q[1] + sx, q[2] + sy, q[3] + sx, q[4] + sy, q[5] + sx, q[6] + sy, q[7] + sx, q[8] + sy, true)
local b = { Q(-hw, -hh, hw, hh, 5) }
smudge.fill_quad(b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], true, tk)
local f = { Q(-hw, -hh, hw, hh, 0) }
smudge.fill_quad(f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8], false, tk)
smudge.draw_sprite_quad("art/card_back.raw", 192, 256, f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8])
for k = 0, 3 do
local i, j = k * 2 + 1, ((k + 1) % 4) * 2 + 1
smudge.line(math.floor(f[i] + 0.5), math.floor(f[i + 1] + 0.5), math.floor(f[j] + 0.5), math.floor(f[j + 1] + 0.5), 2)
end
return
end
