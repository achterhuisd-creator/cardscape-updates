{ "Reels stopping", { "slot_stop1", "slot_stop2", "slot_stop3", "slot_stop" } }, { "Last reel waiting", { "slot_riser" } },
{ "So close", { "slot_nearmiss" } }, { "Winning line", { "slot_line" } }, { "Win counting up", { "slot_count" } },
{ "Small win", { "win_small" } }, { "Big win", { "win_big", "jackpot" } }, { "Star", { "slot_star" } },
{ "WILD", { "slot_wild" } }, { "Free spins", { "slot_fs" } }, { "Hold", { "slot_hold" } }, { "Nudge", { "slot_nudge" } },
{ "Bell bonus", { "slot_bonus" } }, { "Chest opens", { "slot_chest" } }, { "Gamble right, missions", { "slot_gwin" } },
{ "Gamble wrong", { "slot_glose" } }, { "Gamble card", { "flip" } }, { "Jackpot", { "slot_jackpot" } },
{ "Bets and coins", { "chip" } }, { "Buttons", { "click", "click_back" } } }
local VS = {}
