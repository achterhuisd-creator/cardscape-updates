local fl = math.floor
local SI = 1
local GATHER = H.GATHER[1]
local ITEMS = H.ITEMS
local PHONE = smudge.smooth == true
local function fx() return PHONE and GFX and GFX.ok and GFX.ok() end
local function hd() return fx() and smudge.hires_quad end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function vib(p) if VIB then VIB.play(p, true) end end
local function ms() return X.millis() end
local CH = { 5, 6, 7, 8, 9, 10, 12, 14 }
local LOGS = { 3, 3, 3, 4, 4, 4, 5, 5 }
local LEAF = { { 120, 170, 50, k = 2 }, { 90, 150, 40, k = 2 }, { 160, 200, 70, k = 2 }, { 230, 80, 30, k = 6 }, { 40, 90, 40, k = 2 },
{ 150, 90, 230, k = 5 }, { 240, 235, 200, k = 7 }, { 90, 150, 50, k = 2 } }
local PIC = {
{ 403, 500, 460, 270, 200, 207, 34 },
{ 401, 500, 460, 310, 210, 205, 50 },
{ 379, 500, 455, 280, 205, 214, 50 },
{ 409, 500, 465, 340, 207, 205, 50 },
{ 335, 500, 470, 335, 170, 168, 44 },
{ 412, 454, 435, 270, 183, 192, 60 },
