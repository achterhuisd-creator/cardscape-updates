for k = 0, NS - 1 do
local t0, t1 = k / NS, (k + 1) / NS
local dx = ((k * 7 + anim_v * 3) % 3 == 0) and (((k + anim_v) % 2 == 0) and 1 or -1) * (3 + 3 * anim_v) or 0
local q = { Q(x0 + dx, y0 + (y1 - y0) * t0, x1 + dx, y0 + (y1 - y0) * t1, z) }
smudge.draw_sprite_quad(key, w, h, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], nil, 0, t0, 1, t1)
end
end
local tk = (not SAVER) and card_tk() or 0
if o.back then
local sx, sy = (9 + o.ry * 34) * dp * SC, (13 - o.rx * 34) * dp * SC
