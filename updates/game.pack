if isel and isel.slot and slots[isel.slot] then
local i = slots[isel.slot][1]
local info = FOOD[i] and FOOD[i][3] or (EQL[i] and string.format("%s  +%d ATK  +%d HP", SLOTN[EQL[i][1]], EQL[i][2], EQL[i][3])) or "material"
X.ctext(W / 2, ay, X.fit(ITEMS[i][1] .. ": " .. info, W - 40, "small", "bold"), "small", "bold")
ay = ay + 26
local act, actf
if FOOD[i] and FOOD[i][1] == 6 then act = "DRINK"; actf = function() eat(S, i) end
elseif EQL[i] then act = "EQUIP"; actf = function() equip(S, i); isel = nil end end
local n = inv_n(i)
X.button(24, ay, bw, 52, act or "-", actf or function() end, { font = "ui10", off = not act, id = "IUSE" })
X.button(32 + bw, ay, bw, 52, "BANK", function() if deposit(S, i, stacks(i) and n or 1) > 0 then X.set_note("Put " .. ITEMS[i][1] .. " in the bank."); isel = nil end end, { font = "ui10", sub = "deposit 1", id = "IBANK" })
X.button(40 + 2 * bw, ay, bw, 52, drop_ok == 1 and "SURE?" or "DROP", function()
if drop_ok ~= 1 then drop_ok = 1; X.set_note("Tap DROP again to throw 1 " .. ITEMS[i][1] .. " away."); return end
inv_take(i, stacks(i) and n or 1); drop_ok = false; isel = nil; X.set_note("Dropped it."); X.save_now()
end, { font = "ui10", sub = "drop 1", active = drop_ok == 1, id = "IDROP" })
local hw2 = (W - 48 - 8) // 2
X.button(24, ay + 58, hw2, 46, "BANK ALL " .. n, function()
local m = deposit(S, i, n); if m > 0 then X.set_note(string.format("Put %d %s in the bank.", m, ITEMS[i][1])); isel = nil end
end, { font = "small", off = n < 1, id = "IBANKALL" })
X.button(32 + hw2, ay + 58, hw2, 46, drop_ok == 2 and "SURE? DROP " .. n or "DROP ALL " .. n, function()
if drop_ok ~= 2 then drop_ok = 2; X.set_note("Tap again to throw all " .. n .. " " .. ITEMS[i][1] .. " away."); return end
inv_take(i, n); drop_ok = false; isel = nil; X.set_note(string.format("Dropped %d %s.", n, ITEMS[i][1])); X.save_now()
end, { font = "small", active = drop_ok == 2, id = "IDROPALL" })
elseif isel and isel.worn and (cp.eq[isel.worn] or 0) > 0 then
local it = cp.eq[isel.worn]
local ul = ADV.G.upg(it)
X.ctext(W / 2, ay, X.fit(ITEMS[it][1] .. ((ul > 0) and (" +" .. ul) or "") .. string.format(":  +%d ATK  +%d HP", EQL[it][2], EQL[it][3]), W - 40, "small", "bold"), "small", "bold")
ay = ay + 26
X.button(24, ay, bw, 56, "REMOVE", function() unequip(S, isel.worn) end, { font = "ui10", id = "UNEQUIP" })
X.button(32 + bw, ay, 2 * bw + 8, 56, "UPGRADE +" .. (ul + 1), function() ADV.G.upgrade(S, it) end,
{ font = "small", sub = ADV.G.upg_cost_text(it), off = ul >= 10, id = "UPG" })
else
X.ctext(W / 2, ay + 8, inv_used() == 0 and "Empty. Take food, potions and gear from the BANK." or "Tap an item or a worn slot.", "small")
end
X.draw_note(ay - 30)
back_btn(C.ret.gear or "camp")
end
local MBUCK = 900
local MKT = {
{ "WOOD", { "log", "oak", "willow", "maple", "yew", "magic", "elder", "anc" } },
{ "ORE", { "copper", "iron", "coal", "mith", "adam", "rstone", "dragon", "celes" } },
{ "FISH", { "shrimp", "trout", "salmon", "sword", "lob", "shark", "manta", "levi" } },
{ "HUNT", { "fur", "feather", "hide", "tusk", "wolf", "bear", "drake", "plume" } },
{ "BAR", { "bbar", "ibar", "sbar", "mbar", "abar", "rbar", "dbar", "cbar" } },
{ "CROP", { "potato", "cabbage", "pumpkin", "star", "dfruit", "melon", "apple", "lotus" } },
{ "BOW", { "bow1", "bow2", "bow3", "bow4", "bow5", "bow6", "bow7", "bow8" } },
{ "GEAR", { "cap", "hat", "vest", "charm", "helm", "bvest", "mail", "pcharm" } },
{ "FOOD", { "stew", "pie", "roast", "feast", "lstew", "spie", "mroast", "dfeast" } },
}
for _, t in ipairs(MKT) do for k, id in ipairs(t[2]) do t[2][k] = IDX[id] end end
local function hash01(a, b)
local v = math.sin(a * 12.9898 + (b % 100003) * 78.233) * 43758.5453
return v - math.floor(v)
end
local function mkt_mult(i, b)
local m = 1 + 0.28 * math.sin(b * 6.2832 / (40 + (i % 7) * 9) + i * 1.7)
+ 0.14 * math.sin(b * 6.2832 / (11 + (i % 5) * 3) + i * 0.9)
+ 0.16 * (hash01(i, b) - 0.5)
local w = b // 8
local r = hash01(i + 777, w)
if r < 0.06 then m = m * 1.7 elseif r < 0.12 then m = m * 0.55 end
m = 1 + (m - 1) * (C.mkt_swing and C.mkt_swing() or 1)
return math.max(0.25, math.min(3, m))
end
local function mkt_bucket() return math.floor(now() / MBUCK) end
local function mkt_price(i, b) return math.max(1, fl(ITEMS[i][2] * mkt_mult(i, b or mkt_bucket()) + 0.5)) end
C.ATH = {}
C.mkt_alltime = function(i)
local nowb = mkt_bucket()
local a = C.ATH[i]
if not a then
local b0 = math.floor(1790812800 / MBUCK)
if b0 > nowb - 96 * 3 then b0 = nowb - 96 * 3 end
a = { last = b0 - 1, hi = -1, lo = math.huge, bhi = b0, blo = b0 }
C.ATH[i] = a
end
for b = a.last + 1, nowb do
local v = mkt_price(i, b)
if v > a.hi then a.hi = v; a.bhi = b end
if v < a.lo then a.lo = v; a.blo = b end
end
a.last = nowb
return a.hi, a.lo, (nowb - a.bhi) * MBUCK, (nowb - a.blo) * MBUCK
end
local MKT_ITEM = {}
for _, t in ipairs(MKT) do for _, i in ipairs(t[2]) do MKT_ITEM[i] = true end end
mkt_cap = function(i) if MKT_ITEM[i] then return mkt_price(i) end end
local function mkt_buy_price(S, i) return math.max(mkt_price(i) + 1, math.ceil(mkt_price(i) * 1.1)) end
local function pct(a, b) if b <= 0 then return 0 end return fl((a - b) * 100 / b + (a >= b and 0.5 or -0.5)) end
local function mkt_trade(S, i, n)
local cp = S.camp
if n > 0 then
if ADV.R.iron_block("buy from the Market") then return end
local p = mkt_buy_price(S, i)
n = math.min(n, C.bank_cap(cp) - cp.inv[i], S.coins // p)
if n <= 0 then X.set_note(cp.inv[i] >= C.bank_cap(cp) and "Your bank is full of that." or "Not enough coins."); return end
S.coins = S.coins - n * p; add_item(cp, i, n)
ADV.pf_buy(i, n, p)
X.set_note(string.format("Bought %d %s for %d coins.", n, ITEMS[i][1], n * p))
else
n = math.min(-n, cp.inv[i])
if n <= 0 then X.set_note("You have none to sell."); return end
local p = mkt_price(i)
local gain = ADV.pf_sell(cp, i, n, p)
cp.inv[i] = cp.inv[i] - n; X.add_coins(n * p); ADV.on_market_sell(S)
X.set_note(string.format("Sold %d %s for %d coins.", n, ITEMS[i][1], n * p) .. (gain and string.format(" Profit %s%dc.", gain >= 0 and "+" or "", gain) or ""))
end
X.save_now()
end
local function price_line(x, y, w, h, i, nb, step, thick, fill)
local b0 = mkt_bucket()
local p, lo, hi = {}, math.huge, 0
for k = 1, nb do
local v = ITEMS[i][2] * mkt_mult(i, b0 - (nb - k) * step)
p[k] = v; lo = math.min(lo, v); hi = math.max(hi, v)
end
if hi - lo < 0.01 then hi = lo + 1 end
local function px(k) return x + fl((k - 1) * (w - 1) / (nb - 1)) end
local function py(v) return y + h - 1 - fl((v - lo) * (h - 1) / (hi - lo)) end
if fill then
for k = 1, nb - 1 do
local x1, x2 = px(k), px(k + 1)
local top = math.max(py(p[k]), py(p[k + 1]))
if y + h - top > 1 then smudge.rect_dither(x1, top, x2 - x1 + 1, y + h - top, false) end
end
end
for k = 1, nb - 1 do smudge.line(px(k), py(p[k]), px(k + 1), py(p[k + 1]), thick) end
return p, lo, hi, px(nb), py(p[nb])
end
local function arrow(x, y, up)
if up then smudge.triangle(x, y + 12, x + 12, y + 12, x + 6, y + 2, true)
else smudge.triangle(x, y + 2, x + 12, y + 2, x + 6, y + 12, true) end
end
local SORTS = { "PRICE HIGH", "PRICE LOW", "RISING", "FALLING" }
local function draw_menu_icon(x, y)
for k = 0, 2 do smudge.rect(x, y + k * 8, 22, 4, true) end
end
function C.draw_market(S)
local cp = S.camp
head(S, "Market", "")
local ty = HUDY + 40
local b = mkt_bucket()
ADV.ge_fill(S)
X.swipe_tabs(function() return mtab end, function(t) mtab = t end, 0, #MKT - 1)
X.button(20, ty, 130, 48, MKT[mtab + 1][1], function() mdrawer = not mdrawer end, { font = "ui10", active = mdrawer, id = "MCATS" })
draw_menu_icon(28, ty + 14)
X.button(156, ty, 110, 48, SORTS[msort + 1], function() msort = (msort + 1) % #SORTS end, { font = "small", sub = "sort", id = "MSORT" })
X.button(272, ty, 104, 48, "MINE", function() X.go("portfolio") end, { font = "ui10", sub = "profit", id = "MINE" })
X.button(382, ty, W - 402, 48, "GE", function() X.go("geoffers") end, { font = "ui10", sub = ADV.ge_count(cp) .. "/3", id = "GE", dot = C.badges(S).market })
local y0 = ty + 56
local sp = math.min(66, (H - 96 - 8 - y0) // 8)
local rh = sp - 5
local rows = {}
for _, i in ipairs(MKT[mtab + 1][2]) do
local p = ITEMS[i][2] * mkt_mult(i, b)
rows[#rows + 1] = { i = i, p = p, ch = pct(mkt_price(i, b), mkt_price(i, b - 24)) }
end
table.sort(rows, function(u, v)
if msort == 0 then return u.p > v.p elseif msort == 1 then return u.p < v.p
elseif msort == 2 then return u.ch > v.ch end
return u.ch < v.ch
end)
for k, r in ipairs(rows) do
local i = r.i
local by = y0 + (k - 1) * sp
if mdrawer then panel(20, by, W - 40, rh)
else X.button(20, by, W - 40, rh, "", function() msel = i; mrange = 0; X.go("mktitem") end, { id = "MKT" .. k }) end
sprite(30, by + (rh - 24) // 2, 24, ITEMS[i][3])
X.ltext(62, by + 3, ITEMS[i][1], (#ITEMS[i][1] > 11) and "small" or "ui10", "bold")
X.ltext(62, by + rh - 24, "have " .. cp.inv[i], "small")
price_line(214, by + rh - 28, 100, 22, i, 24, 1, 1, false)
local now_p = mkt_price(i, b)
X.rtext(W - 30, by + 3, now_p .. "c", "ui10", "bold")
arrow(W - 92, by + rh - 20, r.ch >= 0)
X.rtext(W - 30, by + rh - 24, (r.ch >= 0 and "+" or "") .. r.ch .. "%", "small", "bold")
end
if mdrawer then
local dw, dy = 236, y0 - 6
local ds = math.min(56, (H - 96 - 8 - dy - 14) // 9)
local dh = 9 * ds + 14
smudge.rect_dither(dw, dy, W - dw, dh, false)
X.button(dw + 4, dy, W - dw - 4, dh, "", function() mdrawer = false end, { id = "MCLOSE" })
do
local ix, iw = dw + 18, W - dw - 40
local list = MKT[mtab + 1][2]
local up, dn, upc, dnc, own, worth = nil, nil, -1e9, 1e9, 0, 0
for _, i in ipairs(list) do
local c = pct(mkt_price(i, b), mkt_price(i, b - 24))
if c > upc then up, upc = i, c end
if c < dnc then dn, dnc = i, c end
if cp.inv[i] > 0 then own = own + cp.inv[i]; worth = worth + cp.inv[i] * mkt_price(i, b) end
end
local yy = dy + 14
X.ltext(ix, yy, X.fit(MKT[mtab + 1][1], iw, "ui12", "bold"), "ui12", "bold")
X.ltext(ix, yy + 32, #list .. " items, 6h change", "small")
smudge.line(ix, yy + 58, ix + iw, yy + 58, 1)
local function mover(y, label, i, c)
X.ltext(ix, y, label, "small", "bold")
sprite(ix, y + 26, 24, ITEMS[i][3])
X.ltext(ix + 32, y + 24, X.fit(ITEMS[i][1], iw - 32, "small"), "small")
X.ltext(ix + 32, y + 46, string.format("%dc  %s%d%%", mkt_price(i, b), c >= 0 and "+" or "", c), "small", "bold")
end
if up then mover(yy + 70, "Rising most", up, upc) end
if dn and dn ~= up then mover(yy + 150, "Falling most", dn, dnc) end
smudge.line(ix, yy + 228, ix + iw, yy + 228, 1)
X.ltext(ix, yy + 240, "You have", "small", "bold")
X.ltext(ix, yy + 262, own > 0 and string.format("%d items, %dc", own, worth) or "nothing yet", "small")
X.ltext(ix, yy + 294, "Next price move", "small", "bold")
X.ltext(ix, yy + 316, mmss(fl(MBUCK - now() % MBUCK)), "small")
X.ctext(dw + (W - dw) // 2, dy + dh - 30, "tap here to close", "small")
end
if not X.saver() then smudge.rect(dw, dy + 4, 5, dh, true) end
smudge.rounded_rect(0, dy, dw, dh, 1, true, 1, false)
smudge.line(dw, dy, dw, dy + dh, 3)
smudge.line(0, dy + dh, dw, dy + dh, 3)
for t = 0, #MKT - 1 do
local cy = dy + 8 + t * ds
local best = 0
for _, i in ipairs(MKT[t + 1][2]) do best = math.max(best, pct(mkt_price(i, b), mkt_price(i, b - 24))) end
X.button(10, cy, dw - 22, ds - 4, MKT[t + 1][1], function() mtab = t; mdrawer = false end,
{ font = "ui10", active = (mtab == t), sub = "best " .. (best >= 0 and "+" or "") .. best .. "%", id = "MTAB" .. t })
sprite(18, cy + (ds - 28) // 2, 24, ITEMS[MKT[t + 1][2][1]][3])
end
end
back_btn("camp")
end
function C.draw_mktitem(S)
local cp = S.camp
local i = msel
head(S, ITEMS[i][1], "Market")
local y = HUDY + 42
local b = mkt_bucket()
local p = mkt_price(i, b)
sprite(26, y + 6, 24, ITEMS[i][3])
X.ltext(60, y, p .. " coins", "bitter14", "bold")
local ch1, ch2 = pct(p, mkt_price(i, b - 4)), pct(p, mkt_price(i, b - 96))
X.rtext(W - 24, y + 2, string.format("1h %s%d%%", ch1 >= 0 and "+" or "", ch1), "ui10", "bold")
X.rtext(W - 24, y + 28, string.format("24h %s%d%%", ch2 >= 0 and "+" or "", ch2), "small")
X.ltext(60, y + 36, string.format("normal %dc   bank %dc", ITEMS[i][2], unit_price(S, i)), "small")
local ry = y + 66
local R = { { "6H", 24, 1 }, { "1D", 48, 2 }, { "3D", 72, 4 } }
for k = 0, 2 do
X.button(24 + k * 146, ry, 138, 42, R[k + 1][1], function() mrange = k end, { font = "ui10", active = (mrange == k), id = "RANGE" .. k })
end
local rg = R[mrange + 1]
local cx, cy, cw = 64, ry + 56, W - 64 - 28
local ch = math.max(100, math.min(230, H - 96 - 8 - 24 - 60 - 32 - 34 - 82 - 26 - cy))
smudge.rect(cx - 2, cy - 2, cw + 4, ch + 4, false, 2)
for g = 1, 3 do
local gy = cy + fl(ch * g / 4)
for gx = cx, cx + cw - 4, 8 do smudge.line(gx, gy, gx + 3, gy, 1) end
end
local _, lo, hi, lx, lyy = price_line(cx, cy, cw, ch, i, rg[2], rg[3], 2, false)
smudge.circle(lx, lyy, 5, true)
X.rtext(cx - 6, cy - 6, tostring(fl(hi + 0.5)), "small", "bold")
X.rtext(cx - 6, cy + ch - 16, tostring(fl(lo + 0.5)), "small", "bold")
X.ltext(cx, cy + ch + 6, "-" .. ({ "6h", "1 day", "3 days" })[mrange + 1], "small")
X.rtext(cx + cw, cy + ch + 6, "now", "small")
local left = fl(MBUCK - now() % MBUCK)
X.ctext(W / 2, cy + ch + 6, "next move " .. mmss(left), "small")
local ahi, alo, thi, tlo = C.mkt_alltime(i)
local function ago(sec) if sec < 3600 then return "now" elseif sec < 86400 then return (sec // 3600) .. "h ago" end return (sec // 86400) .. "d ago" end
X.ltext(24, cy + ch + 30, string.format("All-time high %dc %s", ahi, ago(thi)), "small", "bold")
X.rtext(W - 24, cy + ch + 30, string.format("low %dc %s", alo, ago(tlo)), "small", "bold")
local ty = cy + ch + 58
local bp = mkt_buy_price(S, i)
X.ltext(24, ty, string.format("You have %d", cp.inv[i]), "ui10", "bold")
X.rtext(W - 24, ty, string.format("buy %dc / sell %dc", bp, p), "ui10")
local by = ty + 32
local bw2 = (W - 48 - 24) // 4
X.button(24, by, bw2, 60, "BUY 1", function() mkt_trade(S, i, 1) end, { font = "ui10", off = S.coins < bp or cp.inv[i] >= C.bank_cap(cp), id = "BUY1" })
X.button(24 + (bw2 + 8), by, bw2, 60, "BUY 10", function() mkt_trade(S, i, 10) end, { font = "ui10", off = S.coins < bp or cp.inv[i] >= C.bank_cap(cp), id = "BUY10" })
X.button(24 + 2 * (bw2 + 8), by, bw2, 60, "SELL 1", function() mkt_trade(S, i, -1) end, { font = "ui10", off = cp.inv[i] < 1, id = "SELL1" })
X.button(24 + 3 * (bw2 + 8), by, bw2, 60, "SELL ALL", function() mkt_trade(S, i, -cp.inv[i]) end, { font = "small", off = cp.inv[i] < 1, id = "SELLALL" })
local hw = (W - 48 - 8) // 2
X.button(24, by + 66, hw, 50, "GE BID -15%", function() ADV.ge_place(S, 1, i) end, { font = "small", sub = "buy 10 when it dips", id = "GEBID" })
X.button(32 + hw, by + 66, hw, 50, "GE ASK +15%", function() ADV.ge_place(S, 2, i) end, { font = "small", sub = "sell 10 when it peaks", off = cp.inv[i] < 1, id = "GEASK" })
local q, avg, np, pl, pc = ADV.pf_pos(cp, i)
if q then
X.ctext(W / 2, by + 122, string.format("Bought %d at avg %dc - if sold now: %s%dc (%s%d%%)", q, fl(avg + 0.5), pl >= 0 and "+" or "", pl, pc >= 0 and "+" or "", pc), "small", "bold")
else X.ctext(W / 2, by + 122, ADV.examine(i), "small") end
X.draw_note(by + 142)
back_btn("market")
end
C.mkt_price = mkt_price
C.mkt_sel = function() return msel end
function C.draw_shop(S)
local cp = S.camp
if cp.shopd ~= today_n() then cp.shopd = today_n(); cp.shopm = 0 end
head(S, "Shop", stab == 0 and "daily deals" or STORES[stab][2])
local tw5 = (W - 48 - 16) // 5
for t = 0, 4 do
X.button(24 + t * (tw5 + 4), TOP + 2, tw5, 42, t == 0 and "DEALS" or STORES[t][1], function() stab = t end,
{ font = "small", active = stab == t, id = "STAB" .. t, nohelp = true })
end
if stab > 0 then
local st = STORES[stab]
X.ctext(W / 2, TOP + 54, "Market prices. Goes to your bank.", "small")
for k, id in ipairs(st[3]) do
local i = IDX[id]
local by = TOP + 80 + (k - 1) * 82
local p = ITEMS[i][2]
panel(20, by, W - 40, 74)
sprite(32, by + 24, 24, ITEMS[i][3])
X.ltext(66, by + 10, ITEMS[i][1], "ui10", "bold")
local eqp = ITEMS[i][5] == "i_sup"
local own = count_item(cp, i)
X.ltext(66, by + 42, eqp and (own > 0 and "owned - kept forever" or string.format("%dc - yours forever", p))
or string.format("%dc each   you have %d", p, own), "small")
if eqp then
X.button(W - 24 - 8 - 2 * 86 - 6, by + 10, 2 * 86 + 6, 54, own > 0 and "OWNED" or "BUY", function() store_buy(S, id, 1) end,
{ font = "small", sub = (own == 0) and (p .. "c") or nil, off = own > 0 or S.coins < p, id = "SBUY" .. k, nohelp = true })
else
X.button(W - 24 - 8 - 2 * 86 - 6, by + 10, 86, 54, "BUY 1", function() store_buy(S, id, 1) end,
{ font = "small", sub = p .. "c", off = S.coins < p, id = "SBUY" .. k, nohelp = true })
X.button(W - 24 - 8 - 86, by + 10, 86, 54, "BUY 10", function() store_buy(S, id, 10) end,
{ font = "small", sub = (10 * p) .. "c", off = S.coins < 10 * p, id = "SBUYX" .. k, nohelp = true })
end
end
X.draw_note(TOP + 80 + 5 * 82)
back_btn("camp")
return
end
local offers = shop_offers(cp)
for k = 1, 5 do
local o = offers[k]
local by = TOP + 52 + (k - 1) * 88
local sold = (cp.shopm >> (k - 1)) & 1 == 1
panel(20, by, W - 40, 80)
local title, sub
if o.kind == "item" then title = o.qty .. " " .. ITEMS[o.item][1]; sprite(32, by + 28, 24, ITEMS[o.item][3])
else title = X.cname(o.c); sub = "Card of the day (" .. X.tier_name(o.c) .. ")"; sprite(32, by + 28, 24, "ui_gem") end
X.ltext(66, by + 10, title, "ui10", "bold")
if sub then X.ltext(66, by + 44, sub, "small") end
X.button(W - 24 - 150, by + 8, 140, 66, sold and "SOLD" or "BUY", function() shop_buy(S, k) end,
{ font = "ui10", sub = o.price .. " coins", off = sold or S.coins < o.price, id = "BUYOFFER" .. k })
end
X.draw_note(TOP + 52 + 5 * 88)
back_btn("camp")
end
