smudge.fill_quad(wl[1], wl[2], wl[3], wl[4], wl[5], wl[6], wl[7], wl[8], false, tk)
end
local function L3(x0, y0, x1, y1, z, th)
local a1, b1 = P(x0, y0, z); local a2, b2 = P(x1, y1, z)
