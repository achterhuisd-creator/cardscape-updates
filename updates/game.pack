X.ctext(bx0 + bw0 / 2, cy + 3, "BET", "small", "bold", true)
X.ctext(bx0 + bw0 / 2, cy + 18, short(b or 0), "ui12", "bold", true)
if GFX.ok() then smudge.glow_quad(bx0 + 8, cy + 20, bx0 + bw0 - 8, cy + 20, bx0 + bw0 - 8, cy + 44, bx0 + 8, cy + 44, 255, 205, 90, 0.25) end
X.reg("SBET", bx0, cy, bw0, 48, function()
if locked then return end
HP.pad_open(function(v) SL.cust = v; for i, x in ipairs(BETS) do if x == v then SL.cust = nil; SL.bi = i end end; save_bet() end)
end, false)
local gam = SL.gam and not SL.gam.over and not SL.gview and not locked
if gam then
X.button(24, cy + 56, lw, 48, "GAMBLE " .. SL.gam.amt, function() SL.gview = true; SND.play("chip", 0.6) end, { id = "SGAMBLE", sub = "double or nothing" })
else
local hint = SL.auto and ("AUTO: " .. SL.auto .. " pulls") or "hold SPIN: AUTO"
smudge.rounded_rect(24, cy + 56, lw, 48, 10, false, 1)
X.ctext(24 + lw / 2, cy + 56 + 24 - X.lh("small") // 2, hint, "small", "bold")
end
local label, sub, on = "SPIN", nil, true
if SL.auto then label, sub, on = "AUTO", "tap to stop", true
elseif SL.bonus then label, on = "BONUS", false
elseif free then label, sub, on = "FREE", SL.fsn .. " / " .. (SL.fsn + SL.fs), false
elseif SL.t0 and not SL.paid then label, on = "STOP", true
elseif SL.nudge then label, sub = "SKIP", "the nudges"
elseif SL.offer then label, sub = "SPIN", "held reels"
elseif SL.t0 then on = false end
spin_btn(W - 24 - spw, cy, spw, 100, label, sub, on, function()
if SL.auto then SL.auto = nil; SL.autoAt = nil; X.set_note("AUTO stopped."); return end
if SL.t0 and not SL.paid then quick_stop(); return end
if SL.nudge and not SL.nudge.anim then SL.nudge = nil; return end
if SL.gview then SL.gview = nil end
sl_pull(S)
end, "SPULL", now)
local sy = cy + 40
local ty0 = sy + 74
local rows = 5
local rh = math.min(34, fl((H - 112 - ty0 - 30) / rows))
local ph = rows * rh + 30
if SL.gview and SL.gam then
local G = SL.gam
smudge.rounded_rect(16, ty0, W - 32, ph, 10, true, 1, false)
smudge.rounded_rect(16, ty0, W - 32, ph, 10, false, 2)
local cxm = 16 + 24 + HP.CW / 2
local cyy = ty0 + (ph - HP.CH) / 2
if G.card then
local f = math.min(1, (now - G.card.t0) / 260)
if f < 1 then busy(); HP.cardback(cxm - HP.CW / 2, cyy, math.abs(math.cos(f * math.pi)) * HP.CW)
else HP.cardface(cxm - HP.CW / 2, cyy, G.card) end
else HP.cardback(cxm - HP.CW / 2, cyy, HP.CW) end
local lx = cxm + HP.CW / 2 + 16
local txt
if G.res == "lose" then txt = "Lost it. Better luck next time."
elseif G.over then txt = "Doubled 5 times! " .. G.amt .. " is yours."
elseif G.res == "win" then txt = "Right! Now " .. G.amt .. ". Again?"
else txt = "Double " .. G.amt .. " or lose it." end
X.wrapped(lx, ty0 + 10, txt, W - 16 - lx - 10, "small", 2)
if not G.over then
local bw = (W - 16 - lx - 22) // 2
X.button(lx, ty0 + 52, bw, 52, "RED", function() gamble(S, true) end, { id = "SGRED" })
X.button(lx + bw + 8, ty0 + 52, bw, 52, "BLACK", function() gamble(S, false) end, { id = "SGBLACK" })
X.button(lx, ty0 + 112, bw * 2 + 8, 44, "COLLECT " .. G.amt, function() SL.gam = nil; SL.gview = nil; SND.play("win_small", 0.6) end, { id = "SGCOL" })
else
X.button(lx, ty0 + 70, W - 16 - lx - 12, 48, "OK", function() SL.gam = nil; SL.gview = nil end, { id = "SGOK" })
end
elseif rh >= 22 then
smudge.rounded_rect(16, ty0, W - 32, ph, 10, true, 1, false)
smudge.rounded_rect(16, ty0, W - 32, ph, 10, false, 2)
smudge.rounded_rect(16, ty0, W - 32, 26, 10, true)
smudge.rect(16, ty0 + 14, W - 32, 12, true)
local rec = SL.tab == "rec"
local mis = SL.tab == "mis"
local done = 0
for _, m in ipairs(MIS.list) do if m.done then done = done + 1 end end
X.ctext(W / 2, ty0 + 14 - X.lh("small") // 2, rec and "YOUR RECORDS   (tap: missions)" or mis and ("DAILY MISSIONS " .. done .. "/3   (tap: what pays)")
or ("PAYS: TIMES YOUR BET   (tap: records)"), "small", "bold", true)
X.reg("STAB", 16, ty0, W - 32, 26, function() SL.tab = rec and "mis" or mis and "pays" or "rec" end, false)
if mis then
for i, m in ipairs(MIS.list) do
local d = mdef(m.id)
local yy = ty0 + 28 + (i - 1) * rh * 1.4
if i > 1 then smudge.line(24, fl(yy), W - 24, fl(yy), 1, true) end
local txt = string.format(d[3], d[2])
X.ltext(26, fl(yy + 4), txt, "small", "bold")
local right = m.done and "DONE" or (m.prog .. " / " .. d[2])
X.ltext(W - 26 - X.tw(right, "small", "bold"), fl(yy + 4), right, "small", "bold")
local bw = W - 52 - 110
local by = fl(yy + 4 + X.lh("small") + 3)
smudge.rounded_rect(26, by, bw, 8, 4, false, 1)
local fw = fl(bw * math.min(1, m.prog / d[2]))
if fw > 2 then smudge.rounded_rect(26, by, fw, 8, 4, true) end
if GFX.ok() and m.done then smudge.glow_quad(26, by, 26 + fw, by, 26 + fw, by + 8, 26, by + 8, 120, 255, 140, 0.6) end
local rw = "+" .. mis_reward(m)
X.ltext(W - 26 - X.tw(rw, "small"), by - 3, rw, "small")
end
X.ctext(W / 2, fl(ty0 + 28 + 3 * rh * 1.4 + 4), "New missions every day", "small")
elseif rec then
local lines = {
{ "Biggest win", REC.best .. "  (" .. string.format("%.0f", REC.bestx) .. "x your bet)" },
{ "Jackpots", "GRAND " .. REC.n[1] .. "   MAJOR " .. REC.n[2] .. "   MINI " .. REC.n[3] },
{ "Bell bonus / free spins", REC.bonus .. " / " .. REC.fs },
}
for i, e in ipairs(REC.last) do lines[#lines + 1] = { i == 1 and "Last big wins" or "", e[1] .. "  " .. e[2] } end
if #REC.last == 0 then lines[#lines + 1] = { "Last big wins", "none yet" } end
for i = 1, math.min(#lines, rows) do
local yy = ty0 + 28 + (i - 1) * rh
if i > 1 then smudge.line(24, yy, W - 24, yy, 1, true) end
X.ltext(26, yy + rh / 2 - X.lh("small") // 2, lines[i][1], "small")
X.ltext(W - 26 - X.tw(lines[i][2], "small", "bold"), yy + rh / 2 - X.lh("small") // 2, lines[i][2], "small", "bold")
end
else
local cw = (W - 44) // 2
local items = { JACK, WILD, 7, 6, 5, STAR, 4, 3, 2, 1 }
local function m(v) local q = v / 5; return (q == math.floor(q)) and tostring(fl(q)) or string.format("%.1f", q) end
for n, id in ipairs(items) do
local k = n - 1
local col, row = k // rows, k % rows
local x = 22 + col * cw
local yy = ty0 + 28 + row * rh
if row > 0 then smudge.line(x + 4, yy, x + cw - 6, yy, 1, true) end
local isz = math.min(30, rh - 4)
local cyy = yy + rh / 2
draw_sym(id, x + 8 + isz / 2, cyy, isz, false)
X.ltext(x + 14 + isz, cyy - X.lh("small") // 2, (id == STAR) and "any" or "x3", "small")
local pt
if id == JACK then pt = "JACKPOTS"
elseif id == WILD then pt = m(PAYW) .. "x"
elseif id == STAR then pt = "2: 1x  3: 8 FREE"
elseif id == BELL then pt = m(PAY3[id]) .. "x +BONUS"
else pt = m(PAY3[id]) .. "x" .. ((PAY2[id] > 0) and ("  2:" .. m(PAY2[id])) or "") end
local f = "small"
X.ltext(x + cw - 10 - X.tw(pt, f, "bold"), cyy - X.lh(f) // 2, pt, f, "bold")
end
smudge.line(22 + cw, ty0 + 28, 22 + cw, ty0 + ph - 4, 1, true)
end
end
if SL.rain then
local live = false
for _, c in ipairs(SL.rain) do
local age = now - c.t0
if age < 0 then live = true
else
local yy = -20 + age * 0.55 * c.sp + age * age * 0.00025
if yy < H + 20 then
live = true
local hw = math.max(1, 10 * math.abs(math.cos(age / 110 + c.ph)))
local xx = c.x + math.sin(age / 300 + c.ph) * 10
smudge.draw_sprite_quad("art/ui_coin.raw", 24, 24, xx - hw, yy - 10, xx + hw, yy - 10, xx + hw, yy + 10, xx - hw, yy + 10, "art/ui_coin_m.raw")
if GFX.ok() then
local f = (hw / 10) ^ 10
if f > 0.05 then
smudge.glow_circle(xx - 3, yy - 4, 4 + 5 * f, 255, 250, 220, 2.4 * f)
if f > 0.7 then smudge.glow_quad(xx - 9, yy - 4, xx + 9, yy - 4, xx + 9, yy - 3, xx - 9, yy - 3, 255, 255, 240, 1.5 * f) end
end
end
end
end
end
if live then busy() else SL.rain = nil end
end
back_btn("casino")
end
SM.SL = SL
SM.REC = REC
SM.SPR = SPR
SM.spin_btn, SM.short = spin_btn, short
SM.pull, SM.nudge, SM.pick, SM.gamble, SM.quick_stop = sl_pull, nudge, pick, gamble, quick_stop
return SM
end
smithing.lua
19371
return function(X, C, ADV, H)
local F = {}
local W, Hh = X.W, X.H
local fl = math.floor
local SI = 5
local PHONE = smudge.smooth == true
local function hd() return PHONE and GFX and GFX.ok and GFX.ok() and smudge.hires_quad end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function vib(p) if VIB then VIB.play(p, true) end end
local function ms() return X.millis() end
local P = {
fire1 = { 55, 37 },
fire2 = { 55, 57 },
fire3 = { 55, 72 },
cr_ore = { 30, 30 },
cr_melt = { 30, 31 },
cr_pour = { 39, 43, 0.885 },
mould = { 35, 16, 0.329 },
mould_hot = { 35, 16, 0.329 },
mould_b1 = { 35, 16 }, mould_b2 = { 35, 16 }, mould_b3 = { 35, 16 }, mould_b4 = { 35, 16 },
mould_b5 = { 35, 16 }, mould_b6 = { 35, 16 }, mould_b7 = { 35, 16 }, mould_b8 = { 35, 16 },
bel_open = { 65, 35, 0.457 },
bel_shut = { 53, 20, 0.500 },
hammer = { 66, 28 },
hot_bar = { 12, 34 },
hot_sword = { 17, 91 },
hot_axe = { 35, 37 },
hot_pick = { 53, 45 },
hot_harp = { 17, 52 },
bar1 = { 33, 14 }, bar2 = { 33, 14 }, bar3 = { 33, 14 }, bar4 = { 33, 14 },
bar5 = { 33, 14 }, bar6 = { 33, 15 }, bar7 = { 33, 14 }, bar8 = { 33, 15 },
sword1 = { 14, 79 }, sword2 = { 14, 80 }, sword3 = { 14, 80 }, sword4 = { 14, 81 },
sword5 = { 14, 80 }, sword6 = { 14, 80 }, sword7 = { 14, 80 }, sword8 = { 14, 83 },
axe2 = { 25, 58 }, axe3 = { 25, 59 }, axe4 = { 25, 59 }, axe5 = { 25, 59 }, axe6 = { 25, 59 }, axe7 = { 25, 59 },
pick2 = { 31, 60 }, pick3 = { 31, 65 }, pick4 = { 31, 63 }, pick5 = { 31, 64 }, pick6 = { 31, 62 }, pick7 = { 31, 55 },
harp = { 12, 51 },
}
local PX = 464 / 256
local SW, SH = 464, 371
local METAL = { "Bronze", "Iron", "Steel", "Mithril", "Adamant", "Rune", "Dragon", "Celestial" }
local STRIKES = { 5, 5, 6, 7, 7, 8, 9, 10 }
local function metal_of(r) local w = r[1]:match("^(%a+)"); for i, m in ipairs(METAL) do if m == w then return i end end; return 2 end
local function kind_of(r)
local n = r[1]:lower()
if n:find("pickaxe") then return "pick" elseif n:find("axe") then return "axe" elseif n:find("sword") then return "sword"
elseif n:find("harpoon") then return "harp" end
return "bar"
end
local FUR, ANV = {}, {}
for ri, r in ipairs(H.REC[SI]) do if r[6] then ANV[#ANV + 1] = ri else FUR[#FUR + 1] = ri end end
local view = "furnace"
local SEL = { furnace = nil, anvil = nil }
local SCN = nil
local SS = nil
local LAST = nil
local POP = nil
local function pic(n, cx, cy, w, ang, ax, ay)
local p = P[n]
local s = (w or p[1] * PX) / p[1]
local pw, ph = p[1] * s, p[2] * s
local x0, y0 = -(ax or 0.5) * pw, -(ay or 0.5) * ph
local c, sn = math.cos(ang or 0), math.sin(ang or 0)
local function R(dx, dy) return cx + dx * c - dy * sn, cy + dx * sn + dy * c end
local a1, a2 = R(x0, y0); local b1, b2 = R(x0 + pw, y0); local c1, c2 = R(x0 + pw, y0 + ph); local d1, d2 = R(x0, y0 + ph)
local o = -9
smudge.hires_quad("^hd/sm_" .. n .. "_c.png", o, o, o, o, o, o, o, o, a1, a2, b1, b2, c1, c2, d1, d2)
return pw, ph
end
local function tile(nm, x0, y0, x1, y1)
local lx, rx = x0 + 0.75, x1 - 1.75
smudge.hires_quad(nm, lx, y0, rx, y0, rx, y1, lx, y1, x0, y0, x1, y0, x1, y1, x0, y1)
end
local function pill(cx, y, txt, font)
font = font or "ui10"
local tw = X.tw(txt, font, "bold") + 18
smudge.rounded_rect(fl(cx - tw / 2), fl(y), tw, 26, 9, true, 1, false)
smudge.rounded_rect(fl(cx - tw / 2), fl(y), tw, 26, 9, false, 2)
X.ctext(fl(cx), fl(y + 3), txt, font, "bold")
end
local function lerp(a, b, k) return a + (b - a) * k end
local function gauges(x, y, G)
local cw, ch = 280, 10 + #G * 20
local cx = fl(x + SW / 2 - cw / 2)
smudge.rounded_rect(cx, y + 40, cw, ch, 8, true, 1, false)
smudge.rounded_rect(cx, y + 40, cw, ch, 8, false, 2)
for k, g in ipairs(G) do
local gy = y + 46 + (k - 1) * 20
X.ltext(cx + 10, gy - 1, g[1], "small", "bold")
local bx, bw = cx + 62, cw - 74
smudge.rect(bx, gy + 2, bw, 12, false, 2)
if g[3] then smudge.rect_dither(bx + 2, gy + 4, fl((bw - 4) * g[2]), 8, true)
else smudge.rect(bx + 2, gy + 4, fl((bw - 4) * g[2]), 8, true) end
end
end
local function list() return view == "furnace" and FUR or ANV end
local function pick_default(cp)
for _, v in ipairs({ "furnace", "anvil" }) do
if not SEL[v] then
local L = v == "furnace" and FUR or ANV
local best = 1
for k, ri in ipairs(L) do
local r = H.REC[SI][ri]
if H.slevel(cp, SI) >= r[2] and H.can_make(cp, r) and not (r[5].tool and H.owns_tool(cp, r[5].tool)) then best = k end
end
SEL[v] = best
end
end
end
local function why_not(cp, r)
if H.slevel(cp, SI) < r[2] then return "You need Smithing level " .. r[2] .. "." end
if r[6] and not H.have_item(cp, r[6]) then return "You need a hammer (General store in the SHOP)." end
if r[5].tool and H.owns_tool(cp, r[5].tool) then return "You already have that." end
if not H.can_make(cp, r) then return "Missing materials: " .. H.need_text(cp, r) .. "." end
return nil
end
local function addnote(extra)
local n = X.get_note and X.get_note() or ""
X.set_note((n ~= "" and (n .. "  ") or "") .. extra)
end
local FS = { heat = 0.06, melt = 0, hold = false, out = 0, clean = true, pour = nil, puff = 0, ri = nil, flick = 0 }
local function band(cp, r)
local m = metal_of(r)
local lo = 0.26 + 0.065 * (m - 1)
local w = 0.34 - 0.034 * (m - 1) + math.min(0.12, 0.003 * math.max(0, H.slevel(cp, SI) - r[2]))
return lo, math.min(0.97, lo + w)
end
local function melt_time(r) return 2.5 + 0.28 * (metal_of(r) - 1) end
local function poured(S)
local cp = S.camp
local r = H.REC[SI][FS.ri]
local res = H.make(S, SI, FS.ri)
if GFX and SCN then GFX.tapxy = { x = W / 2, y = SCN[2] + SH + 130 } end
if res ~= "ok" then return end
POP = { t0 = ms(), text = "+1 " .. r[1] }
if FS.clean then
local nd = r[4][1]
cp.inv[nd[1]] = cp.inv[nd[1]] + 1
addnote("PERFECT POUR: 1 " .. H.ITEMS[nd[1]][1]:lower() .. " back.")
end
X.mark_dirty(); X.save_now()
end
local function furnace_step(S, dt)
local cp = S.camp
if FS.pour then
local p = (ms() - FS.pour) / 1000
if p > 2.6 then FS.pour = nil; FS.melt = 0; FS.clean = true; FS.ri = nil end
FS.heat = math.max(0.06, FS.heat - dt * 0.2)
return true
end
if FS.hold then
FS.heat = math.min(1, FS.heat + dt * 0.55)
FS.puff = FS.puff + dt
if FS.puff > 0.42 then FS.puff = 0; snd("sm_puff", 0.35) end
else FS.heat = math.max(0.06, FS.heat - dt * 0.32) end
if FS.ri then
local r = H.REC[SI][FS.ri]
local lo, hi = band(cp, r)
if FS.heat >= lo and FS.heat <= hi then FS.melt = math.min(1, FS.melt + dt / melt_time(r)); FS.out = 0
elseif FS.heat > hi then FS.out = FS.out + dt; if FS.out > 0.35 then FS.clean = false end
else FS.out = 0 end
if FS.melt >= 1 then
FS.pour = ms(); FS.hold = false
snd("sm_pour", 0.5); vib("sf_click")
poured(S)
end
end
return FS.hold or FS.heat > 0.07 or FS.pour ~= nil
end
local function draw_furnace(S, x, y)
local cp = S.camp
local t = ms()
local HD = hd()
local u = SW / 1402
if HD then tile("hd/sm_furnace_c.png", x, y, x + SW, y + SH)
else
smudge.rect(x, y, SW, SH, false, 2)
smudge.rounded_rect(fl(x + 181), fl(y + 165), 106, 90, 40, false, 3)
X.ctext(x + SW // 2, y + 120, "FURNACE", "ui12", "bold")
X.ctext(x + SW // 2, y + 270, "Tap the furnace to smelt one bar.", "small")
end
local mx, my = x + 708 * u, y + 765 * u
local r = FS.ri and H.REC[SI][FS.ri] or H.REC[SI][FUR[SEL.furnace]]
if HD then
local h = FS.heat
local f = h < 0.3 and 1 or (h < 0.62 and 2 or 3)
local fw = ({ 90, 86, 84 })[f] * (0.92 + 0.08 * math.min(1, h * 1.6)) * (1 + 0.03 * math.sin(t / 70) * math.sin(t / 113))
pic("fire" .. f, mx, my + 2, fw, 0, 0.5, 1)
local p = FS.pour and (t - FS.pour) / 1000 or nil
local kx, ky = x + 1012 * u, y + 838 * u
if not p or p < 0.35 then
local k = p and p / 0.35 or 0
local cx, cy = lerp(mx, kx - 34, k), lerp(my - 4, ky - 50, k)
pic(((FS.melt > 0.45) or p) and "cr_melt" or "cr_ore", cx, cy, 52, k * 0.3, 0.5, 1)
end
local hx, hy = kx, ky - 64 * P.mould[2] / P.mould[1] * (1 - P.mould[3])
local mn = "mould"
if p and p >= 1.75 then mn = "mould_b" .. metal_of(r) elseif p and p > 0.75 then mn = "mould_hot" end
pic(mn, kx, ky, 64, 0, 0.5, 1)
if p and p >= 0.35 and p < 1.4 then
local ax = P.cr_pour[3]
pic("cr_pour", hx, hy, 70, 0, ax, 1)
end
local shut = FS.hold and (fl(t / 210) % 2 == 0)
if shut then pic("bel_shut", x + 562 * u, my - 26, 96, 0, 1, P.bel_shut[3])
else pic("bel_open", x + 562 * u, my - 26, 118, 0, 1, P.bel_open[3]) end
if h > 0.25 then
for k = 0, 5 do
local q = ((t / 1400) + k / 6) % 1
local sx = mx - 30 + ((k * 37) % 60) + math.sin(t / 300 + k) * 4
smudge.rect(fl(sx), fl(my - 20 - q * 90 * h), 2, 2, true, 1, false)
end
end
end
if not HD then return end
local tx, ty, th = x + SW - 30, y + 44, SH - 100
smudge.rect(tx, ty, 18, th, true, 1, false)
smudge.rect(tx, ty, 18, th, false, 2)
local lo, hi = band(cp, r)
smudge.rect(tx + 2, fl(ty + th * (1 - hi)), 14, fl(th * (hi - lo)), true)
smudge.rect_dither(tx + 2, ty + 2, 14, fl(th * (1 - hi)) - 2, true)
local ny = fl(ty + th * (1 - FS.heat))
smudge.rect(tx - 10, ny - 4, 38, 9, true)
smudge.rect(tx - 8, ny - 2, 34, 5, true, 1, false)
if FS.ri or FS.pour then gauges(x, y, { { "melt", FS.melt } }) end
local msg
if FS.pour then msg = FS.clean and "PERFECT POUR!" or "POURING"
elseif not FS.ri then msg = HD and "Hold the furnace: pump the bellows" or nil
elseif FS.heat > hi then msg = "TOO HOT!"
elseif FS.heat >= lo then msg = "MELTING"
else msg = "Hotter: pump the bellows" end
if msg then pill(x + SW / 2 - 12, y + 10, msg) end
end
local AS = { ri = nil, prog = 0, heat = 1, ring = nil, streak = 0, hit = nil, done = nil, reheat = nil, hammer = 0, sparks = {} }
local function piece(r)
local k = kind_of(r)
local m = metal_of(r)
if AS.done then
if k == "sword" then return "sword" .. m, 26, -math.pi / 2 end
if k == "axe" then return "axe" .. math.max(2, math.min(7, m)), 46, -math.pi / 2 end
if k == "pick" then return "pick" .. math.max(2, math.min(7, m)), 56, -math.pi / 2 end
return "harp", 22, -math.pi / 2
end
if AS.prog < 0.45 then
if AS.heat < 0.2 then return "bar" .. m, 62, 0 end
return "hot_bar", 22, -math.pi / 2
end
if k == "sword" then return "hot_sword", 30, -math.pi / 2 end
if k == "axe" then return "hot_axe", 64, 0 end
if k == "pick" then return "hot_pick", 96, 0 end
return "hot_harp", 30, -math.pi / 2
end
local function piece_len(n, w, ang)
local p = P[n]
return (ang ~= 0) and (p[2] * w / p[1]) or w
end
local function new_ring(r)
local n, w, ang = piece(r)
local L = piece_len(n, w, ang)
AS.ring = { x = (X.rnd(0, 1000) / 1000 - 0.5) * L * 0.7, y = (X.rnd(0, 1000) / 1000 - 0.5) * 6, t0 = ms() }
end
local RING = 1150
local function ring_r() return AS.ring and math.max(0, 1 - (ms() - AS.ring.t0) / RING) or 1 end
local function finished(S)
local cp = S.camp
local r = H.REC[SI][AS.ri]
local res = H.make(S, SI, AS.ri)
if GFX and SCN then GFX.tapxy = { x = W / 2, y = SCN[2] + SH + 130 } end
snd("sm_hiss", 0.5); vib("sf_bolt")
AS.done = ms()
if res ~= "ok" then return end
POP = { t0 = ms(), text = r[1] }
if AS.streak >= 3 then
local xp = H.xp_amt(cp, fl(r[3] * 0.25 + 0.5), SI)
local keep = X.rnd(1, 100) <= 25
if keep then for _, nd in ipairs(r[4]) do cp.inv[nd[1]] = cp.inv[nd[1]] + nd[2] end end
addnote("MASTERWORK! +" .. xp .. " xp" .. (keep and ", and the materials are kept." or ".") .. H.give_xp(S, SI, xp))
POP.text = "MASTERWORK " .. r[1]
end
X.mark_dirty(); X.save_now()
end
local function strike(S)
local cp = S.camp
if AS.done or AS.reheat then return end
if not AS.ri then
local ri = ANV[SEL.anvil]
local r = H.REC[SI][ri]
local why = why_not(cp, r)
if why then X.set_note(why); return end
AS.ri, AS.prog, AS.heat, AS.streak = ri, 0, 1, 0
new_ring(r)
snd("sm_clink", 0.3)
return
end
local r = H.REC[SI][AS.ri]
AS.hammer = ms()
if AS.heat < 0.15 then snd("sm_thud", 0.5); X.set_note("The metal is too cold: REHEAT it in the forge."); return end
local off = ring_r()
local q = off < 0.1 and "PERFECT" or (off < 0.28 and "GOOD" or "WEAK")
local gain = (q == "PERFECT" and 1 or (q == "GOOD" and 0.7 or 0.3)) * (0.4 + 0.6 * AS.heat)
AS.prog = math.min(1, AS.prog + gain / STRIKES[metal_of(r)])
if q == "PERFECT" then AS.streak = AS.streak + 1; snd("sm_perfect", 0.5); vib("sf_bolt") else AS.streak = 0; snd("sm_clink", 0.45); vib("sf_click") end
AS.hit = { q = q, t = ms(), x = AS.ring and AS.ring.x or 0, y = AS.ring and AS.ring.y or 0 }
AS.sparks = {}
for k = 1, (q == "PERFECT" and 16 or 7) do
local a = X.rnd(0, 628) / 100
local v = 40 + X.rnd(0, 60)
AS.sparks[k] = { vx = math.cos(a) * v, vy = math.sin(a) * v - 40 }
end
if AS.prog >= 1 then finished(S); AS.ring = nil; return end
new_ring(r)
end
local function anvil_step(S, dt)
if AS.done then
if ms() - AS.done > 1800 then AS.done = nil; AS.ri = nil; AS.prog = 0; AS.heat = 1; AS.streak = 0 end
return true
end
if AS.reheat then
if ms() - AS.reheat > 1300 then AS.reheat = nil; AS.heat = 1; if AS.ri then new_ring(H.REC[SI][AS.ri]) end end
return true
end
if not AS.ri then return false end
AS.heat = math.max(0, AS.heat - dt / 12)
if AS.ring and ms() - AS.ring.t0 > RING + 300 then AS.streak = 0; new_ring(H.REC[SI][AS.ri]) end
return true
end
local function draw_anvil(S, x, y)
local cp = S.camp
local t = ms()
local HD = hd()
local u = SW / 1402
if HD then tile("hd/sm_anvil_c.png", x, y, x + SW, y + SH)
else
smudge.rect(x, y, SW, SH, false, 2)
smudge.fill_quad(x + 60, y + 150, x + 330, y + 150, x + 300, y + 190, x + 90, y + 190, true)
smudge.rect(x + 160, y + 190, 70, 90, true)
X.ctext(x + SW // 2, y + 60, "ANVIL", "ui12", "bold")
X.ctext(x + SW // 2, y + 300, "Tap the anvil to smith one.", "small")
end
local cx, cy = x + 560 * u, y + 462 * u
local r = H.REC[SI][AS.ri or ANV[SEL.anvil]]
if HD and (AS.ri or AS.done) then
local px, py = cx, cy
if AS.reheat then
local p = (t - AS.reheat) / 1300
local k = p < 0.3 and p / 0.3 or (p > 0.7 and (1 - p) / 0.3 or 1)
px, py = lerp(cx, x + 75, k), lerp(cy, y + 92, k)
end
local n, w, ang = piece(r)
pic(n, px, py, w, ang, 0.5, 0.5)
if AS.ring and not AS.done and not AS.reheat then
local sx, sy = fl(cx + AS.ring.x), fl(cy + AS.ring.y)
local rr = ring_r()
local rad = fl(6 + rr * 34)
smudge.circle(sx, sy, rad, false, 4)
smudge.circle(sx, sy, rad, false, 2, false)
smudge.circle(sx, sy, 4, true)
smudge.circle(sx, sy, 2, true, 1, false)
end
local hx, hy = cx + (AS.ring and AS.ring.x or 0), cy + (AS.ring and AS.ring.y or 0)
if AS.hit and t - AS.hit.t < 400 then hx, hy = cx + AS.hit.x, cy + AS.hit.y end
local k = AS.hammer and math.max(0, 1 - (t - AS.hammer) / 260) or 0
if not AS.reheat then pic("hammer", hx + lerp(30, 4, k), hy + lerp(-74, -16, k), 120, lerp(-0.85, -0.1, k), 0.13, 0.5) end
if AS.hit and t - AS.hit.t < 600 then
local s = (t - AS.hit.t) / 1000
for _, p in ipairs(AS.sparks) do
smudge.rect(fl(cx + AS.hit.x + p.vx * s), fl(cy + AS.hit.y + p.vy * s + 160 * s * s), 2, 2, true, 1, false)
end
end
end
if AS.ri then gauges(x, y, { { "shape", AS.prog }, { "heat", AS.heat, true } }) end
local msg
if AS.done then msg = (AS.streak >= 3) and "MASTERWORK!" or "Done!"
elseif AS.reheat then msg = "Reheating..."
elseif AS.hit and t - AS.hit.t < 700 then msg = AS.hit.q .. ((AS.hit.q == "PERFECT" and AS.streak > 1) and (" x" .. AS.streak) or "")
elseif AS.ri and AS.heat < 0.15 then msg = "Too cold: REHEAT"
elseif not AS.ri then msg = HD and "Tap the anvil to start" or nil end
if msg then pill(x + SW / 2, y + 10, msg) end
end
SMITHT = {}
local function in_scene(px, py) return SCN and px >= SCN[1] and px < SCN[1] + SW and py >= SCN[2] and py < SCN[2] + SH end
function SMITHT.touch(ev, px, py)
if not SS or not hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
local cp = SS.camp
if view == "furnace" then
if ev == "down" and in_scene(px, py) then
if FS.pour then return true end
if not FS.ri then
local ri = FUR[SEL.furnace]
local why = why_not(cp, H.REC[SI][ri])
if why then X.set_note(why); return true end
FS.ri, FS.melt, FS.clean, FS.out = ri, 0, true, 0
end
FS.hold = true; FS.puff = 1; busy(); return true
end
if FS.hold and (ev == "release" or ev == "up" or ev == "tap") then FS.hold = false; busy(); return true end
if FS.hold and (ev == "move" or ev == "nudge") then return true end
return false
end
if ev == "down" and in_scene(px, py) then strike(SS); busy(); return true end
if ev == "up" or ev == "tap" or ev == "release" then return in_scene(px, py) end
return false
end
function F.draw(S, y)
local cp = S.camp
SS = S
pick_default(cp)
local t = ms()
local dt = LAST and math.min(0.05, (t - LAST) / 1000) or 0
LAST = t
local x = fl((W - SW) / 2)
SCN = { x, y }
local more
if view == "furnace" then more = furnace_step(S, dt); draw_furnace(S, x, y)
else more = anvil_step(S, dt); draw_anvil(S, x, y) end
if more then busy() else LAST = nil end
if not hd() then
X.reg("SMSCN", x, y, SW, SH, function()
local ri = list()[SEL[view]]
local why = why_not(cp, H.REC[SI][ri])
if why then X.set_note(why); return end
H.make(S, SI, ri)
end, false)
end
if POP and t - POP.t0 < 1300 then
local v = (t - POP.t0) / 1300
local tw = X.tw(POP.text, "ui12", "bold") + 20
smudge.rounded_rect(fl(x + SW / 2 - tw / 2), fl(y + SH / 2 - 10 - 30 * v), tw, 30, 10, true)
X.ctext(fl(x + SW / 2), fl(y + SH / 2 - 6 - 30 * v), POP.text, "ui12", "bold", true)
busy()
end
local L = list()
local k = SEL[view]
local ri = L[k]
local r = H.REC[SI][ri]
local busy_now = (view == "furnace" and (FS.ri or FS.pour)) or (view == "anvil" and (AS.ri or AS.done))
local ry = y + SH + 6
local function step(d)
if busy_now then X.set_note(view == "furnace" and "Finish this melt first." or "Finish this piece first."); return end
SEL[view] = (k - 1 + d) % #L + 1
end
X.button(24, ry, 52, 56, "<", function() step(-1) end, { font = "ui12", id = "SMPREV", nohelp = true })
X.button(W - 76, ry, 52, 56, ">", function() step(1) end, { font = "ui12", id = "SMNEXT", nohelp = true })
local why = why_not(cp, r)
smudge.rounded_rect(82, ry, W - 164, 56, 10, false, 1)
X.ctext(W // 2, ry + 4, r[1] .. "  (Lv " .. r[2] .. ")", "ui10", "bold")
X.ctext(W // 2, ry + 30, X.fit((why and why:find("^You") and why) or H.need_text(cp, r), W - 180, "small"), "small")
local by = Hh - 96 - 60
local bw = (W - 48 - 12) // 3
X.button(24, by, bw, 52, view == "furnace" and "ANVIL" or "FURNACE", function()
view = view == "furnace" and "anvil" or "furnace"; FS.hold = false; X.mark_dirty()
end, { font = "small", id = "SMVIEW", sub = view == "furnace" and "smith things" or "smelt bars", nohelp = true })
X.button(24 + bw + 6, by, bw, 52, "QUICK x5", function()
if busy_now then X.set_note("Finish this one first."); return end
H.make_many(S, SI, ri, 5)
end, { font = "small", id = "SMQUICK", sub = "no bonus", off = why ~= nil, nohelp = true })
if view == "anvil" then
X.button(24 + 2 * (bw + 6), by, W - 48 - 2 * (bw + 6), 52, "REHEAT", function()
if AS.ri and not AS.reheat and not AS.done then AS.reheat = ms(); snd("sm_puff", 0.4); busy() end
end, { font = "small", id = "SMHEAT", off = not AS.ri or AS.heat > 0.9, nohelp = true, sub = AS.ri and (fl(AS.heat * 100) .. "% hot") or "" })
else
X.button(24 + 2 * (bw + 6), by, W - 48 - 2 * (bw + 6), 52, "STOP", function()
if FS.ri and not FS.pour then FS.ri, FS.melt, FS.hold = nil, 0, false; X.set_note("Melt stopped: nothing used.") end
end, { font = "small", id = "SMSTOP", off = not FS.ri or FS.pour ~= nil, nohelp = true, sub = "this melt" })
end
X.draw_note(hd() and (y + SH + 68) or (y + SH - 70))
end
F.state = function() return FS, AS end
F.set_view = function(v) view = v end
return F
end
thieving.lua
6132
return function(X, C, ADV, H, K)
local F = {}
local fl = math.floor
local SI = 12
local function ms() return X.millis() end
local ACTS = H.ACTS
local NAMES = { "Villager", "Market trader", "Guard", "Noble", "Guild merchant", "Banker", "Royal steward", "Dragon priest" }
local sel = nil
local TH = { reach = 0, hold = false, look = 0, state = "away", next = 0, caught = 0, ai = nil, tw = 0 }
local L, SS, POP, LAST = nil, nil, nil, nil
local function tier() return sel or 1 end
local function plan(state)
local t = tier()
if state == "away" then return 1.5 + X.rnd(0, 250 - t * 18) / 100 end
if state == "tell" then return math.max(0.3, 0.6 - t * 0.035) end
if state == "turning" then return 0.3 end
if state == "looking" then return 1.0 + X.rnd(0, 120) / 100 end
return 0.3
end
local NEXT = { away = "tell", tell = "turning", turning = "looking", looking = "back", back = "away" }
local function lifted(S)
local cp = S.camp
local a = ACTS[2][sel]
ADV.on_action(S, SI)
local c = X.rnd(a[4], a[5]) * 3
X.add_coins(c)
cp.stat[8] = cp.stat[8] + 1
local xp = H.xp_amt(cp, a[3], SI)
if GFX and L then GFX.tapxy = { x = X.W / 2, y = L.ry - 40 } end
X.set_note(string.format("You lift the %s's pouch: %d coins!  (+%d xp)", NAMES[sel]:lower(), c, xp) .. H.give_xp(S, SI, xp) .. ADV.G.pet_roll(S, SI))
POP = { t0 = ms(), text = "+" .. c .. " coins" }
K.snd("coins", 0.6); K.vib("sf_bolt")
TH.reach, TH.hold = 0, false
X.mark_dirty(); X.save_now()
end
local function step(S, dt)
if TH.caught > 0 then
TH.caught = TH.caught - dt
TH.reach = math.max(0, TH.reach - dt * 0.8)
return true
end
TH.next = TH.next - dt
if TH.next <= 0 then TH.state = NEXT[TH.state]; TH.next = plan(TH.state) end
local target = ({ away = 0, tell = 0, turning = 0.5, looking = 1, back = 0.5 })[TH.state]
TH.look = TH.look + (target - TH.look) * math.min(1, dt * 10)
if TH.hold then
TH.reach = math.min(1, TH.reach + dt / (2.2 + tier() * 0.15))
if TH.look > 0.75 then
TH.hold = false; TH.caught = 5
C.thief_stun(5000)
K.snd("th_caught", 0.6); K.vib("sf_bolt")
if GFX and L then GFX.tapxy = { x = X.W / 2, y = L.ry - 40 } end
X.set_note('"Oi! Hands off!" Caught by the ' .. NAMES[sel]:lower() .. ": stunned for 5 seconds.")
end
if TH.reach >= 1 then lifted(S) end
end
return true
end
THIEFT = {}
function THIEFT.touch(ev, px, py)
if not SS or not L or not K.hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
if ev == "down" then
if not (px >= L.x and px < L.x + L.w and py >= L.y and py < L.y + L.h) then return false end
local a = ACTS[2][sel]
if H.slevel(SS.camp, SI) < a[2] then X.set_note("You need Thieving level " .. a[2] .. " for the " .. NAMES[sel]:lower() .. "."); return true end
if TH.caught > 0 or C.thief_stunned() then X.set_note("You're stunned!"); return true end
TH.hold = true; K.busy(); return true
end
if TH.hold and (ev == "release" or ev == "up" or ev == "tap") then TH.hold = false; return true end
if TH.hold and (ev == "move" or ev == "nudge") then return true end
return false
end
local function draw_scene(S)
local t = ms()
local HD = K.hd()
local x, y = L.x, L.y
if not HD then
smudge.rect(x, y, L.w, L.h, false, 2)
X.ctext(x + L.w // 2, y + L.h // 2 - 20, NAMES[sel]:upper(), "ui12", "bold")
X.ctext(x + L.w // 2, y + L.h // 2 + 10, "Tap to pickpocket.", "small")
X.reg("THSCN", x, y, L.w, L.h, function() H.do_act(S, SI, sel) end, false)
return false
end
K.tile("hd/th_street_c.png", x, y, x + L.w, y + L.h)
local u, v = L.w / 256, L.h / 355
local mw = 70 * 2.6
local mh = 150 * 2.6
local fx, fy = x + L.w * 0.66, y + L.h * 0.93
local pose = (TH.look > 0.75) and "face" or ((TH.look > 0.25) and "side" or "away")
K.pic("th_m" .. sel .. "_" .. pose, 70, 150, fx, fy, mw, 0, 0.5, 1)
local s = mw / 70
local ox, oy = fx - mw / 2, fy - mh
if TH.state == "tell" and pose == "away" then
local j = math.sin(t / 25) * 2
K.pic("th_ear", 4, 7, ox + 46 * s + j, oy + 29 * s - j, 4 * s, 0)
end
if TH.state == "looking" or TH.caught > 0 then K.pill(ox + 35 * s, oy - 34, TH.caught > 0 and "OI!" or "!") end
local px, py = ox + 10 * s, oy + 92 * s
if TH.reach < 0.98 then K.pic("th_pouch", 14, 16, px, py, 14 * s * 0.85, 0, 0.5, 0.3) end
local hw = 90 * s * 0.9
local hx = x - hw + 30 + TH.reach * (px - 12 - (x - hw + 30) - hw * 0.95)
K.pic("th_hand", 90, 16, hx, py + 10, hw, 0, 0, 0.5)
local bx, by = x + 14, y + 44
smudge.rounded_rect(bx - 4, by - 4, 128, 20, 6, true, 1, false)
smudge.rect(bx, by, 120, 12, false, 1)
local lw = fl(116 * math.max(0.06, TH.look))
if TH.look > 0.75 then smudge.rect(bx + 2, by + 2, lw, 8, true) else smudge.rect_dither(bx + 2, by + 2, lw, 8, true) end
local msg
if TH.caught > 0 then msg = "CAUGHT! Stunned " .. math.ceil(TH.caught) .. "s"
elseif TH.state == "tell" then msg = "His ear twitches... stop!"
elseif TH.look > 0.75 then msg = "He's looking: don't move!"
elseif TH.hold then msg = "Reaching..."
else msg = "Hold anywhere to reach for the pouch" end
K.pill(x + L.w / 2, y + 10, msg)
K.pop(L, POP, t)
return true
end
function F.draw(S, y)
local cp = S.camp
SS = S
L = K.layout(y)
if not sel then
sel = 1
for k, a in ipairs(ACTS[2]) do if H.slevel(cp, SI) >= a[2] then sel = k end end
TH.next = plan("away")
end
local t = ms()
local dt = LAST and math.min(0.05, (t - LAST) / 1000) or 0
LAST = t
if K.hd() then step(S, dt) end
if draw_scene(S) and K.hd() then K.busy() else LAST = nil end
local a = ACTS[2][sel]
local lock = H.slevel(cp, SI) < a[2]
K.picker(ACTS[2], L.ry, sel, NAMES[sel] .. "  (Lv " .. a[2] .. ")",
lock and ("Needs Thieving level " .. a[2]) or string.format("%d-%d coins by hand  Â·  +%d xp", a[4] * 3, a[5] * 3, a[3]), function(d)
if TH.hold then return end
sel = (sel - 1 + d) % #ACTS[2] + 1; TH.reach = 0; TH.state = "away"; TH.next = plan("away"); TH.look = 0
end, "TH")
local bw = fl((X.W - 48 - 6) / 2)
X.button(24, L.by, bw, 52, "CRACK A SAFE", function() X.go("safe") end, { font = "small", id = "SAFE", nohelp = true })
X.button(24 + bw + 6, L.by, X.W - 48 - bw - 6, 52, "QUICK", function() H.do_act(S, SI, sel) end,
{ font = "small", id = "THQUICK", sub = "the dice, old way", off = lock, nohelp = true })
end
F.state = function() return TH end
return F
end
wheel.lua
8062
return function(X, K, C, HP)
local WM = {}
local W, H = X.W, X.H
local fl = math.floor
local head, back_btn = K.head, K.back_btn
local function TOPY() return K.top() end
local function ms() return X.millis() end
local busy, after, run_timers = HP.busy, HP.after, HP.run_timers
local stake, payout, flush = HP.stake, HP.payout, HP.flush
local SEG = { 0, 1, 0, 0.5, 0, 2, 0, 1, 0.5, 0, 1.5, 0, 1, 0.5, 0, 10, 0, 0.5, 1, 0, 2, 0.5, 0, 1 }
local COL = { [0] = 1, [0.5] = 3, [1] = 2, [1.5] = 5, [2] = 7, [10] = 4 }
local NSEG = #SEG
local BETS = { 10, 20, 50, 100, 200, 500, 1000, 2000, 5000, 10000 }
local WH = { ang = 0, bi = 1, hist = {} }
do
local b = tonumber(smudge.load("wheelbet", "") or "")
if b then for i, v in ipairs(BETS) do if v == b then WH.bi = i end end; if BETS[WH.bi] ~= b and b >= 1 then WH.cust = fl(b) end end
end
local function bet() return WH.cust or BETS[WH.bi] end
local function save_bet() smudge.save("wheelbet", tostring(bet())) end
local function label(m) return (m == 0) and "0" or (m == fl(m) and (fl(m) .. "x") or (tostring(m) .. "x")) end
local function spin(S)
if WH.t0 or HP.pad_is_open() then return end
local v = bet()
if not stake(S, v, true) then return end
local seg = WH.force or X.rnd(1, NSEG); WH.force = nil
local step = 2 * math.pi / NSEG
local off = (X.rnd(-35, 35) / 100) * step
local target = -((seg - 0.5) * step + off)
local turns = X.rnd(5, 7)
local from = WH.ang
local to = target - 2 * math.pi * turns
while to > from - 2 * math.pi * turns do to = to - 2 * math.pi end
WH.t0, WH.from, WH.to, WH.dur, WH.seg, WH.bet = ms(), from, to, X.rnd(5200, 6400), seg, v
WH.res, WH.lastPeg = nil, math.floor(from / step)
SND.play("slot_lever", 0.6)
VIB.play("t1", true)
end
local function settle(S, now)
local m = SEG[WH.seg]
local won = fl(WH.bet * m + 0.5)
WH.res = { m = m, amt = won, t0 = now }
table.insert(WH.hist, 1, m); while #WH.hist > 10 do table.remove(WH.hist) end
if won > 0 then payout(S, won, W / 2, H * 0.4, false) end
if m >= 10 then
SND.play("slot_jackpot", 0.9); GFX.flash(255, 220, 120, 600, 0.6); GFX.shake(8, 700)
if GFX.ok() then GFX.confetti(W / 2, H * 0.3, { 255, 200, 60 }, 120) end
X.set_note("x10! " .. won .. " coins!")
elseif m >= 2 then SND.play("win_big", 0.8); if GFX.ok() then GFX.confetti(W / 2, H * 0.3, { 255, 220, 120 }, 50) end
elseif m >= 1 then SND.play("win_small", 0.7)
elseif m > 0 then SND.play("slot_count", 0.5)
else SND.play("slot_glose", 0.6) end
flush()
end
function C.draw_fortune(S)
run_timers()
head(S, "Wheel of Fortune", "")
if HP.pad_is_open() then HP.pad(S); back_btn("casino"); return end
local now = ms()
local t = now / 1000
local y = TOPY() + 6
local step = 2 * math.pi / NSEG
if WH.t0 then
local u = math.min(1, (now - WH.t0) / WH.dur)
local e = 1 - (1 - u) ^ 4
WH.ang = WH.from + (WH.to - WH.from) * e
local peg = math.floor(WH.ang / step)
if peg ~= WH.lastPeg then
WH.lastPeg = peg; WH.flap = now
if now - (WH.lastTick or 0) > 35 then SND.play("slot_tick", 0.45); WH.lastTick = now end
if u > 0.75 then VIB.play("sf_tick", true) end
end
busy()
if u >= 1 then WH.t0 = nil; WH.ang = WH.to; settle(S, now) end
end
local cyc0 = H - 96 - 118
local R = fl(math.min(W * 0.46, (cyc0 - y - 30 - 90) * 0.5))
local extra = math.max(0, (cyc0 - y) - (2 * R + 30 + 90)) // 2
local cx, cy = W / 2, y + 30 + R + extra
smudge.circle(fl(cx), fl(cy), R + 14, true)
smudge.circle(fl(cx), fl(cy), R + 10, false, 2, false)
if HP.tint_rr then HP.tint_rr(cx - R - 14, cy - R - 14, 2 * R + 28, 2 * R + 28, R + 14, 4, 1) end
local win = WH.res and not WH.t0 and WH.seg
for i = 1, NSEG do
local a0 = WH.ang + (i - 1) * step - math.pi / 2
local a1 = a0 + step
local am = (a0 + a1) / 2
local m = SEG[i]
local function pt(a, r) return cx + math.cos(a) * r, cy + math.sin(a) * r end
local ax, ay = pt(a0, R); local mx, my = pt(am, R * 1.01); local bx, by = pt(a1, R)
smudge.fill_quad(cx, cy, ax, ay, mx, my, bx, by, true, COL[m], true)
smudge.line(fl(cx), fl(cy), fl(ax), fl(ay), 1, false)
local lx, ly = pt(am, R * 0.78)
local f = (m >= 10) and "ui12" or "small"
X.ctext(fl(lx), fl(ly) - X.lh(f) // 2, label(m), f, "bold", true)
if GFX.ok() then
if m >= 10 then smudge.glow_circle(lx, ly, R * 0.16, 255, 210, 90, 0.9 + 0.4 * math.sin(t * 5)) end
if win == i then
smudge.glow_quad(cx, cy, ax, ay, mx, my, bx, by, 255, 240, 180, 0.6 + 0.4 * math.sin(t * 8)); busy()
end
end
end
for i = 1, NSEG do
local a = WH.ang + (i - 1) * step - math.pi / 2
local px, py = cx + math.cos(a) * (R + 5), cy + math.sin(a) * (R + 5)
smudge.circle(fl(px), fl(py), 3, true, 1, false)
if GFX.ok() then
local lit = WH.t0 and ((now // 70 + i) % 4 == 0) or (not WH.t0 and (now // 400 + i) % 6 == 0)
smudge.glow_circle(px, py, lit and 6 or 3, 255, 220, 140, lit and 1.5 or 0.3)
end
end
smudge.circle(fl(cx), fl(cy), fl(R * 0.2), true)
smudge.circle(fl(cx), fl(cy), fl(R * 0.2) - 4, false, 2, false)
if HP.tint_rr then HP.tint_rr(cx - R * 0.2, cy - R * 0.2, R * 0.4, R * 0.4, R * 0.2, 4, 1) end
X.ctext(fl(cx), fl(cy) - X.lh("small") // 2, WH.t0 and "..." or (WH.res and label(WH.res.m) or "SPIN"), "small", "bold", true)
if GFX.ok() then smudge.glow_quad(cx - R * 0.7, cy - R * 0.85, cx - R * 0.3, cy - R * 0.95, cx + R * 0.1, cy - R * 0.2, cx - R * 0.4, cy - R * 0.05, 255, 255, 255, 0.12) end
local fa = WH.flap and math.max(0, 1 - (now - WH.flap) / 90) or 0
local tip = cy - R + 18
local px0 = cx + fa * 6
smudge.fill_quad(px0 - 16, cy - R - 26, px0 + 16, cy - R - 26, cx + 1, tip, cx - 1, tip, true, 6, true)
smudge.triangle(fl(px0 - 16), fl(cy - R - 26), fl(px0 + 16), fl(cy - R - 26), fl(cx), fl(tip), false, 2)
smudge.circle(fl(px0), fl(cy - R - 24), 6, true)
local ry = cy + R + 22
if WH.res and not WH.t0 then
local m = WH.res.m
local txt = (m == 0) and "Nothing this time" or (label(m) .. ":  +" .. WH.res.amt .. " coins")
X.ctext(W / 2, ry, txt, "ui12", "bold")
if GFX.ok() and m >= 2 then smudge.glow_circle(W / 2, ry + 12, 90, 255, 210, 100, 0.5 + 0.3 * math.sin(t * 6)); busy() end
else
X.ctext(W / 2, ry, WH.t0 and "Round and round..." or "Where will it stop?", "ui10", "bold")
end
local hy = ry + 36
local n = #WH.hist
if n > 0 then
local hw = 40
local x0 = (W - n * (hw + 4)) // 2
for i, m in ipairs(WH.hist) do
local hx = x0 + (i - 1) * (hw + 4)
smudge.rounded_rect(hx, hy, hw, 24, 8, true)
if HP.tint_rr then HP.tint_rr(hx, hy, hw, 24, 8, COL[m], 1) end
X.ctext(hx + hw // 2, hy + 12 - X.lh("small") // 2, label(m), "small", "bold", true)
end
end
local cyc = H - 96 - 118
local locked = WH.t0 ~= nil
local spw = fl((W - 48) * 0.42)
local lw = W - 48 - spw - 10
local aw = 46
local bx0 = 24 + aw + 5
local bw0 = lw - 2 * aw - 10
X.button(24, cyc, aw, 48, "<", function()
if WH.cust then local nb = 1; for i, v in ipairs(BETS) do if v < WH.cust then nb = i end end; WH.cust = nil; WH.bi = nb
else WH.bi = math.max(1, WH.bi - 1) end
save_bet(); SND.play("chip", 0.5)
end, { off = locked or (not WH.cust and WH.bi <= 1), id = "WBETDN", font = "ui12" })
X.button(bx0 + bw0 + 5, cyc, aw, 48, ">", function()
if WH.cust then local nb = #BETS; for i = #BETS, 1, -1 do if BETS[i] > WH.cust then nb = i end end; WH.cust = nil; WH.bi = nb
else WH.bi = math.min(#BETS, WH.bi + 1) end
save_bet(); SND.play("chip", 0.5)
end, { off = locked or (not WH.cust and WH.bi >= #BETS), id = "WBETUP", font = "ui12" })
smudge.rounded_rect(bx0, cyc, bw0, 48, 10, true)
smudge.rounded_rect(bx0 + 3, cyc + 3, bw0 - 6, 42, 8, false, 1, false)
X.ctext(bx0 + bw0 / 2, cyc + 3, "BET", "small", "bold", true)
X.ctext(bx0 + bw0 / 2, cyc + 18, HP.short(bet()), "ui12", "bold", true)
X.reg("WBET", bx0, cyc, bw0, 48, function()
if locked then return end
HP.pad_open(function(v) WH.cust = v; for i, x in ipairs(BETS) do if x == v then WH.cust = nil; WH.bi = i end end; save_bet() end)
end, false)
smudge.rounded_rect(24, cyc + 56, lw, 48, 10, false, 1)
X.ctext(24 + lw / 2, cyc + 56 + 24 - X.lh("small") // 2, "x0 .. x10: 96% back", "small", "bold")
HP.spin_btn(W - 24 - spw, cyc, spw, 100, WH.t0 and "..." or "SPIN", nil, not WH.t0, function() spin(S) end, "WSPIN", now)
back_btn("casino")
end
WM.WH = WH
WM.spin = spin
return WM
end
wiki.lua
12547
return function(X, K, C, ADV)
local WK = {}
local W, H = X.W, X.H
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local ST = { open = false, q = "", mode = "kb", page = 0, sel = nil, ipage = 0 }
local function I(id) return IDX[id] end
local function S0() return X.state and X.state() end
local function all_tables(cp)
local T = {}
local CB, G = ADV.CB, ADV.G
local function add(prefix, fn)
local ok, t, rows, sub = pcall(fn)
if ok and t then T[#T + 1] = { prefix .. t, rows, function() ADV.show_drops(fn()) end } end
end
for k = 1, #CB.MON do add("Slayer: ", function() return CB.drops_slayer(k) end) end
for k = 1, #ADV.LAIRS do add("Boss lair: ", function() return ADV.lair_drops(cp, k) end) end
for bi = 1, #G.WBOSS do add("World boss: ", function() return CB.drops_wb(cp, bi) end) end
add("Raid: ", function() return CB.drops_raid() end)
add("Minigame: ", function() return CB.drops_todt() end)
add("", function() return ADV.wild_drops() end)
for k = 1, #ADV.R.inst_list() do add("Instance: ", function() return ADV.R.inst_drops(cp, k) end) end
for k = 1, #ADV.WO.REGIONS do add("World map: ", function() return ADV.WO.region_drops(k) end) end
return T
end
local function row_matches(rn, name)
if rn == name then return true end
if rn:sub(1, 5) == "PET: " and (rn:sub(6) .. " (pet)") == name then return true end
if rn:sub(-6) == " piece" and name:sub(1, #rn - 6) == rn:sub(1, -7) then return true end
return false
end
local function mats(r)
local p = {}
for _, nd in ipairs(r[4]) do p[#p + 1] = (nd[2] > 1 and (nd[2] .. " ") or "") .. ITEMS[nd[1]][1] end
if r[6] then p[#p + 1] = "a " .. ITEMS[r[6]][1]:lower() .. " (tool)" end
return table.concat(p, " + ")
end
local SPECIAL = {
slhelm = "Slayer shop (Slayer master): 200 Slayer points",
torso = "Barbarian Assault (minigame): 400 honour points",
ang1 = "Fishing Trawler (minigame): rare reward after a good trip", ang2 = "Fishing Trawler (minigame): rare reward after a good trip",
ang3 = "Fishing Trawler (minigame): rare reward after a good trip", ang4 = "Fishing Trawler (minigame): rare reward after a good trip",
frog = "Skilling: a frog hops by now and then (1 in 1500 actions)",
nest = "Woodcutting: any tree, about 1/100 per log (2x with the Menagerie or in Nest week)",
usapph = "Mining: any rock, about 1/83 per ore; 50% of gems are sapphires",
uemer = "Mining: any rock, about 1/83 per ore; 30% of gems are emeralds",
uruby = "Mining: any rock, about 1/83 per ore; 15% of gems are rubies",
udia = "Mining: any rock, about 1/83 per ore; 5% of gems are diamonds",
maxcape = "Reach level 99 in every skill",
qcape = "Complete every quest",
}
local function sources(cp, i)
local get, use = {}, {}
local name = ITEMS[i][1]
local id
for k, v in pairs(IDX) do if v == i then id = k end end
for si = 1, 4 do
for _, g in ipairs(K.GATHER[si]) do
if g[4] == i then
local t = string.format("%s Lv %d: %s", SK[si].name, g[2], g[1])
if g[3] and g[3] > 0 then t = t .. " (" .. K.GEAR[g[3]][1] .. ")" end
if g[8] then t = t .. " (uses " .. ITEMS[g[8]][1] .. ")" end
if g[9] then t = t .. ", " .. g[9] .. " quest points" end
get[#get + 1] = t
end
if g[8] == i then use[#use + 1] = string.format("Needed at %s (%s Lv %d), kept forever", g[1], SK[si].name, g[2]) end
end
end
for _, cr in ipairs(K.CROPS) do
if cr[8] == i then get[#get + 1] = string.format("Farming Lv %d: plant %s seeds (%dc, %d min)", cr[2], cr[1], cr[7], cr[3]) end
end
for si = 1, #SK do
for _, r in ipairs(K.REC[si] or {}) do
if r[5].id == i then get[#get + 1] = string.format("%s Lv %d: %s", SK[si].name, r[2], mats(r)) end
for _, nd in ipairs(r[4]) do
if nd[1] == i then use[#use + 1] = string.format("%s Lv %d: %s", SK[si].name, r[2], r[1]) end
end
if r[6] == i then use[#use + 1] = string.format("Tool for %s: %s", SK[si].name, r[1]) end
end
end
for _, st in ipairs(K.STORES) do
for _, sid in ipairs(st[3]) do if I(sid) == i then get[#get + 1] = string.format("SHOP > %s: %d coins", st[2], ITEMS[i][2]) end end
end
for _, s2 in ipairs(K.SHOP_ITEMS) do if s2 == i then get[#get + 1] = "SHOP > DEALS: sometimes in the daily deals" end end
local groups, order, cat_n = {}, {}, {}
for _, t in ipairs(all_tables(cp)) do
local cat, mon = t[1]:match("^(.-): (.*)$")
if not cat then cat, mon = t[1], nil end
cat_n[cat] = (cat_n[cat] or 0) + 1
for _, r in ipairs(t[2]) do
if row_matches(r[1], name) then
local key = cat .. "|" .. ADV.chance_text(r[3]) .. "|" .. r[2]
if not groups[key] then groups[key] = { cat = cat, ch = ADV.chance_text(r[3]), amt = r[2], mons = {} }; order[#order + 1] = key end
if mon then table.insert(groups[key].mons, mon) end
end
end
end
for _, key in ipairs(order) do
local g = groups[key]
local who
if #g.mons == 0 then who = g.cat
elseif #g.mons == cat_n[g.cat] and #g.mons > 2 then who = g.cat .. ": every monster"
else who = g.cat .. ": " .. table.concat(g.mons, ", ") end
get[#get + 1] = string.format("%s: %s%s", who, g.ch, (g.amt ~= "1") and (" (" .. g.amt .. ")") or "")
end
for _, q in ipairs(ADV.QUESTS or {}) do
if q[5] and q[5].item and I(q[5].item) == i then get[#get + 1] = "Quest reward: " .. q[1] end
end
for t, list in ipairs(ADV.CLUE_U or {}) do
for _, cid in ipairs(list) do if I(cid) == i then get[#get + 1] = ({ "Easy", "Medium", "Hard" })[t] .. " clue scroll casket (rare)" end end
end
for _, s2 in ipairs(ADV.G.STAR_SHOP or {}) do
local nm = s2[1]:gsub(" %(.*%)", "")
if nm == name or (id and id:match("^pr%d") and s2[1]:find("^Prospector")) then get[#get + 1] = string.format("Stardust shop (shooting star): %d stardust", s2[2]) end
end
if id and id:match("^pet%d+$") then
local si = tonumber(id:sub(4))
if SK[si] then get[#get + 1] = string.format("Pet: rare while training %s, %s per action", SK[si].name, ADV.chance_text(ADV.p(3000, true))) end
end
if id and id:match("^cape%d+$") then
local si = tonumber(id:sub(5))
if SK[si] then get[#get + 1] = "Reach level 99 in " .. SK[si].name end
end
if id and SPECIAL[id] then get[#get + 1] = SPECIAL[id] end
if #get == 0 then
for _, ln in ipairs(K.item_info(i)) do if ln:find("^Get it from") then get[#get + 1] = ln:gsub("^Get it from: ", "") end end
end
return get, use
end
WK.sources = sources
local function results(cp)
local q = ST.q:lower()
local out = {}
if q == "" then return out end
for i = 1, #ITEMS do
if ITEMS[i][1]:lower():find(q, 1, true) then out[#out + 1] = { kind = "item", i = i, name = ITEMS[i][1] } end
end
for _, t in ipairs(all_tables(cp)) do
if t[1]:lower():find(q, 1, true) then out[#out + 1] = { kind = "mon", name = t[1], open = t[3] } end
end
return out
end
WK.results = function(cp) return results(cp) end
function C.wiki_open() ST.open = true; ST.mode = "kb"; ST.page = 0; ST.sel = nil end
function C.wiki_is_open() return ST.open end
function C.wiki_close() ST.open = false end
function C.wiki_back()
if ST.mode == "item" then ST.mode = "list"; ST.sel = nil
elseif ST.mode == "kb" and ST.q ~= "" then ST.mode = "list"
else ST.open = false end
end
WK.ST = ST
local function panel_box()
local x0, y0 = 12, X.bar_h() + 8
local w, h = W - 24, H - 108 - y0
X.reg("WIKIBLOCK", 0, 0, W, H, function() end)
if X.glass_cut then X.glass_cut(x0, y0, w + 6, h + 6) end
if not X.saver() then smudge.rounded_rect(x0 + 6, y0 + 6, w, h, 14, true) end
smudge.rounded_rect(x0, y0, w, h, 14, true, 1, false)
smudge.rounded_rect(x0, y0, w, h, 14, false, 3)
return x0, y0, w, h
end
local function search_field(x0, y0, w)
X.ltext(x0 + 16, y0 + 12, "Search", "ui12", "bold")
X.button(x0 + w - 100, y0 + 8, 88, 36, "CLOSE", function() ST.open = false end, { font = "small", id = "WIKICLOSE", nohelp = true })
X.button(x0 + 12, y0 + 50, w - 24, 46, "", function() ST.mode = "kb" end, { id = "WIKIFIELD", nohelp = true })
X.ltext(x0 + 26, y0 + 62, (ST.q == "" and "item, monster or boss..." or ST.q) .. (ST.mode == "kb" and "_" or ""), "ui10", ST.q ~= "" and "bold" or nil)
end
local function draw_kb(S, x0, y0, w, h)
local n = #results(S.camp)
X.ctext(W / 2, y0 + 104, ST.q == "" and "type a name or part of it" or (n .. " result" .. (n == 1 and "" or "s")), "small")
X.keyboard({ id = "WKEY", bottom = y0 + h - 10,
key = function(ch) if #ST.q < 18 then ST.q = ST.q .. ch:lower(); ST.page = 0 end end,
actions = { { "SPACE", function() if #ST.q < 18 and ST.q ~= "" then ST.q = ST.q .. " " end end, false, "WKEYSPACE" },
{ "DELETE", function() ST.q = ST.q:sub(1, -2); ST.page = 0 end, ST.q == "", "WKEYDEL" },
{ "CLEAR", function() ST.q = ""; ST.page = 0 end, ST.q == "", "WKEYCLR" },
{ "SHOW", function() ST.mode = "list"; ST.page = 0 end, n == 0, "WIKIGO" } } })
end
local function draw_list(S, x0, y0, w, h)
local list = results(S.camp)
local ly = y0 + 108
local rh = 54
local per = math.max(1, (y0 + h - 70 - ly) // rh)
local pages = math.max(1, math.ceil(#list / per))
if ST.page >= pages then ST.page = pages - 1 end
if #list == 0 then X.ctext(W / 2, ly + 20, "Nothing found. Tap the search bar to change it.", "small") end
local sc = X.scrolling and X.scrolling()
local rw = w - 24 - (sc and 14 or 0)
local function wrow(n, k, by)
local e = list[n]
if e then
X.button(x0 + 12, by, rw, rh - 6, "", function()
if e.kind == "item" then ST.sel = e.i; ST.mode = "item"; ST.ipage = 0 else e.open() end
end, { id = "WRES" .. k, nohelp = true })
if e.kind == "item" then
smudge.draw_sprite(x0 + 22, by + 11, 24, 24, "art/" .. ITEMS[e.i][3] .. ".raw")
X.ltext(x0 + 56, by + 4, X.fit(e.name, w - 90, "ui10", "bold"), "ui10", "bold")
local have = S.camp.inv[e.i] + K.inv_n(e.i)
X.ltext(x0 + 56, by + 26, "item" .. (have > 0 and ("   you have " .. have) or ""), "small")
else
X.ltext(x0 + 24, by + 4, X.fit(e.name, w - 60, "ui10", "bold"), "ui10", "bold")
X.ltext(x0 + 24, by + 26, "drop table", "small")
end
end
end
local ny = y0 + h - 62
local tw3 = (w - 24 - 12) // 3
if not X.list("wiki" .. ST.q, ly, ny + 50 - ly, #list, rh, function(n, by) wrow(n, n, by) end, x0 + 8, rw + 8) then
for k = 1, per do wrow(ST.page * per + k, k, ly + (k - 1) * rh) end
X.button(x0 + 12, ny, tw3, 50, "PREV", function() if ST.page > 0 then ST.page = ST.page - 1 end end, { font = "ui10", off = ST.page == 0, id = "WPREV", nohelp = true })
X.ctext(x0 + 18 + tw3 + tw3 // 2, ny + 14, string.format("%d / %d", ST.page + 1, pages), "ui10", "bold")
X.button(x0 + 24 + 2 * tw3, ny, tw3, 50, "NEXT", function() if ST.page < pages - 1 then ST.page = ST.page + 1 end end, { font = "ui10", off = ST.page >= pages - 1, id = "WNEXT", nohelp = true })
end
end
local function draw_item(S, x0, y0, w, h)
local i = ST.sel
local cp = S.camp
local iy = y0 + 104
smudge.draw_sprite(x0 + 18, iy + 4, 24, 24, "art/" .. ITEMS[i][3] .. ".raw")
X.ltext(x0 + 52, iy, X.fit(ITEMS[i][1], w - 70, "ui12", "bold"), "ui12", "bold")
X.ltext(x0 + 52, iy + 30, string.format("Value %d coins   You have %d", ITEMS[i][2], cp.inv[i] + K.inv_n(i)), "small")
local get, use = sources(cp, i)
local lines = {}
local function add(t, bold) lines[#lines + 1] = { t, bold } end
for k, ln in ipairs(K.item_info(i)) do if not ln:find("^Get it from") then add(ln) end end
add("HOW TO GET IT", true)
for _, t in ipairs(get) do add("- " .. t) end
if #use > 0 then add("USED FOR", true); for _, t in ipairs(use) do add("- " .. t) end end
local wrapped = {}
for _, l in ipairs(lines) do
local res = smudge.wrapped_text(l[1], w - 36, "small", l[2] and "bold" or "regular", 6)
for _, t in ipairs(res.lines) do wrapped[#wrapped + 1] = { t, l[2] } end
end
local ty = iy + 60
local lhh = X.lh("small") + 4
local per = math.max(1, (y0 + h - 70 - ty) // lhh)
local pages = math.max(1, math.ceil(#wrapped / per))
if ST.ipage >= pages then ST.ipage = pages - 1 end
for k = 1, per do
local l = wrapped[ST.ipage * per + k]
if l then X.ltext(x0 + 18, ty + (k - 1) * lhh, l[1], "small", l[2] and "bold" or nil) end
end
local ny = y0 + h - 62
local tw3 = (w - 24 - 12) // 3
X.button(x0 + 12, ny, tw3, 50, "RESULTS", function() ST.mode = "list"; ST.sel = nil end, { font = "small", id = "WBACK", nohelp = true })
X.button(x0 + 18 + tw3, ny, tw3, 50, "UP", function() if ST.ipage > 0 then ST.ipage = ST.ipage - 1 end end, { font = "ui10", off = ST.ipage == 0, id = "WUP", nohelp = true })
X.button(x0 + 24 + 2 * tw3, ny, tw3, 50, "MORE", function() if ST.ipage < pages - 1 then ST.ipage = ST.ipage + 1 end end,
{ font = "ui10", sub = (ST.ipage + 1) .. "/" .. pages, off = ST.ipage >= pages - 1, id = "WMORE", nohelp = true })
end
function C.draw_wiki(S)
if not ST.open or ADV.dt then return end
local x0, y0, w, h = panel_box()
search_field(x0, y0, w)
if ST.mode == "kb" then draw_kb(S, x0, y0, w, h)
elseif ST.mode == "item" and ST.sel then draw_item(S, x0, y0, w, h)
else draw_list(S, x0, y0, w, h) end
end
return WK
end
