for k = 1, 8 do
local L = LAIRS[k]
local by = y0 + (k - 1) * sp
local req = lair_req(cp, k)
X.button(20, by, W - 40, sp - 6, "", function() ADV.fight_lair(S, k) end, { id = "LAIR" .. k, off = req ~= nil })
X.chip(40, by + (sp - 6) // 2, L[2])
X.ltext(62, by + 4, L[1], "ui10", "bold")
X.ltext(62, by + sp - 30, req and ("Requires " .. req) or fit_small(L[7]), "small")
X.rtext(W - 30, by + 4, "KC " .. cp.x["kc" .. k], "small", "bold")
X.button(W - 30 - 84, by + sp - 6 - 36, 84, 30, "DROPS", function() ADV.show_drops(lair_drops(cp, k)) end, { font = "small", id = "LDROPS" .. k, nohelp = true })
end
back_btn("adventure")
end
