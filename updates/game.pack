local g, r = {}, {}
for i, t in pairs(L.GROW) do g[#g + 1] = i .. ":" .. fl(t) end
for i, t in pairs(L.RG) do r[#r + 1] = i .. ":" .. fl(t) end
return table.concat(g, ";") .. "|" .. table.concat(r, ";")
end
local function gunpack(L, raw)
local g, r = (raw or ""):match("^([^|]*)|?(.*)$")
for i, t in (g or ""):gmatch("(%d+):(%d+)") do i = tonumber(i); if IV.GROWB[L.B[i] or ""] then L.GROW[i] = tonumber(t) end end
for i, t in (r or ""):gmatch("(%d+):(%d+)") do i = tonumber(i); if not L.B[i] then L.RG[i] = tonumber(t) end end
for i, b in pairs(L.B) do if IV.GROWB[b] and not L.GROW[i] then L.GROW[i] = WD.now() end end
end
local function cpack(L)
local o = {}
for i, C in pairs(L.CHEST) do
if IV.CHESTB[L.B[i] or ""] then
local l = {}
for k = 1, 27 do local it = C.s[k]; if it then l[#l + 1] = k .. "." .. it.id .. "." .. it.n .. (it.d and ("." .. it.d) or "") end end
if #l > 0 then o[#o + 1] = i .. "=" .. table.concat(l, ",") end
end
end
return table.concat(o, "/")
end
local function cslots(txt)
local t = {}
for k, id, n, d in (txt or ""):gmatch("(%d+)%.(%w+)%.(%d+)%.?(%d*)") do
k = tonumber(k)
if k and k >= 1 and k <= 27 and IV.NAME[id] then t[k] = { id = id, n = math.max(1, math.min(64, tonumber(n))), d = tonumber(d) } end
end
return t
end
local function cunpack(L, raw)
for i, txt in (raw or ""):gmatch("(%d+)=([^/]*)") do
i = tonumber(i)
if IV.CHESTB[L.B[i] or ""] then L.CHEST[i] = { s = cslots(txt) } end
end
end
WD.cslots = cslots
WD.DEEP = 3
WD.ORES = {
[-1] = { 0.07, { or4 = 40, or2 = 35, or3 = 20, or1 = 5 } },
[-2] = { 0.08, { or4 = 15, or3 = 35, or1 = 32, or6 = 18 } },
[-3] = { 0.09, { or1 = 22, or6 = 30, or5 = 26, or7 = 16, or8 = 6 } },
}
function WD.makez(z)
local L = { G = {}, B = {}, OPEN = {}, CHG = {}, GCH = {}, FURN = {}, GROW = {}, RG = {}, CHEST = {}, z = z }
local S = (WD.SEED or 0) + 7919 * (-z)
local rock = (z <= -3) and "b03" or "b05"
local O = WD.ORES[z] or WD.ORES[-1]
local tot = 0
for _, w in pairs(O[2]) do tot = tot + w end
local names = {}
for id in pairs(O[2]) do names[#names + 1] = id end
table.sort(names)
for y = 0, N - 1 do for x = 0, N - 1 do
local i = y * N + x
L.G[i] = "di1"
local cave = vnoise(x, y, 9, 101 + S * 3) * 0.65 + vnoise(x, y, 3.5, 211 + S * 5) * 0.35
if cave < 0.6 then
local b = rock
if hash(x * 5 + S, y * 11 + 3) < O[1] then
local r = hash(x + 77 + S, y * 3 + 5) * tot
for _, id in ipairs(names) do r = r - O[2][id]; if r < 0 then b = id; break end end
end
L.B[i] = b
end
end end
return L
end
function WD.lv(z)
z = z or WD.Z
local L = WD.LV[z]
if L then return L end
L = WD.makez(z)
WD.LV[z] = L
lunpack(L, fields(smudge.load(WKEY .. "_u" .. (-z), "") or ""), 1)
gunpack(L, smudge.load(WKEY .. "_grow" .. (-z), "") or "")
cunpack(L, smudge.load(WKEY .. "_chest" .. (-z), "") or "")
return L
end
function WD.go(z)
local L = WD.lv(z)
WD.Z = z
WD.G, WD.B, WD.OPEN, WD.CHG, WD.GCH, WD.FURN, WD.CHEST = L.G, L.B, L.OPEN, L.CHG, L.GCH, L.FURN, L.CHEST
if WD.MAP then WD.MAP.dirty = true; WD.MAP.mini = nil; WD.MAP.tp = nil end
end
function WD.gi(i, z) return i + (-(z or WD.Z)) * N * N end
function WD.split(g)
g = tonumber(g)
if not g or g < 0 or g >= N * N * (WD.DEEP + 1) then return nil end
return g % (N * N), -(g // (N * N))
end
local function save()
smudge.save(WKEY, string.format("%d,%d|%s|%d|%d", fl(PL.x), fl(PL.y), lpack(WD.LV[0]), fl(WD.WX.T), WD.Z))
for z, L in pairs(WD.LV) do
if z < 0 then smudge.save(WKEY .. "_u" .. (-z), lpack(L)) end
smudge.save(WKEY .. "_grow" .. (-z), gpack(L))
smudge.save(WKEY .. "_chest" .. (-z), cpack(L))
end
smudge.save(WKEY .. "_inv", pack(IV.S, 36) .. "/" .. pack(IV.A, 4) .. "/" .. pack(IV.C, 4))
local wp = {}
for _, w in ipairs(WD.WP) do wp[#wp + 1] = w.x .. "," .. w.y .. "," .. w.c .. "," .. (-(w.z or 0)) end
smudge.save(WKEY .. "_wp", (#wp > 0) and table.concat(wp, ";") or "none")
dirty, lastSave = false, ms()
end
local function load()
WD.make()
WD.LV = { [0] = { G = WD.G, B = WD.B, OPEN = WD.OPEN, CHG = WD.CHG, GCH = WD.GCH, FURN = WD.FURN, GROW = {}, RG = {}, CHEST = {}, z = 0 } }
WD.Z = 0
local f = fields(smudge.load(WKEY, "") or "")
local a, b = (f[1] or ""):match("^(%-?%d+),(%-?%d+)")
PL.x, PL.y = tonumber(a) or (N / 2 + 0.5) * TS, tonumber(b) or (N / 2 + 0.5) * TS
lunpack(WD.LV[0], f, 2)
gunpack(WD.LV[0], smudge.load(WKEY .. "_grow0", "") or "")
cunpack(WD.LV[0], smudge.load(WKEY .. "_chest0", "") or "")
WD.CHEST = WD.LV[0].CHEST
WD.WX.T = tonumber(f[6] or "") or 96
IV.S, IV.A, IV.C, IV.T, IV.DRAG, IV.open, IV.DROPS, IV.MODE = {}, {}, {}, {}, nil, false, {}, "inv"
local a2, b2, c2 = (smudge.load(WKEY .. "_inv", "") or ""):match("^([^/]*)/([^/]*)/([^/]*)$")
unpack_into(IV.S, a2, 36); unpack_into(IV.A, b2, 4); unpack_into(IV.C, c2, 4)
WD.WP = {}
for x, y, c, z in (smudge.load(WKEY .. "_wp", "") or ""):gmatch("(%d+),(%d+),(%d),?(%d*)") do
x, y, c, z = tonumber(x), tonumber(y), tonumber(c), -(tonumber(z) or 0)
if x < N and y < N and c >= 1 and c <= 5 and z >= -WD.DEEP and #WD.WP < 5 then WD.WP[#WD.WP + 1] = { x = x, y = y, c = c, z = z } end
end
WD.animals()
local z = math.max(-WD.DEEP, math.min(0, tonumber(f[7] or "") or 0))
if z ~= 0 then WD.go(z) end
WD.onst = fl(PL.y / TS) * N + fl(PL.x / TS)
if not WD.free(PL.x, PL.y) then
for _, d in ipairs({ { 0, -8 }, { -8, 0 }, { 8, 0 }, { 0, 8 }, { -8, -8 }, { 8, -8 }, { 0, -16 }, { -16, 0 }, { 16, 0 } }) do
if WD.free(PL.x + d[1], PL.y + d[2]) then PL.x, PL.y = PL.x + d[1], PL.y + d[2]; break end
end
end
if not WD.free(PL.x, PL.y) then
if z ~= 0 then WD.go(0) end
PL.x, PL.y = (N / 2 + 0.5) * TS, (N / 2 + 0.5) * TS
end
if WD.MAP then WD.MAP.dirty = true; WD.MAP.mini = nil; WD.MAP.tp = nil; WD.MAP.open = false end
PL.face, PL.step = "down", 0
end
local NQ, CAP = 0, 200
local HMAX = (smudge.hires_max and smudge.hires_max()) or 255
local CAPW = (HMAX >= 1000) and { w = 850, all = 1020 } or { w = 192, all = 254 }
local SZ = { ui_power = { 32, 32 }, i_hand = { 16, 16 } }
local QNO, QNC = {}, {}
local JN, TN0 = {}, {}
local function TN(k) local v = TN0[k]; if not v then v = "t_" .. k; TN0[k] = v end; return v end
local TNT0 = {}
local function TNT(k) local v = TNT0[k]; if not v then v = "t_" .. k .. "_tp"; TNT0[k] = v end; return v end
local function q(nm, x0, y0, x1, y1, over)
if NQ >= CAP then return end
NQ = NQ + 1
if over then
local o = -9
local full = QNO[nm]
if not full then full = "^hd/wl_" .. nm .. "_c.png"; QNO[nm] = full end
smudge.hires_quad(full, o, o, o, o, o, o, o, o, x0, y0, x1, y0, x1, y1, x0, y1)
else
local lx, rx = x0 + 0.75, x1 - 1.75
local full = QNC[nm]
if not full then full = "hd/wl_" .. nm .. "_c.png"; QNC[nm] = full end
smudge.hires_quad(full, lx, y0, rx, y0, rx, y1, lx, y1, x0, y0, x1, y0, x1, y1, x0, y1)
end
end
local function qfit(nm, cx, cy, box)
local z = SZ[nm] or { 1, 1 }
local sc = box / math.max(z[1], z[2])
local w, h = z[1] * sc, z[2] * sc
local x0, y0 = fl(cx - w / 2), fl(cy - h / 2)
q(nm, x0, y0, x0 + fl(w + 0.5), y0 + fl(h + 0.5), true)
end
local UI, ST = {}, {}
IV.ST = ST
function UI.pic(nm, x0, y0, x1, y1, claim) q(nm, fl(x0), fl(y0), fl(x1), fl(y1), not claim) end
function UI.nine(nm, n, cut, x, y, w, h, sc)
local xs, ys = { 0, cut, n - cut, n }, { 0, cut, n - cut, n }
local dx, dy = { x, x + cut * sc, x + w - cut * sc, x + w }, { y, y + cut * sc, y + h - cut * sc, y + h }
for i = 1, 3 do for j = 1, 3 do
if NQ < CAP then
NQ = NQ + 1
local kx, ky = (dx[i + 1] - dx[i]) / (xs[i + 1] - xs[i]), (dy[j + 1] - dy[j]) / (ys[j + 1] - ys[j])
local px0, py0 = dx[i] - xs[i] * kx, dy[j] - ys[j] * ky
local px1, py1 = px0 + n * kx, py0 + n * ky
local lx, rx, ty, by = fl(dx[i]) + 0.75, fl(dx[i + 1]) - 1.75, fl(dy[j]), fl(dy[j + 1])
smudge.hires_quad("hd/wl_" .. nm .. "_c.png", lx, ty, rx, ty, rx, by, lx, by, px0, py0, px1, py0, px1, py1, px0, py1)
end
end end
end
function UI.btn(x, y, w, h, label, fn, o)
o = o or {}
UI.pic(o.off and "ui_btnoff" or (o.active and "ui_btnp" or "ui_btn"), x, y, x + w, y + h)
if label and label ~= "" then
local f = o.font or "small"
local fh = (f == "ui12") and 26 or (f == "ui10") and 22 or 18
if o.sub then
OT.c(fl(x + w / 2), fl(y + h / 2 - fh + 1), X.fit(label, w - 12, f), f, "bold")
OT.c(fl(x + w / 2), fl(y + h / 2 + 1), X.fit(o.sub, w - 12, "small"), "small", "regular")
else OT.c(fl(x + w / 2), fl(y + h / 2 - fh / 2 - 1), X.fit(label, w - 12, f), f, "bold") end
end
X.reg(o.id or ("WLB" .. tostring(label)), x, y, w, h, fn, false)
end
ST.HAIRN = { "Brown", "Black", "Blonde", "Ginger", "Silver", "Pink" }
ST.SHIRTN = { "Blue", "Red", "Green", "Purple", "Yellow", "Black", "White", "Orange" }
do
local g, h, sh = (smudge.load("wilds_look", "m|1|1") or "m|1|1"):match("^([mf])|(%d+)|(%d+)")
ST.look = { g = g or "m", h = tonumber(h) or 1, s = tonumber(sh) or 1 }
local raw = smudge.load("wilds_set", "0|0|1") or "0|0|1"
local fx, lh, tg = raw:match("^(%d)|(%d)|(%d)")
ST.fixed, ST.left, ST.tags = fx == "1", lh == "1", tg ~= "0"
local hb, sl, ps = raw:match("^%d|%d|%d|(%d)|(%d)|?(%d?)")
ST.ps = ps == "1"
ST.psp = tonumber(raw:match("^%d|%d|%d|%d|%d|%d|(%d)") or "") or 3
ST.hbtop = hb ~= "0"
ST.sel = math.max(1, math.min(9, tonumber(sl) or 1))
end
function ST.save()
smudge.save("wilds_look", ST.look.g .. "|" .. ST.look.h .. "|" .. ST.look.s)
smudge.save("wilds_set", (ST.fixed and "1" or "0") .. "|" .. (ST.left and "1" or "0") .. "|" .. (ST.tags and "1" or "0") ..
"|" .. (ST.hbtop and "1" or "0") .. "|" .. ST.sel .. "|" .. (ST.ps and "1" or "0") .. "|" .. (ST.psp or 3))
end
function ST.code(lk) return lk.g .. ":" .. lk.h .. ":" .. lk.s end
function ST.parse(c)
local g, h, sh = (c or ""):match("^([mf]):(%d+):(%d+)$")
if not g then return { g = "f", h = 1, s = 2 } end
return { g = g, h = math.max(1, math.min(6, tonumber(h))), s = math.max(1, math.min(8, tonumber(sh))) }
end
function UI.char(lk, cx, by, face, step, sc, use)
sc = sc or 1
local z = (sc == 1) and 3 or math.max(3, fl(60 * sc * 0.8 / 24))
local w = 24 * z
local x0, y0 = fl(cx - w / 2), fl(by - 23 * z)
local x1, y1 = x0 + w, y0 + w
local tag = use and ("use_" .. face) or (step == "i" and ("idle_" .. face)) or (face .. step)
q("ch2_base_" .. tag, x0, y0, x1, y1, true)
q("ch2_h" .. lk.h .. "_" .. tag, x0, y0, x1, y1, true)
q("ch2_s" .. lk.s .. "_" .. tag, x0, y0, x1, y1, true)
end
