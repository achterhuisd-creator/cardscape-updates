for i, g in pairs(L.GCH) do gc[#gc + 1] = i .. ":" .. g end
local function sl(it) return it and (it.id .. ":" .. it.n) or "-" end
for i, F in pairs(L.FURN) do
if L.B[i] == "fu" then fs[#fs + 1] = string.format("%d=%s,%s,%s,%d,%d,%d", i, sl(F.s[1]), sl(F.s[2]), sl(F.s[3]), fl(F.burn * 10), fl(F.bmax), fl(F.prog * 10)) end
