local fz, bz = -14, 19
local CH8 = 9
local function oct(z, ox, oy)
local pts = { kx0 + CH8, ky0, kx1 - CH8, ky0, kx1, ky0 + CH8, kx1, ky1 - CH8, kx1 - CH8, ky1, kx0 + CH8, ky1, kx0, ky1 - CH8, kx0, ky0 + CH8 }
local r = {}
for m = 0, 7 do local a, b2 = P(pts[m * 2 + 1], pts[m * 2 + 2], z); r[m * 2 + 1] = a + (ox or 0); r[m * 2 + 2] = b2 + (oy or 0) end
return r
end
local function fill_oct(r, black, tint)
smudge.fill_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[15], r[16], black, tint)
smudge.fill_quad(r[15], r[16], r[5], r[6], r[7], r[8], r[13], r[14], black, tint)
