function GFX.vista(by, bh)
local t = smudge.millis() / 1000
local ph = (C and C.sky) and C.sky() or 2
local fx = GFX.ok()
local iy = by
if smudge.set_clip then smudge.set_clip(0, by, W, bh) end
GFX.skyband(by, bh, iy, ph, GFX.HSTARS, 396, 24)
ttint(0, by, W, bh, TT.panel)
if ph <= 2 and fx then
for b = 0, 2 do
local u = ((t * 0.035 + b * 0.31) % 1.3) - 0.15
local x, y = math.floor(u * W), iy + 30 + b * 9 + math.floor(math.sin(t * 0.8 + b) * 4)
local f = (math.sin(t * 7 + b * 2) > 0) and 2 or 0
smudge.line(x - 4, y - f, x, y, 1); smudge.line(x, y, x + 4, y - f, 1)
end
end
if GFX.skylight(by, bh, iy) then
GFX.pic("home_scene", by, bh, iy, true)
smudge.glass_sprite_quad("art/home_scene_m.raw", 480, 240, 0, iy, W, iy, W, iy + 240, 0, iy + 240, -1, 0, 0)
else
GFX.pic("home_scene", by, bh, iy, true)
end
local fog = fx and smudge.glass_sprite_quad and not SAVER
for j, c in ipairs(GFX.CHIMNEY) do
for p = 0, (fog and 7 or 4) do
local n = fog and 8 or 5
local a = fx and ((t * (fog and 0.11 or 0.18) + j * 0.27 + p / n) % 1) or (p / n)
local x = c[1] + math.sin(a * 3 + j + t * 0.4) * 2.5 + a * 18
local y = iy + c[2] - a * 40
if fog then
local r = 3 + a * 11
local al = 0.16 * math.min(1, a * 6) * (1 - a) ^ 1.3
for k = 0, 2 do
local rr = r * (1 - k * 0.3)
smudge.glass_sprite_quad("art/puff_m.raw", 32, 32, x - rr, y - rr * 0.8, x + rr, y - rr * 0.8, x + rr, y + rr * 0.8, x - rr, y + rr * 0.8,
ph >= 3 and 150 or 235, ph >= 3 and 150 or 235, ph >= 3 and 160 or 238, al)
end
else
local r = (1.5 + a * 4.5) * (a < 0.8 and 1 or (1 - a) * 5)
if r >= 1 then
smudge.circle(math.floor(x), math.floor(y), math.floor(r + 0.5), true, 1, false)
smudge.circle(math.floor(x), math.floor(y), math.floor(r + 0.5), false, 1, true)
end
end
end
end
if fx then
if ph >= 3 then
for i, w in ipairs(GFX.HWIN) do
local fl = 0.8 + 0.2 * math.sin(t * (2 + i % 3) + i)
if fl > 0.66 or i % 4 ~= 0 then
smudge.rect(w[1] - 1, iy + w[2] - 1, 2, 2, false); smudge.tint(w[1] - 1, iy + w[2] - 1, 2, 2, 4, 2)
end
smudge.glow_circle(w[1], iy + w[2], 5, 255, 190, 90, (ph == 4 and 2.2 or 1.4) * fl)
end
for i = 1, 9 do
local u = t * 0.07 + i * 0.37
local x = 30 + (i * 53) % 220 + math.sin(u * 2.3 + i) * 14
local y = iy + 196 + (i * 17) % 34 + math.sin(u * 3.1 + i * 2) * 6
local on = math.sin(t * (1.3 + (i % 3) * 0.4) + i * 1.7)
if on > 0.2 then
smudge.rect(math.floor(x), math.floor(y), 1, 1, false); smudge.tint(math.floor(x), math.floor(y), 1, 1, 2, 2)
smudge.glow_circle(x, y, 4, 200, 255, 120, 1.6 * (on - 0.2))
end
end
else
for i, r in ipairs(GFX.RIVER) do
local a = math.sin(t * (1.3 + i * 0.2) + i * 1.9)
if a > 0.4 then smudge.glow_quad(r[1] - 6, iy + r[2], r[1] + 6, iy + r[2], r[1] + 4, iy + r[2] + 1.5, r[1] - 4, iy + r[2] + 1.5, 230, 245, 255, 2.4 * (a - 0.4)) end
end
end
GFX.live = true
end
reg("KINGDOM", 0, by, W, bh, function() go("worldmap") end)
if smudge.set_clip then smudge.set_clip() end
smudge.line(0, by, W - 1, by, 2); smudge.line(0, by + bh - 2, W - 1, by + bh - 2, 2)
end
function GFX.shopscene(by, bh, card)
local t = smudge.millis() / 1000
local ph = (C and C.sky) and C.sky() or 2
local fx = GFX.ok()
local iy = by + math.max(0, (bh - 240) // 2)
local y1 = math.min(by + bh, iy + 240)
if smudge.set_clip then smudge.set_clip(0, by, W, y1 - by) end
ttint(0, by, W, bh, TT.panel)
GFX.pic("shop_scene", by, y1 - by, iy, false)
if ph >= 3 then smudge.invert_rect(361, iy + 48, 29, 51) end
local kc = GFX.card_named("Shiver Imp")
if kc then
local s = 100
local kx, ky = 240 - s // 2, iy + 66 + math.floor(math.sin(t * 1.4) * 1.5 + 0.5)
GFX.halo(kc, kx, ky, kx + s, s)
smudge.draw_sprite_quad(art_path(kc, false), 96, 96, kx, ky, kx + s, ky, kx + s, ky + s, kx, ky + s, string.format("art/s%02d_m.raw", kc - 1))
GFX.sharp(kc, kx, ky, kx + s, ky, kx + s, ky + s, kx, ky + s)
local ct = iy + 146
if ct < y1 then
if smudge.set_clip then smudge.set_clip(0, ct, W, y1 - ct) end
GFX.pic("shop_scene", ct, y1 - ct, iy, false)
if smudge.set_clip then smudge.set_clip(0, by, W, y1 - by) end
end
reg("SHOPKEEP", kx + 10, ky, s - 20, ct - ky, function()
local said = { "Welcome! Have a look at today's deals.", "Cold out there, isn't it? Warm deals inside!",
"Every deal is fresh today.", "No haggling... well, maybe a little.", "That scarf? Not for sale." }
note = "Shiver Imp: " .. said[1 + (smudge.millis() // 1000) % #said]
end, false)
end
if fx then
local fl = 0.85 + 0.15 * math.sin(t * 9) * math.sin(t * 5.3)
smudge.glow_circle(107, iy + 46, ph >= 3 and 70 or 30, 255, 180, 80, (ph >= 3 and 1.3 or 0.8) * fl)
smudge.glow_circle(107, iy + 46, 10, 255, 230, 150, 1.6 * fl)
if ph >= 3 then smudge.glow_circle(240, iy + 140, 220, 255, 150, 70, 0.35) end
if ph < 3 then
for k = 0, 6 do
local ya, yb = iy + 50 + k * 22, iy + 72 + k * 22
local xa, xb = 361 - (ya - iy - 50) * 0.62, 361 - (yb - iy - 50) * 0.62
local wa, wb = 29 + k * 6, 35 + k * 6
local a = 0.30 * (1 - k / 7.5)
smudge.glow_quad(xa, ya, xa + wa, ya, xb + wb, yb, xb, yb, 255, 238, 190, a)
smudge.glow_quad(xa + wa * 0.3, ya, xa + wa * 0.7, ya, xb + wb * 0.7, yb, xb + wb * 0.3, yb, 255, 248, 220, a * 0.6)
end
for d = 1, 12 do
local u = (t * 0.05 + d * 0.137) % 1
local x = 376 - u * 80 + math.sin(t * 0.7 + d) * 8 - (d % 3) * 8
local y = iy + 52 + u * 104 + math.cos(t * 0.5 + d * 2) * 6
smudge.glow_circle(x, y, 1.6, 255, 250, 220, 2.4 * math.sin(u * math.pi))
end
end
GFX.live = true
end
if smudge.set_clip then smudge.set_clip() end
smudge.line(0, by, W - 1, by, 2); smudge.line(0, y1 - 2, W - 1, y1 - 2, 2)
end
REORD = { ord = nil, slots = {}, drag = nil, p = nil }
function REORD.load()
REORD.ord = {}
for key, ids in (smudge.load("btnorder", "") or ""):gmatch("([%w_]+):([^;]*)") do
local t = {}
for id in ids:gmatch("[^|]+") do t[#t + 1] = id end
REORD.ord[key] = t
end
end
function REORD.save()
local t = {}
for key, ids in pairs(REORD.ord or {}) do t[#t + 1] = key .. ":" .. table.concat(ids, "|") end
smudge.save("btnorder", table.concat(t, ";"))
end
function REORD.list(key, list, idf)
if not REORD.ord then REORD.load() end
REORD.slots[key] = {}
local o = REORD.ord[key]
if not o then return list end
local by, out, used = {}, {}, {}
for _, b in ipairs(list) do by[idf(b)] = b end
for _, id in ipairs(o) do local b = by[id]; if b and not used[id] then out[#out + 1] = b; used[id] = true end end
for _, b in ipairs(list) do if not used[idf(b)] then out[#out + 1] = b end end
return out
end
function REORD.slot(key, id, x, y, w, h)
local s = REORD.slots[key]
if s then s[#s + 1] = { id = id, x = x, y = y, w = w, h = h } end
return REORD.drag and REORD.drag.key == key and REORD.drag.id == id
end
function REORD.pos() local d = REORD.drag; return math.floor(d.fx - d.gx), math.floor(d.fy - d.gy) - 8 end
function REORD.hole(x, y, w, h)
smudge.rounded_rect(x + 2, y + 2, w - 4, h - 4, 8, false, 2)
end
function REORD.lifted(draw)
local d = REORD.drag
if not d or not draw then return end
for _, sl in ipairs(REORD.slots[d.key] or {}) do
if sl.id == d.tg then smudge.rounded_rect(sl.x - 4, sl.y - 4, sl.w + 8, sl.h + 8, 10, false, 3) end
end
local x, y = REORD.pos()
if smudge.shadow_rect and GFX.ok() then smudge.shadow_rect(x + 4, y + 10, d.w, d.h, 0.7, 10) end
draw(x, y)
end
function REORD.touch(ev, x, y)
local d = REORD.drag
if ev == "down" then REORD.p = { x = x, y = y, t = smudge.millis() }; REORD.eat = false; return false end
if ev == "move" then
if d then
d.fx, d.fy = x, y
local tg
for _, sl in ipairs(REORD.slots[d.key] or {}) do
if sl.id ~= d.id and x >= sl.x and x < sl.x + sl.w and y >= sl.y and y < sl.y + sl.h then tg = sl.id; break end
end
if tg ~= d.tg then d.tg = tg; if tg then VIB.play("flip", true) end end
return true
end
local p = REORD.p
if p and (math.abs(x - p.x) > 12 or math.abs(y - p.y) > 12) then REORD.p = nil end
return false
end
if ev == "release" or ev == "up" or ev == "tap" then
REORD.p = nil
if d then
REORD.drag = nil; REORD.eat = true
if d.tg then
local o, has = {}, {}
for _, id in ipairs(REORD.ord[d.key] or {}) do o[#o + 1] = id; has[id] = true end
for _, sl in ipairs(REORD.slots[d.key] or {}) do if not has[sl.id] then o[#o + 1] = sl.id; has[sl.id] = true end end
local ci, ti
for k, id in ipairs(o) do if id == d.id then ci = k end; if id == d.tg then ti = k end end
if ci and ti then
o[ci], o[ti] = o[ti], o[ci]
REORD.ord[d.key] = o; REORD.save(); VIB.play("t1", true)
end
end
return true
end
if REORD.eat then if ev ~= "release" then REORD.eat = false end; return true end
end
return false
end
function REORD.tick()
local p = REORD.p
if not p or REORD.drag or smudge.millis() - p.t < 480 then return end
REORD.p = nil
for key, s in pairs(REORD.slots) do
if REORD.on[scr] == key or REORD.on[scr .. "2"] == key then
for _, sl in ipairs(s) do
if p.x >= sl.x and p.x < sl.x + sl.w and p.y >= sl.y and p.y < sl.y + sl.h then
if not REORD.ord[key] then local o = {}; for k, q in ipairs(s) do o[k] = q.id end; REORD.ord[key] = o end
REORD.drag = { key = key, id = sl.id, gx = p.x - sl.x, gy = p.y - sl.y, fx = p.x, fy = p.y, w = sl.w, h = sl.h }
BFX.press = nil
VIB.play("t1", true)
note = "Drag it onto another button and let go: they swap."
redraw()
return
end
end
end
end
end
REORD.on = { title = "home", title2 = "home2", camp = "camp", adventure = "adv", rewards = "rewards" }
function GFX.weather(force)
GFX.wx = false
if not GFX.ok() or not (force or SNOW.live()) then return end
local K = SNOW.k or {}
local we = K.storm and 3 or (K.rain and 2 or (K.fog and 4 or 1))
local now = smudge.millis()
local t = now / 1000 * SNOW.speed
local dens, zs = SNOW.dens, SNOW.size
local col = (STONE and smudge.set_tint) and TT.prog or nil
local nm = THEMES[theme_i][1]
local blk = not (CT.LIGHT[nm] or (nm == "retro"))
local function px(layer) return GFX.tx * (5 + layer * 9), GFX.ty * (3 + layer * 6) end
if we == 2 or we == 3 then
GFX.wx = true
local n, slant = math.floor((we == 3 and 80 or 46) * dens + 0.5), we == 3 and 0.32 or 0.16
for i = 1, n do
local h1, h2 = (i * 7919 % 1000) / 1000, (i * 104729 % 1000) / 1000
local layer = i % 3
local sp = 520 + layer * 260 + h2 * 200
local len = (16 + layer * 10) * zs
local dx, dy = px(layer)
local y = (h1 * (H + 60) + t * sp) % (H + 60) - 30 + dy
local x = (h2 * (W + 80) - slant * (y + 30)) % (W + 80) - 40 + dx
local w2 = (0.7 + layer * 0.4) * math.max(0.7, zs)
smudge.fill_quad(x - w2, y, x + w2, y, x + w2 - slant * len, y + len, x - w2 - slant * len, y + len, blk, col)
end
for i = 1, 7 do
local per = 700 + i * 90
local u = ((now + i * 377) % per) / per
local x = (i * 61 + math.floor((now + i * 377) / per) * 97) % (W - 40) + 20
local rw = 3 + u * 22
if u < 0.85 then smudge.fill_quad(x - rw, H - 6, x + rw, H - 6, x + rw, H - 5, x - rw, H - 5, blk, col) end
end
if we == 3 then
GFX.bolt = GFX.bolt or (now + 6000)
if now >= GFX.bolt then
GFX.flash(235, 240, 255, 160, 0.5)
GFX.bolt = now + 7000 + math.floor(GFX.rnd() * 9000)
end
end
elseif we == 4 then
GFX.wx = true
for i = 1, math.max(3, math.floor(14 * dens + 0.5)) do
local dx, dy = px(i % 3)
local y = (i * 157 + math.sin(t * 0.07 + i) * 40) % (H - 60) + 30 + dy
local x = ((t * (5 + (i % 4) * 3) + i * 97) % (W + 260)) - 130 + dx
smudge.glow_circle(x, y, (70 + (i % 3) * 25) * zs, 200, 210, 220, 0.25)
end
end
if K.fireflies then
GFX.wx = true
local n = math.max(2, math.floor(14 * dens + 0.5))
for i = 1, n do
local dx, dy = px(2)
local x = (i * 89 + math.sin(t * (0.21 + i * 0.013) + i) * 70 + t * 4) % W + dx
local y = H * 0.25 + (i * 53 % math.floor(H * 0.6)) + math.cos(t * (0.17 + i * 0.011) + i * 2) * 50 + dy
local blink = 0.5 + 0.5 * math.sin(t * (1.3 + (i % 5) * 0.27) + i)
if blink > 0.25 then
smudge.glow_circle(x, y, 10 * zs, 200, 255, 80, 3.5 * blink)
smudge.glow_circle(x, y, 2.5 * zs, 255, 255, 200, 6 * blink)
end
end
end
if K.leaves and P3 and P3.spr then
GFX.wx = true
for i = 1, math.max(2, math.floor(9 * dens + 0.5)) do
local h1, h2 = (i * 7919 % 1000) / 1000, (i * 104729 % 1000) / 1000
local dx, dy = px(1 + i % 2)
local y = (h1 * (H + 60) + t * (28 + h2 * 22)) % (H + 60) - 30 + dy
local x = (h2 * W + math.sin(t * 0.8 + i) * 34 + t * 8) % (W + 40) - 20 + dx
P3.spr("fx_leaf", 48, 48, x, y, 22 * zs, 22 * zs, t * (0.9 + h1) + i, nil)
end
end
end
SNOW = { on = true, speed = 1, dens = 1, size = 1, mode = "auto", k = {} }
SNOW.MODES = { { "auto", "AUTO" }, { "snow", "SNOW" }, { "rain", "RAIN" }, { "storm", "STORM" }, { "fog", "FOG" },
{ "fireflies", "FIREFLIES" }, { "leaves", "LEAVES" } }
function SNOW.kinds()
local k = {}
if SNOW.mode ~= "auto" then k[SNOW.mode] = true; return k end
local ph, we = 2, 1
if C and C.sky then ph, we = C.sky() end
if we == 2 then k.rain = true elseif we == 3 then k.storm = true elseif we == 4 then k.fog = true elseif we == 5 then k.snow = true
else
local m = tonumber(os.date("%m", smudge.time and smudge.time() or os.time())) or 1
if m == 12 or m <= 2 then k.snow = true end
if m >= 9 and m <= 11 then k.leaves = true end
if ph >= 3 then k.fireflies = true end
end
return k
end
function SNOW.label()
if not SNOW.on then return "OFF" end
for _, m in ipairs(SNOW.MODES) do if m[1] == SNOW.mode then return m[2] end end
return "AUTO"
end
function SNOW.live() return SNOW.on and CS_SMOOTH and not SAVER end
function SNOW.load()
SNOW.on = smudge.load("snow", "1") ~= "0"
SNOW.mode = smudge.load("wxmode", "auto") or "auto"
local a, b, c = (smudge.load("snowcfg", "") or ""):match("([%d%.]+),([%d%.]+),([%d%.]+)")
SNOW.speed, SNOW.dens, SNOW.size = tonumber(a) or 1, tonumber(b) or 1, tonumber(c) or 1
end
function SNOW.save()
if not SNOW.on then SNOW.pile = nil end
smudge.save("snow", SNOW.on and "1" or "0")
smudge.save("wxmode", SNOW.mode)
smudge.save("snowcfg", string.format("%.2f,%.2f,%.2f", SNOW.speed, SNOW.dens, SNOW.size))
end
function SNOW.draw(rx, ry, rw, rh, force)
if not (force or SNOW.live()) or not smudge.fill_quad or not SNOW.k.snow then return end
local whole = rx == nil
rx, ry, rw, rh = rx or 0, ry or 0, rw or W, rh or H
local t = smudge.millis() / 1000 * SNOW.speed
local col = (STONE and smudge.set_tint) and TT.prog or nil
local nm = THEMES[theme_i][1]
local blk = not (CT.LIGHT[nm] or (nm == "retro"))
local n = math.max(1, math.floor(66 * SNOW.dens * (rw * rh) / (W * H) + 0.5))
local zs = SNOW.size
for i = 1, n do
local h1, h2, h3 = (i * 7919 % 1000) / 1000, (i * 104729 % 1000) / 1000, (i * 31337 % 997) / 997
local layer = i % 3
local sp = 12 + layer * 13 + h2 * 9
local y = ry + (h1 * (rh + 40) + t * sp) % (rh + 40) - 20
local x = rx + (h2 * (rw + 40) + math.sin(t * (0.35 + h3 * 0.5) + i) * (8 + layer * 7) + t * (3 + layer * 2)) % (rw + 40) - 20
if GFX and GFX.on then x = x + GFX.tx * (6 + layer * 9); y = y + GFX.ty * (4 + layer * 6) end
local r = (1.6 + layer * 1.5 + h3 * 1.0) * zs
if layer == 2 and i % 2 == 0 then
local a0 = t * (0.3 + h1 * 0.4) + i
r = r + 4 * zs
local wd = math.max(0.7, zs)
for k = 0, 2 do
local a = a0 + k * math.pi / 3
local dx, dy = math.cos(a) * r, math.sin(a) * r
local nx, ny = -math.sin(a) * wd, math.cos(a) * wd
smudge.fill_quad(x - dx + nx, y - dy + ny, x + dx + nx, y + dy + ny, x + dx - nx, y + dy - ny, x - dx - nx, y - dy - ny, col == nil or blk, col)
end
elseif col then
smudge.fill_quad(x, y - r, x + r, y, x, y + r, x - r, y, blk, col)
else
smudge.circle(math.floor(x), math.floor(y), math.max(1, math.floor(r)), false, 1)
end
end
if whole and col and GFX and GFX.on then SNOW.piled(col, blk, zs) end
end
function SNOW.piled(col, blk, zs)
local now = smudge.millis()
local dt = math.min(200, now - (SNOW.pt or now)); SNOW.pt = now
local n = W // 10 + 1
local p = SNOW.pile
if not p then p = {}; for i = 1, n do p[i] = 0 end; SNOW.pile = p end
local cap = 16 * zs
local grow = dt / 1000 * 0.22 * SNOW.dens
for i = 1, n do
local noise = 0.5 + 0.5 * math.sin(i * 1.7 + now / 9000) * math.cos(i * 0.6 + now / 13000)
p[i] = math.min(cap * (0.7 + 0.3 * noise), p[i] + grow * (0.4 + 1.2 * noise))
end
for i = 2, n - 1 do p[i] = p[i] * 0.98 + (p[i - 1] + p[i + 1]) * 0.01 end
for i = 1, n - 1 do
local x0, x1 = (i - 1) * 10, i * 10
if p[i] >= 0.5 or p[i + 1] >= 0.5 then
smudge.fill_quad(x0, H - p[i], x1, H - p[i + 1], x1, H, x0, H, blk, col)
end
end
end
SCREENS.advent = function()
local _, m, day = ADVENT.date()
top_bar("Advent calendar", "Frostfall")
local y0 = TOP + 6
ctext(W / 2, y0, m == 12 and (day <= 24 and ("December " .. day .. ": open today's door!") or "Merry Christmas! Open any door you missed.")
or "Opens on 1 December.", "ui10", "bold")
local gx, gw, gap = 24, (W - 48 - 30) // 4, 10
local gh = math.min(100, (H - 96 - 16 - (y0 + 34)) // 6 - gap)
local now = smudge.millis()
for d = 1, 24 do
local col, row = (d - 1) % 4, (d - 1) // 4
local x, y = gx + col * (gw + gap), y0 + 34 + row * (gh + gap)
local open, can = ADVENT.is_open(d), ADVENT.can(d)
local an = ADVENT.pop and ADVENT.pop.d == d and CS_SMOOTH and not SAVER and (now - ADVENT.pop.t) < 450
if open and not an then
smudge.rounded_rect(x, y, gw, gh, 10, false, 1)
local r = ADVENT.R[d]
ctext(x + gw // 2, y + 6, tostring(d), "small", "bold")
if r[1] == "card" then
local c = tonumber(smudge.load("advcard" .. d, "") or "")
if c and not smudge.draw_sprite_quad then ctext(x + gw // 2, y + gh // 2 - 4, fit(cname(c), gw - 8, "small", "bold"), "small", "bold")
elseif c then
local z = math.min(gw - 20, gh - 26)
local qx, qy = x + (gw - z) // 2, y + 22
smudge.draw_sprite_quad(string.format("art/s%02d.raw", c - 1), 96, 96, qx, qy, qx + z, qy, qx + z, qy + z, qx, qy + z)
end
else
ctext(x + gw // 2, y + gh // 2 - 4, fit(ADVENT.text(d), gw - 8, "small", "bold"), "small", "bold")
end
else
local k = an and (1 - (now - ADVENT.pop.t) / 450) or 1
local dw = math.max(4, math.floor(gw * k))
smudge.rounded_rect(x, y, dw, gh, 10, true, 1, false)
smudge.rounded_rect(x, y, dw, gh, 10, false, can and 3 or 1)
if k > 0.6 then
ctext(x + dw // 2, y + gh // 2 - 18, tostring(d), can and "ui12" or "ui10", "bold")
if can then ctext(x + dw // 2, y + gh // 2 + 14, "open!", "small", "bold")
elseif d == 24 then ctext(x + dw // 2, y + gh // 2 + 14, "big one", "small") end
smudge.circle(x + dw - 12, y + 12, 3, can, 1)
end
if an then V3.moving = now + 100 end
end
if can then reg("ADV" .. d, x, y, gw, gh, function() ADVENT.open(d) end, true) end
end
local pp = ADVENT.pop
if pp and not (CS_SMOOTH and not SAVER and now - pp.t < 450) then
local pw, ph = W - 80, pp.c and 330 or 200
local px, py = 40, (H - ph) // 2
smudge.rounded_rect(px + 6, py + 6, pw, ph, 16, true)
smudge.rounded_rect(px, py, pw, ph, 16, true, 1, false)
smudge.rounded_rect(px, py, pw, ph, 16, false, 3)
ctext(W / 2, py + 14, "Door " .. pp.d, "ui12", "bold")
if pp.c then
thumb(W // 2 - 54, py + 56, pp.c, { show = true })
ctext(W / 2, py + 172, cname(pp.c), "ui12", "bold")
ctext(W / 2, py + 204, D.tiers[tier_of(pp.c) + 1] .. (pp.new and " - NEW!" or " - spare copy"), "small", "bold")
else
ctext(W / 2, py + 70, ADVENT.text(pp.d), "bitter14", "bold")
end
button(px + 40, py + ph - 76, pw - 80, 56, "NICE!", function() ADVENT.pop = nil end, { font = "ui10", id = "ADVNICE" })
return
end
button(24, H - 96, W - 48, 64, "BACK", function() ADVENT.pop = nil; go("title") end, { font = "ui10" })
end
SNOWUI = { tr = {} }
SNOWUI.DEF = { { "speed", "SPEED", 0.25, 3 }, { "dens", "DENSITY", 0.25, 3 }, { "size", "SIZE", 0.5, 2.5 } }
function SNOWUI.touch(ev, x, y)
if ev == "down" then
for k, tr in pairs(SNOWUI.tr) do
if y >= tr.y - 26 and y <= tr.y + 26 and x >= tr.x - 20 and x <= tr.x + tr.w + 20 then SNOWUI.drag = k end
end
end
local tr = SNOWUI.drag and SNOWUI.tr[SNOWUI.drag]
if not tr then return false end
if ev == "down" or ev == "move" or ev == "release" or ev == "up" then
local f = math.max(0, math.min(1, (x - tr.x) / tr.w))
SNOW[tr.key] = math.floor((tr.lo + (tr.hi - tr.lo) * f) * 20 + 0.5) / 20
end
if ev == "release" or ev == "up" then SNOWUI.drag = nil; SNOW.save() end
return true
end
SCREENS.snowfx = function()
top_bar("Weather", "behind every screen")
local y = TOP + 8
button(24, y, W - 48, 56, SNOW.on and "WEATHER: ON" or "WEATHER: OFF", function()
SNOW.on = not SNOW.on; SNOW.save()
note = SNOW.on and "The weather shows behind the screens, in your theme's colour." or "No more weather (the preview still shows it)."
end, { font = "ui10", active = SNOW.on, sub = SAVER and "battery saver stops it" or "behind every screen", id = "SNOWON" })
local bw7 = (W - 48 - 3 * 6) // 4
for i, m in ipairs(SNOW.MODES) do
local col, row = (i - 1) % 4, (i - 1) // 4
button(24 + col * (bw7 + 6), y + 64 + row * 50, bw7, 44, m[2], function()
SNOW.mode = m[1]; SNOW.save()
note = m[1] == "auto" and "AUTO: the game's weather (World screen); snow on clear winter days, leaves in autumn, fireflies at night." or (m[2] .. " all the time.")
end, { font = "small", active = SNOW.mode == m[1], id = "WX" .. m[1] })
end
y = y + 100
local px, py, pw, ph = 24, y + 70, W - 48, 170
smudge.fill_quad(px, py, px + pw, py, px + pw, py + ph, px, py + ph, false, (STONE and smudge.set_tint) and TT.bg or nil)
if smudge.set_clip then smudge.set_clip(px + 3, py + 3, pw - 6, ph - 6) end
SNOW.draw(px + 3, py + 3, pw - 6, ph - 6, true)
GFX.weather(true)
if smudge.set_clip then smudge.set_clip() end
smudge.rounded_rect(px, py, pw, ph, 12, false, 2)
button(px + pw // 2 - 90, py + ph // 2 - 30, 180, 60, "PACKS", function() end, { font = "ui10", sub = "preview", id = "SNOWPREV" })
ctext(W / 2, py + ph + 6, "preview", "small")
local sy = py + ph + 44
local sp3 = math.max(64, math.min(84, (H - 96 - 64 - sy) // 3))
SNOWUI.tr = {}
for k, d in ipairs(SNOWUI.DEF) do
local yy = sy + (k - 1) * sp3
local v = SNOW[d[1]]
ltext(26, yy, d[2], "ui10", "bold")
rtext(W - 26, yy, string.format("%d%%", math.floor(v * 100 + 0.5)), "ui10", "bold")
local tx, tw4, ty = 40, W - 80, yy + 48
smudge.rounded_rect(tx, ty - 5, tw4, 10, 5, true, 1, false)
smudge.rounded_rect(tx, ty - 5, tw4, 10, 5, false, 2)
local f = (v - d[3]) / (d[4] - d[3])
smudge.rounded_rect(tx, ty - 5, math.max(10, math.floor(tw4 * f)), 10, 5, true)
local kx = tx + math.floor(tw4 * f)
smudge.circle(kx, ty, 15, true, 1, false); smudge.circle(kx, ty, 15, false, 3)
if SNOWUI.drag == d[1] then smudge.circle(kx, ty, 6, true) end
SNOWUI.tr[d[1]] = { x = tx, y = ty, w = tw4, lo = d[3], hi = d[4], key = d[1] }
end
local by = sy + 3 * sp3 + 4
button(24, by, W - 48, 48, "RESET", function() SNOW.speed, SNOW.dens, SNOW.size = 1, 1, 1; SNOW.save(); note = "Weather back to normal." end,
{ font = "small", sub = "speed, density and size to 100%", id = "SNOWRESET" })
draw_note(by + 56)
button(24, H - 96, W - 48, 64, "BACK", function() go("settings") end, { font = "ui10" })
end
function on_draw()
if WILDS_TXT_OFF and scr ~= "wilds" then WILDS_TXT_OFF() end
smudge.clear()
GFX.holo = false; GFX.rolling = false; GFX.sweeping = false; GFX.live = false; GFX.barsOn = false
if STONE and smudge.tint_base and not SAVER then smudge.tint_base(TT.bg)
else ttint(0, 0, W, H, TT.bg) end
nbtn = 0
CHAT_GIFT_IN()
SNOW.k = SNOW.kinds()
if scr ~= "wilds" then
SNOW.draw()
GFX.weather()
else GFX.wx = false end
if PH then PH.frame(); clip() end
SWIPE = {}
local f = SCREENS[scr]
if f then f() end
draw_help_button()
draw_help()
if C and S and not help_open then C.draw_qinv(S); if C.draw_wiki then C.draw_wiki(S) end; C.draw_drop(S); C.draw_toast(S) end
draw_popup()
draw_focus()
GFX.draw()
end
function SKILL_TOUCH()
local si = C and C.cur_skill and C.cur_skill()
if si == 3 then return FISHT elseif si == 1 then return WOODT elseif si == 2 then return MINET elseif si == 5 then return SMITHT elseif si == 10 then return FARMT elseif si == 9 then return COOKT elseif si == 13 then return PRAYT elseif si == 20 then return RUNET elseif si == 12 then return THIEFT elseif si == 21 then return FIRET end
end
function on_touch(a, b, c, d, e)
local ev, x, y
if type(a) == "string" then ev, x, y = a, b, c else x, y, ev = a, b, c end
if type(ev) == "string" and ev:sub(-1) == "2" then
if scr == "wilds" and WILDST and WILDST.touch(ev, x, y) then redraw() end
return
end
if scr == "wilds" and WILDST and ev ~= "nudge" and WILDST.touch(ev, x, y) then redraw(); return end
if scr == "wilds" and WILDST and ev == "nudge" then WILDST.touch("move", x, y); redraw(); return end
if ev == "nudge" then
if scr == "safe" and SAFE and SAFE.touch("move", x, y) then redraw() end
if scr == "skill" and SKILL_TOUCH() and SKILL_TOUCH().touch("move", x, y) then redraw() end
return
end
GFX.finger(ev, x, y)
if REORD.on[scr] and REORD.touch(ev, x, y) then redraw(); return end
if scr == "card3d" and (ev == "down" or ev == "move" or ev == "release") then V3.touch(ev, x, y, d); redraw(); return end
if scr == "reveal" and P3.touch(ev, x, y) then redraw(); return end
if scr == "album" and BIND.touch(ev, x, y) then redraw(); return end
if scr == "safe" and SAFE and SAFE.touch(ev, x, y) then redraw(); return end
if scr == "slots" and SLOTS and SLOTS.touch(ev, x, y) then redraw(); return end
if scr == "skill" and SKILL_TOUCH() and SKILL_TOUCH().touch(ev, x, y, d, e) then redraw(); return end
if scr == "snowfx" and SNOWUI.touch(ev, x, y) then redraw(); return end
if scr == "detail" and V3.mini_touch(ev, x, y) then redraw(); return end
if scr == "ourpet" and F and F.pet_touch and F.pet_touch(ev, x, y) then redraw(); return end
if scr == "trophies" and TR.touch(ev, x, y) then redraw(); return end
if scr == "worldmap" and C and C.map_touch and C.map_touch(ev, x, y) then V3.moving = smudge.millis() + 600; redraw(); return end
if (scr == "ourpet" or scr == "packs" or scr == "title" or scr == "worldmap") and V3.tilt_touch(ev, x, y) then redraw(); return end
if ev == "down" or ev == "move" or ev == "release" then BFX.touch(ev, x, y) end
if PH and (ev == "down" or ev == "move" or ev == "release") then
if PH.touch(ev, x, y, d, e) or CS_SMOOTH then redraw() end
return
end
if ev == "down" or ev == "release" then if CS_SMOOTH then redraw() end; return end
if ev ~= "up" and ev ~= "tap" then return end
if BFX.press and not BFX.rel then BFX.rel = smudge.millis() end
if type(x) ~= "number" or type(y) ~= "number" then return end
if PH and PH.eat_tap() then redraw(); return end
local now = smudge.millis()
if now - last_act < (CS_SMOOTH and 90 or 250) then return end
for i = nbtn, 1, -1 do
local bt = btns[i]
if smudge.in_rect(x, y, bt.x, bt.y, bt.w, bt.h) then
last_act = now
use_focus = false
if GFX then GFX.tapxy = { x = x, y = y } end
if bt.frame == false and BFX.live() then BFX.tap(bt, x, y) end
SND.tap(bt.id)
if bt.act then bt.act() end
CS_FLUSH()
redraw()
return
end
end
end
function on_button(btn, pressed)
if type(btn) == "string" and btn:sub(1, 9) == "chatgift:" then
if pressed then CHAT_SEND_GIFT(btn) end
return
end
if not pressed then return end
CS_FLUSH()
if btn == "home" then go_home(); return end
if help_open then help_open = false; redraw(); return end
if C and C.qinv_open and C.qinv_open() then C.close_qinv(); redraw(); return end
if C and C.drop_open and C.drop_open() then C.close_drop(); redraw(); return end
if C and C.wiki_is_open and C.wiki_is_open() then C.wiki_back(); redraw(); return end
if btn == "back" then use_focus = true; go_back(); return end
if btn == "confirm" then
use_focus = true
local b = btns[focus]
if b and b.act then b.act() end
redraw()
return
end
if nbtn == 0 then return end
if btn == "up" or btn == "left" or btn == "page_back" then
use_focus = true
focus = (focus - 2) % nbtn + 1
redraw()
elseif btn == "down" or btn == "right" or btn == "page_forward" then
use_focus = true
focus = focus % nbtn + 1
redraw()
end
end
local last_chk = -1e9
local idle_anim_at = 0
function V3.gap(fast)
local f = tonumber(smudge.fps)
if f and f >= 90 then return math.floor(1000 / f) - 1 end
return fast and 15 or 32
end
local sec_tick = 0
function on_update()
CS_FLUSH()
if REORD.on[scr] then REORD.tick() end
GFX.frame()
if GFX.busy() and smudge.millis() - idle_anim_at >= V3.gap(true) then idle_anim_at = smudge.millis(); redraw() end
if GFX.holo and GFX.on and (math.abs(GFX.tx - GFX.ptx) + math.abs(GFX.ty - GFX.pty) > 0.01) then
GFX.ptx, GFX.pty = GFX.tx, GFX.ty; redraw()
end
if GFX.live and GFX.on and smudge.millis() - (GFX.lt or 0) >= 66 then GFX.lt = smudge.millis(); redraw() end
if note ~= "" and note == note_seen and smudge.millis() - note_at > NOTE_MS then
note = ""; note_seen = ""; redraw()
end
if S and S.camp and smudge.millis() - last_chk > (CS_SMOOTH and 1000 or 5000) then
last_chk = smudge.millis()
if C.check_notes(S) then redraw() end
if GR then local m = GR.tick(); if m then note = m; redraw() end end
end
if S and S.camp and C.update(S.camp) then
dirty = true
if scr == "camp" and not SAVER then redraw() end
end
if CS_SMOOTH and not SAVER and scr == "reveal" and RV and RV.idx == 0 then redraw() end
if CS_SMOOTH and not SAVER and (SNOW.live() or scr == "snowfx" or scr == "ourpet" or scr == "star" or scr == "card3d" or (scr == "title" and H >= 860) or (scr == "battle" and V3.ok()) or (scr == "reveal" and RV and RV.idx == -1) or (scr == "album" and (BIND.turn or BIND.drag or BIND.open_t or BIND.on())) or (scr == "worldmap" and V3.ok()) or (scr == "reel" and V3.ok()) or (scr == "trophies" and V3.ok()) or (scr == "packs" and V3.ok()) or (scr == "detail" and V3.ok() and owned(sel))) and smudge.millis() - idle_anim_at >= ((scr == "card3d" or (scr == "reveal" and RV and RV.idx == -1) or (scr == "album" and BIND.on()) or smudge.millis() < V3.moving) and V3.gap(true) or V3.gap(false)) then idle_anim_at = smudge.millis(); redraw() end
if PH and PH.update() then redraw() end
if VIB.q[1] then VIB.tick() end
if smudge.keep_awake and (AUTO.open == true) ~= (AUTO.awake == true) then
AUTO.awake = AUTO.open == true
smudge.keep_awake(AUTO.awake)
end
if BFX.live() and BFX.busy() and smudge.millis() - idle_anim_at >= V3.gap(false) then idle_anim_at = smudge.millis(); redraw() end
if CS_SMOOTH and not SAVER and smudge.millis() - sec_tick >= 1000 then sec_tick = smudge.millis(); redraw() end
if timer_fn and smudge.millis() >= timer_at then
local f = timer_fn
timer_fn = nil
f()
end
end
function on_exit()
if S and (dirty or SAVE_PENDING) then save_now() end
end
function cs_save_now()
if S then save_now() end
end
function cs_times(t0, t1)
local out, seen = {}, {}
if S and S.camp and C.times then
C.times(S, t0, t1, function(t) if t > t0 and t <= t1 and not seen[t] then seen[t] = true; out[#out + 1] = t end end)
end
table.sort(out)
return table.concat(out, ",")
end
function cs_check()
if S and S.camp then C.check_notes(S) end
end
if __CPQ_TEST then
__CPQ_TEST.get = function() return { v3 = V3, bind = BIND, gr = GR, bfx = BFX, btns = btns, nbtn = nbtn, S = S, C = C, anim_t = anim_t, scr = scr, B = B, RV = RV, focus = focus, note = note, F = F } end
__CPQ_TEST.go = function(n) go(n) end
__CPQ_TEST.theme = function(i) theme_i = i; smudge.save("style", THEMES[i][1]); apply_theme() end
__CPQ_TEST.screens = function() local t = {} for k in pairs(SCREENS) do t[#t + 1] = k end table.sort(t) return t end
__CPQ_TEST.sel = function(c) sel = c end
__CPQ_TEST.fight = function(c) start_battle(c) end
__CPQ_TEST.reveal = function(...)
local list, best = {}, 0
for _, c in ipairs({ ... }) do list[#list + 1] = { c = c, new = true, shiny = c % 2 == 0 }; best = math.max(best, tier_of(c)) end
RV = { list = list, idx = 0, fr = 1, best = best, flip = nil, kind = { true, nil, nil, nil } }
scr = "reveal"; focus = 1; note = ""; redraw(); start_opening()
end
__CPQ_TEST.end_battle = function(w) end_battle(w) end
__CPQ_TEST.screens = function() local t = {} for k in pairs(SCREENS) do t[#t + 1] = k end table.sort(t) return t end
end
mining.lua
23053
return function(X, C, ADV, H)
local F = {}
local W, Hh = X.W, X.H
local fl = math.floor
local SI = 2
local GATHER = H.GATHER[2]
local ITEMS = H.ITEMS
local PHONE = smudge.smooth == true
local function fx() return PHONE and GFX and GFX.ok and GFX.ok() end
local function hd() return fx() and smudge.hires_quad end
local function busy() if not PHONE then return end; GFX.sweeping = true; if not GFX.on then X.redraw() end end
local function snd(n, v) if SND then SND.play(n, v) end end
local function vib(p) if VIB then VIB.play(p, true) end end
local function ms() return X.millis() end
local ORES = {
{ id = "stone", gi = 1, hits = 3 },
{ id = "copper", gi = 2, hits = 4, from = 1, mid = 12, to = 25, max = 0.22, k = 4 },
{ id = "iron", gi = 3, hits = 5, from = 10, mid = 28, to = 45, max = 0.18, k = 6 },
{ id = "coal", gi = 4, hits = 5, from = 25, mid = 45, to = 70, max = 0.20, k = 1 },
{ id = "mith", gi = 5, hits = 7, from = 50, mid = 75, to = 100, max = 0.14, k = 3 },
{ id = "adam", gi = 6, hits = 8, from = 80, mid = 110, to = 140, max = 0.11, k = 2 },
{ id = "dragon", gi = 7, hits = 11, from = 130, mid = 170, to = 1e9, max = 0.07, k = 6 },
{ id = "celes", gi = 8, hits = 14, from = 200, mid = 260, to = 1e9, max = 0.05, k = 4 },
}
local BY = {}
for _, o in ipairs(ORES) do BY[o.id] = o end
local EYE = 1.35
local LV = { 1.0, 0.82, 0.68, 0.56, 0.46, 0.38, 0.30 }
local function chance(o, d)
if not o.from or d < o.from then return 0 end
if d <= o.mid then return o.max * (0.25 + 0.75 * (d - o.from) / math.max(1, o.mid - o.from)) end
if d <= o.to then return o.max * (1 - 0.7 * (d - o.mid) / math.max(1, o.to - o.mid)) end
return o.max * 0.3 * math.exp(-(d - o.to) / 60)
end
local function hash(a, b)
local h = (a * 374761393 + b * 668265263) % 4294967296
h = (h * 1274126177 + 2654435761) % 4294967296
h = (h ~ (h >> 15)) % 4294967296
h = (h * 2246822519) % 4294967296
h = h ~ (h >> 13)
return (h % 1000003) / 1000003
end
BY.ticket = { id = "ticket", gi = 1, hits = 3, k = 4 }
local FOUND = 25
local RUNLEN = 15
local RUN = nil
local function block(d, side)
if d < 0 then return "air" end
if RUN then
if side == 0 or hash(d, side * 31 + 5) < 0.6 then return RUN end
return "stone"
end
if d == 0 and side == 0 then return "grass" end
if d <= 3 then return "dirt" end
if side == 0 and hash(d, 7777) < 1 / 35 then return "ticket" end
local r, acc = hash(d, side * 97 + 13), 0
for i = #ORES, 2, -1 do acc = acc + chance(ORES[i], d); if r < acc then return ORES[i].id end end
return "stone"
end
local view = "dig"
local SCN = nil
local FALLT = nil
local SHAKE = nil
local CHIPS = {}
local POP = nil
local CRIT = { u = 0.5, v = 0.5, t = 0 }
local SS = nil
local function sync(cp)
local k = cp.x.mrun or 0
RUN = (k >= 2 and ORES[k]) and ORES[k].id or nil
if RUN and (cp.x.mleft or 0) <= 0 then cp.x.mrun = 0; RUN = nil end
end
local function depth(cp) if RUN then return cp.x.mrd or 0 end; return cp.x.mdp or 0 end
local function layer_ore(d)
local best, bi = 0, nil
for i = 2, #ORES do local c = chance(ORES[i], d); if c > best then best, bi = c, i end end
return bi
end
local function need(cp, id)
local o = BY[id]
local base = o and o.hits or 2
if not o then return base end
local p = H.success_pct(cp, SI, GATHER[o.gi])
return math.max(1, math.ceil(base * 55 / math.max(20, p)))
end
local function move_crit()
local u, v
repeat u, v = 0.18 + math.random() * 0.64, 0.18 + math.random() * 0.64 until math.abs(u - CRIT.u) + math.abs(v - CRIT.v) > 0.3
CRIT = { u = u, v = v, t = ms() }
end
local function eye_now(t)
if FALLT then
local u = (t - FALLT) / 260
if u >= 1 then FALLT = nil else return EYE + (1 - u) ^ 2 end
end
return EYE
end
local function chips(x, y, n, k, spd)
for q = 1, n do
CHIPS[#CHIPS + 1] = { x = x, y = y, vx = (math.random() * 2 - 1) * 120 * (spd or 1), vy = -(50 + math.random() * 120) * (spd or 1),
t0 = ms(), life = 450 + math.random() * 300, k = k, s = 2 + fl(math.random() * 2) }
end
end
local function broke(S, id)
local cp = S.camp
local d = depth(cp)
local crit = (cp.x.mcr or 0) == 1
cp.x.mht, cp.x.mcr = 0, 0
if RUN then cp.x.mrd = d + 1; cp.x.mleft = (cp.x.mleft or 0) - 1
else cp.x.mdp = d + 1; cp.x.mmx = math.max(cp.x.mmx or 0, d + 1) end
FALLT = ms()
snd("mn_break", 0.5); vib("sf_tick")
local note
if id == "ticket" then
local i = layer_ore(d) or 2
cp.x["mt" .. i] = (cp.x["mt" .. i] or 0) + 1
local nm = ITEMS[GATHER[ORES[i].gi][4]][1]
local f = cp.x["mo" .. i] or 0
note = string.format("A ticket block! +1 %s mine ticket (%d). %s", nm, cp.x["mt" .. i],
f >= FOUND and "Use it under MINES." or string.format("Find %s %d more times to open its mine.", nm:lower(), FOUND - f))
POP = { t0 = ms(), text = "+1 " .. nm .. " mine ticket" }
snd("mn_crit", 0.35)
elseif id == "grass" or id == "dirt" then
note = "Dirt. Dig on: stone and ores start at depth 4."
else
local o = BY[id]
local gi = o.gi
local why = H.block(cp, SI, gi)
local gave = gi
if why then gave = 1; note = GATHER[gi][1]:gsub(" rock", ""):gsub(" seam", ""):gsub(" vein", "") .. ": " .. why .. " You only get rune essence." end
local g = GATHER[gave]
local n = crit and 5 or 1
local bonus = crit and "  CRIT x5!" or ""
if cp.pet > 0 and X.rnd(1, 100) <= 4 + 3 * X.tier_of(cp.pet) then n = n + 1; bonus = bonus .. " (pet)" end
ADV.on_action(S, SI)
H.stash(cp, g[4], n)
ADV.on_gain(S, g[4], n)
local xp = H.xp_amt(cp, g[7] * n, SI)
local txt = string.format("+%d %s%s  (+%d xp)", n, ITEMS[g[4]][1], bonus, xp)
txt = txt .. H.rare_drop(S, SI) .. ADV.G.pet_roll(S, SI)
local lvn = H.give_xp(S, SI, xp)
if lvn ~= "" then txt = lvn:gsub("^%s+", "") .. "  " .. txt end
if ADV.cluenote then txt = ADV.cluenote .. "  " .. txt; ADV.cluenote = nil end
if H.inv_used() >= H.INV_MAX then txt = txt .. "  Your inventory is full!" end
note = note and (note .. "  " .. txt) or txt
cp.stat[SI] = cp.stat[SI] + 1
if not RUN and gave ~= 1 then
for i = 2, #ORES do if ORES[i].id == id then cp.x["mo" .. i] = (cp.x["mo" .. i] or 0) + 1 end end
end
if gave ~= 1 or crit then POP = { t0 = ms(), text = "+" .. n .. " " .. ITEMS[g[4]][1] } end
end
if RUN and (cp.x.mleft or 0) <= 0 then
cp.x.mrun = 0; RUN = nil
note = (note or "") .. "  The mine is mined out: back to your shaft at depth " .. (cp.x.mdp or 0) .. "."
end
X.set_note(note)
X.mark_dirty(); X.save_now()
end
local function hit(S, tx, ty)
local cp = S.camp
if FALLT then return end
sync(cp)
local d = depth(cp)
local id = block(d, 0)
if id ~= "grass" and id ~= "dirt" and H.inv_room(GATHER[BY[id].gi][4]) < 1 and H.inv_room(GATHER[1][4]) < 1 then
X.set_note("Your inventory is too full to hold any more. Tap BANK to deposit."); return
end
local t = ms()
local crit = false
if PHONE and SCN and tx then
local e = eye_now(t)
local half = SCN[3] / 2
local u = ((tx - (SCN[1] + half)) / half) * e + 0.5
local v = ((ty - (SCN[2] + half)) / half) * e + 0.5
crit = math.abs(u - CRIT.u) < 0.09 and math.abs(v - CRIT.v) < 0.09
end
if crit and (cp.x.mcr or 0) == 0 then
cp.x.mcr = 1
POP = { t0 = t, text = "CRIT! x5" }
snd("mn_crit", 0.45); vib("sf_bolt")
if tx then chips(tx, ty, 10, 4, 1.3) end
end
cp.x.mht = (cp.x.mht or 0) + 100
SHAKE = { t0 = t, a = crit and 2 or 1 }
snd("mn_tock", 0.4); if not crit then vib("sf_click") end
if tx then
local o = BY[id]
chips(tx, ty, 6, (id == "grass") and 2 or ((id == "dirt") and 4 or 1), 1)
if o and o.k and o.id ~= "stone" then chips(tx, ty, 3, o.k, 0.8) end
end
if PHONE then move_crit() end
if cp.x.mht >= need(cp, id) * 100 then broke(S, id) end
X.mark_dirty()
end
MINET = {}
function MINET.touch(ev, x, y)
if not SCN or view ~= "dig" or type(x) ~= "number" or type(y) ~= "number" then return false end
if ev == "down" and x >= SCN[1] and x < SCN[1] + SCN[3] and y >= SCN[2] and y < SCN[2] + SCN[3] then
if SS then hit(SS, x, y) end
busy()
return true
end
return false
end
local function texname(id, lv) return string.format("hd/mn_%s_%d_c.png", id, lv) end
local function level(b) local best, bi = 9, 0; for i, v in ipairs(LV) do if math.abs(v - b) < best then best, bi = math.abs(v - b), i - 1 end end; return bi end
local function shaft(S, x, y, w, t)
local cp = S.camp
local d = depth(cp)
local e = eye_now(t)
local half = w / 2
local cx, cy = x + half, y + half
if SHAKE then
local v = t - SHAKE.t0
if v > 220 then SHAKE = nil else cx = cx + math.sin(v / 18) * 2.5 * SHAKE.a * (1 - v / 220) end
end
local function P(nx, ny) return cx + nx * half, cy + ny * half end
local floorD = RUN and (d + 3) or d
local eyeD = floorD - e
smudge.set_clip(x, y, w, w)
if not hd() then
smudge.rect(x, y, w, w, false); smudge.rect(x, y, w, w, false, 2)
local s = 0.5 / e
local ax, ay = P(-s, -s)
smudge.rect(fl(ax), fl(ay), fl(2 * s * half), fl(2 * s * half), false, 3)
for q = 0, 3 do
local sx, sy = (q % 2 == 0) and -1 or 1, (q < 2) and -1 or 1
local px, py = P(sx * s, sy * s)
smudge.line(fl(x + (sx > 0 and w or 0)), fl(y + (sy > 0 and w or 0)), fl(px), fl(py), 2)
end
smudge.set_clip()
return
end
if eyeD < 0 then
local z = -eyeD
for i = -3, 3 do for j = -3, 3 do
if not (i == 0 and j == 0) then
local x0, y0 = (i - 0.52) / z, (j - 0.52) / z
local x1, y1 = (i + 0.52) / z, (j + 0.52) / z
if x1 > -1.2 and x0 < 1.2 and y1 > -1.2 and y0 < 1.2 then
local a1, a2 = P(x0, y0); local b1, b2 = P(x1, y0); local c1, c2 = P(x1, y1); local d1, d2 = P(x0, y1)
smudge.hires_quad(texname("grass", level(0.95)), a1, a2, b1, b2, c1, c2, d1, d2)
end
end
end end
end
local L0 = math.max(0, fl(eyeD))
for L = L0, floorD - 1 do
local z1 = math.max(0.12, L - eyeD)
local z2 = math.min(e, L + 1 - eyeD)
if z2 > z1 + 0.001 then
local s1, s2 = 0.5 / z1, 0.5 / z2
local zm = (z1 + z2) / 2
local fall = math.max(0.3, 1 - math.max(0, zm - 0.3) * 0.22)
local faces = {
{ 3, -s1, -s1, -s1, s1, -s2, s2, -s2, -s2, 0.78 },
{ 4, s1, s1, s1, -s1, s2, -s2, s2, s2, 0.62 },
{ 1, s1, -s1, -s1, -s1, -s2, -s2, s2, -s2, 0.70 },
{ 2, -s1, s1, s1, s1, s2, s2, -s2, s2, 0.86 },
}
for _, f in ipairs(faces) do
local id = block(L, f[1])
if id ~= "air" then
local a1, a2 = P(f[2], f[3]); local b1, b2 = P(f[4], f[5]); local c1, c2 = P(f[6], f[7]); local d1, d2 = P(f[8], f[9])
smudge.hires_quad(texname(id, level(f[10] * fall)), a1, a2, b1, b2, c1, c2, d1, d2)
end
end
end
end
local s = 0.5 / e
local fid = block(floorD, 0)
local fb = math.max(0.3, 1 - math.max(0, e - 0.3) * 0.22)
local ax, ay = P(-s, -s); local bx, by = P(s, -s); local ccx, ccy = P(s, s); local dx, dy = P(-s, s)
smudge.hires_quad(texname(fid, level(math.min(1, fb + 0.15))), ax, ay, bx, by, ccx, ccy, dx, dy)
smudge.set_clip()
local fs = 2 * s * half
local stage = math.min(9, fl((cp.x.mht or 0) / 100 / need(cp, fid) * 10))
if (cp.x.mht or 0) > 0 and not FALLT then
local segs = F.cracks(floorD * 13 + (cp.x.mrun or 0) * 7919)
local n = fl(#segs * (stage + 1) / 10)
for q = 1, n do
local c = segs[q]
smudge.line(fl(ax + c[1] * fs), fl(ay + c[2] * fs), fl(ax + c[3] * fs), fl(ay + c[4] * fs), 1)
end
end
for k = 1, 3 do
local o = BY[block(floorD + k, 0)]
if o and o.k and o.id ~= "stone" and math.sin(t / 250 + k * 2) > 0.6 and not FALLT then
local gx, gy = ax + (0.2 + hash(floorD + k, 1) * 0.6) * fs, ay + (0.2 + hash(floorD + k, 2) * 0.6) * fs
local r2 = 4 - k
smudge.line(fl(gx - r2 - 2), fl(gy), fl(gx + r2 + 2), fl(gy), 1); smudge.line(fl(gx), fl(gy - r2 - 2), fl(gx), fl(gy + r2 + 2), 1)
smudge.rect(fl(gx) - 1, fl(gy) - 1, 2, 2, false)
smudge.tint(fl(gx - r2 - 2), fl(gy - r2 - 2), 2 * r2 + 5, 2 * r2 + 5, o.k, 3)
end
end
if PHONE and not FALLT then
local born = math.max(0, math.min(1, (t - CRIT.t) / 220))
local pz = 0.5 + 0.5 * math.sin(t / 220)
local sx, sy = ax + CRIT.u * fs, ay + CRIT.v * fs
local rr = fl((9 + 2 * pz) * born + 0.5)
if rr >= 3 then
local hr = rr + 5 + fl(3 * pz)
local ph = fl(t / 120) % 2
for yy = -hr, hr do
local hw = fl(math.sqrt(math.max(0, hr * hr - yy * yy)))
for xx = -hw, hw do
local d2 = xx * xx + yy * yy
if d2 < (rr - 2) * (rr - 2) and (xx + yy + ph) % 2 == 0 then smudge.rect(fl(sx) + xx, fl(sy) + yy, 1, 1, false)
elseif d2 > (rr + 2) * (rr + 2) and (xx + yy + ph) % 3 == 0 and d2 < hr * hr * (0.6 + 0.4 * pz) then smudge.rect(fl(sx) + xx, fl(sy) + yy, 1, 1, false) end
end
end
smudge.circle(fl(sx), fl(sy), rr + 2, false, 2, false)
smudge.circle(fl(sx), fl(sy), rr, false, 3)
smudge.circle(fl(sx), fl(sy), 3, true, 1, false)
smudge.circle(fl(sx), fl(sy), 2, true)
for yy = -hr, hr do
local hw = fl(math.sqrt(math.max(0, hr * hr - yy * yy)))
smudge.tint(fl(sx - hw), fl(sy + yy), 2 * hw + 1, 1, 4, 3)
end
end
if (cp.x.mcr or 0) == 1 then
local pz2 = 0.5 + 0.5 * math.sin(t / 120)
smudge.rect(fl(ax) + 1, fl(ay) + 1, fl(fs) - 2, fl(fs) - 2, false, 3)
smudge.tint(fl(ax), fl(ay), fl(fs), 4, 4, 3); smudge.tint(fl(ax), fl(ay + fs) - 4, fl(fs), 4, 4, 3)
smudge.tint(fl(ax), fl(ay), 4, fl(fs), 4, 3); smudge.tint(fl(ax + fs) - 4, fl(ay), 4, fl(fs), 4, 3)
if fx() then smudge.glow_circle(cx, cy, fs * 0.5, 255, 210, 90, 0.3 + 0.3 * pz2) end
end
end
end
local function draw_scene(S, x, y, w)
local cp = S.camp
local t = ms()
SS = S
SCN = { x, y, w }
shaft(S, x, y, w, t)
smudge.rect(x, y, w, w, false, 3)
local keep = {}
for _, c in ipairs(CHIPS) do
local u = (t - c.t0) / 1000
if u * 1000 < c.life then
local cx2, cy2 = c.x + c.vx * u, c.y + c.vy * u + 380 * u * u
if cy2 > y and cy2 < y + w and cx2 > x and cx2 < x + w then
smudge.rect(fl(cx2), fl(cy2), c.s, c.s, true); smudge.tint(fl(cx2), fl(cy2), c.s, c.s, c.k, 3)
end
keep[#keep + 1] = c
end
end
CHIPS = keep
local d = depth(cp)
if RUN then
local nm = ITEMS[GATHER[BY[RUN].gi][4]][1]:upper() .. " MINE"
local bw3 = X.tw(nm, "small", "bold") + 24
smudge.rounded_rect(x + 8, y + 8, math.max(112, bw3), 40, 8, true)
X.ltext(x + 16, y + 10, nm, "small", "bold", true)
X.ltext(x + 16, y + 24, (cp.x.mleft or 0) .. " left", "ui12", "bold", true)
else
smudge.rounded_rect(x + 8, y + 8, 112, 40, 8, true)
X.ltext(x + 16, y + 10, "DEPTH", "small", nil, true)
X.ltext(x + 16, y + 24, tostring(d), "ui12", "bold", true)
end
if POP and t - POP.t0 < 1000 then
local u = (t - POP.t0) / 1000
local tw2 = X.tw(POP.text, "ui12", "bold") + 20
smudge.rounded_rect(fl(x + w / 2 - tw2 / 2), fl(y + w * 0.3 - 30 * u) - 4, tw2, 30, 10, true)
X.ctext(fl(x + w / 2), fl(y + w * 0.3 - 30 * u), POP.text, "ui12", "bold", true)
end
if (cp.x.mht or 0) == 0 and d == 0 then X.ctext(fl(x + w / 2), fl(y + w - 30), "tap the ground to dig down", "small", "bold") end
if FALLT or SHAKE or POP or #CHIPS > 0 or PHONE then busy() end
if not PHONE then
X.reg("MDIG", fl(x), y, fl(w), w, function() hit(S) end, false)
end
end
local function layer_name(d)
if d <= 3 then return "Topsoil" end
local best, bo = 0, nil
for i = 2, #ORES do local c = chance(ORES[i], d); if c > best then best, bo = c, ORES[i] end end
return bo and (ITEMS[GATHER[bo.gi][4]][1] .. " layer") or "Deep stone"
end
function F.draw(S, y)
local cp = S.camp
local x0, w0 = 24, W - 48
sync(cp)
local d = depth(cp)
if view == "mines" then
local yy = y
X.ltext(x0, yy, "MINES: one ore only, " .. RUNLEN .. " blocks a ticket", "ui10", "bold")
X.ltext(x0, yy + 22, X.fit("Tickets: from ticket blocks. A mine opens at " .. FOUND .. " finds.", w0, "small"), "small")
yy = yy + 48
for i = 2, #ORES do
local o = ORES[i]
local nm = ITEMS[GATHER[o.gi][4]][1]
local f, tk = cp.x["mo" .. i] or 0, cp.x["mt" .. i] or 0
local why = H.block(cp, SI, o.gi)
local open = f >= FOUND
local here = math.abs(cp.x.mrun or 0) == i and (cp.x.mleft or 0) > 0
local sub
if here then sub = "you're in it: " .. (cp.x.mleft or 0) .. " blocks left"
elseif not open then sub = string.format("found %d/%d   tickets %d", f, FOUND, tk)
elseif why then sub = X.fit(why, w0 - 80, "small")
else sub = string.format("tickets %d   (%d found)", tk, f) end
local can = here or (open and tk > 0 and not why)
X.button(x0, yy, w0, 50, (here and "CONTINUE: " or "") .. nm .. " mine", function()
if why then X.set_note(why); return end
if not here then
if not open or tk < 1 then X.set_note(open and "No tickets for this mine yet: find ticket blocks in the shaft." or ("Find " .. nm:lower() .. " " .. (FOUND - f) .. " more times to open this mine.")); return end
if (cp.x.mrun or 0) ~= 0 and (cp.x.mleft or 0) > 0 then
X.set_note("Finish the mine you're in first (or go in and dig it out)."); return
end
cp.x["mt" .. i] = tk - 1
cp.x.mrun, cp.x.mleft, cp.x.mrd = i, RUNLEN, 0
X.set_note("Into the " .. nm:lower() .. " mine: " .. RUNLEN .. " blocks of " .. nm:lower() .. ".")
else cp.x.mrun = i end
cp.x.mht, cp.x.mcr = 0, 0
view = "dig"; FALLT = ms(); move_crit(); snd("slot_hold", 0.4); X.mark_dirty(); X.save_now()
end, { font = "ui10", id = "MMINE" .. i, off = not can, sub = sub })
smudge.draw_sprite(x0 + w0 - 34, yy + 13, 24, 24, "art/" .. ITEMS[GATHER[o.gi][4]][3] .. ".raw", "art/" .. ITEMS[GATHER[o.gi][4]][3] .. "_m.raw")
yy = yy + 56
end
X.button(x0, Hh - 96 - 56, w0, 48, "BACK TO THE SHAFT", function() view = "dig" end, { font = "ui10", id = "MBACK" })
X.draw_note(Hh - 96 - 84)
return
end
if view == "lift" then
local yy = y
X.ltext(x0, yy, "THE LIFT: to any depth you have reached", "ui10", "bold")
yy = yy + 30
local stops = { 0 }
local mx = cp.x.mmx or 0
for k = 10, mx, 10 do stops[#stops + 1] = k end
if stops[#stops] ~= mx then stops[#stops + 1] = mx end
local per = math.max(1, fl((Hh - 96 - 70 - yy) / 52))
local first = math.max(1, #stops - per + 1)
for i = first, #stops do
local k = stops[i]
X.button(x0, yy, w0, 46, k == 0 and "THE TOP" or ("DEPTH " .. k), function()
cp.x.mdp, cp.x.mht, cp.x.mcr = k, 0, 0; view = "dig"; FALLT = ms(); move_crit()
X.set_note(k == 0 and "Back at the top." or ("The lift takes you down to depth " .. k .. "."))
snd("slot_hold", 0.4); X.mark_dirty()
end, { font = "ui10", id = "MLIFT" .. k, sub = k == 0 and nil or layer_name(k), off = k == d })
yy = yy + 52
end
X.button(x0, Hh - 96 - 56, w0, 48, "BACK TO THE SHAFT", function() view = "dig" end, { font = "ui10", id = "MBACK" })
X.draw_note(Hh - 96 - 84)
return
end
local by = Hh - 96 - 60
local chartH = 98
local w = math.min(w0, by - 8 - chartH - 6 - y)
local sx = x0 + fl((w0 - w) / 2)
draw_scene(S, sx, y, w)
local cyy = y + w + 6
smudge.rounded_rect(x0, cyy, w0, chartH, 10, false, 1)
local rows = {}
if RUN then
local nm = ITEMS[GATHER[BY[RUN].gi][4]][1]
X.ltext(x0 + 10, cyy + 4, nm .. " mine:  " .. H.tool_name(H.tool_tier(cp, SI), SI):lower(), "small", "bold")
X.ltext(x0 + 10, cyy + 30, X.fit("Every block is " .. nm:lower() .. ". Then back to your shaft.", w0 - 20, "small"), "small")
smudge.draw_sprite(x0 + 10, cyy + 56, 24, 24, "art/" .. ITEMS[GATHER[BY[RUN].gi][4]][3] .. ".raw", "art/" .. ITEMS[GATHER[BY[RUN].gi][4]][3] .. "_m.raw")
local bw4 = w0 - 60
smudge.rect(x0 + 44, cyy + 64, bw4, 8, false, 1)
smudge.rect(x0 + 45, cyy + 65, math.max(1, fl((bw4 - 2) * (cp.x.mleft or 0) / RUNLEN)), 6, true)
else
X.ltext(x0 + 10, cyy + 4, layer_name(d) .. ":  " .. H.tool_name(H.tool_tier(cp, SI), SI):lower(), "small", "bold")
end
if d > 3 and not RUN then
for i = 2, #ORES do local c = chance(ORES[i], d); if c > 0.004 then rows[#rows + 1] = { ORES[i], c } end end
table.sort(rows, function(a, b) return a[2] > b[2] end)
end
if #rows == 0 and not RUN then X.ltext(x0 + 10, cyy + 30, d <= 3 and "Soil: dig on, stone and ores start at depth 4." or "Deep stone.", "small") end
for i = 1, math.min(4, #rows) do
local o, c = rows[i][1], rows[i][2]
local col = (i - 1) % 2
local row = fl((i - 1) / 2)
local rx, ry = x0 + 10 + col * (w0 / 2), cyy + 26 + row * 34
local why = H.block(cp, SI, o.gi)
local nm = ITEMS[GATHER[o.gi][4]][1]
smudge.draw_sprite(rx, ry, 24, 24, "art/" .. ITEMS[GATHER[o.gi][4]][3] .. ".raw", "art/" .. ITEMS[GATHER[o.gi][4]][3] .. "_m.raw")
X.ltext(rx + 30, ry, X.fit(nm, w0 / 2 - 90, "small"), "small", "bold", false)
X.rtext(rx + w0 / 2 - 22, ry, fl(c * 100 + 0.5) .. "%", "small", "bold")
local bw2 = w0 / 2 - (why and 110 or 60)
smudge.rect(rx + 30, ry + 19, fl(bw2), 6, false, 1)
smudge.rect(rx + 31, ry + 20, math.max(1, fl((bw2 - 2) * math.min(1, c / 0.22))), 4, true)
if why then X.rtext(rx + w0 / 2 - 22, ry + 14, "too hard", "small") end
end
local nt = 0
for i = 2, #ORES do nt = nt + (cp.x["mt" .. i] or 0) end
if RUN then
local bw = (w0 - 6) // 2
X.button(x0, by, bw, 52, "TO THE SHAFT", function()
cp.x.mrun = -(cp.x.mrun or 0); RUN = nil; cp.x.mht, cp.x.mcr = 0, 0
FALLT = ms(); move_crit(); X.set_note("Back in your shaft. The mine waits under MINES."); X.mark_dirty()
end, { font = "ui10", id = "MOUT", sub = (cp.x.mleft or 0) .. " blocks left" })
X.button(x0 + bw + 6, by, w0 - bw - 6, 52, "BANK " .. H.inv_used() .. "/" .. H.INV_MAX, function() H.bank_loot(S) end,
{ font = "ui10", id = "GBANK", nohelp = true, dot = (H.inv_used() >= H.INV_MAX) and "!" or nil })
else
local bw = (w0 - 18) // 4
X.button(x0, by, bw, 52, "LIFT", function() view = "lift" end, { font = "small", id = "MLIFT", sub = "deepest " .. (cp.x.mmx or 0) })
X.button(x0 + bw + 6, by, bw, 52, "MINES", function() view = "mines" end, { font = "small", id = "MMINES", sub = nt .. " tickets", dot = nt > 0 and nt or nil })
X.button(x0 + 2 * (bw + 6), by, bw, 52, "BANK", function() H.bank_loot(S) end,
{ font = "small", id = "GBANK", nohelp = true, sub = H.inv_used() .. "/" .. H.INV_MAX, dot = (H.inv_used() >= H.INV_MAX) and "!" or nil })
X.button(x0 + 3 * (bw + 6), by, w0 - 3 * (bw + 6), 52, "UP", function()
if d == 0 then X.set_note("You are at the top."); return end
cp.x.mdp, cp.x.mht, cp.x.mcr = d - 1, 0, 0; FALLT = ms(); move_crit(); X.mark_dirty()
end, { font = "small", id = "MUP", off = d == 0, sub = "one block" })
end
X.draw_note(cyy + chartH + 8)
end
local CR = {}
function F.cracks(seed)
if CR[seed] then return CR[seed] end
local segs, tips = {}, {}
local starts = 1 + fl(hash(seed, 1) * 3)
for k = 1, starts do tips[#tips + 1] = { 0.2 + hash(seed, 10 + k) * 0.6, 0.2 + hash(seed, 20 + k) * 0.6, hash(seed, 30 + k) * 6.283 } end
for q = 1, 46 do
local i = 1 + fl(hash(seed, 100 + q) * #tips)
local p = tips[i]
local a = p[3] + (hash(seed, 200 + q) - 0.5) * 1.6
local L = 0.03 + hash(seed, 300 + q) * 0.06
local nx, ny = math.max(0.02, math.min(0.98, p[1] + math.cos(a) * L)), math.max(0.02, math.min(0.98, p[2] + math.sin(a) * L))
segs[#segs + 1] = { p[1], p[2], nx, ny }
if hash(seed, 400 + q) < 0.18 then tips[#tips + 1] = { nx, ny, a + (hash(seed, 500 + q) < 0.5 and 1 or -1) * 0.9 }
else tips[i] = { nx, ny, a } end
end
CR[seed] = segs
return segs
end
do
local segs, pts = {}, { { 8, 8 } }
for q = 0, 39 do
local p = pts[fl(hash(q, 3) * #pts) + 1]
local a = hash(q, 5) * 6.283
local L = 2 + hash(q, 7) * 3
local nx, ny = math.max(0, math.min(15.9, p[1] + math.cos(a) * L)), math.max(0, math.min(15.9, p[2] + math.sin(a) * L))
segs[#segs + 1] = { p[1], p[2], nx, ny }
pts[#pts + 1] = { nx, ny }
end
F.CRACK, F.CRACKN = {}, {}
local seen = {}
for st = 0, 9 do
local n = fl((st + 1) / 10 * #segs)
for i = 1, n do
local s = segs[i]
for k = 0, 8 do
local cx, cy = fl(s[1] + (s[3] - s[1]) * k / 8), fl(s[2] + (s[4] - s[2]) * k / 8)
if not seen[cy * 16 + cx] then seen[cy * 16 + cx] = true; F.CRACK[#F.CRACK + 1] = { cx, cy } end
end
end
F.CRACKN[st + 1] = #F.CRACK
end
end
F.hit = function(S, x, y) hit(S, x, y) end
F.block, F.chance = block, chance
F.state = function() return { crit = CRIT, scn = SCN, fall = FALLT } end
return F
end
prayer.lua
5423
return function(X, C, ADV, H, K)
local F = {}
local fl = math.floor
local SI = 13
local function ms() return X.millis() end
local LIST = {}
for ri in ipairs(H.REC[SI]) do LIST[#LIST + 1] = ri end
local BEAT = 1100
local sel = nil
local PR = { on = false, t0 = 0, res = {}, ri = nil, glow = 0 }
local L, SS, POP = nil, nil, nil
local function centre() return L.x + L.w / 2, L.y + L.h * (214 / 355) end
local function radius() return math.min(L.w * 0.36, L.h * 0.28) end
local function begin(S)
if PR.on then return end
local ri = LIST[sel]
local why = K.why_not(S.camp, SI, H.REC[SI][ri], "Prayer")
if why then X.set_note(why); return end
PR.on, PR.t0, PR.res, PR.ri = true, ms() + 900, {}, ri
X.set_note("Feel the beat: tap as each ring of light meets the white circle.")
end
local function finish(S)
local cp = S.camp
PR.on = false
local r = H.REC[SI][PR.ri]
local good = 0
for k = 1, 8 do if PR.res[k] == 2 then good = good + 1 end end
if H.make(S, SI, PR.ri) ~= "ok" then return end
local o = r[5]
local extra = ""
if good > 0 then
local xp = H.xp_amt(cp, fl(r[3] * 0.1 * good + 0.5), SI)
extra = "  +" .. xp .. " xp for " .. good .. " beat" .. (good > 1 and "s" or "") .. " in time" .. H.give_xp(S, SI, xp)
end
if good == 8 then
if o.power then cp.power = math.max(cp.power, fl(o.power * 1.5 + 0.5)) end
if o.fort then cp.fort = math.max(cp.fort, o.fort * 2) end
extra = "  HOLY OFFERING: the blessing is " .. (o.fort and "twice as long" or "half as strong again") .. "!" .. extra
K.snd("pr_holy", 0.6); K.vib("sf_bolt")
POP = { t0 = ms(), text = "HOLY OFFERING!" }
else
POP = { t0 = ms(), text = good .. " of 8 in time" }
end
if GFX and L then GFX.tapxy = { x = X.W / 2, y = L.ry - 40 } end
K.addnote(extra)
X.mark_dirty(); X.save_now()
end
local function beat_tap()
if not PR.on then return end
local ph = (ms() - PR.t0) / BEAT
local k = fl(ph + 0.5)
if k < 0 or k > 7 or PR.res[k + 1] then return end
local off = math.abs(ph - k)
PR.res[k + 1] = off < 0.16 and 2 or (off < 0.3 and 1 or 0)
if PR.res[k + 1] > 0 then K.snd("pr_n" .. (k + 1), 0.55); PR.glow = ms(); K.vib("sf_click") else K.snd("pr_miss", 0.4) end
end
PRAYT = {}
function PRAYT.touch(ev, px, py)
if not SS or not L or not K.hd() or type(px) ~= "number" or type(py) ~= "number" then return false end
if ev ~= "down" then return PR.on and (ev == "up" or ev == "tap" or ev == "release" or ev == "move" or ev == "nudge") end
if not (px >= L.x and px < L.x + L.w and py >= L.y and py < L.y + L.h) then return false end
if PR.on then beat_tap() else begin(SS) end
K.busy()
return true
end
local function draw_scene(S)
local t = ms()
local HD = K.hd()
local x, y = L.x, L.y
local cx, cy = centre()
local R = radius()
if not HD then
smudge.rect(x, y, L.w, L.h, false, 2)
smudge.rect(fl(cx - 70), fl(cy + 10), 140, 60, false, 3)
X.ctext(fl(cx), fl(cy + 26), "ALTAR", "ui12", "bold")
X.ctext(fl(cx), fl(cy + 90), "Tap the altar to offer.", "small")
X.reg("PRSCN", x, y, L.w, L.h, function()
local why = K.why_not(S.camp, SI, H.REC[SI][LIST[sel]], "Prayer")
if why then X.set_note(why); return end
H.make(S, SI, LIST[sel])
end, false)
return false
end
K.tile("hd/pr_chapel_c.png", x, y, x + L.w, y + L.h)
local u = L.w / 256
local v = L.h / 355
for _, c in ipairs({ 80, 176 }) do K.pic("pr_flame" .. ((fl(t / 160) + c) % 2 + 1), 7, 12, x + c * u, y + 187 * v, 7 * u, 0, 0.5, 1) end
K.ring(cx, cy, R, 3)
local anim = true
if PR.on then
local ph = (t - PR.t0) / BEAT
for k = 0, 7 do
local u2 = ph - k + 1
if u2 >= 0 and u2 <= 1.3 then
local rr = u2 * R
if rr > 4 then
if u2 > 0.86 and u2 < 1.14 then K.ring(cx, cy, rr, 4) else smudge.circle(fl(cx), fl(cy), fl(rr), false, 2, false) end
end
end
end
for k = 1, 8 do
local bx = fl(cx - 4 * 22 + (k - 1) * 22 + 3)
local by = fl(L.y + L.h - 34)
local v = PR.res[k]
smudge.rounded_rect(bx, by, 16, 16, 5, true, 1, false)
smudge.rounded_rect(bx, by, 16, 16, 5, false, 2)
if v == 2 then smudge.rect(bx + 3, by + 3, 10, 10, true) elseif v == 1 then smudge.rect_dither(bx + 3, by + 3, 10, 10, true) end
end
if ph > 8.4 then finish(S) end
end
local msg = PR.on and (((t - PR.t0) < 0) and "Ready..." or "Tap as the ring meets the circle") or "Tap the altar (or OFFER) to begin"
K.pill(x + L.w / 2, y + 10, msg)
K.pop(L, POP, t)
return anim
end
function F.draw(S, y)
local cp = S.camp
SS = S
L = K.layout(y)
if not sel then
sel = 1
for k, ri in ipairs(LIST) do local r = H.REC[SI][ri]; if H.slevel(cp, SI) >= r[2] and H.can_make(cp, r) then sel = k end end
end
if draw_scene(S) then K.busy() end
local r = H.REC[SI][LIST[sel]]
local why = K.why_not(cp, SI, r, "Prayer")
local o = r[5]
local what = o.power and ("+" .. o.power .. " ATK next fight") or (o.fort and ("+50% coins for " .. o.fort .. " fights") or "")
K.picker(LIST, L.ry, sel, r[1] .. "  (Lv " .. r[2] .. ")", (why and why:find("^You") and why) or (H.need_text(cp, r) .. "  Â·  " .. what), function(d)
if PR.on then X.set_note("Finish this offering first."); return end
sel = (sel - 1 + d) % #LIST + 1
end, "PR")
local bw = fl((X.W - 48 - 6) / 2)
X.button(24, L.by, bw, 52, "OFFER", function() begin(S) end, { font = "small", id = "PROFFER", sub = "8 beats", off = why ~= nil or PR.on or not K.hd(), nohelp = true })
X.button(24 + bw + 6, L.by, X.W - 48 - bw - 6, 52, "QUICK", function() H.make(S, SI, LIST[sel]) end,
{ font = "small", id = "PRQUICK", sub = "no bonus", off = why ~= nil or PR.on, nohelp = true })
end
F.state = function() return PR end
return F
end
rsps.lua
39061
return function(X, K, C, ADV, G)
local R = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function today() return now() // 86400 end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function I(id) return IDX[id] end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
local V = {}
local function load()
V = {}
for part in (smudge.load("rsps", "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then V[k] = tonumber(v) end
end
end
local function save()
local p = {}
for k, v in pairs(V) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
table.sort(p)
smudge.save("rsps", table.concat(p, ";"))
end
load()
R.load, R.save = load, save
local function get(k) return V[k] or 0 end
local function add(k, n) V[k] = (V[k] or 0) + n; save() end
R.get, R.add = get, add
R.V = function() return V end
function R.iron() return get("iron") == 1 end
C.is_iron = R.iron
function R.iron_block(what)
if R.iron() then X.set_note("Iron Mode: you can't " .. what .. ". Gather and make it yourself!"); return true end
return false
end
function R.luck()
return (get("ring") + get("amu")) * 0.02 + (R.iron() and 0.05 or 0)
end
function G.lucky(n)
local m = math.max(1, fl(n / (1 + R.luck()) + 0.5))
return X.rnd(1, m) == 1
end
local LUCK = {
{ key = "ring", name = "Ring of wealth", mat = "scale", matname = "Boss scales" },
{ key = "amu", name = "Amulet of luck", mat = "stardust", matname = "stardust" },
}
local function luck_cost(L) return 300 * (L + 1), math.max(1, fl((L + 2) / 2)), 25 * (L + 1), 15 * (L + 1) end
local function luck_up(S, k)
local cp = S.camp
local g = LUCK[k]
local L = get(g.key)
if L >= 10 then X.set_note(g.name .. " is already +10."); return end
local coins, scales, sd, dust = luck_cost(L)
if S.coins < coins then X.set_note("Need " .. coins .. " coins."); return end
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
if g.mat == "scale" then
if cp.inv[I("scale")] < scales then X.set_note("Need " .. scales .. " Boss scales."); return end
cp.inv[I("scale")] = cp.inv[I("scale")] - scales
else
if cp.x.stardust < sd then X.set_note("Need " .. sd .. " stardust (shooting stars)."); return end
cp.x.stardust = cp.x.stardust - sd
end
S.coins = S.coins - coins; S.dust = S.dust - dust
add(g.key, 1)
X.set_note(string.format("%s is now %s! Luck +%d%%", g.name, L == 0 and "made" or ("+" .. (L + 1)), fl(R.luck() * 100 + 0.5)))
X.save_now()
end
local KC = {
{ key = "wb1", name = "Quill Behemoth", base = "Quillbreaker", ms = { 10, 50, 100, 250 } },
{ key = "wb2", name = "Bandit King", base = "Bandit Bane", ms = { 10, 50, 100, 250 } },
{ key = "wb3", name = "Totem Lord", base = "Totem Toppler", ms = { 10, 50, 100, 250 } },
{ key = "wb4", name = "Thunder Rooster", base = "Storm Plucker", ms = { 10, 50, 100, 250 } },
{ key = "raid", name = "Raids", base = "Hatter Slayer", ms = { 5, 25, 50, 100 } },
{ key = "todt", name = "Wintertodt", base = "Firekeeper", ms = { 5, 25, 50, 100 } },
{ key = "slay", name = "Slayer kills", base = "Monster Hunter", ms = { 25, 100, 250, 1000 } },
}
R.KC = KC
local RANK = { "", "Elite ", "Master ", "Grand " }
local KCI = {}
for k, e in ipairs(KC) do KCI[e.key] = k end
local function kc_count(cp, key)
if key == "raid" then return cp.x.raids end
if key == "todt" then return cp.x.todt end
return get("kc_" .. key)
end
local function tier_n(key, n)
local e = KC[KCI[key]]
if not e then return 0 end
local t = 0
for _, m in ipairs(e.ms) do if n >= m then t = t + 1 end end
return t
end
local function kc_tier(cp, key) return tier_n(key, kc_count(cp, key)) end
function R.kc_add(S, key)
local cp = S.camp
if key ~= "raid" and key ~= "todt" then add("kc_" .. key, 1) end
local after = kc_tier(cp, key)
local before = tier_n(key, kc_count(cp, key) - 1)
if after > before then
local e = KC[KCI[key]]
ADV.notify(string.format("New title: %s%s! (+%d%% vs %s)", RANK[after], e.base, 2 * after, e.name), "titles")
return string.format("  KC %d: title %s%s!", kc_count(cp, key), RANK[after], e.base)
end
return ""
end
function R.kc_bonus(cp, key) if not key then return 0 end return 0.02 * kc_tier(cp, key) end
local function title_of(cp, k)
if k == #KC + 1 then return R.iron() and "Ironman" or nil end
local e = KC[k]
if not e then return nil end
local t = kc_tier(cp, e.key)
if t == 0 then return nil end
return RANK[t] .. e.base
end
function R.title(cp)
local k = get("title")
if k == 0 then return nil end
return title_of(cp, k)
end
local PMAX = 5
function R.prestige(si) return get("p" .. si) end
local function do_prestige(S, si)
local cp = S.camp
local p = get("p" .. si)
if p >= PMAX then X.set_note(SK[si].name .. " is already prestige " .. PMAX .. "."); return end
if lvl(cp, si) < 99 then X.set_note("Prestige needs level 99."); return end
cp.sxp[si] = 0
add("p" .. si, 1)
X.set_note(string.format("%s PRESTIGE %d! Back to level 1 with +%d%% xp and +%d%% extra drops for good.", SK[si].name, p + 1, 5 * (p + 1), 5 * (p + 1)))
ADV.notify(SK[si].name .. " reached prestige " .. (p + 1) .. "!", "prestige")
X.save_now()
end
function R.mega(si) return get("mp" .. si) == 1 end
function R.mega_roll(S, si, ch)
if R.mega(si) or not G.lucky(ch) then return "" end
V["mp" .. si] = 1; save()
local n = ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
ADV.notify("MEGA PET: your " .. n .. " grew huge!", "megapets")
return "  Your " .. n .. " grows into a MEGA pet!"
end
local function give_mega(S)
local cp = S.camp
local cand = {}
for si = 1, 16 do if I("pet" .. si) and ADV.owns(cp, "pet" .. si) and not R.mega(si) then cand[#cand + 1] = si end end
if #cand == 0 then return nil end
local si = cand[X.rnd(1, #cand)]
V["mp" .. si] = 1; save()
return "MEGA " .. ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
end
local xp0 = G.xp_bonus
G.xp_bonus = function(cp, si)
local m = xp0(cp, si)
if si then
m = m + 0.05 * get("p" .. si)
if R.mega(si) then m = m + 0.05 end
end
if R.iron() then m = m + 0.10 end
return m
end
function R.gather_bonus(si)
local n, note = 0, ""
local p = get("p" .. si)
if p > 0 and X.rnd(1, 100) <= 5 * p then n = n + 1; note = "  (prestige +1)" end
if R.mega(si) and X.rnd(1, 100) <= 20 then n = n + 1; note = note .. "  (mega pet +1)" end
return n, note
end
local BOX = { "Bronze box", "Silver box", "Gold box", "Mythic box" }
R.BOX = BOX
function R.give_box(t, n) add("b" .. t, n or 1) end
function R.give_key(n) add("key", n or 1) end
function R.give_token(n) add("tok", n or 1) end
local function unique_item(S)
local cp = S.camp
local cand = {}
for _, it in ipairs(ADV.items) do
local id = it[4]
if it[5] and not it[6] and not id:find("^cape") and id ~= "maxcape" and id ~= "qcape" and not ADV.owns(cp, id) then cand[#cand + 1] = id end
end
if #cand == 0 then X.add_coins(3000); return "3000 coins (you own every unique!)" end
local id = cand[X.rnd(1, #cand)]
ADV.grant(cp, id)
return "UNIQUE: " .. ITEMS[I(id)][1] .. "!"
end
local RUNE_IDS = { "rair", "rwater", "rearth", "rfire", "rchaos", "rnature", "rdeath", "rblood" }
local function rune_bag(S, n)
local cp = S.camp
local got, pool = {}, {}
for k, r in ipairs(RUNE_IDS) do pool[k] = r end
for _ = 1, 3 do
local r = table.remove(pool, X.rnd(1, #pool))
local k = fl(n / 3) + X.rnd(0, 3)
K.add_item(cp, I(r), k); got[#got + 1] = k .. " " .. ITEMS[I(r)][1]
end
return table.concat(got, ", ")
end
local RES = { "oak", "willow", "maple", "yew", "coal", "iron", "mith", "adam", "salmon", "lob" }
local function resources(S, n)
local id = RES[X.rnd(1, #RES)]
K.add_item(S.camp, I(id), n)
return n .. " " .. ITEMS[I(id)][1]
end
local function coins(n) return function() X.add_coins(n); return n .. " coins" end end
local function dust(n) return function() X.add_dust(n); return n .. " dust" end end
local POOLS = {
{
{ 30, "150 coins", coins(150) }, { 15, "300 coins", coins(300) }, { 20, "25 dust", dust(25) },
{ 20, "Resources", function(S) return resources(S, X.rnd(4, 8)) end },
{ 10, "2 Attack pots", function(S) K.add_item(S.camp, I("patk"), 2); return "2 Attack potions" end },
{ 4, "Silver box", function() R.give_box(2); return "a Silver box!" end, true },
{ 1, "Crystal key", function() R.give_key(); return "a Crystal key!" end, true },
},
{
{ 25, "500 coins", coins(500) }, { 10, "1000 coins", coins(1000) }, { 20, "60 dust", dust(60) },
{ 15, "Pack ticket", function(S) S.camp.tickets = S.camp.tickets + 1; return "a pack ticket" end },
{ 15, "Rune bag", function(S) return rune_bag(S, 30) end },
{ 6, "Instance token", function() R.give_token(); return "an Instance token!" end, true },
{ 5, "Crystal key", function() R.give_key(); return "a Crystal key!" end, true },
{ 4, "Gold box", function() R.give_box(3); return "a Gold box!" end, true },
},
{
{ 20, "2000 coins", coins(2000) }, { 20, "150 dust", dust(150) },
{ 20, "RARE ticket", function(S) S.camp.rtickets = S.camp.rtickets + 1; return "a RARE pack ticket" end },
{ 12, "Instance token", function() R.give_token(); return "an Instance token!" end },
{ 12, "2 Crystal keys", function() R.give_key(2); return "2 Crystal keys!" end },
{ 8, "Unique item", unique_item, true },
{ 3, "Mythic box", function() R.give_box(4); return "a MYTHIC box!" end, true },
},
{
{ 15, "5000 coins", coins(5000) }, { 15, "400 dust", dust(400) },
{ 20, "3 RARE tickets", function(S) S.camp.rtickets = S.camp.rtickets + 3; return "3 RARE pack tickets" end },
{ 25, "Unique item", unique_item, true },
{ 10, "Mega pet", function(S) return give_mega(S) or unique_item(S) end, true },
{ 14, "Mythic card", function()
local c = X.D.pick(5, nil, X.rnd); X.give_card(c); return "MYTHIC card: " .. X.cname(c) .. "!" end, true },
{ 1, "SECRET CARD", function()
local l = X.D.tier_cards[6]; local c = l[X.rnd(1, #l)]; X.give_card(c); return "SECRET CARD: " .. X.cname(c) .. "!!!" end, true },
},
{
{ 20, "800 coins", coins(800) }, { 15, "100 dust", dust(100) },
{ 20, "Rune bag", function(S) return rune_bag(S, 45) end },
{ 15, "Rare ores", function(S)
local cp = S.camp; local id = ({ "rstone", "dragon", "celes" })[X.rnd(1, 3)]; local n = X.rnd(3, 6)
K.add_item(cp, I(id), n); return n .. " " .. ITEMS[I(id)][1] end },
{ 15, "Silver box", function() R.give_box(2); return "a Silver box!" end },
{ 10, "Unique item", unique_item, true },
{ 5, "Gold box", function() R.give_box(3); return "a Gold box!" end, true },
},
}
R.POOLS = POOLS
local function pick(pool)
local lk = 1 + R.luck()
local tot = 0
for _, e in ipairs(pool) do tot = tot + e[1] * (e[4] and lk or 1) end
local r = X.rnd(1, 1000000) / 1000000 * tot
for _, e in ipairs(pool) do
r = r - e[1] * (e[4] and lk or 1)
if r <= 0 then return e end
end
return pool[#pool]
end
local RL
local CELL = 132
local function reel_frame()
if not RL or RL.done then return end
local p = math.min(1, (X.millis() - RL.t0) / RL.dur)
local e = 1 - (1 - p) ^ 3
RL.pos = 1 + e * (RL.target - 1)
if p >= 1 then RL.pos = RL.target; RL.done = true; X.set_note(RL.result); if GFX then GFX.tap = { x = W / 2, y = TOPY() + 165, t = X.millis() } end else X.after(X.fstep(140), reel_frame) end
X.redraw()
end
local function open_box(S, tier)
local key = (tier == 5) and "key" or ("b" .. tier)
if get(key) < 1 then X.set_note(tier == 5 and "You have no Crystal keys." or ("You have no " .. BOX[tier] .. "es.")); return end
if RL and not RL.done then return end
add(key, -1)
local pool = POOLS[tier]
local e = pick(pool)
local res = e[3](S)
add("opened", 1)
if e[4] then ADV.notify((tier == 5 and "Crystal chest" or BOX[tier]) .. ": " .. res, "loot") end
local strip = {}
for k = 1, 30 do strip[k] = pool[X.rnd(1, #pool)][2] end
local target = 26
strip[target] = e[2]
strip[target - 1] = pool[#pool][2]
RL = { tier = tier, strip = strip, target = target, pos = 1, t0 = X.millis(), dur = 2400, result = "You won: " .. res, rare = e[4], res = res }
X.save_now()
X.go("reel")
if X.smooth and X.smooth() and smudge.draw_sprite_quad then
local sh = 300 + 260 * tier
RL.ch = X.millis(); RL.T = { 300, 300 + sh, 500 + sh, 700 + sh, 1050 + sh, 1500 + sh }
return
end
X.after(X.fstep(140), reel_frame)
end
R.open_box = open_box
local WHEEL = {
{ 25, "250c", coins(250) }, { 20, "50 dust", dust(50) },
{ 20, "Bronze", function() R.give_box(1); return "a Bronze box" end },
{ 12, "Silver", function() R.give_box(2); return "a Silver box" end },
{ 10, "Key", function() R.give_key(); return "a Crystal key" end },
{ 8, "50c", function(S) X.add_coins(50); return "50 coins" end },
{ 3, "Token", function() R.give_token(); return "an Instance token" end },
{ 2, "GOLD", function() R.give_box(3); return "a GOLD box!" end },
}
local WL
__RSPS = R
ROLL_HOLD = function() return (RL ~= nil and (RL.ch ~= nil or not RL.done)) or (WL ~= nil and not WL.done) end
local function wheel_spins() return ((get("wd") ~= today()) and 1 or 0) + get("wx") end
R.wheel_spins = wheel_spins
local function wheel_frame()
if not WL or WL.done then return end
local p = math.min(1, (X.millis() - WL.t0) / WL.dur)
local e = 1 - (1 - p) ^ 3
WL.ang = e * WL.target
if p >= 1 then WL.done = true; X.set_note("Wheel of Fortune: " .. WL.res); if GFX then GFX.tap = { x = W / 2, y = TOPY() + 200, t = X.millis() } end else X.after(X.fstep(140), wheel_frame) end
X.redraw()
end
local function spin(S)
local cp = S.camp
if WL and not WL.done then return end
if wheel_spins() < 1 then X.set_note("No spins left. Come back tomorrow!"); return end
if get("wd") ~= today() then V.wd = today() else V.wx = get("wx") - 1 end
save()
local tot = 0
for _, e in ipairs(WHEEL) do tot = tot + e[1] end
local r, k = X.rnd(1, tot), 1
for i, e in ipairs(WHEEL) do r = r - e[1]; if r <= 0 then k = i; break end end
local res = WHEEL[k][3](S)
local seg = 2 * math.pi / #WHEEL
WL = { k = k, res = res, t0 = X.millis(), dur = 2600, ang = 0, target = 3 * 2 * math.pi + (k - 1) * seg + seg / 2 }
X.save_now()
X.after(X.fstep(140), wheel_frame)
end
local function tok() return function() R.give_token(); return "an Instance token" end end
local function box(t, n) return function() R.give_box(t, n); return (n and n > 1 and (n .. " ") or "") .. BOX[t] .. ((n and n > 1) and "es" or "") end end
local function key(n) return function() R.give_key(n); return (n or 1) .. " Crystal key" .. ((n or 1) > 1 and "s" or "") end end
local LOGIN = {
{ "100c", coins(100) }, { "20d", dust(20) }, { "Pots", function(S) K.add_item(S.camp, I("patk"), 2); return "2 Attack potions" end },
{ "Brnz", box(1) }, { "200c", coins(200) }, { "40d", dust(40) },
{ "Slvr", function(S) R.give_box(2); S.camp.tickets = S.camp.tickets + 1; return "a Silver box + pack ticket" end },
{ "300c", coins(300) }, { "Key", key(1) }, { "60d", dust(60) }, { "Brnz", box(1) }, { "400c", coins(400) },
{ "Tokn", tok() }, { "Gold", function(S) R.give_box(3); S.camp.rtickets = S.camp.rtickets + 1; return "a Gold box + RARE ticket" end },
{ "500c", coins(500) }, { "80d", dust(80) }, { "Slvr", box(2) }, { "Key", key(1) }, { "600c", coins(600) },
{ "Spin", function() V.wx = get("wx") + 2; save(); return "2 extra Wheel spins" end },
{ "Gold", function(S) R.give_box(3); S.camp.tickets = S.camp.tickets + 2; return "a Gold box + 2 tickets" end },
{ "700c", coins(700) }, { "100d", dust(100) }, { "Tokn", tok() }, { "Slvr", box(2) }, { "2key", key(2) }, { "1k c", coins(1000) },
{ "CHEST", function(S)
R.give_box(4); R.give_box(3); S.camp.rtickets = S.camp.rtickets + 3; X.add_dust(500)
return "THE BIG CHEST: Mythic box, Gold box, 3 RARE tickets, 500 dust!" end },
}
local function login_ready() return get("ld") ~= today() end
R.login_ready = login_ready
local function login_claim(S)
if not login_ready() then X.set_note("Already claimed today. Come back tomorrow!"); return end
local d, s = get("ld"), get("ls")
local note = ""
if d ~= 0 and d < today() - 1 then
local missed = today() - 1 - d
local drop = math.min(s, 3 * missed)
s = s - drop
note = "  (missed " .. missed .. " day" .. (missed > 1 and "s" or "") .. ": back " .. drop .. ")"
end
s = s % 28 + 1
V.ld = today(); V.ls = s; save()
local res = LOGIN[s][2](S)
X.set_note("Day " .. s .. ": " .. res .. note)
X.save_now()
end
local function inst_bosses()
local list = {}
for k, b in ipairs(G.WBOSS) do list[#list + 1] = { name = b[1], card = b[3], weak = ADV.CB.WB_WEAK[k], uniq = b[4], kc = "wb" .. k, m = 17 + k } end
list[#list + 1] = { name = "Mad Hatter", card = 33, weak = 2, kc = "raid", olm = true, m = 17 }
return list
end
local function inst_drops(cp, k)
local b = inst_bosses()[k]
local c = ADV.CB.stats(cp)
local rows = { { "Coins", tostring(80 + 2 * c.clvl), 1 }, { "Dust", "20", 1 } }
if b.uniq then rows[#rows + 1] = { ITEMS[I(b.uniq)][1], "1", ADV.p(30, true) } end
if b.olm then rows[#rows + 1] = { "A raid purple", "1", ADV.p(60, true) } end
rows[#rows + 1] = { "Silver box", "1", ADV.p(6, true) }
ADV.herb_rows(rows, 40 + 8 * c.clvl)
return b.name .. " (instance)", rows, "uses 1 instance kill"
end
R.inst_list, R.inst_drops = inst_bosses, inst_drops
local function inst_fight(S, k)
local cp = S.camp
if get("ik") < 1 then X.set_note("Use an Instance token first (10 kills)."); return end
local b = inst_bosses()[k]
local c = ADV.CB.stats(cp)
local hp = 40 + 8 * c.clvl
ADV.CB.start(S, {
title = "Instance - " .. b.name, name = b.name, card = b.card, boss = true, art = string.format("art/m%02d.raw", b.m), hp = hp, maxhp = hp,
maxhit = fl(3 + 0.5 * c.clvl), weak = b.weak, special = 4, kc = b.kc, back = "instance",
drops = function() return inst_drops(cp, k) end,
again = function(S2) inst_fight(S2, k) end,
on_end = function(S2, win)
if not win then return "Knocked out. The instance stays open - no kill used." end
V.ik = math.max(0, get("ik") - 1); save()
local cn = 80 + 2 * c.clvl
X.add_coins(cn); X.add_dust(20)
local t = string.format("%s is down! +%d coins, 20 dust. Instance kills left: %d", b.name, cn, get("ik"))
if not b.olm then t = t .. R.kc_add(S2, b.kc) end
if b.uniq and G.lucky(30) then ADV.grant(cp, b.uniq); t = t .. "  UNIQUE: " .. ITEMS[I(b.uniq)][1] .. "!" end
if b.olm and G.lucky(60) then t = t .. "  " .. unique_item(S2) end
if G.lucky(6) then R.give_box(2); t = t .. "  Silver box!" end
return t
end,
})
end
local function forge_list(cp)
local list = {}
for i = 1, #ITEMS do
local e = K.EQL[i]
if e and cp.inv[i] >= 3 then list[#list + 1] = i end
end
return list
end
local function forge_next(i)
local e = K.EQL[i]
local cand = {}
for j = 1, #ITEMS do
local f = K.EQL[j]
if f and j ~= i and f[1] == e[1] and ITEMS[j][2] > ITEMS[i][2] and not ITEMS[j][1]:find("[Cc]ape$") then
cand[#cand + 1] = j
end
end
table.sort(cand, function(a, b) return ITEMS[a][2] < ITEMS[b][2] end)
local out = {}
for k = 1, math.min(3, #cand) do out[k] = cand[k] end
return out
end
local function forge_chance() return math.min(90, 60 + fl(R.luck() * 50)) end
local function forge_cost(i) return math.max(50, 2 * ITEMS[i][2]) end
local function forge(S, i)
local cp = S.camp
if cp.inv[i] < 3 then X.set_note("You need 3 of that item."); return end
local nx = forge_next(i)
if #nx == 0 then X.set_note("That is already the best of its kind."); return end
local cost = forge_cost(i)
if S.coins < cost then X.set_note("The forge costs " .. cost .. " coins."); return end
S.coins = S.coins - cost
if X.rnd(1, 100) <= forge_chance() then
cp.inv[i] = cp.inv[i] - 3
local j = nx[X.rnd(1, #nx)]
K.add_item(cp, j, 1)
X.set_note("The forge roars! 3 " .. ITEMS[i][1] .. " -> " .. ITEMS[j][1] .. "!")
else
cp.inv[i] = cp.inv[i] - 2
X.set_note("The forge fails... 2 " .. ITEMS[i][1] .. " melt, you keep 1.")
end
X.save_now()
end
function R.on_slayer_kill(S)
local t = ""
if G.lucky(10) then R.give_box(1); t = t .. "  Bronze box!" end
if G.lucky(40) then R.give_box(2); t = t .. "  Silver box!" end
if G.lucky(30) then R.give_key(); t = t .. "  Crystal key!" end
return t .. R.kc_add(S, "slay")
end
function R.on_wb_kill(S, bi)
R.give_box(2)
local t = "  Silver box!"
if G.lucky(4) then R.give_box(3); t = t .. "  Gold box!" end
return t .. R.kc_add(S, "wb" .. bi)
end
function R.on_raid(S)
local t = ""
if G.lucky(3) then R.give_box(3); t = "  Gold box!" else R.give_box(2); t = "  Silver box!" end
if G.lucky(50) then R.give_box(4); t = t .. "  MYTHIC BOX!" end
if G.lucky(3) then R.give_token(); t = t .. "  Instance token!" end
return t .. R.kc_add(S, "raid")
end
function R.on_todt(S, pts, won)
local t = ""
if pts >= 300 then R.give_box(1); t = "  Bronze box!" end
if won and G.lucky(5) then R.give_box(2); t = t .. "  Silver box!" end
if won then t = t .. R.kc_add(S, "todt") end
return t
end
function R.on_challenge(S)
R.give_box(1)
local t = " +Bronze box"
if G.lucky(4) then R.give_token(); t = t .. " +Instance token" end
return t
end
function R.box_total() return get("b1") + get("b2") + get("b3") + get("b4") + get("key") end
function R.badges(S)
return { loot = R.box_total() + wheel_spins(), perks = (login_ready() and 1 or 0) }
end
function R.check(S)
if login_ready() and get("ln") ~= today() then V.ln = today(); save(); ADV.notify("Your daily login reward is ready!", "login") end
end
R.SCR = { "loot", "reel", "wheel", "forge", "perks", "login", "prestige", "luck", "titles", "instance", "iron", "megapets" }
R.PARENT = { loot = "rewards", reel = "loot", wheel = "loot", forge = "loot", perks = "rewards", login = "perks", prestige = "skills",
luck = "perks", titles = "perks", instance = "perks", iron = "perks", megapets = "perks" }
local function box_icon(x, y, t)
sprite(x, y, 32, "a14")
for k = 1, t do smudge.circle(x + 4 + (k - 1) * 8, y + 38, 3, true) end
end
function C.draw_loot(S)
head(S, "Loot", "luck +" .. fl(R.luck() * 100 + 0.5) .. "%")
local y = TOPY() + 4
local rows = { { 1, "Bronze box", "coins, dust, resources" }, { 2, "Silver box", "tickets, runes, tokens" },
{ 3, "Gold box", "RARE tickets, uniques" }, { 4, "Mythic box", "mythic + SECRET cards" },
{ 5, "Crystal chest", "open with a Crystal key" } }
local sp = 82
for k, r in ipairs(rows) do
local by = y + (k - 1) * sp
local key = (r[1] == 5) and "key" or ("b" .. r[1])
local n = get(key)
panel(20, by, W - 40, sp - 8)
if r[1] == 5 then sprite(34, by + 12, 32, "a14"); smudge.circle(64, by + 46, 6, false, 2) else box_icon(34, by + 12, r[1]) end
X.ltext(84, by + 8, r[2] .. "  x" .. n, "ui10", "bold")
X.ltext(84, by + 38, r[3], "small")
X.button(W - 24 - 130, by + 6, 120, sp - 20, "OPEN", function() open_box(S, r[1]) end,
{ font = "ui10", off = n < 1, id = "BOX" .. r[1], dot = (n > 0) and n or nil })
end
local by = y + 5 * sp + 4
local hw = (W - 48 - 10) // 2
local sp_n = wheel_spins()
X.button(24, by, hw, 74, "WHEEL", function() X.go("wheel") end, { sub = sp_n .. " spin" .. (sp_n == 1 and "" or "s"), id = "WHEEL", dot = (sp_n > 0) and "!" or nil })
X.button(34 + hw, by, hw, 74, "FORGE", function() X.go("forge") end, { sub = "3 -> next tier", id = "FORGE" })
X.draw_note(by + 84)
back_btn("rewards")
end
function C.draw_reel(S)
head(S, RL and ((RL.tier == 5) and "Crystal chest" or BOX[RL.tier]) or "Loot", "")
if not RL then X.go("loot"); return end
if RL.ch then
local u = X.millis() - RL.ch
local k = 6
for i = 1, 6 do if u < RL.T[i] then k = i; break end end
local cx, cy, sz = W / 2, TOPY() + (H - TOPY() - 120) / 2, math.min(W - 40, 400)
local dx, dy = 0, 0
if k == 2 then local a = 2 + RL.tier * 1.5; dx = math.sin(u / 28) * a; dy = math.cos(u / 37) * a * 0.4 end
local x0, y0 = cx - sz / 2 + dx, cy - sz / 2 + dy
local nm = "art/ch" .. k
smudge.draw_sprite_quad(nm .. ".raw", 224, 224, x0, y0, x0 + sz, y0, x0 + sz, y0 + sz, x0, y0 + sz, nm .. "_m.raw")
X.ctext(W / 2, TOPY() + 20, (RL.tier == 5) and "Crystal chest" or BOX[RL.tier], "ui12", "bold")
X.reg("CHESTSKIP", 0, TOPY(), W, H - TOPY() - 100, function() RL.ch = X.millis() - RL.T[6] end, false)
if u >= RL.T[6] then RL.ch = nil; RL.t0 = X.millis(); X.after(X.fstep(140), reel_frame) end
back_btn("loot")
return
end
local y = TOPY() + 20
if RL.tier == 5 then sprite(W // 2 - 16, y, 32, "a14") else box_icon(W // 2 - 16, y, RL.tier) end
local ry = y + 80
local rh = 130
smudge.rect(0, ry, W, rh, false, 3)
for i, lab in ipairs(RL.strip) do
local cx = fl(W / 2 + (i - RL.pos) * CELL)
if cx > -CELL and cx < W + CELL then
local win = RL.done and i == RL.target
local x0 = cx - CELL // 2 + 6
smudge.rounded_rect(x0, ry + 14, CELL - 12, rh - 28, 8, win, 2)
local words = {}
for w in lab:gmatch("%S+") do words[#words + 1] = w end
local l1, l2 = lab, nil
if #words > 1 and X.tw(lab, "small", "bold") > CELL - 24 then l1 = words[1]; l2 = table.concat(words, " ", 2) end
X.ctext(cx, ry + rh // 2 - (l2 and 22 or 10), l1, "small", "bold", win)
if l2 then X.ctext(cx, ry + rh // 2 + 2, l2, "small", "bold", win) end
end
end
smudge.triangle(W // 2 - 14, ry - 16, W // 2 + 14, ry - 16, W // 2, ry + 6, true)
smudge.triangle(W // 2 - 14, ry + rh + 16, W // 2 + 14, ry + rh + 16, W // 2, ry + rh - 6, true)
local by = ry + rh + 40
if RL.done then
X.ctext(W / 2, by, RL.rare and "* RARE! *" or "You won", "ui12", "bold")
X.wrapped(30, by + 36, RL.res, W - 60, "ui10", 3)
local t = RL.tier
local key = (t == 5) and "key" or ("b" .. t)
X.button(24, by + 130, W - 48, 74, "OPEN ANOTHER", function() open_box(S, t) end,
{ off = get(key) < 1, sub = get(key) .. " left", id = "REELAGAIN" })
else
X.ctext(W / 2, by, "Spinning...", "ui12", "bold")
end
back_btn("loot")
end
function C.draw_wheel(S)
local cp = S.camp
local n = wheel_spins()
head(S, "Wheel of Fortune", n .. " spin" .. (n == 1 and "" or "s"))
local cx, cy, r = W // 2, TOPY() + 200, 170
smudge.circle(cx, cy, r, false, 3)
smudge.circle(cx, cy, r - 6, false, 1)
local seg = 2 * math.pi / #WHEEL
local rot = WL and WL.ang or 0
for k, e in ipairs(WHEEL) do
local a0 = (k - 1) * seg - rot - math.pi / 2
smudge.line(cx, cy, cx + fl(math.cos(a0) * r), cy + fl(math.sin(a0) * r), 2)
local am = a0 + seg / 2
local tx, ty = cx + fl(math.cos(am) * r * 0.64), cy + fl(math.sin(am) * r * 0.64)
local win = WL and WL.done and WL.k == k
if win then smudge.rounded_rect(tx - 40, ty - 16, 80, 30, 6, true) end
X.ctext(tx, ty - 12, e[2], "small", "bold", win)
end
smudge.circle(cx, cy, 26, true)
X.ctext(cx, cy - 12, "SPIN", "small", "bold", true)
smudge.triangle(cx - 16, cy - r - 22, cx + 16, cy - r - 22, cx, cy - r + 10, true)
local by = cy + r + 22
if WL and WL.done then X.ctext(W / 2, by, "You won " .. WL.res .. "!", "ui10", "bold")
elseif WL then X.ctext(W / 2, by, "Spinning...", "ui10", "bold")
else X.ctext(W / 2, by, "One free spin a day", "small") end
X.button(24, by + 34, W - 48, 74, "SPIN THE WHEEL", function() spin(S) end,
{ off = n < 1 or (WL and not WL.done), sub = (n < 1) and "next spin tomorrow" or "free", id = "SPIN", dot = (n > 0) and "!" or nil })
back_btn("loot")
end
local fpage = 0
function C.draw_forge(S)
local cp = S.camp
head(S, "Upgrade forge", forge_chance() .. "% success")
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "3 of one gear piece -> a random better one", "small")
local list = forge_list(cp)
local per = 6
local pages = math.max(1, math.ceil(#list / per))
if fpage >= pages then fpage = pages - 1 end
if #list == 0 then X.wrapped(30, y0 + 60, "You don't have 3 of any piece of gear yet. Duplicates from bosses, Slayer, boxes and Smithing land here.", W - 60, "ui10", 4) end
local sp = 84
local function frow(n, k, by)
local i = list[n]
if i then
panel(20, by, W - 40, sp - 8)
sprite(30, by + 12, 24, ITEMS[i][3])
X.ltext(62, by + 6, X.fit(ITEMS[i][1] .. "  x" .. cp.inv[i], 250, "ui10", "bold"), "ui10", "bold")
local nx = forge_next(i)
local names = {}
for _, j in ipairs(nx) do names[#names + 1] = ITEMS[j][1] end
X.ltext(62, by + 36, X.fit(#nx > 0 and ("-> " .. table.concat(names, " / ")) or "top tier", 260, "small"), "small")
X.button(W - 24 - 120, by + 6, 110, sp - 20, "FORGE", function() forge(S, i) end,
{ font = "small", sub = forge_cost(i) .. "c", off = #nx == 0 or S.coins < forge_cost(i), id = "FORGE" .. k })
end
end
local ny = y0 + 28 + per * sp
if not X.list("forge", y0 + 28, nil, #list, sp, function(n, by) frow(n, n, by) end) then
for k = 1, per do frow(fpage * per + k, k, y0 + 28 + (k - 1) * sp) end
if pages > 1 then
X.button(24, ny, 140, 44, "PREV", function() if fpage > 0 then fpage = fpage - 1 end end, { font = "small", off = fpage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (fpage + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 44, "NEXT", function() if fpage < pages - 1 then fpage = fpage + 1 end end, { font = "small", off = fpage >= pages - 1, id = "NEXT" })
end
end
X.draw_note(ny + 50)
back_btn("loot")
end
function C.draw_perks(S)
local cp = S.camp
head(S, "Perks", R.iron() and "IRON MODE" or "")
local y = TOPY() + 4
local t = R.title(cp)
X.ctext(W / 2, y, t and ("Title: " .. t) or "No title chosen", "small", "bold")
local np, nm = 0, 0
for si = 1, #SK do np = np + get("p" .. si) end
for si = 1, 16 do if R.mega(si) then nm = nm + 1 end end
local list = {
{ "LOGIN", "day " .. get("ls") .. " / 28", "login", login_ready() and "!" or nil },
{ "LUCK GEAR", "luck +" .. fl(R.luck() * 100 + 0.5) .. "%", "luck" },
