end
local b = { Q(-hw, -hh, hw, hh, 5) }
smudge.fill_quad(b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], true, tk)
local f = { Q(-hw, -hh, hw, hh, 0) }
smudge.fill_quad(f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8], false, tk)
local function outline(pts, t)
