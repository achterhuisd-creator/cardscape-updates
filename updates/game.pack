go = function(name)
if name == "album" and scr ~= "album" and BIND.on() then BIND.open_t = 0 end
scr = name; focus = 1; note = ""; confirm_reset = false
help_open = false
if C and C.close_qinv then C.close_qinv() end
if C then C.on_nav(); C.toast_off(); C.seen(name); if C.close_drop then C.close_drop() end; if C.wiki_close then C.wiki_close() end end
loop_on = false
if name == "detail" then aura_start() end
redraw()
end
local function go_back()
if scr == "title" then
elseif scr == "battle" and B and not B.over then
if not B.busy then
if B.retreat then B.over = true; B.win = false; B.reward = 0; B.fled = true; blog("You retreated.")
else B.retreat = true; note = "Press again to retreat from the fight." end
end
else
if scr == "battle" then B = nil end
if scr == "reveal" then timer_fn = nil; RV = nil end
PE = (scr == "quest") and nil or PE
go("title")
end
redraw()
end
local function go_home()
help_open = false
if C and C.close_qinv then C.close_qinv() end
if C and C.close_drop then C.close_drop() end
use_focus = false
if scr == "battle" and B and not B.over then go_back(); return end
if scr ~= "title" then
if scr == "battle" then B = nil end
if scr == "reveal" then timer_fn = nil; RV = nil end
PE = (scr == "quest") and nil or PE
go("title")
end
redraw()
end
function on_init()
if smudge.get_bounds then W, H = smudge.get_bounds() end
CS_SMOOTH = smudge.smooth == true
if smudge.get_metrics then
local m = smudge.get_metrics()
if m then TOP = (m.top_padding or 4) + BAR_H + 10 end
end
math.randomseed(os.time())
if smudge.set_clip then
local ok, f = pcall(dofile, "scroll.lua")
if ok and type(f) == "function" then PH = f({ millis = smudge.millis, clip = clip, press = press, smooth = function() return CS_SMOOTH and not SAVER end }) end
end
C = dofile("camp.lua")(camp_ctx())
for _, n in ipairs(C.adv_screens) do SCREENS[n] = function() C["draw_" .. n](S) end end
C.load_notes()
local last = tonumber((smudge.load("stamp", "") or ""):match("^(%d+)"))
S = load_state()
DX.load()
SAVER = (smudge.load("opt", "0") == "1")
local st = smudge.load("style", "stone")
CT.bg = math.max(1, math.min(#CT.bases, tonumber(smudge.load("custombg", "1")) or 1))
CT.accent = math.max(1, math.min(#CT.accents, tonumber(smudge.load("customaccent", "1")) or 1))
CT.card = math.max(1, math.min(#CT.cards, tonumber(smudge.load("customcard", "1")) or 1))
theme_i = 1
if smudge.night_was and smudge.night_was() then st = "dark"; smudge.save("style", "dark") end
for i, t in ipairs(THEMES) do if t[1] == st then theme_i = i end end
apply_theme()
load_show()
CLEAN = (smudge.load("clean", "0") == "1"); apply_clean()
FX_GLINT = smudge.load("fxglint", "1") ~= "0"; FX_RIP = smudge.load("fxrip", "1") ~= "0"
scr = "title"
local fx = camp_ctx()
fx.S = function() return S end
fx.tilt = function(...) if V3.ok() and not SAVER then return V3.tilt_get(...) end end
fx.cnum = C.cnum; fx.item_name = C.item_name; fx.nitems = function() return #C._data.ITEMS end
fx.bank_cap = C.bank_cap; fx.iron_block = function(w) return C.iron_block(w) end
fx.notes_since = function(t) return C.notes_since(S, t) end
fx.food_in_bank = function()
local IT, best = C._data.ITEMS, nil
for i = 1, #IT do if IT[i][5] == "i_food" and S.camp.inv[i] > 0 and (not best or IT[i][2] < IT[best][2]) then best = i end end
return best
end
F = dofile("friends.lua")(fx)
GR = dofile("grade.lua")(fx)
C.gift_item = F.gift_item
SCREENS.friends = F.draw_friends; SCREENS.codeentry = F.draw_entry; SCREENS.duel = F.draw_duel; SCREENS.away = F.draw_away; SCREENS.frames = GR.draw; SCREENS.grading = GR.draw; SCREENS.ourpet = F.draw_pet_shared
if F.check_away(last) then scr = "away" end
local lastver = smudge.load("lastver", "")
if lastver ~= GAME_VERSION then
smudge.save("lastver", GAME_VERSION)
if lastver ~= "" then note = "CardScape updated to v" .. GAME_VERSION .. "!" end
end
end
local HELP
local function help_text()
if not HELP then HELP = dofile("help.lua") end
if scr == "skill" and C and C.cur_skill then
local si = C.cur_skill()
local sk = C.skill_name and C.skill_name(si) or "Skill"
return sk, HELP.SKILL[si] or ""
end
local h = HELP.H[scr]
if h then return h[1], h[2] end
return "Help", "Tap the buttons to explore this screen. BACK returns to the previous screen."
end
local function draw_help_button()
local y = H - 96
if STONE or CS_SMOOTH then
button(HELP_X, y, HELP_W, 64, "?", function() help_open = not help_open end, { font = "bitter14", nohelp = true, active = help_open, id = "HELP" })
return
end
if not SAVER then smudge.rounded_rect(HELP_X + 4, y + 5, HELP_W, 64, 10, true) end
smudge.rounded_rect(HELP_X, y, HELP_W, 64, 10, true, 1, false)
smudge.rounded_rect(HELP_X, y, HELP_W, 64, 10, false, 2)
if help_open then smudge.rounded_rect(HELP_X + 5, y + 5, HELP_W - 10, 54, 7, false, 1) end
ctext(HELP_X + HELP_W // 2, y + 32 - lh("bitter14") // 2, "?", "bitter14", "bold")
reg("HELP", HELP_X, y, HELP_W, 64, function() help_open = not help_open end, false)
end
local function draw_help()
if not help_open then return end
local t, body = help_text()
local x0, y0, w = 16, bar_pad() + BAR_H + 10, W - 32
local h = H - 112 - y0
reg("HELPCLOSE", 0, 0, W, H, function() help_open = false end)
if not SAVER then smudge.rounded_rect(x0 + 6, y0 + 6, w, h, 14, true) end
smudge.rounded_rect(x0, y0, w, h, 14, true, 1, false)
smudge.rounded_rect(x0, y0, w, h, 14, false, 3)
smudge.circle(x0 + 30, y0 + 30, 16, true)
ctext(x0 + 30, y0 + 30 - lh("ui12") // 2, "?", "ui12", "bold", true)
ltext(x0 + 56, y0 + 16, fit(t, w - 70, "ui12", "bold"), "ui12", "bold")
smudge.line(x0 + 14, y0 + 56, x0 + w - 14, y0 + 56, 2)
if C and C.wiki_open then
smudge.rounded_rect(x0 + 14, y0 + 66, w - 28, 44, 10, false, 2)
ltext(x0 + 28, y0 + 76, "Search items or monsters", "ui10")
smudge.circle(x0 + w - 44, y0 + 86, 9, false, 2); smudge.line(x0 + w - 37, y0 + 93, x0 + w - 30, y0 + 100, 3)
reg("HELPSEARCH", x0 + 14, y0 + 66, w - 28, 44, function() help_open = false; C.wiki_open() end, false)
end
local y = y0 + 124
for para in (body .. "\n"):gmatch("(.-)\n") do
if para ~= "" and y < y0 + h - 40 then
local res = smudge.wrapped_text(para, w - 36, "small", "regular", math.max(1, (y0 + h - 40 - y) // (lh("small") + 4)))
for _, line in ipairs(res.lines) do ltext(x0 + 18, y, line, "small"); y = y + lh("small") + 4 end
y = y + 8
end
end
ctext(W // 2, y0 + h - 30, "tap anywhere to close", "small")
end
function on_draw()
smudge.clear()
if STONE and smudge.tint_base and not SAVER then smudge.tint_base(TT.bg)
else ttint(0, 0, W, H, TT.bg) end
nbtn = 0
if PH then PH.frame(); clip() end
SWIPE = {}
local f = SCREENS[scr]
if f then f() end
draw_help_button()
draw_help()
if C and S and not help_open then C.draw_qinv(S); if C.draw_wiki then C.draw_wiki(S) end; C.draw_drop(S); C.draw_toast(S) end
draw_popup()
draw_focus()
end
function on_touch(a, b, c, d, e)
local ev, x, y
if type(a) == "string" then ev, x, y = a, b, c else x, y, ev = a, b, c end
if scr == "card3d" and (ev == "down" or ev == "move" or ev == "release") then V3.touch(ev, x, y, d); redraw(); return end
if scr == "reveal" and P3.touch(ev, x, y) then redraw(); return end
if scr == "album" and BIND.touch(ev, x, y) then redraw(); return end
if scr == "detail" and V3.mini_touch(ev, x, y) then redraw(); return end
if scr == "ourpet" and F and F.pet_touch and F.pet_touch(ev, x, y) then redraw(); return end
if scr == "worldmap" and C and C.map_touch and C.map_touch(ev, x, y) then V3.moving = smudge.millis() + 600; redraw(); return end
if (scr == "ourpet" or scr == "packs" or scr == "title" or scr == "worldmap") and V3.tilt_touch(ev, x, y) then redraw(); return end
if ev == "down" or ev == "move" or ev == "release" then BFX.touch(ev, x, y) end
if PH and (ev == "down" or ev == "move" or ev == "release") then
if PH.touch(ev, x, y, d, e) or CS_SMOOTH then redraw() end
return
end
if ev == "down" or ev == "release" then if CS_SMOOTH then redraw() end; return end
if ev ~= "up" and ev ~= "tap" then return end
if BFX.press and not BFX.rel then BFX.rel = smudge.millis() end
if type(x) ~= "number" or type(y) ~= "number" then return end
if PH and PH.eat_tap() then redraw(); return end
local now = smudge.millis()
if now - last_act < (CS_SMOOTH and 90 or 250) then return end
for i = nbtn, 1, -1 do
local bt = btns[i]
if smudge.in_rect(x, y, bt.x, bt.y, bt.w, bt.h) then
last_act = now
use_focus = false
if bt.frame == false and BFX.live() then BFX.tap(bt, x, y) end
if bt.act then bt.act() end
redraw()
return
end
end
end
function on_button(btn, pressed)
if not pressed then return end
if btn == "home" then go_home(); return end
if help_open then help_open = false; redraw(); return end
if C and C.qinv_open and C.qinv_open() then C.close_qinv(); redraw(); return end
if C and C.drop_open and C.drop_open() then C.close_drop(); redraw(); return end
if C and C.wiki_is_open and C.wiki_is_open() then C.wiki_back(); redraw(); return end
if btn == "back" then use_focus = true; go_back(); return end
if btn == "confirm" then
use_focus = true
local b = btns[focus]
if b and b.act then b.act() end
redraw()
return
end
if nbtn == 0 then return end
if btn == "up" or btn == "left" or btn == "page_back" then
use_focus = true
focus = (focus - 2) % nbtn + 1
redraw()
elseif btn == "down" or btn == "right" or btn == "page_forward" then
use_focus = true
focus = focus % nbtn + 1
redraw()
end
end
local last_chk = -1e9
local idle_anim_at = 0
local sec_tick = 0
function on_update()
if note ~= "" and note == note_seen and smudge.millis() - note_at > NOTE_MS then
note = ""; note_seen = ""; redraw()
end
if S and S.camp and smudge.millis() - last_chk > (CS_SMOOTH and 1000 or 5000) then
last_chk = smudge.millis()
if C.check_notes(S) then redraw() end
if GR then local m = GR.tick(); if m then note = m; redraw() end end
end
if S and S.camp and C.update(S.camp) then
dirty = true
if scr == "camp" and not SAVER then redraw() end
end
if CS_SMOOTH and not SAVER and scr == "reveal" and RV and RV.idx == 0 then redraw() end
if CS_SMOOTH and not SAVER and (scr == "ourpet" or scr == "star" or scr == "card3d" or (scr == "title" and H >= 860) or (scr == "battle" and V3.ok()) or (scr == "reveal" and RV and RV.idx == -1) or (scr == "album" and (BIND.turn or BIND.drag or BIND.open_t or BIND.on())) or (scr == "worldmap" and V3.ok()) or (scr == "packs" and V3.ok()) or (scr == "detail" and V3.ok() and owned(sel))) and smudge.millis() - idle_anim_at >= ((scr == "card3d" or (scr == "reveal" and RV and RV.idx == -1) or smudge.millis() < V3.moving) and 15 or 32) then idle_anim_at = smudge.millis(); redraw() end
if PH and PH.update() then redraw() end
if BFX.live() and BFX.busy() and smudge.millis() - idle_anim_at >= 32 then idle_anim_at = smudge.millis(); redraw() end
if CS_SMOOTH and not SAVER and smudge.millis() - sec_tick >= 1000 then sec_tick = smudge.millis(); redraw() end
if timer_fn and smudge.millis() >= timer_at then
local f = timer_fn
timer_fn = nil
f()
end
end
function on_exit()
if S and dirty then save_now() end
end
function cs_save_now()
if S then save_now() end
end
function cs_times(t0, t1)
local out, seen = {}, {}
if S and S.camp and C.times then
C.times(S, t0, t1, function(t) if t > t0 and t <= t1 and not seen[t] then seen[t] = true; out[#out + 1] = t end end)
end
table.sort(out)
return table.concat(out, ",")
end
function cs_check()
if S and S.camp then C.check_notes(S) end
end
if __CPQ_TEST then
__CPQ_TEST.get = function() return { bind = BIND, gr = GR, bfx = BFX, btns = btns, nbtn = nbtn, S = S, C = C, anim_t = anim_t, scr = scr, B = B, RV = RV, focus = focus, note = note, F = F } end
__CPQ_TEST.go = function(n) go(n) end
__CPQ_TEST.theme = function(i) theme_i = i; smudge.save("style", THEMES[i][1]); apply_theme() end
__CPQ_TEST.screens = function() local t = {} for k in pairs(SCREENS) do t[#t + 1] = k end table.sort(t) return t end
__CPQ_TEST.sel = function(c) sel = c end
__CPQ_TEST.fight = function(c) start_battle(c) end
__CPQ_TEST.end_battle = function(w) end_battle(w) end
__CPQ_TEST.screens = function() local t = {} for k in pairs(SCREENS) do t[#t + 1] = k end table.sort(t) return t end
end
rsps.lua
37779
return function(X, K, C, ADV, G)
local R = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function today() return now() // 86400 end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function I(id) return IDX[id] end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
local V = {}
local function load()
V = {}
for part in (smudge.load("rsps", "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then V[k] = tonumber(v) end
end
end
local function save()
local p = {}
for k, v in pairs(V) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
table.sort(p)
smudge.save("rsps", table.concat(p, ";"))
end
load()
R.load, R.save = load, save
local function get(k) return V[k] or 0 end
local function add(k, n) V[k] = (V[k] or 0) + n; save() end
R.get, R.add = get, add
R.V = function() return V end
function R.iron() return get("iron") == 1 end
C.is_iron = R.iron
function R.iron_block(what)
if R.iron() then X.set_note("Iron Mode: you can't " .. what .. ". Gather and make it yourself!"); return true end
return false
end
function R.luck()
return (get("ring") + get("amu")) * 0.02 + (R.iron() and 0.05 or 0)
end
function G.lucky(n)
local m = math.max(1, fl(n / (1 + R.luck()) + 0.5))
return X.rnd(1, m) == 1
end
local LUCK = {
{ key = "ring", name = "Ring of wealth", mat = "scale", matname = "Boss scales" },
{ key = "amu", name = "Amulet of luck", mat = "stardust", matname = "stardust" },
}
local function luck_cost(L) return 300 * (L + 1), math.max(1, fl((L + 2) / 2)), 25 * (L + 1), 15 * (L + 1) end
local function luck_up(S, k)
local cp = S.camp
local g = LUCK[k]
local L = get(g.key)
if L >= 10 then X.set_note(g.name .. " is already +10."); return end
local coins, scales, sd, dust = luck_cost(L)
if S.coins < coins then X.set_note("Need " .. coins .. " coins."); return end
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
if g.mat == "scale" then
if cp.inv[I("scale")] < scales then X.set_note("Need " .. scales .. " Boss scales."); return end
cp.inv[I("scale")] = cp.inv[I("scale")] - scales
else
if cp.x.stardust < sd then X.set_note("Need " .. sd .. " stardust (shooting stars)."); return end
cp.x.stardust = cp.x.stardust - sd
end
S.coins = S.coins - coins; S.dust = S.dust - dust
add(g.key, 1)
X.set_note(string.format("%s is now %s! Luck +%d%%", g.name, L == 0 and "made" or ("+" .. (L + 1)), fl(R.luck() * 100 + 0.5)))
X.save_now()
end
local KC = {
{ key = "wb1", name = "Quill Behemoth", base = "Quillbreaker", ms = { 10, 50, 100, 250 } },
{ key = "wb2", name = "Bandit King", base = "Bandit Bane", ms = { 10, 50, 100, 250 } },
{ key = "wb3", name = "Totem Lord", base = "Totem Toppler", ms = { 10, 50, 100, 250 } },
{ key = "wb4", name = "Thunder Rooster", base = "Storm Plucker", ms = { 10, 50, 100, 250 } },
{ key = "raid", name = "Raids", base = "Hatter Slayer", ms = { 5, 25, 50, 100 } },
{ key = "todt", name = "Wintertodt", base = "Firekeeper", ms = { 5, 25, 50, 100 } },
{ key = "slay", name = "Slayer kills", base = "Monster Hunter", ms = { 25, 100, 250, 1000 } },
}
R.KC = KC
local RANK = { "", "Elite ", "Master ", "Grand " }
local KCI = {}
for k, e in ipairs(KC) do KCI[e.key] = k end
local function kc_count(cp, key)
if key == "raid" then return cp.x.raids end
if key == "todt" then return cp.x.todt end
return get("kc_" .. key)
end
local function tier_n(key, n)
local e = KC[KCI[key]]
if not e then return 0 end
local t = 0
for _, m in ipairs(e.ms) do if n >= m then t = t + 1 end end
return t
end
local function kc_tier(cp, key) return tier_n(key, kc_count(cp, key)) end
function R.kc_add(S, key)
local cp = S.camp
if key ~= "raid" and key ~= "todt" then add("kc_" .. key, 1) end
local after = kc_tier(cp, key)
local before = tier_n(key, kc_count(cp, key) - 1)
if after > before then
local e = KC[KCI[key]]
ADV.notify(string.format("New title: %s%s! (+%d%% vs %s)", RANK[after], e.base, 2 * after, e.name), "titles")
return string.format("  KC %d: title %s%s!", kc_count(cp, key), RANK[after], e.base)
end
return ""
end
function R.kc_bonus(cp, key) if not key then return 0 end return 0.02 * kc_tier(cp, key) end
local function title_of(cp, k)
if k == #KC + 1 then return R.iron() and "Ironman" or nil end
local e = KC[k]
if not e then return nil end
local t = kc_tier(cp, e.key)
if t == 0 then return nil end
return RANK[t] .. e.base
end
function R.title(cp)
local k = get("title")
if k == 0 then return nil end
return title_of(cp, k)
end
local PMAX = 5
function R.prestige(si) return get("p" .. si) end
local function do_prestige(S, si)
local cp = S.camp
local p = get("p" .. si)
if p >= PMAX then X.set_note(SK[si].name .. " is already prestige " .. PMAX .. "."); return end
if lvl(cp, si) < 99 then X.set_note("Prestige needs level 99."); return end
cp.sxp[si] = 0
add("p" .. si, 1)
X.set_note(string.format("%s PRESTIGE %d! Back to level 1 with +%d%% xp and +%d%% extra drops for good.", SK[si].name, p + 1, 5 * (p + 1), 5 * (p + 1)))
ADV.notify(SK[si].name .. " reached prestige " .. (p + 1) .. "!", "prestige")
X.save_now()
end
function R.mega(si) return get("mp" .. si) == 1 end
function R.mega_roll(S, si, ch)
if R.mega(si) or not G.lucky(ch) then return "" end
V["mp" .. si] = 1; save()
local n = ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
ADV.notify("MEGA PET: your " .. n .. " grew huge!", "megapets")
return "  Your " .. n .. " grows into a MEGA pet!"
end
local function give_mega(S)
local cp = S.camp
local cand = {}
for si = 1, 16 do if I("pet" .. si) and ADV.owns(cp, "pet" .. si) and not R.mega(si) then cand[#cand + 1] = si end end
if #cand == 0 then return nil end
local si = cand[X.rnd(1, #cand)]
V["mp" .. si] = 1; save()
return "MEGA " .. ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
end
local xp0 = G.xp_bonus
G.xp_bonus = function(cp, si)
local m = xp0(cp, si)
if si then
m = m + 0.05 * get("p" .. si)
if R.mega(si) then m = m + 0.05 end
end
if R.iron() then m = m + 0.10 end
return m
end
function R.gather_bonus(si)
local n, note = 0, ""
local p = get("p" .. si)
if p > 0 and X.rnd(1, 100) <= 5 * p then n = n + 1; note = "  (prestige +1)" end
if R.mega(si) and X.rnd(1, 100) <= 20 then n = n + 1; note = note .. "  (mega pet +1)" end
return n, note
end
local BOX = { "Bronze box", "Silver box", "Gold box", "Mythic box" }
R.BOX = BOX
function R.give_box(t, n) add("b" .. t, n or 1) end
function R.give_key(n) add("key", n or 1) end
function R.give_token(n) add("tok", n or 1) end
local function unique_item(S)
local cp = S.camp
local cand = {}
for _, it in ipairs(ADV.items) do
local id = it[4]
if it[5] and not it[6] and not id:find("^cape") and id ~= "maxcape" and id ~= "qcape" and not ADV.owns(cp, id) then cand[#cand + 1] = id end
end
if #cand == 0 then X.add_coins(3000); return "3000 coins (you own every unique!)" end
local id = cand[X.rnd(1, #cand)]
ADV.grant(cp, id)
return "UNIQUE: " .. ITEMS[I(id)][1] .. "!"
end
local RUNE_IDS = { "rair", "rwater", "rearth", "rfire", "rchaos", "rnature", "rdeath", "rblood" }
local function rune_bag(S, n)
local cp = S.camp
local got, pool = {}, {}
for k, r in ipairs(RUNE_IDS) do pool[k] = r end
for _ = 1, 3 do
local r = table.remove(pool, X.rnd(1, #pool))
local k = fl(n / 3) + X.rnd(0, 3)
K.add_item(cp, I(r), k); got[#got + 1] = k .. " " .. ITEMS[I(r)][1]
end
return table.concat(got, ", ")
end
local RES = { "oak", "willow", "maple", "yew", "coal", "iron", "mith", "adam", "salmon", "lob" }
local function resources(S, n)
local id = RES[X.rnd(1, #RES)]
K.add_item(S.camp, I(id), n)
return n .. " " .. ITEMS[I(id)][1]
end
local function coins(n) return function() X.add_coins(n); return n .. " coins" end end
local function dust(n) return function() X.add_dust(n); return n .. " dust" end end
local POOLS = {
{
{ 30, "150 coins", coins(150) }, { 15, "300 coins", coins(300) }, { 20, "25 dust", dust(25) },
{ 20, "Resources", function(S) return resources(S, X.rnd(4, 8)) end },
{ 10, "2 Attack pots", function(S) K.add_item(S.camp, I("patk"), 2); return "2 Attack potions" end },
{ 4, "Silver box", function() R.give_box(2); return "a Silver box!" end, true },
{ 1, "Crystal key", function() R.give_key(); return "a Crystal key!" end, true },
},
{
{ 25, "500 coins", coins(500) }, { 10, "1000 coins", coins(1000) }, { 20, "60 dust", dust(60) },
{ 15, "Pack ticket", function(S) S.camp.tickets = S.camp.tickets + 1; return "a pack ticket" end },
{ 15, "Rune bag", function(S) return rune_bag(S, 30) end },
{ 6, "Instance token", function() R.give_token(); return "an Instance token!" end, true },
{ 5, "Crystal key", function() R.give_key(); return "a Crystal key!" end, true },
{ 4, "Gold box", function() R.give_box(3); return "a Gold box!" end, true },
},
{
{ 20, "2000 coins", coins(2000) }, { 20, "150 dust", dust(150) },
{ 20, "RARE ticket", function(S) S.camp.rtickets = S.camp.rtickets + 1; return "a RARE pack ticket" end },
{ 12, "Instance token", function() R.give_token(); return "an Instance token!" end },
{ 12, "2 Crystal keys", function() R.give_key(2); return "2 Crystal keys!" end },
{ 8, "Unique item", unique_item, true },
{ 3, "Mythic box", function() R.give_box(4); return "a MYTHIC box!" end, true },
},
{
{ 15, "5000 coins", coins(5000) }, { 15, "400 dust", dust(400) },
{ 20, "3 RARE tickets", function(S) S.camp.rtickets = S.camp.rtickets + 3; return "3 RARE pack tickets" end },
{ 25, "Unique item", unique_item, true },
{ 10, "Mega pet", function(S) return give_mega(S) or unique_item(S) end, true },
{ 14, "Mythic card", function()
local c = X.D.pick(5, nil, X.rnd); X.give_card(c); return "MYTHIC card: " .. X.cname(c) .. "!" end, true },
{ 1, "SECRET CARD", function()
local l = X.D.tier_cards[6]; local c = l[X.rnd(1, #l)]; X.give_card(c); return "SECRET CARD: " .. X.cname(c) .. "!!!" end, true },
},
{
{ 20, "800 coins", coins(800) }, { 15, "100 dust", dust(100) },
{ 20, "Rune bag", function(S) return rune_bag(S, 45) end },
{ 15, "Rare ores", function(S)
local cp = S.camp; local id = ({ "rstone", "dragon", "celes" })[X.rnd(1, 3)]; local n = X.rnd(3, 6)
K.add_item(cp, I(id), n); return n .. " " .. ITEMS[I(id)][1] end },
{ 15, "Silver box", function() R.give_box(2); return "a Silver box!" end },
{ 10, "Unique item", unique_item, true },
{ 5, "Gold box", function() R.give_box(3); return "a Gold box!" end, true },
},
}
R.POOLS = POOLS
local function pick(pool)
local lk = 1 + R.luck()
local tot = 0
for _, e in ipairs(pool) do tot = tot + e[1] * (e[4] and lk or 1) end
local r = X.rnd(1, 1000000) / 1000000 * tot
for _, e in ipairs(pool) do
r = r - e[1] * (e[4] and lk or 1)
if r <= 0 then return e end
end
return pool[#pool]
end
local RL
local CELL = 132
local function reel_frame()
if not RL or RL.done then return end
local p = math.min(1, (X.millis() - RL.t0) / RL.dur)
local e = 1 - (1 - p) ^ 3
RL.pos = 1 + e * (RL.target - 1)
if p >= 1 then RL.pos = RL.target; RL.done = true; X.set_note(RL.result) else X.after(X.fstep(140), reel_frame) end
X.redraw()
end
local function open_box(S, tier)
local key = (tier == 5) and "key" or ("b" .. tier)
if get(key) < 1 then X.set_note(tier == 5 and "You have no Crystal keys." or ("You have no " .. BOX[tier] .. "es.")); return end
if RL and not RL.done then return end
add(key, -1)
local pool = POOLS[tier]
local e = pick(pool)
local res = e[3](S)
add("opened", 1)
if e[4] then ADV.notify((tier == 5 and "Crystal chest" or BOX[tier]) .. ": " .. res, "loot") end
local strip = {}
for k = 1, 30 do strip[k] = pool[X.rnd(1, #pool)][2] end
local target = 26
strip[target] = e[2]
strip[target - 1] = pool[#pool][2]
RL = { tier = tier, strip = strip, target = target, pos = 1, t0 = X.millis(), dur = 2400, result = "You won: " .. res, rare = e[4], res = res }
X.save_now()
X.go("reel")
X.after(X.fstep(140), reel_frame)
end
R.open_box = open_box
local WHEEL = {
{ 25, "250c", coins(250) }, { 20, "50 dust", dust(50) },
{ 20, "Bronze", function() R.give_box(1); return "a Bronze box" end },
{ 12, "Silver", function() R.give_box(2); return "a Silver box" end },
{ 10, "Key", function() R.give_key(); return "a Crystal key" end },
{ 8, "50c", function(S) X.add_coins(50); return "50 coins" end },
{ 3, "Token", function() R.give_token(); return "an Instance token" end },
{ 2, "GOLD", function() R.give_box(3); return "a GOLD box!" end },
}
local WL
local function wheel_spins() return ((get("wd") ~= today()) and 1 or 0) + get("wx") end
R.wheel_spins = wheel_spins
local function wheel_frame()
if not WL or WL.done then return end
local p = math.min(1, (X.millis() - WL.t0) / WL.dur)
local e = 1 - (1 - p) ^ 3
WL.ang = e * WL.target
if p >= 1 then WL.done = true; X.set_note("Wheel of Fortune: " .. WL.res) else X.after(X.fstep(140), wheel_frame) end
X.redraw()
end
local function spin(S)
local cp = S.camp
if WL and not WL.done then return end
if wheel_spins() < 1 then X.set_note("No spins left. Come back tomorrow!"); return end
if get("wd") ~= today() then V.wd = today() else V.wx = get("wx") - 1 end
save()
local tot = 0
for _, e in ipairs(WHEEL) do tot = tot + e[1] end
local r, k = X.rnd(1, tot), 1
for i, e in ipairs(WHEEL) do r = r - e[1]; if r <= 0 then k = i; break end end
local res = WHEEL[k][3](S)
local seg = 2 * math.pi / #WHEEL
WL = { k = k, res = res, t0 = X.millis(), dur = 2600, ang = 0, target = 3 * 2 * math.pi + (k - 1) * seg + seg / 2 }
X.save_now()
X.after(X.fstep(140), wheel_frame)
end
local function tok() return function() R.give_token(); return "an Instance token" end end
local function box(t, n) return function() R.give_box(t, n); return (n and n > 1 and (n .. " ") or "") .. BOX[t] .. ((n and n > 1) and "es" or "") end end
local function key(n) return function() R.give_key(n); return (n or 1) .. " Crystal key" .. ((n or 1) > 1 and "s" or "") end end
local LOGIN = {
{ "100c", coins(100) }, { "20d", dust(20) }, { "Pots", function(S) K.add_item(S.camp, I("patk"), 2); return "2 Attack potions" end },
{ "Brnz", box(1) }, { "200c", coins(200) }, { "40d", dust(40) },
{ "Slvr", function(S) R.give_box(2); S.camp.tickets = S.camp.tickets + 1; return "a Silver box + pack ticket" end },
{ "300c", coins(300) }, { "Key", key(1) }, { "60d", dust(60) }, { "Brnz", box(1) }, { "400c", coins(400) },
{ "Tokn", tok() }, { "Gold", function(S) R.give_box(3); S.camp.rtickets = S.camp.rtickets + 1; return "a Gold box + RARE ticket" end },
{ "500c", coins(500) }, { "80d", dust(80) }, { "Slvr", box(2) }, { "Key", key(1) }, { "600c", coins(600) },
{ "Spin", function() V.wx = get("wx") + 2; save(); return "2 extra Wheel spins" end },
{ "Gold", function(S) R.give_box(3); S.camp.tickets = S.camp.tickets + 2; return "a Gold box + 2 tickets" end },
{ "700c", coins(700) }, { "100d", dust(100) }, { "Tokn", tok() }, { "Slvr", box(2) }, { "2key", key(2) }, { "1k c", coins(1000) },
{ "CHEST", function(S)
R.give_box(4); R.give_box(3); S.camp.rtickets = S.camp.rtickets + 3; X.add_dust(500)
return "THE BIG CHEST: Mythic box, Gold box, 3 RARE tickets, 500 dust!" end },
}
local function login_ready() return get("ld") ~= today() end
R.login_ready = login_ready
local function login_claim(S)
if not login_ready() then X.set_note("Already claimed today. Come back tomorrow!"); return end
local d, s = get("ld"), get("ls")
local note = ""
if d ~= 0 and d < today() - 1 then
local missed = today() - 1 - d
local drop = math.min(s, 3 * missed)
s = s - drop
note = "  (missed " .. missed .. " day" .. (missed > 1 and "s" or "") .. ": back " .. drop .. ")"
end
s = s % 28 + 1
V.ld = today(); V.ls = s; save()
local res = LOGIN[s][2](S)
X.set_note("Day " .. s .. ": " .. res .. note)
X.save_now()
end
local function inst_bosses()
local list = {}
for k, b in ipairs(G.WBOSS) do list[#list + 1] = { name = b[1], card = b[3], weak = ADV.CB.WB_WEAK[k], uniq = b[4], kc = "wb" .. k, m = 17 + k } end
list[#list + 1] = { name = "Mad Hatter", card = 33, weak = 2, kc = "raid", olm = true, m = 17 }
return list
end
local function inst_drops(cp, k)
local b = inst_bosses()[k]
local c = ADV.CB.stats(cp)
local rows = { { "Coins", tostring(80 + 2 * c.clvl), 1 }, { "Dust", "20", 1 } }
if b.uniq then rows[#rows + 1] = { ITEMS[I(b.uniq)][1], "1", ADV.p(30, true) } end
if b.olm then rows[#rows + 1] = { "A raid purple", "1", ADV.p(60, true) } end
rows[#rows + 1] = { "Silver box", "1", ADV.p(6, true) }
ADV.herb_rows(rows, 40 + 8 * c.clvl)
return b.name .. " (instance)", rows, "uses 1 instance kill"
end
R.inst_list, R.inst_drops = inst_bosses, inst_drops
local function inst_fight(S, k)
local cp = S.camp
if get("ik") < 1 then X.set_note("Use an Instance token first (10 kills)."); return end
local b = inst_bosses()[k]
local c = ADV.CB.stats(cp)
local hp = 40 + 8 * c.clvl
ADV.CB.start(S, {
title = "Instance - " .. b.name, name = b.name, card = b.card, boss = true, art = string.format("art/m%02d.raw", b.m), hp = hp, maxhp = hp,
maxhit = fl(3 + 0.5 * c.clvl), weak = b.weak, special = 4, kc = b.kc, back = "instance",
drops = function() return inst_drops(cp, k) end,
again = function(S2) inst_fight(S2, k) end,
on_end = function(S2, win)
if not win then return "Knocked out. The instance stays open - no kill used." end
V.ik = math.max(0, get("ik") - 1); save()
local cn = 80 + 2 * c.clvl
X.add_coins(cn); X.add_dust(20)
local t = string.format("%s is down! +%d coins, 20 dust. Instance kills left: %d", b.name, cn, get("ik"))
if not b.olm then t = t .. R.kc_add(S2, b.kc) end
if b.uniq and G.lucky(30) then ADV.grant(cp, b.uniq); t = t .. "  UNIQUE: " .. ITEMS[I(b.uniq)][1] .. "!" end
if b.olm and G.lucky(60) then t = t .. "  " .. unique_item(S2) end
if G.lucky(6) then R.give_box(2); t = t .. "  Silver box!" end
return t
end,
})
end
local function forge_list(cp)
local list = {}
for i = 1, #ITEMS do
local e = K.EQL[i]
if e and cp.inv[i] >= 3 then list[#list + 1] = i end
end
return list
end
local function forge_next(i)
local e = K.EQL[i]
local cand = {}
for j = 1, #ITEMS do
local f = K.EQL[j]
if f and j ~= i and f[1] == e[1] and ITEMS[j][2] > ITEMS[i][2] and not ITEMS[j][1]:find("[Cc]ape$") then
cand[#cand + 1] = j
end
end
table.sort(cand, function(a, b) return ITEMS[a][2] < ITEMS[b][2] end)
local out = {}
for k = 1, math.min(3, #cand) do out[k] = cand[k] end
return out
end
local function forge_chance() return math.min(90, 60 + fl(R.luck() * 50)) end
local function forge_cost(i) return math.max(50, 2 * ITEMS[i][2]) end
local function forge(S, i)
local cp = S.camp
if cp.inv[i] < 3 then X.set_note("You need 3 of that item."); return end
local nx = forge_next(i)
if #nx == 0 then X.set_note("That is already the best of its kind."); return end
local cost = forge_cost(i)
if S.coins < cost then X.set_note("The forge costs " .. cost .. " coins."); return end
S.coins = S.coins - cost
if X.rnd(1, 100) <= forge_chance() then
cp.inv[i] = cp.inv[i] - 3
local j = nx[X.rnd(1, #nx)]
K.add_item(cp, j, 1)
X.set_note("The forge roars! 3 " .. ITEMS[i][1] .. " -> " .. ITEMS[j][1] .. "!")
else
cp.inv[i] = cp.inv[i] - 2
X.set_note("The forge fails... 2 " .. ITEMS[i][1] .. " melt, you keep 1.")
end
X.save_now()
end
function R.on_slayer_kill(S)
local t = ""
if G.lucky(10) then R.give_box(1); t = t .. "  Bronze box!" end
if G.lucky(40) then R.give_box(2); t = t .. "  Silver box!" end
if G.lucky(30) then R.give_key(); t = t .. "  Crystal key!" end
return t .. R.kc_add(S, "slay")
end
function R.on_wb_kill(S, bi)
R.give_box(2)
local t = "  Silver box!"
if G.lucky(4) then R.give_box(3); t = t .. "  Gold box!" end
return t .. R.kc_add(S, "wb" .. bi)
end
function R.on_raid(S)
local t = ""
if G.lucky(3) then R.give_box(3); t = "  Gold box!" else R.give_box(2); t = "  Silver box!" end
if G.lucky(50) then R.give_box(4); t = t .. "  MYTHIC BOX!" end
if G.lucky(3) then R.give_token(); t = t .. "  Instance token!" end
return t .. R.kc_add(S, "raid")
end
function R.on_todt(S, pts, won)
local t = ""
if pts >= 300 then R.give_box(1); t = "  Bronze box!" end
if won and G.lucky(5) then R.give_box(2); t = t .. "  Silver box!" end
if won then t = t .. R.kc_add(S, "todt") end
return t
end
function R.on_challenge(S)
R.give_box(1)
local t = " +Bronze box"
if G.lucky(4) then R.give_token(); t = t .. " +Instance token" end
return t
end
function R.box_total() return get("b1") + get("b2") + get("b3") + get("b4") + get("key") end
function R.badges(S)
return { loot = R.box_total() + wheel_spins(), perks = (login_ready() and 1 or 0) }
end
function R.check(S)
if login_ready() and get("ln") ~= today() then V.ln = today(); save(); ADV.notify("Your daily login reward is ready!", "login") end
end
R.SCR = { "loot", "reel", "wheel", "forge", "perks", "login", "prestige", "luck", "titles", "instance", "iron", "megapets" }
R.PARENT = { loot = "adventure", reel = "loot", wheel = "loot", forge = "loot", perks = "adventure", login = "perks", prestige = "perks",
luck = "perks", titles = "perks", instance = "perks", iron = "perks", megapets = "perks" }
local function box_icon(x, y, t)
sprite(x, y, 32, "a14")
for k = 1, t do smudge.circle(x + 4 + (k - 1) * 8, y + 38, 3, true) end
end
function C.draw_loot(S)
head(S, "Loot", "luck +" .. fl(R.luck() * 100 + 0.5) .. "%")
local y = TOPY() + 4
local rows = { { 1, "Bronze box", "coins, dust, resources" }, { 2, "Silver box", "tickets, runes, tokens" },
{ 3, "Gold box", "RARE tickets, uniques" }, { 4, "Mythic box", "mythic + SECRET cards" },
{ 5, "Crystal chest", "open with a Crystal key" } }
local sp = 82
for k, r in ipairs(rows) do
local by = y + (k - 1) * sp
local key = (r[1] == 5) and "key" or ("b" .. r[1])
local n = get(key)
panel(20, by, W - 40, sp - 8)
if r[1] == 5 then sprite(34, by + 12, 32, "a14"); smudge.circle(64, by + 46, 6, false, 2) else box_icon(34, by + 12, r[1]) end
X.ltext(84, by + 8, r[2] .. "  x" .. n, "ui10", "bold")
X.ltext(84, by + 38, r[3], "small")
X.button(W - 24 - 130, by + 6, 120, sp - 20, "OPEN", function() open_box(S, r[1]) end,
{ font = "ui10", off = n < 1, id = "BOX" .. r[1], dot = (n > 0) and n or nil })
end
local by = y + 5 * sp + 4
local hw = (W - 48 - 10) // 2
local sp_n = wheel_spins()
X.button(24, by, hw, 74, "WHEEL", function() X.go("wheel") end, { sub = sp_n .. " spin" .. (sp_n == 1 and "" or "s"), id = "WHEEL", dot = (sp_n > 0) and "!" or nil })
X.button(34 + hw, by, hw, 74, "FORGE", function() X.go("forge") end, { sub = "3 -> next tier", id = "FORGE" })
X.draw_note(by + 84)
back_btn("adventure")
end
function C.draw_reel(S)
head(S, RL and ((RL.tier == 5) and "Crystal chest" or BOX[RL.tier]) or "Loot", "")
if not RL then X.go("loot"); return end
local y = TOPY() + 20
if RL.tier == 5 then sprite(W // 2 - 16, y, 32, "a14") else box_icon(W // 2 - 16, y, RL.tier) end
local ry = y + 80
local rh = 130
smudge.rect(0, ry, W, rh, false, 3)
for i, lab in ipairs(RL.strip) do
local cx = fl(W / 2 + (i - RL.pos) * CELL)
if cx > -CELL and cx < W + CELL then
local win = RL.done and i == RL.target
local x0 = cx - CELL // 2 + 6
smudge.rounded_rect(x0, ry + 14, CELL - 12, rh - 28, 8, win, 2)
local words = {}
for w in lab:gmatch("%S+") do words[#words + 1] = w end
local l1, l2 = lab, nil
if #words > 1 and X.tw(lab, "small", "bold") > CELL - 24 then l1 = words[1]; l2 = table.concat(words, " ", 2) end
X.ctext(cx, ry + rh // 2 - (l2 and 22 or 10), l1, "small", "bold", win)
if l2 then X.ctext(cx, ry + rh // 2 + 2, l2, "small", "bold", win) end
end
end
smudge.triangle(W // 2 - 14, ry - 16, W // 2 + 14, ry - 16, W // 2, ry + 6, true)
smudge.triangle(W // 2 - 14, ry + rh + 16, W // 2 + 14, ry + rh + 16, W // 2, ry + rh - 6, true)
local by = ry + rh + 40
if RL.done then
X.ctext(W / 2, by, RL.rare and "* RARE! *" or "You won", "ui12", "bold")
X.wrapped(30, by + 36, RL.res, W - 60, "ui10", 3)
local t = RL.tier
local key = (t == 5) and "key" or ("b" .. t)
X.button(24, by + 130, W - 48, 74, "OPEN ANOTHER", function() open_box(S, t) end,
{ off = get(key) < 1, sub = get(key) .. " left", id = "REELAGAIN" })
else
X.ctext(W / 2, by, "Spinning...", "ui12", "bold")
end
back_btn("loot")
end
function C.draw_wheel(S)
local cp = S.camp
local n = wheel_spins()
head(S, "Wheel of Fortune", n .. " spin" .. (n == 1 and "" or "s"))
local cx, cy, r = W // 2, TOPY() + 200, 170
smudge.circle(cx, cy, r, false, 3)
smudge.circle(cx, cy, r - 6, false, 1)
local seg = 2 * math.pi / #WHEEL
local rot = WL and WL.ang or 0
for k, e in ipairs(WHEEL) do
local a0 = (k - 1) * seg - rot - math.pi / 2
smudge.line(cx, cy, cx + fl(math.cos(a0) * r), cy + fl(math.sin(a0) * r), 2)
local am = a0 + seg / 2
local tx, ty = cx + fl(math.cos(am) * r * 0.64), cy + fl(math.sin(am) * r * 0.64)
local win = WL and WL.done and WL.k == k
if win then smudge.rounded_rect(tx - 40, ty - 16, 80, 30, 6, true) end
X.ctext(tx, ty - 12, e[2], "small", "bold", win)
end
smudge.circle(cx, cy, 26, true)
X.ctext(cx, cy - 12, "SPIN", "small", "bold", true)
smudge.triangle(cx - 16, cy - r - 22, cx + 16, cy - r - 22, cx, cy - r + 10, true)
local by = cy + r + 22
if WL and WL.done then X.ctext(W / 2, by, "You won " .. WL.res .. "!", "ui10", "bold")
elseif WL then X.ctext(W / 2, by, "Spinning...", "ui10", "bold")
else X.ctext(W / 2, by, "One free spin a day", "small") end
X.button(24, by + 34, W - 48, 74, "SPIN THE WHEEL", function() spin(S) end,
{ off = n < 1 or (WL and not WL.done), sub = (n < 1) and "next spin tomorrow" or "free", id = "SPIN", dot = (n > 0) and "!" or nil })
back_btn("loot")
end
local fpage = 0
function C.draw_forge(S)
local cp = S.camp
head(S, "Upgrade forge", forge_chance() .. "% success")
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "3 of one gear piece -> a random better one", "small")
local list = forge_list(cp)
local per = 6
local pages = math.max(1, math.ceil(#list / per))
if fpage >= pages then fpage = pages - 1 end
if #list == 0 then X.wrapped(30, y0 + 60, "You don't have 3 of any piece of gear yet. Duplicates from bosses, Slayer, boxes and Smithing land here.", W - 60, "ui10", 4) end
local sp = 84
local function frow(n, k, by)
local i = list[n]
if i then
panel(20, by, W - 40, sp - 8)
sprite(30, by + 12, 24, ITEMS[i][3])
X.ltext(62, by + 6, X.fit(ITEMS[i][1] .. "  x" .. cp.inv[i], 250, "ui10", "bold"), "ui10", "bold")
local nx = forge_next(i)
local names = {}
for _, j in ipairs(nx) do names[#names + 1] = ITEMS[j][1] end
X.ltext(62, by + 36, X.fit(#nx > 0 and ("-> " .. table.concat(names, " / ")) or "top tier", 260, "small"), "small")
X.button(W - 24 - 120, by + 6, 110, sp - 20, "FORGE", function() forge(S, i) end,
{ font = "small", sub = forge_cost(i) .. "c", off = #nx == 0 or S.coins < forge_cost(i), id = "FORGE" .. k })
end
end
local ny = y0 + 28 + per * sp
if not X.list("forge", y0 + 28, nil, #list, sp, function(n, by) frow(n, n, by) end) then
for k = 1, per do frow(fpage * per + k, k, y0 + 28 + (k - 1) * sp) end
if pages > 1 then
X.button(24, ny, 140, 44, "PREV", function() if fpage > 0 then fpage = fpage - 1 end end, { font = "small", off = fpage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (fpage + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 44, "NEXT", function() if fpage < pages - 1 then fpage = fpage + 1 end end, { font = "small", off = fpage >= pages - 1, id = "NEXT" })
end
end
X.draw_note(ny + 50)
back_btn("loot")
end
function C.draw_perks(S)
local cp = S.camp
head(S, "Perks", R.iron() and "IRON MODE" or "")
local y = TOPY() + 4
local t = R.title(cp)
X.ctext(W / 2, y, t and ("Title: " .. t) or "No title chosen", "small", "bold")
local np, nm = 0, 0
for si = 1, #SK do np = np + get("p" .. si) end
for si = 1, 16 do if R.mega(si) then nm = nm + 1 end end
local list = {
{ "LOGIN", "day " .. get("ls") .. " / 28", "login", login_ready() and "!" or nil },
{ "LUCK GEAR", "luck +" .. fl(R.luck() * 100 + 0.5) .. "%", "luck" },
{ "TITLES", "kill counts", "titles" },
{ "INSTANCES", get("tok") .. " tokens, " .. get("ik") .. " kills", "instance" },
{ "IRON MODE", R.iron() and "ON" or "off", "iron" },
{ "MEGA PETS", nm .. " / 16", "megapets" },
}
local sp = rows_sp(y + 28, #list, 82)
for k, b in ipairs(list) do
X.button(24, y + 28 + (k - 1) * sp, W - 48, sp - 8, b[1], function() X.go(b[3]) end,
{ sub = b[2], id = b[1], dot = b[4] })
end
back_btn("adventure")
end
function C.draw_login(S)
head(S, "Daily login", "day " .. get("ls") .. " / 28")
local y = TOPY() + 6
local cw, ch = (W - 40) // 7, 70
local s = get("ls")
local nextd = login_ready() and (s % 28 + 1) or 0
for d = 1, 28 do
local col, row = (d - 1) % 7, (d - 1) // 7
local x, by = 20 + col * cw, y + row * (ch + 6)
local done = (d <= s) and not (nextd ~= 0 and s == 28)
if d == nextd then smudge.rounded_rect(x + 2, by, cw - 4, ch, 6, true)
else smudge.rounded_rect(x + 2, by, cw - 4, ch, 6, false, (d == 28) and 3 or 1) end
X.ctext(x + cw // 2, by + 4, tostring(d), "small", "bold", d == nextd)
X.ctext(x + cw // 2, by + 30, LOGIN[d][1], "small", (d == 28) and "bold" or nil, d == nextd)
if done and d ~= nextd then
smudge.line(x + cw - 24, by + ch - 14, x + cw - 18, by + ch - 8, 3)
smudge.line(x + cw - 18, by + ch - 8, x + cw - 8, by + ch - 22, 3)
end
end
local by = y + 4 * (ch + 6) + 10
X.button(24, by, W - 48, 76, login_ready() and ("CLAIM DAY " .. nextd) or "CLAIMED TODAY", function() login_claim(S) end,
{ off = not login_ready(), sub = login_ready() and ("reward: " .. LOGIN[nextd][1]) or "come back tomorrow", id = "LOGINCLAIM", dot = login_ready() and "!" or nil })
X.wrapped(30, by + 90, "Log in every day. Day 28 is the big chest (Mythic box, Gold box, 3 RARE tickets, 500 dust), then the calendar starts again. Missing a day only sets you back 3 days.", W - 60, "small", 4)
X.draw_note(by + 190)
back_btn("perks")
end
local ppage, pconfirm = 0, 0
function C.draw_prestige(S)
local cp = S.camp
head(S, "Prestige", "max " .. PMAX)
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "At 99: reset to 1 for +5% xp and +5% drops, forever.", "small")
local per = 10
local pages = math.ceil(#SK / per)
local sp = rows_sp(y0 + 26, per + 1, 60)
local function prrow(si, by)
if SK[si] then
local p, lv = get("p" .. si), lvl(cp, si)
panel(20, by, W - 40, sp - 6)
sprite(28, by + (sp - 6 - 32) // 2, 32, "sk" .. (si - 1))
X.ltext(68, by + 4, SK[si].name, "small", "bold")
X.ltext(68, by + sp - 30, "Lv " .. lv .. "   " .. (p > 0 and (string.rep("*", p) .. " +" .. 5 * p .. "%") or "no prestige"), "small")
local ok = lv >= 99 and p < PMAX
local lab = (pconfirm == si) and "SURE?" or (p >= PMAX and "MAX" or "PRESTIGE")
X.button(W - 24 - 130, by + 4, 120, sp - 14, lab, function()
if pconfirm == si then pconfirm = 0; do_prestige(S, si) else pconfirm = si; X.set_note("Tap again: " .. SK[si].name .. " goes back to level 1.") end
end, { font = "small", off = not ok, active = pconfirm == si, id = "PRES" .. si, dot = ok and "!" or nil })
end
end
local ny = y0 + 26 + per * sp
if not X.list("prestige", y0 + 26, nil, #SK, sp, prrow) then
for k = 1, per do prrow(ppage * per + k, y0 + 26 + (k - 1) * sp) end
X.button(24, ny, 140, 44, "PREV", function() ppage = math.max(0, ppage - 1); pconfirm = 0 end, { font = "small", off = ppage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (ppage + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 44, "NEXT", function() ppage = math.min(pages - 1, ppage + 1); pconfirm = 0 end, { font = "small", off = ppage >= pages - 1, id = "NEXT" })
end
back_btn("perks")
end
function C.draw_luck(S)
local cp = S.camp
head(S, "Luck gear", "+" .. fl(R.luck() * 100 + 0.5) .. "% luck")
local y = TOPY() + 6
for k, g in ipairs(LUCK) do
local by = y + (k - 1) * 180
local L = get(g.key)
panel(20, by, W - 40, 170)
X.ltext(34, by + 10, g.name .. (L > 0 and (" +" .. L) or " (not made)"), "ui12", "bold")
X.ltext(34, by + 46, "Luck +" .. (2 * L) .. "%   (max +20%)", "ui10", "bold")
for s = 1, 10 do
local sx = 34 + (s - 1) * 22
if s <= L then smudge.rect(sx, by + 78, 18, 14, true) else smudge.rect(sx, by + 78, 18, 14, false, 1) end
end
if L < 10 then
local c, sc, sd, du = luck_cost(L)
local mat = (g.mat == "scale") and (sc .. " Boss scales") or (sd .. " stardust")
X.ltext(34, by + 104, string.format("Next: %d coins, %d dust", c, du), "small")
X.ltext(34, by + 128, "+ " .. mat, "small")
X.button(W - 24 - 150, by + 100, 140, 58, L == 0 and "MAKE" or "UPGRADE", function() luck_up(S, k) end, { font = "ui10", id = "LUCK" .. k })
else
X.ltext(34, by + 104, "Fully upgraded!", "small", "bold")
end
end
X.wrapped(30, y + 366, "Luck makes rare rolls easier: boss uniques, raid purples, pets, mega pets, Pyromancer pieces, the rare prizes in boxes and the forge. Iron Mode adds +5%.", W - 60, "small", 4)
X.draw_note(y + 460)
back_btn("perks")
end
function C.draw_titles(S)
local cp = S.camp
local cur = R.title(cp)
head(S, "Titles", cur or "")
local y0 = TOPY() + 4
local n = #KC + 1
local sp = rows_sp(y0, n, 80)
for k = 1, n do
local by = y0 + (k - 1) * sp
panel(20, by, W - 40, sp - 6)
local t = title_of(cp, k)
if k <= #KC then
local e = KC[k]
local cnt, tier = kc_count(cp, e.key), kc_tier(cp, e.key)
local nxt = e.ms[tier + 1]
X.ltext(34, by + 4, e.name .. "  KC " .. cnt, "small", "bold")
X.ltext(34, by + sp - 30, (t or ("next title at " .. e.ms[1])) .. (tier > 0 and ("  +" .. 2 * tier .. "%") or "") .. (nxt and tier > 0 and ("  next " .. nxt) or ""), "small")
else
X.ltext(34, by + 4, "Iron Mode", "small", "bold")
X.ltext(34, by + sp - 30, R.iron() and "Ironman" or "turn Iron Mode on", "small")
end
X.button(W - 24 - 120, by + 4, 110, sp - 14, get("title") == k and "WORN" or "WEAR", function()
if get("title") == k then V.title = 0 else V.title = k end; save()
end, { font = "small", off = not t, active = get("title") == k, id = "TITLE" .. k })
end
back_btn("perks")
end
function C.draw_instance(S)
local cp = S.camp
head(S, "Instances", get("tok") .. " tokens")
local y = TOPY() + 4
panel(20, y, W - 40, 92)
X.ltext(34, y + 8, "Kills left: " .. get("ik"), "ui12", "bold")
X.wrapped(34, y + 40, "1 token = 10 boss kills, any time.", W - 220, "small", 2)
X.button(W - 24 - 150, y + 12, 140, 68, "USE TOKEN", function()
if get("tok") < 1 then X.set_note("No Instance tokens."); return end
add("tok", -1); add("ik", 10); X.set_note("Instance open: 10 kills."); X.save_now()
end, { font = "small", sub = "+10 kills", off = get("tok") < 1, id = "USETOKEN", dot = (get("tok") > 0 and get("ik") == 0) and "!" or nil })
local list = inst_bosses()
local sp = math.min(108, (H - 104 - (y + 100)) // #list)
for k, b in ipairs(list) do
local by = y + 100 + (k - 1) * sp
panel(20, by, W - 40, sp - 6)
local az = math.min(96, sp - 10)
smudge.draw_sprite(28, by + 2, 96, az, string.format("art/ms%02d.raw", b.m))
smudge.rect(27, by + 1, 98, az + 2, false, 2)
X.ltext(136, by + 8, b.name, "ui10", "bold")
X.ltext(136, by + 38, "Weak to " .. ({ "MELEE", "RANGED", "MAGIC" })[b.weak], "small")
X.ltext(136, by + 60, "KC " .. kc_count(cp, b.kc), "small", "bold")
X.button(210, by + 52, 90, 32, "DROPS", function() ADV.show_drops(inst_drops(cp, k)) end, { font = "small", id = "IDROPS" .. k, nohelp = true })
X.button(W - 24 - 120, by + 10, 110, sp - 26, "FIGHT", function() inst_fight(S, k) end, { font = "ui10", off = get("ik") < 1, id = "IFIGHT" .. k })
end
X.draw_note(y + 100 + #list * sp)
back_btn("perks")
end
local iconfirm = false
function C.draw_iron(S)
head(S, "Iron Mode", R.iron() and "ON" or "off")
local y = TOPY() + 6
panel(20, y, W - 40, 300)
X.ltext(34, y + 10, R.iron() and "You are an Ironman" or "Become an Ironman?", "ui12", "bold")
local hx, hy = W - 100, y + 14
smudge.rounded_rect(hx, hy, 56, 60, 14, true)
smudge.rect(hx + 10, hy + 26, 36, 8, true, 1, false)
smudge.rect(hx + 26, hy + 34, 4, 22, true, 1, false)
X.wrapped(34, y + 92, "Rules: you can't buy card packs with coins, buy from the Market, place GE bids or buy shop offers. Tickets, boxes and everything you make still work.", W - 70, "small", 5)
X.wrapped(34, y + 200, "Rewards: +10% xp in every skill, +5% luck and the Ironman title. After turning it off you have to wait 24 hours to turn it back on.", W - 70, "small", 4)
local wait = 86400 - (now() - get("ioff"))
local can_on = get("ioff") == 0 or wait <= 0
local lab
if R.iron() then lab = iconfirm and "SURE? TURN OFF" or "TURN OFF"
else lab = iconfirm and "SURE? TURN ON" or "TURN ON" end
X.button(24, y + 316, W - 48, 76, lab, function()
if (not R.iron()) and not can_on then X.set_note("Iron Mode can be turned on again in " .. K.mmss(wait) .. "."); return end
if not iconfirm then iconfirm = true; return end
iconfirm = false
if R.iron() then V.iron = 0; V.ioff = now(); if get("title") == #KC + 1 then V.title = 0 end; save(); X.set_note("Iron Mode is off.")
else V.iron = 1; save(); X.set_note("Iron Mode ON. Good luck, Ironman!") end
X.save_now()
end, { off = (not R.iron()) and not can_on, active = iconfirm, sub = ((not R.iron()) and not can_on) and ("again in " .. K.mmss(wait)) or nil, id = "IRONTOGGLE" })
X.draw_note(y + 404)
back_btn("perks")
end
function C.draw_megapets(S)
local cp = S.camp
head(S, "Mega pets", "")
local y0 = TOPY() + 2
X.ctext(W / 2, y0, "Gathering with a pet you own can rarely make it MEGA.", "small")
local sp = rows_sp(y0 + 26, 9, 66)
for si = 1, 16 do
local col, row = (si - 1) % 2, (si - 1) // 2
local bw = (W - 48 - 8) // 2
local bx, by = 24 + col * (bw + 8), y0 + 26 + row * sp
local has = I("pet" .. si) and ADV.owns(cp, "pet" .. si)
local mega = R.mega(si)
if mega then smudge.rounded_rect(bx, by, bw, sp - 6, 8, true) else smudge.rounded_rect(bx, by, bw, sp - 6, 8, false, has and 2 or 1) end
local nm = ITEMS[I("pet" .. si)][1]:gsub(" %(pet%)", "")
X.ltext(bx + 10, by + 4, X.fit(nm, bw - 20, "small", "bold"), "small", "bold", mega)
X.ltext(bx + 10, by + sp - 32, mega and "MEGA!" or (has and "owned" or "not found"), "small", nil, mega)
end
X.wrapped(30, y0 + 26 + 8 * sp + 4, "Mega pets are a giant version of your skilling pet (just for show, like RuneScape pets). Mythic boxes can also hold one.", W - 60, "small", 3)
back_btn("perks")
end
return R
end
scroll.lua
2783
return function(X)
local P = {}
local views = {}
local live = {}
local grab = nil
local eat = false
local last = X.millis()
local cur = nil
function P.frame() live = {} end
function P.begin(id, x, y, w, h, total)
local v = views[id]
if not v then v = { off = 0, v = 0 }; views[id] = v end
v.max = math.max(0, total - h)
if v.off > v.max then v.off = v.max end
if v.off < 0 then v.off = 0 end
cur = { id = id, x = x, y = y, w = w, h = h, total = total }
live[#live + 1] = cur
X.clip(x, y, w, h)
return math.floor(v.off + 0.5)
end
function P.finish()
X.clip()
local c = cur
cur = nil
if not c or c.total <= c.h then return end
local v = views[c.id]
local bx = c.x + c.w + 3
local th = math.max(40, c.h * c.h // c.total)
local ty = c.y + math.floor((c.h - th) * (v.off / math.max(1, v.max)) + 0.5)
smudge.rect(bx + 3, c.y, 1, c.h, true)
smudge.rounded_rect(bx, ty, 7, th, 3, true)
end
function P.scroll_to(id, off) local v = views[id]; if v then v.off = off; v.v = 0 end end
local function inside(w, x, y) return x >= w.x and x < w.x + w.w and y >= w.y and y < w.y + w.h end
function P.touch(ev, x, y, vx, vy)
if ev == "down" then
eat = false
grab = { x0 = x, y0 = y }
for i = #live, 1, -1 do
local w = live[i]
if inside(w, x, y) then
local v = views[w.id]
if math.abs(v.v) > 0.05 then eat = true end
v.v = 0
grab.id, grab.off0 = w.id, v.off
break
end
end
return eat
end
if not grab then return false end
local dx, dy = x - grab.x0, y - grab.y0
if not grab.dir and (math.abs(dx) > 8 or math.abs(dy) > 8) then
grab.dir = (math.abs(dy) >= math.abs(dx)) and "v" or "h"
end
if ev == "move" then
if grab.dir == "v" and grab.id then
local v = views[grab.id]
local old = v.off
v.off = math.max(0, math.min(v.max, grab.off0 - dy))
return v.off ~= old
end
return false
end
if ev == "release" then
local changed = false
if grab.dir == "v" and grab.id then
changed = true
local v = views[grab.id]
v.off = math.max(0, math.min(v.max, grab.off0 - dy))
local sp = -(vy or 0)
if math.abs(sp) < 0.1 then sp = 0 end
if X.smooth() then v.v = sp; last = X.millis()
else v.off = math.max(0, math.min(v.max, v.off + sp * 250)) end
elseif grab.dir == "h" and math.abs(dx) > 70 and math.abs(dx) > 2 * math.abs(dy) then
if dx < 0 then X.press("NEXT") else X.press("PREV") end
changed = true
end
grab = nil
return changed
end
return false
end
function P.eat_tap() local e = eat; eat = false; return e end
function P.update()
local now = X.millis()
local dt = math.min(50, now - last)
last = now
local moving = false
for _, v in pairs(views) do
if v.v ~= 0 then
v.off = v.off + v.v * dt
v.v = v.v * (0.94 ^ (dt / 16))
if v.off < 0 then v.off = 0; v.v = 0 elseif v.max and v.off > v.max then v.off = v.max; v.v = 0 end
if math.abs(v.v) < 0.02 then v.v = 0 end
moving = true
end
end
return moving
end
return P
end
wiki.lua
12459
return function(X, K, C, ADV)
local WK = {}
local W, H = X.W, X.H
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local ST = { open = false, q = "", mode = "kb", page = 0, sel = nil, ipage = 0 }
local function I(id) return IDX[id] end
local function S0() return X.state and X.state() end
local function all_tables(cp)
local T = {}
local CB, G = ADV.CB, ADV.G
local function add(prefix, fn)
local ok, t, rows, sub = pcall(fn)
if ok and t then T[#T + 1] = { prefix .. t, rows, function() ADV.show_drops(fn()) end } end
end
for k = 1, #CB.MON do add("Slayer: ", function() return CB.drops_slayer(k) end) end
for k = 1, #ADV.LAIRS do add("Boss lair: ", function() return ADV.lair_drops(cp, k) end) end
for bi = 1, #G.WBOSS do add("World boss: ", function() return CB.drops_wb(cp, bi) end) end
add("Raid: ", function() return CB.drops_raid() end)
add("Minigame: ", function() return CB.drops_todt() end)
add("", function() return ADV.wild_drops() end)
for k = 1, #ADV.R.inst_list() do add("Instance: ", function() return ADV.R.inst_drops(cp, k) end) end
for k = 1, #ADV.WO.REGIONS do add("World map: ", function() return ADV.WO.region_drops(k) end) end
return T
end
local function row_matches(rn, name)
if rn == name then return true end
if rn:sub(1, 5) == "PET: " and (rn:sub(6) .. " (pet)") == name then return true end
if rn:sub(-6) == " piece" and name:sub(1, #rn - 6) == rn:sub(1, -7) then return true end
return false
end
local function mats(r)
local p = {}
for _, nd in ipairs(r[4]) do p[#p + 1] = (nd[2] > 1 and (nd[2] .. " ") or "") .. ITEMS[nd[1]][1] end
if r[6] then p[#p + 1] = "a " .. ITEMS[r[6]][1]:lower() .. " (tool)" end
return table.concat(p, " + ")
end
local SPECIAL = {
slhelm = "Slayer shop (Slayer master): 200 Slayer points",
torso = "Barbarian Assault (minigame): 400 honour points",
ang1 = "Fishing Trawler (minigame): rare reward after a good trip", ang2 = "Fishing Trawler (minigame): rare reward after a good trip",
ang3 = "Fishing Trawler (minigame): rare reward after a good trip", ang4 = "Fishing Trawler (minigame): rare reward after a good trip",
frog = "Random events (Mystery box)",
nest = "Woodcutting: any tree, about 1/100 per log (2x with the Menagerie or in Nest week)",
usapph = "Mining: any rock, about 1/83 per ore; 50% of gems are sapphires",
uemer = "Mining: any rock, about 1/83 per ore; 30% of gems are emeralds",
uruby = "Mining: any rock, about 1/83 per ore; 15% of gems are rubies",
udia = "Mining: any rock, about 1/83 per ore; 5% of gems are diamonds",
maxcape = "Reach level 99 in every skill",
qcape = "Complete every quest",
}
local function sources(cp, i)
local get, use = {}, {}
local name = ITEMS[i][1]
local id
for k, v in pairs(IDX) do if v == i then id = k end end
for si = 1, 4 do
for _, g in ipairs(K.GATHER[si]) do
if g[4] == i then
local t = string.format("%s Lv %d: %s", SK[si].name, g[2], g[1])
if g[3] and g[3] > 0 then t = t .. " (" .. K.GEAR[g[3]][1] .. ")" end
if g[8] then t = t .. " (uses " .. ITEMS[g[8]][1] .. ")" end
if g[9] then t = t .. ", " .. g[9] .. " quest points" end
get[#get + 1] = t
end
if g[8] == i then use[#use + 1] = string.format("Needed at %s (%s Lv %d), kept forever", g[1], SK[si].name, g[2]) end
end
end
for _, cr in ipairs(K.CROPS) do
if cr[8] == i then get[#get + 1] = string.format("Farming Lv %d: plant %s seeds (%dc, %d min)", cr[2], cr[1], cr[7], cr[3]) end
end
for si = 1, #SK do
for _, r in ipairs(K.REC[si] or {}) do
if r[5].id == i then get[#get + 1] = string.format("%s Lv %d: %s", SK[si].name, r[2], mats(r)) end
for _, nd in ipairs(r[4]) do
if nd[1] == i then use[#use + 1] = string.format("%s Lv %d: %s", SK[si].name, r[2], r[1]) end
end
if r[6] == i then use[#use + 1] = string.format("Tool for %s: %s", SK[si].name, r[1]) end
end
end
for _, st in ipairs(K.STORES) do
for _, sid in ipairs(st[3]) do if I(sid) == i then get[#get + 1] = string.format("SHOP > %s: %d coins", st[2], ITEMS[i][2]) end end
end
for _, s2 in ipairs(K.SHOP_ITEMS) do if s2 == i then get[#get + 1] = "SHOP > DEALS: sometimes in the daily deals" end end
local groups, order, cat_n = {}, {}, {}
for _, t in ipairs(all_tables(cp)) do
local cat, mon = t[1]:match("^(.-): (.*)$")
if not cat then cat, mon = t[1], nil end
cat_n[cat] = (cat_n[cat] or 0) + 1
for _, r in ipairs(t[2]) do
if row_matches(r[1], name) then
local key = cat .. "|" .. ADV.chance_text(r[3]) .. "|" .. r[2]
if not groups[key] then groups[key] = { cat = cat, ch = ADV.chance_text(r[3]), amt = r[2], mons = {} }; order[#order + 1] = key end
if mon then table.insert(groups[key].mons, mon) end
end
end
end
for _, key in ipairs(order) do
local g = groups[key]
local who
if #g.mons == 0 then who = g.cat
elseif #g.mons == cat_n[g.cat] and #g.mons > 2 then who = g.cat .. ": every monster"
else who = g.cat .. ": " .. table.concat(g.mons, ", ") end
get[#get + 1] = string.format("%s: %s%s", who, g.ch, (g.amt ~= "1") and (" (" .. g.amt .. ")") or "")
end
for _, q in ipairs(ADV.QUESTS or {}) do
if q[5] and q[5].item and I(q[5].item) == i then get[#get + 1] = "Quest reward: " .. q[1] end
end
for t, list in ipairs(ADV.CLUE_U or {}) do
for _, cid in ipairs(list) do if I(cid) == i then get[#get + 1] = ({ "Easy", "Medium", "Hard" })[t] .. " clue scroll casket (rare)" end end
end
for _, s2 in ipairs(ADV.G.STAR_SHOP or {}) do
local nm = s2[1]:gsub(" %(.*%)", "")
if nm == name or (id and id:match("^pr%d") and s2[1]:find("^Prospector")) then get[#get + 1] = string.format("Stardust shop (shooting star): %d stardust", s2[2]) end
end
if id and id:match("^pet%d+$") then
local si = tonumber(id:sub(4))
if SK[si] then get[#get + 1] = string.format("Pet: rare while training %s, %s per action", SK[si].name, ADV.chance_text(ADV.p(3000, true))) end
end
if id and id:match("^cape%d+$") then
local si = tonumber(id:sub(5))
if SK[si] then get[#get + 1] = "Reach level 99 in " .. SK[si].name end
end
if id and SPECIAL[id] then get[#get + 1] = SPECIAL[id] end
if #get == 0 then
for _, ln in ipairs(K.item_info(i)) do if ln:find("^Get it from") then get[#get + 1] = ln:gsub("^Get it from: ", "") end end
end
return get, use
end
WK.sources = sources
local function results(cp)
local q = ST.q:lower()
local out = {}
if q == "" then return out end
for i = 1, #ITEMS do
if ITEMS[i][1]:lower():find(q, 1, true) then out[#out + 1] = { kind = "item", i = i, name = ITEMS[i][1] } end
end
for _, t in ipairs(all_tables(cp)) do
if t[1]:lower():find(q, 1, true) then out[#out + 1] = { kind = "mon", name = t[1], open = t[3] } end
end
return out
end
WK.results = function(cp) return results(cp) end
function C.wiki_open() ST.open = true; ST.mode = "kb"; ST.page = 0; ST.sel = nil end
function C.wiki_is_open() return ST.open end
function C.wiki_close() ST.open = false end
function C.wiki_back()
if ST.mode == "item" then ST.mode = "list"; ST.sel = nil
elseif ST.mode == "kb" and ST.q ~= "" then ST.mode = "list"
else ST.open = false end
end
WK.ST = ST
local function panel_box()
local x0, y0 = 12, X.bar_h() + 8
local w, h = W - 24, H - 108 - y0
X.reg("WIKIBLOCK", 0, 0, W, H, function() end)
if not X.saver() then smudge.rounded_rect(x0 + 6, y0 + 6, w, h, 14, true) end
smudge.rounded_rect(x0, y0, w, h, 14, true, 1, false)
smudge.rounded_rect(x0, y0, w, h, 14, false, 3)
return x0, y0, w, h
end
local function search_field(x0, y0, w)
X.ltext(x0 + 16, y0 + 12, "Search", "ui12", "bold")
X.button(x0 + w - 100, y0 + 8, 88, 36, "CLOSE", function() ST.open = false end, { font = "small", id = "WIKICLOSE", nohelp = true })
X.button(x0 + 12, y0 + 50, w - 24, 46, "", function() ST.mode = "kb" end, { id = "WIKIFIELD", nohelp = true })
X.ltext(x0 + 26, y0 + 62, (ST.q == "" and "item, monster or boss..." or ST.q) .. (ST.mode == "kb" and "_" or ""), "ui10", ST.q ~= "" and "bold" or nil)
end
local function draw_kb(S, x0, y0, w, h)
local n = #results(S.camp)
X.ctext(W / 2, y0 + 104, ST.q == "" and "type a name or part of it" or (n .. " result" .. (n == 1 and "" or "s")), "small")
X.keyboard({ id = "WKEY", bottom = y0 + h - 10,
key = function(ch) if #ST.q < 18 then ST.q = ST.q .. ch:lower(); ST.page = 0 end end,
actions = { { "SPACE", function() if #ST.q < 18 and ST.q ~= "" then ST.q = ST.q .. " " end end, false, "WKEYSPACE" },
{ "DELETE", function() ST.q = ST.q:sub(1, -2); ST.page = 0 end, ST.q == "", "WKEYDEL" },
{ "CLEAR", function() ST.q = ""; ST.page = 0 end, ST.q == "", "WKEYCLR" },
{ "SHOW", function() ST.mode = "list"; ST.page = 0 end, n == 0, "WIKIGO" } } })
end
local function draw_list(S, x0, y0, w, h)
local list = results(S.camp)
local ly = y0 + 108
local rh = 54
local per = math.max(1, (y0 + h - 70 - ly) // rh)
local pages = math.max(1, math.ceil(#list / per))
if ST.page >= pages then ST.page = pages - 1 end
if #list == 0 then X.ctext(W / 2, ly + 20, "Nothing found. Tap the search bar to change it.", "small") end
local sc = X.scrolling and X.scrolling()
local rw = w - 24 - (sc and 14 or 0)
local function wrow(n, k, by)
local e = list[n]
if e then
X.button(x0 + 12, by, rw, rh - 6, "", function()
if e.kind == "item" then ST.sel = e.i; ST.mode = "item"; ST.ipage = 0 else e.open() end
end, { id = "WRES" .. k, nohelp = true })
if e.kind == "item" then
smudge.draw_sprite(x0 + 22, by + 11, 24, 24, "art/" .. ITEMS[e.i][3] .. ".raw")
X.ltext(x0 + 56, by + 4, X.fit(e.name, w - 90, "ui10", "bold"), "ui10", "bold")
local have = S.camp.inv[e.i] + K.inv_n(e.i)
X.ltext(x0 + 56, by + 26, "item" .. (have > 0 and ("   you have " .. have) or ""), "small")
else
X.ltext(x0 + 24, by + 4, X.fit(e.name, w - 60, "ui10", "bold"), "ui10", "bold")
X.ltext(x0 + 24, by + 26, "drop table", "small")
end
end
end
local ny = y0 + h - 62
local tw3 = (w - 24 - 12) // 3
if not X.list("wiki" .. ST.q, ly, ny + 50 - ly, #list, rh, function(n, by) wrow(n, n, by) end, x0 + 8, rw + 8) then
for k = 1, per do wrow(ST.page * per + k, k, ly + (k - 1) * rh) end
X.button(x0 + 12, ny, tw3, 50, "PREV", function() if ST.page > 0 then ST.page = ST.page - 1 end end, { font = "ui10", off = ST.page == 0, id = "WPREV", nohelp = true })
X.ctext(x0 + 18 + tw3 + tw3 // 2, ny + 14, string.format("%d / %d", ST.page + 1, pages), "ui10", "bold")
X.button(x0 + 24 + 2 * tw3, ny, tw3, 50, "NEXT", function() if ST.page < pages - 1 then ST.page = ST.page + 1 end end, { font = "ui10", off = ST.page >= pages - 1, id = "WNEXT", nohelp = true })
end
end
local function draw_item(S, x0, y0, w, h)
local i = ST.sel
local cp = S.camp
local iy = y0 + 104
smudge.draw_sprite(x0 + 18, iy + 4, 24, 24, "art/" .. ITEMS[i][3] .. ".raw")
X.ltext(x0 + 52, iy, X.fit(ITEMS[i][1], w - 70, "ui12", "bold"), "ui12", "bold")
X.ltext(x0 + 52, iy + 30, string.format("Value %d coins   You have %d", ITEMS[i][2], cp.inv[i] + K.inv_n(i)), "small")
local get, use = sources(cp, i)
local lines = {}
local function add(t, bold) lines[#lines + 1] = { t, bold } end
for k, ln in ipairs(K.item_info(i)) do if not ln:find("^Get it from") then add(ln) end end
add("HOW TO GET IT", true)
for _, t in ipairs(get) do add("- " .. t) end
if #use > 0 then add("USED FOR", true); for _, t in ipairs(use) do add("- " .. t) end end
local wrapped = {}
for _, l in ipairs(lines) do
local res = smudge.wrapped_text(l[1], w - 36, "small", l[2] and "bold" or "regular", 6)
for _, t in ipairs(res.lines) do wrapped[#wrapped + 1] = { t, l[2] } end
end
local ty = iy + 60
local lhh = X.lh("small") + 4
local per = math.max(1, (y0 + h - 70 - ty) // lhh)
local pages = math.max(1, math.ceil(#wrapped / per))
if ST.ipage >= pages then ST.ipage = pages - 1 end
for k = 1, per do
local l = wrapped[ST.ipage * per + k]
if l then X.ltext(x0 + 18, ty + (k - 1) * lhh, l[1], "small", l[2] and "bold" or nil) end
end
local ny = y0 + h - 62
local tw3 = (w - 24 - 12) // 3
X.button(x0 + 12, ny, tw3, 50, "RESULTS", function() ST.mode = "list"; ST.sel = nil end, { font = "small", id = "WBACK", nohelp = true })
X.button(x0 + 18 + tw3, ny, tw3, 50, "UP", function() if ST.ipage > 0 then ST.ipage = ST.ipage - 1 end end, { font = "ui10", off = ST.ipage == 0, id = "WUP", nohelp = true })
X.button(x0 + 24 + 2 * tw3, ny, tw3, 50, "MORE", function() if ST.ipage < pages - 1 then ST.ipage = ST.ipage + 1 end end,
{ font = "ui10", sub = (ST.ipage + 1) .. "/" .. pages, off = ST.ipage >= pages - 1, id = "WMORE", nohelp = true })
end
function C.draw_wiki(S)
if not ST.open or ADV.dt then return end
local x0, y0, w, h = panel_box()
search_field(x0, y0, w)
if ST.mode == "kb" then draw_kb(S, x0, y0, w, h)
elseif ST.mode == "item" and ST.sel then draw_item(S, x0, y0, w, h)
else draw_list(S, x0, y0, w, h) end
end
return WK
end
world.lua
24745
return function(X, K, C, ADV, G)
local WO = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function I(id) return IDX[id] end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function hash01(a, b) local v = math.sin(a * 12.9898 + (b % 100003) * 78.233) * 43758.5453; return v - math.floor(v) end
local ELEMS = { "FIRE", "WATER", "EARTH", "STORM", "SHADOW", "LIGHT", "NATURE", "DREAM" }
local V = {}
local function load()
V = {}
for part in (smudge.load("world", "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then V[k] = tonumber(v) end
end
end
local function save()
local p = {}
for k, v in pairs(V) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
table.sort(p)
smudge.save("world", table.concat(p, ";"))
end
load()
local function get(k) return V[k] or 0 end
WO.get, WO.load = get, load
local function hour()
local t = now()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.hour then return d.hour end
return (t // 3600) % 24
end
local function day_n()
local t = now()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.yday then return d.year * 400 + d.yday end
return t // 86400
end
local PHASES = {
{ "Morning", {}, {}, {}, "Crops grow 25% faster" },
{ "Day", { [6] = 1.15, [1] = 1.15 }, {}, {}, "Light & Fire cards +15%" },
{ "Evening", { [7] = 1.15, [2] = 1.15 }, {}, {}, "Nature & Water cards +15%" },
{ "Night", { [5] = 1.20, [8] = 1.20 }, {}, {}, "Shadow & Dream cards +20%" },
}
local WEATHER = {
{ "Clear", {}, {}, {}, "No weather effects" },
{ "Rain", { [2] = 1.10 }, {}, {}, "Crops grow 25% faster, Water cards +10%" },
{ "Storm", { [4] = 1.20 }, {}, {}, "Storm cards +20%" },
{ "Fog", { [5] = 1.10 }, {}, {}, "Shadow cards +10%" },
{ "Snow", { [2] = 1.10 }, {}, {}, "Water cards +10%" },
}
function WO.phase()
local h = hour()
if h >= 6 and h < 12 then return 1 elseif h >= 12 and h < 18 then return 2 elseif h >= 18 and h < 22 then return 3 end
return 4
end
function WO.weather()
local r = hash01(day_n(), 4242)
if r < 0.40 then return 1 elseif r < 0.62 then return 2 elseif r < 0.77 then return 3 elseif r < 0.90 then return 4 end
return 5
end
WO.PHASES, WO.WEATHER = PHASES, WEATHER
local WEEKS = {
{ "Lucky week", "+25% luck on every rare roll" },
{ "Slayer week", "double Slayer points from tasks" },
{ "Wild markets", "market prices swing twice as hard" },
{ "Nest week", "bird nests, gems and clue bottles twice as common" },
{ "Shiny week", "shiny chance in packs doubled (3% -> 6%)" },
{ "Harvest week", "crops grow twice as fast" },
{ "Fortune week", "the travelling merchant pays +25% more often" },
{ "Element week", "%s cards +25%% in card battles" },
}
local function week_n() return (now() + 3 * 86400) // (7 * 86400) end
function WO.week()
local w = week_n()
local k = w % #WEEKS + 1
local si = fl(hash01(w, 77) * 20) + 1
if SK[si] and (SK[si].slayer or SK[si].combat) then si = 1 + (si % 13) end
local el = fl(hash01(w, 91) * 8) + 1
local name, txt = WEEKS[k][1], WEEKS[k][2]
if k == 8 then name = ELEMS[el]:sub(1, 1) .. ELEMS[el]:sub(2):lower() .. " week"; txt = string.format(txt, ELEMS[el]:sub(1, 1) .. ELEMS[el]:sub(2):lower()) end
return k, name, txt, si, el
end
local function week_left() return (week_n() + 1) * 7 * 86400 - 3 * 86400 - now() end
function C.world_mult(e)
local m = (PHASES[WO.phase()][2][e] or 1) * (WEATHER[WO.weather()][2][e] or 1)
local k, _, _, _, el = WO.week()
if k == 8 and el == e then m = m * 1.25 end
return m
end
local xp0 = G.xp_bonus
G.xp_bonus = function(cp, si)
local m = xp0(cp, si)
if si then
m = m + (PHASES[WO.phase()][3][si] or 0) + (WEATHER[WO.weather()][3][si] or 0)
local k, _, _, wsi = WO.week()
if k == 7 and wsi == si then m = m + 1.0 end
if get("sec" .. (WO.REGION_SKILL[si] or 0)) == 1 then m = m + 0.05 end
end
return m
end
local og = G.on_gather
G.on_gather = function(S, si, gi, item, n)
local n2, xm, note = og(S, si, gi, item, n)
local ch = (PHASES[WO.phase()][4][si] or 0) + (WEATHER[WO.weather()][4][si] or 0)
if ch > 0 and X.rnd(1, 100) <= ch then n2 = n2 + 1; note = note .. "  (" .. (WEATHER[WO.weather()][4][si] and WEATHER[WO.weather()][1] or PHASES[WO.phase()][1]) .. " +1)" end
if WO.week() == 6 and X.rnd(1, 100) <= 25 then n2 = n2 + 1; note = note .. "  (week +1)" end
return n2, xm, note
end
local luck0 = G.R.luck
G.R.luck = function() return luck0() + ((WO.week() == 1) and 0.25 or 0) end
local rare0 = ADV.rare_mult
ADV.rare_mult = function(cp, si) return rare0(cp, si) * ((WO.week() == 4) and 2 or 1) end
local grow0 = ADV.grow_mult
ADV.grow_mult = function(cp)
local m = grow0(cp)
if WO.phase() == 1 then m = m * 0.75 end
if WO.weather() == 2 then m = m * 0.75 end
if WO.week() == 6 then m = m * 0.5 end
return m
end
local task0 = ADV.on_task_done
ADV.on_task_done = function(S, need)
local before = S.camp.x.spts
local t = task0(S, need)
if WO.week() == 2 then local extra = S.camp.x.spts - before; S.camp.x.spts = S.camp.x.spts + extra; t = t .. "  (Slayer week: x2)" end
return t
end
function C.mkt_swing() return (WO.week() == 3) and 2 or 1 end
function C.shiny_pct() return (WO.week() == 5) and 6 or 3 end
local BSLOT = 3 * 86400
local function bounty()
local slot = now() // BSLOT
local r = hash01(slot, 313)
local c = fl(hash01(slot, 17) * 32) + 1
local tier = (c - 1) // 8
local need = 1 + fl(hash01(slot, 29) * 3)
local shiny = r < 0.12
local reward = (tier >= 3 or shiny) and 4 or ((tier >= 2 or need >= 3) and 3 or 2)
return { slot = slot, c = c, need = need, shiny = shiny, box = reward, coins = 150 * (tier + need), ends = (slot + 1) * BSLOT }
end
WO.bounty = bounty
function WO.times(t0, t1, add)
for w = (t0 + 3 * 86400) // (7 * 86400), (t1 + 3 * 86400) // (7 * 86400) + 1 do add(w * 7 * 86400 - 3 * 86400) end
for s = t0 // BSLOT, t1 // BSLOT + 1 do add(s * BSLOT) end
end
local function bounty_state(S)
local b = bounty()
local done = get("bdone_slot") == b.slot
local ok = S.lvl[b.c] >= b.need and S.spare[b.c] >= 1 and (not b.shiny or S.shiny[b.c] == 1)
return b, done, ok
end
local function bounty_deliver(S)
local b, done, ok = bounty_state(S)
if done then X.set_note("Already delivered. A new bounty comes soon."); return end
if not ok then X.set_note("You need the card at that level and a spare copy to hand over."); return end
S.spare[b.c] = S.spare[b.c] - 1
V.bdone_slot = b.slot; V.bdone = get("bdone") + 1; save()
X.add_coins(b.coins); G.R.give_box(b.box)
local t = string.format("Bounty done! +%d coins and a %s.", b.coins, G.R.BOX[b.box])
if get("bdone") % 10 == 0 then G.R.give_box(4); t = t .. "  10 bounties: a MYTHIC box!" end
X.set_note(t); X.save_now()
end
function WO.bounty_ready(S) local _, done, ok = bounty_state(S); return (not done and ok) and 1 or 0 end
local REGIONS = {
{ "Greenwood", 0, "Old forest full of birdsong.", { "log", "oak", "potato", "fur" }, 1, "Stumpling", 1 },
{ "Copper Hills", 60, "Rolling hills riddled with mines.", { "copper", "iron", "coal", "ibar" }, 2, "Gob Maw", 2 },
{ "Saltmarsh", 150, "Mud flats, reeds and fishing huts.", { "shrimp", "trout", "salmon", "lob" }, 3, "Marsh Lurker", 3 },
{ "Wildlands", 300, "Lawless plains. Bandits everywhere.", { "hide", "tusk", "wolf", "rchaos" }, 12, "Dread Hare", 1 },
{ "Frostpeak", 600, "Frozen peaks above the clouds.", { "mith", "adam", "yew", "shark" }, 11, "Snow Sprite", 2 },
{ "The Void", 1000, "Where the world runs out.", { "rstone", "dragon", "celes", "rsoul" }, 20, "Hollow Skull", 3 },
{ "Deepwood Hollow", 1200, "Ancient trees, older than the kingdom.", { "elder", "bear", "wolf", "lotus" }, 4, "Moss Troll", 2, 45, "tlhide" },
{ "Serpent Isle", 1400, "A lonely island. Something circles it.", { "manta", "levi", "shark", "lob" }, 14, "Sea Serpent", 3, 46, "sscale" },
{ "Wyrm Crag", 1600, "Cliffs where young wyrms nest.", { "drake", "dragon", "dbar", "adam" }, 5, "Young Wyrm", 1, 47, "wscale" },
{ "Rift's Edge", 1800, "The void tears the sky open here.", { "celes", "rsoul", "anc", "cbar" }, 8, "Rift Wraith", 2, 48, "rcryst" },
}
for _, r in ipairs(REGIONS) do for k, id in ipairs(r[4]) do r[4][k] = I(id) end; if r[9] then r[9] = I(r[9]) end end
local NR = #REGIONS
local function mart(k) return REGIONS[k][8] or (30 + k) end
WO.REGIONS = REGIONS
WO.REGION_SKILL = {}
for k, r in ipairs(REGIONS) do WO.REGION_SKILL[r[5]] = k end
local sel, enc = 1, nil
local function unlocked(cp, k) return K.total_level(cp) >= REGIONS[k][2] end
local function secrets() local n = 0; for k = 1, NR do if get("sec" .. k) == 1 then n = n + 1 end end return n end
local function region_drops(k)
local r = REGIONS[k]
local rows = { { "Coins", (40 * k) .. "-" .. (60 * k), 1 }, { G.R.BOX[math.min(3, 1 + k // 3)], "1", ADV.p(8, true) } }
if r[9] then table.insert(rows, 2, { ITEMS[r[9]][1], "1", ADV.p(8, true) }) end
ADV.herb_rows(rows, 30 + 40 * k)
return r[6], rows, r[1] .. " monster"
end
WO.region_drops = region_drops
local function region_fight(S, k)
local r = REGIONS[k]
local hp, mh = 30 + 40 * k, 3 + 3 * k
ADV.CB.start(S, {
title = r[1] .. " - " .. r[6], name = r[6], card = 1, art = string.format("art/m%02d.raw", mart(k)), hp = hp, maxhp = hp, maxhit = mh,
weak = r[7], back = "worldmap", again = function(S2) region_fight(S2, k) end,
drops = function() return region_drops(k) end,
on_end = function(S2, win)
if not win then return "The " .. r[6] .. " drove you off. Heal up and try again." end
enc = nil
V["rk" .. k] = get("rk" .. k) + 1; save()
local coins = 40 * k + X.rnd(0, 20 * k)
X.add_coins(coins)
local t = string.format("%s defeated! +%d coins", r[6], coins)
if G.lucky(8) then G.R.give_box(math.min(3, 1 + k // 3)); t = t .. "  " .. G.R.BOX[math.min(3, 1 + k // 3)] .. "!" end
if r[9] and X.rnd(1, 8) == 1 then
K.add_item(S2.camp, r[9], 1)
t = t .. "  Rare drop: " .. ITEMS[r[9]][1] .. "!"
V["sp" .. k] = 1
local all = true
for k2 = 1, NR do if REGIONS[k2][9] and get("sp" .. k2) ~= 1 then all = false end end
if all and get("spall") ~= 1 then V.spall = 1; G.R.give_box(4); t = t .. "  All four special drops: a MYTHIC box!" end
save()
end
return t
end,
})
end
local function explore(S, k)
local cp = S.camp
local r = REGIONS[k]
if not unlocked(cp, k) then X.set_note("Needs total level " .. r[2] .. "."); return end
if now() < (WO.ex_next or 0) then X.set_note(string.format("You're still travelling... (%d s)", WO.ex_next - now())); return end
WO.ex_next = now() + 20
local roll = X.rnd(1, 100)
if get("sec" .. k) == 0 and X.rnd(1, 100) <= 3 then
V["sec" .. k] = 1; save()
local t = string.format("You found the SECRET of %s! +200 coins.", r[1]); X.add_coins(200)
if secrets() == NR then G.R.give_box(4); t = t .. "  All " .. NR .. " secrets: a MYTHIC box!" end
ADV.notify("Secret found in " .. r[1] .. "!", "worldmap")
X.set_note(t)
elseif roll <= 55 then
local i = r[4][X.rnd(1, #r[4])]
local n = X.rnd(2, 3 + k)
K.add_item(cp, i, n)
X.set_note(string.format("You explore %s and find %d %s.", r[1], n, ITEMS[i][1]) .. K.give_xp(S, r[5], 6 * k + 4))
elseif roll <= 80 then
enc = k
X.set_note("A " .. r[6] .. " blocks your path!")
else
local c = 30 * k + X.rnd(0, 20 * k)
X.add_coins(c); X.add_dust(2 * k)
X.set_note(string.format("You find a hidden stash: %d coins and %d dust.", c, 2 * k))
end
X.save_now()
end
function WO.check(S)
local w = week_n()
if get("wk_seen") ~= w then V.wk_seen = w; save(); local _, name, txt = WO.week(); ADV.notify("This week: " .. name .. " - " .. txt, "worldinfo") end
local b = bounty()
if get("b_seen") ~= b.slot then V.b_seen = b.slot; save(); ADV.notify("New collector bounty: " .. X.cname(b.c) .. "!", "bounty") end
end
function C.world_line()
local _, name = WO.week()
return string.format("%s - %s - %s", PHASES[WO.phase()][1], WEATHER[WO.weather()][1], name)
end
WO.SCR = { "worldinfo", "bounty", "worldmap" }
WO.PARENT = { worldinfo = "title", bounty = "camp", worldmap = "camp" }
local function sun_moon(x, y, ph)
if ph == 4 then smudge.circle(x, y, 13, true); smudge.circle(x + 6, y - 4, 11, true, 1, false)
elseif ph == 3 or ph == 1 then smudge.circle(x, y + 4, 11, false, 2); smudge.rect(x - 16, y + 6, 32, 10, true, 1, false); smudge.line(x - 16, y + 6, x + 16, y + 6, 2)
else smudge.circle(x, y, 9, true); for a = 0, 7 do local an = a * math.pi / 4; smudge.line(x + fl(math.cos(an) * 12), y + fl(math.sin(an) * 12), x + fl(math.cos(an) * 16), y + fl(math.sin(an) * 16), 2) end end
end
function C.draw_worldinfo(S)
head(S, "World", "")
local y = TOPY() + 6
local ph, we = WO.phase(), WO.weather()
panel(20, y, W - 40, 128)
sun_moon(54, y + 40, ph)
X.ltext(86, y + 10, PHASES[ph][1], "ui12", "bold")
X.wrapped(86, y + 44, PHASES[ph][5], W - 120, "small", 3)
local wy = y + 140
panel(20, wy, W - 40, 110)
X.ltext(36, wy + 10, "Weather: " .. WEATHER[we][1], "ui12", "bold")
X.wrapped(36, wy + 44, WEATHER[we][5] .. ". Changes every day.", W - 70, "small", 3)
local ky = wy + 122
local _, name, txt = WO.week()
panel(20, ky, W - 40, 128)
X.ltext(36, ky + 10, "This week: " .. name, "ui12", "bold")
X.wrapped(36, ky + 44, txt .. ".", W - 70, "small", 2)
local left = week_left()
X.ltext(36, ky + 94, string.format("Next week in %dd %dh", left // 86400, (left % 86400) // 3600), "small", "bold")
X.wrapped(30, ky + 140, "Morning 6-12, day 12-18, evening 18-22, night 22-6 (your reader's clock).", W - 60, "small", 2)
back_btn("title")
end
function C.draw_bounty(S)
local b, done, ok = bounty_state(S)
head(S, "Collector bounty", get("bdone") .. " done")
local y = TOPY() + 6
panel(20, y, W - 40, 250)
X.ltext(34, y + 10, "The Collector wants:", "ui10", "bold")
X.thumb(34, y + 40, b.c, { show = true })
X.ltext(156, y + 44, X.cname(b.c), "ui12", "bold")
X.ltext(156, y + 78, string.format("%s card, level %d+", X.tier_name(b.c), b.need), "small", "bold")
if b.shiny then X.ltext(156, y + 100, "It must be SHINY!", "small", "bold") end
X.ltext(156, y + 124, string.format("You: %s, level %d, %d spare%s", X.owned(b.c) and "owned" or "not owned", S.lvl[b.c], S.spare[b.c], S.spare[b.c] == 1 and "" or "s"), "small")
local left = b.ends - now()
X.ltext(34, y + 170, string.format("Reward: %d coins + %s", b.coins, G.R.BOX[b.box]), "ui10", "bold")
X.ltext(34, y + 200, string.format("Ends in %dd %dh   (every 10 bounties: Mythic box)", left // 86400, (left % 86400) // 3600), "small")
X.button(24, y + 264, W - 48, 74, done and "DELIVERED" or "HAND OVER A COPY", function() bounty_deliver(S) end,
{ off = done or not ok, sub = done and "new bounty soon" or "gives 1 spare copy", id = "BDELIVER", dot = (not done and ok) and "!" or nil })
X.wrapped(30, y + 352, "Level the card by merging copies in the album. Shiny copies come from packs. You keep the card, you only hand over one spare copy.", W - 60, "small", 4)
X.draw_note(y + 440)
back_btn("camp")
end
local SPOTS = { { 0.24, 0.59 }, { 0.47, 0.50 }, { 0.26, 0.28 }, { 0.69, 0.73 }, { 0.81, 0.39 }, { 0.54, 0.22 },
{ 0.35, 0.78 }, { 0.78, 0.84 }, { 0.86, 0.57 }, { 0.64, 0.08 } }
local PAN = { cu = 0.3, cv = 0.55, tu = 0.3, tv = 0.55 }
local MAPZ = 1.5
function C.map_touch(ev, x, y)
if X.scr() ~= "worldmap" or not PAN.box or type(x) ~= "number" then return false end
local b = PAN.box
if ev == "down" then
if smudge.in_rect(x, y, b[1], b[2], b[3], b[4]) then
PAN.d = { x0 = x, y0 = y, u0 = PAN.tu, v0 = PAN.tv, smp = { { x, y, X.millis() } } }; PAN.vu, PAN.vv = 0, 0
else PAN.d = nil end
return false
end
local d = PAN.d
if not d then return false end
if ev == "move" then
local dx, dy = x - d.x0, y - d.y0
if d.moved or dx * dx + dy * dy > 100 then
d.moved = true
PAN.tu, PAN.tv = d.u0 - dx / PAN.su, d.v0 - dy / PAN.sv
PAN.clamp()
end
d.smp[#d.smp + 1] = { x, y, X.millis() }; if #d.smp > 8 then table.remove(d.smp, 1) end
if X.moving then X.moving(600) end
return d.moved or false
end
if ev == "release" then
PAN.d = nil
if d.moved then
local t1, s0 = X.millis(), d.smp[1]
for _, sm in ipairs(d.smp) do if t1 - sm[3] <= 90 then s0 = sm; break end end
local dt = math.max(16, t1 - s0[3])
PAN.vu, PAN.vv = -(x - s0[1]) / dt / PAN.su, -(y - s0[2]) / dt / PAN.sv
if X.moving then X.moving(1500) end
end
return d.moved or false
end
return false
end
local function map3d(S, cp, my)
local mh = math.min(H - my - 380, 390)
if mh < 300 or not X.tilt3d or not X.tilt3d("wmap", 0, -10, 1, 1, 0) then return nil end
local MW, MD = (W - 40) * MAPZ, (W - 40) * 300 / 448 * MAPZ
local tilt = 0.62
local SCL = 1.03
local cy, sa, ca = my + mh * 0.5 + 10, math.sin(tilt), math.cos(tilt)
local FOC = 900
PAN.box = { 0, my, W, mh }
PAN.su, PAN.sv = MW * SCL, MD * ca * SCL
local function ty(v, cv0)
local z = (v - cv0) * MD
return cy + z * ca * (FOC / (FOC - z * sa)) * SCL
end
local function solve(f)
local lo, hi = -0.5, 1.5
for _ = 1, 24 do local m = (lo + hi) / 2; if f(m) then hi = m else lo = m end end
return hi
end
local cvmin = solve(function(c) return ty(0, c) <= my + 70 end)
local cvmax = solve(function(c) return ty(1, c) < my + mh - 24 end)
function PAN.clamp()
local hu = 0.5 * W / PAN.su
PAN.tu = hu >= 0.5 and 0.5 or math.max(hu - 0.03, math.min(1 - hu + 0.03, PAN.tu))
PAN.tv = (cvmin >= cvmax) and (cvmin + cvmax) / 2 or math.max(cvmin, math.min(cvmax, PAN.tv))
end
PAN.clamp()
local now0 = X.millis()
local dt = math.min(60, now0 - (PAN.last or now0)); PAN.last = now0
if not PAN.d and ((PAN.vu or 0) ~= 0 or (PAN.vv or 0) ~= 0) then
PAN.tu, PAN.tv = PAN.tu + PAN.vu * dt, PAN.tv + PAN.vv * dt
local f = math.exp(-dt / 280)
PAN.vu, PAN.vv = PAN.vu * f, PAN.vv * f
local u0, v0 = PAN.tu, PAN.tv
PAN.clamp()
if u0 ~= PAN.tu then PAN.vu = 0 end
if v0 ~= PAN.tv then PAN.vv = 0 end
if math.abs(PAN.vu) + math.abs(PAN.vv) < 0.00002 then PAN.vu, PAN.vv = 0, 0 end
end
local kk0 = 1 - math.exp(-dt / (PAN.d and 50 or 110))
PAN.cu, PAN.cv = PAN.cu + (PAN.tu - PAN.cu) * kk0, PAN.cv + (PAN.tv - PAN.cv) * kk0
local function MP(u, v, h)
local x, z = (u - PAN.cu) * MW, (v - PAN.cv) * MD
local yy = z * ca - (h or 0) * sa
local dep = -z * sa - (h or 0) * ca * 0.2
local k = FOC / (FOC + dep)
return W / 2 + x * k * SCL, cy + yy * k * SCL, k
end
local function quad(u0, v0, u1, v1, h)
local a1, b1 = MP(u0, v0, h); local a2, b2 = MP(u1, v0, h); local a3, b3 = MP(u1, v1, h); local a4, b4 = MP(u0, v1, h)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
if smudge.set_clip then smudge.set_clip(8, my, W - 16, mh) end
local sh = quad(0.02, 0.04, 1.02, 1.04, -8)
if smudge.shade_quad then smudge.shade_quad(sh[1] + 6, sh[2] + 6, sh[3] + 6, sh[4] + 6, sh[5] + 6, sh[6] + 6, sh[7] + 6, sh[8] + 6, 0) end
local top, bot = quad(0, 0, 1, 1, 0), quad(0, 0, 1, 1, -7)
smudge.fill_quad(top[7], top[8], top[5], top[6], bot[5], bot[6], bot[7], bot[8], true, X.TT and X.TT.panel)
smudge.fill_quad(top[3], top[4], top[5], top[6], bot[5], bot[6], bot[3], bot[4], true, X.TT and X.TT.panel)
smudge.fill_quad(top[1], top[2], top[7], top[8], bot[7], bot[8], bot[1], bot[2], true, X.TT and X.TT.panel)
smudge.draw_sprite_quad("art/wmap.raw", 768, 512, top[1], top[2], top[3], top[4], top[5], top[6], top[7], top[8])
for k2 = 0, 3 do
local i, j = k2 * 2 + 1, ((k2 + 1) % 4) * 2 + 1
smudge.line(fl(top[i] + 0.5), fl(top[i + 1] + 0.5), fl(top[j] + 0.5), fl(top[j + 1] + 0.5), 2)
end
local order = {}
for k = 1, NR do order[k] = k end
local dz = {}
for k = 1, NR do local _, sy2 = MP(SPOTS[k][1], SPOTS[k][2], 0); dz[k] = sy2 end
table.sort(order, function(i, j) return dz[i] < dz[j] end)
local t = X.millis()
local lab = {}
for _, k in ipairs(order) do
local s = SPOTS[k]
local open = unlocked(cp, k)
do
local R, n = (k == sel) and 0.058 or 0.048, 14
local cx0, cy0 = MP(s[1], s[2], 0)
local pts = {}
for i = 0, n - 1 do
local a = i / n * 2 * math.pi
local qx, qy = MP(s[1] + math.cos(a) * R, s[2] + math.sin(a) * R * 448 / 300, 0)
pts[#pts + 1] = { qx, qy }
end
for i = 1, n do
local p1, p2 = pts[i], pts[i % n + 1]
smudge.fill_quad(cx0, cy0, p1[1], p1[2], p2[1], p2[2], p2[1], p2[2], false)
end
for i = 1, n do
local p1, p2 = pts[i], pts[i % n + 1]
smudge.line(fl(p1[1] + 0.5), fl(p1[2] + 0.5), fl(p2[1] + 0.5), fl(p2[2] + 0.5), 2)
end
end
if k == sel then
local px, py
for i = 0, 24 do
local a = i / 24 * 2 * math.pi
local qx, qy = MP(s[1] + math.cos(a) * 0.078, s[2] + math.sin(a) * 0.078 * 448 / 300, 0)
if px then smudge.line(fl(px + 0.5), fl(py + 0.5), fl(qx + 0.5), fl(qy + 0.5), 3) end
px, py = qx, qy
end
end
local lift = (k == sel) and (8 + 5 * math.sin(t / 260)) or 0
local bx, by, kk = MP(s[1], s[2], 0)
local _, ty2 = MP(s[1], s[2], lift)
local sz = 92 * kk
local x0, y1 = bx - sz / 2, ty2 + sz * 0.12
local nm = "art/lm" .. k .. (open and "" or "_n")
smudge.draw_sprite_quad(nm .. ".raw", 96, 96, x0, y1 - sz, x0 + sz, y1 - sz, x0 + sz, y1, x0, y1, nm .. "_m.raw")
if not open then
local lx, ly = fl(bx), fl(y1 - sz * 0.45)
smudge.rounded_rect(lx - 10, ly - 4, 20, 16, 3, true); smudge.circle(lx, ly - 7, 6, false, 2)
smudge.rect(lx - 1, ly + 1, 2, 6, true, 1, false)
end
if get("sec" .. k) == 1 then smudge.circle(fl(x0 + sz - 4), fl(y1 - sz + 6), 6, true) end
lab[k] = { fl(bx), fl(y1 - sz - 2), open }
X.reg("REGION" .. k, fl(x0 - 6), fl(y1 - sz - 6), fl(sz + 12), fl(sz + 12), function() sel = k; PAN.tu, PAN.tv = s[1], s[2]; PAN.clamp() end)
end
local taken = {}
local names = { sel }
for k = 1, NR do if k ~= sel then names[#names + 1] = k end end
for _, k in ipairs(names) do
local r, l = REGIONS[k], lab[k]
local txt = l[3] and r[1] or (r[1] .. " (" .. r[2] .. ")")
local lw = X.tw(txt, "small", "bold")
local bx0, by0, bw0, bh0 = l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2
local free = true
for _, o in ipairs(taken) do
if bx0 < o[1] + o[3] + 2 and o[1] < bx0 + bw0 + 2 and by0 < o[2] + o[4] and o[2] < by0 + bh0 then free = false end
end
if free then taken[#taken + 1] = { bx0, by0, bw0, bh0 } end
if free then smudge.rounded_rect(l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2, 6, true, 1, false) end
if free and k == sel then smudge.rounded_rect(l[1] - lw // 2 - 5, l[2] - X.lh("small") - 1, lw + 10, X.lh("small") + 2, 6, false, 2) end
if free then X.ctext(l[1], l[2] - X.lh("small"), txt, "small", "bold") end
end
if smudge.set_clip then smudge.set_clip() end
smudge.rounded_rect(8, my, W - 16, mh, 12, false, 2)
return mh
end
function C.draw_worldmap(S)
local cp = S.camp
head(S, "World map", secrets() .. "/" .. NR .. " secrets")
local y = TOPY() + 4
local mh3 = map3d(S, cp, y)
local mx, my, mw, mh = 20, y, W - 40, mh3 or 300
if not mh3 then
smudge.draw_sprite(mx, my + 2, 440, 296, "art/wmap_r.raw")
smudge.rounded_rect(mx, my, mw, mh, 12, false, 2)
local taken = {}
for k, r in ipairs(REGIONS) do
local px, py = mx + fl(SPOTS[k][1] * mw), my + fl(SPOTS[k][2] * mh)
local open = unlocked(cp, k)
if k == sel then smudge.circle(px, py - 18, 32, false, 3) end
smudge.draw_sprite(px - 24, py - 42, 48, 48, "art/lm" .. k .. "_r.raw", "art/lm" .. k .. "_r_m.raw")
if not open then
smudge.rect_dither(px - 16, py - 36, 32, 32, true)
smudge.rounded_rect(px - 8, py - 22, 16, 13, 2, true); smudge.circle(px, py - 24, 5, false, 2)
end
if get("sec" .. k) == 1 then smudge.circle(px + 20, py - 40, 6, true) end
local lab = open and r[1] or (r[1] .. " (" .. r[2] .. ")")
local lw = X.tw(lab, "small", "bold")
local bx0, bw0 = px - lw // 2 - 3, lw + 6
local free = true
for _, o in ipairs(taken) do if bx0 < o[1] + o[3] and o[1] < bx0 + bw0 and math.abs(o[2] - py) < X.lh("small") + 2 then free = false end end
if free or k == sel then
taken[#taken + 1] = { bx0, py, bw0 }
smudge.rect(bx0, py + 7, bw0, X.lh("small"), true, 1, false)
X.ctext(px, py + 8, lab, "small", "bold")
end
X.reg("REGION" .. k, px - 30, py - 46, 60, 60, function() sel = k end)
end
end
local r = REGIONS[sel]
local py = my + mh + 10
panel(20, py, W - 40, 150)
smudge.draw_sprite(30, py + 8, 96, 96, string.format("art/ms%02d.raw", mart(sel)))
X.ltext(136, py + 8, r[1], "ui12", "bold")
X.button(W - 24 - 96, py + 8, 88, 34, "DROPS", function() ADV.show_drops(region_drops(sel)) end, { font = "small", id = "RDROPS", nohelp = true })
X.wrapped(136, py + 40, r[3], W - 180, "small", 2)
X.ltext(136, py + 88, unlocked(cp, sel) and string.format("Home of the %s", r[6]) or ("Needs total level " .. r[2]), "small", "bold")
X.ltext(136, py + 110, string.format("Skill: %s   Secret: %s", SK[r[5]].name, get("sec" .. sel) == 1 and "found" or "?"), "small")
local by = py + 160
local hw = (W - 48 - 10) // 2
X.button(24, by, hw, 64, "EXPLORE", function() explore(S, sel) end, { off = not unlocked(cp, sel), sub = "20 s trip", id = "EXPLORE" })
X.button(34 + hw, by, hw, 64, enc == sel and "FIGHT!" or "FIGHT", function() region_fight(S, sel) end,
{ off = not unlocked(cp, sel), sub = r[6], id = "RFIGHT", dot = (enc == sel) and "!" or nil })
X.draw_note(by + 70)
back_btn("camp")
end
return WO
end
