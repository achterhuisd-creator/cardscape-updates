local gx0, gy0, gx1, gy1 = lx0 + 8, ly0 + 7, lx0 + 60, ly1 - 7
local gq = { Q(gx0, gy0, gx1, gy1, fz) }
smudge.fill_quad(gq[1], gq[2], gq[3], gq[4], gq[5], gq[6], gq[7], gq[8], true, tk)
local bx0, bx1 = lx1 - 54, lx1 - 8
local seed = c * 131 + g * 17
local x = bx0
while x < bx1 do
seed = (seed * 1103 + 12345) % 65536
local wdt = 1 + seed % 3
if (seed // 8) % 3 ~= 0 then for xx = x, math.min(bx1, x + wdt - 1) do L(xx, ly0 + 8, xx, ly0 + 38, fz, 1) end end
x = x + wdt + 1
end
local hq = { Q(bx0, ly0 + 44, bx1, ly1 - 7, fz) }
smudge.fill_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], true, tk)
if smudge.glare_quad then smudge.glare_quad(hq[1], hq[2], hq[3], hq[4], hq[5], hq[6], hq[7], hq[8], (math.floor(o.ry * 20) % 2) == 0) end
box(bx0, ly0 + 44, bx1, ly1 - 7, fz, 1)
if smudge.text_sprite then
local key = c * 100 + g + (MG and anim_v * 100000 or 0)
if V3.glbl ~= key then
local cert = string.format("CERT %04d %03d%02d", 7300 + c * 37 % 2700, c, g * 7 % 100)
local gn = tostring(g)
if MG and anim_v >= 3 then gn = ({ "?", GL[gn:sub(1, 1)] or "#", "#" })[anim_v - 2] end
smudge.text_sprite("lblgnum", 48, 40, gn, "bitter14", nil, nil)
smudge.text_sprite("lblg1", 144, 46, corrupt(fit(cname(c), 142, "ui10", "bold")), "ui10", corrupt(GR.word(g)), "small")
smudge.text_sprite("lblg2", 144, 20, corrupt(cert), "small", nil, nil)
V3.glbl = key
end
local nq = { Q(gx0 + 4, gy0 + 4, gx1 - 4, gy1 - 4, fz) }
smudge.fill_quad(nq[1], nq[2], nq[3], nq[4], nq[5], nq[6], nq[7], nq[8], false, tk)
local gcx, gcy = (gx0 + gx1) / 2, (gy0 + gy1) / 2
local sq = { Q(gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz) }
tquad("lblgnum", 48, 40, gcx - 24, gcy - 18, gcx + 24, gcy + 22, fz)
local mx0, mx1 = gx1 + 6, bx0 - 6
tquad("lblg1", 144, 46, mx0, ly0 + 4, mx1, ly0 + 4 + 46 * (mx1 - mx0) / 144, fz)
tquad("lblg2", 144, 20, mx0, ly1 - 4 - 20 * (mx1 - mx0) / 144, mx1, ly1 - 4, fz)
end
box(gx0, gy0, gx1, gy1, fz, 2)
rrect(kx0, ky0, kx1, ky1, fz, CH8, 3)
rrect(kx0 + 4, ky0 + 4, kx1 - 4, ky1 - 4, fz, 6, 1)
L(kx0 + 4, ly1 + 6, kx1 - 4, ly1 + 6, fz, 1)
for yy = -hh + 30, hh - 30, 12 do
L(kx0 + 1, yy, kx0 + 4, yy, fz, 1); L(kx1 - 4, yy, kx1 - 1, yy, fz, 1)
end
if smudge.glare_quad then
local p = 0.5 + o.ry * 1.4 - o.rx * 1.0
local cw2 = kx1 - kx0
local t0 = kx0 - cw2 * 0.5 + p * cw2 * 1.6
local function cl(v) return math.max(kx0 + 4, math.min(kx1 - 4, v)) end
local gy = ly1 + 8
local x0, y0 = P(cl(t0), gy, fz); local x1, y1 = P(cl(t0 + 22), gy, fz)
local x2, y2 = P(cl(t0 + 22 - cw2 * 0.5), ky1 - 4, fz); local x3, y3 = P(cl(t0 - cw2 * 0.5), ky1 - 4, fz)
smudge.glare_quad(x0, y0, x1, y1, x2, y2, x3, y3, false)
end
end
end
SCREENS.card3d = function()
local c = V3.c
local now = smudge.millis()
top_bar(cname(c), D.tiers[tier_of(c) + 1])
local gx, gy = V3.tx, V3.ty
local held = V3.drag and V3.drag.moved
if not held then gx = 0.12 * math.sin(now / 1700 + 1); gy = 0.24 * math.sin(now / 1300) end
if not held and GFX.on then gx = gx * 0.4 + GFX.ty * 0.55; gy = gy * 0.4 + GFX.tx * 0.85 end
local dt = math.min(100, now - (V3.last or now)); V3.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
V3.rx = V3.rx + (gx - V3.rx) * k
if V3.spin and not held then
local sp = V3.spin
if math.abs(sp.v) > 0.0022 then
sp.a = sp.a + sp.v * dt; sp.v = sp.v * math.exp(-dt / 900)
else
local tgt = math.floor(sp.a / (2 * math.pi) + 0.5) * 2 * math.pi
sp.a = sp.a + (tgt - sp.a) * (1 - math.exp(-dt / 160))
if math.abs(tgt - sp.a) < 0.01 then V3.ry = sp.a - tgt; V3.spin = nil end
end
if V3.spin then V3.ry = sp.a; V3.moving = now + 1600 end
else
V3.spin = nil
V3.ry = V3.ry + (gy - V3.ry) * k
end
if tier_of(c) == 5 and not SAVER then
local g = math.floor(now / 140)
if g ~= V3.gl then V3.gl = g; gseed(g * 3 + 9); anim_v = (math.floor(now) % 2200 < 520) and grand(5) or 0 end
end
local graded = GR and GR.grade(c) > 0
local CW, CH = graded and 250 or 270, graded and 344 or 370
local bw, bh = graded and CW + 28 or CW, graded and CH + 110 or CH
local y0, y1 = TOP + 10, H - 150
local sc = math.min((W - 60) / bw, (y1 - y0) / bh) * (graded and 0.87 or 0.92)
local cy = (y0 + y1) / 2 + (graded and 41 * sc or 0)
local ry = math.atan(math.sin(V3.ry), math.cos(V3.ry))
local back = math.cos(ry) < 0
if back then ry = math.atan(math.sin(ry + math.pi), math.cos(ry + math.pi)) end
V3.render({ c = c, cx = W // 2, cy = cy, CW = CW, CH = CH, scale = sc, back = back,
rx = V3.rx, ry = ry, inset = 22, label = true, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
ctext(W / 2, H - 132, "Drag to tilt the card - tap to close", "small")
reg("CLOSE3D", 0, TOP, W, H - TOP, function() go("detail") end, false)
end
SCREENS.inspect = function()
local c = sel
if not c or not owned(c) then go("detail"); return end
local t, e = tier_of(c), elem_of(c)
top_bar(cname(c), D.tiers[t + 1])
local g = GR and GR.grade(c) or 0
local AW = 352
local CWd, CHd = AW + 32, AW + 100
local tot = (g > 0) and (92 + 18 + CHd + 22) or (CHd + 42)
local y = math.max(TOP + 4, TOP + 4 + (H - 92 - TOP - 4 - tot) // 2)
local function plastic_shine(x, yy, w, h)
if smudge.set_clip then smudge.set_clip(x, yy, w, h) end
for k = 0, 1 do
local x0 = x + w * (0.18 + 0.5 * k)
for d = 0, 2 - k do smudge.line(math.floor(x0 + d), yy + 6, math.floor(x0 - h * 0.35 + d), yy + h - 6, 1) end
end
if smudge.set_clip then smudge.set_clip() end
end
local cx = (W - CWd) // 2
local cy
if g > 0 then
local sx, sw = cx - 18, CWd + 36
local lh2 = 92
local sh = lh2 + 18 + CHd + 22
local sy = y
smudge.rounded_rect(sx + 5, sy + 6, sw, sh, 16, true)
smudge.rounded_rect(sx, sy, sw, sh, 16, true, 1, false)
smudge.rounded_rect(sx, sy, sw, sh, 16, false, 4)
smudge.rounded_rect(sx + 7, sy + 7, sw - 14, sh - 14, 11, false, 1)
for yy = sy + lh2 + 40, sy + sh - 40, 14 do
smudge.line(sx + 2, yy, sx + 6, yy, 1); smudge.line(sx + sw - 7, yy, sx + sw - 3, yy, 1)
end
local lx, ly, lw = sx + 14, sy + 14, sw - 28
smudge.rect(lx, ly, lw, lh2 - 14, false)
smudge.rounded_rect(lx, ly, lw, lh2 - 14, 4, false, 2)
smudge.rect(lx + 4, ly + 4, lw - 8, lh2 - 22, false); smudge.rounded_rect(lx + 4, ly + 4, lw - 8, lh2 - 22, 3, false, 1)
local gw = 66
smudge.rect(lx + 10, ly + 9, gw, lh2 - 32, true)
ctext(lx + 10 + gw // 2, ly + 13, "GRADE", "small", "bold", true)
ctext(lx + 10 + gw // 2, ly + 32, tostring(g), "bitter14", "bold", true)
local mx = lx + 10 + gw + 12
ltext(mx, ly + 9, fit(cname(c), lw - gw - 100, "ui10", "bold"), "ui10", "bold")
ltext(mx, ly + 33, GR.word(g), "small", "bold")
ltext(mx, ly + 52, string.format("CERT %04d %03d%02d", 7300 + c * 37 % 2700, c, g * 7 % 100), "small")
local bx1 = lx + lw - 12
local seed, x = c * 131 + g * 17, bx1 - 46
while x < bx1 do
seed = (seed * 1103 + 12345) % 65536
local wdt = 1 + seed % 3
if (seed // 8) % 3 ~= 0 then smudge.rect(x, ly + 12, wdt, 34, true) end
x = x + wdt + 1
end
smudge.rect_dither(bx1 - 46, ly + 52, 46, lh2 - 70, true)
smudge.rounded_rect(bx1 - 46, ly + 52, 46, lh2 - 70, 2, false, 1)
cy = sy + lh2 + 18
smudge.line(sx + 8, cy - 9, sx + sw - 9, cy - 9, 1)
smudge.rounded_rect(cx - 6, cy - 6, CWd + 12, CHd + 12, 8, false, 1)
plastic_shine(sx + 10, cy, sw - 20, CHd)
else
local sx, sw = cx - 12, CWd + 24
local sy, sh = y + 8, CHd + 34
smudge.rounded_rect(sx + 4, sy + 6, sw, sh, 10, true)
smudge.rounded_rect(sx, sy, sw, sh, 10, true, 1, false)
smudge.rounded_rect(sx, sy, sw, sh, 10, false, 3)
smudge.rect(sx + 6, sy, sw - 12, 3, false)
smudge.line(sx + 6, sy + 1, sx + sw - 7, sy + 1, 1)
smudge.circle(sx + sw // 2, sy, 14, false, 2)
smudge.rect(sx + sw // 2 - 13, sy - 14, 27, 15, false)
cy = sy + 22
plastic_shine(sx + 6, sy + 8, sw - 12, sh - 16)
end
card_frame(cx, cy, CWd, CHd, t)
local ax, ay = cx + 16, cy + 16
smudge.rect(ax - 3, ay - 3, AW + 6, AW + 6, false); smudge.rounded_rect(ax - 3, ay - 3, AW + 6, AW + 6, 2, false, 2)
smudge.draw_sprite(ax, ay, AW, AW, string.format("art/xl%02d.raw", c - 1))
local ny = ay + AW + 6
ctext(cx + CWd // 2, ny, fit(cname(c), CWd - 40, "ui12", "bold"), "ui12", "bold")
local a, h = card_stats(c)
ctext(cx + CWd // 2, ny + 34, string.format("%s   ATK %d   HP %d", D.tiers[t + 1], a, h), "small", "bold")
chip(cx + 28, cy + CHd - 24, e)
if S.shiny[c] == 1 then rtext(cx + CWd - 18, cy + CHd - 34, "SHINY", "small", "bold") end
if t >= 1 then for k = 0, math.min(t, 6) - 1 do smudge.circle(cx + CWd - 24 - k * 12, cy + CHd - 14, 3, true) end end
ctext(W / 2, H - 34, "Press OK or BACK to close", "small")
reg("CLOSEBIG", 0, TOP, W, H - TOP, function() go("detail") end, false)
end
SCREENS.detail = function()
local c = sel
local own = owned(c)
top_bar(own and cname(c) or "Undiscovered card", own and ("LV " .. S.lvl[c]) or "")
res_bar(TOP + 2)
local ax, ay = 24, TOP + 40
if own and V3.ok() and not SAVER then
local now = smudge.millis()
local m = V3.mini
if not m or m.c ~= c then m = { c = c, rx = 0, ry = 0, tx = 0, ty = 0 }; V3.mini = m end
m.box = { ax, ay, 208, 208 }
local held = m.drag and m.drag.moved
local gx, gy = m.tx, m.ty
if not held then gx = 0.08 * math.sin(now / 1700 + 1); gy = 0.16 * math.sin(now / 1300) end
local dt = math.min(100, now - (m.last or now)); m.last = now
local k = 1 - math.exp(-dt / (held and 60 or 110))
m.rx = m.rx + (gx - m.rx) * k; m.ry = m.ry + (gy - m.ry) * k
V3.render({ c = c, cx = ax + 104, cy = ay + 104, CW = 208, CH = 208, inset = 8, depth = 0.6,
rx = m.rx, ry = m.ry, layers = true, fx = tier_of(c), shiny = S.shiny[c] == 1 })
else
bigcard(ax, ay, c, own)
if own and S.shiny[c] == 1 then glass(ax + 8, ay + 8, 192) end
end
if own and GR then GR.badge(ax + 4, ay + 4, c, true) end
if own and not V3.ok() then EVO.badge(ax + 11, ay + 197, c, true) end
if EVO.fx and EVO.fx.c == c and not SAVER then
local k = (smudge.millis() - EVO.fx.t) / 1100
if k < 1 then
for r = 0, 2 do
local q = k * 1.6 - r * 0.25
if q > 0 and q < 1 then
local g = math.floor(4 + q * 30)
smudge.rounded_rect(ax - g, ay - g, 208 + 2 * g, 208 + 2 * g, 14 + g // 3, false, math.max(1, math.floor(4 * (1 - q))))
end
end
if k < 0.18 and smudge.glare_quad then smudge.glare_quad(ax + 8, ay + 8, ax + 200, ay + 8, ax + 200, ay + 200, ax + 8, ay + 200, false) end
local ty = ay + 90 - math.floor(k * 30)
local tw2 = tw("EVOLVED!", "ui12", "bold") + 24
smudge.rounded_rect(ax + 104 - tw2 // 2, ty - 4, tw2, lh("ui12") + 8, 10, true)
ctext(ax + 104, ty, "EVOLVED!", "ui12", "bold", true)
V3.moving = smudge.millis() + 200
else EVO.fx = nil end
end
if own and V3.ok() then reg("CARD3D", ax, ay, 208, 208, function() V3.open(c) end, false) end
if own and not V3.ok() then reg("INSPECT", ax, ay, 208, 208, function() go("inspect") end) end
if own and not SAVER and tier_of(c) >= 1 and not V3.ok() then card_aura(ax, ay, anim_t, tier_of(c)) end
local t, e = tier_of(c), elem_of(c)
local x, w = 250, 206
local gtxt = (own and GR and GR.grade(c) > 0) and ("  G" .. GR.grade(c) .. " +" .. GR.atk(c)) or ""
ltext(x, ay + 2, fit(D.tiers[t + 1] .. ((own and S.shiny[c] == 1) and "  SHINY" or "") .. gtxt, w, "ui10", "bold"), "ui10", "bold")
tint(x, ay + 2, tw(D.tiers[t + 1], "ui10", "bold") + 1, lh("ui10") - 2, t, "ink")
chip(x + 16, ay + 38, e)
ltext(x + 40, ay + 28, D.elems[e], "ui12", "bold")
smudge.line(x, ay + 62, x + w, ay + 62, 1)
if own then
local a, h = card_stats(c)
local as = C.asc(c)
ltext(x, ay + 70, fit(string.format("Level %d / %d", S.lvl[c], D.max_level) .. ((as > 0) and ("  " .. string.rep("*", as)) or "")
.. ((EVO.n(c) > 0) and ("  EVO " .. EVO.n(c)) or "") .. ((DX.m(c) > 0) and ("  M" .. DX.m(c)) or ""), w, "ui10", "bold"), "ui10", "bold")
if S.lvl[c] >= D.max_level then
if as < 5 then
local du, sp, sc = C.asc_cost(c)
button(x, ay + 94, w, 46, "ASCEND " .. (as + 1) .. "/5", function() C.ascend(S, c) end,
{ font = "small", sub = string.format("%d dust %d spare %d scale", du, sp, sc), id = "ASCEND" })
else ltext(x, ay + 110, "FULLY ASCENDED", "small", "bold") end
else
local frac = S.xp[c] / D.xp_need[S.lvl[c]]
bar(x, ay + 98, w, 18, frac)
ltext(x, ay + 120, string.format("%d / %d xp", S.xp[c], D.xp_need[S.lvl[c]]), "small")
end
icon_sword(x + 12, ay + 160); ltext(x + 34, ay + 148, "ATK  " .. a, "ui12", "bold")
icon_heart(x + 12, ay + 192); ltext(x + 34, ay + 178, "HP   " .. h, "ui12", "bold")
else
ltext(x, ay + 72, "Not found yet.", "ui10", "bold")
wrapped(x, ay + 100, (tier_of(c) == 6) and "A secret. It can only drop from a pack." or "Find it in a pack or craft it with dust.", w, "small", 4)
end
local y = ay + 222
ltext(24, y, "Strong vs " .. D.elems[D.beats[e]], "ui10")
rtext(W - 24, y, "Weak to " .. D.elems[D.weak[e]], "ui10")
local ly = y + 30
if own then
if t == 4 then ly = wrapped(24, ly, D.ability[e], W - 48, "ui10", 3)
else ly = wrapped(24, ly, D.lore[c], W - 48, "ui10", 3) end
end
local sy = ay + 222 + 30 + 84
if CS_SMOOTH then sy = math.max(sy, H - 96 - 10 - 176) end
if own then
local ry = CS_SMOOTH and (sy - 66) or (sy + 176)
local hw = (W - 48 - 10) // 2
local tt2 = tier_of(c) + 1
if S.shiny[c] == 1 then
button(24, ry, hw, 56, "SHINY", function() note = "This card is already shiny." end, { font = "small", sub = "already shiny", off = true, id = "MKSHINY" })
else
local sc2 = DX.SHINY[tt2]
button(24, ry, hw, 56, "MAKE SHINY", function()
if S.dust < sc2 then note = string.format("Making it shiny costs %d dust (you have %d).", sc2, S.dust); return end
S.dust = S.dust - sc2; S.shiny[c] = 1; save_now()
note = cname(c) .. " is shiny now! (+1 ATK, +2 HP)"; aura_start()
end, { font = "small", sub = sc2 .. " dust", off = S.dust < sc2, id = "MKSHINY" })
end
local mc = DX.mcost(c)
local maxed = S.lvl[c] >= D.max_level
button(34 + hw, ry, hw, 56, "MASTERY " .. (DX.m(c) + 1), function()
if not maxed then note = "Mastery starts once a card is level " .. D.max_level .. "."; return end
if DX.m(c) >= 99 then note = "Mastery 99: the very top."; return end
if S.dust < mc then note = string.format("The next mastery star costs %d dust (you have %d).", mc, S.dust); return end
S.dust = S.dust - mc; DX.mast[c] = DX.m(c) + 1; DX.save(); save_now()
note = string.format("%s: mastery %d! (+1 ATK, +2 HP)", cname(c), DX.m(c))
end, { font = "small", sub = maxed and (mc .. " dust, +1 ATK +2 HP") or ("at level " .. D.max_level), off = (not maxed) or S.dust < mc, id = "MASTERY" })
end
smudge.line(24, sy, W - 24, sy, 2)
if own then
ltext(24, sy + 12, "Spares: " .. S.spare[c], "ui12", "bold")
if S.spare[c] > 0 and CHAT_READY() then
local ask = GIFTC and GIFTC[1] == c and smudge.millis() - GIFTC[2] < 4000
button(W - 24 - 150 - 118, sy + 4, 108, 52, ask and "SURE?" or "GIFT", function() CHAT_GIFT(c) end,
{ font = "ui10", sub = ask and "tap again" or "in the chat", active = ask, id = "GIFTCARD" })
elseif S.spare[c] > 0 then
button(W - 24 - 150 - 118, sy + 4, 108, 52, F.card_asking(c) and "SURE?" or "GIFT", function() F.gift_card_tap(c) end,
{ font = "ui10", sub = "1 copy", active = F.card_asking(c), id = "GIFTCARD" })
end
button(W - 24 - 150, sy + 4, 150, 52, all_mode and "ALL" or "ONE", function() all_mode = not all_mode end,
{ font = "ui10", sub = "copies per tap" })
local n = all_mode and S.spare[c] or math.min(1, S.spare[c])
local tt = tier_of(c) + 1
if S.spare[c] > 0 then
button(24, sy + 70, 138, 96, "SELL", function() spare_action("sell") end,
{ sub = string.format("+%d coins", D.sell_value[tt] * n) })
local maxed = S.lvl[c] >= D.max_level
if maxed and t < 6 then
local done = EVO.n(c) >= EVO.MAX
local ec = EVO.cost(c)
button(171, sy + 70, 138, 96, done and "EVOLVED" or ("EVOLVE " .. (EVO.n(c) + 1) .. "/" .. EVO.MAX), function() evolve(c) end,
{ font = done and "ui10" or "small", sub = done and "fully" or string.format("3 + %d dust", ec), off = done or S.spare[c] < 3 or S.dust < ec, id = "EVOLVE" })
else
button(171, sy + 70, 138, 96, "MERGE", function() spare_action("merge") end,
{ sub = maxed and "max level" or string.format("+%d xp", D.xp_value[tt] * n), off = maxed })
end
button(318, sy + 70, 138, 96, "DUST", function() spare_action("dust") end,
{ sub = string.format("+%d dust", D.dust_value[tt] * n) })
else
ctext(W / 2, sy + 84, "No spares. Duplicates from packs land here.", "small")
end
elseif tier_of(c) == 6 then
ctext(W / 2, sy + 20, "SECRET CARD - cannot be crafted", "ui10", "bold")
ctext(W / 2, sy + 56, "Any secret: 1 in 10,000,000 per pulled card", "small")
else
local cost = D.craft_cost[t + 1]
ltext(24, sy + 12, string.format("Craft cost: %d dust  (you have %d)", cost, S.dust), "ui10", "bold")
button(24, sy + 70, W - 48, 96, "CRAFT", function() craft_card(c) end,
{ sub = string.format("%d dust", cost), off = S.dust < cost })
end
draw_note(H - 134)
if own and CHAT_READY() then
local bw4 = (W - 48 - 24) // 4
button(24, H - 96, bw4, 64, "PREV", function() sel = D.step(sel, -1); note = ""; anim_t = 0 end, { font = "ui10" })
button(32 + bw4, H - 96, bw4, 64, "BACK", function() go("album") end, { font = "ui10" })
button(40 + 2 * bw4, H - 96, bw4, 64, "SHOW", function()
smudge.pet_chat_card("card", c, cname(c), CHAT_CARD_LINE(c)); note = cname(c) .. " is in the chat now."
end, { font = "ui10", sub = "in the chat", id = "SHOWCHAT" })
button(48 + 3 * bw4, H - 96, bw4, 64, "NEXT", function() sel = D.step(sel, 1); note = ""; anim_t = 0 end, { font = "ui10" })
else
button(24, H - 96, 120, 64, "PREV", function() sel = D.step(sel, -1); note = ""; anim_t = 0 end, { font = "ui10" })
button(156, H - 96, 168, 64, "BACK", function() go("album") end, { font = "ui10" })
button(336, H - 96, 120, 64, "NEXT", function() sel = D.step(sel, 1); note = ""; anim_t = 0 end, { font = "ui10" })
end
end
local function info_line(e)
return "Weak to " .. D.elems[D.weak[e]] .. "   -   Strong vs " .. D.elems[D.beats[e]]
end
SCREENS.quest = function()
local e = PE
top_bar(e.duel and F.duel_title() or e.wb and ("WORLD BOSS - " .. e.name) or e.lair and ("BOSS - " .. e.name) or (e.wild and ("Wilderness lvl " .. e.wild * 10)) or (e.tower and ((e.boss and "BOSS - " or "Tower - ") .. "Floor " .. e.tower) or (e.boss and ("BOSS - Stage " .. S.stage) or ("Quest - Stage " .. S.stage))), "")
local ey = TOP + 4
local ee = e.eelem or elem_of(e.ec)
thumb(16, ey, e.ec, { show = true, art = e.art })
local x = 138
ltext(x, ey, fit(e.name or cname(e.ec), W - x - 10, "ui12", "bold"), "ui12", "bold")
chip(x + 16, ey + 44, ee)
ltext(x + 38, ey + 32, D.elems[ee] .. " - " .. ((e.lair or e.wb) and "BOSS" or (e.wild and "WILDERNESS" or D.tiers[tier_of(e.ec) + 1])), "small")
icon_heart(x + 12, ey + 70); ltext(x + 30, ey + 58, "HP " .. e.eh, "ui10", "bold")
icon_sword(x + 142, ey + 70); ltext(x + 160, ey + 58, "ATK " .. e.ea, "ui10", "bold")
ltext(x, ey + 84, "Weak to  " .. D.elems[D.weak[ee]], "ui10", "bold")
ltext(x, ey + 108, "Strong vs " .. D.elems[D.beats[ee]], "small")
if e.boss then ltext(x + 170, ey + 4, "BOSS", "small", "bold") end
ctext(W / 2, ey + 132, "Choose a fighter. Dots: your cards strong here.", "small")
local tabs = { "COM", "UNC", "RARE", "LEG", "EXO", "MYTH", "???" }
swipe_tabs(function() return page end, function(t) page = t end, 0, 6)
for i = 0, 6 do
local n = GRID.count(i, function(c) return S.lvl[c] > 0 and mult(elem_of(c), ee) == 2 end)
local tx = 6 + i * 67
button(tx, ey + 156, 63, 52, tabs[i + 1], function() if page == i then GRID.flip("fight", i) end; page = i end,
{ font = "small", sub = " ", active = (page == i), id = tabs[i + 1] })
local bx, by = tx + 31, ey + 156 + 36
if n > 0 then
smudge.circle(bx, by, 10, true); ctext(bx, by - lh("small") // 2, tostring(n), "small", "bold", true); badge_tint(bx, by, 10)
else
smudge.circle(bx, by, 10, true, 1, false); smudge.circle(bx, by, 10, false, 1)
ctext(bx, by - lh("small") // 2, "0", "small")
end
end
local y0 = ey + 220
local frows = 2
frows = GRID.draw("fight", page, y0, 2, 172, function(c, gx, gy)
thumb(gx, gy, c, { name = true })
if owned(c) then
local a, h = card_stats(c)
ctext(gx + 54, gy + 130, string.format("A%d  H%d", a, h), "small")
local mo, mt = mult(elem_of(c), ee), mult(ee, elem_of(c))
local tag
if mo == 2 then tag = "STRONG x2"
elseif mo == 0.5 then tag = "WEAK x1/2"
elseif mt == 2 then tag = "HIT BY x2"
else tag = "EVEN" end
ctext(gx + 54, gy + 150, tag, "small", "bold")
local bx, by = gx + 94, gy + 14
if mo == 2 then
smudge.circle(bx, by, 13, true); ctext(bx, by - lh("small") // 2, "x2", "small", "bold", true); badge_tint(bx, by, 13)
elseif mo == 0.5 then
smudge.circle(bx, by, 13, true, 1, false); smudge.circle(bx, by, 13, false, 2)
ctext(bx, by - lh("small") // 2, "/2", "small", "bold")
end
end
reg("card" .. c, gx, gy, 108, 168, function()
if owned(c) then start_battle(c) else note = "You do not own that card yet." end
end, true)
end, H - 96 - 56) or 2
draw_note(y0 + frows * 172)
button(24, H - 96, W - 48, 64, "BACK", function()
if e.duel then PE = nil; F.duel_quit(); return end
if e.lair or e.wild or e.wb then local back = e.wb and "worldboss" or ((e.lair == 9) and "questinfo" or (e.lair and "lairs" or "wild")); PE = nil; go(back) else go("title") end
end, { font = "ui10" })
end
local function leave_battle()
local won, tower = B.win, B.tower
if B.duel then B = nil; PE = nil; F.duel_next(); return end
if B.lair or B.wild or B.wb then local back = C.adv_back(B); B = nil; PE = nil; go(back); return end
B = nil
if won then
if tower then new_tower_enemy(S.tower + 1) else new_enemy() end
end
go("quest")
end
SCREENS.battle = function()
local boss = B.boss
top_bar(B.duel and F.duel_title() or B.wb and ("WORLD BOSS - " .. ename()) or B.lair and ("BOSS - " .. ename()) or (B.wild and ("Wilderness lvl " .. B.wild * 10)) or (B.tower and ("Tower - Floor " .. B.tower) or (boss and ("BOSS - Stage " .. B.stage) or ("Stage " .. B.stage))), "")
local ee, pe = eelem(), elem_of(B.pc)
local ey = TOP + 4
ltext(24, ey, ename(), "ui12", "bold")
chip(40, ey + 40, ee)
ltext(64, ey + 32, D.elems[ee] .. " - " .. ((B.lair or B.wb) and "BOSS" or (B.wild and "WILDERNESS" or D.tiers[tier_of(B.ec) + 1])), "small")
bar(24, ey + 58, 300, 24, B.ehp / B.emax)
ltext(24, ey + 88, string.format("HP %d / %d   ATK %d", B.ehp, B.emax, B.eatk) .. stt(B.es), "small", "bold")
ltext(24, ey + 112, info_line(ee), "small")
local py = TOP + 146
if V3.ok() and not SAVER then
local now = GFX.now()
local function pose(fx, side)
local dx, dy, rx, ry = 0, 0, 0.06 * math.sin(now / 1500 + side), -0.28 * side + 0.05 * math.sin(now / 1200 + side)
if fx then
local u = (now - fx.t) / 450
if u >= 0 and u < 1 then
local sw = math.sin(u * math.pi)
if fx.k == "lunge" then dx, dy, rx = dx + 70 * sw * side, dy - 44 * sw * side, rx - 0.35 * sw * side
elseif fx.k == "hit" then dx = dx + math.sin(u * 38) * 9 * (1 - u); ry = ry + math.sin(u * 25) * 0.35 * (1 - u)
elseif fx.k == "guard" then ry = ry + 1.15 * sw * side end
end
end
return dx, dy, rx, ry
end
local function fall(r, win_side)
if B.over and B.endt then
local u = math.max(0, math.min(1, (now - B.endt - (GFX.ok() and 420 or 0)) / 600))
return r + 1.25 * u * u, u
end
return r, 0
end
if B.over and not B.endt then
local hf = B.win and B.fxe or B.fxp
B.endt = math.max(now, (hf and hf.k == "hit" and hf.t or now) + 60)
end
local edx, edy, erx, ery = pose(B.fxe, -1)
local pdx, pdy, prx, pry = pose(B.fxp, 1)
if B.over then
if B.win then erx = fall(erx) elseif not B.fled then prx = fall(prx) end
end
local ko_e = B.over and B.win and B.endt and math.min(1, (now - B.endt) / 380) or nil
local ko_p = B.over and not B.win and not B.fled and B.endt and math.min(1, (now - B.endt) / 380) or nil
V3.render({ c = B.ec, cx = 402 + edx, cy = ey + 56 + edy, CW = 104, CH = 104, rx = erx, ry = ery, inset = 6, depth = 0.6,
art = B.art, layers = not B.art, fx = (not B.art) and tier_of(B.ec) or nil, crack = ko_e })
V3.render({ c = B.pc, cx = 78 + pdx, cy = py + 56 + pdy, CW = 104, CH = 104, rx = prx, ry = pry, inset = 6, depth = 0.6,
layers = true, fx = tier_of(B.pc), shiny = S.shiny[B.pc] == 1, crack = ko_p })
if B.fxe and B.fxe.k == "hit" and not B.fxe.gfx and now >= B.fxe.t then
B.fxe.gfx = true; GFX.hit(402 + edx, ey + 56 + edy, B.fxe.el, B.fxe.big, B.fxe.ko)
if B.fxe.dmg then GFX.pop(402 + edx, ey + 10 + edy, "-" .. B.fxe.dmg, B.fxe.big and { 255, 230, 90 } or { 255, 200, 60 }) end
end
if B.fxp and B.fxp.k == "hit" and not B.fxp.gfx and now >= B.fxp.t then
B.fxp.gfx = true; GFX.hit(78 + pdx, py + 56 + pdy, B.fxp.el, B.fxp.big, B.fxp.ko); GFX.shake(5, 300)
if B.fxp.dmg then GFX.pop(78 + pdx, py + 10 + pdy, "-" .. B.fxp.dmg, { 255, 70, 60 }) end
end
else
thumb(348, ey, B.ec, { show = true, art = B.art })
thumb(24, py, B.pc, { show = true })
if B.over and not B.fled then GFX.crack2d(B.win and 348 or 24, B.win and ey or py, 108, 108, B.win and B.ec or B.pc) end
end
ltext(150, py, cname(B.pc), "ui12", "bold")
ltext(150, py + 28, string.format("LV %d - %s", S.lvl[B.pc], D.elems[pe]) .. ((tier_of(B.pc) == 4) and (" - " .. D.ability_short[pe]) or ""), "small")
bar(150, py + 58, 300, 24, B.php / B.pmax)
ltext(150, py + 88, string.format("HP %d / %d   ATK %d", B.php, B.pmax, B.patk) .. stt(B.ps), "small", "bold")
ltext(150, py + 114, "Energy", "small")
for i = 1, 5 do smudge.circle(238 + (i - 1) * 24, py + 122, 8, i <= B.energy, 2) end
ltext(24, py + 138, info_line(pe), "small")
ctext(W / 2, py + 164, string.format("Your hits %s     Their hits %s", mult_txt(mult(pe, ee)), mult_txt(mult(ee, pe))), "small", "bold")
local ly = py + 190
if not SAVER then smudge.rounded_rect(28, ly + 4, W - 48, 108, 8, true, 1) end
smudge.rounded_rect(24, ly, W - 48, 108, 8, true, 1, false)
smudge.rounded_rect(24, ly, W - 48, 108, 8, false, 2)
for i, line in ipairs(B.log) do ltext(36, ly + 6 + (i - 1) * 24, fit(line, W - 72, "small", "regular"), "small") end
if B.over then
local y = ly + 124
ctext(W / 2, y, B.win and "VICTORY!" or (B.fled and "RETREATED" or (B.wb and "KNOCKED BACK" or "DEFEATED")), "bitter14", "bold")
if B.reward > 0 then
icon_coin(W / 2 - 50, y + 54); ltext(W / 2 - 32, y + 42, "+" .. B.reward .. " coins", "ui12", "bold")
end
if B.lair or B.wild or B.wb then
local t = (B.dust and B.win) and ("+" .. B.dust .. " dust  ") or ""
ctext(W / 2, y + 78, fit(t .. (B.bonus or ""), W - 40, "ui10", "regular"), "ui10")
elseif B.win and not B.duel then
local extra = B.scales and (string.format("  +%d Boss scale", B.scales)) or ""
if B.dust then extra = extra .. "  +" .. B.dust .. " dust" end
if B.tower then ctext(W / 2, y + 78, string.format("Next: floor %d", S.tower + 1) .. extra, "ui10")
else ctext(W / 2, y + 78, string.format("Next: stage %d", S.stage) .. extra, "ui10") end
if B.bonus then ctext(W / 2, y + 100 - 2, B.bonus, "small", "bold") end
end
button(24, y + 108, W - 48, 76, "CONTINUE", function() leave_battle() end)
return
end
local by = ly + 138
draw_note(by - 26)
local busy = B.busy
button(24, by, W - 48, 74, "ATTACK", function() player_act("attack") end, { off = busy })
button(24, by + 82, 210, 74, "GUARD", function() player_act("guard") end, { off = busy, sub = "heal + halve hit" })
button(246, by + 82, 210, 74, "SPECIAL", function() player_act("special") end,
{ off = busy or B.energy < 3, sub = "3 energy, double hit" })
local pp, pmx = C.pray_points(S)
button(246, by + 164, 210, 52, B.prot and "PRAY: ON" or "PRAY: OFF", function()
if not B.prot and pp <= 0 then note = "No prayer points. Restore them at the altar."; return end
B.prot = not B.prot
note = B.prot and ("Protect from " .. D.elems[eelem()] .. ": half damage.") or "Prayer off."
end, { font = "small", sub = pp .. "/" .. pmx .. " points", active = B.prot, off = busy, id = "PRAY" })
button(24, by + 164, 210, 52, "RETREAT", function()
if B.retreat then
B.over = true; B.win = false; B.reward = 0; B.fled = true; blog("You retreated.")
else
B.retreat = true; note = "Tap RETREAT again to give up."
end
end, { font = "ui10", off = busy })
end
local TR = { cx = 0, tx = 0, vx = 0 }
function TR.items()
local cp, WO = S.camp, C.ADV and C.ADV.WO
local L = {}
for _, c in ipairs(D.tier_cards[6]) do
L[#L + 1] = { kind = "card", c = c, got = owned(c), name = owned(c) and cname(c) or "Secret card",
how = "A secret card: 1 in 10 million per card from packs (the Mythic box, the well and LEGEND+ packs help)." }
end
if WO then
for k, r in ipairs(WO.REGIONS) do
L[#L + 1] = { kind = "sec", k = k, got = WO.get("sec" .. k) == 1, name = r[1] .. " secret", how = "EXPLORE " .. r[1] .. " on the world map: 3% per trip." }
end
for k = 7, #WO.REGIONS do
local r = WO.REGIONS[k]
if r[9] then
local id = ({ [7] = "tlhide", [8] = "sscale", [9] = "wscale", [10] = "rcryst" })[k]
L[#L + 1] = { kind = "drop", id = id, got = WO.get("sp" .. k) == 1, name = id and C.item_name and C.item_name(r[9]) or "Special drop",
how = "Defeat the " .. r[6] .. " in " .. r[1] .. ": 1 in 8." }
end
end
end
local tot, mx = 0, 0
for i = 1, #cp.ach do tot = tot + (cp.ach[i] or 0); mx = mx + 5 end
local frac = (mx > 0) and tot / mx or 0
for t, need in ipairs({ 0.25, 0.6, 1 }) do
L[#L + 1] = { kind = "cup", t = t, got = frac >= need, name = ({ "Bronze", "Silver", "Gold" })[t] .. " cup",
how = string.format("Achievement stars: %d / %d (%d%% needed).", tot, mx, math.floor(need * 100)) }
end
local all = true
for _, it in ipairs(L) do if not it.got then all = false end end
L[#L + 1] = { kind = "star", got = all, name = "Crystal star", how = "Everything else in this hall." }
local n = 0 for _, it in ipairs(L) do if it.got then n = n + 1 end end
return L, n
end
function TR.touch(ev, x, y)
if scr ~= "trophies" or not TR.box or type(x) ~= "number" then return false end
local now = smudge.millis()
if ev == "down" then
if smudge.in_rect(x, y, TR.box[1], TR.box[2], TR.box[3], TR.box[4]) then TR.d = { x0 = x, c0 = TR.tx, smp = { { x, now } } }; TR.vx = 0 end
return false
end
local d = TR.d
if not d then return false end
if ev == "move" then
if d.moved or math.abs(x - d.x0) > 10 then
d.moved = true
TR.tx = TR.clamp(d.c0 - (x - d.x0) / TR.k)
d.smp[#d.smp + 1] = { x, now }; if #d.smp > 8 then table.remove(d.smp, 1) end
V3.moving = now + 600
end
return d.moved or false
end
if ev == "release" then
TR.d = nil
if d.moved then
local s0 = d.smp[1]
for _, sm in ipairs(d.smp) do if now - sm[2] <= 90 then s0 = sm; break end end
TR.vx = -(x - s0[1]) / math.max(16, now - s0[2]) / TR.k
V3.moving = now + 1500
end
return d.moved or false
end
return false
end
SCREENS.trophies = function()
local L, got = TR.items()
top_bar("Trophy room", got .. " / " .. #L)
local now = smudge.millis()
local y0, h0 = TOP + 6, H - 96 - 110 - TOP
local SP = 150
local LEN = (#L - 1) * SP
function TR.clamp(v) return math.max(0, math.min(LEN, v)) end
local dt = math.min(60, now - (TR.last or now)); TR.last = now
if not TR.d and TR.vx ~= 0 then
TR.tx = TR.clamp(TR.tx + TR.vx * dt); TR.vx = TR.vx * math.exp(-dt / 300)
if math.abs(TR.vx) < 0.01 then TR.vx = 0 end
end
TR.cx = TR.cx + (TR.tx - TR.cx) * (1 - math.exp(-dt / (TR.d and 50 or 110)))
if not (V3.ok() and smudge.draw_sprite_quad and smudge.fill_quad) then
local half = (#L + 1) // 2
for i, it in ipairs(L) do
local col, row = (i - 1) // half, (i - 1) % half
ltext(24 + col * (W - 48) // 2, y0 + 10 + row * 24, fit((it.got and "* " or "- ") .. it.name, (W - 60) // 2, "small", it.got and "bold" or "regular"), "small", it.got and "bold" or "regular")
end
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go(TR.ret or "title"); TR.ret = nil end, { font = "ui10" })
return
end
TR.box = { 0, y0, W, h0 }
local HH, D0, FOC = 150, 230, 700
local ccy = y0 + h0 / 2
local ZS = h0 / (2 * HH * 1.15)
TR.k = ZS * 0.8
local function P(x, y, z)
local k = FOC / (FOC + z) * ZS
return W / 2 + (x - TR.cx) * k, ccy + y * k, k
end
local function quad(x0, y0q, z0, x1, y1q, z1, x2, y2q, z2, x3, y3q, z3)
local a1, b1 = P(x0, y0q, z0); local a2, b2 = P(x1, y1q, z1); local a3, b3 = P(x2, y2q, z2); local a4, b4 = P(x3, y3q, z3)
return { a1, b1, a2, b2, a3, b3, a4, b4 }
end
if smudge.set_clip then smudge.set_clip(0, y0, W, h0) end
local TW = 2 * HH * 2
local xs = TR.cx - W * 0.9
local i0 = math.floor(xs / TW)
for i = i0, i0 + 5 do
local xa, xb = i * TW - 300, (i + 1) * TW - 300 + 6
local q = quad(xa, -HH - 4, D0, xb, -HH - 4, D0, xb, HH + 4, D0, xa, HH + 4, D0)
smudge.draw_sprite_quad("art/th_back.raw", 256, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
local c2 = quad(xa, -HH, -60, xb, -HH, -60, xb, -HH, D0, xa, -HH, D0)
smudge.draw_sprite_quad("art/th_ceil.raw", 256, 128, c2[1], c2[2], c2[3], c2[4], c2[5], c2[6], c2[7], c2[8])
end
do
local BS = 100
local xa0 = math.floor((TR.cx - W * 0.9) / BS) * BS
for zb0 = -60, D0 - 1, BS do
local zb1 = math.min(D0, zb0 + BS)
local vv = (zb1 - zb0) / BS
for xi = 0, math.ceil(W * 2 / BS) do
local xa = xa0 + xi * BS
local q = quad(xa, HH, zb1 + 1, xa + BS + 1, HH, zb1 + 1, xa + BS + 1, HH, zb0, xa, HH, zb0)
smudge.draw_sprite_quad("art/th_tile.raw", 128, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], nil, 0, 1 - vv, 1, 1)
end
end
local cz0, cz1 = D0 * 0.5 - 40, D0 * 0.5 + 40
local r = quad(xa0, HH, cz1, xa0 + W * 2, HH, cz1, xa0 + W * 2, HH, cz0, xa0, HH, cz0)
smudge.fill_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], false, TT.bg)
if smudge.glare_quad then smudge.glare_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], true) end
if smudge.shade_quad then smudge.shade_quad(r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], 0) end
for _, zz in ipairs({ cz0, cz0 + 6, cz1 - 6, cz1 }) do
local a1, b1 = P(xa0, HH, zz); local a2, b2 = P(xa0 + W * 2, HH, zz)
smudge.line(math.floor(a1), math.floor(b1), math.floor(a2), math.floor(b2), (zz == cz0 or zz == cz1) and 2 or 1)
end
end
for _, ex in ipairs({ -300, LEN + 300 }) do
local q = (ex < 0) and quad(ex, -HH, -60, ex, -HH, D0, ex, HH, D0, ex, HH, -60) or quad(ex, -HH, D0, ex, -HH, -60, ex, HH, -60, ex, HH, D0)
smudge.draw_sprite_quad("art/th_side.raw", 256, 128, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8])
end
local pick, pd = nil, 1e9
for i, it in ipairs(L) do
local x = (i - 1) * SP
if math.abs(x - TR.cx) < W * 1.0 then
local z = D0 * 0.5
local bx, by, k = P(x, HH, z)
local function spr(nm, sw, sh, w, h, lift)
w, h, lift = w * 0.75, h * 0.75, (lift or 0) * 0.75
local x0, y1 = bx - w * k / 2, by - lift * k
local p = "art/" .. nm
smudge.draw_sprite_quad(p .. ".raw", sw, sh, x0, y1 - h * k, x0 + w * k, y1 - h * k, x0 + w * k, y1, x0, y1, p .. "_m.raw")
return x0, y1 - h * k, w * k, h * k
end
local top
if it.kind == "card" then
local fx, fy, fw, fh = spr("tp4", 128, 128, 150, 150)
local function E(u, v)
local tx, ty = 45 + (87 - 45) * u, 22 + (26 - 22) * u
local bx2, by2 = 39 + (82 - 39) * u, 78 + (82 - 78) * u
return fx + fw * (tx + (bx2 - tx) * v) / 128, fy + fh * (ty + (by2 - ty) * v) / 128
end
local function EQ(u0, v0, u1, v1)
local a1, b1 = E(u0, v0); local a2, b2 = E(u1, v0); local a3, b3 = E(u1, v1); local a4, b4 = E(u0, v1)
return a1, b1, a2, b2, a3, b3, a4, b4
end
if it.got then
local q1, q2, q3, q4, q5, q6, q7, q8 = EQ(0, 0, 1, 1)
smudge.fill_quad(q1, q2, q3, q4, q5, q6, q7, q8, false, card_tk())
local a1, b1, a2, b2, a3, b3, a4, b4 = EQ(0.08, 0.06, 0.92, 0.72)
smudge.draw_sprite_quad(string.format("art/s%02d.raw", it.c - 1), 96, 96, a1, b1, a2, b2, a3, b3, a4, b4)
else
local a1, b1, a2, b2, a3, b3, a4, b4 = EQ(0, 0, 1, 1)
smudge.draw_sprite_quad("art/card_back.raw", 192, 256, a1, b1, a2, b2, a3, b3, a4, b4)
end
top = fy
elseif it.kind == "sec" then
local _, py = spr("tp1", 128, 128, 120, 120)
local _, ty = spr((it.got and "lm" or "lm") .. it.k .. (it.got and "" or "_n"), 96, 96, 96, 96, 92)
top = ty
elseif it.kind == "drop" then
local fx, fy, fw, fh = spr("tp2", 128, 128, 120, 150)
if it.id then
local iw = fw * 0.42
local ix, iy = fx + fw / 2 - iw / 2, fy + fh * 0.32
local p = "art/it_" .. it.id
smudge.draw_sprite_quad(p .. ".raw", 24, 24, ix, iy, ix + iw, iy, ix + iw, iy + iw, ix, iy + iw, p .. "_m.raw")
end
top = fy
elseif it.kind == "cup" then
local _, cy2 = spr("tp3", 128, 128, 110, 100)
local _, ty = spr("tp" .. (4 + it.t), 128, 128, 100, 100, 74)
top = ty
else
local _, ty = spr("tp8", 128, 128, 150, 150)
top = ty
end
if not it.got and smudge.shade_quad then
local w2 = 80 * k
smudge.shade_quad(bx - w2 / 2, top, bx + w2 / 2, top, bx + w2 / 2, by, bx - w2 / 2, by, 0)
local lx, ly = math.floor(bx), math.floor((top + by) / 2)
smudge.rounded_rect(lx - 12, ly - 4, 24, 20, 4, true); smudge.circle(lx, ly - 8, 7, false, 3)
smudge.rect(lx - 1, ly + 3, 3, 7, true, 1, false)
end
local d2 = math.abs(x - TR.cx)
if d2 < pd then pd = d2; pick = { it = it, x = x, i = i } end
reg("TROPHY" .. i, math.floor(bx - 40 * k), math.floor(top), math.floor(80 * k), math.floor(by - top), function() TR.tx = x end, true)
end
end
if smudge.set_clip then smudge.set_clip() end
if pick then
local it = pick.it
local py = y0 + h0 + 10
ctext(W / 2, py, it.name .. (it.got and "" or "  (locked)"), "ui12", "bold")
wrapped(30, py + 36, it.got and "In your collection." or it.how, W - 60, "small", 3)
end
ctext(W / 2, y0 + h0 - 26, "drag to walk along the hall", "small")
draw_note(H - 134)
button(24, H - 96, W - 48, 64, "BACK", function() go(TR.ret or "title"); TR.ret = nil end, { font = "ui10" })
end
SCREENS.stats = function()
top_bar("Statistics", "")
local y = TOP + 6
local rows = {
{ "Packs opened", S.packs }, { "Cards found", found_count() .. " / " .. D.ncards },
{ "Spare copies", spare_total() }, { "Shiny cards", shiny_count() },
{ "Sets complete", sets_done() .. " / 14" }, { "Evolutions", S.evolved },
{ "Battles won", S.wins }, { "Quest stage", S.stage }, { "Tower floor", S.tower },
{ "Coins earned", S.earned }, { "Coins now", S.coins }, { "Dust", S.dust },
}
for i, r in ipairs(rows) do
ltext(32, y + (i - 1) * 28, r[1], "ui10")
rtext(W - 32, y + (i - 1) * 28, tostring(r[2]), "ui10", "bold")
smudge.line(24, y + (i - 1) * 28 + 25, W - 24, y + (i - 1) * 28 + 25, 1)
end
local ry = y + 12 * 28 + 4
ctext(W / 2, ry, "Rank: " .. D.ranks[math.min(5, found_count() // 8 + 1)], "ui12", "bold")
for t = 0, 5 do
local n, tot = GRID.count(t)
ltext(32, ry + 34 + t * 22, D.tiers[t + 1], "small")
bar(160, ry + 34 + t * 22, 290, 16, n / tot)
end
button(24, H - 172, W - 48, 64, "CAMP & ADVENTURE", function() go("hiscores") end, { font = "ui10", sub = "skills, bosses, quests, clues...", id = "HISCORES" })
button(24, H - 248, W - 48, 64, "TROPHY ROOM", function() TR.ret = "stats"; go("trophies") end, { font = "ui10", sub = "everything you've collected, on show", id = "TROPHIES" })
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
SCREENS.elempack = function()
top_bar("Element Pack", "")
ctext(W / 2, TOP + 4, "3 cards, all of one element. 70 coins.", "ui10")
ctext(W / 2, TOP + 30, "Last card is still uncommon or better.", "small")
for e = 1, 8 do
local col, row = (e - 1) % 2, (e - 1) // 2
button(24 + col * 222, TOP + 62 + row * 94, 210, 86, D.elems[e], function() open_pack(false, false, e) end,
{ sub = "70 coins", off = S.coins < 70, id = "EP" .. e })
chip(24 + col * 222 + 30, TOP + 62 + row * 94 + 43, e)
end
res_bar(TOP + 62 + 4 * 94 + 4)
draw_note(TOP + 62 + 4 * 94 + 40)
button(24, H - 96, W - 48, 64, "BACK", function() go("packs") end, { font = "ui10" })
end
SCREENS.deck = function()
top_bar("Deck & Sets", "")
ctext(W / 2, TOP + 4, "Your team of three", "ui12", "bold")
for i = 1, 3 do
local x = 12 + (i - 1) * 156
local c = S.deck[i]
if c ~= 0 and owned(c) then thumb(x + 24, TOP + 44, c, { name = true })
else
smudge.rounded_rect(x + 24, TOP + 44, 108, 108, 8, false, 2)
ctext(x + 78, TOP + 84, "EMPTY", "small", "bold")
end
reg("slot" .. i, x + 24, TOP + 44, 108, 130, function() dslot = i; album_mode = "deck"; page = 0; go("album") end, true)
end
local y = TOP + 196
wrapped(30, y, "Team spirit: a fighter in the deck gets +1 ATK and +2 HP for every other card in the deck.", W - 60, "ui10", 3)
local ts = 0
for t = 0, 5 do if tier_done(t) then ts = ts + 1 end end
ltext(30, y + 84, string.format("Set bonus now: +%d ATK, +%d HP on all cards", ts, ts * 2), "small", "bold")
local ec = 0
for e = 1, 8 do if elem_done(e) then ec = ec + 1 end end
ltext(30, y + 108, string.format("Element lines done: %d (+2 ATK for that element)", ec), "small")
button(24, y + 140, W - 48, 74, "SETS", function() go("sets") end, { sub = sets_done() .. " / 14 complete", font = "ui10" })
button(24, y + 224, W - 48, 56, "CLEAR DECK", function() S.deck = { 0, 0, 0 }; save_now(); note = "Deck cleared." end, { font = "ui10" })
draw_note(y + 288)
button(24, H - 96, W - 48, 64, "BACK", function() go("title") end, { font = "ui10" })
end
local spage = 0
local SET_DUST = { 20, 40, 60, 100, 150, 200 }
local function set_def(i)
if i <= 6 then
local n = 0
for k = 1, 8 do if S.lvl[(i - 1) * 8 + k] > 0 then n = n + 1 end end
return D.tiers[i] .. " set", n, 8, SET_DUST[i] .. " dust", function() add_dust(SET_DUST[i]) end
end
local e = i - 6
local n = 0
for t = 0, 5 do if S.lvl[t * 8 + e] > 0 then n = n + 1 end end
return D.elems[e] .. " line", n, 5, "30 dust + 100 coins", function() add_dust(30); add_coins(100) end
end
SCREENS.sets = function()
top_bar("Sets", sets_done() .. " / 14")
local per = 5
local pages = 3
if spage >= pages then spage = pages - 1 end
local function srow(i, k, by)
if i <= 14 then
local name, n, tot, rw, give = set_def(i)
local done = (S.setmask >> (i - 1)) & 1 == 1
smudge.rounded_rect(20, by, W - 40, 92, 10, true, 1, false)
smudge.rounded_rect(20, by, W - 40, 92, 10, false, 2)
ltext(34, by + 6, name, "ui10", "bold")
ltext(34, by + 34, "Reward: " .. rw, "small")
bar(34, by + 62, 200, 16, n / tot)
ltext(244, by + 62, n .. "/" .. tot, "small")
button(W - 24 - 130, by + 10, 120, 72, done and "DONE" or "CLAIM", function()
if (S.setmask >> (i - 1)) & 1 == 1 then return end
if n < tot then note = "Collect them all first."; return end
S.setmask = S.setmask | (1 << (i - 1)); give(); note = name .. " claimed!"; save_now()
end, { font = "small", off = done or n < tot, id = "SET" .. k })
end
end
local ny = TOP + 6 + per * 100 + 4
if not scroll_list("sets", TOP + 6, nil, 14, 100, function(i, by) srow(i, i, by) end) then
for k = 1, per do srow(spage * per + k, k, TOP + 6 + (k - 1) * 100) end
button(24, ny, 140, 46, "PREV", function() if spage > 0 then spage = spage - 1 end end, { font = "ui10", off = spage == 0, id = "PREV" })
ctext(W / 2, ny + 12, (spage + 1) .. " / " .. pages, "ui10")
button(W - 24 - 140, ny, 140, 46, "NEXT", function() if spage < pages - 1 then spage = spage + 1 end end, { font = "ui10", off = spage >= pages - 1, id = "NEXT" })
end
draw_note(ny + 52)
button(24, H - 96, W - 48, 64, "BACK", function() go("deck") end, { font = "ui10" })
end
local function save_opt() smudge.save("opt", SAVER and "1" or "0") end
GAME_VERSION = "6.10.98"
SCREENS.customtheme = function()
top_bar("Custom theme", "make it yours")
local y = TOP + 22
ltext(32, y, "Pick a colour and a ground. Changes show right away.", "small")
smudge.rounded_rect(24, y + 30, W - 48, 104, 10, true, 1, false)
smudge.rounded_rect(24, y + 30, W - 48, 104, 10, false, 2)
ltext(42, y + 42, "COLOUR", "ui10", "bold")
ctext(W / 2, y + 73, CT.accents[CT.accent][1], "ui12", "bold")
local function set(v) CT.accent = v; smudge.save("customaccent", tostring(v)); theme_i = CT.custom; smudge.save("style", "custom"); apply_theme() end
button(38, y + 92, 104, 34, "PREV", function() set(CT.accent == 1 and #CT.accents or CT.accent - 1) end, { font = "small", id = "CUSTOMACCENTPREV" })
button(W - 142, y + 92, 104, 34, "NEXT", function() set(CT.accent % #CT.accents + 1) end, { font = "small", id = "CUSTOMACCENTNEXT" })
local hw = (W - 48 - 12) // 2
for k, nm in ipairs({ "DARK GROUND", "LIGHT GROUND" }) do
button(24 + (k - 1) * (hw + 12), y + 150, hw, 56, nm, function()
CT.ground = k; smudge.save("customground", tostring(k)); theme_i = CT.custom; smudge.save("style", "custom"); apply_theme()
end, { font = "ui10", active = (CT.ground or 1) == k, id = "CUSTOMGROUND" .. k })
end
thumb(W // 2 - 54, y + 226, 20, { show = true, name = false })
if smudge.glass_sprite_quad then
button(24, y + 350, W - 48, 64, "EVERY COLOUR", function() theme_i = CT.custom; smudge.save("style", "custom"); apply_theme(); CT.sel = CT.sel or 1; go("customcolors") end,
{ font = "ui10", sub = "background, text, buttons, bars, cards... one by one", id = "CUSTOMEVERY" })
end
button(24, H - 96, W - 48, 64, "DONE", function() theme_i = CT.custom; smudge.save("style", "custom"); apply_theme(); go("settings") end, { font = "ui10", id = "CUSTOMDONE" })
end
function CT.swatch(x, y, w, h, hex)
smudge.rounded_rect(x - 1, y - 1, w + 2, h + 2, 5, false, 1)
smudge.glass_sprite_quad("art/one_m.raw", 8, 8, x, y, x + w, y, x + w, y + h, x, y + h, hex >> 16, (hex >> 8) & 255, hex & 255, 1)
end
SCREENS.customcolors = function()
top_bar("Every colour", "custom theme")
local y = TOP + 8
local cols = CT.now or {}
local sel = CT.sel or 1
local px, pw = 24, W - 48
local cw = pw // 8
local prow = 30
local py = H - 96 - 14 - 6 * (prow + 4) - 30
local lh0 = py - 10 - y
local rh = 38
local function row(i, ry)
local sl = CT.SLOTS[i]
local hex = (cols[sl[1]] or {})[sl[2]] or 0x808080
local on = i == sel
button(24, ry, W - 48, rh - 4, "", function() CT.sel = i end, { id = "CSLOT" .. i })
ltext(40, ry + (rh - 4 - lh("small")) // 2, (on and "> " or "") .. sl[3] .. (CT.over[sl[1] .. sl[2]] and "  *" or ""), "small", "bold")
CT.swatch(W - 24 - 70, ry + 7, 54, rh - 18, hex)
end
if not scroll_list("customcolors", y, lh0, #CT.SLOTS, rh, row) then
local per = math.max(1, lh0 // rh)
local p0 = ((CT.cpage or 0) * per) % #CT.SLOTS
for i = p0 + 1, math.min(#CT.SLOTS, p0 + per) do row(i, y + (i - p0 - 1) * rh) end
end
local sl = CT.SLOTS[sel]
ltext(24, py, "Colour for: " .. sl[3], "small", "bold")
for k, hex in ipairs(CT.PAL) do
local c, r = (k - 1) % 8, (k - 1) // 8
local x, yy = px + c * cw + 2, py + 24 + r * (prow + 4)
CT.swatch(x, yy, cw - 4, prow, hex)
reg("CPAL" .. k, x, yy, cw - 4, prow, function()
CT.over[sl[1] .. sl[2]] = hex; CT.save_over(); theme_i = CT.custom; smudge.save("style", "custom"); apply_theme()
end, false)
end
local bw = (W - 48 - 16) // 3
button(24, H - 96, bw, 64, "RESET ONE", function()
CT.over[sl[1] .. sl[2]] = nil; CT.save_over(); apply_theme()
end, { font = "small", off = CT.over[sl[1] .. sl[2]] == nil, id = "CRESET1" })
button(32 + bw, H - 96, bw, 64, "RESET ALL", function() CT.over = {}; CT.save_over(); apply_theme(); note = "Back to your colour and ground." end,
{ font = "small", off = next(CT.over) == nil, id = "CRESETALL" })
button(40 + 2 * bw, H - 96, bw, 64, "DONE", function() go("customtheme") end, { font = "ui10", id = "CDONE" })
end
SCREENS.vibes = function()
top_bar("Vibration lab", "pack opening")
local y = TOP + 8
if not smudge.vibrate then
wrapped(30, y + 20, "Vibrations need the newest phone app (it can't vibrate yet). Install the app update, then come back here.", W - 60, "ui10", 4)
button(24, H - 96, W - 48, 64, "BACK", function() go("settings") end, { font = "ui10" })
return
end
button(24, y, W - 48, 56, VIB.on and "IN PACK OPENING: ON" or "IN PACK OPENING: OFF", function()
VIB.on = not VIB.on; VIB.save(); note = VIB.on and "Packs vibrate now when they open." or "Packs open without vibrating."
end, { font = "ui10", active = VIB.on, sub = VIB.on and "tap to switch off" or "test them first, then switch on", id = "VIBON" })
local sw = (W - 48 - 16) // 3
for k = 1, 3 do
button(24 + (k - 1) * (sw + 8), y + 66, sw, 44, VIB.SN[k], function() VIB.str = k; VIB.save(); VIB.play("t3", true) end,
{ font = "small", active = VIB.str == k, id = "VIBSTR" .. k })
end
local ry = y + 122
local rh = math.min(58, (H - 96 - 70 - ry) // #VIB.EV)
for i, e in ipairs(VIB.EV) do
local yy = ry + (i - 1) * rh
local L = VIB.len[e[1]] or 100
ltext(26, yy + (rh - 8 - lh("small")) // 2, fit(e[2], 150, "small", "bold"), "small", "bold")
button(176, yy, 84, rh - 8, "TEST", function() VIB.play(e[1], true) end, { font = "small", off = L <= 0, id = "VIBT" .. i })
button(270, yy, 52, rh - 8, "-", function()
VIB.len[e[1]] = (L <= 50) and 0 or (L - 25); VIB.save(); VIB.play(e[1], true)
end, { font = "ui10", off = L <= 0, id = "VIBM" .. i })
ctext(362, yy + (rh - 8 - lh("small")) // 2, (L <= 0) and "OFF" or (L .. "%"), "small", "bold")
button(404, yy, 52, rh - 8, "+", function()
VIB.len[e[1]] = (L <= 0) and 50 or math.min(200, L + 25); VIB.save(); VIB.play(e[1], true)
end, { font = "ui10", off = L >= 200, id = "VIBP" .. i })
end
local py = ry + #VIB.EV * rh + 4
button(24, py, W - 48, 56, "PLAY A WHOLE PACK", function()
VIB.play("tear", true)
local seq = { { 1100, "flip" }, { 1600, "t1" }, { 1900, "flip" }, { 2400, "t2" }, { 2700, "flip" }, { 3500, "t4" } }
local t0 = smudge.millis()
VIB.q = {}
for _, s2 in ipairs(seq) do VIB.q[#VIB.q + 1] = { t0 + s2[1], s2[2] } end
end, { font = "ui10", sub = "tear, three cards, an exotic last", id = "VIBPACK" })
draw_note(py + 64)
button(24, H - 96, W - 48, 64, "BACK", function() go("settings") end, { font = "ui10" })
end
SCREENS.settings = function()
top_bar("Settings", "v" .. GAME_VERSION .. (smudge.app and " app" or ""))
local y = TOP + 8
local low = 0
if not SAVER then smudge.rounded_rect(24 + 3, y + 4, W - 48, 112, 10, true) end
smudge.rounded_rect(24, y, W - 48, 112, 10, true, 1, false)
smudge.rounded_rect(24, y, W - 48, 112, 10, false, 2)
ltext(44, y + 14, "Battery saver", "ui12", "bold")
ltext(44, y + 50, "Light mode: no animations,", "small")
ltext(44, y + 74, "no shadows, fewer refreshes.", "small")
local sx, sy, sw, sh = W - 24 - 24 - 104, y + 30, 104, 52
smudge.rounded_rect(sx, sy, sw, sh, 26, SAVER, 3, true)
if SAVER then
smudge.circle(sx + sw - 26, sy + sh // 2, 18, true, 1, false)
ctext(sx + 30, sy + (sh - lh("small")) // 2, "ON", "small", "bold", true)
else
smudge.circle(sx + 26, sy + sh // 2, 18, true)
ctext(sx + sw - 30, sy + (sh - lh("small")) // 2, "OFF", "small", "bold")
end
reg("SAVER", 24, y, W - 48, 112, function() SAVER = not SAVER; save_opt(); note = SAVER and "Battery saver is ON." or "Battery saver is OFF." end, false)
local hw2 = (W - 48 - 12) // 2
button(24, y + 124, hw2, 60, CLEAN and "CLEANUP: ON" or "CLEANUP: OFF",
function() CLEAN = not CLEAN; smudge.save("clean", CLEAN and "1" or "0"); apply_clean(); note = CLEAN and "A black clean-up flash every 40 screens removes ghosting." or "No more black clean-up flashes." end,
{ font = "ui10", sub = "flash every 40 screens", active = CLEAN, id = "CLEAN" })
button(36 + hw2, y + 124, hw2, 60, "STYLE: " .. THEMES[theme_i][2],
function()
if smudge.set_tint then theme_i = theme_i % #THEMES + 1
else theme_i = (theme_i == CT.classic) and 1 or CT.classic end
smudge.save("style", THEMES[theme_i][1]); apply_theme()
note = THEMES[theme_i][3] and (smudge.tint and "Style: " .. THEMES[theme_i][2] .. ". Tap again for the next one." or "Stone look (the colours show in the phone app).") or "Classic look: white and clean."
end, { font = "ui10", sub = "tap for the next", id = "STYLE" })
local ly = y + 196
if CS_SMOOTH then
button(24, ly, hw2, 60, FX_GLINT and "GLINT: ON" or "GLINT: OFF",
function() FX_GLINT = not FX_GLINT; smudge.save("fxglint", FX_GLINT and "1" or "0"); note = FX_GLINT and "A glint of light runs over the buttons now and then." or "No more glint over the buttons." end,
{ font = "ui10", sub = "light over buttons", active = FX_GLINT, id = "FXGLINT" })
button(36 + hw2, ly, hw2, 60, FX_RIP and "RIPPLE: ON" or "RIPPLE: OFF",
function() FX_RIP = not FX_RIP; smudge.save("fxrip", FX_RIP and "1" or "0"); note = FX_RIP and "A ripple spreads where you tap a button." or "No more ripple when you tap." end,
{ font = "ui10", sub = "ring where you tap", active = FX_RIP, id = "FXRIP" })
local cw = smudge.vibrate and hw2 or (W - 48)
button(24, ly + 72, cw, 52, "CUSTOMIZE THEME", function() theme_i = CT.custom; apply_theme(); go("customtheme") end,
{ font = "ui10", sub = smudge.vibrate and "your own colour" or "pick your own colour", id = "CUSTOMTHEME" })
if smudge.vibrate then
button(36 + hw2, ly + 72, hw2, 52, "VIBRATIONS", function() VIB.load(); go("vibes") end,
{ font = "ui10", sub = VIB.on and "on in packs" or "test and tune", id = "VIBES" })
end
if smudge.music then
button(24, ly + 136, hw2, 56, SND.music and "MUSIC: ON" or "MUSIC: OFF", function()
SND.music = not SND.music; smudge.save("music", SND.music and "1" or "0"); SND.apply()
note = SND.music and "Calm music plays in the background." or "No music."
end, { font = "ui10", sub = "calm background loop", active = SND.music, id = "MUSIC" })
button(36 + hw2, ly + 136, hw2, 56, SND.sfx and "SOUNDS: ON" or "SOUNDS: OFF", function()
SND.sfx = not SND.sfx; smudge.save("sfx", SND.sfx and "1" or "0"); if SND.sfx then SND.play("secret", 0.6) end
note = SND.sfx and "Sound effects are on (like a secret card's sound)." or "No sound effects."
end, { font = "ui10", sub = "effects, e.g. secret cards", active = SND.sfx, id = "SOUNDS" })
end
local sy2 = ly + (smudge.music and 200 or 136)
button(24, sy2, hw2, 56, "WEATHER: " .. SNOW.label(), function() go("snowfx") end,
{ font = "ui10", sub = "type, speed, density, size", active = SNOW.on, id = "SNOW" })
if smudge.glow_circle then
if GFX.fl_on == nil then GFX.fl_on = smudge.load("fingl", "1") ~= "0" end
button(36 + hw2, sy2, hw2, 56, GFX.fl_on and "FINGER LIGHT: ON" or "FINGER LIGHT: OFF", function()
GFX.fl_on = not GFX.fl_on; smudge.save("fingl", GFX.fl_on and "1" or "0"); GFX.fing = nil
end, { font = "ui10", sub = "a glow where you touch", active = GFX.fl_on, id = "FINGERLIGHT" })
end
low = sy2 + 56
draw_note(sy2 + 64)
else
ltext(32, ly, "What battery saver changes", "ui10", "bold")
local items = {
"Pack opening and card outlines stand still.",
"Card effects stand still.",
"No drop shadows, so screens draw faster.",
"Enemy answers instantly in battles.",
"Camp timers stop refreshing the screen.",
}
for i, t in ipairs(items) do ltext(40, ly + 30 + (i - 1) * 26, "- " .. fit(t, W - 90, "small", "regular"), "small") end
draw_note(ly + 160)
end
local sy3 = math.max(H - 366, low + 10)
local by = math.max(H - 270, sy3 + 86)
local rh = math.max(44, math.min(64, H - 100 - by - 26))
if smudge.frame_ms and not CS_SMOOTH then
local d, r = smudge.frame_ms()
if d and r and (d > 0 or r > 0) then ctext(W / 2, by - 38, string.format("Last screen: drawing %d ms, e-ink %d ms", d, r), "small") end
end
smudge.line(24, by - 10, W - 24, by - 10, 1)
ctext(W / 2, by, "Danger zone", "small")
button(24, by + 26, W - 48, rh, confirm_reset and "TAP AGAIN TO ERASE EVERYTHING" or "RESET PROGRESS",
function()
if confirm_reset then
S = new_state(); C.reset_act(); PE = nil; save_now(); confirm_reset = false; note = "Progress erased."
else confirm_reset = true; note = "This erases cards, coins and the camp." end
end, { font = "ui10", off = true })
local hw = (W - 48 - 12) // 2
local cloud = (not smudge.app) and smudge.cloud_sync
local bw = cloud and (W - 48 - 24) // 3 or hw
if smudge.app then
button(24, sy3, bw, 60, "SYNC WITH READER", function() save_now(); smudge.sync() end,
{ font = "small", sub = "copy your progress", id = "SYNC" })
else
button(24, sy3, bw, 60, confirm_phone and "TAP TO START" or (cloud and "WI-FI SYNC" or "SYNC WITH PHONE"),
function()
if not smudge.phone_play then
note = "Install the new CardScape firmware to sync with the phone app."
elseif confirm_phone then
confirm_phone = false; save_now(); smudge.phone_play()
else
confirm_phone = true
note = "Opens Wi-Fi. Then tap SYNC in the CardScape app on your phone. The reader restarts when it's done."
end
end, { font = "small", sub = "with the app", active = confirm_phone, id = "SYNC" })
end
if cloud then
button(24 + bw + 12, sy3, bw, 60, "CLOUD SYNC", function() confirm_phone = false; save_now(); smudge.cloud_sync() end,
{ font = "small", sub = "now", id = "CLOUDNOW" })
local st = smudge.cloud_status and smudge.cloud_status()
local head, line, full = "Cloud sync", "never ran on this reader yet", nil
if st then
local t, when, res = st:match("^(%-?%d+)\t([^\t]*)\t([^\n]*)")
if res then
res = res:gsub("^cloud: ", "")
local ago = ""
local now = tonumber(smudge.time and smudge.time() or 0) or 0
t = tonumber(t) or 0
if t > 1600000000 and now >= t then
local d = now - t
ago = d < 60 and "just now" or (d < 3600 and (d // 60) .. " min ago" or (d < 86400 and (d // 3600) .. " h ago" or (d // 86400) .. " d ago"))
end
local wn = ({ start = "at start", quit = "at quit", sleep = "at sleep", button = "now" })[when] or when
head = "Cloud sync " .. wn .. (ago ~= "" and (", " .. ago) or "")
line = res
full = head .. ": " .. res
end
end
ctext(W / 2, H - 170, head, "small", "bold")
ctext(W / 2, H - 146, fit(line, W - 48, "small", "regular"), "small")
reg("CLOUDSTAT", 24, H - 174, W - 48, 54, function() note = full or (head .. ": " .. line) end, false)
end
button(24 + (cloud and 2 * (bw + 12) or (hw + 12)), sy3, bw, 60, "QUIT GAME", function() save_now(); smudge.exit() end,
{ font = cloud and "small" or "ui10", sub = cloud and "saves first" or "progress is saved", id = "QUIT" })
button(24, H - 96, W - 48, 64, "BACK", function() confirm_phone = false; go("title") end, { font = "ui10" })
end
SCREENS.camp = function() C.draw_camp(S) end
SCREENS.missions = function() C.draw_missions(S) end
SCREENS.skills = function() C.draw_skills(S) end
SCREENS.skill = function() C.draw_skill(S) end
SCREENS.bank = function() C.draw_bank(S) end
SCREENS.daily = function() C.draw_daily(S) end
SCREENS.expedition = function() C.draw_expedition(S) end
SCREENS.expsend = function() C.draw_expsend(S) end
SCREENS.cardpick = function() C.draw_cardpick(S) end
SCREENS.training = function() C.draw_training(S) end
SCREENS.achieve = function() C.draw_achieve(S) end
SCREENS.gear = function() C.draw_gear(S) end
SCREENS.shop = function() C.draw_shop(S) end
SCREENS.pet = function() C.draw_pet(S) end
SCREENS.tasks = function() C.draw_tasks(S) end
SCREENS.market = function() C.draw_market(S) end
SCREENS.mktitem = function() C.draw_mktitem(S) end
go = function(name)
if name ~= "reveal" then AUTO.open = false end
if name == "album" and scr ~= "album" and BIND.on() then BIND.open_t = 0; BIND.mode = "spread"; BIND.cturn = nil end
if name ~= scr and GFX then GFX.fx("swipe", (name == "title" or GFX.back) and -1 or 1) end
if GFX then GFX.back = nil end
scr = name; focus = 1; note = ""; confirm_reset = false
help_open = false
if C and C.close_qinv then C.close_qinv() end
if C then C.on_nav(); C.toast_off(); C.seen(name); if C.close_drop then C.close_drop() end; if C.wiki_close then C.wiki_close() end end
loop_on = false
if name == "detail" then aura_start() end
redraw()
end
local function go_back()
GFX.back = true
if scr == "title" then
elseif scr == "inspect" then go("detail")
elseif scr == "battle" and B and not B.over then
if not B.busy then
if B.retreat then B.over = true; B.win = false; B.reward = 0; B.fled = true; blog("You retreated.")
else B.retreat = true; note = "Press again to retreat from the fight." end
end
else
if scr == "battle" then B = nil end
if scr == "reveal" then timer_fn = nil; RV = nil end
PE = (scr == "quest") and nil or PE
go("title")
end
redraw()
end
local function go_home()
help_open = false
if C and C.close_qinv then C.close_qinv() end
if C and C.close_drop then C.close_drop() end
use_focus = false
if scr == "battle" and B and not B.over then go_back(); return end
if scr ~= "title" then
if scr == "battle" then B = nil end
if scr == "reveal" then timer_fn = nil; RV = nil end
PE = (scr == "quest") and nil or PE
go("title")
end
redraw()
end
function on_init()
if smudge.get_bounds then W, H = smudge.get_bounds() end
CS_SMOOTH = smudge.smooth == true
if smudge.get_metrics then
local m = smudge.get_metrics()
if m then TOP = (m.top_padding or 4) + BAR_H + 10 end
end
math.randomseed(os.time())
if smudge.set_clip then
local ok, f = pcall(dofile, "scroll.lua")
if ok and type(f) == "function" then PH = f({ millis = smudge.millis, clip = clip, press = press, smooth = function() return CS_SMOOTH and not SAVER end }) end
end
C = dofile("camp.lua")(camp_ctx())
for _, n in ipairs(C.adv_screens) do SCREENS[n] = function() C["draw_" .. n](S) end end
C.load_notes()
local last = tonumber((smudge.load("stamp", "") or ""):match("^(%d+)"))
S = load_state()
DX.load()
EVO.load()
SAVER = (smudge.load("opt", "0") == "1")
local st = smudge.load("style", "stone")
CT.bg = math.max(1, math.min(#CT.bases, tonumber(smudge.load("custombg", "1")) or 1))
CT.accent = math.max(1, math.min(#CT.accents, tonumber(smudge.load("customaccent", "1")) or 1))
CT.card = math.max(1, math.min(#CT.cards, tonumber(smudge.load("customcard", "1")) or 1))
CT.ground = (smudge.load("customground", "1") == "2") and 2 or 1
theme_i = 1
if smudge.night_was and smudge.night_was() then st = "dark"; smudge.save("style", "dark") end
for i, t in ipairs(THEMES) do if t[1] == st then theme_i = i end end
apply_theme()
load_show()
CLEAN = (smudge.load("clean", "0") == "1"); apply_clean()
FX_GLINT = smudge.load("fxglint", "1") ~= "0"; FX_RIP = smudge.load("fxrip", "1") ~= "0"
SNOW.load()
SND.load(); SND.apply()
AUTO.load()
scr = "title"
local fx = camp_ctx()
fx.S = function() return S end
fx.tilt = function(...) if V3.ok() and not SAVER then return V3.tilt_get(...) end end
fx.cnum = C.cnum; fx.item_name = C.item_name; fx.nitems = function() return #C._data.ITEMS end
fx.bank_cap = C.bank_cap; fx.iron_block = function(w) return C.iron_block(w) end
fx.notes_since = function(t) return C.notes_since(S, t) end
fx.food_in_bank = function()
local IT, best = C._data.ITEMS, nil
for i = 1, #IT do if IT[i][5] == "i_food" and S.camp.inv[i] > 0 and (not best or IT[i][2] < IT[best][2]) then best = i end end
return best
end
F = dofile("friends.lua")(fx)
GR = dofile("grade.lua")(fx)
C.gift_item = F.gift_item
SCREENS.friends = F.draw_friends; SCREENS.codeentry = F.draw_entry; SCREENS.duel = F.draw_duel; SCREENS.away = F.draw_away; SCREENS.frames = GR.draw; SCREENS.grading = GR.draw; SCREENS.ourpet = F.draw_pet_shared
if F.check_away(last) then scr = "away" end
local lastver = smudge.load("lastver", "")
if lastver ~= GAME_VERSION then
smudge.save("lastver", GAME_VERSION)
if lastver ~= "" then note = "CardScape updated to v" .. GAME_VERSION .. "!" end
end
end
local HELP
local function help_text()
if not HELP then HELP = dofile("help.lua") end
if scr == "skill" and C and C.cur_skill then
local si = C.cur_skill()
local sk = C.skill_name and C.skill_name(si) or "Skill"
return sk, HELP.SKILL[si] or ""
end
local h = HELP.H[scr]
if h then return h[1], h[2] end
return "Help", "Tap the buttons to explore this screen. BACK returns to the previous screen."
end
local function draw_help_button()
if scr == "wilds" and CS_SMOOTH then return end
local y = H - 96
if STONE or CS_SMOOTH then
button(HELP_X, y, HELP_W, 64, "?", function() help_open = not help_open end, { font = "bitter14", nohelp = true, active = help_open, id = "HELP" })
return
end
if not SAVER then smudge.rounded_rect(HELP_X + 4, y + 5, HELP_W, 64, 10, true) end
smudge.rounded_rect(HELP_X, y, HELP_W, 64, 10, true, 1, false)
smudge.rounded_rect(HELP_X, y, HELP_W, 64, 10, false, 2)
if help_open then smudge.rounded_rect(HELP_X + 5, y + 5, HELP_W - 10, 54, 7, false, 1) end
ctext(HELP_X + HELP_W // 2, y + 32 - lh("bitter14") // 2, "?", "bitter14", "bold")
reg("HELP", HELP_X, y, HELP_W, 64, function() help_open = not help_open end, false)
end
local function draw_help()
if not help_open then return end
local t, body = help_text()
local x0, y0, w = 16, bar_pad() + BAR_H + 10, W - 32
local h = H - 112 - y0
reg("HELPCLOSE", 0, 0, W, H, function() help_open = false end)
if not SAVER then smudge.rounded_rect(x0 + 6, y0 + 6, w, h, 14, true) end
GLASS_CUT(x0, y0, w + 8, h + 8)
smudge.rounded_rect(x0, y0, w, h, 14, true, 1, false)
smudge.rounded_rect(x0, y0, w, h, 14, false, 3)
smudge.circle(x0 + 30, y0 + 30, 16, true)
ctext(x0 + 30, y0 + 30 - lh("ui12") // 2, "?", "ui12", "bold", true)
ltext(x0 + 56, y0 + 16, fit(t, w - 70, "ui12", "bold"), "ui12", "bold")
smudge.line(x0 + 14, y0 + 56, x0 + w - 14, y0 + 56, 2)
if C and C.wiki_open then
smudge.rounded_rect(x0 + 14, y0 + 66, w - 28, 44, 10, false, 2)
ltext(x0 + 28, y0 + 76, "Search items or monsters", "ui10")
smudge.circle(x0 + w - 44, y0 + 86, 9, false, 2); smudge.line(x0 + w - 37, y0 + 93, x0 + w - 30, y0 + 100, 3)
reg("HELPSEARCH", x0 + 14, y0 + 66, w - 28, 44, function() help_open = false; C.wiki_open() end, false)
end
local y = y0 + 124
for para in (body .. "\n"):gmatch("(.-)\n") do
if para ~= "" and y < y0 + h - 40 then
local res = smudge.wrapped_text(para, w - 36, "small", "regular", math.max(1, (y0 + h - 40 - y) // (lh("small") + 4)))
for _, line in ipairs(res.lines) do ltext(x0 + 18, y, line, "small"); y = y + lh("small") + 4 end
y = y + 8
end
end
ctext(W // 2, y0 + h - 30, "tap anywhere to close", "small")
end
GFX = { P = {}, tx = 0, ty = 0, on = false, seed = 12345, ember = 0, ptx = 0, pty = 0 }
GFX.TC = { [3] = { 255, 190, 40 }, [4] = { 175, 95, 255 }, [5] = { 255, 50, 70 }, [6] = { 255, 70, 190 } }
GFX.FOIL = { [3] = 1, [4] = 2, [5] = 3, [6] = 4 }
GFX.pops = {}
function GFX.frame()
GFX.back = nil
if GFX.on then GFX.mood() end
if smudge.tilt and CS_SMOOTH and not SAVER then
local a, b, on = smudge.tilt()
GFX.tx, GFX.ty, GFX.on = tonumber(a) or 0, tonumber(b) or 0, on ~= false
else GFX.on = false; GFX.tx, GFX.ty = 0, 0 end
end
function GFX.ok() return GFX.on and smudge.glow_circle ~= nil end
function GFX.sharp(c, ...)
if smudge.hires_quad and GFX.on and c and not (tier_of(c) == 5 and anim_v > 0) then
local nm = string.format("hd/l%02d.png", c - 1)
if tier_of(c) >= 2 then
local q = { ... }
local cx, cy = (q[1] + q[3] + q[5] + q[7]) / 4, (q[2] + q[4] + q[6] + q[8]) / 4
local sz = math.abs(q[3] - q[1]) + math.abs(q[4] - q[2])
local z = 1.08 + 0.012 * math.sin(smudge.millis() / 1300 + c)
local ox = -math.max(-1, math.min(1, GFX.tx)) * sz * 0.022
local oy = -math.max(-1, math.min(1, GFX.ty)) * sz * 0.022
local p = {}
for k = 0, 3 do p[2 * k + 1] = cx + (q[2 * k + 1] - cx) * z + ox; p[2 * k + 2] = cy + (q[2 * k + 2] - cy) * z + oy end
smudge.hires_quad(nm, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8])
GFX.live = true; GFX.holo = true
else smudge.hires_quad(nm, ...) end
end
end
function GFX.rnd() GFX.seed = (GFX.seed * 1103515245 + 12345) % 2147483648; return GFX.seed / 2147483648 end
function GFX.button(x, y, w, h, id, k)
if not GFX.ok() then return end
if k and k > 0.05 then
local a = 0.7 * k
smudge.glow_rect(x - 2, y - 2, w + 4, 4, 255, 236, 190, a); smudge.glow_rect(x - 2, y + h - 2, w + 4, 4, 255, 236, 190, a)
smudge.glow_rect(x - 2, y, 4, h, 255, 236, 190, a); smudge.glow_rect(x + w - 2, y, 4, h, 255, 236, 190, a)
end
end
function GFX.finger(ev, x, y)
if not GFX.on then return end
if x and y then GFX.tap = { x = x, y = y, t = smudge.millis() } end
if GFX.fl_on == nil then GFX.fl_on = smudge.load("fingl", "1") ~= "0" end
if not GFX.fl_on then GFX.fing = nil; return end
if ev == "down" or ev == "move" then GFX.fing = { x = x, y = y, up = nil }
elseif (ev == "up" or ev == "release") and GFX.fing then GFX.fing.up = smudge.millis(); GFX.fing.x = x or GFX.fing.x; GFX.fing.y = y or GFX.fing.y end
if x and y then GFX.tap = { x = x, y = y, t = smudge.millis() } end
end
GFX.GRADE = { { 103, 101, 96 }, { 100, 100, 100 }, { 106, 97, 88 }, { 90, 94, 108 } }
GFX.DAY = { { 0, 86, 92, 114 }, { 4.5, 88, 93, 112 }, { 6.5, 108, 97, 90 }, { 9, 102, 100, 97 }, { 12, 100, 100, 100 },
{ 16.5, 101, 100, 97 }, { 19.5, 112, 96, 84 }, { 21.5, 94, 94, 108 }, { 24, 86, 92, 114 } }
GFX.OUT = { title = true, camp = true, worldmap = true, adventure = true }
function GFX.daylight()
local ok, t = pcall(os.date, "*t", (smudge.time and tonumber(smudge.time())) or os.time())
if not ok then t = nil end
local h = (t and t.hour or 12) + (t and t.min or 0) / 60
local D = GFX.DAY
local a, b = D[1], D[#D]
for i = 1, #D - 1 do if h >= D[i][1] and h <= D[i + 1][1] then a, b = D[i], D[i + 1]; break end end
local u = (b[1] > a[1]) and (h - a[1]) / (b[1] - a[1]) or 0
u = u * u * (3 - 2 * u)
local k = GFX.OUT[scr] and 1 or 0.5
local g = {}
for j = 2, 4 do g[j - 1] = 100 + ((a[j] + (b[j] - a[j]) * u) - 100) * k end
return g
end
function GFX.mood()
local ph = 2
if C and C.sky then ph = C.sky() end
GFX.ph = ph
do
local g, c = GFX.daylight(), GFX.gc
if not c then c = { g[1], g[2], g[3] }; GFX.gc = c; GFX.gs = nil end
local moved = false
for j = 1, 3 do
local d = g[j] - c[j]
if math.abs(d) > 0.4 then c[j] = c[j] + d * 0.12; moved = true else c[j] = g[j] end
end
GFX.easing = moved
local key = string.format("%d,%d,%d", math.floor(c[1] + 0.5), math.floor(c[2] + 0.5), math.floor(c[3] + 0.5))
if key ~= GFX.gs and smudge.fx then GFX.gs = key; smudge.fx("grade", math.floor(c[1] + 0.5), math.floor(c[2] + 0.5), math.floor(c[3] + 0.5), 0, 0) end
end
local nm = THEMES[theme_i][1]
local amb = (nm == "stone") and 1 or ((nm == "retro") and 3 or ((CT.LIGHT[nm]) and 0 or 2))
if amb ~= GFX.amb then GFX.amb = amb; if smudge.fx then smudge.fx("amb", amb, 0, 0, 0, 0) end end
end
function GFX.home(y)
if not GFX.ok() then return end
local now = smudge.millis()
local t = now / 1000
local ph = GFX.ph or 2
if ph == 4 then
for i = 1, 26 do
local x, yy = (i * 137) % W, (i * 89) % math.floor(H * 0.7) + 20
local tw = 0.5 + 0.5 * math.sin(t * (0.8 + (i % 7) * 0.23) + i)
if tw > 0.35 then smudge.glow_circle(x, yy, 3, 220, 230, 255, 2.2 * tw) end
end
else
for i = 1, 4 do
local x = ((t * (4 + i)) + i * 160) % (W + 300) - 150
smudge.glow_circle(x, y + 40 + i * 70, 90 + i * 12, 255, 255, 255, 0.07)
end
end
local u = (now % 6000) / 1100
if u < 1 and smudge.tint then
local lw = smudge.text_width("CARDSCAPE", "bitter14", "bold")
local x0 = W // 2 - lw // 2
local bx = x0 - 24 + u * (lw + 48)
for k = 0, 7 do
local sy = y + k * 4
smudge.tint(math.floor(bx - k * 2), sy, 14, 4, (THEMES[theme_i][1] == "retro") and TT.prog or 4, 1)
end
GFX.sweeping = true
end
GFX.wx = true
end
function GFX.shadow(x, y, w, h, r, k)
if GFX.on and smudge.shadow_rect then smudge.shadow_rect(math.floor(x), math.floor(y), math.floor(w), math.floor(h), k or 0.6, r or 0) end
end
function GFX.fx(kind, a, b, c, d, e) if GFX.on and smudge.fx then smudge.fx(kind, a or 0, b or 0, c or 0, d or 0, e or 0) end end
function GFX.shake(px, ms) GFX.fx("shake", px, ms) end
function GFX.flash(r, g, b, ms, a) GFX.fx("flash", r, g, b, ms, a) end
function GFX.burst(x, y, n, col, speed, life, grav, size)
if not GFX.ok() then return end
local now = smudge.millis()
for _ = 1, n do
local a, sp = GFX.rnd() * 2 * math.pi, (0.35 + GFX.rnd() * 0.65) * (speed or 0.3)
GFX.P[#GFX.P + 1] = { x = x, y = y, vx = math.cos(a) * sp, vy = math.sin(a) * sp - 0.06, t0 = now,
life = (life or 900) * (0.6 + GFX.rnd() * 0.7), c = col, g = grav or 0.0005, r = (size or 3) * (0.6 + GFX.rnd() * 0.8) }
end
end
function GFX.busy()
return GFX.on and (#GFX.P > 0 or #GFX.pops > 0 or scr == "battle" or GFX.rolling or GFX.wx or GFX.fing ~= nil or GFX.sweeping
or #GFX.FL > 0 or #GFX.FLY > 0 or GFX.LU ~= nil or GFX.easing or GFX.barsOn)
end
function GFX.pop(x, y, txt, col)
if not GFX.ok() then return end
GFX.pops[#GFX.pops + 1] = { x = x, y = y, t0 = smudge.millis(), s = txt, c = col }
end
GFX.rv = {}
function ROLL(key, v, ix, iy, spr)
v = tonumber(v) or 0
local r = GFX.rv[key]
if not GFX.on or not r then GFX.rv[key] = { d = v, t = smudge.millis(), v = v }; return v end
local now = smudge.millis()
local dt = math.min(100, now - r.t); r.t = now
if ROLL_HOLD and (scr == "reel" or scr == "wheel") and ROLL_HOLD() then
r.seen = now; GFX.rolling = true; return math.floor(r.d + 0.5)
end
if ix and v > (r.v or v) and now - (r.seen or 0) < 400 then
GFX.gain(key, v - r.v, ix, iy, spr); r.hold = now + 520
end
if ix and r.v and v ~= r.v and now - (r.seen or 0) < 400 and GFX.ok() then
local d = v - r.v
GFX.pops[#GFX.pops + 1] = { x = ix + 44, y = iy + 30, rise = 10, t0 = now + (d > 0 and 520 or 0), s = (d > 0 and "+" or "-") .. short(math.abs(d)),
c = d > 0 and { 255, 210, 90 } or { 255, 90, 80 }, f = "ui10", life = 1300 }
end
r.v = v; r.seen = now
if ix then GFX.at = GFX.at or {}; GFX.at[key] = { ix, iy } end
if r.hold and now < r.hold then GFX.rolling = true; return math.floor(r.d + 0.5) end
if r.d ~= v then
local k = 1 - math.exp(-dt / 160)
local nd = r.d + (v - r.d) * k
if math.abs(v - nd) < 1 then nd = v end
r.d = nd
GFX.rolling = true
end
return math.floor(r.d + 0.5)
end
function GFX.draw()
if not GFX.ok() then GFX.P = {}; return end
local now = smudge.millis()
local dt = math.min(50, now - (GFX.last or now)); GFX.last = now
if scr == "battle" then
GFX.ember = GFX.ember + dt
while GFX.ember > 110 do
GFX.ember = GFX.ember - 110
if #GFX.P < 160 then
GFX.P[#GFX.P + 1] = { x = GFX.rnd() * W, y = H + 4, vx = (GFX.rnd() - 0.5) * 0.03, vy = -(0.035 + GFX.rnd() * 0.05), t0 = now,
life = 2600 + GFX.rnd() * 2000, c = { 255, 110 + math.floor(GFX.rnd() * 70), 30 }, g = 0, r = 1.4 + GFX.rnd() * 1.8, wob = GFX.rnd() * 6 }
end
end
else GFX.ember = 0 end
local keep = {}
local pdt = dt * GFX.rate(now)
for _, p in ipairs(GFX.P) do
p.a = (p.a or 0) + pdt
local age = p.a
if age < p.life then
p.vy = p.vy + p.g * pdt
if p.drag then p.vx = p.vx * (1 - p.drag * pdt); p.vy = p.vy * (1 - p.drag * pdt) end
p.x = p.x + p.vx * pdt + (p.wob and math.sin(now / 420 + p.wob) * (p.ww or 0.12) or 0)
p.y = p.y + p.vy * pdt
local k = 1 - age / p.life
if p.q then
local a = p.wob + age / 140
local cw, sw = math.cos(a) * p.r * 1.6, math.sin(a) * p.r * 1.6
local fl2 = math.abs(math.cos(age / 90 + p.wob)) * p.r * 0.8 + 0.6
smudge.glow_quad(p.x - cw - sw * 0, p.y - sw, p.x + cw, p.y + sw, p.x + cw - fl2 * math.sin(a), p.y + sw + fl2 * math.cos(a),
p.x - cw - fl2 * math.sin(a), p.y - sw + fl2 * math.cos(a), p.c[1], p.c[2], p.c[3], 3.6 * math.min(1, k * 3))
else
smudge.glow_circle(p.x, p.y, p.r * 4, p.c[1], p.c[2], p.c[3], (p.dim or 4) * k)
if not p.soft then smudge.glow_circle(p.x, p.y, math.max(1.5, p.r * 1.6), 255, 255, 230, 6 * k) end
end
keep[#keep + 1] = p
end
end
GFX.P = keep
GFX.drawFX(now, dt)
local kp = {}
for _, p in ipairs(GFX.pops) do
local age = now - p.t0
local life = p.life or 1000
if age < 0 then kp[#kp + 1] = p
elseif age < life then
local u = age / life
local y = p.y - (p.rise or 46) * (1 - (1 - u) * (1 - u))
local f = p.f or "bitter14"
if f == "bitter14" then smudge.glow_circle(p.x, y + lh(f) // 2, 30, p.c[1], p.c[2], p.c[3], 2.2 * (1 - u)) end
for _, o in ipairs({ { -2, 0 }, { 2, 0 }, { 0, -2 }, { 0, 2 }, { -1, -1 }, { 1, 1 }, { -1, 1 }, { 1, -1 } }) do
ctext(p.x + o[1], y + o[2], p.s, f, "bold", true)
end
ctext(p.x, y, p.s, f, "bold")
kp[#kp + 1] = p
end
end
GFX.pops = kp
local fg = GFX.fing
if fg then
local k = fg.up and (1 - (now - fg.up) / 350) or 1
if k <= 0 then GFX.fing = nil
else smudge.glow_circle(fg.x, fg.y, 46, 255, 246, 220, 0.5 * k) end
end
end
function GFX.card(o)
if not GFX.ok() or o.back or o.proj then return end
local tr, shiny = o.fx or 0, o.shiny
local cr, sr, cxr, sxr = math.cos(o.ry or 0), math.sin(o.ry or 0), math.cos(o.rx or 0), math.sin(o.rx or 0)
local SC = o.scale or 1
local function P(x, y)
x, y = x * SC, y * SC
local x1, z1 = x * cr, -x * sr
local y2, z2 = y * cxr - z1 * sxr, y * sxr + z1 * cxr
local k = 900 / (900 + z2)
return o.cx + x1 * k, o.cy + y2 * k
end
local hw, hh = o.CW / 2, o.CH / 2
local kind = GFX.FOIL[math.min(6, math.max(0, tr))] or 0
local st = shiny and 0.8 or (tr >= 3 and 0.4 or 0)
if st > 0 then
local a, b = P(-hw, -hh); local c, d = P(hw, -hh); local e, f = P(hw, hh); local g, h = P(-hw, hh)
smudge.holo_quad(a, b, c, d, e, f, g, h, st, kind)
GFX.holo = true
end
if o.CW * SC >= 140 then
local lx, ly = P(-(o.ry or 0) * hw * 1.4, (o.rx or 0) * hh * 1.4)
smudge.glow_circle(lx, ly, hw * 0.75, 255, 252, 240, 0.22)
end
local col = GFX.TC[math.min(6, math.max(0, tr))]
if col then
local now = smudge.millis()
local pulse = 0.75 + 0.25 * math.sin(now / 520)
local function ring(dx, cc, st)
local o1, i1 = 1.05, 0.96
local pts = { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }
for k = 1, 4 do
local p1, p2 = pts[k], pts[k % 4 + 1]
local ax, ay = P(p1[1] * hw * o1 + dx, p1[2] * hh * o1); local bx, by = P(p2[1] * hw * o1 + dx, p2[2] * hh * o1)
local cx2, cy2 = P(p2[1] * hw * i1 + dx, p2[2] * hh * i1); local dx2, dy2 = P(p1[1] * hw * i1 + dx, p1[2] * hh * i1)
smudge.glow_quad(ax, ay, bx, by, cx2, cy2, dx2, dy2, cc[1], cc[2], cc[3], st)
end
end
if tr == 5 then
ring(-4, { 255, 40, 60 }, 0.9 * pulse); ring(4, { 40, 230, 255 }, 0.9 * pulse)
else ring(0, col, (tr >= 6 and 1.1 or 0.8) * pulse) end
end
end
GFX.FL, GFX.FLY, GFX.lb = {}, {}, 0
function GFX.lagAt(t)
local w = GFX.sw
if not w then return GFX.lb end
local e = math.min(t, w.t0 + w.d) - w.t0
if e <= 0 then return GFX.lb end
local st = math.min(e, 90)
return GFX.lb + st + (e - st) * 0.7
end
function GFX.now() local t = smudge.millis(); return t - GFX.lagAt(t) end
function GFX.rate(t)
local w = GFX.sw
if not w or t >= w.t0 + w.d then return 1 end
return (t - w.t0 < 90) and 0 or 0.3
end
function GFX.slow(d)
if not GFX.ok() then return end
local t = smudge.millis()
GFX.lb = GFX.lagAt(t); GFX.sw = { t0 = t, d = d }
end
GFX.EL = { { 255, 120, 30 }, { 70, 170, 255 }, { 165, 130, 95 }, { 255, 240, 110 }, { 160, 70, 235 }, { 255, 244, 200 },
{ 110, 225, 80 }, { 255, 120, 220 } }
function GFX.hit(x, y, el, big, ko)
if not GFX.ok() then return end
el = el or 1
big = big or ko
local c = GFX.EL[el] or { 255, 200, 70 }
local n = big and 34 or 18
local now = smudge.millis()
local function add(p) p.t0 = now; p.c = p.c or c; GFX.P[#GFX.P + 1] = p end
for i = 1, n do
local a = GFX.rnd() * 2 * math.pi
local r1 = GFX.rnd()
if el == 1 then add({ x = x + (r1 - 0.5) * 50, y = y + 20 - GFX.rnd() * 30, vx = (GFX.rnd() - 0.5) * 0.12, vy = -(0.06 + GFX.rnd() * 0.14), g = -0.00004,
life = 700 + GFX.rnd() * 600, r = 1.5 + GFX.rnd() * 2, wob = GFX.rnd() * 6, c = { 255, 90 + math.floor(GFX.rnd() * 110), 20 } })
elseif el == 2 then add({ x = x, y = y, vx = math.cos(a) * (0.12 + r1 * 0.25), vy = -math.abs(math.sin(a)) * (0.15 + r1 * 0.3), g = 0.0011,
life = 650 + GFX.rnd() * 300, r = 1.4 + GFX.rnd() * 1.6 })
elseif el == 3 then add({ x = x + (r1 - 0.5) * 40, y = y + 30, vx = math.cos(a) * 0.12, vy = -(0.05 + GFX.rnd() * 0.12), g = 0.0004,
life = 900 + GFX.rnd() * 500, r = 2.5 + GFX.rnd() * 3, soft = true, dim = 2.2, drag = 0.002 })
elseif el == 4 then add({ x = x, y = y, vx = math.cos(a) * (0.35 + r1 * 0.4), vy = math.sin(a) * (0.35 + r1 * 0.4), g = 0,
life = 160 + GFX.rnd() * 160, r = 1.2 + GFX.rnd() })
elseif el == 5 then add({ x = x + (r1 - 0.5) * 50, y = y + (GFX.rnd() - 0.5) * 50, vx = (GFX.rnd() - 0.5) * 0.05, vy = -0.02 - GFX.rnd() * 0.03, g = 0,
life = 1100 + GFX.rnd() * 700, r = 3 + GFX.rnd() * 3, soft = true, dim = 2.6, wob = GFX.rnd() * 6, ww = 0.3 })
elseif el == 6 then add({ x = x, y = y, vx = math.cos(a) * (0.08 + r1 * 0.2), vy = math.sin(a) * (0.08 + r1 * 0.2), g = 0,
life = 600 + GFX.rnd() * 500, r = 1 + GFX.rnd() * 1.4, drag = 0.003 })
elseif el == 7 then add({ x = x, y = y, vx = math.cos(a) * (0.1 + r1 * 0.18), vy = math.sin(a) * (0.1 + r1 * 0.18) - 0.05, g = 0.00025,
life = 1000 + GFX.rnd() * 500, r = 2.2 + GFX.rnd() * 1.6, q = true, wob = GFX.rnd() * 6, ww = 0.5, drag = 0.0015,
c = { 90 + math.floor(GFX.rnd() * 80), 200 + math.floor(GFX.rnd() * 50), 60 } })
else add({ x = x + (r1 - 0.5) * 40, y = y + (GFX.rnd() - 0.5) * 30, vx = (GFX.rnd() - 0.5) * 0.06, vy = -(0.03 + GFX.rnd() * 0.06), g = -0.00001,
life = 1100 + GFX.rnd() * 600, r = 2 + GFX.rnd() * 3, soft = true, dim = 3, wob = GFX.rnd() * 6, ww = 0.25 }) end
end
GFX.FL[#GFX.FL + 1] = { x = x, y = y, c = c, t0 = now, big = big, el = el }
if big then
GFX.slow(ko and 760 or 480)
GFX.flash(c[1], c[2], c[3], 220, ko and 0.45 or 0.3)
GFX.shake(ko and 9 or 6, ko and 420 or 300)
end
if el == 4 then GFX.flash(240, 240, 255, 90, big and 0.35 or 0.18) end
end
GFX.CRK = { { -0.62, -0.78 }, { -0.3, -0.42 }, { -0.36, -0.2 }, { 0.02, 0.05 }, { -0.06, 0.3 }, { 0.3, 0.52 }, { 0.22, 0.74 }, { 0.48, 0.95 } }
GFX.CRB = { { 0.02, 0.05 }, { 0.3, -0.06 }, { 0.42, -0.3 }, { 0.7, -0.38 } }
function GFX.crack_pts(u, map)
local function walk(L, frac)
local out = {}
local n = #L - 1
local m = frac * n
for i = 1, n do
if i - 1 >= m then break end
local a, b = L[i], L[i + 1]
local f = math.min(1, m - (i - 1))
local ax, ay = map(a[1], a[2]); local bx, by = map(a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f)
out[#out + 1] = { ax, ay, bx, by }
end
return out
end
local segs = walk(GFX.CRK, math.min(1, u * 1.4))
if u > 0.35 then for _, sg in ipairs(walk(GFX.CRB, math.min(1, (u - 0.35) * 2))) do segs[#segs + 1] = sg end end
return segs
end
function GFX.crack_draw(segs, wide)
if not smudge.fill_quad then
for _, sg in ipairs(segs) do smudge.line(math.floor(sg[1] + 0.5), math.floor(sg[2] + 0.5), math.floor(sg[3] + 0.5), math.floor(sg[4] + 0.5), 2) end
return
end
for pass = 1, 2 do
local w2 = (pass == 1) and (wide + 1.4) or wide * 0.5
for _, sg in ipairs(segs) do
local dx, dy = sg[3] - sg[1], sg[4] - sg[2]
local l = math.max(0.01, math.sqrt(dx * dx + dy * dy))
local nx, ny = -dy / l * w2, dx / l * w2
smudge.fill_quad(sg[1] + nx, sg[2] + ny, sg[3] + nx, sg[4] + ny, sg[3] - nx, sg[4] - ny, sg[1] - nx, sg[2] - ny, pass == 2)
end
end
end
function GFX.crack3d(o)
if not o.crack or o.crack <= 0 or o.back then return end
local cr, sr, cxr, sxr = math.cos(o.ry or 0), math.sin(o.ry or 0), math.cos(o.rx or 0), math.sin(o.rx or 0)
local SC, hw, hh = o.scale or 1, o.CW / 2, o.CH / 2
local function map(u, v)
local x, y = u * hw * 0.92 * SC, v * hh * 0.92 * SC
local x1, z1 = x * cr, -x * sr
local y2, z2 = y * cxr - z1 * sxr, y * sxr + z1 * cxr
local k = 900 / (900 + z2)
return o.cx + x1 * k, o.cy + y2 * k
end
GFX.crack_draw(GFX.crack_pts(o.crack, map), 1.6)
if GFX.ok() and not o.crk then o.crk = true end
end
function GFX.crack2d(x, y, w, h, c)
local function map(u, v) return x + w / 2 + u * w * 0.44, y + h / 2 + v * h * 0.44 end
GFX.crack_draw(GFX.crack_pts(1, map), 1.4)
end
function GFX.gain(key, amt, tx, ty, spr)
if not GFX.ok() or not spr then return end
local now = smudge.millis()
local t = GFX.tap
local sx, sy = W / 2, H * 0.55
if t and now - t.t < 2500 then sx, sy = t.x, t.y end
local n = math.max(2, math.min(9, 2 + math.floor(math.log(amt + 1, 10) * 2)))
for i = 1, n do
GFX.FLY[#GFX.FLY + 1] = { sx = sx + (GFX.rnd() - 0.5) * 34, sy = sy + (GFX.rnd() - 0.5) * 24, tx = tx, ty = ty, t0 = now + (i - 1) * 55,
d = 520 + GFX.rnd() * 120, spr = spr, key = key, arc = 50 + GFX.rnd() * 70, side = (GFX.rnd() - 0.5) * 80 }
end
end
function GFX.levelup(spr, txt)
if not GFX.ok() then return end
GFX.LU = { t0 = smudge.millis(), spr = spr, txt = txt }
GFX.burst(W / 2, H * 0.42, 40, { 255, 215, 90 }, 0.38, 1100)
GFX.flash(255, 236, 170, 380, 0.3)
end
function GFX.glowup(x, y, col, k, r)
if not GFX.ok() or k <= 0 then return end
local b = 0.9 + 0.1 * math.sin(smudge.millis() / 260)
smudge.glow_circle(x, y, r * b, col[1], col[2], col[3], 0.9 * k)
smudge.glow_circle(x, y, r * 0.45, 255, 250, 220, 0.7 * k)
GFX.sweeping = true
end
function GFX.rays(x, y, col, k, len)
if not GFX.ok() or k <= 0 then return end
local t = smudge.millis() / 1000
local n = 12
for i = 0, n - 1 do
local a = t * 0.35 + i * 2 * math.pi / n
local L = (len or 170) * (0.55 + 0.45 * k) * ((i % 2 == 0) and 1 or 0.7)
local w1 = 0.07
local ax, ay = x + math.cos(a - w1) * L, y + math.sin(a - w1) * L
local bx, by = x + math.cos(a + w1) * L, y + math.sin(a + w1) * L
smudge.glow_quad(x, y, x, y, bx, by, ax, ay, col[1], col[2], col[3], 0.36 * k)
end
smudge.glow_circle(x, y, 60 + 40 * k, col[1], col[2], col[3], 0.6 * k)
GFX.sweeping = true
end
function GFX.confetti(x, y, col, n)
if not GFX.ok() then return end
local now = smudge.millis()
for _ = 1, n do
local a = -math.pi / 2 + (GFX.rnd() - 0.5) * 2.4
local sp = 0.22 + GFX.rnd() * 0.32
local c = col
if GFX.rnd() < 0.35 then c = { 255, 255, 235 } end
GFX.P[#GFX.P + 1] = { x = x, y = y, vx = math.cos(a) * sp, vy = math.sin(a) * sp, g = 0.00055, drag = 0.0016, t0 = now,
life = 1500 + GFX.rnd() * 900, c = { math.min(255, c[1] + math.floor((GFX.rnd() - 0.5) * 50)), c[2], c[3] }, r = 2.2 + GFX.rnd() * 1.6,
q = true, wob = GFX.rnd() * 6, ww = 0.35 }
end
end
GFX.BAR = {}
function GFX.barf(x, y, w, frac)
if not GFX.ok() then return frac end
local key = x .. ":" .. y .. ":" .. w
local now = smudge.millis()
local b = GFX.BAR[key]
if not b or now - b.seen > 600 then b = { d = frac, seen = now }; GFX.BAR[key] = b; return frac end
b.seen = now
if frac < b.d - 0.0001 then b.d = frac; b.sh = nil end
if frac > b.d + 0.0001 then
if not b.goal or math.abs(b.goal - frac) > 0.0001 then b.from = b.d; b.goal = frac; b.t = now end
local u = math.min(1, (now - b.t) / 450)
b.d = b.from + (frac - b.from) * (1 - (1 - u) * (1 - u))
if u >= 1 then b.d = frac end
b.sh = now
GFX.barsOn = true
end
if b.sh then GFX.barsOn = true end
return b.d
end
function GFX.barshine(x, y, w, h, frac)
if not GFX.ok() then return end
local b = GFX.BAR[x .. ":" .. y .. ":" .. w]
if not b or not b.sh then return end
local u = (smudge.millis() - b.sh) / 750
if u >= 1 then b.sh = nil; return end
local fw = math.max(3, (w - 6) * math.min(1, frac))
local cx = x + 3 + fw * u
smudge.glow_quad(cx - 10, y + 2, cx + 6, y + 2, cx + 14, y + h - 2, cx - 2, y + h - 2, 255, 250, 220, 1.4 * math.sin(u * math.pi))
smudge.glow_circle(x + 3 + fw, y + h / 2, h * 0.9, 255, 240, 190, 0.8 * (1 - u))
end
function GFX.clouds()
if not GFX.ok() or not smudge.shadow_rect then return end
local ph = GFX.ph or 2
if ph == 4 then return end
local t = smudge.millis() / 1000
for i = 1, 3 do
local cx = ((t * (5 + i * 2)) + i * 210) % (W + 420) - 210
local cy = 150 + i * ((H - 300) // 3)
local s = 1 + (i % 2) * 0.3
for _, b in ipairs({ { -60, 6, 46 }, { -18, -12, 58 }, { 30, -2, 50 }, { 70, 10, 34 } }) do
local r = b[3] * s
smudge.shadow_rect(math.floor(cx + b[1] * s - r), math.floor(cy + b[2] * s - r * 0.62), math.floor(2 * r), math.floor(r * 1.24), 0.26, math.floor(r * 0.6))
end
end
GFX.live = true
end
GFX.SEA = {
0.952, 0.699, 0.053, 0.277, 0.184, 0.922, 0.906, 0.074, 0.065, 0.096, 0.840, 0.137, 0.436, 0.938, 0.154, 0.102,
0.103, 0.828, 0.858, 0.871, 0.134, 0.182, 0.303, 0.936, 0.230, 0.082, 0.913, 0.869, 0.570, 0.938, 0.082, 0.434,
0.318, 0.076, 0.941, 0.236, 0.070, 0.758, 0.374, 0.926, 0.518, 0.936, 0.061, 0.664, 0.944, 0.373, 0.056, 0.570,
0.951, 0.787, 0.056, 0.918, 0.250, 0.920, 0.803, 0.914, 0.917, 0.154, 0.055, 0.182, 0.951, 0.934, 0.128, 0.928,
0.159, 0.840, 0.053, 0.363, 0.108, 0.260, 0.822, 0.062, 0.374, 0.066, 0.046, 0.834, 0.888, 0.939, 0.046, 0.490 }
GFX.WOOD = { { 0.2, 0.62, 0.1 }, { 0.33, 0.76, 0.08 }, { 0.25, 0.27, 0.07 } }
function GFX.mapfx(MP)
if not GFX.ok() then return end
local t = smudge.millis() / 1000
local S2 = GFX.SEA
for i = 1, #S2 - 1, 2 do
local k = i // 2
local ph = math.sin(t * (0.9 + (k % 5) * 0.21) + k * 1.7)
if ph > 0.35 then
local x, y, kk = MP(S2[i] + 0.006 * math.sin(t * 0.4 + k), S2[i + 1], 0)
local a = (ph - 0.35) / 0.65
local l = 9 * kk
smudge.glow_quad(x - l, y - 1, x + l, y - 1, x + l * 0.6, y + 1.5, x - l * 0.6, y + 1.5, 210, 240, 255, 2.8 * a)
smudge.glow_circle(x, y, 2.6 * kk, 255, 255, 255, 3.2 * a)
end
end
local night = (GFX.ph or 2) >= 3
for w, f in ipairs(GFX.WOOD) do
for j = 1, night and 7 or 3 do
local h1 = (w * 37 + j * 71) % 100 / 100
local u = f[1] + math.sin(t * (0.23 + j * 0.05) + j * 2.1 + w) * f[3] * (0.4 + h1 * 0.6)
local v = f[2] + math.cos(t * (0.19 + j * 0.04) + j * 1.3) * f[3] * 0.7
local x, y, kk = MP(u, v, 6 + 4 * math.sin(t * 0.7 + j))
local bl = 0.5 + 0.5 * math.sin(t * (1.4 + j * 0.3) + j * 3 + w)
if bl > 0.3 then
smudge.glow_circle(x, y, 7 * kk, 200, 255, 90, (night and 3 or 1.6) * bl)
smudge.glow_circle(x, y, 1.8 * kk, 255, 255, 210, (night and 5 or 3) * bl)
end
end
end
GFX.wx = true
end
function GFX.drawFX(now, dt)
local keep = {}
for _, f in ipairs(GFX.FL) do
local u = (now - f.t0) / (f.big and 520 or 360)
if u < 1 then
local r = 16 + (f.big and 90 or 54) * (1 - (1 - u) * (1 - u))
smudge.glow_circle(f.x, f.y, r, f.c[1], f.c[2], f.c[3], (f.big and 0.9 or 0.65) * (1 - u) * (1 - u))
if f.el == 4 and u < 0.5 then
for b = 1, f.big and 3 or 2 do
local a = (f.t0 % 97) / 97 * 6.28 + b * 2.1
local px, py = f.x, f.y
for s2 = 1, 4 do
local nx2 = px + math.cos(a) * 14 + math.sin(s2 * 7.3 + b) * 8
local ny2 = py + math.sin(a) * 14 + math.cos(s2 * 5.1 + b) * 8
smudge.glow_quad(px - 1.5, py, px + 1.5, py, nx2 + 1.5, ny2, nx2 - 1.5, ny2, 255, 250, 200, 3 * (1 - u * 2))
px, py = nx2, ny2
end
end
end
keep[#keep + 1] = f
end
end
GFX.FL = keep
local kf = {}
for _, f in ipairs(GFX.FLY) do
local age = now - f.t0
if age < 0 then kf[#kf + 1] = f
elseif age < f.d then
local u = age / f.d
local e = u * u * (3 - 2 * u)
local mx, my = (f.sx + f.tx) / 2 + f.side, math.min(f.sy, f.ty) - f.arc
local x = (1 - e) * (1 - e) * f.sx + 2 * (1 - e) * e * mx + e * e * f.tx
local y = (1 - e) * (1 - e) * f.sy + 2 * (1 - e) * e * my + e * e * f.ty
local sz = 26 - 8 * e
smudge.glow_circle(x, y, 16, 255, 220, 120, 1.2)
P3.spr(f.spr, 24, 24, x, y, sz, sz, math.sin(u * 9) * 0.3)
kf[#kf + 1] = f
else
GFX.burst(f.tx, f.ty, 4, { 255, 225, 120 }, 0.12, 380, 0, 2)
GFX.FLH = GFX.FLH or {}; GFX.FLH[f.key] = now
end
end
GFX.FLY = kf
for key, t0 in pairs(GFX.FLH or {}) do
local u = (now - t0) / 300
local at = GFX.at and GFX.at[key]
if u < 1 and at then smudge.glow_circle(at[1], at[2], 26, 255, 220, 120, 1.6 * (1 - u)); GFX.sweeping = true
elseif u >= 1 then GFX.FLH[key] = nil end
end
local L = GFX.LU
if L then
local u = (now - L.t0) / 1700
if u >= 1 then GFX.LU = nil
else
local cx, cy = W / 2, math.floor(H * 0.42)
local inn = math.min(1, u / 0.18)
local out = u > 0.8 and (1 - (u - 0.8) / 0.2) or 1
local k = inn * out
GFX.glowup(cx, cy, { 255, 215, 110 }, k, 110)
local sz = 84 * (inn < 1 and (1 + 0.35 * math.sin(inn * math.pi)) * inn or 1) * (0.6 + 0.4 * out)
if sz > 4 then
smudge.rounded_rect(math.floor(cx - sz * 0.62), math.floor(cy - sz * 0.62), math.floor(sz * 1.24), math.floor(sz * 1.24), math.floor(sz * 0.2), true)
smudge.rounded_rect(math.floor(cx - sz * 0.62) + 3, math.floor(cy - sz * 0.62) + 3, math.floor(sz * 1.24) - 6, math.floor(sz * 1.24) - 6, math.floor(sz * 0.2) - 2, false)
if L.spr then P3.spr(L.spr, 32, 32, cx, cy, sz * 0.9, sz * 0.9, 0) end
end
if L.txt and u > 0.12 and out > 0.3 then
local ty2 = cy + 66
local tw2 = smudge.text_width(L.txt, "ui12", "bold") + 28
smudge.rounded_rect(math.floor(cx - tw2 / 2), ty2 - 4, tw2, 38, 12, true)
ctext(cx, ty2, L.txt, "ui12", "bold", true)
end
end
end
end
GFX.STARS = { 0.771, 0.062, 0.621, 0.062, 0.206, 0.171, 0.931, 0.183, 0.717, 0.037, 0.735, 0.204, 0.954, 0.029, 0.183, 0.083,
0.546, 0.042, 0.902, 0.062, 0.231, 0.021, 0.340, 0.075, 0.450, 0.125, 0.115, 0.142, 0.006, 0.025, 0.810, 0.158, 0.490, 0.010,
0.838, 0.058, 0.683, 0.158, 0.140, 0.054, 0.279, 0.012, 0.008, 0.125, 0.408, 0.042, 0.275, 0.096, 0.077, 0.042, 0.662, 0.012,
0.333, 0.175, 0.383, 0.167, 0.848, 0.212, 0.596, 0.158, 0.287, 0.204, 0.004, 0.229, 0.115, 0.258, 0.996, 0.079 }
GFX.SEATS = { { 92, 180, 36 }, { 349, 193, 36 }, { 181, 152, 28 } }
function GFX.flame(cx, base, w, h, sway, k1, k2)
local function tongue(ww, hh, ink, k)
local n = 7
local px, py, pw
for i = 0, n do
local t = i / n
local hw = ww / 2 * ((1 - t) ^ 0.75) * (t < 0.25 and (0.75 + t) or 1)
local x = cx + sway * t * t
local y = base - hh * t
if i > 0 then
smudge.fill_quad(px - pw, py, px + pw, py, x + hw, y, x - hw, y, ink, k, true)
end
px, py, pw = x, y, hw
end
end
tongue(w, h, true, k1)
tongue(w * 0.52, h * 0.62, false, k2)
end
function GFX.critter(c, x, y, s, flip)
if smudge.shadow_rect and GFX.ok() then smudge.shadow_rect(math.floor(x + s * 0.2), math.floor(y + s - 5), math.floor(s * 0.6), 6, 0.55, 3) end
local x0, x1 = x, x + s
if flip then x0, x1 = x1, x0 end
GFX.halo(c, x0, y, x1, s)
smudge.draw_sprite_quad(art_path(c, false), 96, 96, x0, y, x1, y, x1, y + s, x0, y + s, string.format("art/s%02d_m.raw", c - 1))
GFX.sharp(c, x0, y, x1, y, x1, y + s, x0, y + s)
end
function GFX.halo(c, x0, y, x1, s)
local m = string.format("art/s%02d_m.raw", c - 1)
for _, d in ipairs({ { -2, 0 }, { 2, 0 }, { 0, -2 }, { 0, 2 }, { -1, -1 }, { 1, 1 }, { -1, 1 }, { 1, -1 } }) do
smudge.draw_sprite_quad(m, 96, 96, x0 + d[1], y + d[2], x1 + d[1], y + d[2], x1 + d[1], y + s + d[2], x0 + d[1], y + s + d[2], m)
end
end
function GFX.card_named(nm)
GFX.NAMED = GFX.NAMED or {}
if GFX.NAMED[nm] == nil then
GFX.NAMED[nm] = false
for i, n in ipairs(D.names) do if n == nm then GFX.NAMED[nm] = i; break end end
end
return GFX.NAMED[nm] or nil
end
function GFX.minicard(c, x, y, s)
smudge.rounded_rect(x - 1, y - 1, s + 2, s + 2, 4, true)
smudge.rounded_rect(x + 1, y + 1, s - 2, s - 2, 3, false)
smudge.draw_sprite_quad(art_path(c, false), 96, 96, x + 3, y + 3, x + s - 3, y + 3, x + s - 3, y + s - 3, x + 3, y + s - 3)
GFX.sharp(c, x + 3, y + 3, x + s - 3, y + 3, x + s - 3, y + s - 3, x + 3, y + s - 3)
tint(x - 1, y - 1, s + 2, s + 2, tier_of(c), "ink")
end
function GFX.scene(S, by, bh)
local cp = S.camp
local now = smudge.millis()
local t = now / 1000
local ph = (C and C.sky) and C.sky() or 2
local dark = ph >= 3
local iy = by + bh - 240
if smudge.set_clip then smudge.set_clip(0, by, W, bh) end
smudge.rect(0, by, W, bh, dark)
ttint(0, by, W, bh, TT.panel)
local fx = GFX.ok()
if dark then
if ph == 3 and fx then
for j = 0, 5 do
local y1 = iy + 30 + j * 14
smudge.glow_quad(0, y1, W, y1, W, iy + 120, 0, iy + 120, 255, 110 + j * 18, 60 + j * 6, 0.16)
end
end
local SP = GFX.STARS
for i = 1, #SP - 1, 2 do
local k = i // 2
if ph == 4 or k % 3 == 0 then
local x, y = math.floor(SP[i] * W), iy + math.floor(SP[i + 1] * 240)
local tw = 0.5 + 0.5 * math.sin(t * (1.1 + (k % 4) * 0.37) + k * 2.3)
if not fx or tw > 0.25 then smudge.rect(x, y, (k % 5 == 0) and 2 or 1, (k % 5 == 0) and 2 or 1, false) end
if fx then smudge.glow_circle(x, y, 3, 255, 250, 220, 2.2 * tw) end
end
end
if ph == 4 then
local mx, my = math.floor(0.70 * W), iy + 22
smudge.circle(mx, my, 9, true, 1, false)
smudge.circle(mx + 4, my - 2, 8, true, 1, true)
if fx then smudge.glow_circle(mx, my, 22, 220, 230, 255, 1.0) end
end
end
smudge.draw_sprite(0, iy, 480, 240, "art/camp_scene.raw", "art/camp_scene_m.raw")
if fx and smudge.hires_quad and GFX.on then
local y0, y1 = math.max(by, iy), by + bh
smudge.hires_quad("hd/camp_a.png", 0, y0, 240, y0, 240, y1, 0, y1, 0, iy, 240, iy, 240, iy + 240, 0, iy + 240)
smudge.hires_quad("hd/camp_b.png", 240, y0, 480, y0, 480, y1, 240, y1, 240, iy, 480, iy, 480, iy + 240, 240, iy + 240)
end
local fxx, fby = 236, iy + 172
local fl = function(a, b) return math.sin(t * a + b) * 0.5 + math.sin(t * a * 2.3 + b * 1.7) * 0.25 end
local k1, k2 = (not MONO) and 6 or nil, (not MONO) and 4 or nil
GFX.flame(fxx - 11, fby, 18, 27 + 5 * fl(5.1, 1), 4 * fl(3.3, 2), k1, k2)
GFX.flame(fxx + 12, fby, 18, 30 + 5 * fl(4.7, 3), 4 * fl(2.9, 5), k1, k2)
GFX.flame(fxx, fby + 1, 26, 44 + 7 * fl(6.0, 0), 5 * fl(3.9, 1), k1, k2)
if fx then
local gl = (dark and 1.0 or 0.5) * (0.85 + 0.15 * fl(9, 0))
smudge.glow_circle(fxx, fby - 22, 50, 255, 150, 50, gl)
smudge.glow_circle(fxx, fby - 40, 10, 255, 220, 120, gl * 0.8)
if dark then
smudge.glow_circle(fxx, fby + 10, 150, 255, 140, 60, 0.5)
smudge.glow_circle(math.floor(0.232 * W), iy + 89, 16, 255, 200, 110, 1.3 + 0.2 * fl(7, 2))
end
if now - (GFX.emb or 0) > 110 then
GFX.emb = now
GFX.P[#GFX.P + 1] = { x = fxx + (GFX.rnd() - 0.5) * 18, y = fby - 18, vx = (GFX.rnd() - 0.5) * 0.03, vy = -(0.04 + GFX.rnd() * 0.05),
g = 0, life = 700 + GFX.rnd() * 700, r = 0.9 + GFX.rnd() * 0.8, wob = GFX.rnd() * 6, ww = 0.15, t0 = now,
c = { 255, 120 + math.floor(GFX.rnd() * 100), 30 } }
end
GFX.live = true
end
reg("CAMPFIRE", fxx - 40, fby - 50, 80, 64, function()
if GFX.ok() then GFX.hit(fxx, fby - 14, 1, false); SND.play("flip", 0.5) end
end)
local wk = { cp.x and cp.x.w1c or 0, cp.x and cp.x.w2c or 0, cp.x and cp.x.w3c or 0 }
for i = 1, 3 do
local c, st = wk[i], GFX.SEATS[i]
if c and c > 0 then
local s = st[3] + 18
local bob = (fx and math.sin(t * 1.3 + i * 2) > 0.92) and 1 or 0
local x, y = st[1] - s // 2, iy + st[2] - s + 4 + bob
GFX.critter(c, x, y, s, i == 2)
if ph == 4 then ltext(x + s - 2, y - 14 - math.floor(2 * math.sin(t * 2 + i)), "z", "small", "bold") end
reg("WORKER" .. i, x - 4, y - 4, s + 8, s + 8, function() go("workers") end)
end
end
local pet = cp.pet
if pet and pet > 0 then
local s = 40
local x, y
local back = false
if ph == 4 then x, y = 280, iy + 222 - s
else
local u = (t / 9) % 2
back = u > 1
u = u > 1 and 2 - u or u
u = u * u * (3 - 2 * u)
x = math.floor(140 + u * 190)
y = iy + 224 - s - math.floor(math.abs(math.sin(t * 6)) * 4)
end
GFX.critter(pet, x, y, s, back)
if ph == 4 then ltext(x + s, y - 10 - math.floor(2 * math.sin(t * 2)), "z", "small", "bold") end
reg("CAMPPET", x - 6, y - 6, s + 12, s + 12, function() go("pet") end)
end
if smudge.set_clip then smudge.set_clip() end
smudge.line(0, by, W - 1, by, 2); smudge.line(0, by + bh - 2, W - 1, by + bh - 2, 2)
end
