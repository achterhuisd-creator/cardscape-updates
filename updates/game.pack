smudge.glow_quad(x0 - 3, y0 - 3, x1 + 3, y0 - 3, x1 + 3, y1 + 3, x0 - 3, y1 + 3, 255, 170, 90, 0.12 + 0.35 * hb); busy()
end
end
smudge.line(fl(x0), fl(y0 + cell), fl(x1), fl(y0 + cell), 1)
