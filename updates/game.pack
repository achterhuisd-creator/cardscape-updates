25041
return function(X, K, C, ADV)
local G = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function I(id) return IDX[id] end
local function rows_sp(y0, n, maxh) return math.min(maxh, (H - 96 - 8 - y0) // n) end
local function hash01(a, b) local v = math.sin(a * 12.9898 + (b % 100003) * 78.233) * 43758.5453; return v - math.floor(v) end
local function kv_load(name)
local t = {}
for part in (smudge.load(name, "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then t[k] = tonumber(v) end
end
return t
end
local function kv_save(name, t)
local p = {}
for k, v in pairs(t) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
smudge.save(name, table.concat(p, ";"))
end
local M, U, A
function G.load() M = kv_load("mastery"); U = kv_load("upgrades"); A = kv_load("ascend") end
G.load()
local PET_CH = 3000
function G.pet_roll(S, si)
local cp = S.camp
if not I("pet" .. si) then return "" end
if ADV.owns(cp, "pet" .. si) then return G.R and G.R.mega_roll(S, si, PET_CH) or "" end
if not G.lucky(PET_CH) then return "" end
ADV.grant(cp, "pet" .. si)
cp.x.petn = cp.x.petn + 1
local n = ITEMS[I("pet" .. si)][1]
ADV.notify("New pet: " .. n .. "!", "colog")
return "  You feel like you're being followed... " .. n .. "!"
end
local MSTAR = { 200, 1000, 3000 }
local function mstars(n) local s = 0; for _, t in ipairs(MSTAR) do if n >= t then s = s + 1 end end return s end
G.mstars = mstars
local function mkey(si, gi) return "m" .. si .. "_" .. gi end
function G.mastery(si, gi) local n = M[mkey(si, gi)] or 0; return mstars(n), n end
local function mastery_add(key, name, n)
local before = mstars(M[key] or 0)
M[key] = (M[key] or 0) + n
local after = mstars(M[key])
kv_save("mastery", M)
if after > before then
ADV.notify(name .. " mastery star " .. after .. "/3! (+1 per action)", "skills")
return "  MASTERY STAR " .. after .. "!"
end
return ""
end
function G.on_gather(S, si, gi, item, n)
local cp = S.camp
local x = cp.x
local note = ""
local xm = 1
local st = mstars(M[mkey(si, gi)] or 0)
n = n + st
if x.goldn > 0 and x.goldsi == si and x.goldgi == gi then
n = n * 2; xm = 2
x.goldn = x.goldn - 1
note = note .. (x.goldn > 0 and ("  GOLDEN x2 (" .. x.goldn .. " left)") or "  The golden glow fades.")
elseif X.rnd(1, 50) == 1 then
x.goldsi, x.goldgi, x.goldn = si, gi, 10
note = note .. "  It turns GOLDEN! x2 for 10 actions"
end
local pb, pn = G.R.gather_bonus(si)
n = n + pb; note = note .. pn
note = note .. mastery_add(mkey(si, gi), ITEMS[item][1], n)
note = note .. G.pet_roll(S, si)
return n, xm, note
end
function G.on_harvest(S, crop, n)
local key = "c" .. crop
local st = mstars(M[key] or 0)
n = n + st + G.R.gather_bonus(10)
local note = mastery_add(key, ITEMS[K.CROPS[crop][8]][1], n) .. G.pet_roll(S, 10)
return n, note
end
function G.node_tag(cp, si, gi)
local st = mstars(M[mkey(si, gi)] or 0)
local t = (st > 0) and ("  " .. string.rep("*", st)) or ""
if cp.x.goldn > 0 and cp.x.goldsi == si and cp.x.goldgi == gi then t = t .. "  GOLD x" .. cp.x.goldn end
return t
end
local function best_node(cp, si)
local best
for gi, g in ipairs(K.GATHER[si]) do
if K.can_gather(cp, si, g) and (not g[8] or cp.inv[g[8]] > 0) then best = gi end
end
return best or 1
end
local function w_rate(c) return 1 + X.tier_of(c) end
local function w_pending(cp, k)
local x = cp.x
local c = x["w" .. k .. "c"]
if c == 0 then return 0, 0 end
local secs = math.min(8 * 3600, math.max(0, now() - x["w" .. k .. "t"]))
return fl(secs / 3600 * w_rate(c)), secs
end
local wslot = 1
function G.set_worker(S, c)
local x = S.camp.x
for k = 1, 3 do if k ~= wslot and x["w" .. k .. "c"] == c then X.set_note("That card already works."); return end end
x["w" .. wslot .. "c"] = c
if x["w" .. wslot .. "s"] == 0 then x["w" .. wslot .. "s"] = 1 end
x["w" .. wslot .. "t"] = now()
X.set_note(X.cname(c) .. " starts working.")
X.save_now()
end
local function w_collect(S, k)
local cp = S.camp
local x = cp.x
local n = w_pending(cp, k)
local si = x["w" .. k .. "s"]
if n <= 0 then X.set_note("Nothing gathered yet."); return end
local g = K.GATHER[si][best_node(cp, si)]
local used = ""
if g[8] then
if K.count_item(cp, g[8]) < 1 then X.set_note("Your worker needs a " .. ITEMS[g[8]][1]:lower() .. " (buy one in the SHOP or make it)."); return end
end
K.add_item(cp, g[4], n)
local xp = 0
x["w" .. k .. "t"] = now()
X.set_note(string.format("Collected %d %s (+%d xp)", n, ITEMS[g[4]][1], xp) .. used .. K.give_xp(S, si, xp))
X.save_now()
end
function G.workers_ready(cp)
local n = 0
for k = 1, 3 do local p, secs = w_pending(cp, k); if p > 0 and secs >= 8 * 3600 then n = n + 1 end end
return n
end
local STAR_SLOT = 3 * 3600
local function star_now()
local t = now()
local slot = t // STAR_SLOT
local start = slot * STAR_SLOT + fl(hash01(slot, 7) * 3600)
local size = 1 + fl(hash01(slot, 11) * 9)
if t >= start and t < start + 45 * 60 then return slot, size, start + 45 * 60 end
return nil, nil, start > t and start or ((slot + 1) * STAR_SLOT + fl(hash01(slot + 1, 7) * 3600))
end
G.star_now = star_now
local function star_state(cp)
local slot, size, t_end = star_now()
if not slot then return nil, t_end end
local x = cp.x
if x.starid ~= slot then x.starid = slot; x.starmined = size; x.starhp = 20 end
if x.starmined <= 0 then return nil, t_end end
return { slot = slot, layer = x.starmined, hp = x.starhp, ends = t_end }
end
G.star_state = star_state
local function star_mine(S)
local cp = S.camp
local st = star_state(cp)
if not st then X.set_note("No star right now."); return end
local need = st.layer * 10 - 9
if lvl(cp, 2) < need then X.set_note("This layer needs Mining " .. need .. "."); return end
local x = cp.x
local dust = 1 + ((lvl(cp, 2) >= need + 20) and 1 or 0)
x.stardust = x.stardust + dust
x.starhp = x.starhp - 1
local note = string.format("+%d stardust", dust) .. K.give_xp(S, 2, 15 * st.layer)
if x.starhp <= 0 then
x.starmined = x.starmined - 1; x.starhp = 20
note = note .. (x.starmined > 0 and ("  Layer " .. x.starmined .. " uncovered!") or "  The star crumbles to dust.")
end
X.set_note(note)
X.save_now()
end
local STAR_SHOP = {
{ "Prospector piece (+Mining xp)", 120, function(cp)
for k = 1, 4 do if not ADV.owns(cp, "pr" .. k) then ADV.grant(cp, "pr" .. k); return end end
X.add_dust(20)
end },
{ "Gem bag (rare ores)", 40, function(cp)
local ores = { "adam", "rstone", "dragon", "celes" }
for _ = 1, 3 do K.add_item(cp, I(ores[X.rnd(1, 4)]), 1) end
end },
{ "RARE pack ticket", 120, function(cp) cp.rtickets = cp.rtickets + 1 end },
{ "Star hat (+6 HP)", 150, function(cp) ADV.grant(cp, "sthat") end },
{ "Star robe (+10 HP)", 200, function(cp) ADV.grant(cp, "strobe") end },
{ "Celestial ring (+3/+6)", 400, function(cp) ADV.grant(cp, "cring") end },
}
G.STAR_SHOP = STAR_SHOP
local AREAS = {
{ "Forest", { 1, 4, 10 } }, { "Mines", { 2, 5 } }, { "Coast", { 3, 9 } },
{ "Arcane", { 8, 13, 15 } }, { "Workshop", { 6, 7, 16 } }, { "Wilderness", { 14, 11, 12 } },
}
local TIERS = { { "Easy", 15 }, { "Medium", 40 }, { "Hard", 70 }, { "Elite", 90 } }
local function dia_bit(a, t) return (a - 1) * 4 + t end
local function dia_done(cp, a, t) return (cp.x.dia // (2 ^ (dia_bit(a, t) - 1))) % 2 == 1 end
local function dia_ok(cp, a, t)
local need = TIERS[t][2]
for _, si in ipairs(AREAS[a][2]) do if lvl(cp, si) < need then return false end end
if a == 6 and cp.x.wk < ({ 1, 10, 30, 75 })[t] then return false end
if t > 1 and not dia_done(cp, a, t - 1) then return false end
return true
end
local function dia_claim(S, a, t)
local cp = S.camp
if dia_done(cp, a, t) or not dia_ok(cp, a, t) then return end
cp.x.dia = cp.x.dia + 2 ^ (dia_bit(a, t) - 1)
local coins, dust = 100 * t, 25 * t
X.add_coins(coins); X.add_dust(dust)
if t >= 3 then cp.rtickets = cp.rtickets + 1 end
X.set_note(string.format("%s %s diary done! +%d coins, +%d dust%s.", AREAS[a][1], TIERS[t][1], coins, dust,
t >= 3 and ", RARE ticket" or ""))
X.save_now()
end
function G.xp_bonus(cp, si)
if not cp.x then return 0 end
local m = 0
for a, ar in ipairs(AREAS) do
for _, s in ipairs(ar[2]) do
if s == si then for t = 1, 4 do if dia_done(cp, a, t) then m = m + ((t == 4) and 0.10 or 0.05) end end end
end
end
return m
end
function G.dia_ready(cp)
local n = 0
for a = 1, #AREAS do for t = 1, 4 do if not dia_done(cp, a, t) and dia_ok(cp, a, t) then n = n + 1 end end end
return n
end
local DC = {
{ "Gather %d times", function(S) return S.camp.stat[1] end, { 25, 40, 60 } },
{ "Win %d fights", function(S) return X.wins() end, { 3, 5, 8 } },
{ "Make %d items", function(S) return S.camp.stat[2] end, { 8, 15, 25 } },
{ "Sell at the market %d times", function(S) return S.camp.x.msells end, { 2, 4, 6 } },
{ "Open %d packs", function(S) return X.stat("packs") end, { 2, 4, 6 } },
{ "Harvest %d crops", function(S) return S.camp.stat[3] end, { 1, 2, 3 } },
}
local function today() return now() // 86400 end
local function dc_roll(S)
local cp = S.camp
local x = cp.x
if x.dcd == today() then return end
x.dcd = today(); x.dcc = 0
local pool = {}
for i = 1, #DC do pool[i] = i end
for k = 1, 3 do
local tp = table.remove(pool, X.rnd(1, #pool))
x["dc" .. k] = tp
x["dct" .. k] = DC[tp][3][X.rnd(1, 3)]
x["dcb" .. k] = DC[tp][2](S)
end
end
local function dc_prog(S, k)
local x = S.camp.x
local tp = x["dc" .. k]
if tp == 0 then return 0, 1 end
return math.min(x["dct" .. k], DC[tp][2](S) - x["dcb" .. k]), x["dct" .. k]
end
local function dc_all(S) for k = 1, 3 do local p, t = dc_prog(S, k); if p < t then return false end end return true end
function G.dc_ready(S) dc_roll(S); return (S.camp.x.dcc == 0 and dc_all(S)) and 1 or 0 end
local function dc_claim(S)
local cp = S.camp
local x = cp.x
dc_roll(S)
if x.dcc == 1 or not dc_all(S) then return end
x.dcc = 1
x.dcs = (x.dcl == today() - 1) and (x.dcs + 1) or 1
x.dcl = today()
local coins = 60 + 20 * math.min(x.dcs, 10)
X.add_coins(coins); X.add_dust(15)
local extra = ""
if x.dcs % 30 == 0 then cp.rtickets = cp.rtickets + 3; extra = " +3 RARE tickets!"
elseif x.dcs % 14 == 0 then cp.rtickets = cp.rtickets + 1; extra = " +RARE ticket!"
elseif x.dcs % 7 == 0 then cp.tickets = cp.tickets + 2; extra = " +2 tickets!" end
extra = extra .. G.R.on_challenge(S)
X.set_note(string.format("Challenge chest: %d coins, 15 dust. Streak %d.%s", coins, x.dcs, extra))
X.save_now()
end
function C.asc(c) return A["c" .. c] or 0 end
function C.asc_bonus(c) local s = A["c" .. c] or 0; return 2 * s, 5 * s end
function C.asc_cost(c)
local s = (A["c" .. c] or 0) + 1
return 40 * s * (X.tier_of(c) + 1), s, s
end
function C.ascend(S, c)
local s = C.asc(c)
if s >= 5 then X.set_note("Already 5 ascension stars."); return end
local dust, spares, scales = C.asc_cost(c)
local cp = S.camp
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
if S.spare[c] < spares then X.set_note("Need " .. spares .. " spare copies."); return end
if cp.inv[I("scale")] < scales then X.set_note("Need " .. scales .. " Boss scales (Tower / quest bosses)."); return end
S.dust = S.dust - dust; S.spare[c] = S.spare[c] - spares; cp.inv[I("scale")] = cp.inv[I("scale")] - scales
A["c" .. c] = s + 1
kv_save("ascend", A)
X.set_note(X.cname(c) .. " ascends to star " .. (s + 1) .. "! +2 ATK +5 HP")
X.save_now()
end
local UP_CH = { 100, 100, 100, 85, 75, 65, 55, 45, 35, 25 }
local UP_BAR = { "ibar", "ibar", "ibar", "sbar", "sbar", "mbar", "mbar", "abar", "rbar", "rbar" }
function G.upg(i) return U["i" .. i] or 0 end
function G.upg_bonus(cp)
local a, h = 0, 0
for k = 1, 5 do
local i = cp.eq[k] or 0
if i > 0 then
local L = U["i" .. i] or 0
if k == 1 then a = a + L elseif k == 2 or k == 3 then h = h + 3 * L else a = a + fl(L / 2 + 0.5); h = h + L end
end
end
return a, h
end
function G.upgrade(S, i)
local cp = S.camp
local L = U["i" .. i] or 0
if L >= 10 then X.set_note("Already +10."); return end
local bar, dust = I(UP_BAR[L + 1]), 10 * (L + 1)
if cp.inv[bar] < 2 then X.set_note("Need 2 " .. ITEMS[bar][1] .. "."); return end
if S.dust < dust then X.set_note("Need " .. dust .. " dust."); return end
cp.inv[bar] = cp.inv[bar] - 2; S.dust = S.dust - dust
if X.rnd(1, 100) <= UP_CH[L + 1] then
U["i" .. i] = L + 1; kv_save("upgrades", U)
X.set_note(ITEMS[i][1] .. " is now +" .. (L + 1) .. "!")
else
X.set_note("The upgrade failed... materials lost (" .. UP_CH[L + 1] .. "% chance).")
end
X.save_now()
end
function G.upg_cost_text(i)
local L = U["i" .. i] or 0
if L >= 10 then return "MAX +10" end
return string.format("2 %s, %d dust, %d%%", ITEMS[I(UP_BAR[L + 1])][1], 10 * (L + 1), UP_CH[L + 1])
end
local WB_SLOT, WB_UP, WB_HP = 5400, 1800, 900
local WBOSS = {
{ "Quill Behemoth", 1, 25, "wb1" }, { "Bandit King", 5, 29, "wb2" }, { "Totem Lord", 3, 27, "wb3" }, { "Thunder Rooster", 4, 28, "wb4" },
}
G.WBOSS = WBOSS
local function wb_now()
local t = now()
local slot = t // WB_SLOT
local up = t - slot * WB_SLOT < WB_UP
return slot, up, up and (slot * WB_SLOT + WB_UP) or ((slot + 1) * WB_SLOT), WBOSS[slot % #WBOSS + 1]
end
G.wb_now = wb_now
local function wb_state(cp)
local slot, up, t_next, boss = wb_now()
local x = cp.x
if x.wbslot ~= slot then
x.wbslot = slot; x.wbdmg = 0
x.wbmax = 200 + 35 * ADV.CB.stats(cp).clvl
x.wbhp = x.wbmax
end
return slot, up and x.wbhp > 0, t_next, boss
end
local boss_frame
boss_frame = function(x, y, sz, c, art)
smudge.draw_sprite(x, y, sz, sz, art or string.format("art/l%02d.raw", c - 1))
smudge.rect(x - 6, y - 6, sz + 12, sz + 12, false, 4)
smudge.rect(x - 12, y - 12, sz + 24, sz + 24, false, 2)
for _, p in ipairs({ { x - 12, y - 12, 1, 1 }, { x + sz + 12, y - 12, -1, 1 }, { x - 12, y + sz + 12, 1, -1 }, { x + sz + 12, y + sz + 12, -1, -1 } }) do
local px, py, dx, dy = p[1], p[2], p[3], p[4]
smudge.triangle(px, py, px + dx * 26, py, px, py + dy * 26, true)
smudge.triangle(px - dx * 8, py - dy * 8, px + dx * 6, py, px, py + dy * 6, true)
end
for k = 0, 3 do
local t = fl((k + 1) * sz / 5)
smudge.circle(x - 9, y + t, 3, true); smudge.circle(x + sz + 9, y + t, 3, true)
end
smudge.rounded_rect(x + sz // 2 - 40, y - 24, 80, 24, 6, true)
X.ctext(x + sz // 2, y - 22, "BOSS", "small", "bold", true)
end
G.boss_frame = boss_frame
function G.wb_info(cp) local slot, alive, t_next, boss = wb_state(cp); return slot, alive, t_next, boss, slot % #WBOSS + 1 end
function G.wb_kill(S)
local cp = S.camp
local x = cp.x
local boss = WBOSS[x.wbslot % #WBOSS + 1]
x.wbkills = x.wbkills + 1
x.wbbest = math.max(x.wbbest, x.wbdmg)
local coins = 250 + fl(x.wbdmg / 5)
X.add_coins(coins); X.add_dust(60)
cp.rtickets = cp.rtickets + 1
local t = string.format("%s is DEFEATED! +%d coins, 60 dust, RARE ticket", boss[1], coins)
t = t .. G.R.on_wb_kill(S, x.wbslot % #WBOSS + 1)
if G.lucky(8) then ADV.grant(cp, boss[4]); t = t .. "  UNIQUE: " .. ITEMS[I(boss[4])][1] .. "!" end
if ADV.drop_clue(cp, 3, 3) then t = t .. "  Hard clue!" end
X.set_note(t)
return t
end
function G.check(S)
local cp = S.camp
local x = cp.x
local slot, alive, _, boss = wb_state(cp)
if alive and x.nwb ~= slot then x.nwb = slot; ADV.notify("World boss " .. boss[1] .. " has spawned! 30 minutes left.", "worldboss") end
local st = star_state(cp)
if st and x.nstar ~= st.slot then x.nstar = st.slot; ADV.notify("A shooting star (layer " .. st.layer .. ") has landed!", "star") end
for k = 1, 3 do
local p, secs = w_pending(cp, k)
local key = "w" .. k .. "t"
if p > 0 and secs >= 8 * 3600 and G["wn" .. k] ~= x[key] then G["wn" .. k] = x[key]; ADV.notify("Worker " .. k .. " is full (8 h). Collect!", "workers") end
end
G.R.check(S)
if G.WO then G.WO.check(S) end
end
function G.badges(S)
local cp = S.camp
local _, alive = wb_state(cp)
local rb = G.R.badges(S)
return { wb = alive and 1 or 0, star = star_state(cp) and 1 or 0, workers = G.workers_ready(cp), dia = G.dia_ready(cp), dc = G.dc_ready(S),
loot = rb.loot, perks = rb.perks }
end
G.SCR = { "worldboss", "star", "starshop", "workers", "diary", "challenges" }
G.PARENT = { worldboss = "adventure", star = "adventure", starshop = "star", workers = "adventure", diary = "adventure", challenges = "adventure" }
function C.draw_worldboss(S)
local cp = S.camp
local slot, alive, t_next, boss = wb_state(cp)
head(S, "World boss", "every 1.5 h")
local y = TOPY() + 6
panel(20, y, W - 40, 262)
local bi = slot % #WBOSS + 1
boss_frame(32, y + 40, 192, boss[3], string.format("art/m%02d.raw", 17 + bi))
X.ltext(246, y + 14, boss[1], "ui12", "bold")
X.ltext(246, y + 46, "Weak to " .. ((ADV.CB.WB_WEAK[bi] == 1) and "MELEE" or "RANGED"), "small", "bold")
if alive then
X.ltext(246, y + 74, "Leaves in " .. K.mmss(t_next - now()), "small", "bold")
X.bar(246, y + 110, W - 280, 18, cp.x.wbhp / math.max(1, cp.x.wbmax))
X.ltext(246, y + 134, string.format("HP %d / %d", cp.x.wbhp, cp.x.wbmax), "small", "bold")
X.ltext(246, y + 158, "Your damage: " .. cp.x.wbdmg, "small")
else
X.ltext(246, y + 74, cp.x.wbhp <= 0 and "Defeated!" or "Not here", "ui10", "bold")
X.ltext(246, y + 104, "Next in " .. K.mmss(t_next - now()), "small", "bold")
X.ltext(246, y + 134, "Kills " .. cp.x.wbkills, "small")
X.ltext(246, y + 156, "Best dmg " .. cp.x.wbbest, "small")
end
local c = G.combat(cp)
X.wrapped(30, y + 270, string.format("You fight it yourself: combat level %d, HP %d, melee max %d, ranged max %d. Kill it within 30 minutes for coins, dust, a RARE ticket and a 1 in 8 unique.", c.clvl, c.hp, c.mmax, c.rmax), W - 60, "small", 4)
local tw = (W - 48 - 16) // 3
X.button(24, y + 356, tw, 70, "FIGHT", function() ADV.CB.wb_fight(S) end, { off = not alive, id = "WBFIGHT", dot = alive and "!" or nil })
X.button(32 + tw, y + 356, tw, 70, "ARMOURY", function() C.arm_back = "worldboss"; X.go("armoury") end, { font = "ui10", sub = "weapons", id = "ARMOURY" })
X.button(40 + 2 * tw, y + 356, tw, 70, "DROPS", function() ADV.show_drops(ADV.CB.drops_wb(cp, bi)) end, { font = "ui10", sub = "chances", id = "WBDROPS", nohelp = true })
back_btn("adventure")
end
function C.draw_star(S)
local cp = S.camp
local st, t_next = star_state(cp)
head(S, "Shooting star", cp.x.stardust .. " dust")
local y = TOPY() + 6
panel(20, y, W - 40, 220)
local cx, cy = W // 2, y + 90
if st then
local f = (st.hp > 12) and 0 or ((st.hp > 4) and 2 or 3)
local smooth = X.smooth and X.smooth()
if f == 0 and smooth and (X.millis() // 700) % 2 == 1 then f = 1 end
local dx = (smooth and X.millis() < (G.star_hit or 0)) and fl(math.sin(X.millis() / 25) * 5) or 0
smudge.draw_sprite(cx - 68 + dx, y + 8, 136, 136, "art/star_" .. f .. ".raw")
smudge.circle(cx + 66, y + 26, 18, true)
X.ctext(cx + 66, y + 26 - X.lh("ui10") // 2, tostring(st.layer), "ui10", "bold", true)
X.ctext(W / 2, y + 160, string.format("Layer %d  (Mining %d)   %d/20 left", st.layer, st.layer * 10 - 9, st.hp), "ui10", "bold")
X.ctext(W / 2, y + 188, "Gone in " .. K.mmss(st.ends - now()), "small")
else
smudge.draw_sprite(cx - 68, y + 4, 136, 136, "art/star_3.raw")
X.ctext(W / 2, y + 150, "No star right now.", "ui10", "bold")
X.ctext(W / 2, y + 178, "Next star in " .. K.mmss(t_next - now()), "small")
end
X.button(24, y + 232, W - 48, 70, "MINE", function() G.star_hit = X.millis() + 220; star_mine(S) end, { off = not st, id = "STARMINE" })
X.button(24, y + 310, W - 48, 60, "STARDUST SHOP", function() X.go("starshop") end, { font = "ui10", id = "STARSHOP" })
back_btn("adventure")
end
function C.draw_starshop(S)
local cp = S.camp
head(S, "Stardust shop", cp.x.stardust .. " dust")
local y0 = TOPY() + 4
local sp = rows_sp(y0, #STAR_SHOP, 76)
for k, s in ipairs(STAR_SHOP) do
local by = y0 + (k - 1) * sp
panel(20, by, W - 40, sp - 6)
X.ltext(34, by + (sp - 6) // 2 - 10, s[1], "ui10", "bold")
X.button(W - 24 - 140, by + 5, 130, sp - 16, "BUY", function()
if cp.x.stardust < s[2] then X.set_note("Need " .. s[2] .. " stardust."); return end
cp.x.stardust = cp.x.stardust - s[2]; s[3](cp); X.set_note("Bought: " .. s[1] .. "."); X.save_now()
end, { font = "small", sub = s[2] .. " dust", off = cp.x.stardust < s[2], id = "SBUY" .. k })
end
back_btn("star")
end
function C.draw_workers(S)
local cp = S.camp
local x = cp.x
head(S, "Card workers", "")
local y = TOPY() + 2
X.ctext(W / 2, y, "Cards gather while you are away (up to 8 hours).", "small")
for k = 1, 3 do
local by = y + 26 + (k - 1) * 172
panel(20, by, W - 40, 164)
local c = x["w" .. k .. "c"]
local si = math.max(1, x["w" .. k .. "s"])
if c > 0 then
X.thumb(30, by + 8, c, {})
local n, secs = w_pending(cp, k)
local g = K.GATHER[si][best_node(cp, si)]
X.ltext(150, by + 8, X.fit(X.cname(c), W - 190, "ui10", "bold"), "ui10", "bold")
X.ltext(150, by + 34, string.format("%s: %s, %d/h", SK[si].name, ITEMS[g[4]][1], w_rate(c)), "small")
X.ltext(150, by + 56, string.format("%d gathered  (%s)", n, secs >= 8 * 3600 and "FULL" or K.mmss(8 * 3600 - secs) .. " to full"), "small", "bold")
local bw = (W - 40 - 140 - 20) // 3
X.button(150, by + 86, bw, 64, "COLLECT", function() w_collect(S, k) end, { font = "small", off = n <= 0, id = "WCOL" .. k, dot = (secs >= 8 * 3600) and "!" or nil })
X.button(156 + bw, by + 86, bw, 64, "SKILL", function()
w_collect(S, k); x["w" .. k .. "s"] = si % 4 + 1; x["w" .. k .. "t"] = now()
end, { font = "small", sub = SK[si % 4 + 1].name:sub(1, 6), id = "WSK" .. k })
X.button(162 + 2 * bw, by + 86, bw, 64, "CHANGE", function() wslot = k; C.pick_back = "workers"; X.go("cardpick") end, { font = "small", id = "WCH" .. k })
else
X.ctext(W / 2, by + 40, "Empty slot", "ui10", "bold")
X.button(60, by + 80, W - 120, 64, "ASSIGN A CARD", function() wslot = k; C.pick_back = "workers"; X.go("cardpick") end, { font = "ui10", id = "WASSIGN" .. k })
end
end
X.draw_note(y + 26 + 3 * 172)
back_btn("adventure")
end
local dpage = 1
function C.draw_diary(S)
local cp = S.camp
head(S, "Achievement diaries", "")
local y = TOPY() + 4
local tw = (W - 40) // #AREAS
for a, ar in ipairs(AREAS) do
local n = 0
for t = 1, 4 do if not dia_done(cp, a, t) and dia_ok(cp, a, t) then n = n + 1 end end
X.button(20 + (a - 1) * tw, y, tw - 4, 50, ({ "FOREST", "MINES", "COAST", "MAGIC", "CRAFT", "WILD" })[a], function() dpage = a end,
{ font = "small", active = dpage == a, id = "DIA" .. a, dot = (n > 0) and n or nil })
end
X.swipe_tabs(function() return dpage end, function(t) dpage = t end, 1, 6)
local ar = AREAS[dpage]
local names = {}
for _, si in ipairs(ar[2]) do names[#names + 1] = SK[si].name end
X.ctext(W / 2, y + 60, ar[1] .. ": " .. table.concat(names, ", "), "small", "bold")
for t = 1, 4 do
local by = y + 88 + (t - 1) * 108
local done, ok = dia_done(cp, dpage, t), dia_ok(cp, dpage, t)
panel(20, by, W - 40, 100)
X.ltext(34, by + 8, TIERS[t][1] .. " tasks", "ui10", "bold")
local req = "All of them level " .. TIERS[t][2]
if dpage == 6 then req = req .. ", " .. ({ 1, 10, 30, 75 })[t] .. " wilderness kills" end
X.wrapped(34, by + 36, req, W - 200, "small", 2)
X.ltext(34, by + 74, string.format("Reward: %d coins, %d dust%s", 100 * t, 25 * t, t >= 3 and ", RARE ticket" or ""), "small")
X.button(W - 24 - 130, by + 16, 120, 66, done and "DONE" or "CLAIM", function() dia_claim(S, dpage, t) end,
{ font = "ui10", off = done or not ok, id = "DCLAIM" .. t, dot = (not done and ok) and "!" or nil })
end
X.draw_note(y + 88 + 4 * 108)
back_btn("adventure")
end
function C.draw_challenges(S)
local cp = S.camp
dc_roll(S)
local x = cp.x
head(S, "Daily challenges", "streak " .. x.dcs)
local y = TOPY() + 6
for k = 1, 3 do
local by = y + (k - 1) * 100
local p, t = dc_prog(S, k)
panel(20, by, W - 40, 92)
X.ltext(34, by + 10, string.format(DC[x["dc" .. k]][1], t), "ui10", "bold")
X.bar(34, by + 48, W - 160, 20, p / t)
X.rtext(W - 34, by + 46, p .. " / " .. t, "ui10", "bold")
end
local by = y + 310
local claimed = x.dcc == 1
X.button(24, by, W - 48, 76, claimed and "CLAIMED TODAY" or "OPEN CHEST", function() dc_claim(S) end,
{ off = claimed or not dc_all(S), sub = claimed and "new challenges tomorrow" or "all 3 done = chest", id = "DCCLAIM", dot = G.dc_ready(S) > 0 and "!" or nil })
X.wrapped(30, by + 90, "Streak bonuses: day 7 two tickets, day 14 a RARE ticket, day 30 three RARE tickets. Miss a day and the streak restarts.", W - 60, "small", 3)
back_btn("adventure")
end
local CB = dofile("combat.lua")(X, K, C, ADV, G)
ADV.CB = CB
for _, n in ipairs(CB.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(CB.PARENT) do G.PARENT[k] = v end
local R = dofile("rsps.lua")(X, K, C, ADV, G)
G.R = R; ADV.R = R
for _, n in ipairs(R.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(R.PARENT) do G.PARENT[k] = v end
local WO = dofile("world.lua")(X, K, C, ADV, G)
G.WO = WO; ADV.WO = WO
for _, n in ipairs(WO.SCR) do G.SCR[#G.SCR + 1] = n end
for k, v in pairs(WO.PARENT) do G.PARENT[k] = v end
function G.times(S, t0, t1, add)
for s = t0 // STAR_SLOT, t1 // STAR_SLOT + 1 do add(s * STAR_SLOT + fl(hash01(s, 7) * 3600)) end
for s = t0 // WB_SLOT, t1 // WB_SLOT + 1 do add(s * WB_SLOT) end
local x = S.camp.x
for k = 1, 3 do if x["w" .. k .. "c"] ~= 0 then add(x["w" .. k .. "t"] + 8 * 3600) end end
if WO.times then WO.times(t0, t1, add) end
end
return G
end
help.lua
28071
local H = {
friends = { "Friends", "Share with a friend, without internet: the game turns a gift or your deck into a short code. Send it any way you like (a message, a note); your friend types it in with ENTER A CODE.\nGIFT COINS: pick the amount with - and +. Items: open the BANK, tap an item, GIFT (the x1 / x5 / ALL button sets how many). Cards: open a card in the ALBUM, GIFT gives one spare copy. What you give leaves your game at once; every code works only once per game.\nDUEL CODES: MY DUEL CODE shows your deck (3 cards with their attack and HP) as a code. Your friend fights your 3 cards one by one (best of 3). The first win against a code gives 100 coins and a pack ticket.\nBookworm (on the reader): every 30 minutes you read a book gives a pack ticket, every 4th one a RARE ticket. Only minutes with a page turn or touch in the last 3 minutes count." },
codeentry = { "Enter a code", "Type the letters of the code on the QWERTY keyboard (numbers on top); dashes don't matter. Codes use 2-9 and A-Z without I and O, so there is no 0/O or 1/I to mix up. A gift code has 15 letters, a duel code 20. OK checks it: a typo is caught, and you can fix it with DELETE." },
duel = { "Duel result", "Best of 3 against your friend's deck. FIGHT AGAIN plays it once more (the prize only comes with the first win against a code). Send your own duel code so they can fight back." },
away = { "Welcome back", "What happened while you were away: crops and expeditions that finished, GE offers, missions and more, plus your Bookworm tickets for reading on the reader. Tap a line to go there, or CONTINUE for the home screen. Everything also stays in the notifications (tap the top bar)." },
frames = { "Gold frames", "Pure decoration for rich collectors: a gold frame around a card you own, shown everywhere the card is (album, fights, showcase). It costs coins by rarity: common 10k, uncommon 20k, rare 50k, legendary 100k, exotic 250k, mythic 500k, secret 1M. Tap a card twice to buy. Frames give no stats." },
ourpet = { "Our pet", "One pet for two players: you both see the same pet and what the other did (on the reader the care is sent at the next sync).\nFEED fills Food, PLAY fills Fun (and makes it a bit hungry), CLEAN fills Clean, PET cheers it up a little, TREAT gives it food from your bank (lots of Food and a little Fun). Food is empty after a day, Fun after 18 hours, Clean after a day and a half; the app can notify you when one gets low. At night (23:00-7:00) it sleeps.\nCare gives xp (once per 15 minutes per action and player): the egg hatches, and your pet grows from baby to young to grown-up.\nTOGETHER: on a day you both took care of it, you each claim a pack ticket. Days in a row together make a streak: 3, 7, 14, 30, 60 and 100 days give rewards.\nGIFT: once a day a happy pet (everything over 60%) brings you coins, sometimes a pack ticket.\nWISH: every day the pet has its own wish for each of you (feed it twice, a bath, hide and seek...). Make it come true for coins, sometimes a ticket.\nHIDE & SEEK: the pet hides in the box, the plant or the basket. Find it: it counts as playing, and the first 3 finds a day give coins.\nTap the pet itself and it reacts. A level-up or growing up is celebrated with confetti.\nSettings (repository, token, your name): the app's menu (top left) > Settings > Our pet." },
title = { "Home", "CardScape: collect cards, fight with them and build up your camp.\nPACKS opens card packs, ALBUM shows your collection, QUEST and TOWER are card fights for coins, CAMP is the RuneScape-style part with skills, bank, adventure and more. DECK picks the 3 cards that fight together.\nTap one of the four cards at the top to show off a card of your own (BEST 4 fills them with your rarest cards).\nTap the top bar for notifications and your task tracker.\nSEARCH (the bar at the top of every ? help): type any item, monster or boss to see where to get it, every drop chance and what it is used for.\nThe device Home button always brings you back here. Quit the game in Settings (the cog). FRIENDS: gift codes and duel codes to share with a friend." },
grading = { "Card grading", "Send up to 3 cards to the grader at once; each comes back after 30 minutes (real time, nothing speeds it up): tap COLLECT. The first grading gives a grade from 1 to 10 (most cards get 4-7, a 10 GEM MINT is rare). Every 2 grade points give the card +1 ATK in fights (grade 10: +5).\nSend a graded card again to try for a higher grade: from grade 1 it goes up 80% of the time, from 5 40%, from 8 15%, from 9 only 6%. It never goes down. Grading is free: it only takes the 30 minutes, and while a card is away you can't use it anywhere (fights, deck, pet, expeditions, workers).\nBREAK CASE (switch at the top, then tap a graded card twice): the grade is gone, and it costs one copy of the card: a spare, or if you have no spares the card itself (back to not found; you get a warning first).\nThe grade shows on the card everywhere; in the big 3D view the card sits in a grading case with its grade on the label." },
packs = { "Booster packs", "Each pack has 3 cards; the 3rd is always UNCOMMON or better. Pay 30 coins (or open x5 / x10 at once), or use pack tickets and RARE tickets.\nGet coins from quests, the tower, selling items in the bank and camp tasks. Tickets come from levelling skills, diaries, bosses, raids and daily streaks.\nELEMENT PACK (70 coins) only gives cards of one element.\nGRADING (free): send a card to the grader (30 minutes, real time). It comes back with a grade 1-10: +1 ATK per 2 grade points. Send it again to try for a higher grade; the higher it is, the smaller the chance it goes up (it never goes down)." },
elempack = { "Element pack", "Pick an element: all 3 cards will be that element. Costs 70 coins. Handy to finish an element set or to get strong cards against an enemy element." },
reveal = { "Opening packs", "Tap to flip each card. New cards go into your album; duplicates become spare copies, which you can merge in the album to level a card up or turn into dust." },
album = { "Album", "All 153 cards, by tier tab (COM ... MYTH, ??? = secret). Every rarity has 24 cards (three series, the newest is the winter set Frostfall): scroll down for the rest (or tap the tab again). Tap a card to see its stats.\nCards come from packs. Missing ones can also be crafted with dust on the card page (not secret cards).\nThe dots under a card are its level (max 5). FILTER shows owned, missing, spares, shiny or one element." },
detail = { "Card", "Stats, element and level of one card.\nLevel up: merge spare copies (copies per tap: ONE / ALL) or train it in the camp. At level 5 you can ASCEND with dust, spare copies and Boss scales for extra ATK and HP.\nNot owned yet? CRAFT it with dust (dust comes from levels, selling spares, diaries and bosses). Secret cards only drop from packs (1 in 10 million)." },
quest = { "Pick a fighter", "Choose the card that fights this enemy. Element advantage doubles your damage: the dots on the tabs show how many of your cards are strong here.\nStrong/weak chain: FIRE > NATURE > EARTH > STORM > WATER > FIRE and SHADOW > DREAM > LIGHT > SHADOW." },
battle = { "Card battle", "ATTACK deals your ATK (x2 against a weak element). GUARD heals and halves the next hit. SPECIAL costs 3 energy for a double hit (energy fills each turn). PRAY halves boss hits but uses prayer points (refill at the Altar or with prayer potions).\nWins give coins and card xp. RETREAT ends the fight without a reward." },
deck = { "Deck & sets", "Choose 3 cards for your deck. Team spirit: a deck card in a fight gets +1 ATK and +2 HP for every other deck card.\nSETS: own all cards of a set for a permanent bonus." },
sets = { "Sets", "Each set is a group of cards. Collect every card of a set to complete it and get its bonus forever." },
stats = { "Statistics", "Your totals: coins earned, packs, wins, tower floor and collection. CAMP & ADVENTURE shows the hiscores for skills, bosses, quests and clues." },
settings = { "Settings", "Battery saver turns off animations and shadows for fewer screen refreshes.\nCLEANUP adds a black clean-up flash every 40 screens against ghosting (off = never; needs the CardScape firmware).\nGLINT and RIPPLE (phone) turn the light running over buttons and the ring where you tap on or off.\nQUIT GAME saves and closes CardScape (back to the reader).\nRESET PROGRESS deletes everything (asks twice)." },
cardpick = { "Pick a card", "Tap a card you own. It is used for the slot you came from (deck, worker, expedition, training or pet)." },
camp = { "Camp", "The RuneScape part of the game. SKILLS: train 21 skills. BANK: everything you store. INVENTORY: 28 slots of what you carry and wear. MISSIONS and DAILY give coins for deliveries. EXPEDITION sends cards out for loot. TRAINING gives card xp. SHOP has daily deals and real shops (General store, Fishing shop, Hunter shop, Apothecary). PET follows you. MARKET is a live price chart for trading. TROPHIES are goals. ADVENTURE has quests, slayer, bosses, raids and more.\nThe bag bar at the top shows how full your inventory is (like RuneScape, gathering fills it). Tap it on any camp screen for the QUICK INVENTORY: drink, wear, DEPOSIT your loot or go to the BANK." },
skills = { "Skills", "21 skills, each up to level 99, like RuneScape. Gathering puts 1 item in your inventory per success. Everything you gather stacks in one slot, like runes; every try can fail, less often with a higher level and (Woodcutting/Mining) a better axe or pickaxe; Fishing and Hunting get the same boost from your level alone (at 6, 21, 31, 41 and 61). When your inventory is full, tap BANK. Making skills use materials from your bank. Combat skills (Ranged, Melee, Block, Magic) train in fights.\nTools: axes and pickaxes (Smithing at the anvil, each needs a level to use; better trees and rocks need a better one: Willow and Coal an Iron one, Maple and Mithril Steel, Yew and Adamant Mithril, Magic Adamant, Elder and Dragon Rune, Ancient and Celestial Dragon), fly rod and harpoon for Fishing. Nets, lobster cages, snares and traps are equipment: buy or make one once and keep it forever (they are expensive in the SHOP).\nNo xp boosts or level rewards except skilling outfits (Lumberjack, Prospector, Angler: +2.5% each full set); level 99 gives the skill's cape." },
bank = { "Bank", "Everything you gather or make lands here. Tabs filter by type (logs, ore, food, potions, gear, runes, misc); the search bar finds items by name or description (tap it for a keyboard, X clears it). Tap an item for its info: what it does and where to get it. SELL gives coins (market goods sell at the market price). TAKE moves items to your inventory: food and potions only work from your inventory, gear is worn from there. The amount button switches x1 / x5 / ALL. DEPOSIT empties your inventory into the bank. Tools and supplies sell back for 40% of their price. The bank holds 99 of each item at first; UPGRADE opens a panel that shows what you have, the next step and its cost; buying raises that: 250 for 1,000 coins, 1,000 for 10,000, 5,000 for 50,000, 25,000 for 250,000, 100,000 for 1M and 1M for 5M. ALCH = High Alchemy (Magic 21, 1 nature + 3 fire runes) turns items into coins." },
gear = { "Inventory", "28 slots like RuneScape, plus your 5 worn slots. Gathering fills it; DEPOSIT puts your loot in the bank (food, potions, tools, supplies and gear stay).\nTap an item: DRINK prayer potions, EQUIP gear (needs a level: weapons the skill of their style, armour Block), put it back in the BANK or DROP it. Tap a worn slot to REMOVE or UPGRADE it (+1..+10 with bars and dust, can fail).\nFood and combat potions are used in fights, raids and Wintertodt from here." },
missions = { "Missions", "Deliver the items asked for coins, dust and tickets. A new mission replaces each delivered one; SKIP swaps one you don't like. Items come from your bank: gather or make them first." },
daily = { "Daily", "Claim a daily bonus every day for a 7-day streak (miss a day and it restarts). The daily mission pays double when you deliver the item." },
expedition = { "Expeditions", "Send a card away for 30 min, 2 h or 4 h. Its element decides the loot (ores, fish, crops, hunter drops, bars, dust, logs or coins); higher tier cards bring back more. Collect when it's back." },
expsend = { "Send out", "Choose how long the card goes away. Longer trips bring back more." },
training = { "Training", "Spend 5 coins for +3 card xp on any card you own. Merging duplicate cards in the album is faster, but training works on every card." },
shop = { "Shop", "DEALS: the trader changes stock every day (resources, a rare bit and a card); each offer once per day, not in Iron Mode.\nThe real shops, like RuneScape: GENERAL (knife, tinderbox, hammer, chisel, vial), FISHING (small net, feathers, lobster cage, big net), HUNTER (snare, pit trap, net trap: equipment, bought once and kept forever) and HERBS (Apothecary: vials and potion secondaries). They sell at the market price and put everything in your bank." },
pet = { "Pet", "Choose a card as your pet. It follows you around camp and gives a chance of +1 item on every gather; higher tier cards give a bigger chance. Skilling pets (like the Beaver) are different: a rare drop while training a skill, just for show like in RuneScape." },
market = { "Market", "Live prices that move every 15 minutes, like crypto. Buy low, sell high: tap an item for its chart, BUY 1/10 and SELL. Categories on the side, sorted by value.\nPORTFOLIO shows what you bought and your profit. GE offers (BID/ASK) fill by themselves when the price reaches your offer." },
mktitem = { "Market item", "The chart shows the price over time. BUY and SELL trade at the current price (+10% when buying). GE BID buys 10 when it dips 15%, GE ASK sells when it rises. Your bank sells market goods for the same market price." },
achieve = { "Trophies", "Goals for skills, cards, fights and more. Claim a finished trophy for coins, dust and tickets. Track one in the notification bubble with + TRACK." },
tasks = { "Slayer master", "Get a Slayer task (kill N of a monster) and fight them yourself: FIGHT uses your own Melee / Ranged / Magic combat. Monsters drop coins, resources, runes and rare uniques. Finish the task, then CLAIM the reward (coins/dust/ticket + Slayer points).\nSKIP costs points; the SLAYER SHOP sells helms, rerolls and more. Higher Slayer levels unlock tougher monsters, up to the Rune Serpent at level 99." },
slayshop = { "Slayer shop", "Spend Slayer points (from finished tasks) on items and perks. Points go up with your task streak." },
inbox = { "Notifications", "All your notifications and the tracker. Tap one to jump to it." },
trackpick = { "Track", "Pick what to follow in the TRACKER tab of the notification bubble: Slayer task, missions, quests, clues, trophies, crops, expeditions, GE offers, card grading or your pet (up to 18)." },
portfolio = { "Portfolio", "What you bought on the market, what you paid and what it's worth now. Realised profit counts sales." },
geoffers = { "GE offers", "Your open Grand Exchange offers. BID buys 10 items when the price drops to your offer, ASK sells when it climbs. They fill by themselves, even while the app is closed. Place them on a market item page." },
adventure = { "Adventure", "QUESTS (journal), BOSSES (lairs), WILDERNESS (risky fights), SLAYER (tasks), CLUES, MINIGAMES, HOUSE, COLLECTION log, ALTAR (restore prayer), WORLD BOSS (every 1.5 h), STAR (shooting stars), WORKERS (idle gathering), DIARIES, CHALLENGES (daily), RAIDS, WINTERTODT, LOOT (boxes, wheel, forge) and PERKS (login, prestige, luck, titles...)." },
quests = { "Quests", "Story quests with steps: deliver items, win fights, reach levels or beat a boss. Each quest gives rewards and quest points; some unlock boss lairs (e.g. Dragon Slayer)." },
questinfo = { "Quest", "The current step of this quest. Do what it asks, then come back to continue. Items are taken from your bank." },
lairs = { "Boss lairs", "Card fights against bosses with special moves (fire breath, healing, burrowing, changing element...). Some need a quest or Slayer level first. Each has a unique drop and counts its kills (KC)." },
wild = { "Wilderness", "Risky card fights: double coins and better clue drops, but if you lose you drop half of 3 random bank stacks. Deeper levels are harder and pay more." },
clues = { "Clue scrolls", "Easy, medium and hard clues drop from gathering, fights, Slayer, bosses and the Wilderness. Do the steps to open a casket with coins, items and clue uniques (berets, boots, third-age...)." },
colog = { "Collection log", "Every unique item you can find: pets, capes, boss drops, clue items, raid purples and more. Owned ones show their icon." },
house = { "House", "Build rooms with planks (Construction), bars and coins. Each room gives a lasting perk: faster crops, double meals, a workshop that sometimes saves materials, a chapel (prayer), free teleports, nests and gems x2..." },
minigames = { "Minigames", "FISHING TRAWLER: 6 rounds at sea for fish, Fishing xp and Angler pieces. BARBARIAN ASSAULT: your deck fights up to 10 waves; Honour buys rewards like the Fighter torso." },
trawler = { "Fishing Trawler", "Pick the right fix each round (leaks, nets, waves). A good trip gives more fish, Fishing xp and a chance at Angler pieces (the full set gives +2.5% Fishing xp)." },
ba = { "Barbarian Assault", "Your 3 DECK cards fight up to 10 waves of Penance. The further you get, the more Honour you earn; spend it on rewards." },
hiscores = { "Hiscores", "Your camp records: skill levels, total level, boss kill counts, quests and clues." },
worldboss = { "World boss", "A boss spawns every 90 minutes and stays 30 minutes. Fight it yourself (Melee / Ranged / Magic, Block, Eat, Pray). Its HP stays down between your fights. A kill gives coins, dust, a RARE ticket, a Silver box and a 1 in 8 unique. ARMOURY picks your weapons." },
star = { "Shooting star", "Every 3 hours a star lands for 45 minutes. Mine it (higher layers need more Mining) for stardust. Spend stardust in the STARDUST SHOP: Prospector outfit pieces (+Mining xp), rare ores, tickets and star gear." },
starshop = { "Stardust shop", "Trade stardust from shooting stars for potions, rare ores, RARE tickets, star gear and the Celestial ring." },
workers = { "Card workers", "Put up to 3 cards to work: they gather while you're away (up to 8 hours). Higher tier and level cards gather faster. SKILL switches what they gather, COLLECT takes the loot." },
diary = { "Achievement diaries", "Each area has Easy/Medium/Hard/Elite tasks: get all its skills to the level shown. Claim for coins, dust and tickets." },
challenges = { "Daily challenges", "3 new challenges every day. Finish all 3 and open the chest for coins, dust and a Bronze box. Keep a streak for tickets on day 7, 14 and 30." },
fight = { "Your fight", "DROPS shows every drop of this monster with its chance (1/N), including uniques, herbs, boxes and pets. You fight with your own skills: MELEE, RANGED and MAGIC (needs runes) deal damage; the enemy's weak style does x1.5. BLOCK raises your block chance and heals a little. ITEMS opens your inventory in the fight: eat food or drink potions (Healing +30 / Super healing +60 HP, Attack +15% damage, Overload +30% damage but -10 HP, Prayer and Super restore refill prayer). Using an item takes your turn. Take them from the BANK into your inventory before the fight. PRAY halves hits using prayer points.\nDamage trains the style you use; hits you take train Block." },
raid = { "Raid", "5 rooms in a row. Your HP carries over between rooms, so take food in your inventory. Clear all 5 for a chest with a 1 in 12 purple (Twisted bow, Kodai wand, Dragon claws, Ancestral robe), plus boxes and a chance at an Instance token." },
todt = { "Wintertodt", "A skilling boss. CHOP roots (Woodcutting), FLETCH them into kindling (Fletching), FEED the brazier (Firemaking), FIX or LIGHT it when it breaks or goes out, EAT (from your inventory) when the cold hurts. Points pay a supply crate; 500+ points can give Pyromancer pieces, Lumberjack pieces (+Woodcutting xp) and the Phoenix pet." },
alch = { "High Alchemy", "Turn an item into coins: Magic 21, 1 nature rune + 3 fire runes per cast. Market goods alch for the market price, other items for 1.3x their value. Make runes with Runecrafting." },
armoury = { "Armoury", "Choose the weapon for each style: melee weapons, bows and staffs you own (bank or worn). Upgrades count. Better weapons raise your max hit." },
loot = { "Loot", "Open Bronze, Silver, Gold and Mythic boxes and Crystal chests (with keys). They drop from Slayer, world bosses, raids, Wintertodt, challenges, the wheel and login days. Mythic boxes can even hold a secret card.\nWHEEL: 1 free spin a day. FORGE: 3 of the same gear -> a better piece." },
reel = { "Prize reel", "The reel spins and stops on your prize. It is already yours: OPEN ANOTHER if you have more boxes." },
wheel = { "Wheel of Fortune", "One free spin a day; login days give extra spins. Prizes: coins, dust, boxes, keys, potions and Instance tokens." },
forge = { "Upgrade forge", "Combine 3 of the same gear piece plus coins for a random better piece of the same slot. Success is 60% (more with luck); a fail keeps 1 of the 3." },
perks = { "Perks", "LOGIN calendar, PRESTIGE skills, LUCK gear, TITLES from kill counts, INSTANCES (private boss rooms), IRON MODE and MEGA PETS." },
login = { "Daily login", "Claim once a day. 28 days of rewards with a big chest on day 28 (Mythic box, Gold box, 3 RARE tickets, 500 dust). Missing a day sets you back 3 days." },
luck = { "Luck gear", "Ring of wealth (Boss scales, from bosses) and Amulet of luck (stardust, from shooting stars). Each level is +2% luck: rare drops, pets, purples and box prizes come easier." },
titles = { "Titles", "Kill counts for world bosses, raids, Wintertodt and Slayer. Milestones unlock a title (shown on Adventure) and +2% damage against that boss per milestone. WEAR one you like." },
instance = { "Instances", "An Instance token (from raids, boxes, the wheel and login days) opens a private room for 10 boss kills, any time. Fight any world boss or the Mad Hatter." },
iron = { "Iron Mode", "A challenge: no buying packs with coins, no Market buying, no GE bids, no daily deals (the real shops are allowed, like RuneScape ironmen). Rewards: +5% luck and the Ironman title. After turning it off you wait 24 h to turn it on again." },
worldinfo = { "World", "The game follows your reader's clock. MORNING (6-12): crops grow faster. DAY (12-18): Light & Fire cards +15%. EVENING (18-22): Nature & Water cards +15%. NIGHT (22-6): Shadow & Dream cards +20%.\nWEATHER changes every day: rain (faster crops, Water cards), storm (Storm cards), fog (Shadow cards), snow (Water cards).\nEvery week one MODIFIER is active: Lucky week, Slayer week, Wild markets, Nest week (nests, gems and clue bottles x2), Shiny week, Harvest week (crops x2 faster), Fortune week (the merchant comes more often) or an element week." },
bounty = { "Collector bounty", "Every 3 days the Collector asks for one card at a certain level (sometimes shiny). Hand over ONE spare copy (you keep the card) for coins and a box. Every 10 bounties gives a Mythic box. Level cards by merging copies in the album; shiny cards come from packs." },
worldmap = { "World map", "6 regions unlock with your total level: Greenwood (0), Copper Hills (60), Saltmarsh (150), Wildlands (300), Frostpeak (600) and The Void (1000). EXPLORE (a 20 second trip) finds resources and xp, a hidden stash, or a monster to FIGHT with your own combat. Each region hides a SECRET (rare, +200 coins). Find all 6 for a Mythic box." },
megapets = { "Mega pets", "Gathering with a skilling pet you already own can rarely turn it MEGA, a giant version just for show. Mythic boxes can also give one." },
}
local SKILL = {
"Chop trees for logs: each swing can fail, a better axe (Smithing, needs a Woodcutting level) and a higher level help. Better trees need a better axe: Willow an Iron axe, Maple Steel, Yew Mithril, Magic Adamant, Elder Rune, Ancient Dragon. Logs go into your inventory; BANK when it is full. Rare bird nests. The Elder and Ancient trees need quest points.",
"Mine rocks for ores and coal: each swing can fail, a better pickaxe (Smithing, needs a Mining level) and a higher level help. Better rocks need a better pickaxe: Coal an Iron pickaxe, Mithril Steel, Adamant Mithril, Dragon Rune, Celestial Dragon (Rune stone and copper: any pickaxe). The Rune stone rock (level 1) gives rune essence, for Runecrafting and rune equipment. Rare uncut gems (cut them with a chisel in Crafting). The deepest veins need quest points.",
"Fish like in RuneScape. Shrimp: small net. Trout and salmon: fly rod. Swordfish, sharks and leviathans: harpoon. Lobsters: lobster cage. Manta rays: big net. The fly rod (Crafting 3) and harpoon (Smithing 12) are made once and kept forever. Nets and cages are equipment: buy or make one once and keep it forever (SHOP > Fishing shop, or Crafting). Rare clue bottles.",
"Hunt like in RuneScape: snares for rabbits, pheasants and phoenixes, pit traps for deer, boars, wolves and bears, net traps for drakes. Buy or make one once and keep it forever: SHOP (Hunter shop) or Fletching. Used by Crafting for gear.",
"Two steps like RuneScape: smelt ores into bars at the FURNACE, then smith bars at the ANVIL (needs a hammer): swords, axes, pickaxes and the harpoon. Bars are also used for upgrades, house rooms and missions.",
"Needs a knife. Cut logs into bows and string them with a bow string (Crafting, from flax), make snares, pit traps and net traps for Hunting. Bows are ranged weapons (pick them in the Armoury, each needs a Ranged level).",
"Spin flax into bow strings, make small nets, lobster cages, big nets and the fly rod, cut gems with a chisel, and make gear from hunter drops and staffs for Magic.",
"Cast utility spells (dust, tickets, coins) and teleports with runes. Magic is also a combat style: spells use runes from Runecrafting. High Alchemy is in the Bank.",
"Cook fish and crops into meals. Food can burn (less often as your level goes up; never 30 levels above the recipe). Meals heal you in fights, nothing else, like RuneScape.",
"Plant seeds (coins) in your plots; crops grow over real time. Start with 3 plots, BUY PLOT 4-6 (500c Farming 10, 2000c Farming 30, 6000c Farming 50). PLANT ALL fills every empty plot with the selected crop, HARVEST ALL picks every ready one. Tap a plot to plant or harvest just that one. Flax for bow strings and nets, herbs (Guam, Ranarr, Snapdragon, Torstol) for Herblore. HARVEST puts the crop in your inventory.",
"Run laps for coins and xp. You can slip on an obstacle; a higher Agility level makes it safer.",
"Steal coins. If you get caught you are stunned for 5 seconds, like RuneScape.",
"Pray for blessings: Might and Strength (+ATK in fights) and Fortune (more coins). Also raises your prayer points.",
"Slayer tasks: kill monsters with your own combat. Open it from Adventure > SLAYER.",
"Like RuneScape: clean grimy herbs (from farming and monster drops), then mix herb + secondary (Apothecary in the SHOP) + vial of water: attack, healing, prayer, super restore, super healing and overload. Potions are used in fights (ITEMS); prayer potions also work from your inventory.",
"Saw logs into planks to build rooms in your HOUSE (Adventure).",
"Trains in fights when you hit with a bow. Raises your ranged max hit.",
"Trains in fights when you hit with melee. Raises your melee max hit.",
"Trains when you get hit or block in fights. Raises your HP, block chance and damage reduction.",
"Turn rune essence into runes for Magic spells, teleports and High Alchemy. Every rune needs rune essence (Mining: the Rune stone rock); air runes need nothing else, the other runes one more material (ore, bars, coal or planks).",
"Light logs with a tinderbox for Firemaking xp (better logs, more xp). Feeding the Wintertodt brazier trains it too.",
}
return { H = H, SKILL = SKILL }
main.lua
240657
local D = dofile("data.lua")
local W, H = 480, 800
local TOP = 64
local S
local C
local F
local GR
local scr = "title"
local btns, nbtn = {}, 0
local focus = 1
local note = ""
local last_act = -1000
local timer_at, timer_fn = nil, nil
local page = 0
local album_mode = "view"
local sel = 1
local SHOW = { 25, 28, 30, 32 }
local sslot = 1
local all_mode = false
local RV
local B
local dirty = false
local confirm_reset = false
local confirm_phone = false
local SAVER = false
local anim_v = 0
local PE
local start_opening
local pack_art
local function rnd(a, b)
if smudge.random then return smudge.random(a, b) end
return math.random(a, b)
end
local function tier_of(c)
if c >= 151 then return 6 elseif c >= 103 then return (c - 103) // 8 elseif c >= 100 then return 6 elseif c >= 76 then return (c - 76) // 8 + 3 elseif c >= 52 then return (c - 52) // 8 end
return (c - 1) // 8
end
local SECRET_ELEM = { [49] = 6, [50] = 1, [51] = 8, [100] = 6, [101] = 5, [102] = 8, [151] = 2, [152] = 1, [153] = 7 }
local function elem_of(c) if SECRET_ELEM[c] then return SECRET_ELEM[c] end if c >= 103 then return (c - 103) % 8 + 1 end if c >= 52 then return (c - 52) % 8 + 1 end return (c - 1) % 8 + 1 end
local function cname(c) return D.names[c] end
local function owned(c) return S.lvl[c] > 0 end
local function after(ms, fn) timer_at = smudge.millis() + ms; timer_fn = fn end
local function redraw() smudge.request_update() end
local CLEAN = false
local FX_GLINT, FX_RIP = true, true
local function apply_clean() if smudge.set_clean_refresh then smudge.set_clean_refresh(CLEAN and 40 or 0) end end
local function split(str, sep)
local t = {}
for p in string.gmatch(str, "[^" .. sep .. "]+") do t[#t + 1] = p end
return t
end
local function new_state()
local s = { lvl = {}, spare = {}, xp = {}, coins = D.start_coins, dust = 0, stage = 1, wins = 0, packs = 0, camp = C.new(),
earned = 0, tower = 0, evolved = 0, setmask = 0, deck = { 0, 0, 0 }, shiny = {} }
for i = 1, D.ncards do s.lvl[i] = 0; s.spare[i] = 0; s.xp[i] = 0; s.shiny[i] = 0 end
local zero = { __index = function() return 0 end }
setmetatable(s.lvl, zero); setmetatable(s.spare, zero); setmetatable(s.xp, zero); setmetatable(s.shiny, zero)
return s
end
local OLDN = 51
local function serialize()
return table.concat({
"CPQ5",
table.concat(S.lvl, ",", 1, OLDN), table.concat(S.spare, ",", 1, OLDN), table.concat(S.xp, ",", 1, OLDN),
table.concat({ S.coins, S.dust, S.stage, S.wins, S.packs, S.earned, S.tower, S.evolved, S.setmask, S.deck[1], S.deck[2], S.deck[3] }, ","),
C.ser(S.camp),
table.concat(S.shiny, ",", 1, OLDN),
}, "|")
end
local function ser_cards2()
local t = {}
for _, arr in ipairs({ S.lvl, S.spare, S.xp, S.shiny }) do
local r = {}
for c = OLDN + 1, D.ncards do r[#r + 1] = arr[c] or 0 end
t[#t + 1] = table.concat(r, ",")
end
return table.concat(t, "|")
end
local function load_cards2(s)
local raw = smudge.load("cards2", "")
if not raw or raw == "" then return end
local parts = split(raw, "|")
for k, arr in ipairs({ s.lvl, s.spare, s.xp, s.shiny }) do
local v = split(parts[k] or "", ",")
for i = 1, math.min(#v, D.ncards - OLDN) do arr[OLDN + i] = tonumber(v[i]) or 0 end
end
end
local function load_state()
local s = new_state()
local raw = smudge.load("save", "")
if raw and raw ~= "" then
local p = split(raw, "|")
if (p[1] == "CPQ2" or p[1] == "CPQ3" or p[1] == "CPQ4" or p[1] == "CPQ5") and #p >= 5 then
local a, b, c, d = split(p[2], ","), split(p[3], ","), split(p[4], ","), split(p[5], ",")
local old = (#a == 24 and #b == 24 and #c == 24)
local old40 = (#a == 40 and #b == 40 and #c == 40)
local old48 = (#a == 48 and #b == 48 and #c == 48)
local old49 = (#a == 49 and #b == 49 and #c == 49)
local old51 = (#a == 51 and #b == 51 and #c == 51)
if (old or old40 or old48 or old49 or old51 or (#a == D.ncards and #b == D.ncards and #c == D.ncards)) and #d >= 5 then
local tmap = { [0] = 0, [1] = 2, [2] = 3 }
for i = 1, #a do
local j = i
if old then j = tmap[(i - 1) // 8] * 8 + (i - 1) % 8 + 1 end
if old40 and i > 32 then j = i + 8 end
s.lvl[j] = tonumber(a[i]) or 0
s.spare[j] = tonumber(b[i]) or 0
s.xp[j] = tonumber(c[i]) or 0
end
s.coins = tonumber(d[1]) or D.start_coins
s.dust = tonumber(d[2]) or 0
s.stage = tonumber(d[3]) or 1
s.wins = tonumber(d[4]) or 0
s.packs = tonumber(d[5]) or 0
if (p[1] == "CPQ4" or p[1] == "CPQ5") and p[6] then s.camp = C.deser(p[6]) end
s.earned = tonumber(d[6]) or 0; s.tower = tonumber(d[7]) or 0; s.evolved = tonumber(d[8]) or 0
s.setmask = tonumber(d[9]) or 0
for i = 1, 3 do s.deck[i] = tonumber(d[9 + i]) or 0 end
if p[7] then
local sh = split(p[7], ",")
if #sh == D.ncards or #sh == 48 or #sh == 49 or #sh == 51 then for i = 1, #sh do s.shiny[i] = tonumber(sh[i]) or 0 end end
if #sh == 40 then for i = 1, #sh do s.shiny[i > 32 and i + 8 or i] = tonumber(sh[i]) or 0 end end
end
load_cards2(s)
if old40 then
local m = s.setmask
s.setmask = (m & 15) | (((m >> 4) & 1) << 5) | ((m >> 5) << 6)
for i = 1, 3 do if s.deck[i] > 32 then s.deck[i] = s.deck[i] + 8 end end
local cp = s.camp
if cp.pet > 32 then cp.pet = cp.pet + 8 end
for k = 1, 2 do if cp.exp[k][1] > 32 then cp.exp[k][1] = cp.exp[k][1] + 8 end end
end
end
end
end
return s
end
local function save_now()
SAVE_PENDING = false
smudge.save("save", serialize())
smudge.save("cards2", ser_cards2())
smudge.save("stamp", string.format("%d %d", tonumber(smudge.time and smudge.time() or os.time()) or 0, S and math.floor(S.coins or 0) or 0))
dirty = false
end
SAVE_PENDING = false
function GLASS_CUT(x, y, w, h)
if smudge.glass_sprite_quad then
smudge.glass_sprite_quad("art/one_m.raw", 8, 8, x, y, x + w, y, x + w, y + h, x, y + h, -1, 0, 0)
end
end
function CS_FLUSH() if SAVE_PENDING and S then save_now() end end
local function found_count()
local n = 0
for i = 1, D.ncards do if S.lvl[i] > 0 then n = n + 1 end end
return n
end
local function spare_total()
local n = 0
for i = 1, D.ncards do n = n + S.spare[i] end
return n
end
local function base_stats(c)
local e, t = elem_of(c), tier_of(c) + 1
return D.elem_atk[e] + D.tier_atk[t], D.elem_hp[e] + D.tier_hp[t]
end
local function tier_done(t)
for k = 1, 8 do if S.lvl[t * 8 + k] < 1 then return false end end
return true
end
local function elem_done(e)
for t = 0, 5 do if S.lvl[t * 8 + e] < 1 then return false end end
return true
end
local function sets_done()
local n = 0
for t = 0, 5 do if tier_done(t) then n = n + 1 end end
for e = 1, 8 do if elem_done(e) then n = n + 1 end end
return n
end
local function shiny_count()
local n = 0
for i = 1, D.ncards do if S.shiny[i] == 1 and S.lvl[i] > 0 then n = n + 1 end end
return n
end
local function in_deck(c) for i = 1, 3 do if S.deck[i] == c then return true end end return false end
local DX = { mast = {} }
function DX.load()
DX.mast = {}
for c, n in (smudge.load("mastery", "") or ""):gmatch("(%d+):(%d+)") do DX.mast[tonumber(c)] = tonumber(n) end
end
function DX.save()
local t = {}
for c, n in pairs(DX.mast) do if n > 0 then t[#t + 1] = c .. ":" .. n end end
table.sort(t)
smudge.save("mastery", table.concat(t, ";"))
end
function DX.m(c) return DX.mast[c] or 0 end
DX.MBASE = { 100, 150, 200, 300, 400, 600, 800 }
function DX.mcost(c) return DX.MBASE[tier_of(c) + 1] * (DX.m(c) + 1) end
DX.SHINY = { 200, 350, 600, 1000, 1600, 3000, 5000 }
DX.COVERS = { "Dragon scale", "Moonlight", "Rune wood", "Crystal stone" }
DX.STANDS = { "Laurel", "Stone", "Crystal", "Crown" }
DX.CPRICE, DX.SPRICE = 1500, 800
function DX.cload()
local v = smudge.load("cosm", "") or ""
DX.cv = tonumber(v:match("cv:(%d)")) or 0; DX.sd = tonumber(v:match("sd:(%d)")) or 0
DX.oc = v:match("oc:(%d+)") or "0000"; DX.os = v:match("os:(%d+)") or "0000"
end
function DX.csave() smudge.save("cosm", string.format("cv:%d;sd:%d;oc:%s;os:%s", DX.cv, DX.sd, DX.oc, DX.os)) end
function DX.cover() if not DX.cv then DX.cload() end return (DX.cv > 0) and ("art/bc" .. DX.cv) or "art/bind_cover" end
function DX.stand() if not DX.sd then DX.cload() end return (DX.sd > 0) and ("art/sd" .. DX.sd) or "art/stand" end
local function card_stats(c)
local a, h = base_stats(c)
local lv = S.lvl[c]
if lv < 1 then lv = 1 end
a = a + 2 * (lv - 1); h = h + 4 * (lv - 1)
local ts = 0
for t = 0, 5 do if tier_done(t) then ts = ts + 1 end end
a = a + ts; h = h + 2 * ts
if elem_done(elem_of(c)) then a = a + 2 end
if GR then a = a + GR.atk(c) end
if S.shiny[c] == 1 then a = a + 1; h = h + 2 end
if DX.m(c) > 0 then a = a + DX.m(c); h = h + 2 * DX.m(c) end
if EVO.n(c) > 0 then a = a + 2 * EVO.n(c); h = h + 4 * EVO.n(c) end
if in_deck(c) then
local n = 0
for i = 1, 3 do local d = S.deck[i]; if d ~= 0 and d ~= c and S.lvl[d] > 0 then n = n + 1 end end
a = a + n; h = h + 2 * n
end
if C and C.gear then
local ga, gh = C.gear(S)
a = a + ga; h = h + gh
end
if C and C.asc_bonus then local aa, ah = C.asc_bonus(c); a = a + aa; h = h + ah end
return a, h
end
do
local raw_draw, MASK = smudge.draw_sprite, {}
local function mask_for(path)
local m = MASK[path]
if m == nil then
local n = path:match("^art/(.-)%.raw$")
m = false
if n and (n:match("^it_") or n:match("^ui_") or n:match("^i_") or n:match("^sk%d+$") or n:match("^[eah]%d+$")) then m = "art/" .. n .. "_m.raw" end
MASK[path] = m
end
return m or nil
end
if raw_draw then
smudge.draw_sprite = function(x, y, w, h, path, mask)
return raw_draw(x, y, w, h, path, mask or (path and mask_for(path)))
end
end
end
local MAXCASH = 2000000000
local function add_coins(n) S.coins = math.max(0, math.min(MAXCASH, S.coins + n)); if n > 0 then S.earned = math.min(MAXCASH, S.earned + n) end end
local function add_dust(n) S.dust = math.max(0, math.min(MAXCASH, S.dust + n)) end
local function short(n)
n = math.floor(n or 0)
if n < 100000 then return tostring(n) end
if n < 1000000 then return (string.format("%.1fK", n / 1000):gsub("%.0K", "K")) end
if n < 1000000000 then return (string.format("%.1fM", n / 1000000):gsub("%.0M", "M")) end
return string.format("%.2fB", n / 1000000000)
end
local function roll_card(slot, rare, elem, mint)
local sodds = (mint == 3) and 1000000 or 10000000
if not elem and rnd(1, sodds) == 1 then local l = D.tier_cards[6]; return l[rnd(1, #l)] end
local r = rnd(1, 1000)
local t
if mint == 3 then
t = (r <= 750) and 3 or ((r <= 950) and 4 or 5)
elseif rare or mint == 2 then
t = (r <= 700) and 2 or ((r <= 930) and 3 or ((r <= 985) and 4 or 5))
elseif slot == 3 then
t = (r <= 470) and 1 or ((r <= 810) and 2 or ((r <= 960) and 3 or ((r <= 990) and 4 or 5)))
else
t = (r <= 550) and 0 or ((r <= 800) and 1 or ((r <= 935) and 2 or ((r <= 980) and 3 or ((r <= 995) and 4 or 5))))
end
return D.pick(t, elem, rnd)
end
local function give_card(c)
if S.lvl[c] == 0 then
S.lvl[c] = 1; S.xp[c] = 0
return true
end
if S.spare[c] < D.max_spare then S.spare[c] = S.spare[c] + 1 end
return false
end
local function merge_one(c)
if S.spare[c] < 1 or S.lvl[c] < 1 or S.lvl[c] >= D.max_level then return false end
S.spare[c] = S.spare[c] - 1
S.xp[c] = S.xp[c] + D.xp_value[tier_of(c) + 1]
local leveled = false
while S.lvl[c] < D.max_level and S.xp[c] >= D.xp_need[S.lvl[c]] do
S.xp[c] = S.xp[c] - D.xp_need[S.lvl[c]]
S.lvl[c] = S.lvl[c] + 1
leveled = true
end
if S.lvl[c] >= D.max_level then S.xp[c] = 0 end
return true, leveled
end
local function spare_action(kind)
local c = sel
if S.spare[c] < 1 then note = "No spare copies."; return end
local n, gained, leveled = 0, 0, false
local limit = all_mode and S.spare[c] or 1
for _ = 1, limit do
if S.spare[c] < 1 then break end
if kind == "sell" then
S.spare[c] = S.spare[c] - 1
local v = D.sell_value[tier_of(c) + 1]
add_coins(v); gained = gained + v; n = n + 1
elseif kind == "dust" then
S.spare[c] = S.spare[c] - 1
local v = D.dust_value[tier_of(c) + 1]
add_dust(v); gained = gained + v; n = n + 1
else
local ok, lv = merge_one(c)
if not ok then break end
n = n + 1
if lv then leveled = true end
end
end
if n == 0 then
note = (kind == "merge") and "This card is already at max level." or "Nothing to do."
elseif kind == "sell" then
note = string.format("Sold %d for %d coins.", n, gained)
SND.play(n > 2 and "coins" or "coin", 0.6)
elseif kind == "dust" then
note = string.format("Broke up %d for %d dust.", n, gained)
SND.play("buy", 0.6)
else
note = leveled and string.format("Merged %d - LEVEL UP! Now level %d.", n, S.lvl[c])
or string.format("Merged %d copies into xp.", n)
if leveled then SND.play("levelup", 0.7) end
end
save_now()
end
function SELL_SPARES(dry)
local n, coins = 0, 0
for c = 1, D.ncards do
local k = S.spare[c] or 0
if k > 0 then
n = n + k; coins = coins + k * D.sell_value[tier_of(c) + 1]
if not dry then S.spare[c] = 0 end
end
end
if not dry and n > 0 then add_coins(coins); save_now(); SND.play("coins", 0.7) end
return n, coins
end
EVO = { e = {}, MAX = 3, BASE = { 30, 60, 120, 250, 500, 800 } }
function EVO.load()
EVO.e = {}
for c, n in (smudge.load("evolve", "") or ""):gmatch("(%d+):(%d+)") do EVO.e[tonumber(c)] = tonumber(n) end
end
function EVO.save()
local t = {}
for c, n in pairs(EVO.e) do if n > 0 then t[#t + 1] = c .. ":" .. n end end
table.sort(t)
smudge.save("evolve", table.concat(t, ";"))
end
function EVO.n(c) return EVO.e[c] or 0 end
function EVO.cost(c) return (EVO.BASE[tier_of(c) + 1] or 800) * (EVO.n(c) + 1) end
EVO.SW, EVO.LW = { 16, 24, 24 }, { 24, 40, 48 }
EVO.SD, EVO.LD = { 10, 19, 21 }, { 19, 38, 43 }
function EVO.spr(c, big)
local n = EVO.n(c)
if n < 1 then return nil end
n = math.min(n, 3)
if big then return "art/evo" .. n .. "_l", EVO.LW[n], 32, EVO.LD[n] end
return "art/evo" .. n, EVO.SW[n], 16, EVO.SD[n]
end
function EVO.badge(x, yb, c, big)
local p, w, h, dw = EVO.spr(c, big)
if not p then return end
local pad = big and 4 or 3
local tw3, th = dw + 2 * pad, h + 2 * pad
smudge.rounded_rect(x, yb - th, tw3, th, big and 6 or 4, true, 1, false)
smudge.rounded_rect(x, yb - th, tw3, th, big and 6 or 4, false, big and 2 or 1)
smudge.draw_sprite(x + pad, yb - th + pad, w, h, p .. ".raw", p .. "_m.raw")
end
function EVO.quad(c, big, L, col)
local p, w, h, dw = EVO.spr(c, big)
if not p then return end
local pad = big and 4 or 3
local a1, b1 = L(-pad, -pad); local a2, b2 = L(dw + pad, -pad); local a3, b3 = L(dw + pad, h + pad); local a4, b4 = L(-pad, h + pad)
smudge.fill_quad(a1, b1, a2, b2, a3, b3, a4, b4, false, col)
for _, e in ipairs({ { a1, b1, a2, b2 }, { a2, b2, a3, b3 }, { a3, b3, a4, b4 }, { a4, b4, a1, b1 } }) do
smudge.line(math.floor(e[1] + 0.5), math.floor(e[2] + 0.5), math.floor(e[3] + 0.5), math.floor(e[4] + 0.5), big and 2 or 1)
end
local q1, q2 = L(0, 0); local q3, q4 = L(w, 0); local q5, q6 = L(w, h); local q7, q8 = L(0, h)
smudge.draw_sprite_quad(p .. ".raw", w, h, q1, q2, q3, q4, q5, q6, q7, q8, p .. "_m.raw")
end
function CHAT_READY()
if not (smudge.pet_chat_card and smudge.pet_chat) then return false end
local ok, c = pcall(smudge.pet_chat)
return ok and type(c) == "table" and c.setup and true or false
end
function CHAT_CARD_LINE(c)
local t = D.tiers[tier_of(c) + 1]
local l = t:sub(1, 1) .. t:sub(2):lower() .. " - level " .. (S.lvl[c] or 0)
if EVO.n(c) > 0 then l = l .. ", evolve " .. EVO.n(c) end
if S.shiny[c] == 1 then l = l .. ", shiny" end
return l
end
GIFTC = nil
function CHAT_GIFT(c)
if (S.spare[c] or 0) < 1 then note = "You need a spare copy to give away."; return end
if not (GIFTC and GIFTC[1] == c and smudge.millis() - GIFTC[2] < 4000) then GIFTC = { c, smudge.millis() }; return end
GIFTC = nil
local ok, sent = pcall(smudge.pet_chat_card, "gift", c, cname(c), D.tiers[tier_of(c) + 1]:sub(1, 1) .. D.tiers[tier_of(c) + 1]:sub(2):lower())
if not (ok and sent) then note = "The gift could not be wrapped: your copy stays here. Try again."; return end
S.spare[c] = S.spare[c] - 1; save_now()
note = "Gift sent: " .. cname(c) .. " is wrapped and waiting in the chat."
end
function CHAT_GIFT_IN()
if not smudge.pet_chat_gift then return end
local ok, g = pcall(smudge.pet_chat_gift)
if not ok or type(g) ~= "table" or not g.id then return end
local got = smudge.load("chatgot", "") or ""
local c = tonumber(g.c) or 0
if not got:find("," .. g.id .. ",", 1, true) and c >= 1 and c <= D.ncards then
local new = give_card(c)
local keep = ("," .. g.id .. got):sub(1, 3000)
smudge.save("chatgot", keep:sub(-1) == "," and keep or (keep .. ","))
note = "Gift opened: " .. cname(c) .. (new and " - a NEW card!" or " (a spare copy)")
SND.play("gift", 0.75)
save_now()
end
smudge.pet_chat_gift_done(g.id)
end
ADVENT = {}
ADVENT.R = {
{ "coins", 200 }, { "dust", 60 }, { "ticket", 1 }, { "coins", 300 }, { "dust", 80 }, { "card", 1 },
{ "coins", 400 }, { "ticket", 1 }, { "dust", 100 }, { "coins", 500 }, { "rticket", 1 }, { "card", 2 },
{ "coins", 600 }, { "dust", 150 }, { "ticket", 2 }, { "coins", 700 }, { "dust", 200 }, { "card", 3 },
{ "coins", 800 }, { "rticket", 1 }, { "dust", 250 }, { "ticket", 2 }, { "coins", 1000 }, { "card", 4 },
}
function ADVENT.date()
if ADVENT_DATE then return ADVENT_DATE[1], ADVENT_DATE[2], ADVENT_DATE[3] end
local t = (smudge.time and tonumber(smudge.time())) or os.time()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.year then return d.year, d.month, d.day end
return 0, 0, 0
end
function ADVENT.on() local _, m = ADVENT.date(); return m == 12 end
function ADVENT.mask()
local y = ADVENT.date()
local sy, sm = (smudge.load("advent", "") or ""):match("^(%d+):(%d+)$")
return (tonumber(sy) == y) and (tonumber(sm) or 0) or 0
end
function ADVENT.is_open(d) return (ADVENT.mask() >> (d - 1)) & 1 == 1 end
function ADVENT.can(d) local _, m, day = ADVENT.date(); return m == 12 and d <= day and d <= 24 and not ADVENT.is_open(d) end
function ADVENT.waiting()
if not ADVENT.on() then return nil end
for d = 1, 24 do if ADVENT.can(d) then return d end end
end
function ADVENT.text(d)
local r = ADVENT.R[d]
if r[1] == "coins" then return "+" .. r[2] .. " coins" end
if r[1] == "dust" then return "+" .. r[2] .. " dust" end
if r[1] == "ticket" then return r[2] == 1 and "pack ticket" or (r[2] .. " pack tickets") end
if r[1] == "rticket" then return "rare ticket" end
local c = tonumber(smudge.load("advcard" .. d, "") or "")
if c then return cname(c) end
return "Frostfall " .. D.tiers[r[2] + 1]:lower()
end
function ADVENT.open(d)
if not ADVENT.can(d) then return nil end
local y = ADVENT.date()
smudge.save("advent", y .. ":" .. (ADVENT.mask() | (1 << (d - 1))))
local r, c, new = ADVENT.R[d], nil, false
if r[1] == "coins" then add_coins(r[2])
elseif r[1] == "dust" then S.dust = S.dust + r[2]
elseif r[1] == "ticket" then S.camp.tickets = S.camp.tickets + r[2]
elseif r[1] == "rticket" then S.camp.rtickets = (S.camp.rtickets or 0) + r[2]
else
local t = r[2]
if d == 24 and math.random(1, 10) == 1 then t = 5 end
c = 102 + t * 8 + math.random(1, 8)
new = give_card(c)
smudge.save("advcard" .. d, tostring(c))
end
save_now()
ADVENT.pop = { d = d, c = c, new = new, t = smudge.millis() }
SND.play("door", 0.75)
return true
end
local function evolve(c)
local t = tier_of(c)
if t >= 6 then note = "Secret cards cannot evolve."; return end
if S.lvl[c] < D.max_level then note = "Only max level cards can evolve."; return end
if EVO.n(c) >= EVO.MAX then note = cname(c) .. " is fully evolved."; return end
local cost = EVO.cost(c)
if S.spare[c] < 3 then note = "Evolving needs 3 spare copies."; return end
if S.dust < cost then note = string.format("Need %d dust.", cost); return end
S.spare[c] = S.spare[c] - 3
S.dust = S.dust - cost
EVO.e[c] = EVO.n(c) + 1; EVO.save()
S.evolved = S.evolved + 1
EVO.fx = { c = c, t = smudge.millis() }
SND.last.pull_exotic = smudge.millis()
if VIB and VIB.play then pcall(VIB.play, "t4") end
SND.play("evolve", 0.8)
note = string.format("%s evolved! Stage %d/%d: +2 ATK, +4 HP.", cname(c), EVO.n(c), EVO.MAX)
save_now()
end
local function craft_card(c)
local cost = D.craft_cost[tier_of(c) + 1]
if S.lvl[c] > 0 or tier_of(c) == 6 then return end
if S.dust < cost then note = string.format("Need %d dust (you have %d).", cost, S.dust); return end
S.dust = S.dust - cost
S.lvl[c] = 1; S.xp[c] = 0; S.spare[c] = 0
note = "Crafted " .. cname(c) .. "!"
save_now()
end
local function ename() return (B and B.ename) or cname(B.ec) end
local function eelem() return (B and B.eel) or elem_of(B.ec) end
local function blog(msg)
local l = B.log
l[#l + 1] = msg
if #l > 4 then table.remove(l, 1) end
end
local function calc_dmg(atk, ae, de)
local d = atk + rnd(0, 2)
local eff = 0
if D.beats[ae] == de then d = d * 2; eff = 1
elseif D.beats[de] == ae then d = math.max(1, d // 2); eff = 2 end
return d, eff
end
local function eff_text(eff)
if eff == 1 then return " Super effective!" end
if eff == 2 then return " Not very effective." end
return ""
end
local function new_enemy()
local boss = (S.stage % 5 == 0)
local t
if boss then t = (S.stage >= 60) and 5 or ((S.stage >= 40) and 4 or 3)
else t = (S.stage < 6) and 0 or ((S.stage < 12) and 1 or ((S.stage < 22) and 2 or ((S.stage < 40) and 3 or ((S.stage < 70) and 4 or 5)))) end
local ec = D.pick(t, nil, rnd)
local ea, eh = base_stats(ec)
ea = ea + S.stage // 4 + (boss and 3 or 0)
eh = eh + S.stage
if boss then eh = eh + eh // 2 end
PE = { ec = ec, ea = ea, eh = eh, boss = boss }
end
local function new_tower_enemy(f)
local boss = (f % 10 == 0)
local t = math.min(5, 1 + f // 9)
if boss then t = math.min(5, t + 1) end
local ec = D.pick(t, nil, rnd)
local ea, eh = base_stats(ec)
ea = ea + f // 2 + (boss and 3 or 0)
eh = eh + f * 2
if boss then eh = eh + eh // 2 end
PE = { ec = ec, ea = ea, eh = eh, boss = boss, tower = f }
end
local function mult(ae, de)
if D.beats[ae] == de then return 2 end
if D.beats[de] == ae then return 0.5 end
return 1
end
local function mult_txt(m) return (m == 2) and "x2" or ((m == 0.5) and "x1/2" or "x1") end
local function start_battle(pc)
if GR and GR.busy(pc) then note = cname(pc) .. " is away for grading."; return end
if not PE then new_enemy() end
local pa, ph = card_stats(pc)
pa = pa + C.take_power(S)
local ec, ea, eh, boss = PE.ec, PE.ea, PE.eh, PE.boss
B = { pc = pc, ec = ec, patk = pa, pmax = ph, php = ph, eatk = ea, emax = eh, ehp = eh,
energy = 0, guard = false, boss = boss, log = {}, busy = false, over = false, win = false,
reward = 0, retreat = false, stage = S.stage, tower = PE.tower, duel = PE.duel,
art = PE.art, lair = PE.lair, wild = PE.wild, wb = PE.wb, wbstart = PE.wb and eh or nil, ename = PE.name, eel = PE.eelem, eturn = 0, prot = false,
ps = { burn = 0, regen = 0 }, es = { burn = 0, regen = 0 } }
if C and C.world_mult then
B.patk = math.floor(B.patk * C.world_mult(elem_of(pc)) + 0.5)
B.eatk = math.floor(B.eatk * C.world_mult(PE.eelem or elem_of(ec)) + 0.5)
end
if B.wb then blog("World boss " .. PE.name .. "! Hit it hard for 10 turns.")
elseif B.lair then blog(PE.name .. " awakens!")
elseif B.wild then blog("A player-killer attacks you in the Wilderness!")
else blog(boss and "A BOSS blocks the way!" or "A wild card appears!") end
scr = "battle"; focus = 1; note = ""
end
local function end_battle(win)
B.over = true; B.win = win; B.busy = false
if B.duel then
B.reward = 0
F.duel_end(win)
blog(win and "Round won!" or "Round lost...")
return
end
if B.lair or B.wild or B.wb then
C.adv_end(S, B, win)
if B.wb then win = B.win end
if win then S.wins = S.wins + 1; C.on_win(S, eelem(), tier_of(B.ec)); blog("Victory!") else blog("You were defeated...") end
save_now()
return
end
if win then
if B.tower then
local f = B.tower
if f > S.tower then
local coins = 4 + f // 2
B.reward = coins
local dust = f // 4
if f % 10 == 0 then
dust = dust + f
B.scales = C.boss_drop(S)
if f % 20 == 0 then S.camp.rtickets = S.camp.rtickets + 1; B.bonus = "RARE ticket!"
else S.camp.tickets = S.camp.tickets + 1; B.bonus = "Pack ticket!" end
end
if dust > 0 then add_dust(dust); B.dust = dust end
S.tower = f
B.reward = math.floor(coins * C.fort_mult(S))
else
B.reward = 1
end
else
B.reward = math.floor((10 + S.stage // 2 + (B.boss and 10 or 0)) * C.fort_mult(S))
if B.boss then B.scales = C.boss_drop(S) end
if S.stage < 99 then S.stage = S.stage + 1 end
end
add_coins(B.reward)
S.wins = S.wins + 1
C.on_win(S, eelem(), tier_of(B.ec))
blog("Victory!")
else
B.reward = 2
add_coins(2)
blog("You were defeated...")
end
save_now()
end
local function stt(t)
local s = ""
if t.burn > 0 then s = s .. " BURN" end
if t.soak then s = s .. " SOAK" end
if t.shield then s = s .. " ROCK" end
if t.stun then s = s .. " STUN" end
if t.conf then s = s .. " DAZE" end
if t.regen > 0 then s = s .. " REGEN" end
return s
end
local function hp_add(side, n)
if side == "p" then B.php = math.max(0, math.min(B.pmax, B.php + n))
else B.ehp = math.max(0, math.min(B.emax, B.ehp + n)) end
end
local function proc(att, ae, dmg)
if rnd(1, 100) > 25 then return end
local vic = (att == "p") and "e" or "p"
local A, V = B[att .. "s"], B[vic .. "s"]
local who = (att == "p") and cname(B.pc) or ename()
local vwho = (att == "p") and ename() or cname(B.pc)
if ae == 1 then V.burn = 3; blog(vwho .. " is burning!")
elseif ae == 2 then V.soak = true; blog(vwho .. " is soaked: weaker next hit.")
elseif ae == 3 then A.shield = true; blog(who .. " hides behind rock.")
elseif ae == 4 then
if B.boss and vic == "e" and rnd(1, 2) == 1 then blog(vwho .. " shrugs off the shock.")
else V.stun = true; blog(vwho .. " is stunned!") end
elseif ae == 5 then
local h = math.max(1, dmg // 2)
hp_add(att, h); blog(who .. " drains " .. h .. " HP.")
elseif ae == 6 then
local h = math.max(2, ((att == "p") and B.pmax or B.emax) // 5)
hp_add(att, h); blog(who .. " glows and heals " .. h .. ".")
elseif ae == 7 then A.regen = 3; blog(who .. " starts to regrow.")
else V.conf = true; blog(vwho .. " is dazed.") end
end
local function ability()
if tier_of(B.pc) == 4 then return elem_of(B.pc) end
return nil
end
local function enemy_turn()
if not B or B.over then return end
local E, P = B.es, B.ps
local ab = ability()
if E.burn > 0 then
E.burn = E.burn - 1; B.ehp = math.max(0, B.ehp - 2); blog(ename() .. " burns for 2.")
if B.ehp <= 0 then end_battle(true); redraw(); return end
end
if E.regen > 0 then E.regen = E.regen - 1; hp_add("e", 2) end
if E.stun then
E.stun = false; blog(ename() .. " cannot move!"); B.busy = false; redraw(); return
end
if E.conf then
E.conf = false
if rnd(1, 2) == 1 then blog(ename() .. " misses wildly!"); B.busy = false; redraw(); return end
end
if ab == 8 and rnd(1, 100) <= 30 then
blog("Lucid Haze: " .. ename() .. " loses track of you!"); B.busy = false; redraw(); return
end
B.eturn = B.eturn + 1
local L, T = B.lair, B.eturn
if B.wb and T > 10 then blog(ename() .. " knocks you back!"); end_battle(false); redraw(); return end
if B.wb and T % 4 == 0 then B.wbslam = true end
if L == 2 and T % 2 == 0 then hp_add("e", 8); blog(ename() .. " heals 8 HP.") end
if L == 7 then hp_add("e", 4); blog(ename() .. " regrows 4 HP.") end
if L == 3 and T % 4 == 0 then B.burrow = true; blog(ename() .. " burrows underground!"); B.busy = false; redraw(); return end
if L == 8 and T % 3 == 0 then E.shield = true; P.conf = true; blog(ename() .. " shields itself and dazes you!") end
local d, eff = calc_dmg(B.eatk, eelem(), elem_of(B.pc))
if B.wbslam then B.wbslam = false; d = d * 2; blog("SPECIAL ATTACK!") end
if (L == 1 or L == 9) and T % 3 == 0 then
if C.has_ads(S) then blog("Your Anti-dragon shield blocks the dragonfire!")
else d = d * 2; blog("DRAGONFIRE!") end
end
if B.prot then
if C.pray_drain(S) then d = math.max(1, d // 2) else B.prot = false; blog("You have run out of prayer points.") end
end
if ab == 3 then d = math.max(1, d - 3) end
if E.soak then d = math.max(1, d // 2); E.soak = false end
if B.guard then d = math.max(1, d // 2); B.guard = false end
if P.shield then d = math.max(1, d // 2); P.shield = false end
B.php = math.max(0, B.php - d)
B.fxe = { k = "lunge", t = smudge.millis() }; B.fxp = { k = "hit", t = smudge.millis() + 180 }
blog(string.format("%s hits you for %d.%s", ename(), d, eff_text(eff)))
if L == 5 then local h = math.max(1, d // 2); hp_add("e", h); blog("The Sire drains " .. h .. " HP.") end
if L == 4 then B.eel = rnd(1, 8); blog(ename() .. " changes to " .. D.elems[B.eel] .. "!") end
B.busy = false
if ab == 7 and B.php > 0 then
B.ehp = math.max(0, B.ehp - 2); blog("Thornbark reflects 2 damage.")
if B.ehp <= 0 then end_battle(true); redraw(); return end
end
if B.php <= 0 then
if ab == 6 and not B.revived then
B.revived = true; B.php = math.max(1, B.pmax // 2); blog("Second Dawn! You rise again.")
else end_battle(false) end
else proc("e", eelem(), d) end
redraw()
end
local function player_act(kind)
if not B or B.over or B.busy then return end
if kind == "special" and B.energy < 3 then note = "Special needs 3 energy."; return end
note = ""
local P, E = B.ps, B.es
local ab = ability()
if ab == 2 then hp_add("p", 3) end
if P.burn > 0 then
P.burn = P.burn - 1; B.php = math.max(0, B.php - 2); blog("You burn for 2.")
if B.php <= 0 then end_battle(false); redraw(); return end
end
if P.regen > 0 then P.regen = P.regen - 1; hp_add("p", 2) end
if P.stun then
P.stun = false; blog("You are stunned and lose the turn!")
B.busy = true
if SAVER then enemy_turn() else after(700, enemy_turn) end
redraw(); return
end
if kind == "guard" then
local heal = math.max(2, B.pmax // 8)
B.php = math.min(B.pmax, B.php + heal)
B.guard = true
B.fxp = { k = "guard", t = smudge.millis() }
B.energy = math.min(5, B.energy + 1)
blog(string.format("You guard and recover %d HP.", heal))
else
local atk = B.patk
if kind == "special" then atk = atk * 2; B.energy = B.energy - 3
else B.energy = math.min(5, B.energy + 1) end
local d, eff = calc_dmg(atk, elem_of(B.pc), eelem())
if P.soak then d = math.max(1, d // 2); P.soak = false end
local miss = false
if P.conf then P.conf = false; if rnd(1, 2) == 1 then miss = true end end
if E.shield then d = math.max(1, d // 2); E.shield = false end
if B.lair == 6 and mult(elem_of(B.pc), eelem()) < 2 then d = math.max(1, d // 2) end
local dug = false
if B.burrow then B.burrow = false; miss = true; dug = true end
local now = smudge.millis()
B.fxp = { k = "lunge", t = now }
if dug then blog("The mole is underground. Your hit finds only dirt!")
elseif miss then blog("You swing wildly and miss!")
else
B.fxe = { k = "hit", t = now + 180 }
B.ehp = math.max(0, B.ehp - d)
blog(string.format("%s %s for %d.%s", cname(B.pc), (kind == "special") and "unleashes" or "strikes", d, eff_text(eff)))
if ab == 4 and B.ehp > 0 and rnd(1, 100) <= 30 then
B.ehp = math.max(0, B.ehp - d); blog("Double Strike! Another " .. d .. ".")
end
if ab == 5 then local h = math.max(1, d // 2); hp_add("p", h); blog("Eclipse Bite drains " .. h .. " HP.") end
if ab == 1 and B.ehp > 0 then E.burn = 3 end
if B.ehp > 0 then proc("p", elem_of(B.pc), d) end
end
end
if B.ehp <= 0 then
end_battle(true)
else
B.busy = true
if SAVER then enemy_turn() else after(700, enemy_turn) end
end
redraw()
end
local function open_pack(free, rare, elem, count, mint)
count = count or 1
local iron = C and C.is_iron and C.is_iron()
if iron and ((count > 1 and free ~= true) or elem or (not rare and free ~= true)) then
note = "Iron Mode: no buying packs with coins. Use tickets!"; return
end
if count > 1 then
if free == true then
local have = rare and S.camp.rtickets or S.camp.tickets
count = math.min(count, have)
if count < 1 then return end
if rare then S.camp.rtickets = S.camp.rtickets - count else S.camp.tickets = S.camp.tickets - count end
else
local cost = D.pack_cost * count
if S.coins < cost then note = string.format("%d packs cost %d coins.", count, cost); return end
S.coins = S.coins - cost
end
S.packs = S.packs + count
local list = {}
local jack = nil
if CS_FORCE_JACKPOT or rnd(1, 100000) == 1 then
local r = rnd(1, 100)
jack = (r <= 60) and 3 or ((r <= 90) and 4 or 5)
CS_FORCE_JACKPOT = nil
end
for p = 1, count do
for slot = 1, 3 do
local c = jack and D.tier_cards[jack][rnd(1, #D.tier_cards[jack])] or roll_card(slot, free == true and rare or nil)
local sh = rnd(1, 100) <= ((C and C.shiny_pct) and C.shiny_pct() or 3)
local isnew = give_card(c)
if sh then S.shiny[c] = 1 end
list[#list + 1] = { c = c, new = isnew, shiny = sh }
end
end
save_now()
local best = 0
for _, r in ipairs(list) do best = math.max(best, tier_of(r.c)) end
RV = { list = list, idx = 0, fr = 1, best = best, flip = nil, kind = { free, rare, nil, count }, multi = count, jackpot = jack }
scr = "reveal"; focus = 1; note = ""
redraw()
start_opening()
return
end
if mint then
local cost = (mint == 3) and 1200 or 400
if S.dust < cost then note = string.format("This dust pack costs %d dust (you have %d).", cost, S.dust); return end
S.dust = S.dust - cost
elseif elem then
if S.coins < 70 then note = "An element pack costs 70 coins."; return end
S.coins = S.coins - 70
else
if rare then
if S.camp.rtickets < 1 then return end
S.camp.rtickets = S.camp.rtickets - 1
elseif free == true then
if S.camp.tickets < 1 then return end
S.camp.tickets = S.camp.tickets - 1
else
if S.coins < D.pack_cost then
note = string.format("Not enough coins (a pack costs %d).", D.pack_cost)
return
end
S.coins = S.coins - D.pack_cost
end
end
S.packs = S.packs + 1
local list = {}
for slot = 1, 3 do
local c = roll_card(slot, rare, elem, mint)
local sh = rnd(1, 100) <= ((C and C.shiny_pct) and C.shiny_pct() or 3)
local isnew = give_card(c)
if sh then S.shiny[c] = 1 end
list[slot] = { c = c, new = isnew, shiny = sh }
end
save_now()
local best = 0
for i = 1, 3 do best = math.max(best, tier_of(list[i].c)) end
RV = { list = list, idx = 0, fr = 1, best = best, flip = nil, kind = { free, rare, elem, nil, mint } }
scr = "reveal"; focus = 1; note = ""
redraw()
start_opening()
end
local use_focus = false
local go
local function tw(s, f, st) return smudge.text_width(s, f or "ui10", st or "regular") end
local function lh(f) return smudge.line_height(f or "ui10") end
local function ltext(x, y, s, f, st, white) smudge.text(x, y, s, f or "ui10", st or "regular", "left", not white) end
local function ctext(cx, y, s, f, st, white)
ltext(math.floor(cx - tw(s, f, st) / 2), y, s, f, st, white)
end
local function rtext(xr, y, s, f, st) ltext(xr - tw(s, f, st), y, s, f, st) end
local function fit(s, maxw, f, st)
while #s > 1 and tw(s, f, st) > maxw do s = s:sub(1, #s - 1) end
return s
end
local RCLIP = nil
local PH = nil
local function reg(id, x, y, w, h, act, frame)
if RCLIP then
local x0, y0 = math.max(x, RCLIP[1]), math.max(y, RCLIP[2])
local x1, y1 = math.min(x + w, RCLIP[1] + RCLIP[3]), math.min(y + h, RCLIP[2] + RCLIP[4])
if x1 <= x0 or y1 <= y0 then return end
x, y, w, h = x0, y0, x1 - x0, y1 - y0
end
nbtn = nbtn + 1
local b = btns[nbtn]
if not b then b = {}; btns[nbtn] = b end
b.id, b.x, b.y, b.w, b.h, b.act, b.frame = id, x, y, w, h, act, frame
end
local function dither_rr(x, y, w, h, r, dark)
r = math.min(r, w // 2, h // 2)
if r <= 0 then smudge.rect_dither(x, y, w, h, dark); return end
for j = 0, r - 1 do
local d = r - j
local ins = r - math.floor(math.sqrt(r * r - d * d))
smudge.rect_dither(x + ins, y + j, w - 2 * ins, 1, dark)
smudge.rect_dither(x + ins, y + h - 1 - j, w - 2 * ins, 1, dark)
end
smudge.rect_dither(x, y + r, w, h - 2 * r, dark)
end
STONE = true
MONO = false
local function ttint(x, y, w, h, k, mode) if STONE and smudge.tint and not SAVER then smudge.tint(x, y, w, h, k, mode or 3) end end
local TT = { bg = 8, face = 9, ring = 10, top = 11, panel = 12, pop = 13, prog = 14, off = 15, card = 16 }
local function badge_tint(cx, cy, r)
if STONE and smudge.tint_circle and not SAVER then smudge.tint_circle(cx, cy, r, MONO and 11 or 6, 3) end
end
