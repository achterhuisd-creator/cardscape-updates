{ { "Log balance", 1, 5, 0, 2 }, { "Rope swing", 5, 10, 1, 3 }, { "Wall climb", 10, 16, 2, 4 }, { "Rooftops", 15, 25, 3, 6 },
{ "Forest canopy", 25, 40, 5, 9 }, { "Cliff run", 40, 72, 8, 14 }, { "Sky bridges", 60, 125, 12, 20 }, { "Dragon spine", 80, 205, 18, 30 } },
{ { "Villager", 1, 6, 2, 4, 75 }, { "Market stall", 5, 11, 4, 7, 65 }, { "Guard", 10, 17, 6, 10, 55 }, { "Noble", 15, 26, 9, 15, 45 },
