local GOLD_TOP = 0.97
local view = "tree"
local SCN = nil
local HOLD = nil
local SWING = nil
local T = nil
local CHOPS = {}
local CHIPS = {}
local LOGF = nil
local POP = nil
local BIRDS = nil
local function tree(cp) local g = cp.x.wtr or 0; if g < 1 or g > #GATHER then g = 1 end; return g end
local function need(gi) return CH[gi] end
local function cut(cp) return (cp.x.whp or 0) / 100 end
local function block(cp, gi) return H.block(cp, SI, gi) end
local function tier(cp) return math.max(1, math.min(7, H.tool_tier(cp, SI))) end
local function gold(cp) return 0.06 + 0.012 * tier(cp) end
local function period(cp) return 1000 + 40 * tier(cp) end
local function power(cp, t)
local u = ((t - HOLD.t0) % period(cp)) / period(cp)
return u < 0.5 and u * 2 or 2 - u * 2
end
local function zone(cp, p)
if p >= GOLD_TOP - gold(cp) and p <= GOLD_TOP then return "gold" end
if p >= 0.5 then return "good" end
return "weak"
end
local function chips(x, y, dir, n, col, spd)
for k = 1, n do
CHIPS[#CHIPS + 1] = { x = x, y = y, vx = (dir == 0 and (math.random() * 2 - 1) or dir) * (60 + math.random() * 160) * (spd or 1),
vy = -(80 + math.random() * 200) * (spd or 1), t0 = ms(), life = 500 + math.random() * 400, r = col[1], g = col[2], b = col[3], k = col.k, s = 2 + math.random() * 3 }
end
end
local function logs(S, gi)
local cp = S.camp
local g = GATHER[gi]
local n = LOGS[gi]
local bonus = ""
if cp.pet > 0 and X.rnd(1, 100) <= 4 + 3 * X.tier_of(cp.pet) then n = n + 1; bonus = " (pet)" end
ADV.on_action(S, SI)
H.stash(cp, g[4], n)
ADV.on_gain(S, g[4], n)
local perf = cp.x.wpf or 0
local xp = H.xp_amt(cp, fl(g[7] * LOGS[gi] * (1 + 0.1 * math.min(perf, 10)) + 0.5), SI)
local note = string.format("+%d %s%s  (+%d xp%s)", n, ITEMS[g[4]][1], bonus, xp, perf > 1 and (", perfect streak " .. perf) or "")
note = note .. H.rare_drop(S, SI) .. ADV.G.pet_roll(S, SI)
local lvn = H.give_xp(S, SI, xp)
if lvn ~= "" then note = lvn:gsub("^%s+", "") .. "  " .. note end
if ADV.cluenote then note = ADV.cluenote .. "  " .. note; ADV.cluenote = nil end
if H.inv_used() >= H.INV_MAX then note = note .. "  Your inventory is full!" end
cp.stat[1] = cp.stat[1] + 1
cp.x.whp = 0
LOGF = { t0 = ms(), item = g[4], n = n }
snd("wc_grow", 0.55); vib("sf_bolt")
if T then
chips(T.cx, T.top + 40, 0, 16, LEAF[gi], 0.9)
BIRDS = { t0 = ms(), x = T.cx, y = T.top + 30 }
end
X.set_note(note)
X.mark_dirty(); X.save_now()
end
local function chop(S, z)
local cp = S.camp
local gi = tree(cp)
local why = block(cp, gi)
if why then X.set_note(why); return end
if H.inv_room(GATHER[gi][4]) < 1 then X.set_note("Your inventory is too full to hold any more. Tap BANK to deposit."); return end
local t = ms()
local perfect = z == "gold"
local bite = perfect and need(gi) or (z == "good" and 1 or 0.35)
cp.x.whp = math.min(need(gi) * 100, (cp.x.whp or 0) + fl(bite * 100 + 0.5))
cp.x.wpf = perfect and (cp.x.wpf or 0) + 1 or 0
CHOPS[#CHOPS + 1] = { t = t, dir = 1, perfect = perfect, hit = z ~= "weak" }
if #CHOPS > 6 then table.remove(CHOPS, 1) end
local hx, hy = T and T.hitx or 0, T and T.hity or 0
if perfect then
snd("wc_perfect", 0.7); vib("sf_bolt")
POP = { t0 = t, x = hx, y = hy, text = (cp.x.wpf > 1) and ("PERFECT x" .. cp.x.wpf) or "PERFECT!" }
elseif z == "good" then snd("wc_chop", 0.7); vib("sf_click"); POP = { t0 = t, x = hx, y = hy, text = "chop", small = true }
else snd("wc_chop", 0.3); vib("sf_tick"); POP = { t0 = t, x = hx, y = hy, text = "weak", small = true }
X.set_note("A weak chop: let go higher up the bar, in the gold for a perfect one.") end
if T then
chips(hx, hy, 1, perfect and 14 or (z == "good" and 7 or 2), { 190, 140, 80, k = 4 }, perfect and 1.3 or 1)
if z ~= "weak" then chips(T.cx, T.top + 30, 0, perfect and 6 or 2, LEAF[gi], 0.6) end
end
if cp.x.whp >= need(gi) * 100 then logs(S, gi) end
X.mark_dirty()
end
local SS = nil
WOODT = {}
local function let_go()
if not HOLD or not SS then HOLD = nil; return end
local cp = SS.camp
local t = ms()
local p = power(cp, t)
SWING = { t0 = t, p = p, zone = zone(cp, p) }
HOLD = nil
snd("wc_swing", 0.35 + 0.3 * p)
end
function WOODT.touch(ev, x, y)
if not SCN or view ~= "tree" or type(x) ~= "number" or type(y) ~= "number" then return false end
if ev == "down" then
if not SWING and x >= SCN[1] and x < SCN[1] + SCN[3] and y >= SCN[2] and y < SCN[2] + SCN[4] then
HOLD = { t0 = ms() }; busy(); return true
end
return false
end
if not HOLD then return false end
if ev == "release" or ev == "up" or ev == "tap" then let_go(); busy(); return true end
if ev == "move" or ev == "nudge" then return true end
return false
end
local function glassq(x1, y1, x2, y2, x3, y3, x4, y4, r, g, b, a)
if smudge.glass_sprite_quad then smudge.glass_sprite_quad("art/solid_m.raw", 8, 8, x1, y1, x2, y2, x3, y3, x4, y4, r, g, b, a) end
end
local function scene(S, x, y, w, h)
local cp = S.camp
local t = ms()
SS = S
SCN = { x, y, w, h }
local gi = tree(cp)
local gy = y + h - 40
local GH = w * 68 / 432
local gtop = gy + 10 - GH * 0.506
if hd() then
smudge.hires_quad("hd/wc_ground_c.png", x, gtop, x + w, gtop, x + w, gtop + GH, x, gtop + GH)
else
for q = 0, 22 do
local gx = x + 8 + q * (w - 16) / 22
smudge.line(fl(gx), gy, fl(gx - 3), gy - 7, 1); smudge.line(fl(gx + 2), gy, fl(gx + 4), gy - 9, 1)
end
smudge.line(x, gy, x + w, gy, 2)
for q = 0, 5 do smudge.line(fl(x + 20 + q * 74), gy + 14 + (q % 2) * 10, fl(x + 34 + q * 74), gy + 14 + (q % 2) * 10, 1) end
end
local P = PIC[gi]
local sc = math.min((gy - y - 14) / P[2], (w + 40) / P[1])
local pw, ph = P[1] * sc, P[2] * sc
local tx0, ty0 = x + (w - pw) / 2, gy + 8 - ph
T = { P = P, sc = sc, x0 = tx0, y0 = ty0, top = ty0, cx = tx0 + (P[5] + P[6]) / 2 * sc,
yfoot = ty0 + P[3] * sc, ytop = ty0 + P[4] * sc, hitx = T and T.hitx, hity = T and T.hity }
local prog = math.min(1, cut(cp) / need(gi))
local any = false
local ang = 0
local last = CHOPS[#CHOPS]
if LOGF and t - LOGF.t0 < 700 then
local v = t - LOGF.t0
ang = math.sin(v / 50) * 0.05 * math.exp(-v / 220)
busy(); any = true
elseif last and t - last.t < 450 then
local v = t - last.t
ang = math.sin(v / 45) * 0.025 * math.exp(-v / 140) * (last.perfect and 1.8 or 1) * last.dir
busy(); any = true
end
if hd() then
local px, py = tx0 + pw / 2, ty0 + ph
local c, sn = math.cos(ang), math.sin(ang)
local function R(a, b) local dx, dy = a - px, b - py; return px + dx * c - dy * sn, py + dx * sn + dy * c end
local a1, a2 = R(tx0, ty0); local b1, b2 = R(tx0 + pw, ty0); local c1, c2 = R(tx0 + pw, ty0 + ph); local d1, d2 = R(tx0, ty0 + ph)
local nm = string.format("hd/wc_%d_c.png", gi)
smudge.hires_quad(nm, x, y, x + w, y, x + w, gtop, x, gtop, a1, a2, b1, b2, c1, c2, d1, d2)
for _, f in ipairs(FOOT[gi]) do
local ry0, ry1 = ty0 + f[1] * sc, ty0 + (f[1] + 2) * sc
if ry1 > gtop then
ry0 = math.max(ry0, gtop)
for q = 2, #f - 1, 2 do
local lx, rx2 = tx0 + f[q] * sc, tx0 + f[q + 1] * sc
smudge.hires_quad(nm, lx, ry0, rx2, ry0, rx2, ry1, lx, ry1, a1, a2, b1, b2, c1, c2, d1, d2)
end
end
end
else
local tw = P[7] * sc
smudge.rect(fl(T.cx - tw / 2), fl(T.ytop - 20), fl(tw), fl(gy - T.ytop + 20), true)
for _, o in ipairs({ { 0, -60, 80 }, { -50, -20, 50 }, { 50, -20, 50 } }) do
smudge.circle(fl(T.cx + o[1]), fl(T.ytop + o[2]), o[3], true, 1, false); smudge.circle(fl(T.cx + o[1]), fl(T.ytop + o[2]), o[3], false, 2)
end
end
local th = P[7] * sc / 2
local L = 64
local IMPACT = -0.35
local ix, iy = T.cx + th * 0.6 + 7, gy - 70
local hx, hy = ix - math.sin(IMPACT) * L, iy + math.cos(IMPACT) * L
T.hitx, T.hity = ix, iy
local REST, BACK = IMPACT + 0.55, IMPACT + 1.45
local aang = REST + (PHONE and math.sin(t / 700) * 0.03 or 0)
local p = 0
if HOLD then
p = power(cp, t)
aang = REST + (BACK - REST) * math.min(1, (t - HOLD.t0) / 250) * (0.35 + 0.65 * p)
local inGold = zone(cp, p) == "gold"
if inGold and not HOLD.gold then snd("safe_tick", 0.25); vib("sf_tick") end
HOLD.gold = inGold
busy(); any = true
elseif SWING then
local from = REST + (BACK - REST) * (0.35 + 0.65 * SWING.p)
local u = (t - SWING.t0) / 130
if u < 1 then aang = from + (IMPACT - from) * u * u
else
if not SWING.done then SWING.done = true; chop(S, SWING.zone) end
local v = math.min(1, (u - 1) / 1.5)
aang = IMPACT + (REST - IMPACT) * v * v
if u > 2.6 then SWING = nil end
end
busy(); any = true
end
do
local ax, ay = 15 / 21.93, -16 / 21.93
local rx, ry = 16 / 21.93, 15 / 21.93
local k = L / 25
local c, sn = math.cos(aang), math.sin(aang)
local function A(ix2, iy2)
local dx, dy = ix2 - 3.5, iy2 - 27
local along, side = dx * ax + dy * ay, dx * rx + dy * ry
local lx, ly = -side * k, -along * k
return hx + lx * c - ly * sn, hy + lx * sn + ly * c
end
local a1, a2 = A(0, 0); local b1, b2 = A(32, 0); local c1, c2 = A(32, 32); local d1, d2 = A(0, 32)
smudge.set_clip(x, y, w, h)
smudge.draw_sprite_quad("art/sk0.raw", 32, 32, a1, a2, b1, b2, c1, c2, d1, d2, "art/sk0_m.raw")
smudge.set_clip()
end
if PHONE then
local bx, bw2 = fl(x + w - 30), 18
local by, bh = y + 70, h - 150
smudge.rect(bx - 2, by - 2, bw2 + 4, bh + 4, true)
smudge.rect(bx, by, bw2, bh, true, 1, false)
smudge.rect_dither(bx, fl(by + bh / 2), bw2, fl(bh / 2), false)
local gT, gH = fl(by + bh * (1 - GOLD_TOP)), math.max(4, fl(bh * gold(cp)))
smudge.rect(bx, gT, bw2, gH, true)
smudge.tint(bx, gT, bw2, gH, 4, 3)
local cur = HOLD and p or (SWING and SWING.p or 0)
local my = fl(by + bh * (1 - cur))
smudge.rect(bx - 6, my - 2, bw2 + 12, 5, true)
if HOLD and HOLD.gold then smudge.tint(bx - 6, my - 2, bw2 + 12, 5, 4, 3) end
X.ctext(fl(bx + bw2 / 2), fl(by + bh + 8), "HOLD", "small", "bold")
end
local keep = {}
for _, c in ipairs(CHIPS) do
local u = (t - c.t0) / 1000
if u * 1000 < c.life then
local cx2, cy2 = c.x + c.vx * u, c.y + c.vy * u + 420 * u * u
if cy2 < gy + 4 then
local sz = c.s
local q = math.max(2, fl(sz))
smudge.rect(fl(cx2), fl(cy2), q, math.max(2, fl(q * 0.7)), true)
smudge.tint(fl(cx2), fl(cy2), q, math.max(2, fl(q * 0.7)), c.k or 4, 3)
end
keep[#keep + 1] = c
end
end
CHIPS = keep
if #CHIPS > 0 then busy(); any = true end
if BIRDS then
local u = (t - BIRDS.t0) / 1600
if u >= 1 then BIRDS = nil
else
for q = 0, 3 do
local bx = BIRDS.x + (q - 1.5) * 26 + u * (q % 2 == 0 and 120 or -90)
local by = BIRDS.y - u * (260 + q * 30)
local fl2 = math.sin(t / 60 + q) * 4
smudge.line(fl(bx - 7), fl(by - fl2), fl(bx), fl(by), 2); smudge.line(fl(bx), fl(by), fl(bx + 7), fl(by - fl2), 2)
end
busy(); any = true
end
end
if LOGF then
local v = t - LOGF.t0
if v > 1300 then LOGF = nil
else
local nm = "art/" .. ITEMS[LOGF.item][3]
for q = 1, math.min(LOGF.n, 6) do
local u = math.min(1, math.max(0, (v - q * 80) / 600))
if u > 0 then
local d = (q % 2 == 0) and 1 or -1
local lx = T.cx + d * (30 + q * 22) * u
local ly = gy - 14 - math.sin(u * math.pi) * 46
smudge.draw_sprite_quad(nm .. ".raw", 24, 24, lx - 14, ly - 14, lx + 14, ly - 14, lx + 14, ly + 14, lx - 14, ly + 14, nm .. "_m.raw")
end
end
busy(); any = true
end
end
if POP and t - POP.t0 < 900 then
local u = (t - POP.t0) / 900
X.ctext(fl(POP.x), fl(POP.y - 40 - 30 * u), POP.text or "PERFECT!", POP.small and "small" or "ui12", "bold")
if fx() and not POP.small then smudge.glow_circle(POP.x, POP.y, 46 * (1 - u) + 8, 255, 240, 170, 1.6 * (1 - u)) end
busy(); any = true
end
local bw2 = 150
local bx, by2 = fl(x + w - bw2 - 12), y + 12
smudge.rounded_rect(bx, by2, bw2, 16, 7, false)
smudge.rounded_rect(bx, by2, bw2, 16, 7, false, 2)
local fw = fl((bw2 - 6) * prog)
if fw > 2 then smudge.rect(bx + 3, by2 + 3, fw, 10, true) end
X.rtext(fl(x + w - 12), by2 + 20, string.format("%s  %d/%d chops", GATHER[gi][1], math.min(need(gi), fl(cut(cp) + 0.999)), need(gi)), "small", "bold")
if prog == 0 and PHONE and #CHOPS == 0 then
X.ctext(fl(x + w / 2), fl(y + 46), "hold to wind up the axe, let go in the gold", "small", "bold")
X.ctext(fl(x + w / 2), fl(y + 64), "PERFECT: the tree is cut at once", "small")
end
X.reg("WCHOP", fl(x), y, fl(w), h, function()
if not PHONE then chop(S, "good")
else X.set_note("Hold your finger down to wind up the axe, let go when the bar is in the gold.") end
end, false)
return any
end
function F.draw(S, y)
local cp = S.camp
local x0, w0 = 24, W - 48
local gi = tree(cp)
if view == "pick" then
local yy = y
local t = H.tool_tier(cp, SI)
smudge.rounded_rect(x0, yy, w0, 60, 10, false, 1)
X.ltext(x0 + 12, yy + 6, "Your axe: " .. H.tool_name(t, SI), "ui10", "bold")
local nxt = cp.tool[SI] + 1
local txt
if cp.tool[SI] > t then txt = string.format("Your %s needs Woodcutting %d to use.", H.tool_name(cp.tool[SI], SI):lower(), H.TOOLREQ[cp.tool[SI]])
elseif nxt <= 7 then txt = "A better axe misses less and opens better trees: smith it (SMITHING)."
else txt = "The best axe there is." end
X.ltext(x0 + 12, yy + 34, X.fit(txt, w0 - 24, "small"), "small")
yy = yy + 70
for k, g in ipairs(GATHER) do
local why = block(cp, k)
local sub = why and X.fit(why, w0 - 80, "small") or string.format("%d chops, %d logs   +%d xp a log   %d%% hit", need(k), LOGS[k], g[7], H.success_pct(cp, SI, g))
X.button(x0, yy, w0, 52, (k == gi and "> " or "") .. g[1], function() if k ~= gi then cp.x.wtr = k; cp.x.whp = 0; cp.x.wpf = 0; CHOPS = {} end; view = "tree"; X.mark_dirty() end,
{ font = "ui10", id = "WTREE" .. k, off = why ~= nil, sub = sub })
smudge.draw_sprite(x0 + w0 - 34, yy + 14, 24, 24, "art/" .. ITEMS[g[4]][3] .. ".raw", "art/" .. ITEMS[g[4]][3] .. "_m.raw")
yy = yy + 58
end
X.button(x0, Hh - 96 - 56, w0, 48, "BACK TO THE TREE", function() view = "tree" end, { font = "ui10", id = "WBACK" })
X.draw_note(Hh - 96 - 84)
return
end
local by = Hh - 96 - 60
scene(S, x0, y, w0, by - 8 - y)
local bw = (w0 - 12) // 3
local sub = X.fit(GATHER[gi][1] .. ", " .. H.tool_name(H.tool_tier(cp, SI), SI):lower(), 2 * bw - 10, "small")
X.button(x0, by, 2 * bw + 6, 52, "TREE & AXE", function() view = "pick" end, { font = "ui10", id = "WPICK", sub = sub })
X.button(x0 + 2 * (bw + 6), by, w0 - 2 * (bw + 6), 52, "BANK " .. H.inv_used() .. "/" .. H.INV_MAX, function() H.bank_loot(S) end,
{ font = "ui10", id = "GBANK", nohelp = true, dot = (H.inv_used() >= H.INV_MAX) and "!" or nil })
X.draw_note(y + 40)
end
F.chop = function(S, dir, perfect) chop(S, dir or 1, perfect) end
F.state = function() return { logs = LOGF ~= nil, T = T, hold = HOLD ~= nil, swing = SWING ~= nil } end
F.CH, F.LOGS = CH, LOGS
return F
end
world.lua
33023
return function(X, K, C, ADV, G)
local WO = {}
local W, H = X.W, X.H
local fl = math.floor
local ITEMS, IDX, SK = K.ITEMS, K.IDX, K.SK
local panel, sprite, head, back_btn = K.panel, K.sprite, K.head, K.back_btn
local function now() return X.time() end
local function I(id) return IDX[id] end
local function lvl(cp, si) return K.slevel(cp, si) end
local function TOPY() return K.top() end
local function hash01(a, b) local v = math.sin(a * 12.9898 + (b % 100003) * 78.233) * 43758.5453; return v - math.floor(v) end
local ELEMS = { "FIRE", "WATER", "EARTH", "STORM", "SHADOW", "LIGHT", "NATURE", "DREAM" }
local V = {}
local function load()
V = {}
for part in (smudge.load("world", "") or ""):gmatch("[^;]+") do
local k, v = part:match("^([^=]+)=(%-?%d+)$")
if k then V[k] = tonumber(v) end
end
end
local function save()
local p = {}
for k, v in pairs(V) do if v ~= 0 then p[#p + 1] = k .. "=" .. fl(v) end end
table.sort(p)
smudge.save("world", table.concat(p, ";"))
end
load()
local function get(k) return V[k] or 0 end
WO.get, WO.load = get, load
local function hour()
local t = now()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.hour then return d.hour end
return (t // 3600) % 24
end
local function day_n()
local t = now()
local ok, d = pcall(os.date, "*t", t)
if ok and type(d) == "table" and d.yday then return d.year * 400 + d.yday end
return t // 86400
end
local PHASES = {
{ "Morning", {}, {}, {}, "Crops grow 25% faster" },
{ "Day", { [6] = 1.15, [1] = 1.15 }, {}, {}, "Light & Fire cards +15%" },
{ "Evening", { [7] = 1.15, [2] = 1.15 }, {}, {}, "Nature & Water cards +15%" },
{ "Night", { [5] = 1.20, [8] = 1.20 }, {}, {}, "Shadow & Dream cards +20%" },
}
local WEATHER = {
{ "Clear", {}, {}, {}, "No weather effects" },
{ "Rain", { [2] = 1.10 }, {}, {}, "Crops grow 25% faster, Water cards +10%" },
{ "Storm", { [4] = 1.20 }, {}, {}, "Storm cards +20%" },
{ "Fog", { [5] = 1.10 }, {}, {}, "Shadow cards +10%" },
{ "Snow", { [2] = 1.10 }, {}, {}, "Water cards +10%" },
}
function WO.phase()
local h = hour()
if h >= 6 and h < 12 then return 1 elseif h >= 12 and h < 18 then return 2 elseif h >= 18 and h < 22 then return 3 end
return 4
end
function WO.weather()
local r = hash01(day_n(), 4242)
if r < 0.40 then return 1 elseif r < 0.62 then return 2 elseif r < 0.77 then return 3 elseif r < 0.90 then return 4 end
return 5
end
WO.PHASES, WO.WEATHER = PHASES, WEATHER
local WEEKS = {
{ "Lucky week", "+25% luck on every rare roll" },
{ "Slayer week", "double Slayer points from tasks" },
{ "Wild markets", "market prices swing twice as hard" },
{ "Nest week", "bird nests, gems and clue bottles twice as common" },
{ "Shiny week", "shiny chance in packs doubled (3% -> 6%)" },
{ "Harvest week", "crops grow twice as fast" },
{ "Fortune week", "the travelling merchant pays +25% more often" },
{ "Element week", "%s cards +25%% in card battles" },
}
local function week_n() return (now() + 3 * 86400) // (7 * 86400) end
function WO.week()
local w = week_n()
local k = w % #WEEKS + 1
local si = fl(hash01(w, 77) * 20) + 1
if SK[si] and (SK[si].slayer or SK[si].combat) then si = 1 + (si % 13) end
local el = fl(hash01(w, 91) * 8) + 1
local name, txt = WEEKS[k][1], WEEKS[k][2]
if k == 8 then name = ELEMS[el]:sub(1, 1) .. ELEMS[el]:sub(2):lower() .. " week"; txt = string.format(txt, ELEMS[el]:sub(1, 1) .. ELEMS[el]:sub(2):lower()) end
return k, name, txt, si, el
end
local function week_left() return (week_n() + 1) * 7 * 86400 - 3 * 86400 - now() end
function C.sky() return WO.phase(), WO.weather() end
function C.world_mult(e)
local m = (PHASES[WO.phase()][2][e] or 1) * (WEATHER[WO.weather()][2][e] or 1)
local k, _, _, _, el = WO.week()
if k == 8 and el == e then m = m * 1.25 end
return m
end
local xp0 = G.xp_bonus
G.xp_bonus = function(cp, si)
local m = xp0(cp, si)
if si then
m = m + (PHASES[WO.phase()][3][si] or 0) + (WEATHER[WO.weather()][3][si] or 0)
local k, _, _, wsi = WO.week()
if k == 7 and wsi == si then m = m + 1.0 end
if get("sec" .. (WO.REGION_SKILL[si] or 0)) == 1 then m = m + 0.05 end
end
return m
end
local og = G.on_gather
G.on_gather = function(S, si, gi, item, n)
local n2, xm, note = og(S, si, gi, item, n)
local ch = (PHASES[WO.phase()][4][si] or 0) + (WEATHER[WO.weather()][4][si] or 0)
if ch > 0 and X.rnd(1, 100) <= ch then n2 = n2 + 1; note = note .. "  (" .. (WEATHER[WO.weather()][4][si] and WEATHER[WO.weather()][1] or PHASES[WO.phase()][1]) .. " +1)" end
if WO.week() == 6 and X.rnd(1, 100) <= 25 then n2 = n2 + 1; note = note .. "  (week +1)" end
return n2, xm, note
end
local luck0 = G.R.luck
G.R.luck = function() return luck0() + ((WO.week() == 1) and 0.25 or 0) end
local rare0 = ADV.rare_mult
ADV.rare_mult = function(cp, si) return rare0(cp, si) * ((WO.week() == 4) and 2 or 1) end
local grow0 = ADV.grow_mult
ADV.grow_mult = function(cp)
local m = grow0(cp)
if WO.phase() == 1 then m = m * 0.75 end
if WO.weather() == 2 then m = m * 0.75 end
if WO.week() == 6 then m = m * 0.5 end
return m
end
local task0 = ADV.on_task_done
ADV.on_task_done = function(S, need)
local before = S.camp.x.spts
local t = task0(S, need)
if WO.week() == 2 then local extra = S.camp.x.spts - before; S.camp.x.spts = S.camp.x.spts + extra; t = t .. "  (Slayer week: x2)" end
return t
end
function C.mkt_swing() return (WO.week() == 3) and 2 or 1 end
function C.shiny_pct() return (WO.week() == 5) and 6 or 3 end
local BSLOT = 3 * 86400
local function bounty()
local slot = now() // BSLOT
local r = hash01(slot, 313)
local c = fl(hash01(slot, 17) * 32) + 1
local tier = (c - 1) // 8
local need = 1 + fl(hash01(slot, 29) * 3)
local shiny = r < 0.12
local reward = (tier >= 3 or shiny) and 4 or ((tier >= 2 or need >= 3) and 3 or 2)
return { slot = slot, c = c, need = need, shiny = shiny, box = reward, coins = 150 * (tier + need), ends = (slot + 1) * BSLOT }
end
WO.bounty = bounty
function WO.times(t0, t1, add)
for w = (t0 + 3 * 86400) // (7 * 86400), (t1 + 3 * 86400) // (7 * 86400) + 1 do add(w * 7 * 86400 - 3 * 86400) end
for s = t0 // BSLOT, t1 // BSLOT + 1 do add(s * BSLOT) end
for s = t0 // (3 * 3600), t1 // (3 * 3600) + 1 do add(s * 3 * 3600 + 1) end
end
local function bounty_state(S)
local b = bounty()
local done = get("bdone_slot") == b.slot
local ok = S.lvl[b.c] >= b.need and S.spare[b.c] >= 1 and (not b.shiny or S.shiny[b.c] == 1)
return b, done, ok
end
local function bounty_deliver(S)
local b, done, ok = bounty_state(S)
if done then X.set_note("Already delivered. A new bounty comes soon."); return end
if not ok then X.set_note("You need the card at that level and a spare copy to hand over."); return end
S.spare[b.c] = S.spare[b.c] - 1
V.bdone_slot = b.slot; V.bdone = get("bdone") + 1; save()
X.add_coins(b.coins); G.R.give_box(b.box)
local t = string.format("Bounty done! +%d coins and a %s.", b.coins, G.R.BOX[b.box])
if get("bdone") % 10 == 0 then G.R.give_box(4); t = t .. "  10 bounties: a MYTHIC box!" end
X.set_note(t); X.save_now()
end
function WO.bounty_ready(S) local _, done, ok = bounty_state(S); return (not done and ok) and 1 or 0 end
local REGIONS = {
{ "Greenwood", 0, "Old forest full of birdsong.", { "log", "oak", "potato", "fur" }, 1, "Stumpling", 1 },
{ "Copper Hills", 60, "Rolling hills riddled with mines.", { "copper", "iron", "coal", "ibar" }, 2, "Gob Maw", 2 },
{ "Saltmarsh", 150, "Mud flats, reeds and fishing huts.", { "shrimp", "trout", "salmon", "lob" }, 3, "Marsh Lurker", 3 },
{ "Wildlands", 300, "Lawless plains. Bandits everywhere.", { "hide", "tusk", "wolf", "rchaos" }, 12, "Dread Hare", 1 },
{ "Frostpeak", 600, "Frozen peaks above the clouds.", { "mith", "adam", "yew", "shark" }, 11, "Snow Sprite", 2 },
{ "The Void", 1000, "Where the world runs out.", { "rstone", "dragon", "celes", "rsoul" }, 20, "Hollow Skull", 3 },
{ "Deepwood Hollow", 1200, "Ancient trees, older than the kingdom.", { "elder", "bear", "wolf", "lotus" }, 4, "Moss Troll", 2, 45, "tlhide" },
{ "Serpent Isle", 1400, "A lonely island. Something circles it.", { "manta", "levi", "shark", "lob" }, 14, "Sea Serpent", 3, 46, "sscale" },
{ "Wyrm Crag", 1600, "Cliffs where young wyrms nest.", { "drake", "dragon", "dbar", "adam" }, 5, "Young Wyrm", 1, 47, "wscale" },
{ "Rift's Edge", 1800, "The void tears the sky open here.", { "celes", "rsoul", "anc", "cbar" }, 8, "Rift Wraith", 2, 48, "rcryst" },
}
for _, r in ipairs(REGIONS) do for k, id in ipairs(r[4]) do r[4][k] = I(id) end; if r[9] then r[9] = I(r[9]) end end
local NR = #REGIONS
local function mart(k) return REGIONS[k][8] or (30 + k) end
WO.REGIONS = REGIONS
WO.REGION_SKILL = {}
for k, r in ipairs(REGIONS) do WO.REGION_SKILL[r[5]] = k end
local sel, enc = 1, nil
local function unlocked(cp, k) return K.total_level(cp) >= REGIONS[k][2] end
local function secrets() local n = 0; for k = 1, NR do if get("sec" .. k) == 1 then n = n + 1 end end return n end
local function region_drops(k)
local r = REGIONS[k]
local rows = { { "Coins", (40 * k) .. "-" .. (60 * k), 1 }, { G.R.BOX[math.min(3, 1 + k // 3)], "1", ADV.p(8, true) } }
if r[9] then table.insert(rows, 2, { ITEMS[r[9]][1], "1", ADV.p(8, true) }) end
ADV.herb_rows(rows, 30 + 40 * k)
return r[6], rows, r[1] .. " monster"
end
WO.region_drops = region_drops
local EV_SLOT, EV_LEN = 3 * 3600, 2 * 3600
local EVK = { "invasion", "boss", "chest", "trader", "rift", "storm" }
local EVNAME = { invasion = "Invasion", boss = "Wandering boss", chest = "Treasure chest", trader = "Wandering trader",
rift = "Rift opening", storm = "Storm" }
function WO.event(t)
t = t or now()
local slot = t // EV_SLOT
if t - slot * EV_SLOT >= EV_LEN then return nil end
local kind = EVK[fl(hash01(slot, 611) * #EVK) + 1]
local k = fl(hash01(slot, 733) * NR) + 1
local k2 = (k + fl(hash01(slot, 811) * (NR - 1))) % NR + 1
if kind == "rift" then k = NR end
local r = REGIONS[k]
local txt
if kind == "invasion" then txt = r[1] .. " is overrun: double drops from exploring and fights there."
elseif kind == "boss" then txt = "A giant " .. r[6] .. " roams " .. r[1] .. ". Beat it once for a big reward."
elseif kind == "chest" then txt = "A treasure chest lies in " .. r[1] .. ". Open it once."
elseif kind == "trader" then txt = "A trader camps in " .. r[1] .. ", selling " .. (r[9] and ITEMS[r[9]][1] or "its goods") .. " (3 per event)."
elseif kind == "rift" then txt = "The rift tears open: fights at " .. r[1] .. " drop " .. ITEMS[r[9]][1] .. " far more often."
else txt = "A storm closes " .. r[1] .. " - but " .. REGIONS[k2][1] .. " gives double xp." end
return { slot = slot, kind = kind, name = EVNAME[kind], k = k, k2 = k2, ends = slot * EV_SLOT + EV_LEN, txt = txt }
end
local function left_txt(ev) local s2 = math.max(0, ev.ends - now()); return string.format("%d:%02d", s2 // 3600, (s2 % 3600) // 60) end
local function ev_here(kind, k) local ev = WO.event(); return ev and ev.kind == kind and ev.k == k and ev or nil end
local function ev_todo()
local ev = WO.event()
if not ev then return nil end
if ev.kind == "boss" and get("evboss") ~= ev.slot then return ev end
if ev.kind == "chest" and get("evchest") ~= ev.slot then return ev end
if ev.kind == "trader" and not (get("evbuy_s") == ev.slot and get("evbuy") >= 3) then return ev end
if ev.kind == "invasion" or ev.kind == "rift" or ev.kind == "storm" then return ev end
return nil
end
WO.ev_todo = ev_todo
function C.event_line()
local ev = WO.event()
if not ev then return nil end
return string.format("EVENT: %s - %s  %s", ev.name, (ev.kind == "storm") and REGIONS[ev.k2][1] or REGIONS[ev.k][1], left_txt(ev))
end
function C.event_dot() local ev = ev_todo(); return (ev and ev.kind ~= "storm" and ev.kind ~= "invasion" and ev.kind ~= "rift") and "!" or nil end
function C.event_short()
local ev = WO.event()
return ev and (ev.name .. " " .. left_txt(ev)) or nil
end
local function storm_block(k)
local ev = ev_here("storm", k)
if ev then X.set_note("A storm closes " .. REGIONS[k][1] .. " for now. " .. REGIONS[ev.k2][1] .. " gives double xp!"); return true end
return false
end
local function region_fight(S, k)
local r = REGIONS[k]
if not unlocked(S.camp, k) then X.set_note("Locked: needs total level " .. r[2] .. "."); return end
if storm_block(k) then return end
local hp, mh = 30 + 40 * k, 3 + 3 * k
ADV.CB.start(S, {
title = r[1] .. " - " .. r[6], name = r[6], card = 1, art = string.format("art/m%02d.raw", mart(k)), hp = hp, maxhp = hp, maxhit = mh,
weak = r[7], back = "worldmap", again = function(S2) region_fight(S2, k) end,
drops = function() return region_drops(k) end,
on_end = function(S2, win)
if not win then return "The " .. r[6] .. " drove you off. Heal up and try again." end
enc = nil
V["rk" .. k] = get("rk" .. k) + 1; save()
local coins = 40 * k + X.rnd(0, 20 * k)
local inv = ev_here("invasion", k)
if inv then coins = coins * 2 end
X.add_coins(coins)
local t = string.format("%s defeated! +%d coins", r[6], coins) .. (inv and " (invasion x2)" or "")
if G.lucky(8) then G.R.give_box(math.min(3, 1 + k // 3)); t = t .. "  " .. G.R.BOX[math.min(3, 1 + k // 3)] .. "!" end
local odds = ev_here("rift", k) and 2 or (inv and 4 or 8)
if r[9] and X.rnd(1, odds) == 1 then
K.add_item(S2.camp, r[9], 1)
t = t .. "  Rare drop: " .. ITEMS[r[9]][1] .. "!"
V["sp" .. k] = 1
local all = true
for k2 = 1, NR do if REGIONS[k2][9] and get("sp" .. k2) ~= 1 then all = false end end
if all and get("spall") ~= 1 then V.spall = 1; G.R.give_box(4); t = t .. "  All four special drops: a MYTHIC box!" end
save()
end
return t
end,
})
end
local function event_boss(S, k)
local ev = ev_here("boss", k)
if not ev then return end
local r = REGIONS[k]
if not unlocked(S.camp, k) then X.set_note("Needs total level " .. r[2] .. "."); return end
local hp, mh = (30 + 40 * k) * 3, fl((3 + 3 * k) * 1.5)
ADV.CB.start(S, {
title = r[1] .. " - Giant " .. r[6], name = "Giant " .. r[6], card = 1, art = string.format("art/m%02d.raw", mart(k)), hp = hp, maxhp = hp, maxhit = mh,
weak = r[7], back = "worldmap", again = function(S2) event_boss(S2, k) end,
drops = function() return region_drops(k) end,
on_end = function(S2, win)
if not win then return "The giant " .. r[6] .. " was too strong. Heal up and try again." end
if get("evboss") == ev.slot then local c = 40 * k; X.add_coins(c); return string.format("Giant %s beaten again: +%d coins.", r[6], c) end
V.evboss = ev.slot; save()
local coins = 150 * k + X.rnd(0, 50 * k)
X.add_coins(coins)
local bx = math.min(4, 2 + k // 4)
G.R.give_box(bx)
local t = string.format("GIANT %s DEFEATED! +%d coins and a %s", r[6]:upper(), coins, G.R.BOX[bx])
if r[9] then K.add_item(S2.camp, r[9], 2); t = t .. ", 2 " .. ITEMS[r[9]][1] end
return t .. "!"
end,
})
end
local function event_chest(S, k)
local ev = ev_here("chest", k)
if not ev then return end
local r = REGIONS[k]
if get("evchest") == ev.slot then X.set_note("You already opened this chest. Another event comes soon."); return end
V.evchest = ev.slot; save()
local coins, dust = 80 * k + X.rnd(0, 40 * k), 4 * k
X.add_coins(coins); X.add_dust(dust)
local i = r[4][X.rnd(1, #r[4])]
local n = 3 + k
K.add_item(S.camp, i, n)
local t = string.format("The chest holds %d coins, %d dust and %d %s", coins, dust, n, ITEMS[i][1])
if X.rnd(1, 4) == 1 then local bx = math.min(3, 1 + k // 3); G.R.give_box(bx); t = t .. " - and a " .. G.R.BOX[bx] end
X.set_note(t .. "!"); X.save_now()
end
local function trade_offer(k)
local r = REGIONS[k]
if r[9] then return r[9], 1, 300 + 60 * k end
return r[4][#r[4]], 10, 40 * k
end
local function event_trade(S, k)
local ev = ev_here("trader", k)
if not ev then return end
local bought = (get("evbuy_s") == ev.slot) and get("evbuy") or 0
if bought >= 3 then X.set_note("The trader is sold out. Another event comes soon."); return end
local i, n, price = trade_offer(k)
if S.coins < price then X.set_note(string.format("%d %s costs %d coins.", n, ITEMS[i][1], price)); return end
S.coins = S.coins - price
K.add_item(S.camp, i, n)
V.evbuy_s = ev.slot; V.evbuy = bought + 1; save()
X.set_note(string.format("Bought %d %s for %d coins (%d left).", n, ITEMS[i][1], price, 2 - bought)); X.save_now()
end
local function explore(S, k)
local cp = S.camp
local r = REGIONS[k]
if not unlocked(cp, k) then X.set_note("Needs total level " .. r[2] .. "."); return end
if storm_block(k) then return end
if now() < (WO.ex_next or 0) then X.set_note(string.format("You're still travelling... (%d s)", WO.ex_next - now())); return end
WO.ex_next = now() + 20
local roll = X.rnd(1, 100)
if get("sec" .. k) == 0 and X.rnd(1, 100) <= 3 then
V["sec" .. k] = 1; save()
local t = string.format("You found the SECRET of %s! +200 coins.", r[1]); X.add_coins(200)
if secrets() == NR then G.R.give_box(4); t = t .. "  All " .. NR .. " secrets: a MYTHIC box!" end
ADV.notify("Secret found in " .. r[1] .. "!", "worldmap")
X.set_note(t)
elseif roll <= 55 then
local i = r[4][X.rnd(1, #r[4])]
local n = X.rnd(2, 3 + k)
local inv = ev_here("invasion", k)
if inv then n = n * 2 end
local st = WO.event()
local xp = 6 * k + 4
if st and st.kind == "storm" and st.k2 == k then xp = xp * 2 end
K.add_item(cp, i, n)
X.set_note(string.format("You explore %s and find %d %s%s.", r[1], n, ITEMS[i][1], inv and " (invasion x2)" or "") .. K.give_xp(S, r[5], xp))
elseif roll <= 80 then
enc = k
X.set_note("A " .. r[6] .. " blocks your path!")
else
local c = 30 * k + X.rnd(0, 20 * k)
X.add_coins(c); X.add_dust(2 * k)
X.set_note(string.format("You find a hidden stash: %d coins and %d dust.", c, 2 * k))
end
X.save_now()
end
function WO.check(S)
local w = week_n()
if get("wk_seen") ~= w then V.wk_seen = w; save(); local _, name, txt = WO.week(); ADV.notify("This week: " .. name .. " - " .. txt, "worldinfo") end
local b = bounty()
if get("b_seen") ~= b.slot then V.b_seen = b.slot; save(); ADV.notify("New collector bounty: " .. X.cname(b.c) .. "!", "bounty") end
local ev = WO.event()
if ev and get("ev_seen") ~= ev.slot then V.ev_seen = ev.slot; save(); ADV.notify("Map event: " .. ev.name .. "! " .. ev.txt, "worldmap") end
end
function C.world_line()
local _, name = WO.week()
return string.format("%s - %s - %s", PHASES[WO.phase()][1], WEATHER[WO.weather()][1], name)
end
WO.SCR = { "worldinfo", "bounty", "worldmap" }
WO.PARENT = { worldinfo = "title", bounty = "camp", worldmap = "title" }
local function sun_moon(x, y, ph)
if ph == 4 then smudge.circle(x, y, 13, true); smudge.circle(x + 6, y - 4, 11, true, 1, false)
elseif ph == 3 or ph == 1 then smudge.circle(x, y + 4, 11, false, 2); smudge.rect(x - 16, y + 6, 32, 10, true, 1, false); smudge.line(x - 16, y + 6, x + 16, y + 6, 2)
else smudge.circle(x, y, 9, true); for a = 0, 7 do local an = a * math.pi / 4; smudge.line(x + fl(math.cos(an) * 12), y + fl(math.sin(an) * 12), x + fl(math.cos(an) * 16), y + fl(math.sin(an) * 16), 2) end end
end
