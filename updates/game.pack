for _, e in ipairs(REC.last) do t[#t + 1] = e[1]:gsub("[;:|]", "") .. ":" .. e[2] end
smudge.save("slotrec", string.format("%d,%.1f,%d,%d,%d,%d,%d|%s", REC.best, REC.bestx, REC.n[1], REC.n[2], REC.n[3], REC.bonus, REC.fs, table.concat(t, ";")))
end
local function record(label, amt, bet)
if amt > REC.best then REC.best = amt end
if bet and bet > 0 and amt / bet > REC.bestx then REC.bestx = amt / bet end
if label and (not bet or amt >= bet * 10) then
table.insert(REC.last, 1, { label, amt })
while #REC.last > 4 do table.remove(REC.last) end
end
save_rec()
end
local MPOOL = {
{ "pull", 40, "Pull %d times", 4 }, { "win", 12, "Win %d times", 3 }, { "big", 1, "Win 10x your bet in one pull", 5 },
{ "bonus", 1, "Open the bell bonus", 6 }, { "free", 1, "Get free spins", 8 }, { "jack", 1, "Hit any jackpot", 6 },
{ "wild", 3, "Land %d WILDs", 3 }, { "stars", 3, "Get two stars %d times", 3 }, { "streak", 3, "Win %d pulls in a row", 5 },
{ "nh", 1, "Win with a HOLD or a NUDGE", 6 } }
local MIS = { day = 0, sum = 0, n = 0, list = {} }
local function today()
local ok, d = pcall(os.date, "*t", X.time and X.time() or os.time())
return (ok and d) and (d.year * 10000 + d.month * 100 + d.day) or 0
end
local function save_mis()
local t = {}
for _, m in ipairs(MIS.list) do t[#t + 1] = m.id .. ":" .. m.prog .. ":" .. (m.done and 1 or 0) end
smudge.save("slotmis", MIS.day .. "|" .. MIS.sum .. "|" .. MIS.n .. "|" .. table.concat(t, ";"))
end
local function mis_check()
local d = today()
if MIS.day == d and #MIS.list > 0 then return end
if MIS.day == 0 then
local sd, ssum, sn, rest = (smudge.load("slotmis", "") or ""):match("^(%d+)|(%d+)|(%d+)|(.*)$")
if tonumber(sd) == d then
MIS.day, MIS.sum, MIS.n, MIS.list = d, tonumber(ssum), tonumber(sn), {}
for e in rest:gmatch("[^;]+") do
local id, pr, dn = e:match("^(%a+):(%d+):(%d)$")
if id then MIS.list[#MIS.list + 1] = { id = id, prog = tonumber(pr), done = dn == "1" } end
end
if #MIS.list == 3 then return end
end
end
MIS.day, MIS.sum, MIS.n, MIS.list = d, 0, 0, {}
local seed = d % 2147483647
local idx = {}
for i = 1, #MPOOL do idx[i] = i end
for i = #idx, 2, -1 do seed = (seed * 1103515245 + 12345) % 2147483648; local j = seed % i + 1; idx[i], idx[j] = idx[j], idx[i] end
for k = 1, 3 do MIS.list[k] = { id = MPOOL[idx[k]][1], prog = 0, done = false } end
save_mis()
end
local function mdef(id) for _, m in ipairs(MPOOL) do if m[1] == id then return m end end end
local function mis_reward(m) return math.max(10, fl(mdef(m.id)[4] * ((MIS.n > 0) and (MIS.sum / MIS.n) or 10) + 0.5)) end
local mis_paid = nil
local function mis_add(id, n, set)
mis_check()
for _, m in ipairs(MIS.list) do
if m.id == id and not m.done then
local d = mdef(id)
m.prog = set and math.max(m.prog, n) or (m.prog + n)
if m.prog >= d[2] then m.prog = d[2]; m.done = true; if mis_paid then mis_paid(m) end end
end
end
save_mis()
end
local function bet() return SL.cust or BETS[SL.bi] end
local function save_bet() smudge.save("slotbet", tostring(bet())) end
local function short(n)
if n >= 10000000 then return string.format("%dM", fl(n / 1000000)) end
if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
if n >= 100000 then return string.format("%dK", fl(n / 1000)) end
if n >= 10000 then return string.format("%.1fK", fl(n / 100) / 10) end
return tostring(fl(n))
end
local WIN = { { 280, 427, 442, 791 }, { 519, 427, 680, 791 }, { 757, 427, 918, 791 } }
local LAMP = { { 260, 284 }, { 340, 270 }, { 434, 259 }, { 539, 253 }, { 656, 253 }, { 762, 259 }, { 856, 271 }, { 935, 284 } }
local ICON = { "cherry", "lemon", "orange", "plum", "grapes", "bell", "bar", [WILD] = "wild", [STAR] = "star", [JACK] = "seven" }
local function quad(cx, cy, hw, hh, ang, px, py)
local ca, sa = math.cos(ang), math.sin(ang)
local q = {}
for i, c in ipairs({ { -hw, -hh }, { hw, -hh }, { hw, hh }, { -hw, hh } }) do
local x, y = cx + c[1] - px, cy + c[2] - py
q[#q + 1] = px + x * ca - y * sa; q[#q + 1] = py + x * sa + y * ca
end
return q
end
local function draw_sym(id, cx, cy, sz, lit, an)
local n = ICON[id]
if not n then return end
local hw, hh, ang, px, py = sz / 2, sz / 2, 0, cx, cy
if an then
if id <= 5 then
local b = math.abs(math.sin(an * 6))
cy = cy - b * sz * 0.1; hh = hh * (0.94 + 0.06 * b); hw = hw * (1.04 - 0.04 * b); cy = cy + (sz / 2 - hh)
elseif id == 7 then local k = 1 + 0.07 * math.sin(an * 8); hw, hh = hw * k, hh * k
end
end
local q = quad(cx, cy, hw, hh, ang, px, py)
smudge.draw_sprite_quad("art/slot_" .. n .. ".raw", 96, 96, q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8], "art/slot_" .. n .. "_m.raw")
if GFX.ok() and smudge.hires_quad then smudge.hires_quad("hd/slot_" .. n .. "_c.png", q[1], q[2], q[3], q[4], q[5], q[6], q[7], q[8]) end
if not GFX.ok() then return end
if id == WILD or id == STAR or id == JACK then smudge.glow_circle(cx, cy, sz * 0.5, 255, 220, 120, lit and 1.6 or 0.5) end
if an and (id == BELL or id == STAR) then
local a = 0.6 + 0.5 * math.sin(an * 7)
smudge.glow_circle(cx, cy, sz * 0.55, 255, 220, 120, 1.0 + a)
end
if an and id == JACK then
local u = (an * 0.9) % 1.4 - 0.2
local x = cx - sz * 0.6 + u * sz * 1.2
smudge.glow_quad(x - sz * 0.08, cy - sz * 0.45, x + sz * 0.1, cy - sz * 0.45, x - sz * 0.05, cy + sz * 0.45, x - sz * 0.23, cy + sz * 0.45, 255, 255, 230, 1.4)
elseif an and id == WILD then
for k = 0, 3 do
local ph = (an * 1.7 + k * 0.27) % 1
local a = math.sin(ph * math.pi)
local gx = cx + math.cos(k * 2.1 + fl(an * 1.7 + k * 0.27) * 1.3) * sz * 0.32
local gy = cy + math.sin(k * 1.7 + fl(an * 1.7 + k * 0.27) * 2.1) * sz * 0.22
smudge.glow_circle(gx, gy, sz * 0.12 * a + 1, 220, 240, 255, 2.2 * a)
end
end
end
local function visible(r, p) return { sym_at(r, p, 1), sym_at(r, p, 2), sym_at(r, p, 3) } end
local function cols_now() return { visible(1, SL.stops[1]), visible(2, SL.stops[2]), visible(3, SL.stops[3]) } end
local function cols_eval()
local c = cols_now()
if SL.fsn == 0 and c[2][2] == WILD then c[2] = { WILD, WILD, WILD } end
if SL.sticky then for k in pairs(SL.sticky) do c[k // 10][k % 10] = WILD end end
return c
end
local function count(cols, id) local n = 0; for _, c in ipairs(cols) do for _, x in ipairs(c) do if x == id then n = n + 1 end end end; return n end
local function has7(c) return c[1] == JACK or c[2] == JACK or c[3] == JACK end
local function wins_any(cols)
for _, L in ipairs(LINES) do
local a, b, c = cols[1][L[1]], cols[2][L[2]], cols[3][L[3]]
local p = line_pay(a, b, c)
if p ~= 0 or (a == JACK and b == JACK) then return true end
end
return count(cols, STAR) >= 2 or count(cols, BELL) >= 3 or (has7(cols[1]) and has7(cols[2]) and has7(cols[3]))
end
local function stop_auto(why) if SL.auto then SL.auto = nil; if why then X.set_note(why) end end end
local function sl_pull(S, free)
if SL.t0 or HP.pad_is_open() or SL.bonus or SL.nudge then return end
local v = free and SL.fsbet or bet()
local held = (not free) and SL.offer and SL.offer.held or nil
if not free then
if SL.fs > 0 then return end
if not stake(S, v, true) then stop_auto(); return end
SL.fswin = 0; SL.roll = nil
for i = 1, 3 do SL.jp[i] = SL.jp[i] + TIER[i][3] end
save_jp()
mis_check(); MIS.sum = MIS.sum + v; MIS.n = MIS.n + 1
mis_add("pull", 1)
end
SL.offer, SL.gam, SL.gview = nil, nil, nil
SL.bet = v
local st = SL.force or { X.rnd(1, NS), X.rnd(1, NS), X.rnd(1, NS) }; SL.force = nil
for r = 1, 3 do if held and held[r] then st[r] = SL.stops[r] end end
SL.stops = st
SL.t0 = ms() + (free and 0 or 120); SL.paid = false; SL.win = 0; SL.wins = nil; SL.shown = 0; SL.rdone = false
SL.from, SL.to, SL.stop, SL.tick, SL.held = {}, {}, {}, {}, held
local c1, c2 = visible(1, st[1]), visible(2, st[2])
local tease = (count({ c1, c2 }, STAR) >= 2) and 2 or nil
for _, L in ipairs(LINES) do
local a, b = c1[L[1]], c2[L[2]]
if a ~= STAR and b ~= STAR then
if a == b and ((a >= 5 and a <= 8) or a == JACK) then tease = 2
elseif (a == b or a == WILD or b == WILD) and not tease then tease = 1 end
end
end
if held and held[3] then tease = nil end
SL.tease = tease
local k = 0
for r = 1, 3 do
SL.from[r] = SL.pos[r]
if held and held[r] then
SL.to[r] = SL.pos[r]; SL.stop[r] = 1; SL["s" .. r] = true
else
SL["s" .. r] = nil
local base = math.ceil(SL.pos[r] / NS) * NS
SL.to[r] = base + NS * (2 + r) + st[r]
SL.stop[r] = 900 + k * 420 + X.rnd(0, 220)
+ ((r == 3 and tease == 2) and 1500 or (r == 3 and tease == 1) and X.rnd(500, 900) or 0)
k = k + 1
end
SL.tick[r] = math.floor(SL.pos[r])
end
if tease then after(SL.stop[2] + 250, function() SND.play("slot_riser", tease == 2 and 0.6 or 0.3) end) end
SL.expw = nil
SND.play(free and "slot_spin" or "slot_lever", free and 0.5 or 0.6)
if not free then after(120, function() SND.play("slot_spin", 0.5) end) end
VIB.play("t1", true)
end
local function quick_stop()
if not SL.t0 then return end
local age = ms() - SL.t0
local k = 0
for r = 1, 3 do
if not SL["s" .. r] and SL.stop[r] > age + 90 then SL.stop[r] = math.max(age + 90 + k * 110, 1); k = k + 1 end
end
SL.tease = false
end
local function settle(S, now, tx, ty2, y, sh, nudged)
SL.paid = true; SL.done = now; SL.rdone = false
local free = SL.fsn > 0
local raw = cols_now()
if free and SL.sticky then
for r = 1, 3 do for row = 1, 3 do
if raw[r][row] == WILD and not SL.sticky[r * 10 + row] then SL.sticky[r * 10 + row] = now; SND.play("slot_hold", 0.6) end
end end
end
if not free and raw[2][2] == WILD and not SL.expw then
SL.expw = now; SND.play("slot_wild", 0.9); after(120, function() SND.play("slot_riser", 0.3) end)
end
local cols = cols_eval()
local mul = free and FREEX or 1
local b0 = SL.bet
local lb = b0 / 5
local wins, total, best = {}, 0, 0
local jack = nil
local mini = false
for li, L in ipairs(LINES) do
local a, b, c = cols[1][L[1]], cols[2][L[2]], cols[3][L[3]]
local pay, n = line_pay(a, b, c)
if pay < 0 then jack = 1; wins[#wins + 1] = { li = li, amt = 0, n = 3, jack = 1 }
elseif pay > 0 then
local amt = math.max(1, math.floor(pay * lb * mul + 0.5))
wins[#wins + 1] = { li = li, amt = amt, n = n }
total = total + amt; best = math.max(best, pay)
elseif a == JACK and b == JACK and not mini then mini = li end
end
if not jack and has7(cols[1]) and has7(cols[2]) and has7(cols[3]) then jack = 2; wins[#wins + 1] = { li = 0, amt = 0, n = 0, jack = 2 }
elseif not jack and mini then jack = 3; wins[#wins + 1] = { li = mini, amt = 0, n = 2, jack = 3 } end
if jack then
local amt = math.floor(SL.jp[jack] * b0 + 0.5)
for _, w in ipairs(wins) do if w.jack then w.amt = amt end end
total = total + amt
SL.jp[jack] = TIER[jack][2]; save_jp()
REC.n[jack] = REC.n[jack] + 1
record(TIER[jack][1], amt, b0)
end
local stars = count(cols, STAR)
if total + ((stars == 2) and 1 or 0) > 0 or jack then SL.wrow = (SL.wrow or 0) + 1; mis_add("win", 1); mis_add("streak", SL.wrow, true)
else SL.wrow = 0 end
if total >= b0 * 10 then mis_add("big", 1) end
if jack then mis_add("jack", 1) end
local nw = count(raw, WILD)
if nw > 0 then mis_add("wild", nw) end
if stars == 2 then mis_add("stars", 1) end
if stars >= 3 then mis_add("free", 1) end
if count(cols, BELL) >= 3 then mis_add("bonus", 1) end
if (nudged or SL.held) and (total > 0 or jack) then mis_add("nh", 1) end
if stars == 2 then total = total + b0 * mul; wins[#wins + 1] = { li = 0, amt = b0 * mul, n = 0 } end
SL.wins = (#wins > 0) and wins or nil
SL.win = total; SL.mult = best
if total > 0 then
payout(S, total, tx, ty2, true)
if free then SL.fswin = SL.fswin + total end
SL.roll = { from = 0, to = total, t0 = now }
if not jack then record(free and "free spin" or (best >= PAYW and "3 wilds" or "win"), total, b0) end
if jack == 1 then
SND.play("slot_jackpot", 0.9); GFX.flash(255, 220, 120, 700, 0.6); GFX.shake(10, 900)
if GFX.ok() then GFX.confetti(W / 2, y + sh * 0.3, { 255, 200, 60 }, 140) end
SL.banner = { t0 = now, txt = "GRAND JACKPOT!", long = true }
X.set_note("GRAND JACKPOT! " .. total .. " coins!")
elseif jack == 2 then
SND.play("slot_jackpot", 0.8); GFX.flash(255, 220, 120, 500, 0.5); GFX.shake(7, 600)
if GFX.ok() then GFX.confetti(W / 2, y + sh * 0.3, { 255, 200, 60 }, 90) end
SL.banner = { t0 = now, txt = "MAJOR JACKPOT!", long = true }
X.set_note("MAJOR JACKPOT! " .. total .. " coins!")
elseif jack == 3 then
SND.play("win_big", 0.8)
SL.banner = { t0 = now, txt = "MINI JACKPOT" }
elseif best >= PAYW then
SND.play("jackpot", 0.85); GFX.flash(255, 220, 120, 500, 0.5); GFX.shake(8, 600)
if GFX.ok() then GFX.confetti(W / 2, y + sh * 0.3, { 255, 200, 60 }, 90) end
X.set_note("THREE WILDS! " .. total .. " coins!")
elseif best >= 100 then
SND.play("jackpot", 0.8)
if GFX.ok() then GFX.confetti(W / 2, y + sh * 0.3, { 255, 200, 60 }, 60) end
X.set_note("Big win: " .. total .. " coins!")
elseif total >= b0 * 4 then SND.play("win_big", 0.8); X.set_note("You win " .. total .. " coins!")
else SND.play("win_small", 0.7) end
if total >= b0 * 8 then
SL.rain = {}
for k = 1, (jack and jack <= 2) and 120 or ((best >= 100) and 70 or 36) do
SL.rain[k] = { x = X.rnd(10, W - 10), t0 = now + X.rnd(0, 900), sp = X.rnd(60, 100) / 100, ph = X.rnd(0, 100) / 10 }
end
end
SL.coins = {}
for k = 1, math.min(40, 4 + math.floor(total / math.max(1, b0)) * 2) do
SL.coins[k] = { x = tx + (X.rnd(-60, 60)), t0 = now + k * 45, vx = X.rnd(-20, 20) / 100 }
end
end
if mini and jack == 3 then
local L = LINES[mini]
local row3 = L[3]
local p = SL.stops[3]
local near = false
for d = -2, 2 do if STRIP[3][((p + d - 1) % NS) + 1] == JACK and (row3 - 2) ~= d then near = true end end
if near then after(350, function() SND.play("slot_nearmiss", 0.8) end); SL.close = now end
end
if stars >= 3 then
if SL.fsn == 0 then SL.fsbet = b0; SL.sticky = {} end
SL.fs = SL.fs + FREE
REC.fs = REC.fs + 1; save_rec()
SND.play("slot_fs", 0.8)
SL.banner = { t0 = now, txt = (SL.fsn > 0 and "+" or "") .. FREE .. " FREE SPINS" }
if GFX.ok() then GFX.confetti(W / 2, y + sh * 0.25, { 255, 230, 140 }, 50) end
elseif stars >= 1 then SND.play("slot_star", 0.5) end
if count(cols, BELL) >= 3 then
local v = {}
for i, c in ipairs(CHEST) do v[i] = c end
for i = #v, 2, -1 do local j = X.rnd(1, i); v[i], v[j] = v[j], v[i] end
SL.bonus = { vals = v, open = {}, picks = 0, t0 = now, bet = b0 }
REC.bonus = REC.bonus + 1; save_rec()
after(500, function() SND.play("slot_bonus", 0.85) end)
SL.banner = { t0 = now + 400, txt = "BELL BONUS!" }
end
for _, c in ipairs(cols) do for _, x in ipairs(c) do if x == WILD then SND.play("slot_wild", 0.5); break end end end
if not free and not SL.bonus and not nudged then
if total == 0 and stars < 3 then
local r = X.rnd(1, 1000) / 1000
if r <= P_HOLD then SL.offer = { held = {}, t0 = now }; SND.play("slot_hold", 0.7)
elseif r <= P_HOLD + P_NUDGE then SL.nudge = { n = X.rnd(1, 3), t0 = now }; SND.play("slot_nudge", 0.7) end
elseif total > 0 and not jack and SL.fs == 0 and not SL.auto then
SL.gam = { amt = total, left = 5 }
end
elseif nudged and total == 0 and stars < 3 and not SL.bonus then
end
end
local function nudge(S, r)
local N = SL.nudge
if not N or N.anim then return end
N.anim = { r = r, t0 = ms(), from = SL.pos[r] }
SL.stops[r] = ((SL.stops[r] - 2) % NS) + 1
N.n = N.n - 1
SND.play("slot_nudge", 0.6)
VIB.play("t1", true)
end
local function nudge_done(S)
local N = SL.nudge
N.anim = nil
if wins_any(cols_eval()) then SL.nudge = nil; SL.resettle = true
elseif N.n <= 0 then SL.nudge = nil; X.set_note("No luck with the nudges.") end
end
local function auto_hold()
local cols = cols_now()
local best, held = 0, nil
for _, L in ipairs(LINES) do
for _, pr in ipairs({ { 1, 2 }, { 1, 3 }, { 2, 3 } }) do
local a, b = cols[pr[1]][L[pr[1]]], cols[pr[2]][L[pr[2]]]
if a == b and a ~= STAR then
local v = (a == JACK) and 100 or (a == WILD) and 50 or a
if v > best then best, held = v, { [pr[1]] = true, [pr[2]] = true } end
end
end
end
if held then SL.offer.held = held end
end
local function auto_nudge(S)
for r = 1, 3 do
local st = { SL.stops[1], SL.stops[2], SL.stops[3] }
st[r] = ((st[r] - 2) % NS) + 1
if wins_any({ visible(1, st[1]), visible(2, st[2]), visible(3, st[3]) }) then nudge(S, r); return end
end
nudge(S, X.rnd(1, 3))
end
local function pick(S, i)
local B = SL.bonus
if not B or B.open[i] or B.picks >= 3 then return end
B.picks = B.picks + 1
B.open[i] = { t0 = ms(), k = B.picks }
SND.play("slot_chest", 0.8)
if B.picks == 3 then
local sum, x2 = 0, false
for j, o in pairs(B.open) do if B.vals[j] == 0 then x2 = true else sum = sum + B.vals[j] end end
local amt = sum * B.bet * (x2 and 2 or 1)
B.total = amt; B.done = ms()
after(700, function()
payout(S, amt, W / 2, H / 2, true)
SL.roll = { from = 0, to = amt, t0 = ms() }
SL.banner = { t0 = ms(), txt = "BONUS +" .. amt }
SND.play("win_big", 0.8)
record("bonus", amt, B.bet)
if SL.fsn > 0 then SL.fswin = SL.fswin + amt end
end)
after(3200, function() SL.bonus = nil; SL.rdone = false; flush() end)
end
end
local function gamble(S, red)
local G = SL.gam
if not G or G.card and ms() - G.card.t0 < 500 then return end
local c = { r = X.rnd(1, 13), s = X.rnd(1, 4), t0 = ms() }
local isred = (c.s == 2 or c.s == 3)
G.card = c
SND.play("flip", 0.6)
if isred == red then
payout(S, G.amt, W / 2, H - 260, false)
G.amt = G.amt * 2; G.left = G.left - 1; G.res = "win"
after(250, function() SND.play("slot_gwin", 0.8) end)
record("gamble", G.amt, SL.bet)
if G.left <= 0 then G.over = ms() end
else
stake(S, G.amt, false)
G.res = "lose"; G.over = ms()
after(250, function() SND.play("slot_glose", 0.8) end)
end
end
local PRESS = nil
local SPR = { 0, 0, 0, 0 }
local HOLD_MS = 900
local HOLD_SHOW = 300
local function spin_btn(x, y, w, h, label, sub, on, fn, id, now)
SPR[1], SPR[2], SPR[3], SPR[4] = x, y, w, h
local D = 10
local k = X.sink and X.sink(id) or 0
local down = math.floor(7 * k + 0.5)
local fh = h - D
local pap = THEME_BG and THEME_BG[1]
local dark = pap and ((((pap >> 16) & 255) * 0.3 + ((pap >> 8) & 255) * 0.59 + (pap & 255) * 0.11) < 110) or false
smudge.rounded_rect(x, y + D, w, fh, 18, true)
if HP.tint_rr then HP.tint_rr(x + 3, y + D + 3, w - 6, fh - 6, 15, 6, 1) end
local cy = y + down
smudge.rounded_rect(x + 2, cy + 2, w - 4, fh, 16, true)
smudge.rounded_rect(x + 2, cy, w - 4, fh - 4, 16, true)
smudge.rounded_rect(x + 5, cy + 3, w - 10, fh - 3, 13, true)
local f = "ui12"
X.ctext(x + w / 2, cy + fh / 2 - X.lh(f) // 2 - (sub and 10 or 0) - 2, label, f, "bold", true)
if sub then X.ctext(x + w / 2, cy + fh / 2 + 6, sub, "small", "bold", true) end
if GFX.ok() and GFX.button and k ~= 0 then GFX.button(x, cy, w, fh, id, k) end
local fill = (PRESS and not PRESS.fired and now - PRESS.t0 > HOLD_SHOW)
and math.min(1, (now - PRESS.t0 - HOLD_SHOW) / (HOLD_MS - HOLD_SHOW)) or nil
if fill then
local bw = fl((w - 28) * fill)
smudge.rounded_rect(x + 14, cy + fh - 16, w - 28, 6, 3, false, 1, false)
if bw > 0 then smudge.rounded_rect(x + 14, cy + fh - 16, bw, 6, 3, true, 1, false) end
end
if HP.tint_rr then HP.tint_rr(x + 5, cy + 3, w - 10, fh - 3, 13, 6, 3) end
if GFX.ok() then
smudge.glow_quad(x + 14, cy + 6, x + w - 14, cy + 6, x + w - 22, cy + fh * 0.32, x + 22, cy + fh * 0.32, 255, 235, 220, 0.45)
if on or fill then
local p
if fill then p = 0.3 + 0.7 * fill
elseif SL.auto then p = 0.35 + 0.3 * math.abs(math.sin(now / 1000 * 6))
else p = 0.3 + 0.2 * math.sin(now / 1000 * 4) end
smudge.glow_quad(x + 10, cy + 8, x + w - 10, cy + 8, x + w - 10, cy + fh - 8, x + 10, cy + fh - 8, 255, 80, 50, p)
end
busy()
end
X.reg(id, x, y, w, h, fn, false)
end
SLOTS = SLOTS or {}
function SLOTS.touch(ev, x, y)
if type(x) ~= "number" or type(y) ~= "number" then return false end
if ev == "down" then
PRESS = nil
if x >= SPR[1] and x < SPR[1] + SPR[3] and y >= SPR[2] and y < SPR[2] + SPR[4] and not SL.auto and not SL.bonus then
PRESS = { t0 = ms() }
SND.play("click", 0.4)
end
return false
elseif ev == "up" or ev == "tap" then
local f = PRESS and PRESS.fired
PRESS = nil
return f and true or false
elseif ev == "move" or ev == "release" then PRESS = nil end
return false
end
local function chest(cx, cy, sz, o, v, now, dim)
local function img(n, k, lift)
local h = sz / 2 * k
local yy = cy - (lift or 0)
local x0, y0, x1, y1 = cx - h, yy - h, cx + h, yy + h
smudge.draw_sprite_quad("art/slot_" .. n .. ".raw", 96, 96, x0, y0, x1, y0, x1, y1, x0, y1, "art/slot_" .. n .. "_m.raw")
if GFX.ok() and smudge.hires_quad then smudge.hires_quad("hd/slot_" .. n .. "_c.png", x0, y0, x1, y0, x1, y1, x0, y1) end
end
if not o then
local wob = dim and 0 or math.sin(now / 260 + cx * 0.05) * 0.03
img("chest", 0.92 + wob)
if GFX.ok() and not dim then smudge.glow_circle(cx, cy, sz * 0.4, 255, 210, 110, 0.25 + 0.15 * math.sin(now / 300 + cx)) end
return
end
local u = math.min(1, (now - o.t0) / 300)
if u < 1 then busy() end
img("chesto", 0.9 + 0.1 * (1 - (1 - u) ^ 3), 0)
if GFX.ok() and not dim then smudge.glow_circle(cx, cy - sz * 0.1, sz * 0.5 * u, 255, 220, 120, 1.3) end
local t = (v == 0) and "x2" or (v .. "x")
local tw = X.tw(t, "ui12", "bold") + 14
local ph = X.lh("ui12") + 4
local py = cy + sz * 0.18
smudge.rounded_rect(fl(cx - tw / 2), fl(py - ph / 2), fl(tw), ph, ph // 2, true)
X.ctext(fl(cx), fl(py) - X.lh("ui12") // 2, t, "ui12", "bold", true)
end
local function commas2(v)
local i = fl(v)
local t = tostring(i):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
return t .. string.format(".%02d", fl((v - i) * 100))
end
function C.draw_slots(S)
run_timers()
mis_check()
mis_paid = function(m)
local amt = mis_reward(m)
payout(S, amt, W / 2, H / 2, false)
local d = mdef(m.id)
X.set_note("Mission done: " .. string.format(d[3], d[2]) .. "  +" .. amt .. " coins")
if not SL.banner then SL.banner = { t0 = ms() + 600, txt = "MISSION +" .. amt } end
after(600, function() SND.play("slot_gwin", 0.8) end)
end
head(S, "Slot machine", SL.fs > 0 and ("free spins " .. SL.fs) or "")
if HP.pad_is_open() then HP.pad(S); back_btn("casino"); return end
SND.vs = SND.vs or {}
SND.vs.slots = VOL / 100
if VOLP then
local top = TOPY() + 6
local bot = H - 104
smudge.rounded_rect(12, top, W - 24, bot - top, 14, true, 1, false)
smudge.rounded_rect(12, top, W - 24, bot - top, 14, false, 2)
smudge.rounded_rect(12, top, W - 24, 32, 14, true)
smudge.rect(12, top + 18, W - 24, 14, true)
X.ctext(W / 2, top + 16 - X.lh("ui10") // 2, "SLOT MACHINE SOUNDS", "ui10", "bold", true)
local function slider(yy, v, set, id)
local sx0, sw0 = 30, W - 60 - 52
smudge.rounded_rect(sx0, yy + 6, sw0, 10, 5, false, 1)
local fw = fl((sw0 - 4) * v / 100)
if fw > 0 then smudge.rounded_rect(sx0 + 2, yy + 8, math.max(6, fw), 6, 3, true) end
local kx = sx0 + 2 + fw
kx = math.max(sx0 + 8, math.min(sx0 + sw0 - 8, kx))
smudge.circle(fl(kx), yy + 11, 9, true); smudge.circle(fl(kx), yy + 11, 6, true, 1, false)
for i = 0, 10 do
X.reg(id .. i, fl(sx0 + sw0 * (i - 0.5) / 10), yy - 8, fl(sw0 / 10) + 1, 38, function() set(i * 10) end, false)
end
end
local function playbtn(x, yy, names)
smudge.circle(fl(x), yy + 11, 15, false, 2)
smudge.triangle(fl(x - 4), yy + 4, fl(x - 4), yy + 18, fl(x + 7), yy + 11, true)
X.reg("SVP" .. names[1], fl(x - 20), yy - 10, 40, 42, function() SND.play(names[1], 0.8) end, false)
end
local yy = top + 44
X.ltext(30, yy, "All sounds", "ui10", "bold")
X.rtext(W - 30, yy, (VOL == 0) and "OFF" or (VOL .. "%"), "ui10", "bold")
slider(yy + 26, VOL, function(v) VOL = v; smudge.save("slotvol", tostring(VOL)); SND.vs.slots = VOL / 100; SND.play("slot_tick", 0.8) end, "SVOLA")
local ax = W - 30 - 18
smudge.circle(fl(ax), yy + 37, 17, false, 2)
speaker(fl(ax) - 1, yy + 37, VOL == 0, true)
X.reg("SVOLMUTE", fl(ax - 20), yy + 16, 40, 42, function()
if VOL == 0 then VOL = SL.lastvol or 70 else SL.lastvol = VOL; VOL = 0 end
smudge.save("slotvol", tostring(VOL)); SND.vs.slots = VOL / 100
end, false)
yy = yy + 66
smudge.line(24, yy, W - 24, yy, 1)
local rowh = 58
local per = math.max(3, fl((bot - 70 - yy - 6) / rowh))
local pages = math.ceil(#VROWS / per)
VOLP = math.max(1, math.min(pages, VOLP == true and 1 or VOLP))
for n = 1, per do
local i = (VOLP - 1) * per + n
local r = VROWS[i]
if not r then break end
local ry = yy + 8 + (n - 1) * rowh
local v = VS[r[1]] or 100
X.ltext(30, ry, r[1], "small", "bold")
X.rtext(W - 30 - 52, ry, (v == 0) and "off" or (v .. "%"), "small", "bold")
slider(ry + 20, v, function(nv) VS[r[1]] = nv; vs_save(); SND.play(r[2][1], 0.8) end, "SVR" .. i .. "_")
playbtn(W - 30 - 18, ry + 16, r[2])
end
local by = bot - 62
local hw = (W - 48 - 12) // 3
X.button(24, by, hw, 50, "<", function() VOLP = math.max(1, VOLP - 1) end, { font = "ui12", id = "SVPAGEP", off = VOLP <= 1 })
X.button(24 + hw + 6, by, hw, 50, "DONE", function() VOLP = nil end, { font = "ui10", id = "SVOLDONE", sub = "page " .. VOLP .. " / " .. pages })
X.button(24 + 2 * (hw + 6), by, W - 48 - 2 * (hw + 6), 50, ">", function() VOLP = math.min(pages, VOLP + 1) end, { font = "ui12", id = "SVPAGEN", off = VOLP >= pages })
back_btn("casino")
return
end
local now = ms()
local t = now / 1000
local y = TOPY() + 2
local AX0, AX1 = 212, 988
local avail = H - y - 486
local s = math.min(W / (AX1 - AX0), avail / 860)
local sw = fl((AX1 - AX0) * s)
local sh = fl(math.min(1312 * s, avail))
local sx = (W - sw) // 2
local function P(px, py) return sx + (px - AX0) * s, y + py * s end
local tx, ty2 = P(600, 1180)
ty2 = math.min(ty2, y + sh - 16)
if SL.nudge and SL.nudge.anim then
local A = SL.nudge.anim
local u = math.min(1, (now - A.t0) / 220)
SL.pos[A.r] = A.from - (1 - (1 - u) ^ 2)
busy()
if u >= 1 then SL.pos[A.r] = A.from - 1; nudge_done(S) end
end
if SL.resettle then SL.resettle = nil; settle(S, now, tx, ty2, y, sh, true) end
if PRESS and not PRESS.fired then
busy()
if now - PRESS.t0 >= HOLD_MS then
PRESS.fired = true
SL.auto = 0
SND.play("slot_hold", 0.7); VIB.play("t1", true)
X.set_note("AUTO: it plays by itself. Tap SPIN to stop.")
if not SL.t0 and not SL.bonus and not SL.nudge then
if SL.offer then auto_hold() end
SL.gam, SL.gview = nil, nil
sl_pull(S)
end
end
end
if SL.auto then
busy()
if SL.nudge and not SL.nudge.anim and now >= (SL.nudge.at or 0) then
if not SL.nudge.at then SL.nudge.at = now + 500 else SL.nudge.at = now + 450; auto_nudge(S) end
elseif SL.bonus and SL.bonus.picks < 3 and now >= (SL.bonus.at or SL.bonus.t0 + 1200) then
SL.bonus.at = now + 650
local free = {}
for i = 1, 9 do if not SL.bonus.open[i] then free[#free + 1] = i end end
pick(S, free[X.rnd(1, #free)])
elseif SL.rdone and not SL.t0 and not SL.bonus and not SL.nudge and not HP.pad_is_open() then
SL.autoAt = SL.autoAt or (now + 450)
if now >= SL.autoAt then
SL.autoAt = nil
if SL.offer then auto_hold() end
SL.gam, SL.gview = nil, nil
SL.auto = SL.auto + 1
sl_pull(S)
end
end
end
local shownLine
if SL.wins and SL.paid and not SL.bonus then
local nW = #SL.wins
local k = math.floor((now - SL.done) / 900) % nW + 1
if k ~= SL.shown then SL.shown = k; if nW > 1 or k == 1 then SND.play("slot_line", 0.45) end end
shownLine = SL.wins[k]
end
local alive = {}
if shownLine then
local L = LINES[shownLine.li]
if L then for r = 1, shownLine.n do alive[r * 10 + L[r]] = true end
elseif shownLine.jack == 2 then for r = 1, 3 do for row = 1, 3 do if sym_at(r, SL.stops[r], row) == JACK then alive[r * 10 + row] = true end end end
else for r = 1, 3 do for row = 1, 3 do if sym_at(r, SL.stops[r], row) == STAR then alive[r * 10 + row] = true end end end end
end
if smudge.set_clip then smudge.set_clip(0, y, W, sh) end
pic("cas_slot", sx - AX0 * s, y, 1199 * s, 1312 * s)
local spinning = SL.t0 ~= nil and not SL.paid
local cellc = {}
local lastTick = SL.lastTick or 0
for r = 1, 3 do
local w = WIN[r]
local x0, y0 = P(w[1] + 6, w[2] + 6); local x1, y1 = P(w[3] - 6, w[4] - 6)
local pos = SL.pos[r]
if SL.t0 and not (SL.held and SL.held[r]) then
local age = now - SL.t0
if age >= 0 then
local u = math.min(1, age / SL.stop[r])
local e = (u < 1) and (1 - (1 - u) ^ 3) or 1
pos = SL.from[r] + (SL.to[r] - SL.from[r]) * e
if r == 3 and SL.tease and u < 1 then
local rem = SL.to[r] - pos
if rem > 0 and rem < 3 then
local kk = math.floor(rem)
pos = SL.to[r] - (kk + (1 - (1 - (rem - kk)) ^ 3))
end
end
if u >= 1 and not SL["s" .. r] then
SL["s" .. r] = true; SND.play("slot_stop" .. r, 0.8)
local c = visible(r, SL.stops[r])
for _, x in ipairs(c) do if x == STAR then SND.play("slot_star", 0.45); break end end
for _, x in ipairs(c) do if x == JACK then SND.play("slot_wild", 0.4); break end end
end
local over = (age - SL.stop[r])
if over > 0 and over < 260 then pos = SL.to[r] - math.sin(over / 260 * math.pi) * 0.12 * (1 - over / 260) end
local fp = math.floor(pos)
if fp ~= SL.tick[r] and u < 1 then
SL.tick[r] = fp
if now - lastTick > 55 then SND.play("slot_tick", 0.35); lastTick = now end
end
end
SL.pos[r] = pos
end
local cell = (y1 - y0) / 3
if smudge.set_clip then smudge.set_clip(fl(x0), fl(y0), fl(x1 - x0), fl(y1 - y0)) end
smudge.rect(fl(x0), fl(y0), fl(x1 - x0), fl(y1 - y0), true, 1, false)
local base = math.floor(pos + 1e-6)
local frac = pos - base
local blur = SL.t0 and not SL["s" .. r] and (now - SL.t0) >= 0 and (now - SL.t0) < SL.stop[r] - 250
local sz = math.min(x1 - x0 - 8, cell * 0.86)
for k = -2, 2 do
local idx = ((base + k - 1) % NS) + 1
local cyc = (y0 + y1) / 2 + (k - frac) * cell
local row = k + 2
if SL.bonus and k >= -1 and k <= 1 then
local i = (r - 1) * 3 + row
local B = SL.bonus
local o = B.open[i]
local show = o or (B.done and now - B.done > 700)
chest((x0 + x1) / 2, cyc, sz, show and (o or { t0 = B.done + 700 }) or nil, B.vals[i], now, B.done and not o)
else
local an = (not spinning and math.abs(frac) < 1e-3 and alive[r * 10 + row]) and ((now - SL.done) / 1000) or nil
draw_sym(STRIP[r][idx], (x0 + x1) / 2, cyc, sz, false, an)
end
end
local function wild_cell(row, k, t0)
local cyc = y0 + (row - 0.5) * cell
local g = t0 and math.min(1, (now - t0) / 350) or 1
if g < 1 then busy() end
smudge.rect(fl(x0), fl(cyc - cell / 2), fl(x1 - x0), fl(cell), true, 1, false)
draw_sym(WILD, (x0 + x1) / 2, cyc, sz * (0.5 + 0.5 * g), true, (not spinning) and ((now - (t0 or now)) / 1000) or nil)
if GFX.ok() then smudge.glow_quad(x0, cyc - cell / 2, x1, cyc - cell / 2, x1, cyc + cell / 2, x0, cyc + cell / 2, k[1], k[2], k[3], 0.25) end
end
