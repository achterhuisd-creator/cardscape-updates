local NOTES = {}
local toast = nil
local function save_notes()
local t = {}
for _, n in ipairs(NOTES) do t[#t + 1] = n[2] .. "\t" .. fl(n[3]) .. "\t" .. n[1]:gsub("[\t\n]", " ") end
smudge.save("inbox", table.concat(t, "\n"))
end
function C.load_notes()
ADV.pf_load()
if ADV.trk_load then ADV.trk_load() end
NOTES = {}
local raw = smudge.load("inbox", "") or ""
for line in raw:gmatch("[^\n]+") do
local tg, tm, tx = line:match("^([^\t]*)\t([^\t]*)\t(.*)$")
if tg then NOTES[#NOTES + 1] = { tx, tg, tonumber(tm) or 0 } end
end
end
function ADV.notify(txt, target)
if CS_NOTIFY_HOOK then CS_NOTIFY_HOOK(txt, target) end
table.insert(NOTES, 1, { txt, target, now() })
while #NOTES > 20 do table.remove(NOTES) end
toast = NOTES[1]
save_notes()
end
function ADV.popup(txt, target) toast = { txt, target, now() } end
function ADV.unread() return #NOTES end
function C.note_text(k) return NOTES[k] and NOTES[k][1] end
function C.unread() return #NOTES end
function C.toast_off() if not ADV.keep_toast then toast = nil end end
function C.seen(name)
local tg = (name == "skill") and "farm" or name
local changed = false
for k = #NOTES, 1, -1 do if NOTES[k][2] == tg then table.remove(NOTES, k); changed = true end end
if changed then save_notes() end
end
local function open_target(S, tg)
if tg == "farm" then K.set_cur(10); X.go("skill")
elseif tg == "missions" then K.ensure_missions(S.camp); X.go("missions")
elseif tg and tg ~= "" then X.go(tg) else X.go("camp") end
end
local function read_note(S, k)
local n = table.remove(NOTES, k)
save_notes()
if n then open_target(S, n[2]) end
end
function C.notes_since(S, t)
C.check_notes(S)
local out = {}
for _, n in ipairs(NOTES) do
if n[3] >= t then
local target = n[2]
out[#out + 1] = { n[1], function()
for j, m in ipairs(NOTES) do if m == n then read_note(S, j); return end end
open_target(S, target)
end }
end
end
return out
end
local drop = false
local dtab, dpg, dtpg = 0, 0, 0
function C.toggle_drop() drop = not drop; if drop then toast = nil end end
function C.close_drop() drop = false; ADV.dt = nil end
function C.drop_open() return drop or ADV.dt ~= nil end
function ADV.p(n, lucky)
if n <= 1 then return 1 end
if lucky then
local luck = (ADV.G and ADV.G.R and ADV.G.R.luck()) or 0
n = math.max(1, math.floor(n / (1 + luck) + 0.5))
end
return 1 / n
end
function ADV.chance_text(p)
if p >= 0.999 then return "Always" end
if p >= 0.5 then return string.format("%d%%", math.floor(100 * p + 0.5)) end
local n = math.floor(1 / p + 0.5)
local pc = 100 * p
return string.format("1/%d (%s%%)", n, pc >= 10 and string.format("%d", math.floor(pc + 0.5)) or (pc >= 1 and string.format("%.1f", pc) or string.format("%.2f", pc)))
end
function ADV.herb_rows(rows, hp)
local left = 1 / 3
for _, h in ipairs({ { 400, "gtors" }, { 200, "gsnap" }, { 80, "grana" } }) do
if hp >= h[1] then rows[#rows + 1] = { ITEMS[I(h[2])][1], "1", left / 2 }; left = left / 2 end
end
rows[#rows + 1] = { ITEMS[I("ggua")][1], "1", left }
return rows
end
function ADV.pet_row(rows, id, n, lucky)
local i = I(id)
if i then rows[#rows + 1] = { "PET: " .. ITEMS[i][1]:gsub(" %(pet%)", ""), "1", ADV.p(n, lucky ~= false) } end
return rows
end
function ADV.show_drops(title, rows, sub) ADV.dt = { title, rows, sub } end
local function draw_droptable()
local dt = ADV.dt
local rows = dt[2]
local y0 = X.bar_h() + 2
local px, pw = 8, W - 20
local rh = 30
local ph = math.min(H - 110 - y0, 64 + #rows * rh + (dt[3] and 28 or 0) + 50)
X.reg("DTCLOSE", 0, 0, W, H, function() ADV.dt = nil end)
if not X.saver() then smudge.rounded_rect(px + 6, y0 + 6, pw, ph, 12, true) end
smudge.rounded_rect(px, y0, pw, ph, 12, true, 1, false)
smudge.rounded_rect(px, y0, pw, ph, 12, false, 3)
X.ltext(px + 14, y0 + 10, X.fit("Drops: " .. dt[1], pw - 28, "ui10", "bold"), "ui10", "bold")
local y = y0 + 40
if dt[3] then X.ltext(px + 14, y, X.fit(dt[3], pw - 28, "small"), "small"); y = y + 28 end
smudge.line(px + 10, y, px + pw - 10, y, 1)
local maxr = math.floor((y0 + ph - 50 - y) / rh)
for k, r in ipairs(rows) do
if k > maxr then break end
local ry = y + 4 + (k - 1) * rh
local rare = r[3] < 0.05
X.ltext(px + 14, ry, X.fit(r[1], 186, "small", rare and "bold" or "regular"), "small", rare and "bold" or "regular")
X.ltext(px + 204, ry, X.fit(r[2], 104, "small"), "small")
X.rtext(px + pw - 14, ry, ADV.chance_text(r[3]), "small", "bold")
end
X.ctext(W / 2, y0 + ph - 32, "chance per kill" .. (((ADV.G and ADV.G.R and ADV.G.R.luck()) or 0) > 0 and ", with your luck" or "") .. "  -  tap to close", "small")
end
function C.draw_toast(S)
if not toast or drop then return end
local t = toast
local y = 4
if not X.saver() then smudge.rounded_rect(12, y + 4, W - 20, 46, 10, true) end
smudge.rounded_rect(8, y, W - 20, 46, 10, true)
smudge.circle(32, y + 23, 12, true, 1, false)
X.ctext(32, y + 23 - X.lh("ui10") // 2, "!", "ui10", "bold")
X.ltext(52, y + 6, X.fit(t[1], W - 120, "small", "bold"), "small", "bold", true)
X.ltext(52, y + 26, "tap to open", "small", "regular", true)
X.ltext(W - 46, y + 12, "X", "ui10", "bold", true)
X.reg("TOAST", 8, y, W - 70, 46, function()
toast = nil
for k, n in ipairs(NOTES) do if n == t then read_note(S, k); return end end
open_target(S, t[2])
end)
X.reg("TOASTX", W - 62, y, 50, 46, function() toast = nil end)
end
function ADV.clue_ready(cp) local x = cp.x; return (x.clt ~= 0 and x.clk ~= 5 and x.clh >= x.cln) and 1 or 0 end
function ADV.quest_ready(cp, q)
local st = QUESTS[q][4][cp.x["q" .. q]]
if not st then return false end
if st[1] == "give" then for _, nd in ipairs(st[2]) do if K.count(cp, nd[1]) < nd[2] then return false end end return true
elseif st[1] == "wins" then return X.wins() - cp.x["q" .. q .. "w"] >= st[2]
elseif st[1] == "lvl" then return lvl(cp, st[2]) >= st[3] end
return false
end
function ADV.quests_ready(cp)
local n = 0
for q = 1, #QUESTS do if ADV.quest_ready(cp, q) then n = n + 1 end end
return n
end
function C.badges(S)
local cp = S.camp
local b = {}
local t = now()
b.skills = 0
for k = 1, K.nplots(cp) do local pl = cp.plots[k]; if pl[1] ~= 0 and pl[2] <= t then b.skills = b.skills + 1 end end
b.exp = 0
for k = 1, 2 do if cp.exp[k][1] ~= 0 and cp.exp[k][2] <= t then b.exp = b.exp + 1 end end
b.missions = K.ready_count(cp)
b.daily = K.daily_ok(cp) and 1 or 0
b.tasks = (cp.task and cp.task[3] >= cp.task[2]) and 1 or 0
b.ach = K.ach_ready(S)
b.market = 0
for _, n in ipairs(NOTES) do if n[2] == "geoffers" then b.market = b.market + 1 end end
b.quests = ADV.quests_ready(cp)
b.clues = ADV.clue_ready(cp) + ((cp.x.clt == 0) and (cp.x.cs1 + cp.x.cs2 + cp.x.cs3) or 0)
local gb = ADV.G and ADV.G.badges(S) or { wb = 0, star = 0, workers = 0, dia = 0, dc = 0 }
b.adventure = b.quests + b.clues + gb.wb + gb.star + gb.workers + gb.dia + gb.dc
b.total = b.skills + b.exp + b.missions + b.daily + b.tasks + b.ach + b.market + b.adventure
return b
end
ADV.badges = C.badges
local function badge_key(v)
local k = tostring(v or ""):lower():gsub("[^a-z0-9]", "")
local aliases = {
home = "title", packs = "packs", pack = "packs", album = "album", collection = "album",
quest = "quest", quests = "quest", tower = "quest", camp = "camp", deck = "deck",
stats = "stats", friends = "friends", ourpet = "ourpet", pet = "pet", grading = "grading", frames = "grading",
skills = "skills", skill = "skills", farm = "skill", missions = "missions", daily = "daily",
expedition = "expedition", expsend = "expedition", training = "training", achieve = "achieve",
trophies = "achieve", market = "market", ge = "geoffers", geoffers = "geoffers",
adventure = "adventure", tasks = "tasks", bank = "bank", gear = "gear", inventory = "gear",
shop = "shop", bounty = "bounty", worldmap = "worldmap", worldinfo = "worldinfo",
settings = "settings", inbox = "inbox", notifications = "inbox",
}
if aliases[k] then return aliases[k] end
if k:match("^skill%d+$") then return "skills" end
return k
end
local BADGE_C = nil
function C.badge_for(target, S)
local key = badge_key(target)
local unread = 0
for _, n in ipairs(NOTES) do
local nk = badge_key(n[2])
if nk == key or (key == "packs" and nk == "grading") then unread = unread + 1 end
end
local ms = X.millis and X.millis() or 0
if not BADGE_C or ms - BADGE_C.t > 250 or ms < BADGE_C.t then BADGE_C = { t = ms, b = C.badges(S) } end
local b = BADGE_C.b
local ready = ({ camp = b.total, skills = b.skills, skill = b.skills, missions = b.missions,
daily = b.daily, expedition = b.exp, tasks = b.tasks, achieve = b.ach, trophies = b.ach,
market = b.market, adventure = b.adventure })[key] or 0
if key == "packs" or key == "grading" then
local t = now()
for _, sl in ipairs(X.grading and X.grading() or {}) do if sl[2] <= t then ready = ready + 1 end end
end
return math.max(unread, ready)
end
function C.check_notes(S)
local cp = S.camp
if not cp or not cp.x then return false end
local x = cp.x
local n0 = #NOTES
local t = now()
ge_fill(S)
for k = 1, K.nplots(cp) do
local pl = cp.plots[k]
if pl[1] ~= 0 and pl[2] <= t and x["np" .. k] ~= pl[2] then
x["np" .. k] = pl[2]; ADV.notify(K.CROPS[pl[1]][1] .. " in plot " .. k .. " is ready!", "farm")
end
end
for k = 1, 2 do
local e = cp.exp[k]
if e[1] ~= 0 and e[2] <= t and x["ne" .. k] ~= e[2] then x["ne" .. k] = e[2]; ADV.notify("Expedition " .. k .. " is back!", "expedition") end
end
if K.daily_ok(cp) and x.nd ~= K.today() then x.nd = K.today(); ADV.notify("Your daily bonus is ready.", "daily") end
if cp.task and cp.task[3] >= cp.task[2] and x.nt ~= x.sdone + 1 then x.nt = x.sdone + 1; ADV.notify("Slayer task done! Claim it.", "tasks") end
local a = K.ach_ready(S); if a > x.na then ADV.notify("Achievement star to claim!", "achieve") end; x.na = a
local m = K.ready_count(cp); if m > x.nm then ADV.notify("A mission can be delivered.", "missions") end; x.nm = m
local c = ADV.clue_ready(cp); if c > x.nc then ADV.notify("Clue step done! Check it.", "clues") end; x.nc = c
local q = ADV.quests_ready(cp); if q > x.nq then ADV.notify("A quest step can be completed.", "quests") end; x.nq = q
local full = (K.inv_used() >= 28) and 1 or 0
if full == 1 and x.nst == 0 then ADV.popup("Your inventory is full: tap BANK.", "skills") end
x.nst = full
if ADV.G then ADV.G.check(S) end
if X.grading then
local told = smudge.load("grnote", "") or ""
local keep = {}
for _, sl in ipairs(X.grading()) do
local key = sl[1] .. ":" .. sl[2]
if sl[2] <= t then
keep[#keep + 1] = key
if not told:find(key, 1, true) then ADV.notify(X.cname(sl[1]) .. " is back from grading: collect it!", "grading") end
end
end
local nt = table.concat(keep, ",")
if nt ~= told then smudge.save("grnote", nt) end
end
local pi = X.pet_info and X.pet_info()
if pi then
local low, what = 100, nil
for _, kv in ipairs({ { "food", "hungry" }, { "fun", "bored" }, { "clean", "dirty" } }) do
local v = pi[kv[1]] or 100
if v < low then low, what = v, kv[2] end
end
local was = smudge.load("petnote", "0") == "1"
if low < 25 and not was and (pi.sleepleft or 0) <= 0 then
smudge.save("petnote", "1"); ADV.notify((pi.name or "Your pet") .. " is " .. what .. ": come take care of it!", "ourpet")
elseif low >= 50 and was then smudge.save("petnote", "0") end
if (pi.lastwho or "") ~= "" and pi.lastwho ~= pi.me and (pi.lastago or 9999) < 6 * 3600 then
local at = t - (pi.lastago or 0)
local ow, oa, ot = (smudge.load("petlast", "") or ""):match("^(.-)|(.-)|(%d+)$")
if ow ~= pi.lastwho or oa ~= (pi.lastact or "") or math.abs(at - (tonumber(ot) or 0)) > 120 then
smudge.save("petlast", pi.lastwho .. "|" .. (pi.lastact or "") .. "|" .. at)
local verb = ({ feed = "fed", play = "played with", clean = "cleaned", pet = "petted", treat = "gave a treat to", lightoff = "put to bed", lighton = "woke up" })[pi.lastact or ""] or "took care of"
ADV.notify(pi.lastwho .. " " .. verb .. " " .. (pi.name or "your pet") .. ".", "ourpet")
end
end
end
return #NOTES ~= n0
end
local ipage = 0
local TRK = {}
local tab = 0
local function trk_save() smudge.save("tracker", table.concat(TRK, ";")) end
local function trk_load() TRK = {}; for k in (smudge.load("tracker", "") or ""):gmatch("[^;]+") do TRK[#TRK + 1] = k end end
ADV.trk_load = trk_load
trk_load()
local function tracked(key) for i, k in ipairs(TRK) do if k == key then return i end end end
local function go_quest(q) qsel = q; X.go("questinfo") end
local function trk_items(S)
local cp = S.camp
local L = {}
local t = now()
local tk = cp.task
if tk then L[#L + 1] = { "slayer", string.format("Slayer: %d x %s", tk[2], ADV.CB.mon_name(tk[1])), tk[3], tk[2], function() X.go("tasks") end }
else L[#L + 1] = { "slayer", "Slayer task", 0, 1, function() X.go("tasks") end, "get one from the Slayer master", true } end
K.ensure_missions(cp)
for k = 1, 3 do
local m = cp.ms[k]
if m then L[#L + 1] = { "m" .. k, "Mission: deliver " .. m[2] .. " " .. ITEMS[m[1]][1], math.min(K.count(cp, m[1]), m[2]), m[2], function() K.ensure_missions(cp); X.go("missions") end } end
end
local dm = cp.dm
if dm and dm[6] == 0 then L[#L + 1] = { "daily", "Daily: deliver " .. dm[2] .. " " .. ITEMS[dm[1]][1], math.min(K.count(cp, dm[1]), dm[2]), dm[2], function() X.go("daily") end }
else L[#L + 1] = { "daily", "Daily mission", 1, 1, function() X.go("daily") end, "done - a new one comes tomorrow", true } end
local gl = X.grading and X.grading() or {}
for k = 1, (X.grade_slots and X.grade_slots() or 3) do
local sl = gl[k]
if sl then
local left = sl[2] - t
L[#L + 1] = { "gr" .. k, "Grading: " .. X.cname(sl[1]), left <= 0 and 1 or 0, 1, function() X.go("grading") end, left <= 0 and "back! collect it" or (K.mmss(left) .. " left"), true }
else
L[#L + 1] = { "gr" .. k, "Grading slot " .. k, 0, 1, function() X.go("grading") end, "empty - send a card", true }
end
end
local pi = X.pet_info and X.pet_info()
if pi then
local low = math.min(pi.food or 100, pi.fun or 100, pi.clean or 100)
local zz = (pi.sleepleft or 0) > 0
L[#L + 1] = { "pet", "Pet: " .. (pi.name or "your pet"), low, 100, function() X.go("ourpet") end,
zz and ("asleep - " .. K.mmss(pi.sleepleft) .. " left") or string.format("food %d%%  fun %d%%  clean %d%%", pi.food or 0, pi.fun or 0, pi.clean or 0), true }
else
L[#L + 1] = { "pet", "Pet", 0, 1, function() X.go("ourpet") end, "not set up yet - see OUR PET", true }
end
for q = 1, #QUESTS do
local st = cp.x["q" .. q]
if st > 0 and not qdone(cp, q) then
L[#L + 1] = { "q" .. q, "Quest: " .. QUESTS[q][1], st - 1 + (ADV.quest_ready(cp, q) and 1 or 0), #QUESTS[q][4], function() go_quest(q) end, step_text(cp, q) }
end
end
local x = cp.x
if x.clt ~= 0 then L[#L + 1] = { "clue", CLUE_N[x.clt] .. " clue: " .. clue_text(cp), (x.clk == 5) and math.min(K.count(cp, x.cla), x.cln) or x.clh, x.cln, function() X.go("clues") end }
else L[#L + 1] = { "clue", "Clue scroll", 0, 1, function() X.go("clues") end, "none open - start one in CLUES", true } end
for i, a in ipairs(K.ACH) do
local st = cp.ach[i]
if st < 5 then
local goal = a[4][st + 1]
L[#L + 1] = { "a" .. i, "Trophy: " .. string.format(a[2], goal), math.min(K.ach_value(S, a), goal), goal, function() X.go("achieve") end }
end
end
for k = 1, K.nplots(cp) do
local pl = cp.plots[k]
if pl[1] ~= 0 then
local left = pl[2] - t
L[#L + 1] = { "p" .. k, string.format("Crop: %s in plot %d", K.CROPS[pl[1]][1], k), left <= 0 and 1 or 0, 1, function() K.set_cur(10); X.go("skill") end, left <= 0 and "ready to harvest!" or (K.mmss(left) .. " left"), true }
else
L[#L + 1] = { "p" .. k, string.format("Crop: plot %d", k), 0, 1, function() K.set_cur(10); X.go("skill") end, "empty - plant a crop", true }
end
end
for k = 1, 2 do
local e = cp.exp[k]
if e[1] ~= 0 then
local left = e[2] - t
L[#L + 1] = { "e" .. k, "Expedition " .. k .. ": " .. X.cname(e[1]), left <= 0 and 1 or 0, 1, function() X.go("expedition") end, left <= 0 and "back!" or (K.mmss(left) .. " left"), true }
else
L[#L + 1] = { "e" .. k, "Expedition " .. k, 0, 1, function() X.go("expedition") end, "idle - send a card out", true }
end
end
for k = 1, 3 do
local p = "g" .. k
if x[p .. "t"] > 0 then
local i = x[p .. "i"]
L[#L + 1] = { "g" .. k, string.format("GE %s %d %s @%dc", x[p .. "t"] == 1 and "buy" or "sell", x[p .. "q"], ITEMS[i][1], x[p .. "p"]), 0, 1, function() X.go("geoffers") end, "market now " .. K.mkt_price(i, K.mkt_bucket()) .. "c", true }
else
L[#L + 1] = { "g" .. k, "GE slot " .. k, 0, 1, function() X.go("geoffers") end, "empty - no offer", true }
end
end
return L
end
ADV.trk_items = trk_items
local function trk_prune(S)
local have = {}
for _, it in ipairs(trk_items(S)) do have[it[1]] = true end
local changed = false
for i = #TRK, 1, -1 do if not have[TRK[i]] then table.remove(TRK, i); changed = true end end
if changed then trk_save() end
end
ADV.trk_prune = trk_prune
local tpg, ppg = 0, 0
local function draw_tracker(S, y0)
trk_prune(S)
local all = trk_items(S)
local by_key = {}
for _, it in ipairs(all) do by_key[it[1]] = it end
local list = {}
for _, k in ipairs(TRK) do if by_key[k] then list[#list + 1] = by_key[k] end end
local per = 6
local pages = math.max(1, math.ceil(#list / per))
if tpg >= pages then tpg = pages - 1 end
local sp = rows_sp(y0, per + 1, 78)
if #list == 0 then
X.ctext(W / 2, y0 + 40, "Nothing tracked yet.", "ui10", "bold")
X.wrapped(40, y0 + 76, "Tap + TRACK to follow your Slayer task, missions, quests, clues, trophies, crops, expeditions, GE offers, grading or your pet here.", W - 80, "small", 4)
end
local function trow(n, k, by)
local it = list[n]
if it then
local done = it[3] >= it[4]
X.button(20, by, W - 40, sp - 6, "", function() it[5]() end, { id = "TRK" .. k, dot = done and "!" or nil })
X.ltext(32, by + 4, X.fit(it[2], W - 80, "small", "bold"), "small", "bold")
if it[6] then X.ltext(32, by + 24, X.fit(it[6], W - 80, "small"), "small") end
if not it[7] then
X.bar(32, by + sp - 26, W - 160, 14, it[3] / it[4])
X.rtext(W - 34, by + sp - 30, it[3] .. "/" .. it[4], "small", "bold")
elseif done then X.rtext(W - 34, by + sp - 30, "DONE", "small", "bold") end
end
end
local ny = y0 + per * sp
local hw = (W - 48 - 10) // 3
if X.scrolling and X.scrolling() then ny = H - 96 - 58 end
if X.list("trk", y0, ny - 6 - y0, #list, sp, function(n, by) trow(n, n, by) end) then
X.button(24, ny, W - 48, 50, "+ TRACK", function() ppg = 0; X.go("trackpick") end, { font = "small", id = "TADD" })
else
for k = 1, per do trow(tpg * per + k, k, y0 + (k - 1) * sp) end
X.button(24, ny, hw, 50, "PREV", function() if tpg > 0 then tpg = tpg - 1 end end, { font = "small", off = tpg == 0, id = "TPREV" })
X.button(34 + hw, ny, hw, 50, "+ TRACK", function() ppg = 0; X.go("trackpick") end, { font = "small", id = "TADD" })
X.button(44 + 2 * hw, ny, hw, 50, "NEXT", function() if tpg < pages - 1 then tpg = tpg + 1 end end, { font = "small", off = tpg >= pages - 1, id = "TNEXT" })
end
end
function C.draw_trackpick(S)
trk_prune(S)
head(S, "Track what?", #TRK .. " tracked")
local all = trk_items(S)
local y0 = TOPY() + 4
local per = 8
local pages = math.max(1, math.ceil(#all / per))
if ppg >= pages then ppg = pages - 1 end
local sp = rows_sp(y0, per + 1, 64)
local function prow(n, k, by)
local it = all[n]
if it then
local on = tracked(it[1])
panel(20, by, W - 40, sp - 6)
X.ltext(32, by + 6, X.fit(it[2], W - 190, "small", "bold"), "small", "bold")
X.ltext(32, by + sp - 30, (not it[7]) and (it[3] .. " / " .. it[4]) or (it[6] or ""), "small")
X.button(W - 24 - 120, by + 5, 110, sp - 16, on and "TRACKED" or "TRACK", function()
local i = tracked(it[1])
if i then table.remove(TRK, i) elseif #TRK < 18 then TRK[#TRK + 1] = it[1] else X.set_note("You can track up to 18 things.") end
trk_save()
end, { font = "small", active = on and true or false, id = "PICK" .. k })
end
end
local ny = y0 + per * sp
if not X.list("trkpick", y0, nil, #all, sp, function(n, by) prow(n, n, by) end) then
for k = 1, per do prow(ppg * per + k, k, y0 + (k - 1) * sp) end
X.button(24, ny, 140, 46, "PREV", function() if ppg > 0 then ppg = ppg - 1 end end, { font = "small", off = ppg == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (ppg + 1) .. " / " .. pages, "small")
X.button(W - 164, ny, 140, 46, "NEXT", function() if ppg < pages - 1 then ppg = ppg + 1 end end, { font = "small", off = ppg >= pages - 1, id = "NEXT" })
end
X.button(24, H - 96, W - 48, 64, "DONE", function() X.go(C.trk_from or "camp"); dtab = 1; drop = true end, { font = "ui10", id = "PICKDONE" })
end
function C.draw_drop(S)
if ADV.dt then draw_droptable(); return end
if not drop then return end
trk_prune(S)
local y0 = X.bar_h() + 2
local px, pw = 8, W - 20
local ph = H - 120 - y0
X.reg("DROPCLOSE", 0, 0, W, H, function() drop = false end)
if not X.saver() then smudge.rounded_rect(px + 6, y0 + 6, pw, ph, 12, true) end
smudge.rounded_rect(px, y0, pw, ph, 12, true, 1, false)
smudge.rounded_rect(px, y0, pw, ph, 12, false, 3)
X.reg("DROPPANEL", px, y0, pw, ph, function() end)
smudge.triangle(W - 46, y0 + 1, W - 22, y0 + 1, W - 34, y0 - 12, true)
local tw2 = (pw - 30) // 2
X.button(px + 10, y0 + 10, tw2, 48, "NOTIFICATIONS", function() dtab = 0 end, { font = "small", active = dtab == 0, id = "DTABN", dot = (#NOTES > 0) and #NOTES or nil })
X.button(px + 20 + tw2, y0 + 10, tw2, 48, "TRACKER", function() dtab = 1 end, { font = "small", active = dtab == 1, id = "DTABT", dot = (#TRK > 0) and #TRK or nil })
X.swipe_tabs(function() return dtab end, function(t) dtab = t end, 0, 1)
local cy = y0 + 68
local bot = y0 + ph - 62
local bw = (pw - 40) // 3
local cx = px + 10
local iw = pw - 20
local sc = X.scrolling and X.scrolling()
if sc then iw = iw - 14 end
if dtab == 0 then
local rh = 64
local per = math.max(1, (bot - cy - 4) // rh)
local pages = math.max(1, math.ceil(#NOTES / per))
if dpg >= pages then dpg = pages - 1 end
if #NOTES == 0 then X.ctext(W / 2 - 6, cy + 30, "No new notifications.", "ui10", "bold") end
local function drow(j, k, by)
local nt = NOTES[j]
if nt then
X.button(cx, by, iw, rh - 6, "", function() drop = false; read_note(S, j) end, { id = "DROP" .. k })
smudge.circle(cx + 18, by + (rh - 6) // 2, 6, true)
X.ltext(cx + 34, by + 4, X.fit(nt[1], iw - 46, "small", "bold"), "small", "bold")
local age = math.max(0, now() - nt[3])
X.ltext(cx + 34, by + rh - 32, (age < 60 and "just now" or (age < 3600 and (age // 60) .. " min ago" or (age // 3600) .. " h ago")) .. "  - tap to open", "small")
end
end
if X.list("drop", cy, bot - cy - 6, #NOTES, rh, function(j, by) drow(j, j, by) end, cx - 2, iw + 6) then
X.button(cx, bot, pw - 20, 50, "CLEAR ALL", function() NOTES = {}; save_notes(); toast = nil end, { font = "small", off = #NOTES == 0, id = "DROPCLEAR" })
else
for k = 1, per do drow(dpg * per + k, k, cy + (k - 1) * rh) end
X.button(cx, bot, bw, 50, "PREV", function() if dpg > 0 then dpg = dpg - 1 end end, { font = "small", off = dpg == 0, id = "DPREV" })
X.button(cx + bw + 10, bot, bw, 50, "CLEAR ALL", function() NOTES = {}; save_notes(); toast = nil end, { font = "small", off = #NOTES == 0, id = "DROPCLEAR" })
X.button(cx + 2 * bw + 20, bot, bw, 50, "NEXT", function() if dpg < pages - 1 then dpg = dpg + 1 end end, { font = "small", off = dpg >= pages - 1, id = "DNEXT" })
end
else
local all = trk_items(S)
local by_key = {}
for _, it in ipairs(all) do by_key[it[1]] = it end
local list = {}
for _, k in ipairs(TRK) do if by_key[k] then list[#list + 1] = by_key[k] end end
local rh = 76
local per = math.max(1, (bot - cy - 4) // rh)
local pages = math.max(1, math.ceil(#list / per))
if dtpg >= pages then dtpg = pages - 1 end
if #list == 0 then
X.ctext(W / 2 - 6, cy + 30, "Nothing tracked yet.", "ui10", "bold")
X.wrapped(cx + 20, cy + 66, "Tap + TRACK to follow your Slayer task, missions, quests, clues, trophies, crops, expeditions, GE offers, grading or your pet here.", iw - 40, "small", 4)
end
local function dtrow(n, k, by)
local it = list[n]
if it then
local done = it[3] >= it[4]
X.button(cx, by, iw, rh - 6, "", function() drop = false; it[5]() end, { id = "TRK" .. k, dot = done and "!" or nil })
X.ltext(cx + 12, by + 4, X.fit(it[2], iw - 40, "small", "bold"), "small", "bold")
if it[6] then X.ltext(cx + 12, by + 24, X.fit(it[6], iw - 40, "small"), "small") end
if not it[7] then
X.bar(cx + 12, by + rh - 26, iw - 120, 14, it[3] / it[4])
X.rtext(cx + iw - 12, by + rh - 30, it[3] .. "/" .. it[4], "small", "bold")
elseif done then X.rtext(cx + iw - 12, by + rh - 30, "DONE", "small", "bold") end
end
end
if X.list("droptrk", cy, bot - cy - 6, #list, rh, function(n, by) dtrow(n, n, by) end, cx - 2, iw + 6) then
X.button(cx, bot, pw - 20, 50, "+ TRACK", function() C.trk_from = X.scr(); ppg = 0; X.go("trackpick") end, { font = "small", id = "TADD" })
else
for k = 1, per do dtrow(dtpg * per + k, k, cy + (k - 1) * rh) end
X.button(cx, bot, bw, 50, "PREV", function() if dtpg > 0 then dtpg = dtpg - 1 end end, { font = "small", off = dtpg == 0, id = "TPREV" })
X.button(cx + bw + 10, bot, bw, 50, "+ TRACK", function() C.trk_from = X.scr(); ppg = 0; X.go("trackpick") end, { font = "small", id = "TADD" })
X.button(cx + 2 * bw + 20, bot, bw, 50, "NEXT", function() if dtpg < pages - 1 then dtpg = dtpg + 1 end end, { font = "small", off = dtpg >= pages - 1, id = "TNEXT" })
end
end
end
function C.draw_inbox(S)
trk_prune(S)
head(S, "Notifications", #NOTES .. " new")
local y00 = TOPY() + 4
local tw2 = (W - 48 - 10) // 2
X.button(24, y00, tw2, 46, "NOTIFICATIONS", function() tab = 0 end, { font = "small", active = tab == 0, id = "TABN", dot = (#NOTES > 0) and #NOTES or nil })
X.button(34 + tw2, y00, tw2, 46, "TRACKER", function() tab = 1 end, { font = "small", active = tab == 1, id = "TABT", dot = (#TRK > 0) and #TRK or nil })
X.swipe_tabs(function() return tab end, function(t) tab = t end, 0, 1)
if tab == 1 then
draw_tracker(S, y00 + 56)
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go(C.inbox_from or "camp") end, { font = "ui10" })
return
end
local y0 = y00 + 56
local per = 8
local pages = math.max(1, math.ceil(#NOTES / per))
if ipage >= pages then ipage = pages - 1 end
local sp = rows_sp(y0, per + 1, 66)
if #NOTES == 0 then X.ctext(W / 2, y0 + 60, "No new notifications.", "ui10", "bold") end
local function irow(j, k, by)
local n = NOTES[j]
if n then
X.button(20, by, W - 40, sp - 6, "", function() read_note(S, j) end, { id = "NOTE" .. k })
smudge.circle(40, by + (sp - 6) // 2, 7, true)
X.ltext(58, by + 4, X.fit(n[1], W - 100, "small", "bold"), "small", "bold")
local age = math.max(0, now() - n[3])
X.ltext(58, by + sp - 30, (age < 60 and "just now" or (age < 3600 and (age // 60) .. " min ago" or (age // 3600) .. " h ago")) .. "  - tap to open", "small")
end
end
local ny = y0 + per * sp
local hw = (W - 48 - 10) // 3
if X.scrolling and X.scrolling() then ny = H - 96 - 58 end
if X.list("inbox", y0, ny - 6 - y0, #NOTES, sp, function(j, by) irow(j, j, by) end) then
X.button(24, ny, W - 48, 50, "CLEAR ALL", function() NOTES = {}; save_notes(); toast = nil end, { font = "small", off = #NOTES == 0, id = "CLEAR" })
else
for k = 1, per do irow(ipage * per + k, k, y0 + (k - 1) * sp) end
X.button(24, ny, hw, 50, "PREV", function() if ipage > 0 then ipage = ipage - 1 end end, { font = "small", off = ipage == 0, id = "PREV" })
X.button(34 + hw, ny, hw, 50, "CLEAR ALL", function() NOTES = {}; save_notes(); toast = nil end, { font = "small", off = #NOTES == 0, id = "CLEAR" })
X.button(44 + 2 * hw, ny, hw, 50, "NEXT", function() if ipage < pages - 1 then ipage = ipage + 1 end end, { font = "small", off = ipage >= pages - 1, id = "NEXT" })
end
X.button(24, H - 96, W - 48, 64, "BACK", function() X.go(C.inbox_from or "camp") end, { font = "ui10" })
end
local PF = { q = {}, c = {}, real = 0 }
local function pf_save()
local t = { tostring(fl(PF.real)) }
for i, q in pairs(PF.q) do if q > 0 then t[#t + 1] = i .. ":" .. q .. ":" .. fl(PF.c[i]) end end
smudge.save("portfolio", table.concat(t, ";"))
end
function ADV.pf_load()
PF = { q = {}, c = {}, real = 0 }
local raw = smudge.load("portfolio", "") or ""
local first = true
for part in raw:gmatch("[^;]+") do
if first then PF.real = tonumber(part) or 0; first = false
else
local i, q, c = part:match("^(%d+):(%d+):(%-?%d+)$")
if i then PF.q[tonumber(i)] = tonumber(q); PF.c[tonumber(i)] = tonumber(c) end
end
end
end
function ADV.pf_buy(i, n, p)
if n <= 0 then return end
PF.q[i] = (PF.q[i] or 0) + n; PF.c[i] = (PF.c[i] or 0) + n * p
pf_save()
end
local function pending_sell(cp, i)
local n = 0
for k = 1, 3 do if cp.x["g" .. k .. "t"] == 2 and cp.x["g" .. k .. "i"] == i then n = n + cp.x["g" .. k .. "q"] end end
return n
end
local function pf_sync(cp, i)
local q = PF.q[i] or 0
local have = cp.inv[i] + pending_sell(cp, i)
if q > have then
PF.c[i] = (q > 0) and fl(PF.c[i] * have / q + 0.5) or 0
PF.q[i] = have
end
end
function ADV.pf_sell(cp, i, n, p, escrowed)
local q = PF.q[i] or 0
if not escrowed then pf_sync(cp, i); q = PF.q[i] or 0 end
if q <= 0 then return nil end
local k = math.min(n, q)
local cost = PF.c[i] * k / q
local gain = fl(k * p - cost + 0.5)
PF.q[i] = q - k; PF.c[i] = PF.c[i] - cost
if PF.q[i] <= 0 then PF.q[i] = nil; PF.c[i] = nil end
PF.real = PF.real + gain
pf_save()
return gain
end
function ADV.pf_pos(cp, i)
pf_sync(cp, i)
local q = PF.q[i] or 0
if q <= 0 then return nil end
local avg = PF.c[i] / q
local now_p = K.mkt_price(i, K.mkt_bucket())
local pl = fl(q * now_p - PF.c[i] + 0.5)
return q, avg, now_p, pl, (PF.c[i] > 0) and fl(pl * 100 / PF.c[i] + (pl >= 0 and 0.5 or -0.5)) or 0
end
local ppage = 0
local function sgn(v) return (v >= 0 and "+" or "") .. v end
function C.draw_portfolio(S)
local cp = S.camp
head(S, "My portfolio", "")
local list = {}
local inv, val = 0, 0
for i in pairs(PF.q) do
local q, avg, np, pl, pct = ADV.pf_pos(cp, i)
if q then list[#list + 1] = { i = i, q = q, avg = avg, np = np, pl = pl, pct = pct }; inv = inv + PF.c[i]; val = val + q * np end
end
table.sort(list, function(a, b) return a.pl > b.pl end)
local y = TOPY() + 4
panel(20, y, W - 40, 112)
X.ltext(34, y + 8, "Invested", "small"); X.rtext(W / 2 - 10, y + 8, fl(inv + 0.5) .. "c", "small", "bold")
X.ltext(34, y + 32, "Worth now", "small"); X.rtext(W / 2 - 10, y + 32, fl(val + 0.5) .. "c", "small", "bold")
local un = fl(val - inv + 0.5)
X.ltext(W / 2 + 10, y + 8, "Open P/L", "small"); X.rtext(W - 34, y + 8, sgn(un) .. "c", "ui10", "bold")
X.ltext(W / 2 + 10, y + 32, "Sold P/L", "small"); X.rtext(W - 34, y + 32, sgn(fl(PF.real)) .. "c", "ui10", "bold")
X.wrapped(34, y + 62, "Profit or loss if you sold everything now at the market price.", W - 70, "small", 2)
local y0 = y + 122
local per = 6
local pages = math.max(1, math.ceil(#list / per))
if ppage >= pages then ppage = pages - 1 end
local sp = rows_sp(y0, per + 1, 72)
if #list == 0 then X.ctext(W / 2, y0 + 40, "Nothing bought on the market yet.", "ui10", "bold") end
local function pfrow(n, k, by)
local r = list[n]
if r then
X.button(20, by, W - 40, sp - 6, "", function() K.open_item(r.i) end, { id = "PF" .. k })
sprite(30, by + (sp - 6 - 24) // 2, 24, ITEMS[r.i][3])
X.ltext(62, by + 4, ITEMS[r.i][1], (#ITEMS[r.i][1] > 11) and "small" or "ui10", "bold")
X.ltext(62, by + sp - 30, string.format("%d x  bought %dc  now %dc", r.q, fl(r.avg + 0.5), r.np), "small")
X.rtext(W - 30, by + 4, sgn(r.pl) .. "c", "ui10", "bold")
X.rtext(W - 30, by + sp - 30, sgn(r.pct) .. "%", "small", "bold")
end
end
local ny = y0 + per * sp
if not X.list("pf", y0, nil, #list, sp, function(n, by) pfrow(n, n, by) end) then
for k = 1, per do pfrow(ppage * per + k, k, y0 + (k - 1) * sp) end
if pages > 1 then
X.button(24, ny, 120, 44, "PREV", function() if ppage > 0 then ppage = ppage - 1 end end, { font = "small", off = ppage == 0, id = "PREV" })
X.ctext(W / 2, ny + 12, (ppage + 1) .. " / " .. pages, "small")
X.button(W - 144, ny, 120, 44, "NEXT", function() if ppage < pages - 1 then ppage = ppage + 1 end end, { font = "small", off = ppage >= pages - 1, id = "NEXT" })
end
end
back_btn("market")
end
local SLAY_SHOP = { { "Slayer helm", "+3 ATK +10 HP head", 200 }, { "RARE ticket", "rare pack ticket", 80 }, { "Medium clue", "a clue scroll", 40 } }
function C.draw_slayshop(S)
local cp = S.camp
head(S, "Slayer shop", cp.x.spts .. " pts")
local y = TOPY() + 6
for k, s in ipairs(SLAY_SHOP) do
local by = y + (k - 1) * 90
panel(20, by, W - 40, 82)
X.ltext(34, by + 10, s[1], "ui10", "bold")
X.ltext(34, by + 44, s[2], "small")
X.button(W - 24 - 150, by + 8, 140, 66, "BUY", function()
if cp.x.spts < s[3] then X.set_note("Need " .. s[3] .. " Slayer points."); return end
cp.x.spts = cp.x.spts - s[3]
if k == 1 then grant(cp, "slhelm") elseif k == 2 then cp.rtickets = cp.rtickets + 1 else cp.x.cs2 = cp.x.cs2 + 1 end
X.set_note("Bought: " .. s[1] .. "."); X.save_now()
end, { font = "ui10", sub = s[3] .. " pts", off = cp.x.spts < s[3], id = "SLAYBUY" .. k })
end
X.draw_note(y + 3 * 90 + 4)
back_btn("tasks")
end
ADV.owns, ADV.drop_clue = owns, drop_clue
ADV.QUESTS, ADV.CLUE_U = QUESTS, CLUE_U
ADV.G = dofile("grind.lua")(X, K, C, ADV)
function C.times(S, t0, t1, add)
local cp = S.camp
if not cp or not cp.x then return end
for k = 1, K.nplots(cp) do local pl = cp.plots[k]; if pl[1] ~= 0 then add(pl[2]) end end
for k = 1, 2 do local e = cp.exp[k]; if e[1] ~= 0 then add(e[2]) end end
for d = t0 // 86400, t1 // 86400 + 1 do add(d * 86400) end
local ge = false
for k = 1, 3 do if cp.x["g" .. k .. "t"] > 0 then ge = true end end
if ge then for b = t0 // 900, t1 // 900 + 1 do add(b * 900) end end
ADV.G.times(S, t0, t1, add)
if X.grading then for _, sl in ipairs(X.grading()) do add(sl[2]) end end
if X.pet_info and X.pet_info() then for h = t0 // 3600, t1 // 3600 + 1 do add(h * 3600 + 1800) end end
end
for _, n in ipairs(ADV.G.SCR) do SCR[#SCR + 1] = n end
for k, v in pairs(ADV.G.PARENT) do PARENT[k] = v end
end
return ADV
