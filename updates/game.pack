end
end
end
local SL = { pos = { 3, 9, 15 }, stops = { 3, 9, 15 }, fs = 0, fsn = 0, fswin = 0, tab = "pays" }
do
local g, m, n = (smudge.load("slotjp", "") or ""):match("^([%d%.]+),([%d%.]+),([%d%.]+)$")
local old = tonumber(smudge.load("slotjack", "") or "")
SL.jp = { tonumber(g) or old or TIER[1][2], tonumber(m) or TIER[2][2], tonumber(n) or TIER[3][2] }
local b = tonumber(smudge.load("slotbet", "") or "")
SL.bi, SL.cust = 1, nil
if b then
for i, v in ipairs(BETS) do if v == b then SL.bi = i end end
if BETS[SL.bi] ~= b and b >= 1 then SL.cust = fl(b) end
end
end
local function save_jp() smudge.save("slotjp", string.format("%.4f,%.4f,%.4f", SL.jp[1], SL.jp[2], SL.jp[3])) end
local REC = { best = 0, bestx = 0, n = { 0, 0, 0 }, bonus = 0, fs = 0, last = {} }
do
local s = smudge.load("slotrec", "") or ""
local a, b, g, m, n, bo, f, rest = s:match("^(%d+),([%d%.]+),(%d+),(%d+),(%d+),(%d+),(%d+)|?(.*)$")
if a then
REC.best, REC.bestx, REC.n, REC.bonus, REC.fs = tonumber(a), tonumber(b), { tonumber(g), tonumber(m), tonumber(n) }, tonumber(bo), tonumber(f)
for e in (rest or ""):gmatch("[^;]+") do local l, v = e:match("^(.-):(%d+)$"); if l then REC.last[#REC.last + 1] = { l, tonumber(v) } end end
end
end
local function save_rec()
