local function star_shape(cx, cy, r, filled)
local pts = {}
for k = 0, 9 do
local ang = -math.pi / 2 + k * math.pi / 5
local rr = (k % 2 == 0) and r or r * 0.45
pts[#pts + 1] = { cx + rr * math.cos(ang), cy + rr * math.sin(ang) }
end
for k = 1, 10 do
local p, q = pts[k], pts[k % 10 + 1]
if filled then smudge.triangle(cx, cy, p[1], p[2], q[1], q[2], true) end
smudge.line(p[1], p[2], q[1], q[2], 1)
end
end
function C.draw_achieve(S)
local cp = S.camp
head(S, "Achievements", "")
local per = 5
local pages = math.ceil(#ACH / per)
if apage >= pages then apage = pages - 1 end
local function arow(i, k, by)
local a = ACH[i]
do
local st = cp.ach[i]
panel(20, by, W - 40, 88)
X.ltext(34, by + 6, a[1], "ui10", "bold")
for sidx = 1, 5 do star_shape(196 + (sidx - 1) * 24, by + 18, 10, sidx <= st) end
local goal = a[4][math.min(5, st + 1)]
X.ltext(34, by + 34, string.format(a[2], goal), "small")
local v = ach_value(S, a)
X.bar(34, by + 62, 200, 16, st >= 5 and 1 or math.min(1, v / goal))
X.ltext(244, by + 62, (st >= 5) and "MAX" or (math.min(v, goal) .. "/" .. goal), "small")
local r = STAR_RW[math.min(5, st + 1)]
local rw = (r[1] == "dust") and (r[2] .. " dust") or (r[1] == "ticket") and (r[2] .. " ticket") or (r[2] .. " RARE tkt")
local ok = st < 5 and v >= goal
X.button(W - 24 - 140, by + 10, 130, 72, st >= 5 and "5 STARS" or "CLAIM", function() claim_ach(S, i) end,
{ font = "ui10", off = not ok, sub = (st >= 5) and "complete" or rw, id = "ACH" .. k, dot = ok and "!" or nil })
end
end
local ny = TOP + 4 + per * 94
if not X.list("ach", TOP + 4, nil, #ACH, 94, function(i, by) arow(i, i, by) end) then
for k = 1, per do local i = apage * per + k; if ACH[i] then arow(i, k, TOP + 4 + (k - 1) * 94) end end
X.button(24, ny, 140, 48, "PREV", function() if apage > 0 then apage = apage - 1 end end, { font = "ui10", off = apage == 0, id = "PREV" })
X.ctext(W / 2, ny + 14, (apage + 1) .. " / " .. pages, "ui10")
X.button(W - 24 - 140, ny, 140, 48, "NEXT", function() if apage < pages - 1 then apage = apage + 1 end end, { font = "ui10", off = apage >= pages - 1, id = "NEXT" })
end
X.draw_note(ny + 54)
back_btn("camp")
end
local gpg = 0
local isel
local drop_ok = false
local function inv_slots()
local t = {}
for _, e in ipairs(PINV) do
if stacks(e[1]) then t[#t + 1] = { e[1], e[2] } else for _ = 1, e[2] do t[#t + 1] = { e[1], 1 } end end
end
return t
end
