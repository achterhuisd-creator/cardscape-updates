elseif k[3] then sub = D.elems[k[3]] .. " pack, 70 coins"; off = S.coins < 70
elseif k[2] then sub = S.camp.rtickets .. " rare ticket(s) left"; off = S.camp.rtickets < 1
elseif k[1] then sub = S.camp.tickets .. " ticket(s) left"; off = S.camp.tickets < 1
