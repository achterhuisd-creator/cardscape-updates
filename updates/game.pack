use_right = { "1_0", "2_0", "1_1", "2_1", "1_2", "2_2", "0_3", "1_3", "2_3", "0_4", "1_4", "2_4", "0_5", "1_5", "2_5", "0_6", "1_6", "2_6", "0_7", "1_7", "2_7", "0_8", "1_8", "2_8", "0_9", "1_9", "2_9", "0_10", "1_10", "0_11", "1_11" },
use_up = { "0_0", "1_0", "2_0", "0_1", "1_1", "2_1", "0_2", "1_2", "2_2", "0_3", "1_3", "2_3", "0_4", "1_4", "2_4", "0_5", "1_5", "2_5", "0_6", "1_6", "2_6", "0_7", "1_7", "2_7", "0_8", "1_8", "2_8", "0_9", "1_9", "2_9", "0_10", "1_10", "2_10", "0_11", "1_11", "2_11" },
}
local SILD = {
down0 = "",
down1 = "",
down2 = "",
idle_down = "",
idle_left = "",
idle_right = "",
idle_up = "",
left0 = "",
left1 = "",
left2 = "",
right0 = "",
right1 = "",
right2 = "",
up0 = "",
up1 = "",
up2 = "",
use_down = "",
use_left = "",
use_right = "",
use_up = "",
}
local HANDS = {
down0 = { 18.5, 19.5, 0 },
down1 = { 18.5, 18.5, 0 },
down2 = { 18.5, 19.5, 0 },
idle_down = { 18.5, 19.5, 0 },
idle_left = { 12.5, 20.5, 0 },
idle_right = { 11.5, 20.5, 0 },
idle_up = { 5.5, 19.5, 1 },
left0 = { 12.5, 19.5, 0 },
left1 = { 11.5, 19.5, 0 },
left2 = { 12.5, 19.5, 0 },
right0 = { 11.5, 19.5, 0 },
right1 = { 12.5, 19.5, 0 },
right2 = { 11.5, 19.5, 0 },
up0 = { 5.5, 19.5, 1 },
up1 = { 5.5, 19.5, 1 },
up2 = { 5.5, 18.5, 1 },
use_down = { 18.5, 14.5, 0 },
use_left = { 6.5, 16.5, 0 },
use_right = { 17.5, 16.5, 0 },
use_up = { 5.5, 14.5, 1 },
}
function UI.held(id, cx, by, face, swing, tag)
if not id or not IV.NAME[id] then return end
local sz = (IV.block(id) or IV.FLOOR[id]) and 0.75 or 1
local hd = HANDS[tag or (face .. "0")] or HANDS[face .. "0"] or { 16.5, 16.5 }
local hx, hy, mir = cx - 36 + hd[1] * 3, by - 69 + hd[2] * 3, face == "left"
if (face == "down" or face == "up") and hd[1] < 12 then mir = true end
local c = { { -6, -26 }, { 26, -26 }, { 26, 6 }, { -6, 6 } }
local a = swing or 0
if mir then a = -a end
local ca, sa = math.cos(a), math.sin(a)
local P = {}
for k, v in ipairs(c) do
local dx, dy = v[1] * sz, v[2] * sz
if mir then dx = -dx end
P[k] = { hx + dx * ca - dy * sa, hy + dx * sa + dy * ca }
end
if NQ >= CAP then return end
NQ = NQ + 1
local o = -9
smudge.hires_quad("^hd/wl_it_" .. id .. "_c.png", o, o, o, o, o, o, o, o, P[1][1], P[1][2], P[2][1], P[2][2], P[3][1], P[3][2], P[4][1], P[4][2])
end
function UI.animal(kind, cx, by, face, step)
local x0, y0 = fl(cx - 36), fl(by - 69)
q(kind .. "_" .. ((step == "i") and ("idle_" .. face) or (face .. step)), x0, y0, x0 + 72, y0 + 72, true)
end
UI.IDLE_AFTER = 20000
function UI.idle(step, seed, o)
if (step or 0) ~= 0 then return step end
if o then
local now = ms()
if o.x ~= o._lx or o.y ~= o._ly or o.face ~= o._lf or not o._mv then o._lx, o._ly, o._lf, o._mv = o.x, o.y, o.face, now end
if now - o._mv < UI.IDLE_AFTER then return 0 end
seed = -o._mv
end
return (fl((ms() + (seed or 0)) / 650) % 2 == 1) and "i" or 0
end
local function shadow(cx, cy, w) q("shadow", fl(cx - w / 2), fl(cy - w * 0.19), fl(cx + w / 2), fl(cy + w * 0.19), true) end
local V = nil
local STICK, ABTN = nil, nil
local PANEL = nil
local WORLD = nil
local LOADING, LAST = nil, nil
local SET = nil
local MP = nil
local HBW, HBS = 440, 44
local HBP = nil
local function ctrl_y() return ST.hbtop and V[2] - 118 or V[2] - 166 end
local function hb_xy() return fl((W - HBW) / 2), ST.hbtop and (V[2] - 246) or (V[2] - 56) end
local function abtn_xy() if ST.left then return 96, ctrl_y(), 60 end; return W - 96, ctrl_y(), 60 end
local function cbtn_xy() if ST.left then return 210, ctrl_y() + 22, 40 end; return W - 210, ctrl_y() + 22, 40 end
local function can_build() local it = IV.S[ST.sel]; return it and (IV.block(it.id) or IV.FLOOR[it.id]) end
local function stick_home() if ST.left then return W - 112, ctrl_y() end; return 112, ctrl_y() end
WILDST = {}
function WILDST.touch(ev, x, y)
if not V or not hd() or type(x) ~= "number" or type(y) ~= "number" then return false end
local f = (ev:sub(-1) == "2") and 2 or 1
local e = (f == 2) and ev:sub(1, -2) or ev
local drag = (e == "down" or e == "move" or e == "nudge" or e == "release")
if not (WORLD == "mine" or WORLD == "ours") or LOADING then return drag end
if e == "down" then
if WD.PAD then WD.PAD.on = false end
if IV.open then IV.touch(e, f, x, y); busy(); return true end
if WD.MAP.open then WD.MAP.drag(e, f, x, y); return true end
if PANEL then return true end
local ax, ay, ar = abtn_xy()
if (x - ax) ^ 2 + (y - ay) ^ 2 <= (ar + 14) ^ 2 then ABTN = { f = f, t0 = ms() }; busy(); return true end
local cx2, cy2, cr = cbtn_xy()
if can_build() and (x - cx2) ^ 2 + (y - cy2) ^ 2 <= (cr + 12) ^ 2 then
WD.CB = { f = f, face = PL.face }; WD.place(true); busy(); return true
end
local bx, by = hb_xy()
if x >= bx and x < bx + HBW and y >= by - 4 and y < by + HBS + 4 then
local k = math.max(1, math.min(10, fl((x - bx) / HBS) + 1))
if k == 10 then HBP = { f = f }; snd("click", 0.3); IV.open = true; IV.MODE = "inv"; STICK = nil
elseif k ~= ST.sel then ST.sel = k; ST.save(); snd("click", 0.2) end
busy(); return true
end
local hx, hy = stick_home()
if ST.fixed then
if (x - hx) ^ 2 + (y - hy) ^ 2 <= 100 ^ 2 then STICK = { f = f, cx = hx, cy = hy, dx = x - hx, dy = y - hy }; busy(); return true end
elseif ((ST.left and x > W * 0.45) or (not ST.left and x < W * 0.55)) and y > V[1] + (V[2] - V[1]) * 0.3 and y < V[2] then
STICK = { f = f, cx = x, cy = y, dx = 0, dy = 0 }; busy(); return true
end
return false
end
local own = (STICK and STICK.f == f) or (ABTN and ABTN.f == f) or (HBP and HBP.f == f) or (WD.CB and WD.CB.f == f)
if WD.MAP.open and e ~= "down" then WD.MAP.drag(e, f, x, y); busy(); return true end
if IV.open and (e == "move" or e == "nudge" or e == "up" or e == "release" or e == "tap") then
if HBP and HBP.f == f and e ~= "move" and e ~= "nudge" then HBP = nil end
IV.touch(e, f, x, y); busy(); return true
end
if e == "move" or e == "nudge" then
if STICK and STICK.f == f then STICK.dx, STICK.dy = x - STICK.cx, y - STICK.cy; busy() end
return own and true or false
end
if e == "up" or e == "release" or e == "tap" then
if STICK and STICK.f == f then STICK = nil end
if ABTN and ABTN.f == f then
if not ABTN.mining and ms() - ABTN.t0 < 260 and WD.tap then WD.tap() end
ABTN = nil
end
if HBP and HBP.f == f then HBP = nil end
if WD.CB and WD.CB.f == f then WD.CB = nil end
if e == "release" and PANEL then return true end
return own and true or false
end
if PANEL and drag then return true end
return false
end
local PBIT = { A = 1, B = 2, X = 4, Y = 8, LB = 16, RB = 32, ST = 64, SEL = 128, UP = 256, DOWN = 512, LEFT = 1024, RIGHT = 2048 }
WD.PAD = { prev = 0, on = false, cur = 1, pcur = 1, rt = 0 }
function WD.bn()
if ST.ps then return { A = "Cross", B = "Circle", X = "Square", Y = "Triangle", LB = "L1", RB = "R1", ST = "Options" } end
return { A = "A", B = "B", X = "X", Y = "Y", LB = "LB", RB = "RB", ST = "Start" }
end
local function nav(list, cur, dx, dy)
local c = list[cur]
if not c then return 1 end
local cx, cy = c[1] + c[3] / 2, c[2] + c[4] / 2
local best, bs = cur, math.huge
for k, o in ipairs(list) do
if k ~= cur then
local ox, oy = o[1] + o[3] / 2 - cx, o[2] + o[4] / 2 - cy
local along = (dx ~= 0) and ox * dx or oy * dy
local side = (dx ~= 0) and math.abs(oy) or math.abs(ox)
if along > 8 then
local sc = along + side * 2.5
if sc < bs then best, bs = k, sc end
end
end
end
return best
end
function WD.pad(t)
local P = WD.PAD
local b = smudge.pad or 0
local x, y = smudge.padx or 0, smudge.pady or 0
if x * x + y * y < 0.18 * 0.18 then x, y = 0, 0 end
if b & PBIT.LEFT ~= 0 then x = -1 elseif b & PBIT.RIGHT ~= 0 then x = 1 end
if b & PBIT.UP ~= 0 then y = -1 elseif b & PBIT.DOWN ~= 0 then y = 1 end
local pr, rl = b & ~P.prev, P.prev & ~b
P.prev = b
if (pr ~= 0 or x ~= 0 or y ~= 0) and not P.on then P.on = true; P.hint = t; STICK = nil end
WD.PADV = nil
if not P.on then return end
local sx, sy = 0, 0
if x ~= 0 or y ~= 0 then
if not P.held or t >= P.rt then
if math.abs(x) >= math.abs(y) then sx = x > 0 and 1 or -1 else sy = y > 0 and 1 or -1 end
P.rt = t + (P.held and 150 or 400); P.held = true
end
else P.held = false end
local function hit(bit) return pr & bit ~= 0 end
if WD.MAP.open then
local M = WD.MAP
if hit(PBIT.SEL) or hit(PBIT.B) or hit(PBIT.ST) then M.open = false end
if hit(PBIT.LB) then M.zoom(-1) elseif hit(PBIT.RB) then M.zoom(1) end
if hit(PBIT.A) and M.cx then M.wp(M.cx, M.cy, 4 / (3 * M.z)) end
local ax, ay = smudge.padx or 0, smudge.pady or 0
if ax * ax + ay * ay > 0.15 * 0.15 then
local dtp = math.min(0.05, (t - (P.lt or t)) / 1000)
M.cx, M.cy = (M.cx or 64) + ax * 40 * dtp, (M.cy or 64) + ay * 40 * dtp
end
P.lt = t
return
end
do
local rx = smudge.padrx or 0
if not WD.rlatch and math.abs(rx) > 0.6 and not IV.open and not PANEL then WD.turn(rx > 0 and 1 or -1); WD.rlatch = true end
if math.abs(rx) < 0.3 then WD.rlatch = false end
end
if hit(PBIT.SEL) and not IV.open and not PANEL then WD.MAP.open = true; WD.MAP.cx, WD.MAP.cy = nil, nil; ABTN = nil; WD.CB = nil; return end
if IV.open then
local TG = IV.TG or {}
local function center(g) return g[1] + g[3] / 2, g[2] + g[4] / 2 end
local function under()
for k, g in ipairs(TG) do if P.mx >= g[1] and P.mx < g[1] + g[3] and P.my >= g[2] and P.my < g[2] + g[4] then return k end end
end
local dtp = math.min(0.05, (t - (P.lt or t)) / 1000); P.lt = t
if not P.mx then local g = TG[P.cur or 1]; if g then P.mx, P.my = center(g) else P.mx, P.my = W / 2, V[1] + 300 end end
local function snap(dx, dy)
local k = under()
if not k then
local bd = math.huge
for i, g in ipairs(TG) do local gx, gy = center(g); local d = (gx - P.mx) ^ 2 + (gy - P.my) ^ 2; if d < bd then k, bd = i, d end end
if k then P.mx, P.my = center(TG[k]) end
return
end
local n = nav(TG, k, dx, dy)
if TG[n] then P.mx, P.my = center(TG[n]) end
end
local ax, ay = smudge.padx or 0, smudge.pady or 0
if ax * ax + ay * ay < 0.12 * 0.12 then ax, ay = 0, 0 end
if b & (PBIT.UP | PBIT.DOWN | PBIT.LEFT | PBIT.RIGHT) ~= 0 then
if sx ~= 0 or sy ~= 0 then snap(sx, sy) end
elseif ax ~= 0 or ay ~= 0 then
if not P.st0 then P.st0, P.sdx, P.sdy, P.drift = t, ax, ay, false end
if ax * ax + ay * ay > P.sdx * P.sdx + P.sdy * P.sdy then P.sdx, P.sdy = ax, ay end
if t - P.st0 > 150 then if not P.drift then P.drift, P.dt0 = true, t end end
if P.drift then
local m = math.min(1, math.sqrt(ax * ax + ay * ay))
local top = ({ 200, 300, 420, 560, 740 })[ST.psp or 3]
local ramp = 0.3 + 0.7 * math.min(1, (t - P.dt0) / 700)
local sp = top * ramp * m ^ 1.15 / m
P.mx, P.my = P.mx + ax * sp * dtp, P.my + ay * sp * dtp
end
elseif P.st0 then
if not P.drift then
if math.abs(P.sdx) >= math.abs(P.sdy) then snap(P.sdx > 0 and 1 or -1, 0) else snap(0, P.sdy > 0 and 1 or -1) end
end
P.st0 = nil
end
P.mx = math.max(4, math.min(W - 4, P.mx)); P.my = math.max(V[1] + 4, math.min(V[2] - 4, P.my))
P.cur = under()
local tg = P.cur and TG[P.cur]
local D = IV.DRAG
if D and D.f == "pad" then D.x, D.y = P.mx + 22, P.my + 40 end
if (hit(PBIT.A) or hit(PBIT.X)) and not tg and D and D.f == "pad" and D.it then
local gx, gy = IV.gx or 0, IV.gy or 0
if not (P.mx >= gx and P.mx < gx + 428 and P.my >= gy and P.my < gy + 404) then
IV.DRAG = nil
local d = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[PL.face] or { 0, 1 }
local tx, ty = PL.x + d[1] * 40, PL.y + d[2] * 40
if WD.solid(tx, ty - 4) then tx, ty = PL.x, PL.y + 4 end
IV.drop(D.it.id, D.it.n, tx, ty, true, D.it.d); snd("wl_pop", 0.3); dirty = true
end
end
if (hit(PBIT.A) or hit(PBIT.X)) and tg then
local half = hit(PBIT.X)
if tg.sl then
if D and D.f == "pad" and D.it then
if half and D.it.n > 1 then
local one = { kind = D.kind, k = D.k, it = { id = D.it.id, n = 1 } }
D.it.n = D.it.n - 1
IV.put(one, tg.sl)
else IV.put(D, tg.sl); IV.DRAG = nil end
dirty = true
elseif not D then
local N2 = { f = "pad", kind = tg.sl[1], k = tg.sl[2], x = tg[1] + 38, y = tg[2] + 48, x0 = 0, y0 = 0, t0 = ms() }
IV.DRAG = N2; IV.lift(half)
if not N2.it then IV.DRAG = nil end
end
elseif tg.rec then IV.pick(tg.rec)
elseif tg.cpage then IV.CP = (tg.cpage < 0) and 1 or 2; snd("click", 0.2)
elseif tg.page then IV.BPAGE = math.max(1, math.min(IV.BPAGES or 1, IV.BPAGE + tg.page)); snd("click", 0.2)
elseif tg.book then IV.BOOK = not IV.BOOK; IV.GHOST = nil; snd("click", 0.25) end
end
if IV.MODE == "chest" and IV.CH and IV.CH[2] then
if hit(PBIT.LB) then IV.CP = 1 elseif hit(PBIT.RB) then IV.CP = 2 end
end
if hit(PBIT.LB) and IV.BOOK then IV.BPAGE = math.max(1, IV.BPAGE - 1) end
if hit(PBIT.RB) and IV.BOOK then IV.BPAGE = math.min(IV.BPAGES or 1, IV.BPAGE + 1) end
if hit(PBIT.B) then
if D and D.f == "pad" and D.it then
IV.DRAG = nil
local d = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[PL.face] or { 0, 1 }
local tx, ty = PL.x + d[1] * 40, PL.y + d[2] * 40
if WD.solid(tx, ty - 4) then tx, ty = PL.x, PL.y + 4 end
IV.drop(D.it.id, D.it.n, tx, ty, true, D.it.d); snd("wl_pop", 0.3); dirty = true
else IV.close() end
elseif hit(PBIT.Y) then IV.close() end
return
end
if PANEL then
local PB = WD.PB or {}
if sx ~= 0 or sy ~= 0 then P.pcur = nav(PB, P.pcur or 1, sx, sy) end
local bt = PB[P.pcur or 1]
if hit(PBIT.A) and bt and bt[5] then snd("click", 0.2); bt[5]() end
if hit(PBIT.B) then PANEL = (PANEL == "menu") and nil or "menu"; P.pcur = 1
elseif hit(PBIT.ST) then PANEL = nil end
return
end
if x ~= 0 or y ~= 0 then WD.PADV = { x, y } end
if hit(PBIT.A) and not ABTN then ABTN = { f = "pad", t0 = ms() } end
if rl & PBIT.A ~= 0 and ABTN and ABTN.f == "pad" then
if not ABTN.mining and ms() - ABTN.t0 < 260 then WD.tap() end
ABTN = nil
end
if hit(PBIT.X) and can_build() then WD.CB = { f = "pad", face = PL.face }; WD.place(true) end
if rl & PBIT.X ~= 0 and WD.CB and WD.CB.f == "pad" then WD.CB = nil end
if hit(PBIT.LB) then ST.sel = (ST.sel - 2) % 9 + 1; ST.save(); snd("click", 0.2) end
if hit(PBIT.RB) then ST.sel = ST.sel % 9 + 1; ST.save(); snd("click", 0.2) end
if hit(PBIT.Y) then IV.open = true; IV.MODE = "inv"; ABTN = nil; WD.CB = nil; P.cur = #IV.SL - 9 + ST.sel; P.mx = nil end
if hit(PBIT.ST) then PANEL = "menu"; P.pcur = 1; ABTN = nil; WD.CB = nil end
end
local function move(dt)
local sx, sy = 0, 0
local vx, vy, full = nil, nil, 60
if STICK then vx, vy = STICK.dx, STICK.dy elseif WD.PADV then vx, vy, full = WD.PADV[1] * 60, WD.PADV[2] * 60, 60 end
if vx and not PANEL then
local d = math.sqrt(vx ^ 2 + vy ^ 2)
if d > 6 then
local m = math.min(1, d / full)
sx, sy = vx / d * m, vy / d * m
if WD.CB then PL.face = WD.CB.face
elseif math.abs(sx) > math.abs(sy) then PL.face = sx > 0 and "right" or "left" else PL.face = sy > 0 and "down" or "up" end
if WD.CAM.a ~= 0 then
PL.sface = PL.face
local C = WD.CAMV
local wx, wy = C.c * sx + C.s * sy, -C.s * sx + C.c * sy
sx, sy = wx, wy
if not WD.CB then
if math.abs(wx) > math.abs(wy) + 0.01 then PL.face = wx > 0 and "right" or "left" else PL.face = wy > 0 and "down" or "up" end
end
end
end
end
local ox, oy = PL.x, PL.y
local nx = math.max(16, math.min(N * TS - 16, PL.x + sx * SPEED * dt))
if WD.free(nx, PL.y) then PL.x = nx end
local ny = math.max(30, math.min(N * TS - 4, PL.y + sy * SPEED * dt))
if WD.free(PL.x, ny) then PL.y = ny end
local moved = math.abs(PL.x - ox) + math.abs(PL.y - oy)
if moved > 0 then
PL.dist = PL.dist + moved
local was = PL.step
PL.step = ({ 1, 0, 2, 0 })[fl(PL.dist / 16) % 4 + 1]; PL.walk = true
if PL.step ~= 0 and was == 0 then
local g = WD.G[fl(PL.y / TS) * N + fl(PL.x / TS)] or "gr1"
local kind = ({ gr1 = "grass", di1 = "dirt", sa1 = "sand", fl1 = "wood", fl3 = "dirt", fl2 = "stone", fl4 = "stone" })[g] or "grass"
snd("wl_step_" .. kind .. X.rnd(1, 3), 0.1)
end
dirty = true
else PL.step = 0; PL.walk = false end
WD.stairs_walk()
end
local function safe_name(n) n = (n or ""):gsub("[|\n;]", ""); if n == "" then n = "Friend" end; return n:sub(1, 12) end
local function mp_send(txt)
if MP and MP.st == 2 and smudge.mp and (next(MP.peers) or txt:sub(1, 2) == "h|") then smudge.mp("send", "B", txt) end
end
local function mp_hello()
mp_send("h|" .. tostring(GAME_VERSION or "?") .. "|" .. MP.name .. "|" .. ST.code(ST.look) .. "|" .. WD.doors(WD.LV[0]) ..
"|" .. (WD.SEED or 0) .. "|" .. (MP.role or "H"))
MP.thello = ms()
end
ST.on_look = function() if MP and MP.st == 2 then mp_hello() end end
local function mp_start()
local _, _, n = smudge.mp("get")
MP = { st = 0, peers = {}, name = safe_name(n), tpos = 0, thello = 0, topen = 0 }
smudge.mp("open")
end
local function mp_stop()
if not MP then return end
mp_send("q|" .. MP.name)
smudge.mp("close")
MP = nil
end
local function peer(nm)
local p = MP.peers[nm]
if not p then p = { x = PL.x, y = PL.y, tx = PL.x, ty = PL.y, face = "down", dist = 0, step = 0, seen = ms(), new = true }; MP.peers[nm] = p end
p.seen = ms()
return p
end
local function mp_msg(m)
local f = {}
for v in (m:match("^[^\n]*") .. "|"):gmatch("([^|]*)|") do f[#f + 1] = v end
local k = f[1]
if k == "h" then
local p = peer(safe_name(f[3])); p.ver = f[2]; p.look = ST.parse(f[4])
MP.block = (f[2] ~= tostring(GAME_VERSION or "?")) and { safe_name(f[3]), f[2] } or nil
if not MP.block and f[7] == "H" and MP.role == "G" and WORLD == "join" then
WD.SEED = tonumber(f[6]) or 0
smudge.save("wilds2_mp", "")
WKEY = "wilds2_mp"; load(); LAST = nil; WORLD = "ours"
X.set_note("You're in " .. safe_name(f[3]) .. "'s world")
elseif f[7] == "H" and MP.role == "H" and p.new then
X.set_note(safe_name(f[3]) .. " is sharing a world too: one of you should JOIN")
end
if p.new then
p.new = false; mp_hello(); snd("pr_holy", 0.3); X.set_note(safe_name(f[3]) .. " is here!")
for z, L in pairs(WD.LV) do
local l = {}
for i, c in pairs(L.CHG) do
l[#l + 1] = WD.gi(i, z) .. ":" .. c
if #l >= 40 then mp_send("c|" .. table.concat(l, ";")); l = {} end
end
if #l > 0 then mp_send("c|" .. table.concat(l, ";")) end
l = {}
for i, g in pairs(L.GCH) do
l[#l + 1] = WD.gi(i, z) .. ":" .. g
if #l >= 40 then mp_send("e|" .. table.concat(l, ";")); l = {} end
end
if #l > 0 then mp_send("e|" .. table.concat(l, ";")) end
end
if MP.role ~= "G" then
for _, d in ipairs(IV.DROPS) do mp_send(string.format("x|%s|%s|%d|%d|%d|%d|%d", d.uid, d.id, d.n, d.x, d.y, d.z or 0, d.d or 0)) end
for _, L in pairs(WD.LV) do for i, F in pairs(L.FURN) do F.sig = nil end end
for _, L in pairs(WD.LV) do for i, C in pairs(L.CHEST) do C.sig = nil end end
MP.tanim, MP.twx = 0, 0
end
end
if f[5] and f[5] ~= WD.doors(WD.LV[0]) and MP.host_doors == nil then MP.host_doors = true; WD.set_doors(f[5], WD.LV[0]) end
elseif k == "p" then
local p = peer(safe_name(f[2]))
local x, y = tonumber(f[3]), tonumber(f[4])
if x and y then
if p.new then p.x, p.y, p.new = x, y, false end
p.tx, p.ty, p.face = x, y, ({ down = 1, up = 1, left = 1, right = 1 })[f[5]] and f[5] or "down"
p.hold = (f[6] and IV.NAME[f[6]]) and f[6] or nil
p.z = math.max(-WD.DEEP, math.min(0, tonumber(f[7] or "") or 0))
end
elseif k == "q" then MP.peers[safe_name(f[2])] = nil
elseif k == "x" then
local id, n, x, y = f[3], tonumber(f[4]), tonumber(f[5]), tonumber(f[6])
if f[2] and IV.NAME[id] and n and x and y then
local d0
for _, d in ipairs(IV.DROPS) do if d.uid == f[2] then d0 = d end end
local dz, dd = tonumber(f[7] or "") or 0, tonumber(f[8] or "")
if d0 then d0.n = n else IV.DROPS[#IV.DROPS + 1] = { id = id, n = math.max(1, math.min(64, n)), x = x, y = y, t0 = ms(), uid = f[2], z = dz, d = (dd and dd > 0) and dd or nil } end
end
elseif k == "w" then
local T = tonumber(f[2])
if T and MP.role == "G" then WD.WX.T = T end
elseif k == "a" then
if MP.role == "G" then WD.anim_in(f[2] or "") end
elseif k == "f" then
WD.furn_in(f)
elseif k == "k" then
local i, z = WD.split(f[2])
local L = i and WD.lv(z)
if L and IV.CHESTB[L.B[i] or ""] then
local C = L.CHEST[i] or { s = {} }
L.CHEST[i] = C
local new = WD.cslots(f[3] or "")
for kk = 1, 27 do C.s[kk] = new[kk] end
C.sig = f[3] or ""; dirty = true
elseif L then L.CHEST[i] = nil end
elseif k == "y" then
for j = #IV.DROPS, 1, -1 do if IV.DROPS[j].uid == f[2] then table.remove(IV.DROPS, j) end end
elseif k == "g" or k == "e" then
local txt = (k == "g") and ((f[2] or "") .. ":" .. (f[3] or "")) or (f[2] or "")
for gi, g in txt:gmatch("(%d+):(%w+)") do
local i, z = WD.split(gi)
if i and IV.GOK[g] then WD.setg(i, g, true, z) end
end
elseif k == "b" or k == "c" then
local txt = (k == "b") and ((f[2] or "") .. ":" .. (f[3] or "")) or (f[2] or "")
for gi, c in txt:gmatch("(%d+):([%w%-]+)") do
local i, z = WD.split(gi)
if i and (c == "-" or IV.NAME[c]) then WD.setb(i, (c ~= "-") and c or nil, true, z) end
end
elseif k == "d" then
local i, z = WD.split(f[2])
local L = i and WD.lv(z)
if L and L.B[i] == "do" then L.OPEN[i] = (f[3] == "1") or nil; dirty = true; if z == WD.Z then snd("door", 0.25) end end
end
end
local function mp_tick(t, dt)
local st, list, err = smudge.mp("poll")
MP.st, MP.err = tonumber(st) or 0, err
for _, m in ipairs(type(list) == "table" and list or {}) do
local k, b = m:sub(1, 1), m:sub(2)
if k == "J" then if MP.st == 2 then mp_hello(); MP.tpos = 0 end
elseif k == "L" then MP.peers = {}
elseif k == "B" then mp_msg(b) end
end
if MP.st == 2 and (next(MP.peers) or WORLD == "join") then
if t - MP.thello > 5000 then mp_hello() end
end
if MP.st == 2 and next(MP.peers) and WORLD == "ours" then
local hold = IV.S[ST.sel] and IV.S[ST.sel].id or "0"
local moved = (MP.lx ~= fl(PL.x) or MP.ly ~= fl(PL.y) or MP.lf ~= PL.face or MP.lh ~= hold)
if (moved and t - MP.tpos > 110) or t - MP.tpos > 3000 then
mp_send(string.format("p|%s|%d|%d|%s|%s|%d", MP.name, fl(PL.x), fl(PL.y), PL.face, hold, WD.Z)); MP.lh = hold
MP.tpos, MP.lx, MP.ly, MP.lf = t, fl(PL.x), fl(PL.y), PL.face
end
end
if MP.st ~= 2 and t - MP.topen > 3000 then MP.topen = t; smudge.mp("open") end
for nm, p in pairs(MP.peers) do
local ox, oy = p.x, p.y
local a = math.min(1, dt * 12)
p.x, p.y = p.x + (p.tx - p.x) * a, p.y + (p.ty - p.y) * a
if math.abs(p.tx - p.x) > 200 or math.abs(p.ty - p.y) > 200 then p.x, p.y = p.tx, p.ty end
local d = math.abs(p.x - ox) + math.abs(p.y - oy)
if d > 0.3 then p.dist = p.dist + d; p.step = ({ 1, 0, 2, 0 })[fl(p.dist / 16) % 4 + 1]; p.walk = true
else p.step, p.walk = 0, false end
if t - p.seen > 12000 then MP.peers[nm] = nil end
end
end
IV.nd = 0
function IV.drop(id, n, x, y, wait, dur)
IV.nd = IV.nd + 1
local d = { id = id, n = n, x = fl(x), y = fl(y), t0 = ms(), uid = (MP and MP.name or "me") .. "." .. IV.nd .. "." .. X.rnd(100, 999), wait = wait, z = WD.Z, d = dur }
IV.DROPS[#IV.DROPS + 1] = d
mp_send(string.format("x|%s|%s|%d|%d|%d|%d|%d", d.uid, id, n, d.x, d.y, d.z, d.d or 0))
return d
end
function WD.setg(i, g, quiet, z)
z = z or WD.Z
local L = WD.lv(z)
L.G[i] = g; L.GCH[i] = g; dirty = true
if WD.MAP and z == WD.Z then WD.MAP.dirty = true end
if not quiet then mp_send("g|" .. WD.gi(i, z) .. "|" .. g) end
end
function WD.setb(i, c, quiet, z)
z = z or WD.Z
local L = WD.lv(z)
local old = L.B[i]
L.B[i] = c
if WD.MAP and z == WD.Z then WD.MAP.dirty = true end
L.CHG[i] = c or "-"
if c and IV.GROWB[c] then L.GROW[i] = (old == c and L.GROW[i]) or WD.now() else L.GROW[i] = nil end
if not c and old == "tr" then L.RG[i] = WD.now() else L.RG[i] = nil end
if c ~= "do" then L.OPEN[i] = nil end
dirty = true
if not quiet then mp_send("b|" .. WD.gi(i, z) .. "|" .. (c or "-")) end
if quiet and c ~= "fu" then L.FURN[i] = nil end
end
function WD.stairs(i, id, loud)
local z2 = (id == "sd") and WD.Z - 1 or WD.Z + 1
local function no(t) if loud then X.set_note(t) end; return false end
if z2 < -WD.DEEP then return no("The rock is too hard to go deeper") end
if z2 > 0 then return no("There's nothing above the land") end
local L2 = WD.lv(z2)
local other = (id == "sd") and "su" or "sd"
if z2 < 0 then
local tx, ty = i % N, i // N
for y = math.max(1, ty - 1), math.min(N - 2, ty + 1) do for x = math.max(1, tx - 1), math.min(N - 2, tx + 1) do
local j = y * N + x
local b = L2.B[j]
if b and (b == "b05" or b == "b03" or b:match("^or%d$")) then WD.setb(j, nil, false, z2) end
end end
elseif L2.B[i] or L2.G[i] == "wa" then return no("Something is in the way up there") end
if L2.B[i] then return no("Something is in the way down there") end
WD.setb(i, id)
WD.setb(i, other, false, z2)
return true
end
function WD.unstair(i, b)
local z2 = (b == "sd") and WD.Z - 1 or WD.Z + 1
if z2 < -WD.DEEP or z2 > 0 then return end
local L2 = WD.lv(z2)
if L2.B[i] == ((b == "sd") and "su" or "sd") then WD.setb(i, nil, false, z2) end
end
function WD.stairs_walk()
local tx, ty = fl(PL.x / TS), fl((PL.y - 6) / TS)
local i = ty * N + tx
local b = WD.B[i]
if b ~= "sd" and b ~= "su" then WD.onst = nil; return end
if WD.onst == i then return end
local z2 = (b == "sd") and WD.Z - 1 or WD.Z + 1
if z2 < -WD.DEEP or z2 > 0 then return end
WD.go(z2)
PL.x, PL.y = (tx + 0.5) * TS, (ty + 0.5) * TS + 6
WD.onst = i
ABTN, WD.CB = nil, nil
snd("wl_step_stone" .. X.rnd(1, 3), 0.6)
X.set_note((z2 == 0) and "Back on the land" or ("Level " .. z2))
dirty = true
end
function WD.front()
local d = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[PL.face] or { 0, 1 }
if WD.CAM.a ~= 0 and PL.sface and not WD.CB then
local sd = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[PL.sface] or { 0, 1 }
local C = WD.CAMV
d = { C.c * sd[1] + C.s * sd[2], -C.s * sd[1] + C.c * sd[2] }
end
local tx, ty = fl((PL.x + d[1] * 34) / TS), fl((PL.y - 6 + d[2] * 34) / TS)
if tx < 0 or ty < 0 or tx >= N or ty >= N then return nil end
return ty * N + tx, tx, ty
end
local function someone_on(tx, ty)
local function on(p) return p.x + WD.FW > tx * TS and p.x - WD.FW < (tx + 1) * TS and p.y + WD.FB >= ty * TS and p.y - 12 < (ty + 1) * TS end
if on(PL) then return true end
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z and on(p) then return true end end end
return false
end
function WD.plantok(i, id)
local g = WD.G[i]
if id == "sp" then return (g == "gr1" or g == "di1" or g == "fl3"), "Plant a sapling on grass or dirt" end
return g == "fl3", "Seeds go on a field: dig one with a hoe first"
end
function WD.ghost()
if PANEL or IV.open or (ABTN and ABTN.mining) then return nil end
local it = IV.S[ST.sel]
if not it or not (IV.block(it.id) or IV.FLOOR[it.id] or IV.PLANT[it.id]) then return nil end
local i, tx, ty = WD.front()
if not i or WD.B[i] or WD.G[i] == "wa" then return nil end
if IV.PLANT[it.id] then return (WD.plantok(i, it.id)) and i or nil, it.id end
if IV.FLOOR[it.id] then return (WD.G[i] ~= it.id) and i or nil, it.id end
if someone_on(tx, ty) then return nil end
return i, it.id
end
function WD.tap()
local i, tx, ty = WD.front()
if not i then return end
if WD.B[i] == "do" then WD.act(i); return end
if IV.CHESTB[WD.B[i] or ""] then
local b = WD.B[i]
IV.CH = (b == "cl") and { i, i + 1 } or (b == "cr") and { i - 1, i } or { i }
IV.CP, IV.open, IV.MODE, STICK, IV.BOOK = 1, true, "chest", nil, false
if WD.PAD then WD.PAD.cur = 1; WD.PAD.mx = nil end
snd("door", 0.3); return
end
if WD.B[i] == "ct" or WD.B[i] == "fu" then
IV.open, IV.MODE, STICK = true, (WD.B[i] == "ct") and "table" or "furnace", nil
if WD.B[i] == "fu" then IV.FI = i; WD.FURN[i] = WD.FURN[i] or { s = {}, burn = 0, bmax = 0, prog = 0 } end
if WD.PAD then WD.PAD.cur = #IV.slots() - 9 + ST.sel; WD.PAD.mx = nil end
snd("click", 0.3); return
end
if WD.B[i] then return end
local it = IV.S[ST.sel]
if it and IV.TOOLS[it.id:sub(1, 2)] and it.id:sub(1, 2) == "ho" and #it.id == 3 then
local g = WD.G[i]
if g == "gr1" or g == "di1" then
WD.setg(i, "fl3"); snd("wl_step_dirt" .. X.rnd(1, 3), 0.5); IV.wear(ST.sel)
if g == "gr1" and math.random() < 0.2 then IV.drop("ws", 1, (tx + 0.5) * TS, (ty + 0.75) * TS) end
end
return
end
WD.place(true)
end
function WD.place(loud)
local i, tx, ty = WD.front()
if not i or WD.B[i] then return false end
local it = IV.S[ST.sel]
if not it or not (IV.block(it.id) or IV.FLOOR[it.id] or IV.PLANT[it.id]) then return false end
if WD.G[i] == "wa" then if loud then X.set_note("Not on water") end; return false end
if IV.PLANT[it.id] then
local ok, g = WD.plantok(i, it.id)
if not ok then if loud then X.set_note(g) end; return false end
WD.setb(i, IV.PLANT[it.id])
elseif IV.FLOOR[it.id] then
if WD.G[i] == it.id then return false end
WD.setg(i, it.id)
elseif it.id == "ch" then
if someone_on(tx, ty) then return false end
if tx > 0 and WD.B[i - 1] == "ch" then WD.setb(i - 1, "cl"); WD.setb(i, "cr")
elseif tx < N - 1 and WD.B[i + 1] == "ch" then WD.setb(i, "cl"); WD.setb(i + 1, "cr")
else WD.setb(i, "ch") end
elseif it.id == "sd" or it.id == "su" then
if not loud or someone_on(tx, ty) or not WD.stairs(i, it.id, loud) then return false end
else
if someone_on(tx, ty) then return false end
WD.setb(i, it.id)
end
it.n = it.n - 1
if it.n <= 0 then IV.S[ST.sel] = nil; WD.CB = nil end
snd("wl_step_" .. (IV.SND[it.id] or "stone") .. X.rnd(1, 3), 0.4)
return true
end
function WD.animals()
WD.ANIM = {}
local c, S = N // 2, WD.SEED or 0
local n = 0
for k = 1, 60 do
if n >= 5 then break end
local tx = c + fl(hash(k * 7 + S, 11) * 30) - 15
local ty = c + fl(hash(k * 13, 17 + S) * 30) - 15
local x, y = (tx + 0.5) * TS, (ty + 0.7) * TS
if (math.abs(tx - c) > 3 or math.abs(ty - c) > 3) and WD.free(x, y, true) and WD.free(x - 20, y, true) and WD.free(x + 20, y, true) then
n = n + 1
WD.ANIM[n] = { an = "an1", x = x, y = y, face = "down", step = 0, dist = 0, next = 0, vx = 0, vy = 0 }
end
end
end
local function slotstr(it) return it and (it.id .. ":" .. it.n) or "-" end
local function slotin(v) local id, n = (v or ""):match("^(%w+):(%d+)$"); return (id and IV.NAME[id]) and { id = id, n = math.max(1, math.min(64, tonumber(n))) } or nil end
function WD.msync(t)
for z, L in pairs(WD.LV) do for i, C in pairs(L.CHEST) do
local l = {}
for k = 1, 27 do local it = C.s[k]; if it then l[#l + 1] = k .. "." .. it.id .. "." .. it.n .. (it.d and ("." .. it.d) or "") end end
local sig = table.concat(l, ",")
if sig ~= C.sig then
if C.sig ~= nil or sig ~= "" then mp_send("k|" .. WD.gi(i, z) .. "|" .. sig) end
C.sig = sig
end
end end
for z, L in pairs(WD.LV) do for i, F in pairs(L.FURN) do
local sig = slotstr(F.s[1]) .. "|" .. slotstr(F.s[2]) .. "|" .. slotstr(F.s[3])
local burning = MP.role ~= "G" and F.burn > 0 and t - (F.tsend or 0) > 1000
if sig ~= F.sig or burning then
F.sig, F.tsend = sig, t
mp_send(string.format("f|%d|%s|%d|%d|%d", WD.gi(i, z), sig, fl(F.burn * 10), fl(F.bmax), fl(F.prog * 10)))
end
end end
if MP.role ~= "G" and t - (MP.twx or 0) > 15000 then MP.twx = t; mp_send("w|" .. fl(WD.WX.T)) end
if MP.role ~= "G" and t - (MP.tanim or 0) > 250 and WD.ANIM then
MP.tanim = t
local o = {}
for _, a in ipairs(WD.ANIM) do o[#o + 1] = fl(a.x) .. "," .. fl(a.y) .. "," .. a.face:sub(1, 1) end
mp_send("a|" .. table.concat(o, ";"))
end
end
function WD.furn_in(f)
local i, z = WD.split(f[2])
local L = i and WD.lv(z)
if not L or L.B[i] ~= "fu" then return end
local F = L.FURN[i] or { s = {}, burn = 0, bmax = 0, prog = 0 }
L.FURN[i] = F
F.s = { slotin(f[3]), slotin(f[4]), slotin(f[5]) }
F.sig = slotstr(F.s[1]) .. "|" .. slotstr(F.s[2]) .. "|" .. slotstr(F.s[3])
if MP and MP.role == "G" then F.burn, F.bmax, F.prog = (tonumber(f[6]) or 0) / 10, tonumber(f[7]) or 0, (tonumber(f[8]) or 0) / 10 end
dirty = true
end
function WD.anim_in(txt)
local FACE = { d = "down", u = "up", l = "left", r = "right" }
local L, k = WD.ANIM or {}, 0
for x, y, fc in txt:gmatch("(%-?%d+),(%-?%d+),(%a)") do
k = k + 1
local a = L[k]
if not a then a = { an = "an1", x = tonumber(x), y = tonumber(y), step = 0, dist = 0 }; L[k] = a end
a.tx, a.ty, a.face = tonumber(x), tonumber(y), FACE[fc] or "down"
end
for j = #L, k + 1, -1 do L[j] = nil end
WD.ANIM = L
end
function WD.atick(t, dt)
if MP and MP.role == "G" then
for _, a in ipairs(WD.ANIM or {}) do
if a.tx then
local ox, oy = a.x, a.y
local m = math.min(1, dt * 10)
a.x, a.y = a.x + (a.tx - a.x) * m, a.y + (a.ty - a.y) * m
if math.abs(a.tx - a.x) > 150 or math.abs(a.ty - a.y) > 150 then a.x, a.y = a.tx, a.ty end
local d = math.abs(a.x - ox) + math.abs(a.y - oy)
if d > 0.2 then a.dist = a.dist + d; a.step = ({ 1, 0, 2, 0 })[fl(a.dist / 14) % 4 + 1] else a.step = 0 end
end
end
return
end
for _, a in ipairs(WD.ANIM or {}) do
if t >= a.next then
local r = X.rnd(1, 6)
local d = ({ { 0, 1, "down" }, { 0, -1, "up" }, { -1, 0, "left" }, { 1, 0, "right" } })[r]
if d then a.vx, a.vy, a.face = d[1] * 42, d[2] * 42, d[3] else a.vx, a.vy = 0, 0 end
a.next = t + X.rnd(900, 2600)
end
local moved = false
if a.vx ~= 0 or a.vy ~= 0 then
local nx, ny = a.x + a.vx * dt, a.y + a.vy * dt
if WD.free(nx - 8 * (a.vx < 0 and 1 or 0) + 8 * (a.vx > 0 and 1 or 0), ny, true) and not someone_on(fl(nx / TS), fl(ny / TS)) then
a.x, a.y, moved = nx, ny, true
else a.vx, a.vy = 0, 0 end
end
if moved then a.dist = a.dist + 42 * dt; a.step = ({ 1, 0, 2, 0 })[fl(a.dist / 14) % 4 + 1] else a.step = 0 end
end
end
local MAPC = {
gr1 = { 89, 143, 41 }, di1 = { 50, 35, 17 }, sa1 = { 177, 170, 65 }, wa = { 83, 162, 212 }, fl1 = { 133, 106, 66 },
fl2 = { 110, 110, 110 }, fl3 = { 74, 49, 24 }, fl4 = { 113, 113, 113 }, b01 = { 82, 66, 41 }, b02 = { 91, 91, 91 },
b03 = { 70, 70, 70 }, b04 = { 120, 92, 50 }, b05 = { 76, 76, 76 }, b06 = { 47, 32, 15 }, b07 = { 35, 72, 25 },
b08 = { 227, 205, 74 }, or1 = { 97, 149, 144 }, or2 = { 150, 60, 20 }, or3 = { 160, 150, 140 }, or4 = { 30, 30, 30 },
or5 = { 40, 50, 200 }, or6 = { 40, 160, 50 }, or7 = { 190, 20, 30 }, or8 = { 230, 180, 20 }, ct = { 81, 58, 33 },
fu = { 84, 84, 84 }, ["do"] = { 100, 70, 40 }, to = { 255, 210, 90 }, sd = { 240, 240, 240 }, su = { 240, 240, 240 },
tr = { 34, 92, 34 }, ch = { 150, 100, 50 }, cl = { 150, 100, 50 }, cr = { 150, 100, 50 }, sg = { 90, 160, 60 }, cw = { 200, 180, 70 }, cc = { 120, 170, 60 }, cp = { 100, 150, 60 } }
local MAPS = {}
for k, c in pairs(MAPC) do MAPS[k] = string.char(c[1], c[2], c[3], 255) end
local MAPX = string.char(0, 0, 0, 255)
local MAP = { dirty = true, mini = nil }
WD.MAP = MAP
local function mpx(i) return MAPS[WD.B[i] or WD.G[i]] or MAPS[WD.G[i]] or MAPX end
function MAP.ok() return smudge.hires_image ~= nil end
function MAP.paint(t)
if not MAP.ok() then return end
if MAP.dirty and (t - (MAP.tp or 0) > 30000 or (MAP.open and t - (MAP.tp or 0) > 1000) or not MAP.tp) then
MAP.tp, MAP.dirty = t, false
local rows = {}
for y = 0, N - 1 do
local r = {}
for x = 0, N - 1 do r[x + 1] = mpx(y * N + x) end
rows[y + 1] = table.concat(r)
end
smudge.hires_image("map_c.png", N, N, table.concat(rows))
MAP.mini = nil
end
local mx, my = fl(PL.x / TS) - 20, fl(PL.y / TS) - 20
if MAP.mini ~= mx .. "," .. my then
MAP.mini = mx .. "," .. my
local rows = {}
for y = my, my + 39 do
local r = {}
for x = mx, mx + 39 do r[#r + 1] = (x >= 0 and y >= 0 and x < N and y < N) and mpx(y * N + x) or MAPX end
rows[#rows + 1] = table.concat(r)
end
smudge.hires_image("mini_c.png", 40, 40, table.concat(rows))
MAP.mx, MAP.my = mx, my
end
end
local function mquad(nm, x0, y0, x1, y1)
if NQ >= CAP then return end
NQ = NQ + 1
local o = -9
smudge.hires_quad("^dyn/" .. nm, o, o, o, o, o, o, o, o, x0, y0, x1, y0, x1, y1, x0, y1)
end
function MAP.dots(x0, y0, sc, ox, oy, w, h)
local function dot(nm, px, py)
local x, y = x0 + (px / TS - ox) * sc, y0 + (py / TS - oy) * sc
if x >= x0 and y >= y0 and x < x0 + w and y < y0 + h then UI.pic(nm, fl(x - 4), fl(y - 4), fl(x + 4), fl(y + 4)) end
end
for _, wp in ipairs(WD.WP or {}) do
local x, y = x0 + (wp.x + 0.5 - ox) * sc, y0 + (wp.y + 0.5 - oy) * sc
if (wp.z or 0) == WD.Z and x >= x0 and y >= y0 and x < x0 + w and y < y0 + h then UI.pic("ui_wp" .. wp.c, fl(x - 7), fl(y - 18), fl(x + 7), fl(y)) end
end
for _, a in ipairs((WD.Z == 0) and WD.ANIM or {}) do dot("ui_dot_an", a.x, a.y) end
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then dot("ui_dot_you", p.x, p.y) end end end
dot("ui_dot_me", PL.x, PL.y)
end
function MAP.corner(y0)
if not MAP.ok() or not MAP.mx then return end
local s, x0, yy = 3, W - 128, y0 + 68
UI.pic("ui_mapbg", x0 - 4, yy - 4, x0 + 124, yy + 124)
mquad("mini_c.png", x0, yy, x0 + 120, yy + 120)
MAP.dots(x0, yy, s, MAP.mx, MAP.my, 120, 120)
OT.c(x0 + 60, yy + 126, fl(PL.x / TS) .. ", " .. fl(PL.y / TS) .. ((WD.Z ~= 0) and ("  L" .. WD.Z) or ""), "small", "bold")
if not (WD.PAD and WD.PAD.on) then
X.button(x0 - 2, yy + 154, 58, 44, "<", function() WD.turn(-1) end, { font = "ui10", id = "WLTURNL", nohelp = true })
X.button(x0 + 64, yy + 154, 58, 44, ">", function() WD.turn(1) end, { font = "ui10", id = "WLTURNR", nohelp = true })
end
X.reg("WLMAPC", x0 - 4, yy - 4, 128, 128, function() MAP.open = true; MAP.cx, MAP.cy = nil, nil end, false)
end
MAP.z = 1
function MAP.view(y0, y1)
local rx, ry, rw, rh = 12, y0 + 56, W - 24, (y1 - y0) - 56 - 120
return rx, ry, rw, rh, 3 * MAP.z
end
function MAP.clamp(y0, y1)
local rx, ry, rw, rh, s = MAP.view(y0, y1)
MAP.cx = math.max(0.5, math.min(N - 0.5, MAP.cx or PL.x / TS))
MAP.cy = math.max(0.5, math.min(N - 0.5, MAP.cy or PL.y / TS))
end
function MAP.zoom(d)
MAP.z = math.max(1, math.min(4, (d > 0) and MAP.z * 2 or MAP.z // 2))
snd("click", 0.2)
end
function MAP.big(y0, y1)
MAP.clamp(y0, y1)
local rx, ry, rw, rh, s = MAP.view(y0, y1)
local x0, yy = fl(rx + rw / 2 - MAP.cx * s), fl(ry + rh / 2 - MAP.cy * s)
UI.pic("ui_mapbg", 0, y0, W, y1)
mquad("map_c.png", x0, yy, x0 + N * s, yy + N * s)
local ox, oy = (rx - x0) / s, (ry - yy) / s
MAP.vr = { rx, ry, rw, rh, s, x0, yy }
MAP.dots(rx, ry, s, ox, oy, rw, rh)
do
local mx, my = fl(rx + rw / 2), fl(ry + rh / 2)
UI.pic("ui_dot_me", mx - 12, my - 1, mx - 4, my + 1); UI.pic("ui_dot_me", mx + 4, my - 1, mx + 12, my + 1)
UI.pic("ui_dot_me", mx - 1, my - 12, mx + 1, my - 4); UI.pic("ui_dot_me", mx - 1, my + 4, mx + 1, my + 12)
end
UI.pic("ui_mapbg", 0, y0, W, ry); UI.pic("ui_mapbg", 0, ry + rh, W, y1)
UI.pic("ui_mapbg", 0, ry, rx, ry + rh); UI.pic("ui_mapbg", rx + rw, ry, W, ry + rh)
OT.c(W // 2, y0 + 2, (WD.Z == 0) and "Map" or ("Map: level " .. WD.Z), "ui12", "bold")
local tx, ty = fl(MAP.cx), fl(MAP.cy)
OT.c(W // 2, ry - 23, "X " .. tx .. "   Y " .. ty .. "   " .. MAP.what(tx, ty), "small", "bold")
local n = WD.bn and WD.bn() or {}
local pad = WD.PAD and WD.PAD.on
OT.c(W // 2, ry + rh + 8, X.fit(pad and ((n.LB or "LB") .. " / " .. (n.RB or "RB") .. ": zoom   stick: move   " .. (n.A or "A") .. ": waypoint   Select / " .. (n.B or "B") .. ": close")
or "Drag to move   tap: waypoint (tap it again: away)", W - 24, "small"), "small")
X.reg("WLMAPBIG", 0, y0, W, y1 - y0, function() end, false)
local by = ry + rh + 40
X.button(24, by, 80, 56, "-", function() MAP.zoom(-1) end, { font = "ui12", off = MAP.z <= 1, id = "WLMAPZO", nohelp = true })
X.button(116, by, 80, 56, "+", function() MAP.zoom(1) end, { font = "ui12", off = MAP.z >= 4, id = "WLMAPZI", nohelp = true })
OT.c(244, by + 16, MAP.z .. "x", "small", "bold")
X.button(W - 24 - 150, by, 150, 56, "CLOSE", function() MAP.open = false end, { font = "ui10", id = "WLMAPX", nohelp = true })
end
function MAP.drag(e, f, x, y)
if e == "down" then MAP.fd = { f = f, x = x, y = y, x0 = x, y0 = y, t0 = ms() }; return end
local d = MAP.fd
if not d or d.f ~= f then return end
if e == "move" or e == "nudge" then
local s = 3 * MAP.z
MAP.cx, MAP.cy = (MAP.cx or 64) - (x - d.x) / s, (MAP.cy or 64) - (y - d.y) / s
d.x, d.y = x, y
else
MAP.fd = nil
local v = MAP.vr
if v and (x - d.x0) ^ 2 + (y - d.y0) ^ 2 < 14 ^ 2 and ms() - d.t0 < 500 and x >= v[1] and y >= v[2] and x < v[1] + v[3] and y < v[2] + v[4] then
MAP.wp((x - v[6]) / v[5], (y - v[7]) / v[5], 14 / v[5])
end
end
end
local GNAME = { gr = "Grass", di = "Dirt", sa = "Sand", wa = "Water", fl = "Floor" }
function MAP.what(tx, ty)
local i = ty * N + tx
local b = WD.B[i]
if b then return IV.NAME[b] or b end
local g = WD.G[i] or ""
return IV.NAME[g] or GNAME[g:sub(1, 2)] or ""
end
function MAP.wp(fx, fy, near)
if fx < 0 or fy < 0 or fx >= N or fy >= N then return end
for k, w in ipairs(WD.WP) do
if (w.z or 0) == WD.Z and math.abs(w.x + 0.5 - fx) <= near and math.abs(w.y + 0.5 - fy) <= near + 0.5 then table.remove(WD.WP, k); snd("click", 0.3); dirty = true; return end
end
if #WD.WP >= 5 then table.remove(WD.WP, 1) end
local used = {}
for _, w in ipairs(WD.WP) do used[w.c] = true end
local c = 1
while used[c] do c = c + 1 end
WD.WP[#WD.WP + 1] = { x = fl(fx), y = fl(fy), c = c, z = WD.Z }
snd("click", 0.3); dirty = true
end
function MAP.world(ox, oy, y0, y1)
local top, bot = y0 + 84, y1 - 230
local px, py = WD.P(PL.x, PL.y)
for _, w in ipairs(WD.WP or {}) do
local sx, sy = WD.P((w.x + 0.5) * TS, (w.y + 0.5) * TS)
if (w.z or 0) ~= WD.Z then
elseif sx >= 10 and sx <= W - 10 and sy >= top and sy <= bot + 160 then
local b = fl(sy - TS * 0.9 + math.sin(ms() / 300) * 4)
UI.pic("ui_wp" .. w.c, fl(sx - 10), b - 27, fl(sx + 11), b)
else
local dx, dy = sx - px, sy - py
local m = math.max(math.abs(dx) / math.max(1, W / 2 - 34), math.abs(dy) / math.max(1, (dy < 0) and (py - top) or (bot - py)))
local ex, ey = px + dx / m, py + dy / m
ex, ey = math.max(34, math.min(W - 34, ex)), math.max(top, math.min(bot, ey))
local a = math.atan(dy, dx)
local ca, sa = math.cos(a), math.sin(a)
local c = { { -10, -10 }, { 11, -10 }, { 11, 11 }, { -10, 11 } }
local P = {}
for k, v in ipairs(c) do P[k] = { ex + v[1] * ca - v[2] * sa, ey + v[1] * sa + v[2] * ca } end
if NQ < CAP then
NQ = NQ + 1
local o = -9
smudge.hires_quad("^hd/wl_ui_wpa" .. w.c .. "_c.png", o, o, o, o, o, o, o, o, P[1][1], P[1][2], P[2][1], P[2][2], P[3][1], P[3][2], P[4][1], P[4][2])
end
local dist = fl(math.sqrt(dx * dx + dy * dy) / TS + 0.5)
OT.c(fl(ex - ca * 30), fl(ey - sa * 30) - 8, tostring(dist), "small", "bold")
end
end
end
local WX = { T = 96, DAY = 1200, SLOT = 180 }
WD.WX = WX
local WXK = { "clear", "clear", "clear", "clear", "clear", "clear", "clear", "cloud", "cloud", "cloud", "wind", "wind",
"rain", "rain", "rain", "storm", "fog", "fog", "snow" }
local WXFX = { clear = {}, cloud = { cloud = 1, grey = 1 }, wind = { cloud = 0.5, wind = 1 },
rain = { cloud = 1, grey = 1, rain = 1, wind = 0.4 }, storm = { cloud = 1, grey = 2, rain = 2, wind = 1, storm = 1 },
fog = { fog = 1, grey = 1 }, snow = { cloud = 1, grey = 1, snow = 1, wind = 0.3 } }
WX.SDAYS = 5
WX.SNAME = { "Spring", "Summer", "Autumn", "Winter" }
local WXKS = {
{ "clear", "clear", "clear", "clear", "clear", "cloud", "cloud", "cloud", "rain", "rain", "rain", "rain", "wind", "fog", "storm" },
{ "clear", "clear", "clear", "clear", "clear", "clear", "clear", "clear", "clear", "cloud", "cloud", "wind", "rain", "storm", "storm" },
{ "clear", "clear", "clear", "cloud", "cloud", "cloud", "wind", "wind", "wind", "rain", "rain", "rain", "fog", "fog", "fog", "storm" },
{ "clear", "clear", "clear", "clear", "cloud", "cloud", "cloud", "snow", "snow", "snow", "snow", "snow", "snow", "wind", "fog", "fog" } }
function WX.day(T) return fl((T or WX.T) / WX.DAY) + 1 end
function WX.season(T) return (fl((WX.day(T) - 1) / WX.SDAYS) % 4) + 1 end
function WX.cover()
if WD.Z ~= 0 then return 0 end
local se, d = WX.season(), (WX.T / WX.DAY) % WX.SDAYS
if se == 4 then return math.max(0, math.min(1, d - 0.5)) end
if se == 1 and WX.T > WX.DAY * WX.SDAYS then return math.max(0, math.min(1, 1 - d)) end
return 0
end
function WX.kind(slot)
local L = WXKS[WX.season(slot * WX.SLOT)] or WXK
return L[fl(hash(slot * 7 + 3, 4242 + (WD.SEED or 0) % 99991) * #L) + 1]
end
function WX.now()
local sl = fl(WX.T / WX.SLOT)
local cur, prev = WX.kind(sl), WX.kind(sl - 1)
local a = math.min(1, (WX.T - sl * WX.SLOT) / 25)
local o = { kind = cur }
for _, k in ipairs({ "cloud", "grey", "rain", "wind", "storm", "fog", "snow" }) do
o[k] = (WXFX[cur][k] or 0) * a + (WXFX[prev][k] or 0) * (1 - a)
end
return o
end
local function sm(v) v = math.max(0, math.min(1, v)); return v * v * (3 - 2 * v) end
function WX.sky()
local g = ((WX.T % WX.DAY) / WX.DAY + 0.07) % 1
if g < 0.12 then return 1 - sm(g / 0.12), 0, math.sin(math.pi * g / 0.12) end
if g < 0.69 then return 0, 0, 0 end
if g < 0.79 then return sm((g - 0.69) / 0.10), math.sin(math.pi * (g - 0.69) / 0.10), 0 end
return 1, 0, 0
end
function WX.lights(tx0, tx1, ty0, ty1)
local L = {}
for ty = math.max(0, ty0 - 5), math.min(N - 1, ty1 + 5) do
for tx = math.max(0, tx0 - 5), math.min(N - 1, tx1 + 5) do
local b = WD.B[ty * N + tx]
if b == "to" then L[#L + 1] = { tx + 0.5, ty + 0.4, 4.6 }
elseif b == "fu" then local F = WD.FURN[ty * N + tx]; if F and F.burn > 0 then L[#L + 1] = { tx + 0.5, ty + 0.6, 3.6 } end end
end
end
local function who(p, hold)
L[#L + 1] = { p.x / TS, p.y / TS - 0.4, (hold == "to") and 4 or ((WD.Z ~= 0) and 3 or 1.6) }
end
who(PL, IV.S[ST.sel] and IV.S[ST.sel].id)
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then who(p, p.hold) end end end
return L
end
function WX.dark(tx0, tx1, ty0, ty1, ox, oy, base, L)
if base <= 0.02 then return end
-- Precompute light bounds once per draw; reject corners outside the circular radius
-- before doing the comparatively expensive square-root operation.
local LL = {}
for _, li in ipairs(L) do
local r = li[3]
-- Reject malformed, zero, negative, NaN and infinite radii before inversion.
if type(li[1]) == "number" and type(li[2]) == "number" and
type(r) == "number" and r > 0 and r < math.huge and r == r then
LL[#LL + 1] = { li[1], li[2], r * r, 1 / r }
end
end
L = LL
local cw = tx1 - tx0 + 2
local C = {}
local function corner(cx, cy)
local r = (cy - ty0) * cw + (cx - tx0)
local v = C[r]
if v then return v end
local l = 0
for _, li in ipairs(L) do
local dx, dy = cx - li[1], cy - li[2]
local d2 = dx * dx + dy * dy
if d2 < li[3] then
local d = math.sqrt(d2) * li[4]
if d < 1 then local w = sm(1 - d); if w > l then l = w end end
end
end
v = math.max(0, math.min(3, fl(base * (1 - l) * 3 + 0.5)))
C[r] = v
return v
end
local RA = (WD.CAM.a ~= 0) and WD.RA or nil
local DKN = WX.DKN
if not DKN then
DKN = {}
for n = 0, 255 do DKN[n] = "dk_" .. (n >> 6) .. ((n >> 4) & 3) .. ((n >> 2) & 3) .. (n & 3) end
WX.DKN = DKN
end
for ty = ty0, ty1 do
local run0, runk = nil, nil
local function flush(tx)
if run0 and runk ~= 0 then WD.gq(DKN[runk], run0 * TS, ty * TS, tx * TS, (ty + 1) * TS) end
run0, runk = nil, nil
end
local a, b = tx0, tx1
if RA then local r = RA[ty]; if r then a, b = math.max(tx0, r[1] - 1), math.min(tx1, r[2] + 1) else a, b = 1, 0 end end
for tx = a, b do
local c1, c2, c3, c4 = corner(tx, ty), corner(tx + 1, ty), corner(tx, ty + 1), corner(tx + 1, ty + 1)
local key = c1 * 64 + c2 * 16 + c3 * 4 + c4
if c1 == c2 and c2 == c3 and c3 == c4 then
if runk ~= key then flush(tx); run0, runk = tx, key end
else
flush(tx)
if key ~= 0 then WD.gq(DKN[key], tx * TS, ty * TS, (tx + 1) * TS, (ty + 1) * TS) end
end
end
flush(b + 1)
end
end
function WX.draw(t, tx0, tx1, ty0, ty1, ox, oy, cx, cy, y0, y1, LIGHTS)
if WD.Z ~= 0 then
WX.dark(tx0, tx1, ty0, ty1, ox, oy, 1, WX.lights(tx0, tx1, ty0, ty1))
for k, L in ipairs(LIGHTS) do
local r = L[3] * (1.35 + 0.05 * math.sin(t / 130 + k * 1.7) + 0.03 * math.sin(t / 57 + k))
q("light", fl(L[1] - r), fl(L[2] - r), fl(L[1] + r), fl(L[2] + r), true)
q("light", fl(L[1] - r * 0.6), fl(L[2] - r * 0.6), fl(L[1] + r * 0.6), fl(L[2] + r * 0.6), true)
end
return { kind = "cave" }, 1
end
local w = WX.now()
local night, dusk, dawn = WX.sky()
if w.cloud > 0.15 then
local spd = 14 + 30 * w.wind
for k = 1, 3 do
local px = ((k * 977 + WX.T * spd) % 1500) - 560 - (cx % 1500)
if px < -700 then px = px + 1500 end
local py = ((k * 613) % 900) - 200 - (cy % 900) + y0
if py < y0 - 500 then py = py + 900 end
q((w.cloud > 0.6) and "wx_cloud2" or "wx_cloud1", fl(px), fl(py), fl(px + 560), fl(py + 420), true)
end
end
local base = math.max(night, w.storm * 0.2)
-- In daylight there is no darkness overlay to calculate. Avoid scanning the
-- surrounding map for torches/furnaces when that result would be unused.
if base > 0.02 then
WX.dark(tx0, tx1, ty0, ty1, ox, oy, base, WX.lights(tx0, tx1, ty0, ty1))
end
for k, L in ipairs(LIGHTS) do
local r = L[3] * (1 + 0.09 * math.sin(t / 110 + k * 1.7) + 0.05 * math.sin(t / 47 + k * 3.1) + 0.04 * math.sin(t / 23 + k)) * (1 + 0.35 * base)
q("light", fl(L[1] - r), fl(L[2] - r), fl(L[1] + r), fl(L[2] + r), true)
if base > 0.5 then q("light", fl(L[1] - r * 0.6), fl(L[2] - r * 0.6), fl(L[1] + r * 0.6), fl(L[2] + r * 0.6), true) end
end
local gl = fl(w.grey + 0.5)
if gl >= 1 then q("wx_grey" .. math.min(3, gl), 0, y0, W, y1, true) end
if dusk > 0.2 then q("wx_dusk" .. ((dusk > 0.6) and 2 or 1), 0, y0, W, y1, true) end
if dawn > 0.2 then q("wx_dawn" .. ((dawn > 0.6) and 2 or 1), 0, y0, W, y1, true) end
if w.fog > 0.15 then
for k = 1, 4 do
local px = ((k * 431 + WX.T * 9) % 1300) - 500 - (cx * 0.6 % 1300)
if px < -700 then px = px + 1300 end
local py = y0 + ((k * 257) % (y1 - y0 + 300)) - 250
q((w.fog > 0.6) and "wx_fog2" or "wx_fog1", fl(px), fl(py), fl(px + 640), fl(py + 480), true)
end
end
local function sheet(nm, sp, slant, layer)
local S = 256
local oxr = fl((t * sp * slant / 1000 + layer * 97 - cx) % S)
local oyr = fl((t * sp / 1000 + layer * 151 - cy) % S)
for yy = y0 - S + oyr, y1, S do for xx = -S + oxr, W, S do q(nm, fl(xx), fl(yy), fl(xx) + S, fl(yy) + S, true) end end
end
if w.rain > 0.15 then
sheet("wx_rain1", 900, 0.15 + 0.35 * w.wind, 0)
if w.rain > 1.2 then sheet("wx_rain2", 1100, 0.2 + 0.4 * w.wind, 1) end
end
if w.snow > 0.15 then sheet("wx_snow", 70, 0.3 * math.sin(t / 2100) + 0.2 * w.wind, 0); sheet("wx_snow", 110, 0.25 * math.sin(t / 1700 + 1), 1) end
if w.storm > 0.6 then
if not WX.tf or t > WX.tf + 30000 then WX.tf = t + X.rnd(4000, 15000) end
if t >= WX.tf and t < WX.tf + 140 then q("wx_flash", 0, y0, W, y1, true) end
if t >= WX.tf and not WX.thund then WX.thund = t + X.rnd(300, 1500) end
if t >= WX.tf + 140 then WX.tf = t + X.rnd(9000, 22000) end
end
if WX.thund and t >= WX.thund then snd("wl_thunder" .. X.rnd(1, 2), 0.7); WX.thund = nil end
return w, night
end
function WX.sound(t, w, night)
if not (smudge.music and SND) then return end
local want = "none"
if (SND.sfx or SND.music) and w.kind ~= "cave" then
want = (w.kind == "storm") and "storm" or (w.kind == "rain") and "rain" or (w.kind == "wind") and "wind" or
((w.kind == "cloud" or w.kind == "fog" or w.kind == "snow") and "cloud") or "cloud"
end
if want ~= WX.amb then WX.amb = want; smudge.music(want ~= "none" and ("snd/wl_amb_" .. want .. ".ogg") or nil, 0.3) end
end
function WX.icons(y0)
local txt = "Day " .. WX.day() .. "  " .. WX.SNAME[WX.season()]
local tw = X.tw(txt, "small", "bold")
if WD.Z ~= 0 then OT.l(W - 10 - tw, y0 + 24, txt, "small", "bold"); return end
OT.l(W - 60 - ((WX.now().kind ~= "clear") and 58 or 0) - 10 - tw, y0 + 24, txt, "small", "bold")
local night = WX.sky()
local w = WX.now()
local x = W - 60
UI.pic("ui_round_s", x, y0 + 8, x + 52, y0 + 60)
UI.pic((night > 0.5) and "ui_moon" or "ui_sun", x + 10, y0 + 18, x + 42, y0 + 50)
local ic = ({ cloud = "ui_wcloud", wind = "ui_wwind", rain = "ui_wrain", storm = "ui_wstorm", fog = "ui_wfog", snow = "ui_wsnow" })[w.kind]
if ic then
x = x - 58
UI.pic("ui_round_s", x, y0 + 8, x + 52, y0 + 60)
UI.pic(ic, x + 10, y0 + 18, x + 42, y0 + 50)
end
end
function WD.ftick(F, dt)
local inp, out = F.s[1], F.s[3]
local res = inp and IV.SMELTS[inp.id]
local can = res and (not out or (out.id == res and out.n < 64))
if can and F.burn <= 0 and F.s[2] and IV.FUEL[F.s[2].id] then
F.bmax = IV.FUEL[F.s[2].id]; F.burn = F.bmax
F.s[2].n = F.s[2].n - 1
if F.s[2].n <= 0 then F.s[2] = nil end
dirty = true
end
if F.burn > 0 then F.burn = math.max(0, F.burn - dt) end
if can and F.burn > 0 then
F.prog = F.prog + dt
if F.prog >= IV.SMELT_T then
F.prog = 0
inp.n = inp.n - 1
if inp.n <= 0 then F.s[1] = nil end
if out then out.n = out.n + 1 else F.s[3] = { id = res, n = 1 } end
dirty = true
end
else F.prog = 0 end
end
local SWC, SWH = 0.34, 0.75
function WD.swing()
local ph = ((ABTN and ABTN.sw) or 0) % SWC / SWC
local a
if ph < 0.55 then a = 0.2 - 0.65 * math.sin(ph / 0.55 * math.pi / 2)
elseif ph < SWH then local u = (ph - 0.55) / (SWH - 0.55); a = -0.45 + 1.45 * u * u
else a = 1.0 - 0.8 * (ph - SWH) / (1 - SWH) end
return a, ph >= 0.6 and ph < 0.95
end
function WD.mine(dt)
local prev = (ABTN.sw or 0) % SWC
ABTN.sw = (ABTN.sw or 0) + dt
local now = ABTN.sw % SWC
local hitnow = (now >= prev and prev < SWC * SWH and now >= SWC * SWH) or (now < prev and (prev < SWC * SWH or now >= SWC * SWH))
local i = WD.front()
local b = i and WD.B[i]
local floor = false
if i and not b and IV.FLOOR[WD.G[i]] then b, floor = WD.G[i], true end
if not b then ABTN.ti = nil; return end
local need, uses = IV.mhits(b)
if not need then
if not ABTN.told then ABTN.told = true; X.set_note(uses) end
ABTN.ti = nil; return
end
ABTN.need = need
if ABTN.ti ~= i then ABTN.ti, ABTN.p, ABTN.shown = i, 0, nil end
if not hitnow then return end
ABTN.p = ABTN.p + 1
ABTN.shown, ABTN.hitt = ABTN.p, ms()
WD.chips(b, i, (ABTN.p >= need) and 10 or 4, ABTN.p >= need)
if uses then IV.wear(ST.sel) end
if ABTN.p < need then snd("wl_step_" .. (IV.SND[b] or "stone") .. X.rnd(1, 3), 0.45) end
if ABTN.p >= need and floor then
WD.setg(i, "di1"); ABTN.ti = nil
IV.drop(b, 1, ((i % N) + 0.5) * TS + X.rnd(-8, 8), ((i // N) + 0.75) * TS + X.rnd(-4, 4))
snd("wl_step_" .. (IV.SND[b] or "stone") .. X.rnd(1, 3), 0.6)
elseif ABTN.p >= need then
local drops = WD.drops(b, i)
WD.setb(i, nil); ABTN.ti = nil
local tx, ty = i % N, i // N
if IV.CHESTB[b] then
local C = WD.CHEST[i]
if C then for k = 1, 27 do local it = C.s[k]; if it then IV.drop(it.id, it.n, (tx + 0.5) * TS + X.rnd(-14, 14), (ty + 0.8) * TS + X.rnd(-6, 6), false, it.d) end end end
WD.CHEST[i] = nil
if b == "cl" and WD.B[i + 1] == "cr" then WD.setb(i + 1, "ch") end
if b == "cr" and WD.B[i - 1] == "cl" then WD.setb(i - 1, "ch") end
mp_send("k|" .. WD.gi(i) .. "|")
end
local F = WD.FURN[i]
if F then
for k = 1, 3 do local it = F.s[k]; if it then IV.drop(it.id, it.n, (tx + 0.5) * TS + X.rnd(-10, 10), (ty + 0.8) * TS + X.rnd(-4, 4)) end end
WD.FURN[i] = nil
end
for _, d in ipairs(drops) do
for _ = 1, d[2] do IV.drop(d[1], 1, (tx + 0.5) * TS + X.rnd(-14, 14), (ty + 0.75) * TS + X.rnd(-6, 6)) end
end
if b == "sd" or b == "su" then WD.unstair(i, b) end
snd("wl_step_" .. (IV.SND[b] or "stone") .. X.rnd(1, 3), 0.6)
end
end
local OPQ = { b01 = true, b02 = true, b03 = true, b04 = true, b05 = true, b06 = true, b07 = true, b08 = true, ch = true, cl = true, cr = true, ct = true, fu = true, or1 = true, or2 = true, or3 = true, or4 = true, or5 = true, or6 = true, or7 = true, or8 = true, fu = true }
local HASTP, FULLTOP = {}, {}
for k = 1, 8 do
for _, c in ipairs({ "b0" .. k, "or" .. k }) do
FULLTOP[c] = true
for _, sf in ipairs({ "", "_nb", "_nf", "_nn" }) do HASTP[c .. sf] = true end
end
end
local CHIPS = { b01 = true, b02 = true, b03 = true, b04 = true, b05 = true, b06 = true, b07 = true, b08 = true, cc1 = true, cc2 = true, cc3 = true, cc4 = true, ch = true, cl = true, cp1 = true, cp2 = true, cp3 = true, cp4 = true, cr = true, ct = true, cw1 = true, cw2 = true, cw3 = true, cw4 = true, di1 = true, do1 = true, do2 = true, fb1 = true, fb2 = true, fb3 = true, fb4 = true, fl1 = true, fl2 = true, fl3 = true, fl4 = true, fu = true, gr1 = true, or1 = true, or2 = true, or3 = true, or4 = true, or5 = true, or6 = true, or7 = true, or8 = true, sa1 = true, sd = true, sg = true, su = true, tl1 = true, tl2 = true, tl3 = true, tl4 = true, tr = true, wa1 = true, wa2 = true, wa3 = true, wa4 = true }
WD.PT, WD.FP = {}, {}
function WD.pt(pic, x, y, vx, vy, g, life, sz, frames, sx, sy)
if #WD.PT >= 240 then table.remove(WD.PT, 1) end
WD.PT[#WD.PT + 1] = { pic = pic, x = x, y = y, vx = vx, vy = vy, g = g or 0, t0 = ms(), life = life, sz = sz, fr = frames, sx = sx or 0, sy = sy or 0 }
end
function WD.chip(b)
if b == "do" then b = "do1" elseif b == "cw" or b == "cc" or b == "cp" then b = b .. "4" end
return CHIPS[b] and ("pt_" .. b) or "pt_dust"
end
function WD.chips(b, i, n, big)
local tx, ty = i % N, i // N
local pic = WD.chip(b)
for _ = 1, n do
WD.pt(pic, (tx + 0.5) * TS + X.rnd(-18, 18), (ty + 1) * TS, X.rnd(-90, 90), X.rnd(-190, -80) * (big and 1.2 or 1), 620, X.rnd(380, 620), X.rnd(6, 9), nil, X.rnd(-32, -16))
end
end
function WD.ptdraw(t)
for k = #WD.PT, 1, -1 do
local p = WD.PT[k]
local a = t - p.t0
if a >= p.life then table.remove(WD.PT, k)
else
local s = a / 1000
local bx, by = WD.P(p.x, p.y)
local x, y = bx + p.sx + p.vx * s, by + p.sy + p.vy * s + 0.5 * p.g * s * s
local nm = p.fr and (p.pic .. math.min(p.fr, 1 + fl(a / p.life * p.fr))) or p.pic
local h = p.sz / 2
if p.pic == "pt_shim" then q(nm, fl(x - p.sz), fl(y), fl(x + p.sz), fl(y + 3), true)
else q(nm, fl(x - h), fl(y - h), fl(x + h), fl(y + h), true) end
end
end
end
function WD.snowy(i)
local g = WD.G[i]
return g == "gr1" or g == "di1" or g == "fl3" or g == "sa1"
end
function WD.walkfx(p, t)
local cov = WX.cover()
if cov > 0.4 and (p.step or 0) ~= 0 and p.step ~= p._fs then
local i = fl(p.y / TS) * N + fl(p.x / TS)
if WD.snowy(i) and not WD.B[i] then
p._side = not p._side
local dx = (p.face == "left" or p.face == "right") and 0 or (p._side and -6 or 6)
local dy = (p.face == "up" or p.face == "down") and 0 or (p._side and -3 or 3)
if #WD.FP >= 80 then table.remove(WD.FP, 1) end
WD.FP[#WD.FP + 1] = { x = p.x + dx, y = p.y + dy + 2, t0 = t }
end
end
p._fs = p.step
if (WX.season() == 4 or cov > 0.3) and WD.Z == 0 and p.face ~= "up" and t - (p._br or 0) > 2300 then
p._br = t + X.rnd(0, 600)
local fx = (p.face == "left") and -14 or (p.face == "right") and 14 or 4
WD.pt("pt_breath", p.x, p.y, fx * 1.2, -14, 0, 1300, 16, 3, fx, -46)
end
end
function WD.fx(t, tx0, tx1, ty0, ty1)
if t - (WD.fxt or 0) < 120 then return end
WD.fxt = t
for _ = 1, 2 do
local tx, ty = X.rnd(tx0, tx1), X.rnd(ty0, ty1)
if WD.G[ty * N + tx] == "wa" then WD.pt("pt_shim", (tx + 0.2) * TS + X.rnd(0, 28), (ty + 0.2) * TS + X.rnd(0, 28), 0, 0, 0, 900, 8, 3) end
end
for ty = ty0, ty1 do for tx = tx0, tx1 do
local i = ty * N + tx
local b = WD.B[i]
if b == "cw" or b == "cc" or b == "cp" then
if math.random() < 0.035 and WD.stage(i) >= 4 then WD.pt("pt_spark", (tx + 0.5) * TS, (ty + 0.7) * TS, 0, -18, 0, 800, 10, X.rnd(-14, 14), X.rnd(-40, -14)) end
elseif b == "to" then
if math.random() < 0.25 then WD.pt("pt_ember", (tx + 0.5) * TS, (ty + 0.75) * TS, X.rnd(-10, 10), X.rnd(-60, -35), 0, 1000, 4, 3, X.rnd(-4, 4), -42) end
elseif b == "fu" and WD.FURN[i] and WD.FURN[i].burn > 0 then
if math.random() < 0.35 then WD.pt("pt_ember", (tx + 0.5) * TS, (ty + 0.5) * TS, X.rnd(-12, 12), X.rnd(-70, -40), 0, 1200, 5, 3, X.rnd(-5, 5), -TS * 1.15) end
end
end end
end
WD.CAM = { a = 0, to = 0 }
WD.TPFR = { "b01", "b02", "b03", "b04", "b05", "b06", "b07", "b08", "do1", "do2", "or1", "or2", "or3", "or4", "or5", "or6", "or7", "or8",
"ct", "fu", "fb1", "fb2", "fb3", "fb4", "ch", "cl", "cr" }
local CAM = { c = 1, s = 0, k = 1, x = 0, y = 0, cx = 0, cy = 0 }
WD.CAMV = CAM
function WD.camset(cxw, cyw, y0, vh)
local a = math.rad(WD.CAM.a)
CAM.c, CAM.s, CAM.k = math.cos(a), math.sin(a), 1 - 0.5 * math.abs(WD.CAM.a) / 45
CAM.x, CAM.y, CAM.cx, CAM.cy = W / 2, y0 + vh / 2, cxw, cyw
end
function WD.P(wx, wy, h)
local dx, dy = wx - CAM.cx, wy - CAM.cy
return CAM.x + CAM.c * dx - CAM.s * dy, CAM.y + (CAM.s * dx + CAM.c * dy) * CAM.k - (h or 0)
end
function WD.depth(wx, wy) return CAM.s * (wx - CAM.cx) + CAM.c * (wy - CAM.cy) end
function WD.unP(sx, sy)
local rx, ry = sx - CAM.x, (sy - CAM.y) / CAM.k
return CAM.cx + CAM.c * rx + CAM.s * ry, CAM.cy - CAM.s * rx + CAM.c * ry
end
local Q4N = {}
-- The rotated camera's conservative tile ranges include off-screen tiles so
-- tall sprites and block faces are never clipped at the viewport edge. Reject
-- only quads whose complete screen-space bounds are outside the physical view.
-- A small 1px guard keeps edge filtering/rounding behavior unchanged.
local function q4_visible(ax, ay, bx, by, cx, cy, dx, dy)
local minx = math.min(ax, bx, cx, dx)
local maxx = math.max(ax, bx, cx, dx)
local miny = math.min(ay, by, cy, dy)
local maxy = math.max(ay, by, cy, dy)
return maxx >= -1 and minx <= W + 1 and maxy >= -1 and miny <= Hh + 1
end
function WD.q4(nm, ax, ay, bx, by, cx, cy, dx, dy)
if not q4_visible(ax, ay, bx, by, cx, cy, dx, dy) or NQ >= CAP then return end
NQ = NQ + 1
local o = -9
local full = Q4N[nm]
if not full then full = "^hd/wl_" .. nm .. "_c.png"; Q4N[nm] = full end
smudge.hires_quad(full, o, o, o, o, o, o, o, o, ax, ay, bx, by, cx, cy, dx, dy)
end
function WD.q4c(nm, ax, ay, bx, by, cx, cy, dx, dy)
if not q4_visible(ax, ay, bx, by, cx, cy, dx, dy) or NQ >= CAP then return end
NQ = NQ + 1
smudge.hires_quad("hd/wl_" .. nm .. "_c.png", ax, ay, bx, by, cx, cy, dx, dy, ax, ay, bx, by, cx, cy, dx, dy)
end
function WD.gq(nm, x0, y0, x1, y1, h, claim)
if CAM.s == 0 and CAM.k == 1 then
local ax, ay = WD.P(x0, y0, h); local cx, cy = WD.P(x1, y1, h)
q(nm, fl(ax), fl(ay), fl(cx), fl(cy), not claim); return
end
local c, sn, k = CAM.c, CAM.s, CAM.k
local X0, Y0 = x0 - CAM.cx, y0 - CAM.cy
local X1, Y1 = x1 - CAM.cx, y1 - CAM.cy
local hh = h or 0
local ax, ay = CAM.x + c * X0 - sn * Y0, CAM.y + (sn * X0 + c * Y0) * k - hh
local bx, by = CAM.x + c * X1 - sn * Y0, CAM.y + (sn * X1 + c * Y0) * k - hh
local cx, cy = CAM.x + c * X1 - sn * Y1, CAM.y + (sn * X1 + c * Y1) * k - hh
local dx, dy = CAM.x + c * X0 - sn * Y1, CAM.y + (sn * X0 + c * Y1) * k - hh
if claim then WD.q4c(nm, ax, ay, bx, by, cx, cy, dx, dy) else WD.q4(nm, ax, ay, bx, by, cx, cy, dx, dy) end
end
function WD.turn(d)
WD.CAM.to = math.max(-45, math.min(45, WD.CAM.to + 45 * d))
snd("click", 0.2)
end
function WD.sface(face)
if WD.CAM.a == 0 then return face end
local d = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[face] or { 0, 1 }
local rx, ry = CAM.c * d[1] - CAM.s * d[2], CAM.s * d[1] + CAM.c * d[2]
if math.abs(ry) >= math.abs(rx) - 0.01 then return ry > 0 and "down" or "up" end
return rx > 0 and "right" or "left"
end
local FNAMES = {}
function WD.draw3(t, tx0, tx1, ty0, ty1, draw_one, LIGHTS, y0, y1)
local P, gq, q4 = WD.P, WD.gq, WD.q4
local wf = "t_wa" .. (fl(t / 260) % 4 + 1)
local cov = WX.cover()
local function onscreen(x, y, m) return x > -m and x < W + m and y > y0 - m and y < y1 + m * 2 end
local C = WD.CAMV
local exx, exy = C.c * TS, C.s * TS * C.k
local eyx, eyy = -C.s * TS, C.c * TS * C.k
local ox0, oy0 = P(0, 0)
-- Conservative screen-space rejection for terrain quads. Unlike the tile
-- scan bounds, this tests the expanded ground quad itself (including its
-- texture bleed margin), so partially visible tiles are always retained.
local function terrain_visible(u0, v0, u1, v1)
local ax, ay = ox0 + u0 * exx + v0 * eyx, oy0 + u0 * exy + v0 * eyy
local bx, by = ox0 + u1 * exx + v0 * eyx, oy0 + u1 * exy + v0 * eyy
local cx, cy = ox0 + u1 * exx + v1 * eyx, oy0 + u1 * exy + v1 * eyy
local dx, dy = ox0 + u0 * exx + v1 * eyx, oy0 + u0 * exy + v1 * eyy
local minx = math.min(ax, bx, cx, dx)
local maxx = math.max(ax, bx, cx, dx)
local miny = math.min(ay, by, cy, dy)
local maxy = math.max(ay, by, cy, dy)
return maxx >= -1 and minx <= W + 1 and maxy >= -1 and miny <= Hh + 1
end
local function range(ty, mx, mtop, mbot)
local bx, by = ox0 + (ty + 0.5) * eyx, oy0 + (ty + 0.5) * eyy
local lo, hi = (-mx - bx) / exx, (W + mx - bx) / exx
if exy > 1e-6 then lo, hi = math.max(lo, (y0 - mtop - by) / exy), math.min(hi, (y1 + mbot - by) / exy)
elseif exy < -1e-6 then lo, hi = math.max(lo, (y1 + mbot - by) / exy), math.min(hi, (y0 - mtop - by) / exy)
elseif by < y0 - mtop or by > y1 + mbot then return 1, 0 end
return math.max(0, math.ceil(lo - 0.5)), math.min(N - 1, fl(hi - 0.5))
end
local NMC0 = WD.NMC or {}; WD.NMC = NMC0
local function NMC(k) local v = NMC0[k]; if not v then v = "hd/wl_" .. k .. "_c.png"; NMC0[k] = v end; return v end
local GN = {}
for _, g in ipairs({ "gr1", "di1", "sa1", "fl1", "fl2", "fl3", "fl4" }) do
GN[g] = (cov > 0.12 and (g == "gr1" or g == "di1" or g == "fl3" or g == "sa1")) and ("t_" .. g .. "_sn" .. ((cov > 0.6) and 2 or 1)) or ("t_" .. g)
end
GN.wa = wf
local G, BB0 = WD.G, WD.B
local function gname(i)
if OPQ[BB0[i] or ""] then return false end
local g = G[i] or "gr1"; return GN[g] or ("t_" .. g)
end
local e1, f1 = 0.5 / TS, 3 / TS
local function ground(nm, u0, v0, w)
local c0, c1, d0, d1 = u0 - f1, u0 + w + f1, v0 - f1, v0 + w + f1
if NQ >= CAP or not terrain_visible(c0, d0, c1, d1) then return end
NQ = NQ + 1
local o = -9
smudge.hires_quad("^" .. NMC(nm), o, o, o, o, o, o, o, o,
ox0 + c0 * exx + d0 * eyx, oy0 + c0 * exy + d0 * eyy, ox0 + c1 * exx + d0 * eyx, oy0 + c1 * exy + d0 * eyy,
ox0 + c1 * exx + d1 * eyx, oy0 + c1 * exy + d1 * eyy, ox0 + c0 * exx + d1 * eyx, oy0 + c0 * exy + d1 * eyy)
end
local function flat(nm, u0, v0, u1, v1)
if NQ >= CAP or not terrain_visible(u0, v0, u1, v1) then return end
NQ = NQ + 1
local o = -9
smudge.hires_quad("^" .. NMC(nm), o, o, o, o, o, o, o, o,
ox0 + u0 * exx + v0 * eyx, oy0 + u0 * exy + v0 * eyy, ox0 + u1 * exx + v0 * eyx, oy0 + u1 * exy + v0 * eyy,
ox0 + u1 * exx + v1 * eyx, oy0 + u1 * exy + v1 * eyy, ox0 + u0 * exx + v1 * eyx, oy0 + u0 * exy + v1 * eyy)
end
local RA, RB = WD.RA, WD.RB
if not RA then RA, RB = {}, {}; WD.RA, WD.RB = RA, RB end
for k in pairs(RA) do if k < ty0 or k > ty1 then RA[k] = nil; RB[k] = nil end end
for ty = ty0, ty1 do
local a, b = range(ty, 36, 26, 26)
local c2, d2 = range(ty, 50, 20, 150)
local r, r2 = RA[ty], RB[ty]
if r then r[1], r[2], r2[1], r2[2] = a, b, c2, d2 else RA[ty] = { a, b }; RB[ty] = { c2, d2 } end
end
local X4 = WD.X4
if not X4 then
X4 = { t_gr1 = 1, t_di1 = 1, t_sa1 = 1, t_fl1 = 1, t_fl2 = 1, t_fl3 = 1, t_fl4 = 1, t_wa1 = 1, t_wa2 = 1, t_wa3 = 1, t_wa4 = 1 }
for _, g in ipairs({ "gr1", "di1", "fl3", "sa1" }) do X4["t_" .. g .. "_sn1"] = 1; X4["t_" .. g .. "_sn2"] = 1 end
WD.X4 = X4
end
local NMX0 = WD.NMX or {}; WD.NMX = NMX0
local function NMX(k) local v = NMX0[k]; if not v then v = k .. "_x4"; NMX0[k] = v end; return v end
for ty = ty0 - ty0 % 2, ty1, 2 do
local r1, r2 = RA[ty], RA[ty + 1]
local a = math.min(r1 and r1[1] or N, r2 and r2[1] or N)
local b = math.max(r1 and r1[2] or -1, r2 and r2[2] or -1)
if a <= b then
for tx = a - a % 2, b, 2 do
local i = ty * N + tx
local nm = gname(i)
if nm and X4[nm] and tx + 1 < N and ty + 1 < N and gname(i + 1) == nm and gname(i + N) == nm and gname(i + N + 1) == nm then
ground(NMX(nm), tx, ty, 2)
else
for dy = 0, 1 do
local r = RA[ty + dy]
if r then for dx = 0, 1 do
local x = tx + dx
if x >= r[1] and x <= r[2] then local g2 = gname((ty + dy) * N + x); if g2 then ground(g2, x, ty + dy, 1) end end
end end
end
end
end
end
end
-- Cache solid-tile tests for this draw pass. The rotated renderer asks the
-- same neighbouring tiles about solidity several times while building
-- ground shadows and deciding which block faces are hidden.
local SOLIDV, SOLIDF = WD.SOLIDV, WD.SOLIDF
if not SOLIDV then SOLIDV = {}; WD.SOLIDV = SOLIDV end
if not SOLIDF then SOLIDF = {}; WD.SOLIDF = SOLIDF end
WD.SOLIDFRAME = (WD.SOLIDFRAME or 0) + 1
local SOLIDFRAME = WD.SOLIDFRAME
local function solid(j)
if SOLIDF[j] == SOLIDFRAME then return SOLIDV[j] end
local v = WD.B[j]
local result = v ~= nil and not IV.FLAT[v] and v ~= "tr"
SOLIDV[j], SOLIDF[j] = result, SOLIDFRAME
return result
end
local OCAP = CAP - 280
WD.nqg = NQ
local BB = WD.B
local ff = fl(t / 650) % 2 + 1
local fw = 9 / TS
local PO = WD.POOL3
if not PO then PO = { D = {}, T = {}, A = {}, B = {}, C = {}, K = {}, done = {}, nk = 0, f = 0 }; WD.POOL3 = PO end
local LD, LT, LA, LB, LC = PO.D, PO.T, PO.A, PO.B, PO.C
local n3 = 0
local function push(d, k, a, b, c) n3 = n3 + 1; LD[n3], LT[n3], LA[n3], LB[n3], LC[n3] = d, k, a, b, c end
for ty = ty0, ty1 do
local r = RA[ty]
for tx = r[1], r[2] do
if NQ >= OCAP then break end
local i = ty * N + tx
local b = BB[i]
if b == "sd" or b == "su" then flat("t_" .. b, tx, ty, tx + 1, ty + 1) end
local g = G[i]
if g == "wa" then
if ty > 0 and G[i - N] ~= "wa" then flat("fx_foam_n" .. ff, tx, ty, tx + 1, ty + fw) end
if ty < N - 1 and G[i + N] ~= "wa" then flat("fx_foam_s" .. ff, tx, ty + 1 - fw, tx + 1, ty + 1) end
if tx > 0 and G[i - 1] ~= "wa" then flat("fx_foam_w" .. ff, tx, ty, tx + fw, ty + 1) end
if tx < N - 1 and G[i + 1] ~= "wa" then flat("fx_foam_e" .. ff, tx + 1 - fw, ty, tx + 1, ty + 1) end
elseif not (b and not IV.FLAT[b] and b ~= "tr") then
local l, u = (tx > 0 and solid(i - 1)) and 1 or 0, (ty > 0 and solid(i - N)) and 1 or 0
local ul, rr = (tx > 0 and ty > 0 and solid(i - N - 1)) and 1 or 0, (tx < N - 1 and solid(i + 1)) and 1 or 0
if l + u + ul + rr > 0 then flat("sh" .. l .. u .. ul .. rr, tx, ty, tx + 1, ty + 1) end
end
end
end
for k = #WD.FP, 1, -1 do
local f = WD.FP[k]
local a = t - f.t0
if a > 30000 or cov < 0.3 then table.remove(WD.FP, k)
elseif NQ < OCAP then flat("pt_foot" .. math.min(3, 1 + fl(a / 10000)), (f.x - 10) / TS, (f.y - 6) / TS, (f.x + 11) / TS, (f.y + 6) / TS) end
end
local cs, cc = C.s, C.c
local MERGE = WD.MERGE
if not MERGE then
MERGE = {}
for _, c in ipairs({ "b01", "b02", "b03", "b04", "b05", "b06", "b08", "or1", "or2", "or3", "or4", "or5", "or6", "or7", "or8" }) do MERGE[c] = true end
WD.MERGE = MERGE
end
local mi = ABTN and ABTN.ti
local function toponly(i, tx, ty)
local b = BB[i]
if not (b and MERGE[b]) or i == mi or ty >= N - 1 or not solid(i + N) then return nil end
if cs > 0 then if tx >= N - 1 or not solid(i + 1) then return nil end
elseif cs < 0 then if tx <= 0 or not solid(i - 1) then return nil end end
return b
end
local function dep(tx, ty) return cs * ((tx + 0.5) * TS - C.cx) + cc * ((ty + 0.5) * TS - C.cy) end
local done = PO.done
PO.f = PO.f + 1
local fr = PO.f
for ty = ty0 - ty0 % 2, ty1, 2 do
local r1, r2 = RB[ty], RB[ty + 1]
local a = math.min(r1 and r1[1] or N, r2 and r2[1] or N)
local b2 = math.max(r1 and r1[2] or -1, r2 and r2[2] or -1)
for tx = a - a % 2, b2, 2 do
local i = ty * N + tx
local b = toponly(i, tx, ty)
if b and tx + 1 < N and ty + 1 < N and toponly(i + 1, tx + 1, ty) == b and toponly(i + N, tx, ty + 1) == b and toponly(i + N + 1, tx + 1, ty + 1) == b then
push(math.max(dep(tx, ty), dep(tx + 1, ty), dep(tx, ty + 1), dep(tx + 1, ty + 1)), 4, tx, ty, b)
done[i], done[i + 1], done[i + N], done[i + N + 1] = fr, fr, fr, fr
end
end
end
for ty = ty0, ty1 do
local r = RB[ty]
for tx = r[1], r[2] do
local i = ty * N + tx
local b = BB[i]
if b and b ~= "sd" and b ~= "su" and done[i] ~= fr then push(dep(tx, ty), 1, tx, ty, b) end
end
end
local function add(p) push(WD.depth(p.x, p.y) + 2, 2, p) end
add(PL)
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then add(p) end end end
if WD.Z == 0 then for _, a in ipairs(WD.ANIM or {}) do
local x, y = P(a.x, a.y); if onscreen(x, y, 80) then add(a) end
end end
for _, d in ipairs(IV.DROPS) do if (d.z or 0) == WD.Z then local x, y = P(d.x, d.y); if onscreen(x, y, 40) then add(d) end end end
local gi, gid = WD.ghost()
if gi then push(WD.depth(((gi % N) + 0.5) * TS, ((gi // N) + 0.5) * TS) - 1, 3, gi % N, gi // N, gid) end
local K = PO.K
do
for k = 1, n3 do K[k] = fl((LD[k] + 20000) * 8) * 65536 + k end
for k = n3 + 1, PO.nk do K[k] = nil; LC[k] = nil; LA[k] = nil end
PO.nk = n3
local sort0 = (WD.PROFILE and os and os.clock) and os.clock() or nil
table.sort(K)
if sort0 then
local ps = WD.PROFILE_STATS
ps.sort_ms = ps.sort_ms + (os.clock() - sort0) * 1000
ps.sort_max_ms = math.max(ps.sort_max_ms, (os.clock() - sort0) * 1000)
ps.sort_entries = n3
end
end
WD.nq3 = NQ
local h = TS
local SILX, SILY = WD.SILX, WD.SILY
if not SILX then SILX, SILY = {}, {}; WD.SILX, WD.SILY = SILX, SILY end
local function silh(p, slot)
local cells = p._tag and SIL[p._tag]
if not cells then return end
local dp = WD.depth(p.x, p.y) + 2
local ptx, pty = fl(p.x / TS), fl(p.y / TS)
local HX, HY = SILX, SILY
local nh, o6 = 0, 0
local function pt(k, u, v, top) HX[o6 + k] = ox0 + u * exx + v * eyx; HY[o6 + k] = oy0 + u * exy + v * eyy - (top and h or 0) end
for ty = math.max(0, pty - 1), math.min(N - 1, pty + 3) do for tx = math.max(0, ptx - 3), math.min(N - 1, ptx + 3) do
local i = ty * N + tx
local bxs, bys = ox0 + (tx + 0.5) * exx + (ty + 0.5) * eyx, oy0 + (tx + 0.5) * exy + (ty + 0.5) * eyy
if solid(i) and math.abs(bxs - p._px) < 80 and bys - p._py < 60 and p._py - bys < 140 and WD.depth((tx + 0.5) * TS, (ty + 0.5) * TS) > dp then
o6 = nh * 6
if C.s >= 0 then
pt(1, tx, ty, true); pt(2, tx + 1, ty, true); pt(3, tx + 1, ty, false); pt(4, tx + 1, ty + 1, false); pt(5, tx, ty + 1, false); pt(6, tx, ty + 1, true)
else
pt(1, tx, ty, true); pt(2, tx + 1, ty, true); pt(3, tx + 1, ty + 1, true); pt(4, tx + 1, ty + 1, false); pt(5, tx, ty + 1, false); pt(6, tx, ty, false)
end
nh = nh + 1
end
end end
if nh == 0 then return end
local function inside(x, y)
for m = 0, nh - 1 do
local o = m * 6
local pos, neg = false, false
for k = 1, 6 do
local k2 = k % 6 + 1
local ax, ay, bx, by = HX[o + k], HY[o + k], HX[o + k2], HY[o + k2]
local cr = (bx - ax) * (y - ay) - (by - ay) * (x - ax)
if cr > 0 then pos = true elseif cr < 0 then neg = true end
end
if not (pos and neg) then return true end
end
return false
end
local x0, y0s = p._px - 36, p._py - 69
local cov = {}
for c = 0, 2 do for r = 0, 11 do
if inside(x0 + c * 24 + 12, y0s + r * 6 + 3) then cov[c .. "_" .. r] = true end
end end
WD.sildraw(p, cov, slot)
end
local X4N = WD.X4N
if not X4N then X4N = { {}, {} }; WD.X4N = X4N end
local psh = 0
local function Ps(x, y, z) local u, v = x / TS, y / TS; return ox0 + u * exx + v * eyx + psh, oy0 + u * exy + v * eyy - (z or 0) end
for k3 = 1, n3 do
local j = K[k3] % 65536
local kind = LT[j]
if kind == 4 then
local tx, ty, b = LA[j], LB[j], LC[j]
local u0, v0, u1, v1 = tx, ty, tx + 2, ty + 2
local xc = X4N[(cov > 0.5) and 1 or 2]
local xn = xc[b]
if not xn then xn = "t_" .. b .. ((cov > 0.5) and "_tps_x4" or "_tp_x4"); xc[b] = xn end
q4(xn,
ox0 + u0 * exx + v0 * eyx, oy0 + u0 * exy + v0 * eyy - h, ox0 + u1 * exx + v0 * eyx, oy0 + u1 * exy + v0 * eyy - h,
ox0 + u1 * exx + v1 * eyx, oy0 + u1 * exy + v1 * eyy - h, ox0 + u0 * exx + v1 * eyx, oy0 + u0 * exy + v1 * eyy - h)
elseif kind == 3 then
local tx, ty, id = LA[j], LB[j], LC[j]
local x0, yA, x1, yB = tx * TS, ty * TS, (tx + 1) * TS, (ty + 1) * TS
local pb = IV.PLANT[id]
if IV.FLOOR[id] or id == "sd" or id == "su" then gq("t_" .. id .. "_gh", x0, yA, x1, yB)
elseif pb or IV.FLAT[id] then
local fx, fy = P((tx + 0.5) * TS, (ty + 0.75) * TS)
local nm = pb and ((pb == "sg") and "t_sg_gh" or ("t_" .. pb .. "1_gh")) or ("t_" .. id .. "_gh")
q(nm, fl(fx - 24), fl(fy - 48), fl(fx + 24), fl(fy), true)
else
local ax, ay = P(x0, yB, h); local bx, by = P(x1, yB, h); local cx, cy = P(x1, yB, 0); local dx, dy = P(x0, yB, 0)
q4("t_" .. id .. "_gh_fr", ax, ay, bx, by, cx, cy, dx, dy)
if WD.CAMV.s > 0 then
ax, ay = P(x1, yB, h); bx, by = P(x1, yA, h); cx, cy = P(x1, yA, 0); dx, dy = P(x1, yB, 0)
q4("t_" .. id .. "_gh_fr", ax, ay, bx, by, cx, cy, dx, dy)
elseif WD.CAMV.s < 0 then
ax, ay = P(x0, yA, h); bx, by = P(x0, yB, h); cx, cy = P(x0, yB, 0); dx, dy = P(x0, yA, 0)
q4("t_" .. id .. "_gh_fr", ax, ay, bx, by, cx, cy, dx, dy)
end
gq("t_" .. id .. "_gh_tp", x0, yA, x1, yB, h)
end
elseif kind == 2 then
local p = LA[j]
local x, y = P(p.x, p.y)
local face = (p == PL and PL.sface) or WD.sface(p.face or "down")
draw_one(p, fl(x), fl(y), face)
else
local tx, ty, b = LA[j], LB[j], LC[j]
local i = ty * N + tx
local x0, yA, x1, yB = tx * TS, ty * TS, (tx + 1) * TS, (ty + 1) * TS
if b == "to" then
local fx, fy = P((tx + 0.5) * TS, (ty + 0.75) * TS)
q("t_tl" .. (fl(t / 150 + i * 0.61) % 4 + 1), fl(fx - 24), fl(fy - 48), fl(fx + 24), fl(fy), true)
LIGHTS[#LIGHTS + 1] = { fx, fy - 36, 150 }
elseif IV.GROWB[b] then
local fx, fy = P((tx + 0.5) * TS, (ty + 0.75) * TS)
WD.swayq((b == "sg") and "t_sg" or ("t_" .. b .. WD.stage(i)), fx - 24, fy - 48, fx + 24, fy, WD.sway(t, i, 3))
elseif b == "tr" then
local fx, fy = P((tx + 0.5) * TS, (ty + 0.8) * TS)
if ABTN and ABTN.ti == i and ABTN.hitt and t - ABTN.hitt < 90 then fx = fx + ((t - ABTN.hitt < 45) and 3 or -2) end
q("shadow", fl(fx - 30), fl(fy - 9), fl(fx + 30), fl(fy + 9), true)
WD.swayq("t_tr", fx - 48, fy - 144, fx + 48, fy, WD.sway(t, i, 4))
if ABTN and ABTN.ti == i and ABTN.shown then
q("crack" .. math.min(3, fl(ABTN.shown / (ABTN.need or 1) * 3) + 1) .. "_f", fl(fx - 24), fl(fy - 48), fl(fx + 24), fl(fy), true)
end
else
local nm = b
if b == "do" then nm = WD.OPEN[i] and "do2" or "do1"
elseif b == "fu" and WD.FURN[i] and WD.FURN[i].burn > 0 then
nm = "fb" .. (fl(t / 140 + i * 0.37) % 4 + 1)
local lx, ly = P((tx + 0.5) * TS, (ty + 1) * TS, h * 0.5); LIGHTS[#LIGHTS + 1] = { lx, ly, 130 }
end
local sh = (ABTN and ABTN.ti == i and ABTN.hitt and t - ABTN.hitt < 90) and ((t - ABTN.hitt < 45) and 3 or -2) or 0
local ck = (ABTN and ABTN.ti == i and ABTN.shown) and ("crack" .. math.min(3, fl(ABTN.shown / (ABTN.need or 1) * 3) + 1) .. "_f") or nil
psh = sh
local NF = FNAMES[nm]
if not NF then NF = { "t_" .. nm .. "_frd", "t_" .. nm .. "_sid", "t_" .. nm .. "_tp", "t_" .. nm .. "_tps" }; FNAMES[nm] = NF end
if not (ty < N - 1 and solid(i + N)) then
local ax, ay = Ps(x0, yB, h); local bx, by = Ps(x1, yB, h); local cx, cy = Ps(x1, yB, 0); local dx, dy = Ps(x0, yB, 0)
q4(NF[1], ax, ay, bx, by, cx, cy, dx, dy)
if ck then q4(ck, ax, ay, bx, by, cx, cy, dx, dy) end
end
if WD.CAMV.s > 0 and not (tx < N - 1 and solid(i + 1)) then
local ax, ay = Ps(x1, yB, h); local bx, by = Ps(x1, yA, h); local cx, cy = Ps(x1, yA, 0); local dx, dy = Ps(x1, yB, 0)
q4(NF[2], ax, ay, bx, by, cx, cy, dx, dy)
if ck then q4(ck, ax, ay, bx, by, cx, cy, dx, dy) end
elseif WD.CAMV.s < 0 and not (tx > 0 and solid(i - 1)) then
local ax, ay = Ps(x0, yA, h); local bx, by = Ps(x0, yB, h); local cx, cy = Ps(x0, yB, 0); local dx, dy = Ps(x0, yA, 0)
q4(NF[2], ax, ay, bx, by, cx, cy, dx, dy)
if ck then q4(ck, ax, ay, bx, by, cx, cy, dx, dy) end
end
do
local ax, ay = Ps(x0, yA, h); local bx, by = Ps(x1, yA, h); local cx, cy = Ps(x1, yB, h); local dx, dy = Ps(x0, yB, h)
q4((cov > 0.5) and NF[4] or NF[3], ax, ay, bx, by, cx, cy, dx, dy)
if ck then q4(ck, ax, ay, bx, by, cx, cy, dx, dy) end
end
end
end
end
silh(PL, 1)
if MP then for _, p in pairs(MP.peers) do if not p.new and (p.z or 0) == WD.Z then silh(p, 2); break end end end
end
local SILPX = { ["0"] = "\0\0\0\0", ["1"] = string.char(235, 235, 255, 72), ["2"] = string.char(250, 250, 255, 205) }
function WD.sildraw(p, covered, slot)
local tag = p._tag
local keys = {}
for _, key in ipairs(SIL[tag] or {}) do if covered[key] then keys[#keys + 1] = key end end
if #keys == 0 then return end
if not smudge.hires_image or not SILD[tag] then
for _, key in ipairs(keys) do
local c, r = key:match("(%d+)_(%d+)")
local cx, cy = p._px - 36 + tonumber(c) * 24, p._py - 69 + tonumber(r) * 6
q("sil_" .. tag .. "_" .. key, fl(cx), fl(cy), fl(cx) + 24, fl(cy) + 6, true)
end
return
end
local name = "sil" .. slot .. "_c.png"
local id = tag .. ":" .. table.concat(keys, ",")
if WD.SILK[slot] ~= id then
local d = SILD[tag]
local rows = {}
for y = 0, 23 do
local r = y // 2
for x = 0, 23 do
local ch = covered[(x // 8) .. "_" .. r] and d:sub(y * 24 + x + 1, y * 24 + x + 1) or "0"
rows[#rows + 1] = SILPX[ch]
end
end
smudge.hires_image(name, 24, 24, table.concat(rows))
WD.SILK[slot] = id
end
if NQ < CAP then
NQ = NQ + 1
local o = -9
local x0, y0 = fl(p._px - 36), fl(p._py - 69)
smudge.hires_quad("^dyn/" .. name, o, o, o, o, o, o, o, o, x0, y0, x0 + 72, y0, x0 + 72, y0 + 72, x0, y0 + 72)
end
end
WD.SILK = {}
function WD.sway(t, i, amp)
if WD.swt ~= t then
WD.swt = t
local k = WX.now().kind
WD.swm = (WD.Z ~= 0) and 0.3 or (k == "storm") and 2.5 or (k == "wind") and 1.8 or (k == "rain") and 1.3 or 1
end
return (math.sin(t / 650 + i * 0.73) + 0.35 * math.sin(t / 270 + i * 1.9)) * amp * WD.swm
end
function WD.swayq(nm, x0, y0, x1, y1, dx)
if NQ >= CAP then return end
NQ = NQ + 1
local o = -9
smudge.hires_quad("^hd/wl_" .. nm .. "_c.png", o, o, o, o, o, o, o, o, x0 + dx, y0, x1 + dx, y0, x1, y1, x0, y1)
end
function WD.chest_s(i)
if not i or not WD.CHEST then return {} end
if not IV.CHESTB[WD.B[i] or ""] then return {} end
local C = WD.CHEST[i]
if not C then C = { s = {} }; WD.CHEST[i] = C end
return C.s
end
function WD.stage(i, L)
local t0 = (L or WD.lv(WD.Z)).GROW[i]
if not t0 then return 1 end
return math.max(1, math.min(4, 1 + fl((WD.now() - t0) / (IV.CROP_T / 3))))
end
function WD.drops(b, i)
local function ch(p) return math.random() < p end
if b == "or4" then return { { "co", 1 } } end
if IV.CHESTB[b] then return { { "ch", 1 } } end
if b == "tr" then
local d = { { "b04", X.rnd(3, 5) } }
local n = (ch(0.7) and 1 or 0) + (ch(0.25) and 1 or 0)
if n > 0 then d[2] = { "sp", n } end
return d
end
if b == "sg" then return { { "sp", 1 } } end
local ripe = WD.stage(i) >= 4
if b == "cw" then return ripe and { { "wh", X.rnd(1, 2) }, { "ws", X.rnd(1, 3) } } or { { "ws", 1 } } end
if b == "cc" then return { { "ca", ripe and X.rnd(2, 4) or 1 } } end
if b == "cp" then return { { "po", ripe and X.rnd(2, 4) or 1 } } end
if b == "b07" then
local d = { { "b07", 1 } }
if ch(0.6) then d[#d + 1] = { "ws", X.rnd(1, 2) } end
if ch(0.12) then d[#d + 1] = { "ca", 1 } end
if ch(0.12) then d[#d + 1] = { "po", 1 } end
return d
end
return { { b, 1 } }
end
function WD.gtick(t, dt)
local w = WX.now()
if WX.season() == 4 then
for i, t0 in pairs(WD.LV[0].GROW) do WD.LV[0].GROW[i] = t0 + dt end
elseif WD.Z == 0 and (w.kind == "rain" or w.kind == "storm") then
for i, t0 in pairs(WD.LV[0].GROW) do if WD.LV[0].B[i] ~= "sg" then WD.LV[0].GROW[i] = t0 - dt * 0.5 end end
end
if t < (WD.gt or 0) then return end
WD.gt = t + 1000
if MP and MP.role == "G" and next(MP.peers) then return end
local now = WD.now()
for z, L in pairs(WD.LV) do
for i, t0 in pairs(L.GROW) do
if L.B[i] == "sg" and now - t0 >= IV.SAP_T and not (z == WD.Z and someone_on(i % N, i // N)) then WD.setb(i, "tr", false, z) end
end
for i, t0 in pairs(L.RG) do
if now - t0 >= IV.RG_T then
local g = L.G[i]
if L.B[i] or L.GCH[i] or not (g == "gr1" or g == "di1") then L.RG[i] = nil
elseif not (z == WD.Z and someone_on(i % N, i // N)) then WD.setb(i, "sg", false, z) end
end
end
end
end
function WD.act(i)
if WD.B[i] ~= "do" then return end
if WD.OPEN[i] then
WD.OPEN[i] = nil
if not WD.free(PL.x, PL.y) then WD.OPEN[i] = true; return end
else WD.OPEN[i] = true end
snd("door", 0.35); dirty = true
mp_send("d|" .. WD.gi(i) .. "|" .. (WD.OPEN[i] and "1" or "0"))
end
function IV.gather()
for _, d in ipairs(IV.DROPS) do IV.add(d.id, d.n, d.d); mp_send("y|" .. d.uid) end
if #IV.DROPS > 0 then dirty = true end
IV.DROPS = {}
end
WD.WL = nil
function WD.worlds()
if WD.WL then return WD.WL end
local l = { { id = 0, seed = 0, name = "World 1", key = "wilds2" } }
local raw = smudge.load("wilds2_worlds", "") or ""
if raw ~= "" then
l = {}
for id, sd, nm in raw:gmatch("(%d+):(%d+):([^;]*);?") do
id = tonumber(id)
l[#l + 1] = { id = id, seed = tonumber(sd), name = nm, key = (id == 0) and "wilds2" or ("wilds2_w" .. id) }
end
end
WD.WL = l
return l
end
function WD.save_worlds()
local o = {}
for _, w in ipairs(WD.worlds()) do o[#o + 1] = w.id .. ":" .. w.seed .. ":" .. w.name:gsub("[;:]", "") end
smudge.save("wilds2_worlds", (#o > 0) and table.concat(o, ";") or "none")
end
function WD.new_world()
local l = WD.worlds()
local id = 0
for _, w in ipairs(l) do id = math.max(id, w.id) end
id = id + 1
local seed = (ms() % 999983 * 7 + X.rnd(1, 99999)) % 999983 + 1
local w = { id = id, seed = seed, name = "World " .. (id + 1), key = "wilds2_w" .. id }
l[#l + 1] = w
WD.save_worlds()
return w
end
function WD.del_world(w)
smudge.save(w.key, ""); smudge.save(w.key .. "_inv", "")
local l = WD.worlds()
for k = #l, 1, -1 do if l[k] == w then table.remove(l, k) end end
WD.save_worlds()
end
local function switch_world(key)
IV.gather()
if dirty then save() end
WKEY = key; load(); LAST = nil; PANEL = nil
end
function WILDST.enter() if MP then mp_stop() end; WORLD = nil end
function F.leave() OT.colours(false); LAST = nil; IV.gather(); if dirty then save() end; mp_stop(); WORLD = nil
WD.WX.amb = nil; if SND and SND.apply then SND.apply() end
end
local function draw_choose(y0)
local cy = y0 + 40
X.ctext(W // 2, cy, "The Wilds", "ui12", "bold")
X.button(24, cy + 50, W - 48, 96, "MY WORLDS", function() WORLD = "list" end,
{ font = "ui12", sub = "just you: choose one or make a new one", id = "WLMINE", nohelp = true })
local can = smudge.mp ~= nil
local r, c = "", ""
if can then r, c = smudge.mp("get") end
local paired = can and (r or "") ~= "" and (c or "") ~= ""
X.button(24, cy + 160, W - 48, 96, "OUR WORLD", function()
if not can then X.set_note("Our world needs the newer app: reinstall it (6.8.0 or later)."); return end
if not paired then local _, _, n = smudge.mp("get"); SET = { f = { r or "", c or "", n or "" }, k = 1 }; WORLD = "setup"; return end
WORLD = "share"
end, { font = "ui12", sub = paired and "together, live" or "set it up once (both phones)", off = not can, id = "WLOURS", nohelp = true })
if paired then
X.button(24, cy + 270, W - 48, 56, "PAIRING", function() local _, _, n = smudge.mp("get"); SET = { f = { r, c, n or "" }, k = 1 }; WORLD = "setup" end,
{ font = "ui10", sub = "relay, code, your name", id = "WLPAIR", nohelp = true })
end
K.back_btn("skills")
end
local function draw_list(y0)
local l = WD.worlds()
X.ctext(W // 2, y0 + 30, "My worlds", "ui12", "bold")
local by = y0 + 70
for k, w in ipairs(l) do
if by > Hh - 260 then break end
X.button(24, by, W - 48 - 96, 76, w.name, function()
WORLD = "mine"; WD.SEED = w.seed; switch_world(w.key)
end, { font = "ui12", sub = (w.seed == 0) and "the first world" or ("seed " .. w.seed), id = "WLW" .. w.id, nohelp = true })
local sure = WD.DEL and WD.DEL[1] == w and ms() - WD.DEL[2] < 4000
X.button(W - 24 - 88, by, 88, 76, sure and "SURE?" or "DELETE", function()
if sure then WD.del_world(w); WD.DEL = nil; X.set_note(w.name .. " is gone.")
else WD.DEL = { w, ms() }; X.set_note("Tap again to delete " .. w.name .. " for good.") end
end, { font = "small", active = sure, id = "WLWD" .. w.id, nohelp = true })
by = by + 86
end
if #l < 8 then
X.button(24, by + 10, W - 48, 76, "NEW WORLD", function()
local w = WD.new_world()
WORLD = "mine"; WD.SEED = w.seed; switch_world(w.key)
X.set_note(w.name .. ": a new world (seed " .. w.seed .. ")")
end, { font = "ui12", sub = "a random one", id = "WLWNEW", nohelp = true })
end
X.button(W - 112, y0 + 14, 96, 40, "BACK", function() WORLD = nil end, { font = "small", id = "WLLBACK", nohelp = true })
end
local function draw_share(y0)
local l = WD.worlds()
X.ctext(W // 2, y0 + 30, "Our world", "ui12", "bold")
X.button(24, y0 + 70, W - 48, 86, "JOIN", function()
mp_start(); MP.role = "G"; WORLD = "join"; MP.tjoin = ms()
end, { font = "ui12", sub = "go into the world your friend shares", id = "WLJOIN", nohelp = true })
OT.c(W // 2, y0 + 176, "or share one of yours:", "small", "bold")
local by = y0 + 200
for _, w in ipairs(l) do
if by > Hh - 200 then break end
X.button(24, by, W - 48, 70, "SHARE " .. w.name, function()
WORLD = "ours"; WD.SEED = w.seed; switch_world(w.key); mp_start(); MP.role = "H"
end, { font = "ui10", sub = (w.seed == 0) and "the first world" or ("seed " .. w.seed), id = "WLSH" .. w.id, nohelp = true })
by = by + 80
end
X.button(W - 112, y0 + 14, 96, 40, "BACK", function() WORLD = nil end, { font = "small", id = "WLSBACK", nohelp = true })
end
local function draw_join(y0)
if MP then mp_tick(ms(), 0) end
if WORLD ~= "join" then return end
smudge.rounded_rect(24, y0 + 60, W - 48, 200, 12, false, 2)
OT.c(W // 2, y0 + 90, "Our world", "ui12", "bold")
local txt = "Waiting for your friend to share a world..."
if MP and MP.block then txt = "Your friend has version " .. tostring(MP.block[2]) .. ": you both need the same" end
if MP and MP.st ~= 2 then txt = "Connecting..." end
OT.c(W // 2, y0 + 140, X.fit(txt, W - 72, "small"), "small")
OT.c(W // 2, y0 + 170, X.fit("They tap OUR WORLD, then SHARE a world.", W - 72, "small"), "small")
X.button(W // 2 - 80, y0 + 196, 160, 48, "CANCEL", function() mp_stop(); WORLD = nil end, { font = "small", id = "WLJCANCEL", nohelp = true })
busy()
end
local function draw_setup(y0)
local f = SET.f
NQ, CAP = 0, CAPW.all
UI.nine("ui_panel", 48, 6, 8, y0 - 6, W - 16, Hh - 104 - y0 + 10, 3)
OT.c(W // 2, y0 + 8, "Our world: pairing", "ui12", "bold")
OT.c(W // 2, y0 + 40, X.fit("Relay: the NAME in cardscape-relay.NAME.workers.dev", W - 32, "small"), "small")
OT.c(W // 2, y0 + 60, X.fit("One phone: NEW CODE. Type that code on the other.", W - 32, "small"), "small")
local labels = { "RELAY", "CODE", "YOUR NAME" }
for k = 1, 3 do
local by = y0 + 92 + (k - 1) * 70
OT.l(24, by, labels[k], "small", "bold")
local v = (k == 1) and f[k]:lower() or f[k]
X.button(24, by + 20, W - 48, 44, (v ~= "" and v or "-") .. ((SET.k == k) and "_" or ""), function() SET.k = k end,
{ font = "ui10", active = SET.k == k, id = "WLSET" .. k, nohelp = true })
end
local function key(ch)
local v = f[SET.k]
if SET.k == 2 then
local raw = (v .. ch):upper():gsub("[^A-Z0-9]", "")
if #raw > 12 then return end
f[2] = raw:gsub("(....)", "%1-"):gsub("%-$", "")
elseif #v < 30 then f[SET.k] = v .. ch end
end
local addr = f[1]:lower()
if addr ~= "" and not addr:find("%.") then addr = "cardscape-relay." .. addr .. ".workers.dev" end
OT.c(W // 2, y0 + 92 + 3 * 70 + 6, X.fit(addr ~= "" and addr or "(type your workers.dev name)", W - 32, "small"), "small", "bold")
X.keyboard({ rows = { "1234567890", "QWERTYUIOP", "ASDFGHJKL-", "ZXCVBNM." }, id = "WLK", key = key, bottom = Hh - 104,
actions = {
{ "DEL", function() local v = f[SET.k]; f[SET.k] = v:sub(1, -2):gsub("%-$", "") end, false, "WLKDEL" },
{ "NEW CODE", function() local nc = smudge.mp("newcode"); if nc then f[2] = nc; SET.k = 3 end end, false, "WLKNEW" },
{ "SAVE", function()
if f[1] == "" or #f[2]:gsub("%-", "") < 12 then X.set_note("Fill in the relay's name and the 12-letter code."); return end
smudge.mp("set", f[1]:lower(), f[2], safe_name(f[3]))
WORLD = nil; X.set_note("Saved. Tap OUR WORLD.")
end, false, "WLKSAVE" } } })
X.button(W - 112, y0 - 2, 96, 40, "BACK", function() WORLD = nil end, { font = "small", id = "WLSETBACK", nohelp = true })
end
local function pbtn(x, y, w, h, ...)
WD.PB[#WD.PB + 1] = { x, y, w, h, (select(2, ...)) }
UI.btn(x, y, w, h, ...)
end
local function draw_panel(y0, y1)
WD.PB = {}
local px, py, pw, ph = 16, y0 + 60, W - 32, y1 - y0 - 120
UI.nine("ui_panel", 48, 6, px, py, pw, ph, 3)
X.reg("WLPANELBG", px, py, pw, ph, function() end, false)
local tabs = (PANEL == "char" or PANEL == "set") and { { "char", "CHARACTER" }, { "set", "SETTINGS" } } or {}
local nb = #tabs + 1
local tw = fl((pw - 24 - 8 * (nb - 1)) / nb)
for k, tb in ipairs(tabs) do
pbtn(px + 12 + (k - 1) * (tw + 8), py + 12, tw, 46, tb[2], function() PANEL = tb[1] end, { font = "small", active = PANEL == tb[1], id = "WLT" .. tb[1], nohelp = true })
end
pbtn(px + pw - 12 - tw, py + 12, tw, 46, "CLOSE", function() PANEL = nil end, { font = "small", id = "WLCLOSE", nohelp = true })
local yy = py + 72
if PANEL == "menu" then
local bw2, bh2 = pw - 64, 70
local mx = px + 32
pbtn(mx, yy + 20, bw2, bh2, "CONTINUE", function() PANEL = nil end, { font = "ui12", id = "WLMCONT" })
pbtn(mx, yy + 110, bw2, bh2, "CHARACTER", function() PANEL = "char" end, { font = "ui12", id = "WLMCHAR" })
pbtn(mx, yy + 200, bw2, bh2, "SETTINGS", function() PANEL = "set" end, { font = "ui12", id = "WLMSET" })
pbtn(mx, yy + 290, bw2, bh2, "QUIT", function() PANEL = nil; F.leave(); X.go("skills") end, { font = "ui12", sub = "back to your skills", id = "WLMQUIT" })
elseif PANEL == "char" then
local lk = ST.look
ST.pface = ST.pface or "down"
UI.char(lk, px + pw / 2, yy + 200, ST.pface, UI.idle(0, 0, PL), 3)
pbtn(px + pw - 104, yy + 150, 84, 44, "TURN", function()
ST.pface = ({ down = "left", left = "up", up = "right", right = "down" })[ST.pface]
end, { font = "small", id = "WLCTURN" })
local function changed() ST.save(); if ST.on_look then ST.on_look() end end
local hw = fl((pw - 48 - 8) / 2)
local ry = yy + 220
local function row(yr, label, val, n, set)
OT.l(px + 24, yr + 12, label, "small", "bold")
pbtn(px + 120, yr, 52, 48, "<", function() set((val - 2) % n + 1); changed() end, { font = "ui10", id = "WLC" .. label .. "L" })
OT.c(fl(px + 120 + 52 + (pw - 260) / 2), yr + 12, (label == "HAIR") and ST.HAIRN[val] or ST.SHIRTN[val], "small", "bold")
pbtn(px + pw - 76, yr, 52, 48, ">", function() set(val % n + 1); changed() end, { font = "ui10", id = "WLC" .. label .. "R" })
end
row(ry + 66, "HAIR", lk.h, 6, function(v) lk.h = v end)
row(ry + 122, "SHIRT", lk.s, 8, function(v) lk.s = v end)
elseif PANEL == "set" then
local function tog(yr, label, a, b, on, fn)
OT.l(px + 24, yr, label, "small", "bold")
local hw = fl((pw - 48 - 8) / 2)
pbtn(px + 24, yr + 24, hw, 52, a, function() fn(false); ST.save() end, { font = "small", active = not on, id = "WLS" .. a })
pbtn(px + 32 + hw, yr + 24, hw, 52, b, function() fn(true); ST.save() end, { font = "small", active = on, id = "WLS" .. b })
end
tog(yy + 10, "Joystick", "FOLLOWS THUMB", "STAYS PUT", ST.fixed, function(v) ST.fixed = v end)
tog(yy + 100, "Hand for the joystick", "LEFT THUMB", "RIGHT THUMB", ST.left, function(v) ST.left = v end)
tog(yy + 190, "Name tags in our world", "OFF", "ON", ST.tags, function(v) ST.tags = v end)
tog(yy + 280, "Hotbar", "BELOW BUTTONS", "ABOVE BUTTONS", ST.hbtop, function(v) ST.hbtop = v end)
tog(yy + 370, "Controller", "XBOX", "PLAYSTATION", ST.ps, function(v) ST.ps = v end)
OT.l(px + 24, yy + 460, "Controller pointer speed", "small", "bold")
local sp = ST.psp or 3
pbtn(px + 24, yy + 484, 64, 52, "<", function() ST.psp = math.max(1, sp - 1); ST.save() end, { font = "ui10", id = "WLSPL" })
OT.c(W // 2, yy + 498, ({ "SLOW", "CALM", "MEDIUM", "QUICK", "FAST" })[sp], "small", "bold")
pbtn(px + pw - 88, yy + 484, 64, 52, ">", function() ST.psp = math.min(5, sp + 1); ST.save() end, { font = "ui10", id = "WLSPR" })
end
end
local LOAD_MS = 1200
local ALL = {}
do
local function add(nm) ALL[#ALL + 1] = "hd/wl_" .. nm .. "_c.png" end
for _, d in ipairs({ "down", "up", "left", "right" }) do for k = 0, 4 do
local tg = (k == 3) and ("use_" .. d) or (k == 4) and ("idle_" .. d) or (d .. k)
add("ch2_base_" .. tg)
for h = 1, 6 do add("ch2_h" .. h .. "_" .. tg) end
for s = 1, 8 do add("ch2_s" .. s .. "_" .. tg) end
if k < 3 or k == 4 then add("an1_" .. tg) end
end end
for _, nm in ipairs({ "ui_panel", "ui_btn", "ui_btnp", "ui_btnoff", "ui_round", "ui_round_s", "ui_stick", "ui_knob", "ui_power",
"i_hand", "shadow" }) do add(nm) end
for _, nm in ipairs({ "gr1", "di1", "sa1", "wa1", "wa2", "wa3", "wa4", "fl1", "fl2", "fl3", "fl4", "do1", "do2" }) do add("t_" .. nm) end
for k = 1, 8 do for _, sf in ipairs({ "", "_nb", "_nf", "_nn", "_gh", "_tp", "_nb_tp", "_nf_tp", "_nn_tp" }) do add("t_b0" .. k .. sf); add("t_or" .. k .. sf) end end
add("t_do_gh")
for _, nm in ipairs({ "t_ct", "t_fu", "t_ct_gh", "t_fu_gh", "t_to_gh", "light", "t_fl1_gh", "t_fl2_gh", "t_fl4_gh" }) do add(nm) end
for k = 1, 4 do add("t_fb" .. k); add("t_tl" .. k) end
for a = 0, 3 do for b = 0, 3 do for c = 0, 3 do for d = 0, 3 do add("dk_" .. a .. b .. c .. d) end end end end
for _, nm in ipairs({ "wx_cloud1", "wx_cloud2", "wx_fog1", "wx_fog2", "wx_grey1", "wx_grey2", "wx_grey3", "wx_dusk1", "wx_dusk2",
"wx_dawn1", "wx_dawn2", "wx_flash", "wx_rain1", "wx_rain2", "wx_snow", "ui_sun", "ui_moon", "ui_wcloud",
"ui_wrain", "ui_wstorm", "ui_wfog", "ui_wsnow", "ui_wwind" }) do add(nm) end
for m = 1, 7 do add("shd" .. m) end
for _, nm in ipairs({ "bar", "sel", "invp", "bag" }) do add("hb_" .. nm) end
for id in pairs(IV.NAME) do if not IV.NOICON[id] then add("it_" .. id) end end
for _, c in ipairs({ "cw", "cc", "cp" }) do for k = 1, 4 do add("t_" .. c .. k) end; add("t_" .. c .. "1_gh") end
add("t_sg"); add("t_sg_gh"); add("t_tr")
for _, c in ipairs({ "ch", "cl", "cr" }) do add("t_" .. c); add("t_" .. c .. "_gh") end
for c in pairs(CHIPS) do add("pt_" .. c) end
for _, nm in ipairs({ "fx_contact", "fx_ao_l", "fx_ao_r", "fx_ao_c", "fx_front", "fx_side" }) do add(nm) end
for _, c in ipairs({ "b01", "b02", "b03", "b04", "b05", "b06", "b08", "or1", "or2", "or3", "or4", "or5", "or6", "or7", "or8" }) do add("t_" .. c .. "_tp_x4"); add("t_" .. c .. "_tps_x4") end
for _, c in ipairs(WD.TPFR) do add("t_" .. c .. "_tp"); add("t_" .. c .. "_frd"); add("t_" .. c .. "_sid"); add("t_" .. c .. "_tps") end
for _, g in ipairs({ "gr1", "di1", "fl3", "sa1" }) do add("t_" .. g .. "_sn1"); add("t_" .. g .. "_sn2") end
for _, nm in ipairs({ "gr1", "di1", "sa1", "fl1", "fl2", "fl3", "fl4", "wa1", "wa2", "wa3", "wa4", "gr1_sn1", "gr1_sn2", "di1_sn1", "di1_sn2", "fl3_sn1", "fl3_sn2", "sa1_sn1", "sa1_sn2" }) do add("t_" .. nm .. "_x4") end
for b = 0, 15 do add("sh" .. (b & 1) .. ((b >> 1) & 1) .. ((b >> 2) & 1) .. ((b >> 3) & 1)) end
for _, c in ipairs({ "b01", "b02", "b03", "b04", "b05", "b06", "b07", "b08", "do", "or1", "or2", "or3", "or4", "or5", "or6", "or7", "or8", "ct", "fu", "ch", "cl", "cr" }) do
add("t_" .. c .. "_gh_tp"); add("t_" .. c .. "_gh_fr")
end
for k = 1, 3 do add("crack" .. k .. "_f") end
if not smudge.hires_image then for tag, cells in pairs(SIL) do for _, key in ipairs(cells) do add("sil_" .. tag .. "_" .. key) end end end
for _, nm in ipairs({ "pt_dust", "pt_snow", "pt_spark", "fx_snow1", "fx_snow2", "fx_snowtop" }) do add(nm) end
for k = 1, 3 do add("pt_ember" .. k); add("pt_breath" .. k); add("pt_foot" .. k); add("pt_shim" .. k) end
for _, d in ipairs({ "n", "s", "w", "e" }) do add("fx_foam_" .. d .. "1"); add("fx_foam_" .. d .. "2") end
for k = 1, 3 do add("crack" .. k) end
for _, nm in ipairs({ "it_book", "inv_slot", "inv_bg", "dither", "ui_chisel", "ui_yel", "ui_cursor", "ui_dot_me", "ui_dot_you",
"ui_dot_an", "ui_mapbg", "ui_tip_l", "ui_tip_m", "ui_tip_r", "ui_durbg", "ui_dur1", "ui_dur2", "ui_dur3",
"t_sd", "t_su", "t_sd_gh", "t_su_gh" }) do add(nm) end
for k = 0, 9 do add("ui_n" .. k) end
for k = 1, 5 do add("ui_wp" .. k); add("ui_wpa" .. k) end
add("inv")
end
local IW, IH = 428, 404
IV.SLM = {}
for _, mode in ipairs({ "inv", "table", "furnace", "chest" }) do
local L = {}
if mode ~= "chest" then for k = 1, 4 do L[#L + 1] = { "A", k, 8, 8 + (k - 1) * 22 } end end
if mode == "chest" then
for r = 0, 2 do for c = 0, 8 do L[#L + 1] = { "K", 1 + r * 9 + c, 8 + c * 22, 22 + r * 22 } end end
elseif mode == "inv" then
for k = 1, 4 do L[#L + 1] = { "C", k, 108 + ((k - 1) % 2) * 22, 30 + ((k - 1) // 2) * 22 } end
L[#L + 1] = { "OUT", 1, 180, 41 }
elseif mode == "table" then
for k = 1, 9 do L[#L + 1] = { "T", k, 104 + ((k - 1) % 3) * 22, 14 + ((k - 1) // 3) * 22 } end
L[#L + 1] = { "OUT", 1, 180, 36 }
else
L[#L + 1] = { "F", 1, 118, 12 }; L[#L + 1] = { "F", 2, 118, 62 }; L[#L + 1] = { "F", 3, 178, 37 }
end
for r = 0, 2 do for c = 0, 8 do L[#L + 1] = { "S", 10 + r * 9 + c, 8 + c * 22, 104 + r * 22 } end end
for c = 0, 8 do L[#L + 1] = { "S", 1 + c, 8 + c * 22, 172 } end
IV.SLM[mode] = L
end
function IV.slots() return IV.SLM[IV.MODE] or IV.SLM.inv end
IV.SL = IV.SLM.inv
function IV.slot_item(it, sx, sy)
if not it then return end
UI.pic("it_" .. it.id, sx + 6, sy + 6, sx + 38, sy + 38)
local mx = IV.dmax(it.id)
if mx and it.d and it.d < mx then
local f = it.d / mx
UI.pic("ui_durbg", sx + 7, sy + 35, sx + 37, sy + 40)
UI.pic((f > 0.5) and "ui_dur1" or (f > 0.2) and "ui_dur2" or "ui_dur3", sx + 8, sy + 36, sx + 8 + math.max(1, fl(28 * f)), sy + 39)
end
if it.n > 1 then UI.num(it.n, sx + 42, sy + 42) end
end
function UI.num(n, rx, by)
local t = tostring(n)
local x = rx - #t * 12 - 2
for k = 1, #t do UI.pic("ui_n" .. t:sub(k, k), x + (k - 1) * 12, by - 18, x + (k - 1) * 12 + 14, by) end
end
function UI.tip(x0, y0, x1)
x0, x1 = fl(x0), fl(x1)
UI.pic("ui_tip_l", x0, y0, x0 + 12, y0 + 30)
UI.pic("ui_tip_m", x0 + 12, y0, x1 - 12, y0 + 30)
UI.pic("ui_tip_r", x1 - 12, y0, x1, y0 + 30)
end
function IV.close()
if IV.DRAG and IV.DRAG.it then IV.put(IV.DRAG, nil) end
for k = 1, 4 do local it = IV.C[k]; if it then local left = IV.add(it.id, it.n, it.d); IV.C[k] = (left > 0) and { id = it.id, n = left } or nil end end
for k = 1, 9 do local it = IV.T[k]; if it then local left = IV.add(it.id, it.n, it.d); IV.T[k] = (left > 0) and { id = it.id, n = left } or nil end end
IV.DRAG, IV.open, IV.BOOK, IV.GHOST, IV.MODE = nil, false, false, nil, "inv"
dirty = true
end
function IV.pick(rec)
local g, n = IV.grid()
if not IV.fits(rec) then X.set_note("That needs a crafting table"); snd("click", 0.15); return end
for k = 1, n * n do local it = g[k]; if it then local left = IV.add(it.id, it.n, it.d); g[k] = (left > 0) and { id = it.id, n = left } or nil end end
IV.BOOK = false
for k = 1, n * n do if g[k] then IV.GHOST = rec; return end end
if IV.can(rec) then
for r, row in ipairs(rec.shape) do for c, id in pairs(row) do
if id and IV.take(id) then g[(r - 1) * n + c] = { id = id, n = 1 } end
end end
IV.GHOST = nil; snd("click", 0.25)
else IV.GHOST = rec; snd("click", 0.15) end
dirty = true
end
IV.BPAGE = 1
function IV.book_list()
local a, b = {}, {}
for _, rec in ipairs(IV.RECIPES) do if IV.can(rec) then a[#a + 1] = rec else b[#b + 1] = rec end end
for _, rec in ipairs(b) do a[#a + 1] = rec end
return a
end
function IV.book_cells()
local all, l, gx, gy = IV.book_list(), {}, IV.gx or 0, IV.gy or 0
IV.BPAGES = math.max(1, (#all + 14) // 15)
IV.BPAGE = math.max(1, math.min(IV.BPAGES, IV.BPAGE))
for k = 1, 15 do
local rec = all[(IV.BPAGE - 1) * 15 + k]
if rec then l[#l + 1] = { rec, gx + 206 + ((k - 1) % 5) * 42, gy + 54 + ((k - 1) // 5) * 44 } end
end
return l
end
function IV.hit(x, y)
local gx, gy = IV.gx or 0, IV.gy or 0
local on = x >= gx and x < gx + IW and y >= gy and y < gy + IH
for _, sl in ipairs(IV.slots()) do
local sx, sy = gx + sl[3] * 2, gy + sl[4] * 2
if x >= sx and x < sx + 44 and y >= sy and y < sy + 44 then return sl, on end
end
return nil, on
end
local function tbl(kind)
if kind == "A" then return IV.A elseif kind == "C" then return IV.C elseif kind == "T" then return IV.T end
if kind == "F" then local F = WD.FURN[IV.FI or -1]; return F and F.s or {} end
if kind == "K" then return WD.chest_s(IV.CH and IV.CH[IV.CP or 1]) end
return IV.S
end
function IV.lift(half)
local D = IV.DRAG
if D.it then return end
if D.kind == "OUT" then
local r = IV.result()
if not r then IV.DRAG = nil; return end
local g, n = IV.grid()
for j = 1, n * n do local it = g[j]; if it then it.n = it.n - 1; if it.n <= 0 then g[j] = nil end end end
D.it = { id = r.id, n = r.n }; snd("wl_pop", 0.3); dirty = true; return
end
local t = tbl(D.kind)
local it = t[D.k]
if not it then IV.DRAG = nil; return end
local m = half and math.max(1, it.n // 2) or it.n
if half and it.n == 1 then m = 1 end
D.it = { id = it.id, n = m, d = it.d }
it.n = it.n - m
if it.n <= 0 then t[D.k] = nil end
D.half = half
snd("click", 0.2)
end
function IV.put(D, sl)
local it = D.it
local back = function()
if D.kind ~= "OUT" then
local t = tbl(D.kind)
local o = t[D.k]
if not o then t[D.k] = it; return end
if o.id == it.id and o.n + it.n <= IV.max(o.id) then o.n = o.n + it.n; return end
end
local left = IV.add(it.id, it.n, it.d)
if left > 0 then IV.drop(it.id, left, PL.x, PL.y + 6, true, it.d) end
end
if not sl or sl[1] == "OUT" then back(); return end
if sl[1] == "F" and sl[2] == 3 then back(); return end
if sl[1] == "F" and sl[2] == 2 and not IV.FUEL[it.id] then X.set_note("That doesn't burn"); back(); return end
if sl[1] == "A" and it.id:sub(1, 2) ~= IV.SLOT[sl[2]] or (sl[1] == "A" and not IV.gear(it.id)) then
X.set_note("That doesn't go there"); back(); return
end
local t = tbl(sl[1])
local o = t[sl[2]]
if not o then t[sl[2]] = it
elseif o.id == it.id and o.n < IV.max(o.id) then
local m = math.min(it.n, IV.max(o.id) - o.n); o.n = o.n + m; it.n = it.n - m
if it.n > 0 then back() end
else
local ft = (D.kind ~= "OUT") and tbl(D.kind)
local fits = D.kind ~= "A" or (IV.gear(o.id) and o.id:sub(1, 2) == IV.SLOT[D.k])
if ft and not ft[D.k] and fits then t[sl[2]] = it; ft[D.k] = o else back() end
end
snd("click", 0.2)
end
function IV.touch(e, f, x, y)
if e == "down" then
local gx, gy = IV.gx or 0, IV.gy or 0
if IV.MODE == "chest" and IV.CH and IV.CH[2] and y >= gy + 4 and y < gy + 40 then
if x >= gx + 282 and x < gx + 314 then IV.CP = 1; snd("click", 0.2); return end
if x >= gx + 368 and x < gx + 400 then IV.CP = 2; snd("click", 0.2); return end
end
if IV.MODE ~= "furnace" and IV.MODE ~= "chest" and x >= gx + 360 and x < gx + 412 and y >= gy + 8 and y < gy + 56 then
IV.BOOK = not IV.BOOK; IV.GHOST = nil; snd("click", 0.25); return
end
if IV.BOOK then
for _, b in ipairs(IV.book_cells()) do
if x >= b[2] and x < b[2] + 42 and y >= b[3] and y < b[3] + 44 then
IV.TIP = { IV.what({ rec = b[1] }), ms(), b[2], b[3] - 34 }
IV.pick(b[1]); return
end
end
if y >= gy + 10 and y < gy + 50 then
if x >= gx + 282 and x < gx + 320 then IV.BPAGE = math.max(1, IV.BPAGE - 1); snd("click", 0.2); return end
if x >= gx + 320 and x < gx + 358 then IV.BPAGE = math.min(IV.BPAGES or 1, IV.BPAGE + 1); snd("click", 0.2); return end
end
if x >= gx + 200 and y < gy + 200 and x < gx + IW and y >= gy then return end
end
local sl, on = IV.hit(x, y)
if IV.BOOK and sl and (sl[1] == "C" or sl[1] == "T" or sl[1] == "OUT") then sl = nil end
if sl then IV.DRAG = { f = f, kind = sl[1], k = sl[2], x0 = x, y0 = y, x = x, y = y, t0 = ms() }
elseif not on then IV.OUTDOWN = f end
return
end
local D = IV.DRAG
if e == "move" or e == "nudge" then
if D and D.f == f then
D.x, D.y = x, y
if not D.it and (x - D.x0) ^ 2 + (y - D.y0) ^ 2 > 10 ^ 2 then IV.lift(ms() - D.t0 >= 380) end
end
return
end
if D and D.f == f then
IV.DRAG = nil
if D.it then
local sl, on = IV.hit(x, y)
if not sl and not on then
local d = ({ down = { 0, 1 }, up = { 0, -1 }, left = { -1, 0 }, right = { 1, 0 } })[PL.face] or { 0, 1 }
local tx, ty = PL.x + d[1] * 40, PL.y + d[2] * 40
if WD.solid(tx, ty - 4) then tx, ty = PL.x, PL.y + 4 end
IV.drop(D.it.id, D.it.n, tx, ty, true, D.it.d)
snd("wl_pop", 0.3)
else IV.put(D, sl) end
dirty = true
else
local sl = IV.hit(x, y)
local w = sl and IV.what({ sl = sl })
if w then IV.TIP = { w, ms(), x - 40, y - 60 } end
if D.kind == "S" and D.k <= 9 then ST.sel = D.k; ST.save(); snd("click", 0.2) end
end
return
end
if IV.OUTDOWN == f then
IV.OUTDOWN = nil
local sl, on = IV.hit(x, y)
if not on then IV.close() end
end
end
function IV.what(tg)
if tg.sl then
if tg.sl[1] == "OUT" then local r = IV.result(); return r and IV.NAME[r.id] end
local it = tbl(tg.sl[1])[tg.sl[2]]
if it then return IV.NAME[it.id] .. ((it.n > 1) and (" x" .. it.n) or "") end
if tg.sl[1] == "A" then return ({ "Head", "Body", "Legs", "Feet" })[tg.sl[2]] end
if tg.sl[1] == "F" then return ({ "To smelt", "Fuel", "Comes out" })[tg.sl[2]] end
return nil
end
if tg.rec then return IV.NAME[tg.rec.out] .. (IV.fits(tg.rec) and "" or " (crafting table)") end
if tg.page then return (tg.page < 0) and "Page back" or "Next page" end
if tg.cpage then return (tg.cpage < 0) and "First half" or "Second half" end
if tg.book then return IV.BOOK and "Back to crafting" or "Recipes" end
end
function IV.draw(y0, y1)
local gx, gy = fl((W - IW) / 2), y0 + 76
IV.gx, IV.gy = gx, gy
X.reg("WLINVBLOCK", 0, y0, W, y1 - y0, function() end, false)
local D = IV.DRAG
if D and not D.it and ms() - D.t0 >= 380 then IV.lift(true) end
UI.pic("inv", gx, gy, gx + IW, gy + IH)
UI.char(ST.look, gx + 128, gy + 184, "down", UI.idle(0, 0, PL), 8 / 3)
local MODE = IV.MODE
if MODE == "chest" then
UI.pic("inv_bg", gx + 8, gy + 8, gx + IW - 8, gy + 200)
local two = IV.CH and IV.CH[2]
OT.l(gx + 18, gy + 12, two and "Large chest" or "Chest", "small", "bold")
for _, sl in ipairs(IV.slots()) do
if sl[1] == "K" then local sx, sy = gx + sl[3] * 2, gy + sl[4] * 2; UI.pic("inv_slot", sx + 2, sy + 2, sx + 42, sy + 42) end
end
if two then
OT.c(gx + 340, gy + 14, (IV.CP or 1) .. "/2", "small", "bold")
UI.pic("inv_slot", gx + 282, gy + 4, gx + 314, gy + 40); OT.c(gx + 298, gy + 10, "<", "small", "bold")
UI.pic("inv_slot", gx + 368, gy + 4, gx + 400, gy + 40); OT.c(gx + 384, gy + 10, ">", "small", "bold")
end
elseif MODE ~= "inv" then
UI.pic("inv_bg", gx + 200, gy + 10, gx + IW - 8, gy + 196)
OT.c(W // 2, gy - 26, (MODE == "table") and "Crafting table" or "Furnace", "ui12", "bold")
for _, sl in ipairs(IV.slots()) do
if sl[1] == "T" or sl[1] == "F" or sl[1] == "OUT" then
local sx, sy = gx + sl[3] * 2, gy + sl[4] * 2
UI.pic("inv_slot", sx + 2, sy + 2, sx + 42, sy + 42)
end
end
if MODE == "table" then OT.c(gx + 349, gy + 88, "=", "ui12", "bold")
else
local F = WD.FURN[IV.FI or -1]
local fr = (F and F.burn > 0 and F.bmax > 0) and F.burn / F.bmax or 0
UI.pic("dither", gx + 246, gy + 76, gx + 262, gy + 120)
if fr > 0 then UI.pic("ui_yel", gx + 246, gy + 120 - fl(44 * fr), gx + 262, gy + 120) end
UI.pic("dither", gx + 290, gy + 92, gx + 350, gy + 104)
local pr = F and F.prog / IV.SMELT_T or 0
if pr > 0 then UI.pic("ui_yel", gx + 290, gy + 92, gx + 290 + fl(60 * pr), gy + 104) end
end
end
if MODE == "inv" and not IV.BOOK then OT.l(gx + 216, gy + 32, "Crafting", "small", "bold") end
local r = IV.result()
for _, sl in ipairs(IV.slots()) do
local sx, sy = gx + sl[3] * 2, gy + sl[4] * 2
if sl[1] == "OUT" then IV.slot_item(r, sx, sy) else IV.slot_item(tbl(sl[1])[sl[2]], sx, sy) end
end
if IV.GHOST and not IV.BOOK and MODE ~= "furnace" then
local g, n = IV.grid()
for r, row in ipairs(IV.GHOST.shape) do for c, id in pairs(row) do
local k = (r - 1) * n + c
if id and not g[k] then
local sx, sy = gx + ((n == 3) and (104 + (c - 1) * 22) or (108 + (c - 1) * 22)) * 2, gy + ((n == 3) and (14 + (r - 1) * 22) or (30 + (r - 1) * 22)) * 2
UI.pic("it_" .. id, sx + 6, sy + 6, sx + 38, sy + 38); UI.pic("dither", sx + 6, sy + 6, sx + 38, sy + 38)
end
end end
if not r then local sx, sy = gx + 360, gy + ((n == 3) and 72 or 82); UI.pic("it_" .. IV.GHOST.out, sx + 6, sy + 6, sx + 38, sy + 38); UI.pic("dither", sx + 6, sy + 6, sx + 38, sy + 38) end
end
if IV.BOOK then
UI.pic("inv_bg", gx + 200, gy + 10, gx + IW - 8, gy + 196)
local cl = IV.book_cells()
OT.l(gx + 210, gy + 24, IV.BPAGE .. "/" .. IV.BPAGES, "small", "bold")
UI.pic("inv_slot", gx + 282, gy + 10, gx + 318, gy + 46); OT.c(gx + 300, gy + 18, "<", "small", "bold")
UI.pic("inv_slot", gx + 322, gy + 10, gx + 358, gy + 46); OT.c(gx + 340, gy + 18, ">", "small", "bold")
for _, b in ipairs(cl) do
